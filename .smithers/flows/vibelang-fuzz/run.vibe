// The native host supplies the filesystem path and child-process services to this recorded flow action.
import { Workspace } from "@smthrs/kernel"
import { ChildProcess } from "effect/process"

export schema error FuzzPhaseFailed {
  readonly stage: string; readonly status: number; readonly reason: string
  get message() { return `${this.stage}: ${this.reason} (${this.status})` }
}

/** Runs exactly one phase; the flow supplies ordering, persistence and recovery. */
export effect function runStage(stage: "prepare" | "build" | "targets" | "browser" | "report", coverage: boolean, settings: { readonly budget: string; readonly browserBudget: string; readonly seed: string; readonly executions?: number; readonly floorOnly?: boolean; readonly targets?: ReadonlyArray<string>; readonly reportFiles?: ReadonlyArray<string>; readonly browser?: boolean }) {
  return effect {
  const root = (try Path.Path).resolve((try Workspace.Workspace).root, "apps/vibelang")
  const { seed } = settings
  const budget = stage === "browser" ? settings.browserBudget : settings.budget
  const bootstrap: Record<string, string> = {}
  for (const name of ["PATH", "HOME", "USER", "LANG", "TERM", "TMPDIR", "SHELL", "E2E_SERVER_SECONDS"]) {
    const value = try Config.option(Config.String(name))
    if (Option.isSome(value)) bootstrap[name] = value.value
  }
  // A measured targets stage gives each workerd isolate Istanbul counters, dumped beside Vitest's report for the report
  // stage (apps/vibelang/fuzz/coverage.vibe); workerd has no V8 precise coverage (0015, 0016).
  // A lane running beside others names its own browser port; 4501 is the suite's.
  const port = Option.getOrElse(try Config.option(Config.String("E2E_PORT")), () => "4501")
  const argv = stage === "prepare" ? ["exec", "playwright", "install", "chromium"] : stage === "build" ? ["build:surfaces"]
    : stage === "targets" ? ["exec", "vitest", "run", "--config", "fuzz.config.ts", ...(coverage ? ["--coverage"] : []), ...(settings.targets ?? [])]
    : stage === "browser" ? ["exec", "playwright", "test", "--config", "fuzz/browser.config.ts"]
    : ["exec", "node", "--import=vibelang/register", "fuzz/coverage.vibe"]
  try withSpan(scoped(effect {
    try Effect.logInfo("vibelang.fuzz.phase").pipe(Effect.annotateLogs({ stage, outcome: "started" }))
    const process = try ChildProcess.make("pnpm", argv, { cwd: root, stdout: "inherit", stderr: "inherit", env: { ...bootstrap, E2E_PORT: port, E2E_4501: port, FUZZ_BUDGET: budget, FUZZ_SEED: seed, ...(settings.executions === undefined ? {} : { FUZZ_EXECUTIONS: String(settings.executions) }), ...(settings.floorOnly === true ? { FUZZ_FLOOR_ONLY: "1" } : {}), ...(settings.reportFiles === undefined ? {} : { FUZZ_REPORT_FILES: settings.reportFiles.join(" ") }), FUZZ_BROWSER: settings.browser === false ? "0" : "1", FUZZ_COLLECT_PARTIAL: coverage ? "1" : "0", ...(coverage && stage === "targets" ? { WORKERD_COVERAGE: "1", WORKERD_COVERAGE_DIR: "coverage/fuzz-unit/workerd-raw" } : {}), NODE_OPTIONS: "--import=vibelang/register", PLAYWRIGHT_BROWSERS_PATH: (try Path.Path).join(root, "node_modules/.cache/ms-playwright") }, extendEnv: false })
    const status = Number(try process.exitCode)
    try Metric.update(Metric.counter("vibelang_fuzz_phases", { incremental: true }), 1)
    try Effect.logInfo("vibelang.fuzz.phase").pipe(Effect.annotateLogs({ stage, outcome: status === 0 ? "passed" : "failed", status }))
    if (status !== 0) throw new FuzzPhaseFailed({ stage, status, reason: "exit" })
  }), `vibelang.fuzz.phase.${stage}`)
  } catch effect (error) => {
    if (error._tag === "FuzzPhaseFailed") throw error
    const reason = error._tag === "PlatformError" ? `${error.reason._tag}:${error.reason.module}.${error.reason.method}` : error._tag
    try Effect.logError("vibelang.fuzz.phase").pipe(Effect.annotateLogs({ stage, outcome: "failed", reason }))
    throw new FuzzPhaseFailed({ stage, status: -1, reason })
  }
}
