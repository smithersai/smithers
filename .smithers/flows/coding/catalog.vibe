/** Use the host's existing registered project flows, without another gateway or runtime. */
import * as Digest from "@smthrs/core/Digest"
import { FlowRuntime } from "@smthrs/flow"
import * as Descriptor from "@smthrs/registry/Descriptor"
import * as Executable from "@smthrs/registry/Executable"
import { atomError } from "./atoms.vibe"
import { digest } from "./catalog.trusted.ts"
import { CodingError, Implementation, Receipt } from "./schema.ts"
import { Implement, RunCheck } from "./workflow.vibe"

const isStepFailure = Schema.is(atomError)

effect function invoke(name: string, expectedDigest: string, input: Schema.Json, key: ReadonlyArray<string>) {
  const catalog = try Executable.Catalog
  const instance = try FlowRuntime.FlowInstance
  const runtime = try FlowRuntime.FlowRuntime
  const executable = catalog.executables.find((entry) => entry.descriptor.name === name)
  if (!executable) {
    throw new CodingError({ code: "unavailable", message: `Project flow ${name} is not registered in this host` })
  }
  const descriptorDigest = Descriptor.executionDigest(executable.descriptor)
  if (descriptorDigest === undefined) {
    throw new CodingError({ code: "unavailable", message: `Project flow ${name} has no verified executable identity` })
  }
  if (descriptorDigest !== expectedDigest) {
    throw new CodingError({
      code: "stale_revision",
      message: `Project flow ${name} changed since this plan was prepared; replan under a new execution`
    })
  }
  const suffix = digest(Digest.canonical([
    name,
    descriptorDigest,
    input,
    key
  ]))
  const legacyId = `${instance.executionId}/coding/${suffix}`
  // Preserve existing resumable child IDs. Only an overlong new lineage uses
  // the bounded form; hashing includes the complete parent identity.
  const executionId = legacyId.length <= 200 ? legacyId : digest(Digest.canonical([
    "coding/child/v1",
    instance.executionId,
    name,
    descriptorDigest,
    input,
    key
  ]))
  // The runtime reads the ambient FlowInstance and persists the parent edge.
  // Full payload and verified descriptor identity prevent stale child reuse.
  return runtime.execute(executable.flow, {
    executionId,
    payload: { input }
  }) catch effect (cause) => {
    throw isStepFailure(cause)
      ? cause
      : new CodingError({ code: "execution", message: `Project flow ${name} failed: ${String(cause)}` })
  }
}

/** The deployment supplies its existing Executable.Catalog and FlowRuntime layers. */
export const catalogLayers = Layer.mergeAll(
  Implement.toLayer((input) =>
    effect {
      const invoked = effect {
        const result = try invoke(input.change.implementation, input.change.implementationDigest, input, [
          "implement",
          input.change.id,
          input.parent.commitId
        ])
        return try Schema.decodeUnknownEffect(Implementation)(result)
      }
      return invoked catch effect (cause) => {
        throw isStepFailure(cause)
          ? cause
          : new CodingError({
            code: "execution",
            message: `Implementation flow returned invalid JJ revision evidence: ${String(cause)}`
          })
      }
    }
  ),
  RunCheck.toLayer((input) =>
    effect {
      const invoked = effect {
        const result = try invoke(input.check.flow, input.check.flowDigest, input, [
          "check",
          input.implementation.change,
          input.implementation.head.commitId,
          input.check.id
        ])
        return try Schema.decodeUnknownEffect(Receipt)(result)
      }
      return invoked catch effect (cause) => {
        throw isStepFailure(cause)
          ? cause
          : new CodingError({
            code: "invalid_receipt",
            message: `Check flow returned invalid revision evidence: ${String(cause)}`
          })
      }
    }
  )
)
