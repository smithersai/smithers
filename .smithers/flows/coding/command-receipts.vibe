/** Installed command audit. Repository results cannot manufacture these bytes. */
import { CommandReceipt } from "../../../packages/smithers/gateway/src/RuntimeBridge.ts"
import { ModuleOwner } from "../../../packages/smithers/src/internal/ModuleOwner.ts"
import { freshId, receiptFile } from "./command-receipts.platform.ts"

type Result = {
  readonly exitCode: number
  readonly stderr: { readonly text: string }
  readonly fault?: "factory" | "infra"
}
export interface CommandReceipts {
  readonly begin: (argv: readonly [string, ...Array<string>]) => (((result: Result) => void!unknown) | undefined)!unknown
  readonly read: (runId: string) => (CommandReceipt | undefined)!unknown
}

/** The host captures its raw filesystem before any repository action guards. */
export const commandReceipts = (fs: FileSystem.FileSystem, directory: string): CommandReceipts => {
  const file = (runId: string) => receiptFile(directory, runId)
  effect function write(receipt: CommandReceipt) {
    try fs.makeDirectory(directory, { recursive: true, mode: 0o700 })
    const temporary = file(receipt.runId) + "." + freshId()
    try fs.writeFileString(temporary, JSON.stringify(receipt), { mode: 0o600 })
    try fs.rename(temporary, file(receipt.runId))
  }
  return {
    begin: effect (argv) => {
      const owner = try Effect.serviceOption(ModuleOwner)
      if (Option.isNone(owner)) return undefined
      const receipt: CommandReceipt = {
        runId: owner.value.rootId,
        operationId: freshId(),
        status: "running",
        argv
      }
      // Invalidate the earlier exit before spawning, including failed launches.
      try write(receipt)
      return (result: Result) =>
        write({
          ...receipt,
          status: "completed",
          exitCode: result.exitCode,
          stderr: result.stderr.text,
          ...(result.fault === undefined ? {} : { fault: result.fault })
        })
    },
    read: effect (runId) => {
      const path = file(runId)
      if (!(try fs.exists(path))) return undefined
      const text = try fs.readFileString(path)
      return try Schema.decodeUnknownEffect(CommandReceipt)(try orDie(Effect.try(() => JSON.parse(text) as unknown)))
    }
  }
}
