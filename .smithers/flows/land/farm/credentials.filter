# Credentials and private data that neither farm client (lat-run, mini-run) ever uploads.
# Sender-side rules ("s") hide these paths from the transfer without protecting the slot's
# copy, so rsync --delete also removes any copy an older client left in a reused slot.
# affected.mjs farmSkips mirrors this list; farm.test.mjs checks both against a real transfer.
-,s .env*
-,s .dev.vars*
-,s .ssh/
-,s .aws/
-,s .npmrc
-,s *.pem
-,s *.key
-,s *.p12
-,s *.tfstate*
-,s /data/
