{
  "summary": "How smithersai/smithers develops itself.",
  "flows": [
    {
      "id": "review",
      "description": "Reviews the uncommitted change in this repository and returns a verdict with the reasons behind it.",
      "summary": "Review the working-copy change and return a verdict with the reasons behind it.",
      "featured": true,
      "kind": "mdx",
      "path": "flows/review/flow.mdx",
      "capabilities": [
        "fs:read:**",
        "proc:spawn:*"
      ],
      "model": "openai:gpt-5.6-sol",
      "modelInvocable": true
    },
    {
      "id": "lint",
      "description": "Lints the files you name against this repository's own conventions and fixes what it finds.",
      "summary": "Lint the files you name against this repository's conventions and fix what it finds.",
      "featured": true,
      "kind": "mdx",
      "path": "flows/lint/flow.mdx",
      "capabilities": [
        "fs:read:**",
        "fs:write:**",
        "proc:spawn:*"
      ],
      "model": "openai:gpt-5.6-sol",
      "modelInvocable": true
    },
    {
      "id": "pr-triage",
      "description": "Triages one pull request for scope, tests, documentation, and review readiness from an untrusted diff without checking out its code.",
      "summary": "Triage one pull request for scope, tests, docs, and review readiness from its diff alone.",
      "featured": true,
      "kind": "mdx",
      "path": "flows/pr-triage/flow.mdx",
      "capabilities": [
        "fs:read:**",
        "fs:write:.triage/report.json",
        "proc:spawn:rg *"
      ],
      "model": "openai:gpt-5.6-sol",
      "modelInvocable": true
    },
    {
      "id": "issue-triage",
      "description": "Reproduces and triages one GitHub issue, producing a structured maintainer response without holding a GitHub write token.",
      "summary": "Reproduce and triage one GitHub issue into a structured maintainer response.",
      "featured": true,
      "kind": "mdx",
      "path": "flows/issue-triage/flow.mdx",
      "capabilities": [
        "fs:read:**",
        "fs:write:.triage/report.json",
        "proc:spawn:rg *",
        "proc:spawn:git status *",
        "proc:spawn:git diff *",
        "proc:spawn:pnpm test *",
        "proc:spawn:pnpm exec vitest *"
      ],
      "model": "openai:gpt-5.6-sol",
      "modelInvocable": true
    },
    {
      "id": "release-notes",
      "description": "Drafts release notes from the commits since the last tag, grouped by the package each one touched.",
      "summary": "Draft release notes from the commits since the last tag, grouped by package.",
      "featured": true,
      "kind": "mdx",
      "path": "flows/release-notes/flow.mdx",
      "capabilities": [
        "fs:read:**",
        "proc:spawn:*"
      ],
      "model": "openai:gpt-5.6-sol",
      "modelInvocable": true
    },
