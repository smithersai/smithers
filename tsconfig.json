{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "*": [
        "./*"
      ]
    }
  },
  "include": [
    "PACKAGE.ts",
    "apps/*/PACKAGE.ts",
    "evals/*/PACKAGE.ts",
    "packages/smithers/agent/harness/benchmarks/*/PACKAGE.ts",
    ".smithers/flows/review/seeded-bugs/PACKAGE.ts",
    ".smithers/flows/PACKAGE.ts",
    "packages/*/PACKAGE.ts",
    "packages/*/*/PACKAGE.ts",
    "packages/*/*/*/PACKAGE.ts",
    "PACKAGE.vibe",
    "apps/*/PACKAGE.vibe",
    "evals/*/PACKAGE.vibe",
    "packages/smithers/agent/harness/benchmarks/*/PACKAGE.vibe",
    ".smithers/flows/review/seeded-bugs/PACKAGE.vibe",
    ".smithers/flows/PACKAGE.vibe",
    "packages/*/PACKAGE.vibe",
    "packages/*/*/PACKAGE.vibe",
    "packages/*/*/*/PACKAGE.vibe"
  ],
  "exclude": [
    "**/dist/**",
    "packages/coding-agent/examples/extensions/gondolin/**"
  ]
}
