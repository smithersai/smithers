diff --git a/build/esm/common/internal.js b/build/esm/common/internal.js
index 711234012c30bbea7e7b3db453a3a6923765004d..6445b6250f64a119a20e71fe0193471f5288a3e2 100644
--- a/build/esm/common/internal.js
+++ b/build/esm/common/internal.js
@@ -33,7 +33,9 @@ export function toAnyValue(value, encoder) {
     if (t === 'string')
         return { stringValue: value };
     if (t === 'number') {
-        if (!Number.isInteger(value))
+        // OTLP int_value is a signed 64-bit integer: an integer outside that
+        // range is sent as a double, as the protobuf serializer does.
+        if (!Number.isInteger(value) || value < -(2 ** 63) || value >= 2 ** 63)
             return { doubleValue: value };
         return { intValue: value };
     }
