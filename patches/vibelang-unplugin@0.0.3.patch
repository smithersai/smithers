+++ b/src/options.d.ts
@@ -0,0 +1,14 @@
+// The plugin's options, in a file that imports nothing, so vibelang-unplugin/deferred's types stay free of the
+// bundler packages' types.
+export interface VibeLangOptions {
+  /** tsconfig path relative to the root. Defaults to tsconfig.json. */
+  project?: string
+  /**
+   * Project root. The compiler runs here with rootDir set to it.
+   * Defaults to the Vite root, the webpack or Rspack context, esbuild's
+   * absWorkingDir, or process.cwd().
+   */
+  root?: string
+  /** Native vibelang binary or Node launcher path. Defaults to VIBELANG_BINARY, then the vibelang package. */
+  compiler?: string
+}
