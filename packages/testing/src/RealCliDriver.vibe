/**
 * Isolated real command journeys through injected host services.
 * Provide a supervised ChildProcessSpawner for process-tree cleanup on host loss.
 * Library catalog: filesystem and process services from a platform host.
 * @since 1.0.0
 */

import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"

/**
 * A bounded command failed before yielding an exit receipt.
 * @category errors
 * @since 1.0.0
 */
export error DriverError {
  reason: "invalid-options" | "timeout" | "output-limit"
}

/**
 * Literal executable and explicit environment; ambient credentials are never inherited.
 * @category models
 * @since 1.0.0
 */
export interface Options {
  readonly executable: string
  readonly args?: ReadonlyArray<string>
  readonly env?: Readonly<Record<string, string>>
  readonly timeoutMs?: number
  readonly maxBytes?: number
}

/**
 * Native exit status with independently drained output pipes.
 * @category models
 * @since 1.0.0
 */
export interface Result {
  readonly code: number
  readonly stdout: string
  readonly stderr: string
}

const bounds = (options: Options) => {
  const timeoutMs = options.timeoutMs ?? 30_000
  const maxBytes = options.maxBytes ?? 1024 * 1024
  return Number.isSafeInteger(timeoutMs) && timeoutMs > 0 && Number.isSafeInteger(maxBytes) && maxBytes > 0
    ? Effect.succeed({ timeoutMs, maxBytes })
    : Effect.fail(new DriverError({ reason: "invalid-options" }))
}

/**
 * Execute a literal command inside its own scope, bounded across startup, both
 * pipes and exit. Cancellation closes that scope before returning to the caller.
 * Input is piped without entering the command line or evidence.
 * @category execution
 * @since 1.0.0
 */
export const execute = effect (options: Options & { readonly cwd: string; readonly input?: string }) => {
  const { timeoutMs, maxBytes } = try bounds(options)
  const spawner = try ChildProcessSpawner
  return try Effect.scoped(
    effect {
      const handle = try spawner.spawn(ChildProcess.make(options.executable, [...options.args ?? []], {
        cwd: options.cwd,
        env: { ...options.env },
        extendEnv: false,
        stdin: options.input === undefined ? "ignore" : Stream.make(new TextEncoder().encode(options.input)),
        stdout: "pipe",
        stderr: "pipe",
        detached: true,
        killSignal: "SIGTERM",
        forceKillAfter: 1000
      }))
      let bytes = 0
      const collect = effect (stream: typeof handle.stdout) => {
        const decoder = new TextDecoder()
        const chunks: Array<string> = []
        try Stream.runForEach(stream, (chunk) => {
          bytes += chunk.byteLength
          return bytes > maxBytes
            ? Effect.fail(new DriverError({ reason: "output-limit" }))
            : Effect.orDie(Effect.try(() => {
              chunks.push(decoder.decode(chunk, { stream: true }))
            }))
        })
        return chunks.join("") + (try Effect.orDie(Effect.try(() => decoder.decode())))
      }
      const [stdout, stderr, code] = try Effect.all([
        collect(handle.stdout),
        collect(handle.stderr),
        handle.exitCode
      ], { concurrency: "unbounded" })
      return { code: Number(code), stdout, stderr } satisfies Result
    } |> Effect.timeoutOrElse(%, {
      duration: timeoutMs,
      orElse: () => Effect.fail(new DriverError({ reason: "timeout" }))
    })
  )
}

/**
 * Allocate fresh HOME, XDG, auth, sessions and working directory per journey.
 * All state is removed when the surrounding scope closes. Executable options
 * may supply PATH and loader configuration, but cannot override state roots.
 * @category constructors
 * @since 1.0.0
 */
export const make = effect (options: Options) => {
  try bounds(options)
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = try fs.makeTempDirectoryScoped({ prefix: "smthrs-cli-" })
  const home = path.join(root, "home")
  const cwd = path.join(root, "project")
  const env = {
    ...options.env,
    HOME: home,
    XDG_CONFIG_HOME: path.join(home, "config"),
    XDG_CACHE_HOME: path.join(home, "cache"),
    XDG_DATA_HOME: path.join(home, "data"),
    XDG_STATE_HOME: path.join(home, "state"),
    TMPDIR: path.join(root, "tmp"),
    SMITHERS_AUTH_FILE: path.join(home, "auth.json"),
    SMITHERS_TUI_SESSION_DIR: path.join(home, "sessions"),
    SMITHERS_DISABLE_SYSTEM_KEYRING: "1",
    SMITHERS_AUDIENCE: "human",
    NO_COLOR: "1"
  }
  for (
    const directory of [
      home,
      cwd,
      env.TMPDIR,
      env.XDG_CONFIG_HOME,
      env.XDG_CACHE_HOME,
      env.XDG_DATA_HOME,
      env.XDG_STATE_HOME
    ]
  ) {
    try fs.makeDirectory(directory, { mode: 0o700 })
  }
  return {
    root,
    home,
    cwd,
    env,
    run: (args: ReadonlyArray<string>, input?: string) =>
      execute({
        ...options,
        args: [...options.args ?? [], ...args],
        env,
        cwd,
        ...(input === undefined ? {} : { input })
      })
  }
}
