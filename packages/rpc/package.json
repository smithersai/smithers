{
  "name": "@smthrs/rpc",
  "version": "0.0.0",
  "private": true,
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "description": "Contract modules shared by the Smithers app (apps/mvp), the terminal app (apps/tui), the model host and the site: zod schemas, route constants, and RPC types",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./fixtures/*": {
      "types": "./test/fixtures/*.ts",
      "default": "./test/fixtures/*.ts"
    }
  },
  "scripts": {
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "typecheck": "vibelang --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0 && dprint check"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.18",
    "string-width": "7.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "dprint": "0.57.1",
    "eslint": "9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vitest": "5.0.0"
  }
}
