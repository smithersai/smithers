{
  "name": "__APP_NAME__",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "description": "The Aomi Build page as a Smithers app: file-routed flows and panes, an in-Worker agent on Cloudflare, and a Tevm chain tool",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "routes": "smithers-routes",
    "routes:check": "smithers-routes --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:record": "SMTHRS_RECORD=1 vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
