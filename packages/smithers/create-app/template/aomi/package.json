    "@smthrs/agent": "1.0.0-rc.1",
    "@smthrs/capability": "1.0.0-rc.1",
    "@smthrs/cli": "next",
    "@smthrs/core": "1.0.0-rc.1",
    "@smthrs/create-app": "1.0.0-rc.1",
    "@smthrs/engine": "1.0.0-rc.1",
    "@smthrs/flow": "1.0.0-rc.1",
    "@smthrs/harness": "1.0.0-rc.1",
    "@smthrs/kernel": "1.0.0-rc.1",
    "@smthrs/model": "1.0.0-rc.1",
    "@smthrs/plan": "1.0.0-rc.1",
    "@smthrs/registry": "1.0.0-rc.1",
    "@smthrs/std": "1.0.0-rc.1",
    "@smthrs/targets": "1.0.0-rc.1",
    "@smthrs/testing": "1.0.0-rc.1",
    "@smthrs/ui": "1.0.0-rc.0",
    "effect": "4.0.0-rc.115",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tevm": "1.0.0-next.149",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.13.2",
