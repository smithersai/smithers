{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true,
    "paths": {
      "@smthrs/create-app/app": ["./src/app.ts"],
      "@smthrs/create-app/ui": ["./src/ui.ts"],
      "@smthrs/create-app/worker": ["./src/worker.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
