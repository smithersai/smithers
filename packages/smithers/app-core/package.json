{
  "name": "@smthrs/app-core",
  "type": "module",
  "version": "1.0.0-rc.22",
  "license": "MIT",
  "smthrs": {
    "group": "tooling"
  },
  "description": "The one principal-bound Smithers core, and its four generated clients: MCP, CLI, SDK and GUI",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/app-core"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./CauseReceipt": "./src/CauseReceipt.ts",
    "./CliAdapter": "./src/CliAdapter.ts",
    "./Core": "./src/Core.ts",
    "./GuiAdapter": "./src/GuiAdapter.ts",
    "./McpAdapter": "./src/McpAdapter.ts",
    "./Principal": "./src/Principal.ts",
    "./SdkAdapter": "./src/SdkAdapter.ts",
    "./index": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -p tsconfig.json --noEmit && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../repo-targets/scripts/circular.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.22",
    "@smthrs/plugin": "1.0.0-rc.22"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "effect": "4.1.1",
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "dprint": "0.57.1"
  },
  "peerDependencies": {
    "effect": "4.1.1"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./CauseReceipt": {
        "types": "./dist/esm/CauseReceipt.d.ts",
        "import": "./dist/esm/CauseReceipt.js",
        "require": "./dist/cjs/CauseReceipt.js"
      },
      "./CliAdapter": {
        "types": "./dist/esm/CliAdapter.d.ts",
        "import": "./dist/esm/CliAdapter.js",
        "require": "./dist/cjs/CliAdapter.js"
      },
      "./Core": {
        "types": "./dist/esm/Core.d.ts",
        "import": "./dist/esm/Core.js",
        "require": "./dist/cjs/Core.js"
      },
      "./GuiAdapter": {
        "types": "./dist/esm/GuiAdapter.d.ts",
        "import": "./dist/esm/GuiAdapter.js",
        "require": "./dist/cjs/GuiAdapter.js"
      },
      "./McpAdapter": {
        "types": "./dist/esm/McpAdapter.d.ts",
        "import": "./dist/esm/McpAdapter.js",
        "require": "./dist/cjs/McpAdapter.js"
      },
      "./Principal": {
        "types": "./dist/esm/Principal.d.ts",
        "import": "./dist/esm/Principal.js",
        "require": "./dist/cjs/Principal.js"
      },
      "./SdkAdapter": {
        "types": "./dist/esm/SdkAdapter.d.ts",
        "import": "./dist/esm/SdkAdapter.js",
        "require": "./dist/cjs/SdkAdapter.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  }
}
