{
  "name": "@smthrs/opencode",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "OpenCode protocol server over the Smithers agent loop, for the hosted OpenCode app",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/opencode"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "opencode",
    "agent"
  ],
  "keywords": [
    "typescript",
    "effect",
    "opencode",
    "agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Auth": "./src/Auth.ts",
    "./Cors": "./src/Cors.ts",
    "./DemoScript": "./src/DemoScript.ts",
    "./Driver": "./src/Driver.ts",
    "./EngineDriver": "./src/EngineDriver.ts",
    "./Events": "./src/Events.ts",
    "./Health": "./src/Health.ts",
    "./Ids": "./src/Ids.ts",
    "./Ownership": "./src/Ownership.ts",
    "./Pricing": "./src/Pricing.ts",
    "./Projection": "./src/Projection.ts",
    "./Protocol": "./src/Protocol.ts",
    "./Routes": "./src/Routes.ts",
    "./ScriptedDriver": "./src/ScriptedDriver.ts",
    "./Serve": "./src/Serve.ts",
    "./Store": "./src/Store.ts",
    "./Turns": "./src/Turns.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
