/**
 * One job's work on the runner: its checkout, its agent's session over the
 * Agent Client Protocol, and the change it leaves.
 *
 * The session is the job's durable unit, resumed from the last checkpoint the
 * agent's own protocol records (Will, 2026-10-31, DUR-1's exception for
 * external agents). The runner keeps one checkpoint beside the checkout,
 * `<checkout>.acp.json` (mode `0600`): the generation it belongs to, the ACP
 * session id once the agent gave one, and the environment and account label
 * the profile's `prestart` chose. Work that runs again for the same
 * generation, because the runner restarted, reuses that environment, skips
 * `prestart`, and loads the session (`session/load`) so the agent carries on
 * from its own transcript under the same account. A new generation, which
 * follows a retryable end and may run under another account, runs `prestart`
 * again and starts a fresh session told that the checkout holds earlier work.
 * Nothing outside this module knows a session can resume.
 *
 * Every update the agent streams goes to the job's transcript spool
 * (Spool.ts), which the host shows as the run's transcript, except the
 * history an agent replays while it loads a session: the host has it already.
 * The runner adds `_smithers/turn` with each prompt turn's stop reason.
 *
 * A message a person sends the agent while it works (a steer) reaches the
 * turn in flight through ACP's `_session/steering` when the agent advertises
 * it, and otherwise by cancelling the turn and prompting again with the
 * message and {@link STEER_CONTINUE}; a steer that arrives after the turn
 * ended starts the next one. The checkpoint's ledger records each steer
 * before it is handed over and once the agent sent an update after it, which
 * is the first evidence it was read: a steer is handed over at most once,
 * and one handed over before a restart and never confirmed stays unconfirmed.
 * The transcript marks each steer as `_smithers/steer` when it is handed over,
 * and a stop the host asked for as `_smithers/cancel`.
 *
 * Nothing here logs a prompt, the agent's text, a command line, an
 * environment or a path: ids, codes, the account label and durations only.
 *
 * @since 1.0.0
 */

import * as Acp from "@smthrs/agent/Acp"
import * as AgentRunner from "@smthrs/agent/AgentRunner"
import * as Transcript from "@smthrs/agent/Transcript"
import * as ScopedProcess from "@smthrs/platform-node/ScopedProcess"
import { Cause, Deferred, Effect, Exit, Fiber, type Latch, Option, Queue, Schema, Stream } from "effect"
import type * as Config from "./Config.vibe"
import * as Credential from "./Credential.vibe"
import * as Host from "./Host.vibe"
import * as $platform from "./Session.platform.ts"
import * as Spool from "./Spool.ts"
import * as Tree from "./Tree.vibe"
import * as Workspace from "./Workspace.ts"

/**
 * The durable payload of one job: everything the claim said but whether it was
 * reclaimed, which differs between a job's first claim and its reclaim.
 *
 * @category schemas
 * @since 1.0.0
 */
export const JobPayload = Schema.Struct({
  key: AgentRunner.Job.fields.key,
  claim: AgentRunner.Job.fields.claim,
  generation: AgentRunner.Job.fields.generation,
  task: AgentRunner.Task,
  deadline: AgentRunner.Job.fields.deadline
})

/**
 * The durable payload of one job, decoded.
 *
 * @category models
 * @since 1.0.0
 */
export type JobPayload = typeof JobPayload.Type

/**
 * What the serve loop tells a job's work while it runs: whether the host asked
 * to stop it, whether the claim no longer holds it (the work stops its agent,
 * and its settlement is refused), and whether this claim was handed back after
 * a restart.
 *
 * @category models
 * @since 1.0.0
 */
export interface Control {
  readonly cancel: Deferred.Deferred<void>
  readonly dropped: Deferred.Deferred<void>
  /**
   * Whether the host takes this runner's requests (decision 0148), as its
   * heartbeats find: `latch` is open while it does; `suspended` completes when
   * a heartbeat is refused `403 not_authorized` and is replaced by a fresh one
   * when a heartbeat is taken again. While suspended, the work stops the agent,
   * keeps the checkout and its checkpoint, and waits on `latch` to resume the
   * session; the job's execution is never ended for it.
   */
  readonly authorization: { suspended: Deferred.Deferred<void>; readonly latch: Latch.Latch }
  /**
   * Completed when the host, refusing the runner, said it ended the job
   * itself for a Stop (a heartbeat's `403 { cancel: true }`). Unlike
   * `cancel`, which any Stop completes, only this says no settlement or
   * transcript can be recorded any more.
   */
  readonly hostEnded: Deferred.Deferred<void>
  readonly reclaimed: boolean
  /** The messages people sent the agent, each once, as the host handed them out. */
  readonly steers: Queue.Queue<AgentRunner.Steer>
  /** The ids of steers the agent read, which the serve loop reports until the host stops listing them. */
  readonly delivered: Set<string>
  /** How the job runs, as the work last saw it: what each heartbeat tells the host. */
  readonly stats: Stats
}

/**
 * How a job runs, for the host's fleet view and alerts: the account label the
 * profile's hook chose, the CPU seconds the agent's whole tree has used, and
 * the usage the agent reported. The work writes it; each heartbeat reads it.
 *
 * @category models
 * @since 1.0.0
 */
export interface Stats {
  account?: string
  cpuSeconds?: number
  usage?: AgentRunner.Usage
}

/**
 * The most characters of the agent's last message kept as the job's summary.
 *
 * @category constants
 * @since 1.0.0
 */
export const MAX_SUMMARY = 4096

/**
 * How long the agent must be quiet after `end_turn` before its work is
 * collected, and the most the runner waits for that quiet. An agent may go on
 * sending updates, or start a turn of its own, after its turn ends.
 *
 * @category constants
 * @since 1.0.0
 */
export const QUIET = { afterMs: 5000, maxMs: 60_000 }

/**
 * How long a stopped agent's processes have after `SIGINT` before `SIGKILL`.
 *
 * @category constants
 * @since 1.0.0
 */
export const STOP_GRACE_MS = 5000

/**
 * The prompt that resumes a loaded session.
 *
 * @category constants
 * @since 1.0.0
 */
export const CONTINUE =
  "Continue\n\nYour earlier turn was interrupted. The checkout holds your work so far; carry on with " +
  "the task from where you stopped."

/**
 * What a steer's prompt ends with when the runner cancelled the turn to
 * deliver it, or the turn had already ended: the agent's task goes on.
 *
 * @category constants
 * @since 1.0.0
 */
export const STEER_CONTINUE = "Then continue the task."

/**
 * How long the runner waits for a cancelled turn to end before it prompts
 * with a steer anyway.
 *
 * @category constants
 * @since 1.0.0
 */
export const STEER_CANCEL_WAIT_MS = 30_000

/**
 * The line a fresh session's prompt ends with when the checkout holds an
 * earlier session's work.
 *
 * @category constants
 * @since 1.0.0
 */
export const EARLIER_WORK = "An earlier attempt at this task left its work in the checkout. Continue from it."

const Checkpoint = Schema.Struct({
  generation: Schema.Int,
  sessionId: Schema.optional(Schema.String),
  env: Schema.Record(Schema.String, Schema.String),
  account: Schema.optional(Schema.String),
  // Each steer by id: `handed` once the runner began handing it over, `delivered` once the agent answered after it.
  steers: Schema.optional(Schema.Record(Schema.String, Schema.Literals(["handed", "delivered"])))
})
type Checkpoint = typeof Checkpoint.Type
const decodeCheckpoint = Schema.decodeUnknownOption(Schema.fromJsonString(Checkpoint))

const readCheckpoint = (checkout: Workspace.Checkout): Checkpoint | undefined => {
  try {
    return Option.getOrUndefined(decodeCheckpoint($platform.readFileSync(checkout.checkpoint, "utf8")))
  } catch {
    return undefined
  }
}

const writeCheckpoint = (checkout: Workspace.Checkout, checkpoint: Checkpoint) =>
  Effect.sync(() => {
    const temporary = `${checkout.checkpoint}.tmp`
    $platform.writeFileSync(temporary, JSON.stringify(checkpoint), { mode: 0o600 })
    $platform.chmodSync(temporary, 0o600)
    $platform.renameSync(temporary, checkout.checkpoint)
  })

/** The runner's own environment, as an agent or a hook inherits it. */
const inherited = (): Record<string, string> =>
  Object.fromEntries(
    Object.entries($platform.environment()).filter((entry): entry is [string, string] =>
      entry[1] !== undefined && !entry[0].startsWith("SMITHERS_RUNNER_")
    )
  )

/**
 * Runs the profile's `prestart` in the checkout for at most 60 s: the
 * environment its `NAME=VALUE` lines set and the account its `account=` line
 * names, or `undefined` when it exits non-zero.
 */
const prestart = (argv: ReadonlyArray<string>, cwd: string, env: Record<string, string>) =>
  Effect.scoped(effect {
    const handle = try ScopedProcess.spawn({ command: argv[0]!, args: argv.slice(1), cwd, env })
    const chunks: Array<Uint8Array> = []
    const collect = (keep: boolean) => {
      let size = 0
      return Stream.runForEach((chunk: Uint8Array) =>
        effect {
          size += chunk.byteLength
          if (size > 1024 * 1024) throw new Error("prestart output limit")
          if (keep) chunks.push(chunk)
        }
      )
    }
    const [code] = try Effect.all([
      handle.exitCode,
      handle.stdout.pipe(collect(true)),
      handle.stderr.pipe(collect(false))
    ], { concurrency: "unbounded" })
    if (code !== 0) return undefined
    const set: Record<string, string> = {}
    let account: string | undefined
    for (const line of (try sync(() => $platform.concatText(chunks))).split("\n")) {
      const match = /^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/.exec(line.trim())
      if (match === null) continue
      if (match[1] === "account") account = match[2]
      else set[match[1]!] = match[2]!
    }
    return { env: set, account }
  }).pipe(
    Effect.timeout("60 seconds"),
    Effect.catch(() => Effect.succeed(undefined)),
    Effect.tap((result) =>
      Effect.logDebug("runner.prestart").pipe(
        Effect.annotateLogs({ outcome: result === undefined ? "refused" : "completed" })
      )
    ),
    Effect.onInterrupt(() => Effect.logDebug("runner.prestart").pipe(Effect.annotateLogs({ outcome: "cancelled" }))),
    Effect.withSpan("runner.prestart")
  )

/** The first prompt of a fresh session: the instructions, the task, and whether earlier work is in the checkout. */
const promptOf = (task: AgentRunner.Task, earlier: boolean): string =>
  [...task.system, task.prompt, ...(earlier ? [EARLIER_WORK] : [])].filter((part) => part.length > 0).join("\n\n")

const failed = (reason: (typeof AgentRunner.FAILURES)[number]): AgentRunner.Outcome => ({ _tag: "Failed", reason })

/**
 * Why an agent's process didn't start, for a log: the error's code and the first line of its message, every absolute
 * path replaced. Nothing of the agent's environment.
 *
 * @category constructors
 * @since 1.0.0
 */
export const spawnFailureOf = (cause: Cause.Cause<unknown>): { readonly code: string; readonly reason: string } => {
  const error = Cause.squash(cause) as {
    readonly code?: unknown
    readonly message?: unknown
    readonly _tag?: unknown
    readonly cause?: { readonly code?: unknown }
  }
  const code = [error.code, error.cause?.code, error._tag].find((each) => typeof each === "string")
  const message = typeof error.message === "string" ? error.message : String(error)
  return {
    code: code ?? "unknown",
    reason: (message.split("\n")[0] ?? "").replace(/\/[^\s'"`:,)]+/g, "<path>").slice(0, 200)
  }
}

/**
 * Does one job's work and answers how it ended. Never fails: every way it can
 * end is an outcome. Interrupted (the claim was lost), it stops the agent's
 * whole tree and answers nothing.
 *
 * @category constructors
 * @since 1.0.0
 */
export const work = (
  config: Config.Checked,
  job: JobPayload,
  control: Control
): Effect.Effect<AgentRunner.Outcome, never, Host.Host> =>
  effect {
    const startedAt = Date.now()
    // A throw here is a defect, as it was in the generator this replaced.
    const { origin } = try Effect.orDie(
      Effect.try({ try: () => AgentRunner.parseKey(job.key), catch: (cause) => cause })
    )
    const checkout = try sync(() => Workspace.of(config.stateDir, origin))
    const report = (outcome: AgentRunner.Outcome, fields: Record<string, string | number | boolean> = {}) =>
      Effect.logInfo("runner.session").pipe(
        Effect.annotateLogs({
          job: job.key,
          generation: job.generation,
          outcome: outcome._tag === "Failed" ? `failed:${outcome.reason}` : outcome._tag.toLowerCase(),
          durationMs: Date.now() - startedAt,
          ...fields
        }),
        Effect.as(outcome)
      )
    const repository = config.repositories[job.task.repository]
    if (repository === undefined) return try report(failed("workspace"))
    const profile = config.profiles[job.task.agent.profile]
    if (profile === undefined) return try report(failed("refused"))
    // A checkout whose mark says it was still being made when the runner stopped is incomplete, whatever its
    // directory holds: it is made again. No agent ran in it, since the mark goes, durably, only once it is complete,
    // before the record that an agent is about to run is written. Both there (a machine that lost the mark's removal
    // but kept the record) is never discarded: the record wins, and the mark goes.
    const incomplete = $platform.existsSync(checkout.provisioning) && !$platform.existsSync(checkout.started)
    if (!(try sync(() => Workspace.exists(checkout))) || incomplete) {
      // Gone after an agent was about to run in it (its record, or its session checkpoint): that work is lost. Else
      // no agent ran (a claim handed back before the checkout was begun, or one whose making was cut short), so the
      // checkout is made, costing no generation or restart; an incomplete one's directory is discarded first, as part
      // of the same controlled attempt.
      if (!incomplete && ($platform.existsSync(checkout.started) || $platform.existsSync(checkout.checkpoint))) {
        return try report(failed("machine_lost"))
      }
      const ended = try provision(repository.mirror, job, checkout, control).pipe(
        Effect.ensuring(Effect.sync(() => Credential.forget(job)))
      )
      // Not made: the mark stays until the job's settlement forgets the checkout, so a runner that stops before then
      // discards whatever `jj workspace add` left rather than taking it for a checkout.
      if (ended !== undefined) return try report(ended.outcome, ended.fields)
    }
    // The checkout is complete: its mark goes, then the record that an agent is about to run in it is kept, each
    // through to disk (the directory entry included) before the next.
    try Effect.sync(() => {
      $platform.durablyRemove(checkout.provisioning)
      $platform.durably(checkout.started, `${job.key}\n`)
    })
    if (Date.now() >= job.deadline) return try report(failed("timeout"))
    const saved = readCheckpoint(checkout)
    const same = saved !== undefined && saved.generation === job.generation
    const base = { ...inherited(), ...profile.env }
    let chosen: { readonly env: Record<string, string>; readonly account: string | undefined }
    if (same) {
      chosen = { env: saved.env, account: saved.account }
    } else {
      const hook = profile.prestart === undefined
        ? { env: {}, account: undefined }
        : try prestart(profile.prestart, checkout.dir, base)
      if (hook === undefined) return try report(failed("refused"))
      chosen = hook
      try writeCheckpoint(checkout, {
        generation: job.generation,
        env: hook.env,
        ...(hook.account === undefined ? {} : { account: hook.account }),
        ...(saved?.steers === undefined ? {} : { steers: saved.steers })
      })
    }
    const account: { account?: string } = chosen.account === undefined ? {} : { account: chosen.account }
    if (chosen.account !== undefined) control.stats.account = chosen.account
    const scrub = Transcript.scrubber([
      ...(profile.secretEnv ?? []).flatMap((name) => base[name] === undefined ? [] : [base[name]]),
      ...Object.values(chosen.env)
    ])
    // Suspended for want of authorization (decision 0148), the agent is stopped and its session kept: once the host
    // takes the runner again, the session resumes from its checkpoint, as after a restart.
    let resume = same ? saved.sessionId : undefined
    let outcome: { readonly outcome: AgentRunner.Outcome; readonly stop: string }
    while (true) {
      // Suspended, the work waits for the host to take the runner again, a stop, the claim lost, or the deadline.
      const waited = try control.authorization.latch.await.pipe(
        Effect.as("open" as const),
        Effect.raceFirst(Deferred.await(control.cancel).pipe(Effect.as("cancel" as const))),
        Effect.raceFirst(Deferred.await(control.dropped).pipe(Effect.as("dropped" as const))),
        Effect.raceFirst(
          Effect.suspend(() => Effect.sleep(Math.max(0, job.deadline - Date.now()))).pipe(
            Effect.as("deadline" as const)
          )
        )
      )
      if (waited === "deadline") {
        outcome = { outcome: failed("timeout"), stop: "deadline" }
        break
      }
      if (waited !== "open") {
        outcome = {
          outcome: { _tag: "Cancelled", processTreeGone: true },
          stop: waited === "cancel" ? "cancelled" : "dropped"
        }
        break
      }
      outcome = try Effect.scoped(effect {
        const spool = try Spool.open({ stateDir: config.stateDir, key: job.key, claim: job.claim, scrub })
        try Effect.forkScoped(spool.upload)
        const kept = readCheckpoint(checkout)
        return try session({
          profile,
          job,
          checkout,
          mirror: repository.mirror,
          control,
          env: { ...base, ...chosen.env },
          resume,
          checkpoint: {
            generation: job.generation,
            env: chosen.env,
            ...account,
            // A later generation keeps the ledger: a steer handed to an earlier one is never handed over again.
            ...(kept?.steers === undefined ? {} : { steers: kept.steers }),
            ...(kept?.sessionId === undefined || kept.generation !== job.generation
              ? {}
              : { sessionId: kept.sessionId })
          },
          scrub,
          spool
        })
      })
      if (outcome.stop !== "suspended") break
      const kept = readCheckpoint(checkout)
      resume = kept !== undefined && kept.generation === job.generation ? kept.sessionId : resume
      try Effect.logWarning("runner.session").pipe(Effect.annotateLogs({ job: job.key, outcome: "suspended" }))
    }
    const fields: Record<string, string> = { stop: outcome.stop }
    if (chosen.account !== undefined) fields.account = chosen.account
    return try report(outcome.outcome, fields)
  }

/**
 * How long a checkout waits for a credential the host couldn't issue, when
 * the host said no wait: 15 s, doubling, to 5 minutes.
 */
const provisionWaitSeconds = (attempt: number): number => Math.min(300, 15 * 2 ** (attempt - 1))

/** Time left before the deadline below which a checkout isn't tried again: the job ends `timeout`. */
const PROVISION_LAST_TRY_MS = 1000

/** How a job ended before its agent ran, and what its log line adds. */
interface Ended {
  readonly outcome: AgentRunner.Outcome
  readonly fields: Record<string, string | number>
}

/**
 * Makes the job's checkout: `undefined` once it exists, else how the job
 * ends. First the mark (`checkout.provisioning`) is written: a runner that
 * stops before the checkout is complete finds it on the claim handed back,
 * discards whatever the directory holds, and makes the checkout again. A private repository's mirror fetches with
 * the host's read credential for this job (decision 0148), asked for only
 * when the mirror must fetch or clone: a `404` fetches as before; a refusal
 * fails `workspace` without fetching. A host or GitHub that can't answer now
 * costs the job no generation and none of its agent's restarts: the same
 * claim waits (the host's wait, else `provisionWaitSeconds`, at most half the
 * time left) and makes the checkout again, until the job's deadline passes, a
 * stop the host asked for, or the claim lost.
 */
const provision = (
  mirror: string,
  job: JobPayload,
  checkout: Workspace.Checkout,
  control: Control
): Effect.Effect<Ended | undefined, never, Host.Host> =>
  effect {
    const ended = (outcome: AgentRunner.Outcome, fields: Record<string, string | number> = {}): Ended => ({
      outcome,
      fields
    })
    const host = try Host.Host
    try Effect.sync(() => $platform.durably(checkout.provisioning, `${job.key}\n`))
    for (let attempt = 1;; attempt++) {
      // The whole attempt, its wait for the mirror and a fetch that stalls included, gives way to a Stop, the claim
      // lost, or the deadline: interrupted, its git or jj is killed (decision 0148).
      // A directory an attempt cut short left (the mark says no agent ran in it) is discarded within the attempt.
      const once = effect {
        const make = Workspace.create(mirror, job.task.base, checkout, Credential.forJob(host, job))
        return try ((try sync(() => Workspace.exists(checkout))) && !$platform.existsSync(checkout.started)
          ? Workspace.discard(mirror, checkout).pipe(Effect.andThen(make))
          : make)
      }
      const attempted = try Effect.exit(once).pipe(
        Effect.map((exit) => ({ _tag: "attempted" as const, exit })),
        Effect.raceFirst(Deferred.await(control.cancel).pipe(Effect.as({ _tag: "cancel" as const }))),
        Effect.raceFirst(Deferred.await(control.dropped).pipe(Effect.as({ _tag: "dropped" as const }))),
        Effect.raceFirst(
          Effect.suspend(() => Effect.sleep(Math.max(0, job.deadline - Date.now()))).pipe(
            Effect.as({ _tag: "deadline" as const })
          )
        )
      )
      if (attempted._tag === "deadline") return ended(failed("timeout"), {})
      if (attempted._tag !== "attempted") {
        return ended({ _tag: "Cancelled", processTreeGone: true }, { stop: attempted._tag })
      }
      const made = attempted.exit
      if (Exit.isSuccess(made)) return undefined
      const error = Cause.findErrorOption(made.cause)
      // Refused for want of authorization or authentication (decision 0148): waited out like a host that can't issue
      // one now.
      const unauthorized = Option.isSome(error) && error.value instanceof Credential.CredentialRefused &&
        (error.value.status === 401 || error.value.status === 403)
      if (!unauthorized && (Option.isNone(error) || !(error.value instanceof Credential.CredentialUnavailable))) {
        const refused = Option.isSome(error) && error.value instanceof Credential.CredentialRefused
        return ended(failed("workspace"), refused ? { credential: "refused" } : {})
      }
      const said = Option.getOrUndefined(error)
      const waitSeconds = (said instanceof Credential.CredentialUnavailable ? said.afterSeconds : undefined) ??
        provisionWaitSeconds(attempt)
      // A wait the host asked for that would run past the deadline is cut to half the time left, so the checkout is
      // tried again while it can still be used; the job times out only once its deadline has passed.
      const left = job.deadline - Date.now()
      if (left <= PROVISION_LAST_TRY_MS) return ended(failed("timeout"), { credential: "unavailable" })
      const waitMs = Math.min(waitSeconds * 1000, Math.floor(left / 2))
      try Effect.logInfo("runner.workspace").pipe(
        Effect.annotateLogs({ job: job.key, credential: "unavailable", attempt, waitMs })
      )
      const waited = try Effect.sleep(waitMs).pipe(
        Effect.as("waited" as const),
        Effect.raceFirst(Deferred.await(control.cancel).pipe(Effect.as("cancel" as const))),
        Effect.raceFirst(Deferred.await(control.dropped).pipe(Effect.as("dropped" as const)))
      )
      if (waited !== "waited") {
        return ended({ _tag: "Cancelled", processTreeGone: true }, { stop: waited })
      }
    }
  }

/** One agent process and its session, in the caller's scope: how it ended, and the stop reason or end code. */
const session = (options: {
  readonly profile: Config.Profile
  readonly job: JobPayload
  readonly checkout: Workspace.Checkout
  readonly mirror: string
  readonly control: Control
  readonly env: Record<string, string>
  readonly resume: string | undefined
  readonly checkpoint: Checkpoint
  readonly scrub: (text: string) => string
  readonly spool: Spool.Spool
}) =>
  effect {
    const { checkout, control, job, profile } = options
    const retry = (kind: "refusal" | "exit" | "error"): AgentRunner.Outcome | undefined =>
      profile.retryOn?.includes(kind) === true ? { _tag: "Retryable" } : undefined
    const ended = (outcome: AgentRunner.Outcome, stop: string) => ({ outcome, stop })
    const spawned = try Effect.exit(ScopedProcess.spawn({
      command: profile.argv[0]!,
      args: profile.argv.slice(1),
      cwd: checkout.dir,
      env: options.env,
      stdin: "pipe",
      killSignal: "SIGINT",
      forceKillAfter: 15_000
    }))
    if (Exit.isFailure(spawned)) {
      try Effect.logWarning("runner.spawn").pipe(Effect.annotateLogs(spawnFailureOf(spawned.cause)))
      return ended(failed("refused"), "spawn")
    }
    const handle = spawned.value
    const tree = Tree.watch(handle.targetPid)
    // Each look at the tree also counts its CPU time, which the host's stall rule reads from the heartbeat.
    try tree.observe.pipe(
      Effect.andThen(Effect.sync(() => {
        control.stats.cpuSeconds = tree.cpuSeconds()
      })),
      Effect.andThen(Effect.sleep(1000)),
      Effect.forever,
      Effect.forkScoped
    )
    // Every way out stops the whole tree, the agent's detached tools included.
    try Effect.addFinalizer(() => Tree.stop(tree, { graceMs: 2000, settleMs: 5000 }).pipe(Effect.ignore))
    const lines = try Queue.unbounded<string>()
    const encoder = new TextEncoder()
    try Stream.fromQueue(lines).pipe(
      Stream.map((line) => encoder.encode(`${line}\n`)),
      Stream.run(handle.stdin),
      Effect.ignore,
      Effect.forkScoped
    )
    try Stream.runDrain(handle.stderr).pipe(Effect.ignore, Effect.forkScoped)
    let lastUpdate = Date.now()
    let current = ""
    let previous = ""
    let usage: AgentRunner.Usage = {}
    // While the agent loads a session it replays that session's history, which the transcript holds already.
    let loading = false
    // The checkpoint as it stands, its steer ledger included; every write goes through `save`.
    let checkpoint: Checkpoint = options.checkpoint
    const ledger: Record<string, "handed" | "delivered"> = { ...checkpoint.steers }
    const save = () => writeCheckpoint(checkout, { ...checkpoint, steers: { ...ledger } })
    // Steers the agent read before a restart, which the host may not have recorded yet.
    for (const [id, state] of Object.entries(ledger)) if (state === "delivered") control.delivered.add(id)
    // Steers handed over that no update has followed yet.
    let awaiting: Array<string> = []
    const steerLog = (id: string, fields: Record<string, string | number | boolean>) =>
      Effect.logInfo("runner.steer").pipe(Effect.annotateLogs({ job: job.key, steer: id, ...fields }))
    const client = try Acp.make({
      incoming: Stream.splitLines(Stream.decodeText(handle.stdout)),
      send: (line) => Queue.offer(lines, line)
    }, {
      permission: profile.permission,
      onUpdate: (update) =>
        Effect.andThen(
          loading ? Effect.void : options.spool.append(update.kind, update.update),
          effect {
            lastUpdate = Date.now()
            if (awaiting.length > 0) {
              // The agent's first word after a steer was handed over: it read it.
              const read = awaiting
              awaiting = []
              for (const id of read) {
                ledger[id] = "delivered"
                control.delivered.add(id)
              }
              try save()
              for (const id of read) try steerLog(id, { outcome: "delivered" })
            }
            const text = Acp.messageText(update)
            if (Option.isSome(text)) {
              current = (current + text.value).slice(-MAX_SUMMARY)
              return
            }
            const reported = Acp.usage(update)
            if (Option.isSome(reported)) {
              usage = {
                contextTokens: reported.value.contextTokens,
                ...(reported.value.costUsd === undefined ? {} : { costUsd: reported.value.costUsd })
              }
              control.stats.usage = usage
              return
            }
            if (current !== "") {
              previous = current
              current = ""
            }
          }
        )
    })
    const failure = (error: Acp.AcpError) =>
      error.code === "closed"
        ? ended(retry("exit") ?? failed("agent"), "exit")
        : error.code === "remote"
        ? ended(retry("error") ?? failed("refused"), "error")
        : ended(failed("agent"), "protocol")
    // A cancel from the host, a claim the host no longer holds, the step's deadline, or the host refusing the runner
    // for want of authorization (decision 0148).
    const signal = Effect.raceAll([
      Deferred.await(control.cancel).pipe(Effect.as("cancel" as const)),
      Deferred.await(control.dropped).pipe(Effect.as("dropped" as const)),
      Effect.suspend(() => Effect.sleep(Math.max(0, job.deadline - Date.now()))).pipe(Effect.as("deadline" as const)),
      Effect.suspend(() => Deferred.await(control.authorization.suspended)).pipe(Effect.as("suspended" as const))
    ])
    type Signal = "cancel" | "dropped" | "deadline" | "suspended"
    const isSignal = (value: unknown): value is Signal =>
      value === "cancel" || value === "dropped" || value === "deadline" || value === "suspended"
    const stopped = (cause: Signal, sessionId: string | undefined, turn: Fiber.Fiber<unknown, unknown> | undefined) =>
      effect {
        // Seen before the cancel: an agent may end its own helpers on a cancel and orphan the commands they ran
        // (one adapter does), which no later look at the tree finds under the agent.
        try tree.observe
        // A stop the host asked for is marked in the transcript before the agent hears it.
        if (cause === "cancel") try options.spool.append(Transcript.KINDS.cancel, {})
        if (sessionId !== undefined) try client.cancel(sessionId).pipe(Effect.ignore)
        if (turn !== undefined) try Fiber.await(turn).pipe(Effect.timeout("30 seconds"), Effect.ignore)
        // A stop a person asked for: tools that ignore SIGINT (S3's real agents' commands did) get SIGKILL after 5 s,
        // so the tree is gone within a heartbeat and about 10 s.
        const gone = try Tree.stop(tree, { graceMs: STOP_GRACE_MS, settleMs: 5000 })
        // A dropped claim settles nothing the host keeps: its settlement is fenced off. A suspended one settles
        // nothing yet: the work resumes the session once the host takes the runner again.
        return cause === "deadline"
          ? ended(failed("timeout"), "deadline")
          : cause === "suspended"
          ? ended({ _tag: "Cancelled", processTreeGone: gone }, "suspended")
          : ended({ _tag: "Cancelled", processTreeGone: gone }, cause === "cancel" ? "cancelled" : "dropped")
      }
    const opened = try Effect.raceFirst(
      effect {
        const initialized = try client.initialize
        if (options.resume !== undefined && initialized.loadSession) {
          loading = true
          const loaded = try Effect.exit(client.loadSession(options.resume, checkout.dir))
          loading = false
          if (Exit.isSuccess(loaded)) {
            return { sessionId: options.resume, text: CONTINUE, steering: initialized.steering }
          }
        }
        const sessionId = try client.newSession(checkout.dir)
        checkpoint = { ...checkpoint, sessionId }
        try save()
        return {
          sessionId,
          text: promptOf(job.task, job.generation > 1 || options.resume !== undefined),
          steering: initialized.steering
        }
      }.pipe(Effect.result),
      signal
    )
    if (isSignal(opened)) return try stopped(opened, undefined, undefined)
    if (opened._tag === "Failure") return failure(opened.failure)
    const { sessionId, steering, text } = opened.success
    // The turn in flight. A steer may replace it: `replacing` says its end is the cancel the steer asked for, and
    // `turns` takes each turn a steer started.
    let turn = try Effect.forkScoped(client.prompt(sessionId, text))
    let open = true
    let replacing = false
    const turns = try Queue.unbounded<void>()
    const prompt = (steer: AgentRunner.Steer) =>
      effect {
        turn = try Effect.forkScoped(client.prompt(sessionId, `${steer.text}\n\n${STEER_CONTINUE}`))
        open = true
        awaiting = [...awaiting, steer.id]
        try Queue.offer(turns, undefined)
      }
    /** Hands one steer to the agent: into the turn in flight when it can, else as the next prompt. */
    const handOver = (steer: AgentRunner.Steer) =>
      effect {
        const startedAt = Date.now()
        if (open && steering && profile.steering !== "prompt") {
          const taken = try client.steer(sessionId, steer.text).pipe(Effect.orElseSucceed(() => false))
          if (taken) {
            awaiting = [...awaiting, steer.id]
            try options.spool.append(Transcript.KINDS.steer, { id: steer.id, mode: "steering" })
            return try steerLog(steer.id, {
              mode: "steering",
              outcome: "handed",
              durationMs: Date.now() - startedAt
            })
          }
        }
        // No turn in flight: the steer starts the next one. Else the only way every ACP agent takes it: cancel the
        // turn, then prompt.
        const mode = open ? "cancel_prompt" : "prompt"
        if (open) {
          replacing = true
          // Seen before the cancel, so a command the cancel orphans is still stopped with the session.
          try tree.observe
          try client.cancel(sessionId).pipe(Effect.ignore)
          try Fiber.await(turn).pipe(Effect.timeout(STEER_CANCEL_WAIT_MS), Effect.ignore)
        }
        // Marked before the prompt that carries it, so the agent's answer follows it in the transcript.
        try options.spool.append(Transcript.KINDS.steer, { id: steer.id, mode })
        try prompt(steer)
        try steerLog(steer.id, { mode, outcome: "handed", durationMs: Date.now() - startedAt })
      }
    try effect {
      while (true) {
        const steer = try Queue.take(control.steers)
        // Never twice: one handed over before a restart, read or not, is the agent's already.
        if (ledger[steer.id] !== undefined) continue
        ledger[steer.id] = "handed"
        try save()
        try handOver(steer)
      }
    }.pipe(Effect.forkScoped)
    let stop: Acp.StopReason
    while (true) {
      const awaited = turn
      const first = try Effect.raceFirst(Fiber.await(awaited), signal)
      if (isSignal(first)) return try stopped(first, sessionId, turn)
      // Every prompt turn that ends says why, a turn a steer cancelled included.
      if (Exit.isSuccess(first)) try options.spool.append(Transcript.KINDS.turn, { stopReason: first.value })
      if (awaited !== turn) {
        // A steer replaced the turn while this one ended: the next one is the turn to wait on.
        replacing = false
        continue
      }
      if (Exit.isSuccess(first) && first.value === "cancelled" && replacing) {
        // The cancel a steer asked for: wait for the turn it starts.
        replacing = false
        const next = try Effect.raceFirst(Queue.take(turns), signal)
        if (isSignal(next)) return try stopped(next, sessionId, turn)
        continue
      }
      open = false
      if (Exit.isFailure(first)) {
        const error = Option.getOrUndefined(Cause.findErrorOption(first.cause))
        return error === undefined ? ended(failed("agent"), "exit") : failure(error)
      }
      stop = first.value
      if (stop === "refusal") return ended(retry("refusal") ?? failed("agent"), stop)
      if (stop !== "end_turn") return ended(failed("agent"), stop)
      // The turn ended; the agent may still be talking, or a steer may start another turn. Collect once it has been
      // quiet a while.
      const endedAt = Date.now()
      const quiet = effect {
        while (Date.now() - lastUpdate < QUIET.afterMs && Date.now() - endedAt < QUIET.maxMs) {
          try Effect.sleep(Math.max(10, Math.min(QUIET.afterMs - (Date.now() - lastUpdate), 1000)))
        }
        try Effect.logInfo("runner.quiet").pipe(
          Effect.annotateLogs({ job: job.key, waitedMs: Date.now() - endedAt })
        )
      }
      const settled = try Effect.raceAll([
        quiet.pipe(Effect.as("quiet" as const)),
        Queue.take(turns).pipe(Effect.as("steered" as const)),
        signal
      ])
      if (settled === "steered") continue
      if (settled !== "quiet") return try stopped(settled, sessionId, undefined)
      break
    }
    try Tree.stop(tree, { graceMs: 2000, settleMs: 5000 }).pipe(Effect.ignore)
    const changes = try Effect.exit(Workspace.changes(checkout, job.task.base, job.task.limits, options.mirror))
    if (Exit.isFailure(changes)) return ended(failed("workspace"), stop)
    if (changes.value === undefined) return ended(failed("too_large"), stop)
    const summary = options.scrub(current !== "" ? current : previous)
    return ended({ _tag: "Done", changes: changes.value, summary, usage }, stop)
  }
