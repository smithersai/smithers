/**
 * `smthrs runner serve`: the claim loop.
 *
 * The runner claims while it has room and its machine admits another job
 * ({@link Admission}: under half load, over the disk floor), starting each
 * claimed job as its `runner/Job` execution, and keeps every running job's claim with a
 * heartbeat. A heartbeat that says `cancel` stops the job's agent and the job
 * settles cancelled; one that says the claim no longer holds the job
 * interrupts it, which stops the agent's whole tree, and nothing is settled.
 * A heartbeat also hands the job's work each message a person sent its agent
 * (once each, whatever the host repeats), and tells the host which of them the
 * agent read, until the host stops listing them.
 * A runner that restarts lists no running jobs, so the host hands back the
 * claims it still holds (`reclaimed`), and each one's execution resumes from
 * the runner's journal.
 *
 * @since 1.0.0
 */

import * as AgentRunner from "@smthrs/agent/AgentRunner"
import * as Admission from "./Admission.ts"
import type * as Config from "./Config.vibe"
import * as Host from "./Host.vibe"
import * as Job from "./Job.vibe"
import * as Machine from "./Machine.ts"
import type * as Session from "./Session.vibe"
import * as Workspace from "./Workspace.ts"

const isAccount = Schema.is(AgentRunner.Profile)

/** How often the serve loop does the checkout removals owed (`Workspace.sweep`). */
const SWEEP_SECONDS = 2

/**
 * What the runner logs while the host refuses its claims `403`: no registration
 * through its repository's Admin role authorized it (decision 0148; migration
 * `0095_runner_reauthorization` cleared every earlier one), so it claims nothing until an Admin of the
 * repository registers it again with its token's SHA-256.
 *
 * @category constants
 * @since 1.0.0
 */
export const NOT_AUTHORIZED_HINT = "this runner needs re-registration: an Admin of its repository registers it again " +
  "with PUT /api/repos/<owner>/<name>/runners/<runner> and its token's SHA-256 " +
  "(apps/mvp/docs/features/agent-runners.md#registering-a-runner-again)"

/**
 * Runs the claim loop under `config`, forever or until it served no job for
 * `idleExitSeconds`, with `controls` shared with the
 * job's registration (`Job.registration`), reading the machine with `read`
 * before each claim.
 *
 * @category constructors
 * @since 1.0.0
 */
export const loop = (
  config: Config.Checked,
  controls: Map<string, Session.Control>,
  read: () => Machine.Reading = () => Machine.read(config)
) =>
  effect {
    const host = try Host.Host
    // A runner killed before it could end its provisioning commands' process groups ends them first (decision 0148).
    try Workspace.reapGroups(config.stateDir)
    try Workspace.watchGroups(config.stateDir)
    const running = new Map<string, Fiber.Fiber<unknown, unknown>>()
    const profiles = Object.keys(config.profiles)
    let held: string | undefined

    /** Beats for one job until its claim is lost: then the job's `dropped` completes. */
    const heartbeat = effect (job: AgentRunner.Job, control: Session.Control) => {
      const offered = new Set<string>()
      while (true) {
        try Effect.sleep(`${config.heartbeatSeconds} seconds`)
        const delivered = [...control.delivered]
        const { account, cpuSeconds, usage } = control.stats
        const beat = try Effect.result(host.heartbeat({
          key: job.key,
          claim: job.claim,
          ...(delivered.length === 0 ? {} : { delivered }),
          // A label the protocol can't carry (a path, say) is left out rather than refused with the beat.
          ...(account === undefined || !isAccount(account) ? {} : { account }),
          ...(cpuSeconds === undefined ? {} : { cpuSeconds: Math.round(cpuSeconds * 100) / 100 }),
          ...(usage === undefined ? {} : { usage })
        }))
        if (beat._tag === "Failure") {
          // Refused for want of authorization or authentication (decision 0148: cleared, uninstalled, or a token
          // rotated or retired): suspended, never ended, and beating on until the host takes the runner again. Only
          // an authenticated answer that the claim no longer holds ends the job's work.
          if (Host.authorizationLost(beat.failure)) {
            try suspend(job, control)
            // A Stop the host still tells a runner it no longer takes: it ended the job, so the work ends too.
            if (beat.failure.cancel === true) {
              try Deferred.succeed(control.hostEnded, undefined)
              try Deferred.succeed(control.cancel, undefined)
            }
            continue
          }
          if (beat.failure.code === "refused") return try drop(job, control)
          // An unreachable host doesn't prove the claim is gone: keep working, and keep asking.
          try (Effect.logWarning("runner.heartbeat")
            |> Effect.annotateLogs({ job: job.key, outcome: beat.failure.code })(%))
          continue
        }
        if (!beat.success.held) return try drop(job, control)
        try authorized(job, control)
        if (beat.success.cancel) try Deferred.succeed(control.cancel, undefined)
        const steers = beat.success.steers ?? []
        // A delivered steer the host no longer lists was recorded there; one it still lists is acknowledged again.
        for (const id of delivered) if (!steers.some((steer) => steer.id === id)) control.delivered.delete(id)
        for (const steer of steers) {
          if (offered.has(steer.id)) continue
          offered.add(steer.id)
          try Queue.offer(control.steers, steer)
        }
      }
    }

    /**
     * Suspends a job the host refuses `403 not_authorized` (decision 0148): its work stops the agent and keeps
     * everything, and waits; nothing of the job ends or is deleted.
     */
    const suspend = effect (job: AgentRunner.Job, control: Session.Control) => {
      if (try Deferred.isDone(control.authorization.suspended)) return
      try control.authorization.latch.close
      try Deferred.succeed(control.authorization.suspended, undefined)
      try (Effect.logError("runner.job")
        |> Effect.annotateLogs({ job: job.key, outcome: "suspended", hint: NOT_AUTHORIZED_HINT })(%))
    }

    /** Resumes a suspended job once the host takes the runner's heartbeat again. */
    const authorized = effect (job: AgentRunner.Job, control: Session.Control) => {
      if (!(try Deferred.isDone(control.authorization.suspended))) return
      control.authorization.suspended = try Deferred.make<void>()
      try control.authorization.latch.open
      try (Effect.logInfo("runner.job") |> Effect.annotateLogs({ job: job.key, outcome: "resumed" })(%))
    }

    const drop = (job: AgentRunner.Job, control: Session.Control) =>
      Effect.logWarning("runner.job")
      |> Effect.annotateLogs({ job: job.key, outcome: "claim_lost" })(%)
      |> Effect.andThen(%, Deferred.succeed(control.dropped, undefined))
      |> Effect.asVoid(%)

    const start = effect (job: AgentRunner.Job) => {
      const control: Session.Control = {
        cancel: try Deferred.make<void>(),
        dropped: try Deferred.make<void>(),
        authorization: { suspended: try Deferred.make<void>(), latch: try Latch.make(true) },
        hostEnded: try Deferred.make<void>(),
        reclaimed: job.reclaimed,
        steers: try Queue.unbounded<AgentRunner.Steer>(),
        delivered: new Set(),
        stats: {}
      }
      controls.set(job.key, control)
      const payload: Session.JobPayload = {
        key: job.key,
        claim: job.claim,
        generation: job.generation,
        task: job.task,
        deadline: job.deadline
      }
      const execution = Job.RunnerJob.execute(payload, { executionId: job.key })
        |> Effect.tap(%, (settled) =>
          Effect.logInfo("runner.job") |> Effect.annotateLogs({ job: job.key, ...settled })(%))
        // A job that couldn't settle (its retries ran out) is the host's to time out; an interruption is the
        // runner stopping, and stays one.
        |> Effect.catchCause(%, (cause) =>
          Cause.hasInterruptsOnly(cause)
            ? Effect.failCause(cause)
            : (Effect.logWarning("runner.job")
              |> Effect.annotateLogs({
                job: job.key,
                outcome: "not_settled",
                errorTag: String((Cause.squash(cause) as { readonly _tag?: unknown } | undefined)?._tag ?? "defect")
              })(%)))
      // The job's work watches its control, so a lost claim stops the agent and its settlement is fenced off;
      // the execution itself always runs to its end.
      const fiber = try (execution
        |> Effect.raceFirst(%, heartbeat(job, control) |> Effect.andThen(%, Effect.never))
        |> Effect.ensuring(
          %,
          Effect.sync(() => {
            running.delete(job.key)
            controls.delete(job.key)
          })
        )
        |> Effect.forkDetach(%))
      running.set(job.key, fiber)
      try (Effect.logInfo("runner.claim")
        |> Effect.annotateLogs({ job: job.key, generation: job.generation, reclaimed: job.reclaimed })(%))
    }

    // The removals owed for checkouts whose jobs ended (`Workspace.scheduleRemoval`), done apart from any job's slot,
    // every few seconds, after a restart too.
    // A sweep that fails anyhow is logged and the fiber goes on: it never ends for good while the runner serves.
    try (Workspace.sweep(config.stateDir)
      |> Effect.catchCause(%, (cause) =>
        Cause.hasInterruptsOnly(cause)
          ? Effect.failCause(cause)
          : (Effect.logError("runner.sweep") |> Effect.annotateLogs({ outcome: "failed" })(%)))
      |> Effect.andThen(%, Effect.sleep(`${SWEEP_SECONDS} seconds`))
      |> Effect.forever(%)
      |> Effect.forkChild(%))
    let backoff = 1
    let admission = Admission.initial
    let busyAt = try Clock.currentTimeMillis
    while (true) {
      const now = try Clock.currentTimeMillis
      if (running.size > 0) {
        busyAt = now
      } else if (config.idleExitSeconds !== undefined && now - busyAt >= config.idleExitSeconds * 1000) {
        // An overflow box's runner ends when the overflow is gone, and its machine sleeps (decision 0144).
        try (Effect.logInfo("runner.idle_exit") |> Effect.annotateLogs({ idleSeconds: config.idleExitSeconds })(%))
        return
      }
      const reading = read()
      const decisionAt = try Clock.currentTimeMillis
      const decision = try Effect.orDie(Effect.try({
        try: () =>
          Admission.decide(config.admission, admission, reading, decisionAt),
        catch: (error) => error
      }))
      admission = decision.state
      const room = config.capacity - running.size
      // A held or full runner still asks, with no room and no wait: its machine row stays current and says why, and
      // a job it holds but doesn't list comes back.
      const free = decision.held === undefined ? Math.max(0, room) : 0
      // A runner that ends when idle never waits on the host past its idle time.
      const wait = config.idleExitSeconds === undefined ? 25 : Math.min(25, config.idleExitSeconds)
      const claimed = try Effect.result(
        host.claim({
          profiles,
          free,
          running: [...running.keys()],
          waitSeconds: free > 0 ? wait : 0,
          machine: try Effect.orDie(Effect.try({
            try: () => Machine.facts(reading, decision.held),
            catch: (error) => error
          })),
          ...(config.minQueuedSeconds === undefined ? {} : { minQueuedSeconds: config.minQueuedSeconds })
        })
      )
      if (claimed._tag === "Failure") {
        if (Host.authorizationLost(claimed.failure)) {
          // No registration through its repository's Admin role authorized this runner, or its token is no longer
          // the registered one (decision 0148).
          try (Effect.logError("runner.claim") |> Effect.annotateLogs({
            outcome: "not_authorized",
            hint: NOT_AUTHORIZED_HINT
          })(%))
        } else {
          try (Effect.logWarning("runner.claim") |> Effect.annotateLogs({ outcome: claimed.failure.code })(%))
        }
        try Effect.sleep(`${backoff} seconds`)
        backoff = Math.min(30, backoff * 2)
        continue
      }
      backoff = 1
      const job = claimed.success
      if (job === null || running.has(job.key)) {
        if (decision.held !== held) {
          held = decision.held
          try (Effect.logInfo("runner.admission")
            |> Effect.annotateLogs({ held: held ?? "none", load1: reading.load1, cpus: reading.cpus })(%))
        }
        try Effect.sleep(`${config.pollSeconds} seconds`)
        continue
      }
      if (!job.reclaimed) {
        const claimedAt = try Clock.currentTimeMillis
        admission = try Effect.orDie(Effect.try({
          try: () => Admission.claimed(admission, claimedAt),
          catch: (error) => error
        }))
      }
      try start(job)
    }
  }
