/**
 * The complete flow catalog, read the same way by `ls`, `flow list`, and
 * `doctor`: from a control plane's pages, or from the local discovery snapshot.
 *
 * @since 1.0.0
 */

import { type Control, ControlSchema } from "@smthrs/control"
import { Descriptor, Registry } from "@smthrs/registry"
import { Effect } from "effect"
import * as CliError from "../CliError.vibe"
import * as BoundedEvents from "../internal/BoundedEvents.vibe"
import * as FeaturedFlows from "../internal/FeaturedFlows.ts"
import * as Unsupported from "../Unsupported.ts"

/**
 * One page of the flow listing.
 * @category models
 * @since 1.0.0
 */
export type FlowPage = Extract<ControlSchema.ListResponse, { readonly _tag: "flows" }>

/**
 * Every page, bounded by the history limits so a runaway registry cannot
 * exhaust the process.
 * @category constructors
 * @since 1.0.0
 */
export const read = effect (control: Control.Service) => {
  const items: Array<FlowPage["items"][number]> = []
  const warnings: Array<NonNullable<FlowPage["warnings"]>[number]> = []
  const warningKeys = new Set<string>()
  const cursors = new Set<string>()
  let bytes = 0
  let entries = 0
  const reserve = (value: unknown) =>
    Effect.suspend(() => {
      const nextBytes = bytes + BoundedEvents.encodedBytes(value)
      if (entries >= BoundedEvents.maximumEvents || nextBytes > BoundedEvents.maximumBytes) {
        return Effect.fail(
          new CliError.ResourceLimitError({
            operation: "flow listing",
            subject: "the discovered registry",
            limit: nextBytes > BoundedEvents.maximumBytes ? BoundedEvents.maximumBytes : BoundedEvents.maximumEvents,
            unit: nextBytes > BoundedEvents.maximumBytes ? "bytes" : "events"
          })
        )
      }
      bytes = nextBytes
      entries += 1
      return Effect.void
    })
  let cursor: string | undefined
  for (;;) {
    const listed = try control.list({
      _tag: "flows",
      limit: ControlSchema.maxPageSize,
      ...(cursor === undefined ? {} : { cursor })
    })
    if (listed._tag !== "flows") {
      throw new CliError.UnsupportedError({ message: "the control plane returned a run page for a flow listing" })
    }
    for (const item of listed.items) {
      try reserve(item)
      items.push(item)
    }
    for (const warning of listed.warnings ?? []) {
      const key = `${warning.code}\0${warning.path}\0${warning.message}`
      if (!warningKeys.has(key)) {
        try reserve(warning)
        warningKeys.add(key)
        warnings.push(warning)
      }
    }
    if (listed.nextCursor === undefined) break
    if (cursors.has(listed.nextCursor)) {
      throw new CliError.UnsupportedError({ message: "the control plane repeated a flow-listing cursor" })
    }
    try reserve(listed.nextCursor)
    cursors.add(listed.nextCursor)
    cursor = listed.nextCursor
  }
  return { items, warnings }
}

/**
 * The project's discovered flows, read from the discovery snapshot without
 * opening the control or execution databases. Reserved `system/*` flows belong
 * to the control plane, which lists them only for an empty registry; every
 * listing hides them and `plan` and `up` refuse them.
 * @category constructors
 * @since 1.0.0
 */
export const discovered: Pick<FlowPage, "items" | "warnings">!never!Registry.Registry = effect {
  const registry = try Registry.Registry
  const [descriptors, warnings] = try Effect.all([registry.list(), registry.warnings()])
  return {
    items: descriptors.map((descriptor) => {
      const inputSchema = Descriptor.inputDocument(descriptor.input)
      return {
        flowId: descriptor.name,
        description: descriptor.description,
        ...(inputSchema === undefined ? {} : { inputSchema })
      }
    }),
    warnings
  }
}

/**
 * The listing document: reserved system flows removed, featured rows applied
 * from the project's generated factory projection when one is checked in,
 * discovery warnings when there are any, and the homepage's apps when the
 * project declares any.
 * @category constructors
 * @since 1.0.0
 */
export const listing = (
  items: FlowPage["items"],
  projectRoot: string,
  warnings: NonNullable<FlowPage["warnings"]> = []
) => {
  const apps = FeaturedFlows.apps(projectRoot)
  return {
    _tag: "flows" as const,
    items: FeaturedFlows.present(
      items.filter((item) => !Unsupported.isReservedFlow(item.flowId)),
      FeaturedFlows.read(projectRoot)
    ),
    // Discovery warnings ride the page as the control plane's listing carries them.
    ...(warnings.length === 0 ? {} : {
      warnings: warnings.map((warning) => ({
        code: warning.code,
        path: warning.path,
        ...(warning.name === undefined ? {} : { name: warning.name }),
        message: warning.message
      }))
    }),
    // The homepage's apps ride the listing when the project declares any (PRODUCT.md D-18).
    ...(apps.length === 0 ? {} : { apps })
  }
}
