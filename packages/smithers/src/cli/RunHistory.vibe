/** Bounded, streaming history for diagnosis; raw log readers keep their strict limits.
 * @since 1.0.0
 */

import { BoundedJson } from "@smthrs/canonical"
import type { ControlSchema } from "@smthrs/control"
import { Effect, Stream } from "effect"
import * as CliError from "../CliError.vibe"
import { shellQuote } from "../Forensics.vibe"
import * as BoundedEvents from "../internal/BoundedEvents.vibe"
import { terminalSafeJson } from "../internal/Failure.ts"

/** One omitted JSON value, measured including its JSON quotes and escapes.
 * @since 1.0.0
 * @private
 */
export interface FieldSize {
  readonly path: string
  readonly bytes: number
}

const pointer = (key: string): string => key.replaceAll("~", "~0").replaceAll("/", "~1")
const childPath = (parent: string, key: string): string | undefined => {
  if (key.length > 256) return undefined
  const path = `${parent}/${pointer(key)}`
  return new TextEncoder().encode(path).length <= 2048 ? path : undefined
}
const object = (value: unknown): Record<string, unknown> | undefined =>
  value !== null && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : undefined

/** Exact JSON bytes without serializing a composite value or a large string.
 * Formatted output includes the CLI's terminal-safe JSON escaping.
 * @since 1.0.0
 * @private
 */
export const jsonBytes = (value: unknown, format?: {
  readonly indent: number
  readonly initialDepth: number
  readonly maxDepth: number
  readonly maxBytes: number
}): number => {
  let bytes = 0
  const indent = format?.indent ?? 0
  const maxBytes = format?.maxBytes ?? Infinity
  const members = function*(item: Record<string, unknown>, depth: number): Generator<unknown> {
    let count = 0
    for (const key in item) {
      if (!Object.hasOwn(item, key)) continue
      if (count++ > 0) bytes++
      if (indent > 0) bytes += 1 + indent * (depth + 1)
      yield key
      bytes += 1 + (indent > 0 ? 1 : 0)
      yield item[key]
    }
    if (count > 0 && indent > 0) bytes += 1 + indent * depth
  }
  const stack: Array<{ iterator: Iterator<unknown>; depth: number }> = [{
    iterator: [value].values(),
    depth: format?.initialDepth ?? 0
  }]
  while (stack.length > 0) {
    if (bytes > maxBytes) return Infinity
    const frame = stack[stack.length - 1]!
    const next = frame.iterator.next()
    if (next.done) {
      stack.pop()
      continue
    }
    if (frame.depth > (format?.maxDepth ?? Infinity)) return Infinity
    const item = next.value
    if (typeof item === "string") {
      if (format !== undefined) {
        bytes += 2
        for (const character of item) {
          bytes += new TextEncoder().encode(terminalSafeJson(JSON.stringify(character))).length - 2
          if (bytes > maxBytes) return Infinity
        }
      } else {
        const valid = BoundedJson.encodedStringBytes(item)
        if (valid !== undefined) bytes += valid
        else {
          bytes += 2
          for (const char of item) bytes += new TextEncoder().encode(JSON.stringify(char)).length - 2
        }
      }
    } else if (Array.isArray(item)) {
      bytes += 2 + Math.max(0, item.length - 1)
      if (item.length > 0 && indent > 0) {
        bytes += item.length + 1 + indent * (item.length * (frame.depth + 1) + frame.depth)
      }
      stack.push({ iterator: item.values(), depth: frame.depth + 1 })
    } else {
      const record = object(item)
      if (record === undefined) bytes += new TextEncoder().encode(JSON.stringify(item) ?? "null").length
      else {
        bytes += 2
        stack.push({ iterator: members(record, frame.depth), depth: frame.depth + 1 })
      }
    }
  }
  return bytes
}

const keepLargest = (fields: Array<FieldSize>, field: FieldSize, limit = 20) => {
  fields.push(field)
  fields.sort((a, b) => b.bytes - a.bytes || a.path.localeCompare(b.path))
  if (fields.length > limit) fields.pop()
}

/** Metadata appears only when a diagnosis omits data. Paths are JSON pointers,
 * with event sequence numbers rather than array offsets under /events.
 * @since 1.0.0
 * @private
 */
export interface Omission {
  readonly events: number
  readonly bytes: number
  readonly omittedEvents: number
  readonly omittedBytes: number
  readonly truncatedFields: ReadonlyArray<FieldSize>
  readonly truncatedFieldsOmitted: number
  readonly largestFields: ReadonlyArray<FieldSize>
  readonly currentNode?: string
  readonly currentNodeUnavailable?: true
  readonly lastRecordedNode?: string
  readonly round?: number
  readonly lastError?: unknown
  readonly read: string
}

/** The legacy projection receives the identical events for small histories.
 * @since 1.0.0
 * @private
 */
export interface History {
  readonly events: ReadonlyArray<ControlSchema.ControlEvent>
  readonly history?: Omission
}

/** Read the stream once, retaining a bounded recent window and bounded field receipts.
 * @since 1.0.0
 * @private
 */
export const read = <E, R>(
  stream: Stream.Stream<ControlSchema.ControlEvent, E, R>,
  runId: string,
  limits: BoundedEvents.Limits = BoundedEvents.defaultLimits,
  selectedExecutionId: string = runId
): History!E!R =>
  Effect.suspend(() => {
    let queue: Array<{ event: ControlSchema.ControlEvent; bytes: number; originalBytes: number } | undefined> = []
    let head = 0
    let retained = 0
    let events = 0
    let bytes = 0
    let omittedEvents = 0
    let omittedBytes = 0
    let truncatedCount = 0
    const truncatedFields: Array<FieldSize> = []
    const largestFields: Array<FieldSize> = []
    let currentNode: string | undefined
    let currentNodeAt = -1
    let currentNodeExecution: string | undefined
    let lastRecordedNode: string | undefined
    let terminal = false
    let previousSequence: number | undefined
    let member = 0
    let nodeEvidenceLost = false
    const running = new Map<string, { executionId: string; name: string; at: number }>()
    const generations = new Map<string, number>()
    let round: number | undefined
    let lastError: unknown
    const invalidateExecution = (executionId: string | undefined, rewound = false) => {
      // A child rewind can archive descendants. Without an ancestry graph,
      // no retained current-action evidence is safe across that boundary.
      const all = executionId === undefined || rewound
      for (const [key, node] of running) if (all || node.executionId === executionId) running.delete(key)
      if (all || currentNodeExecution === executionId) {
        currentNode = undefined
        currentNodeAt = -1
        currentNodeExecution = undefined
      }
      if (rewound) {
        terminal = false
        lastRecordedNode = undefined
        round = undefined
      }
    }
    const admitProjection = (payload: Record<string, unknown> | undefined, gap: boolean): boolean => {
      const executionId = payload?.executionId
      const generation = payload?.generation === undefined && !gap ? 0 : payload?.generation
      if (
        typeof executionId !== "string" || executionId.length === 0 || executionId.length > 256 ||
        !(gap && (generation === null || generation === undefined)) &&
          !(typeof generation === "number" && Number.isSafeInteger(generation) && generation >= 0)
      ) {
        nodeEvidenceLost = true
        invalidateExecution(undefined)
        return false
      }
      const previous = generations.get(executionId)
      if (typeof generation === "number") {
        if (generation < (previous ?? 0)) return false
        // Generation zero needs no watermark. Retain only rewound executions,
        // so ordinary completed children do not consume the bounded budget.
        if (generation > (previous ?? 0)) {
          if (previous === undefined && generations.size >= 128) {
            nodeEvidenceLost = true
            invalidateExecution(undefined)
            return false
          }
          invalidateExecution(executionId, true)
          generations.set(executionId, generation)
        }
      }
      if (gap) invalidateExecution(executionId, payload?.reason === "rewound")
      return true
    }
    const omit = (path: string, size: number) => {
      truncatedCount++
      keepLargest(truncatedFields, { path, bytes: size })
      return null
    }
    // Bound copied containers and leaves as well as the complete retained window.
    const compact = (value: unknown, path: string, budget: number, depth = 0): unknown => {
      const size = jsonBytes(value)
      if (size <= budget) return value
      if (depth >= 32 || value === null || typeof value !== "object") return omit(path, size)
      const array = Array.isArray(value)
      const result: Record<string, unknown> = Object.create(null)
      const list: Array<unknown> = []
      let remaining = Math.max(0, budget - 2)
      let count = 0
      for (const key in value) {
        if (!Object.hasOwn(value, key)) continue
        const item = (value as Record<string, unknown>)[key]
        const cost = array ? 1 : jsonBytes(key) + 2
        if (++count > 256 || cost + 4 > remaining) return omit(path, size)
        remaining -= cost
        const child = childPath(path, key)
        if (child === undefined) return omit(path, size)
        const copy = compact(item, child, Math.min(remaining, 64 * 1024), depth + 1)
        remaining -= jsonBytes(copy)
        if (array) list.push(copy)
        else result[key] = copy
      }
      return array ? list : result
    }
    return Stream.runForEach(stream, (event) =>
      Effect.sync(() => {
        const size = jsonBytes(event) + 1
        events++
        bytes += size
        member = event.sequence === previousSequence ? member + 1 : 0
        previousSequence = event.sequence
        const path = `/events/${event.sequence}${member === 0 ? "" : `:${member}`}`
        const payload = object(event.payload)
        const related = event.runId === undefined || event.runId === runId
        const native = event.kind === "control.engine.event"
        const gap = event.kind === "control.engine.projection-gap"
        const admitted = related && (native || gap) && admitProjection(payload, gap)
        for (const [key, value] of Object.entries(payload ?? {})) {
          const child = childPath(`${path}/payload`, key)
          if (child === undefined) {
            keepLargest(largestFields, { path: `${path}/payload`, bytes: jsonBytes(event.payload) })
            break
          }
          keepLargest(largestFields, { path: child, bytes: jsonBytes(value) })
        }
        if (native && admitted) {
          const body = object(payload?.payload)
          const executionId = payload?.executionId
          const nodeId = body?.nodeId
          if (
            typeof executionId === "string" && typeof nodeId === "string" &&
            (payload?.eventType === "flows.engine.node-scheduled" || payload?.eventType === "flows.engine.node-settled")
          ) currentNode = undefined
          if (typeof executionId === "string" && typeof nodeId === "string") {
            if (executionId.length > 256 || nodeId.length > 256) nodeEvidenceLost = true
            else {
              const identity = JSON.stringify([executionId, nodeId])
              if (payload?.eventType === "flows.engine.node-settled") running.delete(identity)
              if (payload?.eventType === "flows.engine.node-scheduled" && body?.kind === "ActionCall") {
                const name = typeof body.action === "string" ? body.action : nodeId
                if (name.length > 1024 || (!running.has(identity) && running.size >= 128)) nodeEvidenceLost = true
                else {
                  running.delete(identity)
                  running.set(identity, { executionId, name, at: events })
                }
              }
            }
          }
          const observation = object(object(body?.executionFact)?.observation)
          if (observation?.executionId === selectedExecutionId && typeof observation.roundOrdinal === "number") {
            round = observation.roundOrdinal
          }
          if (["completed", "failed", "cancelled"].includes(String(observation?.status))) {
            if (observation?.executionId === currentNodeExecution) currentNode = undefined
            for (const [key, node] of running) if (node.executionId === observation?.executionId) running.delete(key)
          }
        }
        if (
          related &&
          ["control.run.completed", "control.run.failed", "control.run.cancelled"].includes(event.kind)
        ) {
          terminal = true
          currentNode = undefined
          running.clear()
        }
        if (related && ["control.run.resume", "control.run.resumed"].includes(event.kind)) {
          terminal = false
          // Scheduling copied after the old terminal event is still stale.
          // A new lifecycle needs fresh evidence; retain generation fences.
          invalidateExecution(undefined)
        }
        const state = object(payload?.state) ?? payload
        const stateEligible = related && !gap && (!native || admitted)
        if (
          stateEligible &&
          (payload?.executionId === undefined || payload.executionId === selectedExecutionId) &&
          typeof state?.currentNode === "string"
        ) {
          lastRecordedNode = state.currentNode.slice(0, 1024)
          currentNode = state.currentNode.length <= 1024 ? state.currentNode : undefined
          currentNodeAt = events
          currentNodeExecution = selectedExecutionId
        }
        if (
          stateEligible &&
          (payload?.executionId === undefined || payload.executionId === selectedExecutionId) &&
          typeof state?.round === "number"
        ) round = state.round
        if (event.kind === "control.run.failed" && (event.runId === undefined || event.runId === runId)) {
          const property = payload?.cause !== undefined && payload.cause !== null ? "cause" : "fault"
          const error = payload?.[property] ?? null
          lastError = jsonBytes(error) <= 4096
            ? error
            : { omitted: true, bytes: jsonBytes(error), path: `${path}/payload/${property}` }
        }
        const projected = size <= limits.maxEventBytes ? event : {
          ...event,
          payload: compact(
            event.payload,
            `${path}/payload`,
            Math.max(4, limits.maxEventBytes - jsonBytes({ ...event, payload: null }) - 1)
          )
        } as ControlSchema.ControlEvent
        const keptSize = jsonBytes(projected) + 1
        queue.push({ event: projected, bytes: keptSize, originalBytes: size })
        retained += keptSize
        while (head < queue.length && (queue.length - head > limits.maxEvents || retained > limits.maxBytes)) {
          retained -= queue[head]!.bytes
          omittedBytes += queue[head]!.originalBytes
          queue[head] = undefined
          omittedEvents++
          head++
        }
        if (head >= 1024) {
          queue = queue.slice(head)
          head = 0
        }
      }))
      |> Effect.map(%, () => ({
        events: queue.slice(head).map((entry) => entry!.event),
        ...(truncatedCount === 0 && omittedEvents === 0 ? {} : {
          history: {
            events,
            bytes,
            omittedEvents,
            omittedBytes,
            truncatedFields,
            truncatedFieldsOmitted: Math.max(0, truncatedCount - truncatedFields.length),
            largestFields,
            ...(() => {
              const active = terminal || nodeEvidenceLost ? undefined : [...running.values()].at(-1)
              const node = terminal ?
                undefined :
                currentNode !== undefined && (active === undefined || currentNodeAt >= active.at)
                ? currentNode
                : active?.name
              return node === undefined ? { currentNodeUnavailable: true as const } : { currentNode: node }
            })(),
            ...(lastRecordedNode === undefined ? {} : { lastRecordedNode }),
            ...(round === undefined ? {} : { round }),
            ...(lastError === undefined ? {} : { lastError }),
            read: `smthrs runs show ${shellQuote(runId)} --field '/events/<sequence>[:<member>]/payload/<field>'`
          }
        })
      }))
      |> Effect.tap(%, (result) =>
        result.history === undefined ? Effect.void : Effect.all([
          Metric.update(Metric.counter("smithers.cli.run_history.truncated"), 1),
          Effect.logDebug("run diagnosis history bounded", {
            events,
            bytes,
            omittedEvents,
            omittedBytes,
            truncatedFields: truncatedCount
          })
        ]))
      |> withSpan(%, "cli.run_history.read")
  })

interface FieldRead {
  readonly path: string
  readonly bytes: number
  readonly value?: unknown
  readonly omitted?: true
  readonly reason?: "rendering-limit"
  readonly page?: {
    readonly offset: number
    readonly length: number
    readonly totalCharacters: number
    readonly nextOffset?: number
  }
}

/** Read one event field by JSON pointer with an independent byte budget.
 * Oversized values report their size; select a child pointer to narrow further.
 * @since 1.0.0
 * @private
 */
export const field = <E, R>(
  stream: Stream.Stream<ControlSchema.ControlEvent, E, R>,
  path: string,
  limit = BoundedEvents.maximumEventBytes,
  page?: { readonly offset: number; readonly length: number }
): FieldRead!(E | CliError.UsageError)!R => {
  if (path.length > 2048 || new TextEncoder().encode(path).length > 2048) {
    return Effect.fail(
      new CliError.UsageError({ message: "--field pointer exceeds 2048 bytes; select a bounded ancestor" })
    )
  }
  const parts = path.split("/").slice(1).map((part) => part.replaceAll("~1", "/").replaceAll("~0", "~"))
  if (!/^\/events\/[0-9]+(?::[0-9]+)?(?:\/|$)/.test(path) || /~(?:[^01]|$)/.test(path)) {
    return Effect.fail(
      new CliError.UsageError({ message: "--field requires /events/<sequence>/<field> (JSON pointer)" })
    )
  }
  return Effect.suspend(() => {
    const [sequence, selected = "0"] = parts[1]!.split(":")
    let offset = -1
    return Stream.filter(stream, (event) => String(event.sequence) === sequence && String(++offset) === selected)
      |> Stream.take(%, 1)
      |> Stream.runCollect(%)
      |> Effect.flatMap(%, (events): FieldRead!CliError.UsageError => {
        let value: unknown = events[0]
        for (const key of parts.slice(2)) {
          if (value === null || typeof value !== "object" || !Object.hasOwn(value, key)) {
            value = undefined
            break
          }
          value = (value as Record<string, unknown>)[key]
        }
        if (value === undefined) return Effect.fail(new CliError.UsageError({ message: `Field not found: ${path}` }))
        const bytes = jsonBytes(value)
        if (typeof value === "string" && (bytes > limit || page !== undefined)) {
          const offset = page?.offset ?? 0
          const length = Math.min(
            page?.length ?? 4096,
            Math.max(0, Math.floor((Math.min(limit, BoundedEvents.maximumEventBytes - 64 * 1024) - 2) / 6))
          )
          const end = Math.min(value.length, offset + length)
          return Effect.succeed({
            path,
            bytes,
            value: value.slice(offset, end),
            page: {
              offset,
              length: end - Math.min(offset, end),
              totalCharacters: value.length,
              ...(end >= value.length ? {} : { nextOffset: end })
            }
          })
        }
        if (page !== undefined) {
          return Effect.fail(new CliError.UsageError({ message: "--offset/--length require a string field" }))
        }
        if (bytes > limit) return Effect.succeed({ path, bytes, omitted: true as const })
        // Reserve space for the CLI envelope, CTA, path and pretty-printing.
        // Measure with a conservative eight wrapper levels; never serialize an
        // oversized or deeply nested response to discover that it is too big.
        const output = jsonBytes({ path, bytes, value }, {
          indent: 2,
          initialDepth: 8,
          maxDepth: 40,
          maxBytes: BoundedEvents.maximumEventBytes - 64 * 1024
        })
        return Effect.succeed(
          Number.isFinite(output)
            ? { path, bytes, value }
            : { path, bytes, omitted: true as const, reason: "rendering-limit" as const }
        )
      })
  })
}

/** Render a bounded structured error or its omission receipt without losing its address.
 * @since 1.0.0
 * @private
 */
export const errorText = (error: unknown): string => {
  const receipt = object(error)
  if (receipt?.omitted === true && typeof receipt.bytes === "number" && typeof receipt.path === "string") {
    return `omitted ${receipt.bytes} bytes; read ${receipt.path}`
  }
  return typeof error === "string" ? error : JSON.stringify(error) ?? "null"
}
