{
  "name": "@smthrs/core",
  "type": "module",
  "version": "1.0.0-rc.16",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Flow metadata and Markdown lowering over @smthrs/flow",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/core"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "flows"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "flows"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Annotations": "./src/Annotations.ts",
    "./Digest": "./src/Digest.ts",
    "./Effects": "./src/Effects.ts",
    "./Flow": "./src/Flow.ts",
    "./Graph": "./src/Graph.ts",
    "./KeyMaterial": "./src/KeyMaterial.ts",
    "./Markdown": "./src/Markdown.ts",
    "./Node": "./src/Node.ts",
    "./Placement": "./src/Placement.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./*/index": null,
      "./Annotations": {
        "import": {
          "types": "./dist/esm/Annotations.d.ts",
          "default": "./dist/esm/Annotations.js"
        },
        "require": {
          "types": "./dist/cjs/Annotations.d.ts",
          "default": "./dist/cjs/Annotations.js"
        }
      },
      "./Digest": {
        "import": {
          "types": "./dist/esm/Digest.d.ts",
          "default": "./dist/esm/Digest.js"
        },
        "require": {
          "types": "./dist/cjs/Digest.d.ts",
          "default": "./dist/cjs/Digest.js"
        }
      },
      "./Effects": {
        "import": {
          "types": "./dist/esm/Effects.d.ts",
          "default": "./dist/esm/Effects.js"
        },
        "require": {
          "types": "./dist/cjs/Effects.d.ts",
          "default": "./dist/cjs/Effects.js"
        }
      },
      "./Flow": {
        "import": {
          "types": "./dist/esm/Flow.d.ts",
          "default": "./dist/esm/Flow.js"
        },
        "require": {
          "types": "./dist/cjs/Flow.d.ts",
          "default": "./dist/cjs/Flow.js"
        }
      },
      "./Graph": {
        "import": {
          "types": "./dist/esm/Graph.d.ts",
          "default": "./dist/esm/Graph.js"
        },
        "require": {
          "types": "./dist/cjs/Graph.d.ts",
          "default": "./dist/cjs/Graph.js"
        }
      },
      "./KeyMaterial": {
        "import": {
          "types": "./dist/esm/KeyMaterial.d.ts",
          "default": "./dist/esm/KeyMaterial.js"
        },
        "require": {
          "types": "./dist/cjs/KeyMaterial.d.ts",
          "default": "./dist/cjs/KeyMaterial.js"
        }
      },
      "./Markdown": {
        "import": {
          "types": "./dist/esm/Markdown.d.ts",
          "default": "./dist/esm/Markdown.js"
        },
        "require": {
          "types": "./dist/cjs/Markdown.d.ts",
          "default": "./dist/cjs/Markdown.js"
        }
      },
      "./Node": {
        "import": {
          "types": "./dist/esm/Node.d.ts",
          "default": "./dist/esm/Node.js"
        },
        "require": {
          "types": "./dist/cjs/Node.d.ts",
          "default": "./dist/cjs/Node.js"
        }
      },
      "./Placement": {
        "import": {
          "types": "./dist/esm/Placement.d.ts",
          "default": "./dist/esm/Placement.js"
        },
        "require": {
          "types": "./dist/cjs/Placement.d.ts",
          "default": "./dist/cjs/Placement.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.16",
    "@smthrs/crypto": "1.0.0-rc.16",
    "@smthrs/flow": "1.0.0-rc.16",
    "@smthrs/plan": "1.0.0-rc.16",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@eslint/js": "9.39.5",
    "@smthrs/engine": "1.0.0-rc.16",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  }
}
