        "require": {
          "types": "./dist/cjs/KeyMaterial.d.ts",
          "default": "./dist/cjs/KeyMaterial.js"
        }
      },
      "./Migrations": null,
      "./Plan": {
        "import": {
          "types": "./dist/esm/Plan.d.ts",
          "default": "./dist/esm/Plan.js"
        },
        "require": {
          "types": "./dist/cjs/Plan.d.ts",
          "default": "./dist/cjs/Plan.js"
        }
      },
      "./Placement": {
        "import": {
          "types": "./dist/esm/Placement.d.ts",
