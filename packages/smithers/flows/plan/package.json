          "default": "./dist/cjs/Effects.js"
        }
      },
      "./CachePolicy": {
        "import": {
          "types": "./dist/esm/CachePolicy.d.ts",
          "default": "./dist/esm/CachePolicy.js"
        },
        "require": {
          "types": "./dist/cjs/CachePolicy.d.ts",
          "default": "./dist/cjs/CachePolicy.js"
        }
      },
      "./Repetition": {
        "import": {
          "types": "./dist/esm/Repetition.d.ts",
          "default": "./dist/esm/Repetition.js"
        },
        "require": {
          "types": "./dist/cjs/Repetition.d.ts",
          "default": "./dist/cjs/Repetition.js"
        }
      },
      "./FileSet": {
        "import": {
          "types": "./dist/esm/FileSet.d.ts",
