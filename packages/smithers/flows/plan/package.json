{
  "name": "@smthrs/plan",
  "type": "module",
  "version": "1.0.0-rc.17",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "The persisted flows plan: a keyed action graph, its append-only store, and its diff",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/plan"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "plan",
    "graph"
  ],
  "keywords": [
    "typescript",
    "effect",
    "plan",
    "graph"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./GraphBuildError": {
      "types": "./.vibe/declarations/src/GraphBuildError.d.vibe.ts",
      "vibelang-source": "./src/GraphBuildError.vibe",
      "default": "./.vibelang/js/src/GraphBuildError.js"
    },
    "./Node": {
      "types": "./src/Node.ts",
      "vibelang-source": "./src/Node.ts",
      "default": "./.vibelang/js/src/Node.js"
    },
    "./Planned": {
      "types": "./.vibe/declarations/src/Planned.d.vibe.ts",
      "vibelang-source": "./src/Planned.vibe",
      "default": "./.vibelang/js/src/Planned.js"
    },
    "./internal/*": null,
    "./*/index": null,
    "./Effects": {
      "types": "./.vibe/declarations/src/Effects.d.vibe.ts",
      "default": {
        "types": "./.vibe/declarations/src/Effects.d.vibe.ts",
        "vibelang-source": "./src/Effects.vibe",
        "default": "./.vibelang/js/src/Effects.js"
      }
    },
    "./CachePolicy": {
      "types": "./.vibe/declarations/src/CachePolicy.d.vibe.ts",
      "vibelang-source": "./src/CachePolicy.vibe",
      "default": "./.vibelang/js/src/CachePolicy.js"
    },
    "./Repetition": {
      "types": "./.vibe/declarations/src/Repetition.d.vibe.ts",
      "vibelang-source": "./src/Repetition.vibe",
      "default": "./.vibelang/js/src/Repetition.js"
    },
    "./FileSet": {
      "types": "./.vibe/declarations/src/FileSet.d.vibe.ts",
      "vibelang-source": "./src/FileSet.vibe",
      "default": "./.vibelang/js/src/FileSet.js"
    },
    "./KeyMaterial": {
      "types": "./.vibe/declarations/src/KeyMaterial.d.vibe.ts",
      "vibelang-source": "./src/KeyMaterial.vibe",
      "default": "./.vibelang/js/src/KeyMaterial.js"
    },
    "./Migrations": null,
    "./Plan": {
      "types": "./src/Plan.ts",
      "vibelang-source": "./src/Plan.ts",
      "default": "./.vibelang/js/src/Plan.js"
    },
    "./Placement": {
      "types": "./.vibe/declarations/src/Placement.d.vibe.ts",
      "vibelang-source": "./src/Placement.vibe",
      "default": "./.vibelang/js/src/Placement.js"
    },
    "./PlanDiff": {
      "types": "./src/PlanDiff.ts",
      "vibelang-source": "./src/PlanDiff.ts",
      "default": "./.vibelang/js/src/PlanDiff.js"
    },
    "./PlanStore": null,
    "./StepKey": {
      "types": "./.vibe/declarations/src/StepKey.d.vibe.ts",
      "vibelang-source": "./src/StepKey.vibe",
      "default": "./.vibelang/js/src/StepKey.js"
    },
    "./Scheduling": {
      "types": "./src/Scheduling.ts",
      "vibelang-source": "./src/Scheduling.ts",
      "default": "./.vibelang/js/src/Scheduling.js"
    },
    "./index": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./test/PlanFixtures": {
      "types": "./src/test/PlanFixtures.ts",
      "vibelang-source": "./src/test/PlanFixtures.ts",
      "default": "./.vibelang/js/src/test/PlanFixtures.js"
    }
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.vibe",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    ".vibelang/js",
    "!.vibelang/js/.loader"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
