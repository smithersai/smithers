/**
 * Bumps the shared execution revision at COMMIT instead of at each run-row write.
 *
 * Every insert, update and delete of a `flows_runs` row increments the one
 * `flows_run_source` row (`0003_execution_revisions`), and journal inserts
 * update the run row through the progress trigger (`0005_run_progress`). On
 * PostgreSQL the increment held that row's lock from the run-row write to the
 * writer's COMMIT, across every later round trip of its transaction, so every
 * writer of every run queued behind whichever transaction bumped it first. On
 * smithers.sh, 2026-11-02, one transaction idle between statements held it
 * while 40 to 46 writers of other runs waited on its transaction id.
 *
 * The same trigger functions now run as deferred constraint triggers, which
 * PostgreSQL fires during COMMIT. The singleton's lock then lives for the
 * commit alone, and revisions still follow commit order, so a change-feed
 * cursor read between two commits misses neither. A savepoint rolled back
 * discards its queued bumps, as it discarded the immediate ones. SQLite
 * serializes every write on its file lock and keeps its immediate triggers.
 *
 * The first `DROP TRIGGER` holds `ACCESS EXCLUSIVE` on `flows_runs` until the
 * whole migration pass commits, blocking every read and write of the table. Ship
 * it in a deploy with no other pending migration, so the pass is this statement.
 *
 * Deferred triggers need readers that flush them. Ship those in an earlier
 * release and keep it as the rollback target: a binary without them reads a null
 * revision for its own insert in one transaction, and fails to decode it.
 *
 * @since 1.0.0
 */

import * as Dialect from "@smthrs/database/Dialect"
import * as Effect from "effect/Effect"
import * as SqlClient from "effect/sql/SqlClient"

/**
 * The three deferred revision triggers on `flows_runs`. The migration runner
 * runs them immediately during a migration pass, and a read that joins a
 * writer's transaction flushes them first (`Dialect.flushDeferredTriggers`).
 *
 * @category migrations
 * @since 1.0.0
 */
export const revisionTriggers: ReadonlyArray<Dialect.DeferredTrigger> = (["insert", "update", "delete"] as const).map(
  (operation) => ["flows_runs", `flows_runs_revision_${operation}`] as const
)

/**
 * Recreates the three `flows_runs_revision_*` triggers as deferred constraint
 * triggers on PostgreSQL.
 *
 * @category migrations
 * @since 1.0.0
 */
export const deferredRevisions: void!unknown!SqlClient.SqlClient = effect {
  const sql = try SqlClient.SqlClient
  if (!Dialect.isPostgres(sql)) {
    return
  }
  // One statement, so the pass spends as few round trips as it can holding the
  // table's ACCESS EXCLUSIVE lock, which the first DROP TRIGGER takes.
  try sql.unsafe(`DO $swap$ BEGIN
    ${
    (["INSERT", "UPDATE", "DELETE"] as const).map((operation) => {
      const name = `flows_runs_revision_${operation.toLowerCase()}`
      return `DROP TRIGGER ${name} ON flows_runs;
    CREATE CONSTRAINT TRIGGER ${name} AFTER ${operation} ON flows_runs
      DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION ${name}_fn();`
    }).join("\n    ")
  }
  END $swap$`)
}
