/**
 * Name-based UUIDs (RFC 9562 §5.5, version 5): the same namespace and name
 * always give the same UUID, on every host, with no coordination.
 *
 * A host that must know an identifier before it can ask anyone, such as a
 * device offline that names the conversation of a branch it already knows,
 * derives it from names both sides share. The digest is SHA-1 through the
 * injected `effect/crypto/Digest` service, as the RFC defines version 5; SHA-1's
 * weakness doesn't matter here, because a name-based UUID is an identifier,
 * never a secret or a proof.
 *
 * @since 1.0.0-rc.17
 */

import * as EffectDigest from "effect/crypto/Digest"
import * as Effect from "effect/Effect"
import { isWellFormed } from "./internal/snapshot.ts"

const pattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const encoder = new TextEncoder()

/**
 * Whether `value` is a UUID in its canonical hyphenated form, in either case.
 *
 * @category validation
 * @since 1.0.0-rc.17
 */
export const isUuid = (value: string): boolean => pattern.test(value)

const bytesOf = (uuid: string): Uint8Array => {
  const hex = uuid.replaceAll("-", "")
  const bytes = new Uint8Array(16)
  for (let index = 0; index < 16; index++) bytes[index] = Number.parseInt(hex.slice(index * 2, index * 2 + 2), 16)
  return bytes
}

const format = (bytes: Uint8Array): string => {
  const hex = Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`
}

/**
 * The version 5 UUID of `name` in `namespace`, in lowercase: SHA-1 of the
 * namespace's 16 bytes followed by the name's UTF-8 bytes, cut to 16 bytes,
 * with the version and variant bits set. A `namespace` that isn't a UUID is a
 * defect, as is a name containing an unpaired UTF-16 surrogate or a host digest
 * that is not a 20-byte Uint8Array. Well-formed names are encoded without
 * Unicode normalization.
 *
 * @category constructors
 * @since 1.0.0-rc.17
 */
export const v5 = effect (
  namespace: string,
  name: string
): string!never!EffectDigest.Digest => {
  if (!isUuid(namespace)) return try Effect.die(new TypeError("Uuid.v5: namespace is not a UUID"))
  if (!isWellFormed(name)) {
    return try Effect.die(new TypeError("Uuid.v5: name contains an unpaired UTF-16 surrogate"))
  }
  const nameBytes = encoder.encode(name)
  const input = new Uint8Array(16 + nameBytes.length)
  input.set(bytesOf(namespace), 0)
  input.set(nameBytes, 16)
  const digest = try (try EffectDigest.Digest).digest(EffectDigest.sha1, input)
  if (!(digest instanceof Uint8Array) || digest.length !== 20) {
    return try Effect.die(new TypeError("Uuid.v5: host digest must be a 20-byte Uint8Array"))
  }
  const bytes = digest.slice(0, 16)
  bytes[6] = (bytes[6]! & 0x0f) | 0x50
  bytes[8] = (bytes[8]! & 0x3f) | 0x80
  return format(bytes)
}
