/**
 * Applies a session's work to a host jj repository.
 *
 * @since 1.0.0
 */

import { RepositoryMutation } from "@smthrs/jj"
import * as Clock from "effect/Clock"
import * as Effect from "effect/Effect"
import * as FileSystem from "effect/FileSystem"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Work } from "../Sandbox/Work.vibe"
import { Conflicted, Merged, MergeError, type Outcome } from "./Outcome.vibe"
import { make as repositoryAt, output, type Repository } from "./Repository.vibe"
import * as $platform from "./apply.platform.ts"
import { recordConflicts, type Strategy } from "./Strategy.vibe"

/**
 * Where and how to apply work.
 *
 * @category models
 * @since 1.0.0
 */
export interface ApplyOptions<E = never, R = never> {
  /** The host jj repository's root directory. */
  readonly repository: string
  /** A jj revision naming one commit, the change's parent: `main`, `trunk()`. */
  readonly onto: string
  /** The change's description. */
  readonly message: string
  /**
   * What makes two applications the same application: the change's id
   * derives from it. Applying with a key already applied answers the existing
   * change's outcome and lands nothing new.
   *
   * Name the application, never what it lands: take it from the step that
   * applies, such as `Action.effectKey("apply")` from `@smthrs/flow` inside a
   * dispatch, or an id recorded before the work ran. A key made of the work's
   * patch would fold two applications of the same patch into one change and
   * land a retry whose patch changed as a second one.
   */
  readonly key: string
  /**
   * Arguments to `jj git fetch` when the work's base is not in the
   * repository: a session usually fetched its checkout from the same remote
   * moments before the host did. Default `[]`, the default remote; `false`
   * never fetches.
   */
  readonly fetch?: ReadonlyArray<string> | false | undefined
  /** What to do when the work conflicts with `onto`. Default {@link recordConflicts}. */
  readonly strategy?: Strategy<E, R> | undefined
}

/**
 * The jj change id for `key`: 16 bytes of its SHA-256 in jj's reverse-hex
 * alphabet, so one key always names one change.
 *
 * @category utils
 * @since 1.0.0
 */
export const changeIdOf = (key: string): Effect.Effect<string> =>
  Effect.promise(() => $platform.sha256(key)).pipe(
    Effect.map((digest) =>
      Array.from(new Uint8Array(digest).slice(0, 16), (byte) => byte.toString(16).padStart(2, "0")).join("")
        .replace(/[0-9a-f]/g, (digit) => "zyxwvutsrqponmlk"[Number.parseInt(digit, 16)]!)
    )
  )

const lines = (text: string): Array<string> => text.split("\n").filter((line) => line !== "")

/**
 * A full SHA-1 or SHA-256 commit id, the only base `Work` promises. Anything
 * else (a bookmark, a revset, a short prefix) still resolves in jj and in
 * `git read-tree`, then fails late as a malformed `parent` header, or lands on
 * whatever the name points at now rather than the commit the session saw.
 */
const fullCommitId = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/

/** The one commit `revision` names, or nothing. */
const single = (repository: Repository, revision: string) =>
  Effect.map(
    repository.jj(["log", "--no-graph", "-r", `present(${revision})`, "-T", "commit_id ++ \"\\n\""]),
    lines
  )

/** The change's current state, read from the repository. */
const outcomeOf = (repository: Repository, change: string) =>
  effect {
    const found = lines(
      try repository.jj([
        "log",
        "--no-graph",
        "-r",
        `change_id(${change})`,
        "-T",
        "commit_id ++ \"\\t\" ++ conflict ++ \"\\t\" ++ parents.map(|p| p.commit_id()).join(\",\") ++ \"\\n\""
      ])
    )
    if (found.length !== 1) {
      throw new MergeError({
        reason: "vcs_failed",
        message: `the change ${change} names ${found.length} commits; resolve the divergence with jj`
      })
    }
    const [commit, conflict, onto] = found[0]!.split("\t") as [string, string, string]
    if (conflict !== "true") return new Merged({ change, commit, onto })
    const paths = lines(
      try repository.jj(["file", "list", "-r", commit, "-T", "if(conflict, path.display() ++ \"\\n\")"])
    )
    return new Conflicted({ change, commit, onto, paths })
  }

/**
 * Lands `work` in the host repository as one jj change on `onto`.
 *
 * The patch is applied to its own base, never to `onto`, so it applies
 * exactly as captured; the change is then rebased onto `onto`, and jj merges
 * whatever `onto` gained since the base. A clean merge answers
 * {@link Merged}. An overlapping edit answers {@link Conflicted}: the change
 * still exists, with jj's conflict markers recorded in it, unless the
 * strategy decides otherwise. {@link Unchanged} work applies as nothing.
 * Changed work whose base is not a full commit id fails with
 * `base_not_found` before any host command runs.
 *
 * Applying is idempotent per key, including after a crash part-way: the
 * change's id derives from the key, and an application interrupted between
 * creating the change and rebasing it finishes on the next attempt.
 *
 * No working copy is read or written. The change is built from git objects
 * in the repository's git store, imported through a short-lived
 * `smithers-sandbox/<change>` bookmark that is deleted once the change is
 * rebased. The host needs `jj` and `git` on its `PATH`, and provides the
 * `@smthrs/jj` `RepositoryMutation` fence (`NodeJj.layerRepositoryMutation`
 * on Node and Bun) so the change never interleaves with the host's own jj
 * operations on the repository.
 *
 * @category constructors
 * @since 1.0.0
 */
export const apply = <E = never, R = never>(
  work: Work,
  options: ApplyOptions<E, R>
): Effect.Effect<Outcome, MergeError | E, R | ChildProcessSpawner | FileSystem.FileSystem | RepositoryMutation> => {
  if (work._tag === "Unchanged") return Effect.succeed(work)
  if (!fullCommitId.test(work.base)) {
    return Effect.fail(
      new MergeError({
        reason: "base_not_found",
        message: `the work's base ${JSON.stringify(work.base)} is not a full commit id`
      })
    )
  }
  return Effect.flatMap(
    RepositoryMutation,
    (mutation) =>
      effect {
        const repository = try repositoryAt(options.repository)
        const change = try changeIdOf(options.key)
        // Fetch before the fences: network latency must not block local snapshots.
        // The fenced reads below re-check presence and resolve the refreshed onto.
        if (
          options.fetch !== false
          && (try single(repository, `change_id(${change})`)).length === 0
          && (try single(repository, work.base)).length === 0
        ) {
          try repository.jj(["git", "fetch", ...(options.fetch ?? [])])
        }
        return try mutation.run(
          "sandbox apply",
          options.repository,
          effect {
            const spawner = try ChildProcessSpawner
            const fs = try FileSystem.FileSystem
            const pending = `smithers-sandbox/${change}`
            const exists = (try single(repository, `change_id(${change})`)).length > 0
            const interrupted = (try single(repository, `bookmarks(exact:"${pending}")`)).length > 0
            if (!exists) {
              if ((try single(repository, work.base)).length === 0) {
                throw new MergeError({
                  reason: "base_not_found",
                  message: `the work's base ${work.base} is not in ${options.repository}`
                })
              }
            }
            const onto = try single(repository, options.onto)
            if (onto.length !== 1) {
              throw new MergeError({
                reason: "onto_unresolved",
                message: `${options.onto} names ${onto.length} commits in ${options.repository}`
              })
            }
            if (!exists) {
              const gitDir = (try repository.jj(["git", "root"])).trim()
              const git = (args: ReadonlyArray<string>, env?: Record<string, string>, stdin?: string) =>
                output(spawner, "git", ["--git-dir", gitDir, ...args], { cwd: options.repository, env, stdin })
              // A private index, so the repository's own index and working copy are untouched.
              const index = { GIT_INDEX_FILE: `${gitDir}/smithers-sandbox-${change}.index` }
              const tree = try Effect.ensuring(
                effect {
                  try git(["read-tree", work.base], index)
                  try Effect.mapError(
                    git(["apply", "--cached", "--binary", "-"], index, work.patch),
                    (cause) =>
                      new MergeError({
                        reason: "patch_rejected",
                        message: `the patch does not apply to its base ${work.base}: ${cause.message}`,
                        cause
                      })
                  )
                  return (try git(["write-tree"], index)).trim()
                },
                Effect.ignore(fs.remove(index.GIT_INDEX_FILE, { force: true }))
              )
              // jj's built-in defaults set both to "", so an unconfigured identity reads as empty.
              const name = (try repository.jj(["config", "get", "user.name"])).trim()
              const email = (try repository.jj(["config", "get", "user.email"])).trim()
              const signature = `${name || "Smithers"} <${email || "sandbox@smithers.invalid"}> ${
                Math.floor((try Clock.currentTimeMillis) / 1000)
              } +0000`
              // jj takes the change id from the commit's `change-id` header on import.
              const commit = (try git(
                ["hash-object", "-t", "commit", "-w", "--stdin"],
                undefined,
                `tree ${tree}\nparent ${work.base}\nauthor ${signature}\ncommitter ${signature}\nchange-id ${change}\n\n${
                  options.message.endsWith("\n") ? options.message : `${options.message}\n`
                }`
              )).trim()
              try git(["update-ref", `refs/heads/${pending}`, commit])
              try repository.jj(["git", "import"])
            }
            if (!exists || interrupted) {
              try repository.jj(["rebase", "-r", `change_id(${change})`, "-d", onto[0]!])
              try repository.jj(["bookmark", "delete", pending])
            }
            // Export may have failed after the pending bookmark was deleted.
            // Recover that phase even when the change already exists.
            try repository.jj(["git", "export"])
            const landed = try outcomeOf(repository, change)
            return landed
          }
        )
      }
  ).pipe(
    Effect.catchTag(
      "@smthrs/jj/JjError",
      (cause) => new MergeError({ reason: "vcs_failed", message: cause.message, cause })
    ),
    Effect.flatMap((landed) =>
      landed._tag === "Conflicted"
        ? Effect.flatMap(
          repositoryAt(options.repository),
          (repository) => (options.strategy ?? recordConflicts).onConflict(landed, repository)
        )
        : Effect.succeed(landed)
    )
  )
}
