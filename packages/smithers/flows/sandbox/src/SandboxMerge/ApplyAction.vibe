/**
 * Durable, recoverable application of captured work.
 *
 * @since 1.0.0
 */

import { Action, RetryPolicy } from "@smthrs/flow"
import { isGitLockContention } from "@smthrs/jj"
import * as Schema from "effect/Schema"
import { Work } from "../Sandbox/Work.ts"
import { apply } from "./apply.ts"
import { MergeError, Outcome } from "./Outcome.vibe"

/**
 * Confirmed shared Git lock contention; only the engine retries it.
 *
 * @category errors
 * @since 1.0.0
 */
export class GitLockContention extends Schema.TaggedError<GitLockContention>()(
  "@smthrs/sandbox/SandboxMerge/GitLockContention",
  { message: Schema.String },
) {}

/**
 * Lands work with a fixed commit target and key. Custom conflict strategies
 * belong in subsequent actions, outside this action's retry boundary.
 *
 * @category actions
 * @since 1.0.0
 */
export const Apply = Action.make("@smthrs/sandbox/SandboxMerge/Apply", {
  implementationVersion: "sandbox-merge/v1",
  payload: {
    work: Schema.toEncoded(Work),
    repository: Schema.String,
    onto: Schema.String.check(Schema.isPattern(/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/)),
    message: Schema.String,
    key: Schema.String,
    fetch: Schema.optional(Schema.Union([Schema.Array(Schema.String), Schema.Literal(false)])),
  },
  success: Outcome,
  error: Schema.Union([MergeError, GitLockContention]),
  retryPolicy: RetryPolicy.make({
    initialMs: 100,
    factor: 1,
    maxMs: 100,
    maxAttempts: 1_201,
    nonRetryable: ["@smthrs/sandbox/SandboxMerge/MergeError"],
  }),
})

/**
 * Implements {@link Apply} with the host's filesystem, spawner and mutation fence.
 * A failed command returns immediately. The engine journals the retry wait.
 *
 * @category layers
 * @since 1.0.0
 */
export const layerApply = Apply.toLayer(({ work, ...options }) =>
  Schema.decodeUnknownEffect(Work)(work)
  |> Effect.orDie(%)
  |> Effect.flatMap(%, (decoded) => apply(decoded, options))
  |> Effect.mapError(%, (error) =>
    error.reason === "vcs_failed" && isGitLockContention(error)
      ? new GitLockContention({ message: error.message })
      // Host errors can carry non-JSON objects. The raw effect preserves them;
      // the action journals only the portable failure fields.
      : new MergeError({
        reason: error.reason,
        message: error.message,
      })), { implementationVersion: "sandbox-merge/v1" })
