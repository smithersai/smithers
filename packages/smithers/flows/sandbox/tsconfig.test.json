{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests share the process-table probe in packages/testing; this config emits nothing.
    "rootDir": "../../..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*"]
}
