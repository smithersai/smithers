// Deep reviewed and polished by a human on 2026-08-10.

/**
 * Defines runtime context carried across action attempts.
 *
 * @since 0.1.0
 */

import * as Context from "effect/Context"
import * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as RpcSerialization from "effect/rpc/RpcSerialization"
import type { CacheEnvironment } from "./CacheEnvironment.vibe"

/**
 * Context reference carrying the complete environment folded into reusable
 * action keys.
 *
 * A composition either provides a complete {@link CacheEnvironment} or leaves
 * it absent. When absent, the engine scopes action keys to the current run
 * instead of presenting incomplete environment data as reusable identity.
 *
 * @category idempotency
 * @since 0.1.0
 */
export const CurrentCacheEnvironment = Context.Reference<CacheEnvironment | undefined>(
  "@smthrs/flow/Action/CurrentCacheEnvironment",
  { defaultValue: () => undefined }
)

/**
 * Declares the complete cache environment of a composition as a layer.
 *
 * **When to use**
 *
 * Use this only when the composition can identify every semantic runtime
 * layer and its complete capability set. Otherwise leave the context absent.
 *
 * @category idempotency
 * @since 0.1.0
 */
export const layerCacheEnvironment = (
  environment: CacheEnvironment
): Layer.Layer<never> => Layer.succeed(CurrentCacheEnvironment)(environment)

/**
 * The ordinal slots a retry sequence shares across its attempts, keyed by
 * allocation scope.
 *
 * `Action.retry` cannot allocate ordinals itself — allocation is scoped by
 * action identity and only the engine knows which action is being
 * dispatched (issue #73) — so it provides an empty map the engine fills per
 * scope on the first attempt and reads back on every later one. The map is
 * scope-keyed rather than a single value because one retry block may
 * dispatch several distinct actions; a shared unkeyed slot handed the
 * first action's ordinal to every later one, silently skipping their own
 * name-scoped counters and aliasing a later independent dispatch onto an
 * in-block key (issue #84).
 *
 * Each scope pins a *sequence* of ordinals rather than a single value
 * (issue #100): one retry block may dispatch the same declaration several
 * times, and a single-valued slot handed the first dispatch's ordinal to
 * every later one, so the second dispatch silently replayed the first's
 * recorded outcome. `cursors` counts the dispatches of each scope within the
 * current attempt — `Action.retry` resets it at every attempt boundary —
 * so the n-th same-scope dispatch of every attempt reuses the n-th pinned
 * ordinal.
 *
 * @category attempts
 * @since 0.1.0
 */
export interface OrdinalSlot {
  readonly values: Map<string, Array<number>>
  readonly cursors: Map<string, number>
}

/**
 * Context reference carrying the ordinal slot of the enclosing
 * `Action.retry` sequence, when present.
 *
 * @category attempts
 * @since 0.1.0
 */
export const CurrentOrdinal = Context.Reference<OrdinalSlot | undefined>(
  "@smthrs/flow/Action/CurrentOrdinal",
  { defaultValue: () => undefined }
)

/**
 * Context reference containing the current action retry attempt, defaulting
 * to `1`.
 *
 * @category attempts
 * @since 0.1.0
 */
export const CurrentAttempt = Context.Reference<number>(
  "@smthrs/flow/Action/CurrentAttempt",
  { defaultValue: () => 1 }
)

/**
 * Context reference carrying the persisted key of the dispatch an
 * implementation is currently running under, when the runtime supplies one.
 *
 * **When to use**
 *
 * Use it in an action implementation that has to name durable state of its
 * own — `Sleep` names a `DurableClock` — so the name it derives belongs to
 * THIS dispatch. The key is the identity the engine already allocated for the
 * dispatch: its attempt rows, its recorded outcome, and its cache row are
 * addressed by it, so it is stable across every replay of one node and
 * distinct between two identical calls of the same declaration. Deriving from
 * it is therefore the only way an implementation gets both properties without
 * allocating a second identity beside the engine's.
 *
 * **Gotchas**
 *
 * A runtime that has not adopted the seam leaves the reference absent rather
 * than substituting a placeholder, because a placeholder would silently alias
 * every dispatch of one declaration onto one name. An implementation that
 * needs durable identity refuses instead.
 *
 * @category idempotency
 * @since 0.1.0
 */
export const CurrentInvocationKey = Context.Reference<string | undefined>(
  "@smthrs/flow/Action/CurrentInvocationKey",
  { defaultValue: () => undefined }
)

/**
 * Context reference carrying the serializer an action's results are stored
 * with (VIP-44): `executeEncoded` encodes with its `codecFor`, and the engine
 * that provides it decodes with `exitSchemasFor` of the same one. Defaults to
 * `RpcSerialization.json`.
 *
 * **When to use**
 *
 * An engine provides it around every dispatch. It is a reference of its own,
 * not the `RpcSerialization` service, so pinning the stored representation
 * never changes the `RpcSerialization` an action body sees.
 *
 * @category serialization
 * @since 1.0.0
 */
export const StoredSerialization = Context.Reference<RpcSerialization.RpcSerialization["Service"]>(
  "@smthrs/flow/Action/StoredSerialization",
  { defaultValue: () => RpcSerialization.json }
)

/**
 * The ownership fence of the attempt an implementation is running under.
 *
 * `runId`, `stepKeyDigest` and `attempt` name the durable attempt row, and
 * `owner` is the engine incarnation that holds the run while the attempt
 * runs. The owner changes when another incarnation takes over a crashed run
 * and adopts its running attempt, and the attempt changes when a failed
 * attempt is retried, so a fence captured by an earlier owner or an earlier
 * attempt names a row state that no longer holds.
 *
 * @category attempts
 * @since 1.0.0
 */
export interface Fence {
  readonly runId: string
  readonly stepKeyDigest: string
  readonly attempt: number
  readonly owner: {
    readonly hostId: string
    readonly pid: number
    readonly nonce: string
  }
}

/**
 * Context reference carrying the ownership fence of the attempt currently
 * running, when the runtime supplies one.
 *
 * **When to use**
 *
 * Use it in an implementation that writes its own durable state, such as an
 * application table it updates while it streams, so a write from an owner or
 * attempt that has been superseded changes nothing. A durable SQL engine
 * supplies it, and `@smthrs/run-store`'s `RunStore.owned` turns it into a
 * condition the implementation adds to its own statement.
 *
 * **Gotchas**
 *
 * A runtime without durable ownership, such as the in-memory engine, leaves it
 * absent rather than inventing one. An implementation that needs fencing
 * refuses instead of writing unfenced.
 *
 * @category attempts
 * @since 1.0.0
 */
export const CurrentFence = Context.Reference<Fence | undefined>(
  "@smthrs/flow/Action/CurrentFence",
  { defaultValue: () => undefined }
)

/**
 * Context reference that is `true` while an implementation runs an attempt
 * an earlier execution started and never settled.
 *
 * A durable engine re-runs such an attempt under its original number: the
 * process running it died or was cut off mid-body, or the body parked on a
 * durable wait and the run resumed. Anything the earlier execution did
 * outside the engine may have happened, so an implementation that cannot
 * repeat it silently (a paid provider call, a message sent) reads this to
 * count, log or reconcile the repeat. A fresh attempt, a retry under a new
 * attempt number, and every runtime without durable attempts read `false`.
 *
 * @category attempts
 * @since 1.0.0
 */
export const CurrentRedispatch = Context.Reference<boolean>(
  "@smthrs/flow/Action/CurrentRedispatch",
  { defaultValue: () => false }
)

/**
 * Context reference carrying the heartbeat of the attempt currently running,
 * which the runtime installs for an action declared with
 * `heartbeatTimeoutMs`. Outside such an attempt it does nothing.
 *
 * @category attempts
 * @since 1.0.0
 */
export const CurrentHeartbeat = Context.Reference<void!!>(
  "@smthrs/flow/Action/CurrentHeartbeat",
  { defaultValue: () => Effect.void }
)

/**
 * Reports that the running action attempt is still making progress.
 *
 * An action declared with `heartbeatTimeoutMs` fails its attempt with
 * `AttemptTimedOut` when that long passes without a heartbeat; each call
 * restarts the gap. In any other action it is a no-op.
 *
 * @category attempts
 * @since 1.0.0
 */
export const heartbeat: void!! = effect {
  const beat = try CurrentHeartbeat
  try beat
}
