/**
 * Coordinates keyed drain executions.
 *
 * Adapted nearly verbatim from
 * `reference/opencode/packages/smithers/flows/core/src/session/run-coordinator.ts`:
 * `Deferred` joins, `FiberSet` ownership, coalesced wakes, and
 * `uninterruptibleMask` preserve its start-or-join semantics. This adaptation
 * drops the source's `force` drain argument because no engine-store drain has
 * a second execution mode; the successor flag carries coordinator scheduling.
 *
 * @since 0.1.0
 */

import { Cause, Deferred, Effect, Exit, Fiber, FiberSet, type Scope } from "effect"

/**
 * How a drain is asked for. `resumed` marks the engine resuming a run on its
 * own, such as a sweep reclaiming it or a host driving it after a restart:
 * while idle, such a drain waits for a slot of `resumeConcurrency`.
 *
 * @since 1.0.0
 * @category models
 */
export interface Ask {
  readonly resumed?: boolean | undefined
}

/**
 * Serializes drain execution for each key while allowing distinct keys to run
 * concurrently.
 *
 * @since 0.1.0
 * @category models
 */
export interface RunCoordinator<Key, E> {
  /**
   * Snapshots keys with an execution owned by this coordinator.
   *
   * @since 0.1.0
   * @category operations
   */
  readonly active: ReadonlySet<Key>!!
  /**
   * Starts a drain while idle or joins the active drain for the key.
   *
   * @since 0.1.0
   * @category operations
   */
  readonly run: (key: Key, ask?: Ask) => void!E!
  /**
   * Joins the active drain for the key, and starts none while idle.
   *
   * @since 1.0.0
   * @category operations
   */
  readonly join: (key: Key) => void!E!
  /**
   * Starts an idle key without joining or requesting another active drain.
   *
   * @since 1.0.0
   * @category operations
   */
  readonly schedule: (key: Key, ask?: Ask) => void!!
  /** Reserves an idle key, then starts its drain only while the supplied durable readiness holds. */
  readonly scheduleIf: (key: Key, ready: boolean!!) => void!!
  /**
   * Ensures one coalesced drain follows the active drain for the key.
   *
   * @since 0.1.0
   * @category operations
   */
  readonly wake: (key: Key, ask?: Ask) => void!!
  /** Coalesces a wake only into an active, non-stopping drain; never starts an idle key. */
  readonly wakeIfActive: (key: Key) => void!!
  /**
   * Interrupts the active drain for the key and waits for its cleanup.
   *
   * @since 0.1.0
   * @category operations
   */
  readonly interrupt: (key: Key) => void!!
  /** Sends interruption without awaiting cleanup; safe for a short commit publication. */
  readonly requestInterrupt: (key: Key) => void!!
}

type Entry<E> = {
  readonly done: Deferred.Deferred<void, E>
  owner?: Fiber.Fiber<void, never>
  pendingWake: boolean
  stopping: boolean
  /** Waiting in the resume lane for a slot, with no drain started yet. */
  queued: boolean
  /** Holds one of the resume lane's slots until its drains end. */
  slot: boolean
}

/**
 * Creates a scoped coordinator for keyed drain effects.
 *
 * `resumeConcurrency` bounds the resume lane: at most that many drains asked
 * for with `{ resumed: true }` run at once, and the rest wait in the order
 * they asked. Anything else that asks for a waiting key, a `run`, `schedule`,
 * `scheduleIf` or `wake` without `resumed`, starts its drain at once, outside
 * the lane, and so does an `interrupt` or `requestInterrupt`, which has no
 * drain to stop yet: the drain it starts delivers the cancellation the caller
 * recorded. Absent, resumed drains start at once like any other. A waiting
 * key is active: `join` waits for it.
 *
 * @since 0.1.0
 * @category constructors
 */
export const make = <Key, E, R>(options: {
  readonly drain: (key: Key) => void!E!R
  readonly resumeConcurrency?: number | undefined
}): RunCoordinator<Key, E>!never!(Scope.Scope | R) =>
  effect {
    const limit = options.resumeConcurrency
    if (limit !== undefined && !(Number.isSafeInteger(limit) && limit > 0)) {
      return try Effect.die(new RangeError(`resumeConcurrency must be a positive integer, got ${limit}`))
    }
    const active = new Map<Key, Entry<E>>()
    const runFork = try FiberSet.makeRuntime<R, void, never>()
    let free = limit ?? 0
    const waiting: Array<readonly [Key, Entry<E>]> = []
    // Closing the coordinator ends every drain; a key still waiting for a slot ends with them.
    try Effect.addFinalizer(() =>
      Effect.sync(() => {
        for (const [key, entry] of waiting.splice(0)) {
          active.delete(key)
          Deferred.doneUnsafe(entry.done, Exit.failCause(Cause.interrupt()))
        }
      })
    )

    const makeEntry = (): Entry<E> => ({
      done: Deferred.makeUnsafe<void, E>(),
      pendingWake: false,
      stopping: false,
      queued: false,
      slot: false
    })

    const start = (
      key: Key,
      entry: Entry<E>,
      successor = false,
      onlyIf: boolean!! = Effect.succeed(true)
    ): void => {
      const ready = Deferred.makeUnsafe<void>()
      const owner = runFork(
        (successor ? Effect.yieldNow : Deferred.await(ready)).pipe(
          Effect.andThen(onlyIf),
          Effect.flatMap((ready) => ready ? Effect.suspend(() => options.drain(key)) : Effect.void),
          Effect.onError((cause) =>
            Cause.hasInterruptsOnly(cause)
              ? Effect.void
              : Effect.logWarning(`engine-store: coordinated drain failed for ${String(key)}`, cause)
          ),
          Effect.onExit((exit) => Effect.sync(() => settle(key, entry, exit))),
          Effect.exit,
          Effect.asVoid
        )
      )
      entry.owner = owner
      if (!successor) Deferred.doneUnsafe(ready, Effect.void)
    }

    const settle = (key: Key, entry: Entry<E>, exit: Exit.Exit<void, E>): void => {
      if (Exit.isSuccess(exit) && !entry.stopping && entry.pendingWake) {
        entry.pendingWake = false
        start(key, entry, true)
        return
      }

      const successor = entry.pendingWake ? makeEntry() : undefined
      if (successor === undefined) active.delete(key)
      else {
        // The follow-up drains in the slot its predecessor held.
        successor.slot = entry.slot
        entry.slot = false
        active.set(key, successor)
        start(key, successor, true)
      }
      releaseSlot(entry)
      Deferred.doneUnsafe(entry.done, exit)
    }

    /** Gives an ended drain's slot to the next waiting key, or back to the lane. */
    const releaseSlot = (entry: Entry<E>): void => {
      if (!entry.slot) return
      entry.slot = false
      const next = waiting.shift()
      if (next === undefined) {
        free++
        return
      }
      next[1].queued = false
      next[1].slot = true
      start(next[0], next[1])
    }

    /** Starts a waiting key's drain at once, outside the lane. */
    const promote = (key: Key, entry: Entry<E>): void => {
      if (!entry.queued) return
      entry.queued = false
      waiting.splice(waiting.findIndex(([, waiter]) => waiter === entry), 1)
      start(key, entry)
    }

    const startIdle = (key: Key, onlyIf?: boolean!!, ask?: Ask): Entry<E> => {
      const next = makeEntry()
      active.set(key, next)
      if (ask?.resumed === true && limit !== undefined) {
        if (free === 0) {
          next.queued = true
          waiting.push([key, next])
          return next
        }
        free--
        next.slot = true
      }
      start(key, next, false, onlyIf)
      return next
    }

    /** The key's entry, started at once if it was waiting and this ask is not a resumption. */
    const asked = (key: Key, ask: Ask | undefined): Entry<E> | undefined => {
      const entry = active.get(key)
      if (entry !== undefined && ask?.resumed !== true) promote(key, entry)
      return entry
    }

    const run = (key: Key, ask?: Ask): void!E! =>
      Effect.uninterruptibleMask((restore) => {
        const entry = asked(key, ask)
        if (entry !== undefined) {
          if (entry.stopping) {
            // This caller asked for a fresh drain. Wait for the old owner's
            // cleanup, but do not inherit the interruption that stopped it:
            // the replacement must still deliver a persisted cancellation.
            return restore(
              Deferred.await(entry.done).pipe(
                Effect.catchCause((cause) => Cause.hasInterruptsOnly(cause) ? Effect.void : Effect.failCause(cause)),
                Effect.andThen(run(key, ask))
              )
            )
          }
          return restore(Deferred.await(entry.done))
        }

        return restore(Deferred.await(startIdle(key, undefined, ask).done))
      })

    const awaitKey = (key: Key): void!E! =>
      Effect.suspend(() => {
        const entry = active.get(key)
        return entry === undefined ? Effect.void : Deferred.await(entry.done)
      })

    const schedule = (key: Key, ask?: Ask): void!! =>
      Effect.sync(() => {
        if (asked(key, ask) === undefined) startIdle(key, undefined, ask)
      })

    const scheduleIf = (key: Key, ready: boolean!!): void!! =>
      Effect.sync(() => {
        if (asked(key, undefined) === undefined) startIdle(key, ready)
      })

    const wake = (key: Key, ask?: Ask): void!! =>
      Effect.sync(() => {
        const entry = asked(key, ask)
        if (entry !== undefined) {
          entry.pendingWake = true
          return
        }

        startIdle(key, undefined, ask)
      })

    const wakeIfActive = (key: Key): void!! =>
      Effect.sync(() => {
        const entry = active.get(key)
        if (entry !== undefined && !entry.stopping) entry.pendingWake = true
      })

    /**
     * Starts a waiting key's drain so it delivers the cancellation its caller
     * recorded, answering whether the key was waiting.
     */
    const promoteToCancel = (key: Key): boolean => {
      const entry = active.get(key)
      if (entry === undefined || !entry.queued) return false
      promote(key, entry)
      return true
    }

    const interrupt = (key: Key): void!! =>
      Effect.suspend(() => {
        if (promoteToCancel(key)) return Effect.void
        const entry = active.get(key)
        if (entry?.owner === undefined) return Effect.void
        entry.stopping = true
        entry.pendingWake = false
        return Fiber.interrupt(entry.owner)
      })

    const requestInterrupt = (key: Key): void!! =>
      Effect.withFiber((fiber) =>
        Effect.sync(() => {
          if (promoteToCancel(key)) return
          const entry = active.get(key)
          if (entry?.owner === undefined) return
          entry.stopping = true
          entry.pendingWake = false
          entry.owner.interruptUnsafe(fiber.id)
        })
      )

    return {
      active: Effect.fn("RunCoordinator.active")(() => Effect.sync(() => new Set(active.keys())))(),
      run: Effect.fn("RunCoordinator.run")(run),
      join: Effect.fn("RunCoordinator.join")(awaitKey),
      schedule: Effect.fn("RunCoordinator.schedule")(schedule),
      scheduleIf: Effect.fn("RunCoordinator.scheduleIf")(scheduleIf),
      wake: Effect.fn("RunCoordinator.wake")(wake),
      wakeIfActive: Effect.fn("RunCoordinator.wakeIfActive")(wakeIfActive),
      interrupt: Effect.fn("RunCoordinator.interrupt")(interrupt),
      requestInterrupt: Effect.fn("RunCoordinator.requestInterrupt")(requestInterrupt)
    }
  }
