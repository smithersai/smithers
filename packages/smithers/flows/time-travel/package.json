    "typescript",
    "effect",
    "flow",
    "time-travel"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.vibe/declarations/src/index.d.vibe.ts",
