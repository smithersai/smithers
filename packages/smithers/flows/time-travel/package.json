  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Durable replay, fork, and rewind primitives for flows",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/time-travel"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
