        },
        "require": {
          "types": "./dist/cjs/Migrations.d.ts",
          "default": "./dist/cjs/Migrations.js"
        }
      },
      "./SqlTimeTravelStore": {
        "import": {
          "types": "./dist/esm/SqlTimeTravelStore.d.ts",
          "default": "./dist/esm/SqlTimeTravelStore.js"
        },
        "require": {
          "types": "./dist/cjs/SqlTimeTravelStore.d.ts",
          "default": "./dist/cjs/SqlTimeTravelStore.js"
        }
      },
      "./TimeTravel": {
