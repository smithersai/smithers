          "types": "./dist/cjs/TimeTravel.d.ts",
          "default": "./dist/cjs/TimeTravel.js"
        }
      },
      "./TimeTravelError": {
        "import": {
          "types": "./dist/esm/TimeTravelError.d.ts",
          "default": "./dist/esm/TimeTravelError.js"
        },
        "require": {
          "types": "./dist/cjs/TimeTravelError.d.ts",
          "default": "./dist/cjs/TimeTravelError.js"
        }
      },
      "./TimeTravelStore": {
        "import": {
          "types": "./dist/esm/TimeTravelStore.d.ts",
          "default": "./dist/esm/TimeTravelStore.js"
        },
        "require": {
          "types": "./dist/cjs/TimeTravelStore.d.ts",
