  "scripts": {
    "lint": "eslint src test --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "node ../database/scripts/test-matrix.mjs",
    "test:matrix": "node ../database/scripts/test-matrix.mjs"
