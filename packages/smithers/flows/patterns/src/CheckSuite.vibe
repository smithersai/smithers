/**
 * Check-suite pattern: run independent checks with bounded concurrency and
 * reduce their rows to one verdict.
 *
 * `make` and `run` take the checks as a record written with the suite.
 * `makeDiscovered` and `runDiscovered` take one check and the ids to run it
 * for, so a suite can run the checks a repository turned out to have.
 *
 * @see https://smithers.sh/docs/reference/api/patterns
 * @see https://smithers.sh/docs/reference/api/patterns#identity-and-ownership
 *
 * @since 0.1.0
 */

import * as Flow from "@smthrs/flow/Flow"
import * as Node from "@smthrs/plan/Node"
import type * as Planned from "@smthrs/plan/Planned"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
import * as Compose from "./internal/Compose.vibe"
import * as Failure from "./internal/Failure.vibe"
import type { Member } from "./internal/Member.ts"
import { call as callMember } from "./internal/Member.ts"
import { OpaqueInput } from "./internal/Payload.vibe"
import { PatternError } from "./PatternError.vibe"
import * as Quarantine from "./Quarantine.vibe"

/**
 * How per-check outcomes reduce to one verdict.
 *
 * @category models
 * @since 0.1.0
 */
export type Strategy = "all-pass" | "majority" | "any-pass"

/**
 * The declared form of a check suite.
 *
 * @category models
 * @since 0.1.0
 */
export type CheckSuiteFlow<R = never> = Flow.Flow<
  string,
  typeof OpaqueInput,
  typeof Schema.Unknown,
  typeof Schema.Unknown,
  R
>

/**
 * Configuration for {@link make}.
 *
 * `checks` is keyed by check id, so two checks cannot share an id, and the
 * checks run in the record's key order.
 *
 * `continueOnFail` changes the declared topology as well as the run: a
 * tolerant suite joins its checks with {@link Quarantine.all} under the
 * `quarantine` policy, so the declaration carries one recovery arm per check
 * and the join cannot fail on a check's behalf. The option is captured too, so
 * a tolerant suite and a fail-fast suite have different step identity.
 *
 * @category models
 * @since 0.1.0
 */
export interface MakeOptions<R = never> {
  readonly name?: string | undefined
  readonly description?: string | undefined
  readonly checks: Readonly<Record<string, Member<R>>>
  readonly strategy: Strategy
  readonly concurrency: number
  readonly continueOnFail: boolean
}

/**
 * One check's classified outcome, with its original error when available.
 *
 * @category models
 * @since 0.1.0
 */
export interface CheckResult {
  readonly id: string
  readonly passed: boolean
  readonly error?: unknown
}

/**
 * The reduced suite outcome. `errors` retains errors by check id, including
 * falsy tolerated errors; checks without an error have no entry. Diagnostics
 * do not affect the verdict decision.
 *
 * @category models
 * @since 0.1.0
 */
export interface Verdict {
  readonly passed: ReadonlyArray<string>
  readonly failed: ReadonlyArray<string>
  readonly errors: Readonly<Record<string, unknown>>
  readonly strategy: Strategy
  readonly verdict: boolean
}

/**
 * Operational callbacks for {@link run}.
 *
 * `checks` is keyed by check id, so two checks cannot share an id, and the
 * checks run in the record's key order.
 *
 * @category models
 * @since 0.1.0
 */
export interface RuntimeOptions<I, Out, E, R> {
  readonly checks: Readonly<Record<string, (input: I) => Out!E!R>>
  readonly strategy: Strategy
  readonly concurrency: number
  readonly continueOnFail: boolean
}

/**
 * Classifies one check's row as a pass.
 *
 * A missing row is a failure: the check produced nothing. A
 * object row fails when it carries `passed: false`, `ok: false`, `failed: true`, or an
 * `error` other than `undefined`, `null`, or `false`. Anything else passes.
 * Quarantine protocol envelopes are interpreted by {@link rows}, where the
 * caller explicitly declares that the record came from a tolerant join.
 *
 * @category introspection
 * @since 0.1.0
 */
export const passed = (row: unknown): boolean => {
  if (row === null || row === undefined) return false
  if (typeof row !== "object") return true
  const record = row as Record<string, unknown>
  if (record.passed === false || record.ok === false || record.failed === true) return false
  return record.error === undefined || record.error === null || record.error === false
}

const classify = (id: string, row: unknown): CheckResult => {
  const result = { id, passed: passed(row) }
  const error = typeof row === "object" && row !== null ? (row as Record<string, unknown>).error : undefined
  return error === undefined || error === null || error === false ? result : { ...result, error }
}

/**
 * Classifies the record a batch of check calls produces.
 *
 * Results follow declaration order, not completion order, so the verdict does
 * not depend on which check finished first.
 *
 * `quarantineOutcomes` defaults to `false`, treating values as plain check
 * rows. Use `rows(values, ids, true)` for {@link Quarantine.all} output under
 * the `quarantine` policy: successful envelopes are unwrapped and quarantined
 * failures retain their original error, including falsy errors. Plain rows
 * retain an `error` other than `undefined`, `null`, or `false`.
 *
 * @category introspection
 * @since 0.1.0
 */
export const rows = (
  values: unknown,
  ids: ReadonlyArray<string>,
  quarantineOutcomes = false
): ReadonlyArray<CheckResult> => {
  const record = (typeof values === "object" && values !== null ? values : {}) as Record<string, unknown>
  return ids.map((id) => {
    if (!Object.hasOwn(record, id)) return { id, passed: false }
    const row = record[id]
    if (!quarantineOutcomes) return classify(id, row)
    if (Quarantine.isSucceeded(row)) return classify(id, row.value)
    if (Quarantine.isQuarantined(row)) return { id, passed: false, error: row.error }
    return { id, passed: false }
  })
}

/**
 * Reduces classified check results to one verdict under a strategy.
 *
 * An empty suite never passes: `all-pass` has nothing to pass, and `any-pass`
 * and `majority` have no passing check to point at.
 *
 * @category combinators
 * @since 0.1.0
 */
export const verdict = (results: ReadonlyArray<CheckResult>, strategy: Strategy): Verdict => {
  const passing = results.filter((result) => result.passed).map((result) => result.id)
  const failing = results.filter((result) => !result.passed).map((result) => result.id)
  const total = results.length
  const decided = strategy === "any-pass"
    ? passing.length > 0
    : strategy === "majority"
    ? passing.length * 2 > total && total > 0
    : total > 0 && passing.length === total
  const errors = Object.fromEntries(
    results.filter((result) => Object.hasOwn(result, "error")).map((result) => [result.id, result.error])
  )
  return { passed: passing, failed: failing, errors, strategy, verdict: decided }
}

const bound = (value: number): boolean => Number.isSafeInteger(value) && value >= 1

// A tolerated failure is reported in the verdict the suite settles with, so
// the row carries its error as data.
const reported = (wire: (error: unknown) => unknown) => (result: CheckResult): CheckResult =>
  Object.hasOwn(result, "error") ? { ...result, error: wire(result.error) } : result

/**
 * Joins check calls in batches of `concurrency` and maps the joined record to
 * a verdict with `decide`. `entries` pairs each call with the key its row is
 * joined under.
 */
const joined = <R>(
  entries: ReadonlyArray<readonly [key: string, call: Node.Node<unknown, unknown, R>]>,
  concurrency: number,
  continueOnFail: boolean,
  captures: Readonly<Record<string, unknown>>,
  decide: (values: unknown) => Verdict
): Node.Node<unknown, unknown, R> => {
  const keys = entries.map(([key]) => key)
  const batchAt = (offset: number): Node.Node<unknown, unknown, R> => {
    const members = Object.fromEntries(entries.slice(offset, offset + concurrency)) as Record<string, Node.Any>
    return continueOnFail
      ? Quarantine.all(members, { policy: "quarantine" })
      : Quarantine.all(members, { policy: "halt" })
  }
  // Each batch gates the next, and the rows a batch produced are carried on
  // as planned field references: a batch's result does not exist while the
  // graph builds, so the suite assembles the record the verdict reads rather
  // than merging two symbols.
  const visit = (
    offset: number,
    carried: Readonly<Record<string, Planned.Planned<unknown>>>
  ): Node.Node<unknown, unknown, R> => {
    if (offset >= entries.length) {
      return Node.map(Node.succeed(carried), Node.capture(captures, decide))
    }
    const batched = keys.slice(offset, offset + concurrency)
    return Node.bindPlanned(
      batchAt(offset),
      Node.capture({ offset, batched }, (reference) =>
        Node.andThen(
          Node.succeed(reference),
          visit(offset + concurrency, {
            ...carried,
            ...Object.fromEntries(
              batched.map((key) => [key, (reference as Readonly<Record<string, Planned.Planned<unknown>>>)[key]!])
            )
          })
        ))
    )
  }
  return visit(0, {})
}

/** One runtime check's classified result; a tolerant suite turns its typed failure into a failed result. */
const attempt = <Out, E, R>(
  id: string,
  check: Effect.Effect<Out, E, R>,
  continueOnFail: boolean
): Effect.Effect<CheckResult, E, R> => {
  const classified = Effect.map(check, (row) => classify(id, row))
  return continueOnFail
    ? Effect.catch(classified, (error) => Effect.succeed({ id, passed: false, error }))
    : classified
}

/**
 * Builds the check-suite topology: one call per check, batched into `Node.all`
 * groups of `concurrency` members, then one pure verdict map.
 *
 * Every declared check reaches the graph, so `make` throws a `PatternError`
 * when the record is empty, when an id is the empty string, or when
 * `concurrency` is not a positive safe integer. Keying `checks` by id is what
 * rules out a duplicate: a repeated id could otherwise overwrite the earlier
 * check's member and drop it from the plan.
 *
 * `continueOnFail` picks the join. A tolerant suite joins each batch with
 * {@link Quarantine.all} under the `quarantine` policy: every check gains a
 * recovery arm, and every check settles in an explicit
 * {@link Quarantine.Settled} envelope. {@link rows} unwraps successful rows
 * and classifies quarantined failures. A fail-fast suite joins under `halt`,
 * which is the plain `Node.all` that fails on the first failing member and
 * interrupts the rest.
 *
 * @category constructors
 * @since 0.1.0
 */
export const make = <R = never>(options: MakeOptions<R>): CheckSuiteFlow<R> => {
  // The body runs when the graph builds, later than this call, so it reads
  // these snapshots and never the caller's options again.
  const declared = Object.entries(options.checks)
  const strategy = options.strategy
  const concurrency = options.concurrency
  const continueOnFail = options.continueOnFail
  if (declared.length === 0) {
    $raise(new PatternError({ code: "invalid_decorator", message: "CheckSuite requires at least one check" }))
  }
  if (!bound(concurrency)) {
    $raise(new PatternError({
      code: "invalid_decorator",
      message: "CheckSuite concurrency must be a positive safe integer"
    }))
  }
  const ids = declared.map(([id]) => id)
  if (ids.some((id) => id === "")) {
    $raise(new PatternError({ code: "invalid_decorator", message: "CheckSuite check ids must not be empty" }))
  }
  const captures = {
    checks: ids,
    strategy,
    concurrency,
    continueOnFail
  }
  const { name, description } = Compose.label(
    "checkSuite",
    { checks: ids, strategy, concurrency },
    options,
    declared.map(([, check]) => check)
  )
  const report = reported(Failure.wire(declared.map(([, check]) => check)))
  const body = ({ input }: { readonly input: unknown }): Node.Node<unknown, unknown, R> =>
    joined(
      declared.map(([id, check]) => [id, callMember(check, { check: id, input })]),
      concurrency,
      continueOnFail,
      captures,
      (values) => verdict(rows(values, ids, continueOnFail).map(report), strategy)
    )
  return Flow.make(name, {
    ...(description === undefined ? {} : { description }),
    payload: OpaqueInput,
    success: Schema.Unknown,
    // The engine encodes a typed failure through this schema: the pattern's
    // own `PatternError`, and whatever a member it called failed with.
    error: Failure.schemaFor([PatternError], declared.map(([, check]) => check)) as typeof Schema.Unknown,
    body: Node.capture(captures, body)
  })
}

/**
 * Runs the checks with bounded concurrency and returns the verdict.
 *
 * With `continueOnFail: false` the first failing check fails the suite and the
 * remaining checks do not run. With `continueOnFail: true` every check runs and
 * a failed one is listed in the verdict's `failed`, with its original error
 * retained in `errors` under its id. A check that succeeds but
 * returns a failure row is always listed in `failed`; it does not fail the
 * suite, because the row is the check's answer, not an error.
 *
 * `continueOnFail` tolerates a typed check failure. A check that throws
 * raises a defect, which fails the suite under either setting and cancels
 * the checks still in flight.
 *
 * `run` rejects the same suites `make` rejects, and it rejects them before any
 * check runs: an empty record, an empty check id, and a `concurrency` that is
 * not a positive safe integer each fail with a `PatternError`. An empty record
 * would otherwise return a false verdict, which reads like a failing suite
 * rather than like a misconfigured one. Keying `checks` by id rules out a
 * duplicate, which would otherwise list the same check twice in the verdict.
 *
 * @category combinators
 * @since 0.1.0
 */
export const run = <I, Out, E, R>(
  input: I,
  options: RuntimeOptions<I, Out, E, R>
): Verdict!(E | PatternError)!R => {
  // Snapshots taken at the call: the effect may run later, and a caller's
  // edit to the record or the option object in between must not reach it.
  const declared = Object.entries(options.checks)
  const strategy = options.strategy
  const concurrency = options.concurrency
  const continueOnFail = options.continueOnFail
  if (declared.length === 0) {
    return Effect.fail(
      new PatternError({ code: "invalid_decorator", message: "CheckSuite requires at least one check" })
    )
  }
  if (!bound(concurrency)) {
    return Effect.fail(
      new PatternError({
        code: "invalid_decorator",
        message: "CheckSuite concurrency must be a positive safe integer"
      })
    )
  }
  if (declared.some(([id]) => id === "")) {
    return Effect.fail(
      new PatternError({ code: "invalid_decorator", message: "CheckSuite check ids must not be empty" })
    )
  }
  return Effect.map(
    Effect.forEach(
      declared,
      ([id, check]) => attempt(id, check(input), continueOnFail),
      { concurrency }
    ),
    (results) => verdict(results, strategy)
  )
}

/**
 * What a discovered suite with no checks decides: `pass` settles a true
 * verdict, `fail` a false one. Either way `passed` and `failed` are empty.
 *
 * @category models
 * @since 1.0.0
 */
export type OnEmpty = "pass" | "fail"

/**
 * The payload a discovered suite takes: the ids of the checks to run, in the
 * order to run and report them, and the input every check receives.
 *
 * @category schemas
 * @since 1.0.0
 */
export const DiscoveredPayload = Schema.Struct({ checks: Schema.Array(Schema.String), input: Schema.Unknown })

/**
 * The declared form of a discovered check suite.
 *
 * @category models
 * @since 1.0.0
 */
export type DiscoveredFlow<R = never> = Flow.Flow<
  string,
  typeof DiscoveredPayload,
  typeof Schema.Unknown,
  typeof Schema.Unknown,
  R
>

/**
 * Configuration for {@link makeDiscovered}.
 *
 * `check` is the one member every discovered id is run through. It is called
 * with `{ check, input }`: the id and the suite's input.
 *
 * @category models
 * @since 1.0.0
 */
export interface DiscoveredMakeOptions<R = never> {
  readonly name?: string | undefined
  readonly description?: string | undefined
  readonly check: Member<R>
  readonly strategy: Strategy
  readonly concurrency: number
  readonly continueOnFail: boolean
  readonly onEmpty: OnEmpty
}

/**
 * Operational callbacks for {@link runDiscovered}.
 *
 * `check` receives the same `{ check, input }` a declared suite's member does.
 *
 * @category models
 * @since 1.0.0
 */
export interface DiscoveredRuntimeOptions<I, Out, E, R> {
  readonly check: (payload: { readonly check: string; readonly input: I }) => Effect.Effect<Out, E, R>
  readonly strategy: Strategy
  readonly concurrency: number
  readonly continueOnFail: boolean
  readonly onEmpty: OnEmpty
}

/** The ids a discovered suite was handed, copied, or why they are not a suite. */
const discoveredIds = (checks: unknown): ReadonlyArray<string> | PatternError => {
  if (!Array.isArray(checks) || checks.some((id) => typeof id !== "string")) {
    return new PatternError({ code: "invalid_input", message: "CheckSuite discovered checks must be an array of ids" })
  }
  const ids: ReadonlyArray<string> = [...checks]
  if (ids.some((id) => id === "")) {
    return new PatternError({ code: "invalid_input", message: "CheckSuite check ids must not be empty" })
  }
  if (new Set(ids).size !== ids.length) {
    return new PatternError({ code: "invalid_input", message: "CheckSuite discovered check ids must be unique" })
  }
  return ids
}

const emptyVerdict = (strategy: Strategy, onEmpty: OnEmpty): Verdict => ({
  passed: [],
  failed: [],
  errors: {},
  strategy,
  verdict: onEmpty === "pass"
})

/**
 * Builds a check suite whose checks arrive with its input.
 *
 * {@link make} needs every check when the suite is written. A discovered suite
 * needs one `check` member and takes the ids as `{ checks, input }`, so the
 * step before it can find them: the scripts a commit has, the packages a
 * change touches. The ids must be known when the suite's graph builds, which
 * they are when the suite is called with the result of an earlier step.
 *
 * Each id becomes one call to `check` with `{ check: id, input }`, batched and
 * joined exactly as {@link make} does, so `continueOnFail` changes the
 * topology here too. The checks run and are reported in the order the ids
 * came in. The calls are joined under positional keys, never under the ids,
 * so an id that looks like an array index keeps its place and an id such as
 * `__proto__` cannot collide with a record's own keys.
 *
 * A suite handed no ids calls nothing and settles the verdict `onEmpty` names.
 * Ids that are not an array of unique, non-empty strings settle the flow with
 * a `PatternError` coded `invalid_input` before any check runs.
 * `makeDiscovered` throws a `PatternError` when `concurrency` is not a
 * positive safe integer.
 *
 * @category constructors
 * @since 1.0.0
 */
export const makeDiscovered = <R = never>(options: DiscoveredMakeOptions<R>): DiscoveredFlow<R> => {
  // The body runs when the graph builds, later than this call, so it reads
  // these snapshots and never the caller's options again.
  const check = options.check
  const strategy = options.strategy
  const concurrency = options.concurrency
  const continueOnFail = options.continueOnFail
  const onEmpty = options.onEmpty
  if (!bound(concurrency)) {
    $raise(new PatternError({
      code: "invalid_decorator",
      message: "CheckSuite concurrency must be a positive safe integer"
    }))
  }
  const captures = { strategy, concurrency, continueOnFail, onEmpty }
  const { name, description } = Compose.label("checkSuiteDiscovered", { strategy, concurrency, onEmpty }, options, [
    check
  ])
  const report = reported(Failure.wire([check]))
  const body = (payload: { readonly checks: unknown; readonly input: unknown }): Node.Node<unknown, unknown, R> => {
    const ids = discoveredIds(payload.checks)
    // A declared failure, not a throw: a body that throws is reported as an
    // incomplete graph, while `runDiscovered` fails with this error.
    if (ids instanceof PatternError) return Node.fail(ids)
    if (ids.length === 0) return Node.succeed(emptyVerdict(strategy, onEmpty))
    const keys = ids.map((_, index) => `check-${index}`)
    return joined(
      ids.map((id, index) => [keys[index]!, callMember(check, { check: id, input: payload.input })]),
      concurrency,
      continueOnFail,
      { ...captures, checks: ids },
      (values) =>
        verdict(
          rows(values, keys, continueOnFail).map((result, index) => report({ ...result, id: ids[index]! })),
          strategy
        )
    )
  }
  return Flow.make(name, {
    ...(description === undefined ? {} : { description }),
    payload: DiscoveredPayload,
    success: Schema.Unknown,
    // The engine encodes a typed failure through this schema: the pattern's
    // own `PatternError`, and whatever a member it called failed with.
    error: Failure.schemaFor([PatternError], [check]) as typeof Schema.Unknown,
    body: Node.capture(captures, body)
  })
}

/**
 * Runs `check` once per discovered id with bounded concurrency and returns
 * the verdict.
 *
 * The runtime form of {@link makeDiscovered}: the same payload, the same
 * order, the same `continueOnFail` and `onEmpty`, and the same refusals. A
 * `concurrency` that is not a positive safe integer and ids that are not an
 * array of unique, non-empty strings each fail with a `PatternError` before
 * any check runs. No ids succeeds with the verdict `onEmpty` names and runs
 * nothing.
 *
 * @category combinators
 * @since 1.0.0
 */
export const runDiscovered = <I, Out, E, R>(
  payload: { readonly checks: ReadonlyArray<string>; readonly input: I },
  options: DiscoveredRuntimeOptions<I, Out, E, R>
): Effect.Effect<Verdict, E | PatternError, R> => {
  // Snapshots taken at the call: the effect may run later, and a caller's
  // edit to the id array or the option object in between must not reach it.
  const check = options.check
  const strategy = options.strategy
  const concurrency = options.concurrency
  const continueOnFail = options.continueOnFail
  const onEmpty = options.onEmpty
  const input = payload.input
  const ids = discoveredIds(payload.checks)
  if (!bound(concurrency)) {
    return Effect.fail(
      new PatternError({
        code: "invalid_decorator",
        message: "CheckSuite concurrency must be a positive safe integer"
      })
    )
  }
  if (ids instanceof PatternError) return Effect.fail(ids)
  if (ids.length === 0) return Effect.succeed(emptyVerdict(strategy, onEmpty))
  return Effect.map(
    Effect.forEach(ids, (id) => attempt(id, Effect.suspend(() => check({ check: id, input })), continueOnFail), {
      concurrency
    }),
    (results) => verdict(results, strategy)
  )
}

module $throw$ts {
export function raise(value: unknown): never { throw value }
}
import { raise as $raise } from $throw$ts
