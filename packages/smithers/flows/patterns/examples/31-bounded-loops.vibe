/**
 * Repair a configuration, refine a summary, and drain a queue on the engine.
 *
 * ScanFixVerify.make and Optimizer.make declare the bounded work. The queue
 * flow hands off to itself until it is empty, with maxRounds bounding the
 * lineage. The host supplies the engine and crypto services.
 */
import { Action, Flow, Interpreter } from "@smthrs/flow"
import * as DriftDetector from "@smthrs/patterns/DriftDetector"
import * as Optimizer from "@smthrs/patterns/Optimizer"
import * as ScanFixVerify from "@smthrs/patterns/ScanFixVerify"
import * as Sidecar from "@smthrs/patterns/Sidecar"
import * as Node from "@smthrs/plan/Node"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"

interface Setting {
  readonly key: string
  readonly value: number
}

interface Violation {
  readonly key: string
  readonly value: number
  readonly limit: number
}

const limits: Readonly<Record<string, number>> = { retries: 3, timeoutMs: 30_000, concurrency: 8 }

/**
 * A config the repair loop edits in place, the way a real fixer edits files.
 */
const config = (): Map<string, number> => new Map([["retries", 9], ["timeoutMs", 90_000], ["concurrency", 4]])

const violations = (current: ReadonlyMap<string, number>): ReadonlyArray<Violation> =>
  [...current].flatMap(([key, value]) => {
    const limit = limits[key]
    return limit !== undefined && value > limit ? [{ key, value, limit }] : []
  })

/**
 * Scans a config for settings above policy, repairs each one on its own, and
 * verifies the result, until a scan comes back clean.
 *
 * `retries` and `timeoutMs` both start above their limits, so the first round
 * fixes two settings concurrently and the verifier reports them resolved. That
 * verdict does not end the loop: the second round rescans, finds nothing, and
 * that empty scan is the terminal. Two rounds, one of them a confirmation.
 * `remaining` is empty on a clean exit and lists the last scan's issues when
 * the retry bound stopped the loop, which is the signal an operator acts on.
 */
const Violation = Schema.Struct({ key: Schema.String, value: Schema.Number, limit: Schema.Number })
const Scan = Action.make("bounded-loops/scan", {
  payload: { input: Schema.String, iteration: Schema.Number },
  success: Schema.Array(Violation)
})
const Fix = Action.make("bounded-loops/fix", {
  payload: { issue: Violation, index: Schema.Number, iteration: Schema.Number },
  success: Schema.String
})
const Verify = Action.make("bounded-loops/verify", {
  payload: {
    input: Schema.String,
    issues: Schema.Array(Violation),
    fixes: Schema.Array(Schema.String),
    iteration: Schema.Number
  },
  success: Schema.Struct({ resolved: Schema.Boolean })
})
const Repair = ScanFixVerify.make<
  Action.Requirement<"bounded-loops/scan" | "bounded-loops/fix" | "bounded-loops/verify">
>({ scan: Scan, fix: Fix, verify: Verify, maxRetries: 4, maxIssues: 3, concurrency: 4 })

/** Repairs a copy of the configuration with journaled action calls. */
export const repair = (initial: ReadonlyMap<string, number> = config()) =>
  effect {
    const current = new Map(initial)
    const raw = try (Repair.execute({ input: "settings" })
      |> Effect.provide(
        %,
        Layer.mergeAll(
          Interpreter.layer(Repair),
          Scan.toLayer(effect () => violations(current)),
          Fix.toLayer(effect ({ issue }) => (current.set(issue.key, issue.limit), issue.key)),
          Verify.toLayer(effect () => ({ resolved: violations(current).length === 0 }))
        ).pipe(Layer.provide(Action.layerImplementations))
      )
      |> Effect.orDie(%))
    const report = try (Schema.decodeUnknownEffect(Schema.Struct({
      iterations: Schema.Number,
      remaining: Schema.Array(Violation)
    }))(raw) |> Effect.orDie(%))
    return {
      iterations: report.iterations,
      remaining: report.remaining,
      settled: [...current].map(([key, value]) => ({ key, value }))
    }
  }

/**
 * Compares the repaired config to the baseline an operator recorded, and pages
 * only when it moved: a changed value, a missing setting, or one the baseline
 * never approved.
 * The baseline is the config as last recorded, so the repair is exactly what
 * the detector reports: two settings moved away from what the operator
 * approved, and the alert names them.
 *
 * The detector runs once. For polling, declare a flow that hands off to itself
 * with `.to(...)` and bounds the lineage with `maxRounds`.
 */
export const audit = effect (
  settled: ReadonlyArray<Setting>
): { readonly drifted: boolean; readonly paged: ReadonlyArray<string> }!! => {
  const paged: Array<string> = []
  const approved: Record<string, number> = { retries: 9, timeoutMs: 90_000, concurrency: 4 }
  const result = try DriftDetector.run(settled, {
    baseline: approved,
    capture: ({ input }) => Effect.succeed(Object.fromEntries(input.map((s) => [s.key, s.value]))),
    // Walk the union of both key sets: a setting the operator never approved
    // is drift just as much as an approved one that moved or went missing.
    compare: effect ({ baseline, snapshot }) => {
      const keys = new Set([...Object.keys(baseline), ...Object.keys(snapshot)])
      const changed = [...keys].filter((key) => baseline[key] !== snapshot[key])
      return { drifted: changed.length > 0, changed }
    },
    alert: effect ({ comparison }) => (paged.push(...comparison.changed), comparison.changed.length)
  })
  return { drifted: result.drifted, paged }
}

/**
 * The candidates the search produces, in order. The second is the shortest, so
 * the last attempt is not the best one.
 */
export const wordy: ReadonlyArray<string> = [
  "the config was repaired successfully by the loop",
  "repaired",
  "config repaired"
]

/**
 * Searches for a summary short enough to fit an alert line.
 *
 * The scorer rewards brevity and no candidate reaches the target, so the search
 * spends its whole budget. It still answers with the shortest summary it saw
 * rather than the one it happened to end on. Keeping the best attempt is the
 * difference between an optimizer and a retry.
 */
const Generate = Action.make("bounded-loops/generate", {
  payload: { input: Schema.String, previous: Schema.optional(Schema.Unknown), iteration: Schema.Number },
  success: Schema.String
})
const Evaluate = Action.make("bounded-loops/evaluate", {
  payload: { value: Schema.String, iteration: Schema.Number },
  success: Schema.Struct({ score: Schema.Number, feedback: Schema.String })
})
const Tune = Optimizer.make<Action.Requirement<"bounded-loops/generate" | "bounded-loops/evaluate">>({
  generate: Generate,
  evaluate: Evaluate,
  maxIterations: 3,
  targetScore: 0.9
})

/** Runs the search and returns the best summary. */
export const tune = effect {
  const raw = try (Tune.execute({ input: "summary" }, { executionId: "bounded-loops/tune" })
    |> Effect.provide(
      %,
      Layer.mergeAll(
        Interpreter.layer(Tune),
        Generate.toLayer(({ iteration }) => Effect.succeed(wordy[iteration - 1] ?? "")),
        Evaluate.toLayer(({ value }) => Effect.succeed({ score: 1 - value.length / 60, feedback: "shorter" }))
      ).pipe(Layer.provide(Action.layerImplementations))
    )
    |> Effect.orDie(%))
  const result = try (Schema.decodeUnknownEffect(Schema.Struct({
    best: Schema.Struct({ candidate: Schema.String, score: Schema.Number }),
    iterations: Schema.Number,
    converged: Schema.Boolean
  }))(raw) |> Effect.orDie(%))
  return {
    best: result.best.candidate,
    score: Number(result.best.score.toFixed(4)),
    iterations: result.iterations,
    converged: result.converged
  }
}

/**
 * Runs a cheap shadow beside the expensive summary to see whether the cheap
 * seat would have been good enough.
 *
 * The shadow here fails. A sidecar quarantines that, because the shadow is an
 * experiment and the primary result is the answer. `delta` stays absent, since
 * there is nothing to compare against.
 */
export const shadow: {
  readonly primary: string
  readonly quarantined: boolean
  readonly delta: number | undefined
}!! = effect {
  const result = try (Sidecar.run("summary", {
    primary: () => Effect.succeed("config repaired"),
    // Annotated because this shadow only fails: without it the shadow output
    // type infers as `never` and the scorer cannot read it.
    shadow: (): string!string => Effect.fail("the cheap seat is out of quota"),
    score: ({ primary, shadow }) => Effect.succeed({ primary: primary.length, shadow: shadow.length })
    // All options are literals, so an unsafe configuration is an example defect.
  }) |> Effect.orDie(%))
  return {
    primary: result.primary,
    quarantined: result.shadow.quarantined,
    delta: result.delta?.difference
  }
}

schema QueuePayload { pending: number; turns: number }
schema QueueResult { turns: number; exhausted: boolean }
const Drain = Action.make("bounded-loops/drain", {
  payload: QueuePayload,
  success: QueuePayload
})
type QueueFlow = Flow.Flow<
  "bounded-loops/queue",
  typeof QueuePayload,
  typeof QueueResult,
  typeof Schema.Never,
  Action.Requirement<"bounded-loops/drain">
>

/** Each round journals one drain step, then settles or opens the next round. */
export const Queue: QueueFlow = Flow.make("bounded-loops/queue", {
  payload: QueuePayload,
  success: QueueResult,
  maxRounds: 10,
  body: (payload) =>
    Drain.call(payload).pipe(
      Node.branch({
        if: Node.capture({}, (next) => next.pending <= 0),
        then: (next) => Flow.done({ turns: next.turns, exhausted: false }),
        else: (next) => Queue.to({ pending: next.pending, turns: next.turns })
      })
    )
})

/** Runs a queue lineage with a caller-owned execution identity. */
export const drain = (pending: number, executionId: string) =>
  Queue.execute({ pending, turns: 0 }, { executionId })
  |> Effect.provide(
    %,
    Layer.mergeAll(
      Interpreter.layer(Queue),
      Drain.toLayer(({ pending, turns }) => Effect.succeed({ pending: pending - 1, turns: turns + 1 }))
    ).pipe(Layer.provide(Action.layerImplementations))
  )

/** Drains three items through three engine rounds. */
export const settle = drain(3, "bounded-loops/settle")

/**
 * Runs the whole story: repair, audit, tune, shadow, settle.
 */
export const main = effect {
  const repaired = try repair()
  const audited = try audit(repaired.settled)
  const tuned = try tune
  const shadowed = try shadow
  const settled = try settle
  return {
    repair: { iterations: repaired.iterations, remaining: repaired.remaining },
    audit: audited,
    tune: { best: tuned.best, converged: tuned.converged },
    shadow: { quarantined: shadowed.quarantined },
    settle: { turns: settled.turns }
  }
}
