// Node exercises the unsupported-runtime boundary; the real Bun/CEF success path runs in the desktop E2E.
import { HttpServer } from "effect/http"
import { expect, it } from "@effect/vitest"
import { bunRuntime } from "./native/config.ts"
import { BunDesktop, BunServer } from "../src/index.ts"

it.effect.skipIf(bunRuntime)("refuses native FFI on Node with the public safe failure", () => effect {
  const result = try exit(scoped(Layer.build(BunDesktop.layer)))
  try Effect.try(() => {
    expect(Exit.isFailure(result)).toBe(true)
    if (Exit.isFailure(result)) expect(Cause.squash(result.cause)).toBeInstanceOf(BunDesktop.DesktopUnavailable)
  })
})

it.effect.skipIf(bunRuntime)("refuses the Bun server on Node", () => effect {
  const result = try exit(scoped(Layer.build(BunServer.layer())))
  try Effect.try(() => expect(Exit.isFailure(result)).toBe(true))
})

it.effect.runIf(bunRuntime)("releases the chosen listener and rebinds its explicit port after each scope", () => effect {
  const address = try scoped(effect {
    const context = try Layer.build(BunServer.layer())
    return Context.get(context, HttpServer.HttpServer).address
  })
  try Effect.try(() => expect(address._tag).toBe("InetAddressV4"))
  if (address._tag !== "InetAddressV4") return
  try Effect.try(() => expect(address.port).toBeGreaterThan(0))
  for (const attempt of [0, 1]) {
    const rebound = try scoped(effect {
      const context = try Layer.build(BunServer.layer(address.port))
      return Context.get(context, HttpServer.HttpServer).address
    })
    try Effect.try(() => expect(rebound, String(attempt)).toEqual(address))
  }
})
