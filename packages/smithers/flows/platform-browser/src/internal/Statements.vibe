/**
 * Runs SQL on an open wa-sqlite database: the one statement loop
 * `BrowserSqlite.make` and the shared database's connection both use.
 *
 * @since 1.0.0
 */

import { classifySqliteError, SqlError } from "effect/sql/SqlError"

/**
 * An open wa-sqlite database: the API built from the module, and the
 * database handle `open_v2` returned.
 *
 * @category models
 * @since 1.0.0
 */
export interface Database {
  readonly sqlite3: SQLiteAPI
  readonly db: number
}

/**
 * A `SqlError` for a failure of `operation`, classified by SQLite's result
 * code when `cause` carries one.
 *
 * @category errors
 * @since 1.0.0
 */
export const failed = (cause: unknown, message: string, operation: string): SqlError =>
  new SqlError({ reason: classifySqliteError(cause, { message, operation }) })

/** `SQLITE_ROW`: `sqlite3_step` produced a row. */
const row = 100

/**
 * A value as wa-sqlite binds it:
 * - a JavaScript integer wider than 32 bits as a `bigint`, so it binds with
 *   `sqlite3_bind_int64` rather than `sqlite3_bind_double`;
 * - a `Date` as its ISO 8601 text, which wa-sqlite would otherwise bind as
 *   `NULL`.
 */
const bindable = (value: unknown): unknown =>
  typeof value === "number" && Number.isSafeInteger(value) && (value | 0) !== value ?
    $invoke(BigInt,value)
    : value instanceof Date ?
    value.toISOString()
    : value

/**
 * Whether `tail`, the SQL after a statement, holds another statement rather
 * than only whitespace, semicolons and comments.
 */
const holdsStatement = (tail: string): boolean => {
  let at = 0
  while (at < tail.length) {
    if (/[\s;]/u.test(tail[at]!)) at++
    else if (tail.startsWith("--", at)) at = tail.includes("\n", at) ? tail.indexOf("\n", at) + 1 : tail.length
    else if (tail.startsWith("/*", at)) at = tail.includes("*/", at + 2) ? tail.indexOf("*/", at + 2) + 2 : tail.length
    else return true
  }
  return false
}

/**
 * One entry of a script: `sql`, which may hold several statements, and the
 * `params` bound to each of them.
 *
 * @category models
 * @since 1.0.0
 */
export interface Entry {
  readonly sql: string
  readonly params: ReadonlyArray<unknown>
}

/**
 * What {@link runEach} and {@link runAll} tell their caller about each
 * statement: `before` runs once the statement is prepared and before it
 * steps, with whether it is the last statement of the script and the rows
 * the earlier ones returned, one array per entry; `after` runs once it
 * completes. What either throws ends the run.
 *
 * @category models
 * @since 1.0.0
 */
export interface Hooks {
  readonly before?: (
    statement: { readonly last: boolean; readonly results: ReadonlyArray<ReadonlyArray<unknown>> }
  ) => Promise<void>
  readonly after?: () => Promise<void>
}

/**
 * Runs each entry of `entries` in order, every statement of its `sql` with
 * its `params`, and collects the rows each entry's statements return, as
 * objects keyed by column name or as arrays: one array per entry. `columns`
 * is `0` when no statement had result columns. A statement SQLite refuses
 * ends the run: the entries after it never run. `hooks` see each statement
 * before it steps and after it completes.
 *
 * @category running
 * @since 1.0.0
 */
export const runEach = async (
  { db, sqlite3 }: Database,
  entries: ReadonlyArray<Entry>,
  shape: "object" | "array",
  hooks: Hooks = {}
): Promise<{ readonly results: Array<Array<unknown>>; readonly columns: number }> => {
  const results: Array<Array<unknown>> = []
  let columns = 0
  for (const [index, { params, sql }] of entries.entries()) {
    const rows: Array<unknown> = []
    results.push(rows)
    const lastEntry = index === entries.length - 1
    // Where the next statement's text starts: each statement's text runs from the end of the one before.
    let at = 0
    for await (const statement of sqlite3.statements(db, sql)) {
      const text = sqlite3.sql(statement)
      // Text that isn't where it should be is never taken for the last statement.
      const last = lastEntry && sql.startsWith(text, at) && !holdsStatement(sql.slice(at + text.length))
      at += text.length
      await hooks.before?.({ last, results })
      sqlite3.bind_collection(statement, params.map(bindable) as Array<SQLiteCompatibleType>)
      const names = sqlite3.column_names(statement)
      columns += names.length
      while (await sqlite3.step(statement) === row) {
        const values = sqlite3.row(statement)
        if (shape === "array") {
          rows.push(values)
        } else {
          const entry: Record<string, unknown> = {}
          names.forEach((name, index) => Record.assignProperty(entry, name, values[index]))
          rows.push(entry)
        }
      }
      await hooks.after?.()
    }
  }
  return { results, columns }
}

/**
 * Runs every statement in `sql`, binding `params` to each, and collects the
 * rows of those that return any: {@link runEach} of one entry.
 *
 * @category running
 * @since 1.0.0
 */
export const runAll = async (
  database: Database,
  sql: string,
  params: ReadonlyArray<unknown>,
  shape: "object" | "array",
  hooks: Hooks = {}
): Promise<{ readonly rows: Array<unknown>; readonly columns: number }> => {
  const { columns, results } = await runEach(database, [{ sql, params }], shape, hooks)
  return { rows: results[0]!, columns }
}

module $call$ts {
export function invoke<T extends Function>(target:T,arg0:Parameters<Extract<T,(...args:any[])=>any>>[0]):ReturnType<Extract<T,(...args:any[])=>any>> { return target(arg0) }
}
import { invoke as $invoke } from $call$ts
