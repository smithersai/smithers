/**
 * The durable flow runtime for one execution on Cloudflare.
 *
 * It is the same `Runtime.layer` the Node and Bun hosts compose, over the
 * Cloudflare Host surface and an injected `SqlClient`, configured for a host
 * that drives one execution per invocation: the engine runs no sweep and
 * renews no lease (`sweep: { host }`), refuses every run but its own
 * execution, and judges an earlier incarnation of the same Durable Object
 * dead at once. Build it inside the invocation that drives the execution
 * (`ExecutionObject.alarm` does), so its connections close when that
 * invocation ends.
 *
 * Nothing else deletes from a Durable Object's own engine store (`smithers gc`
 * runs on a host's files), so an object that runs one execution per
 * invocation grows by one run each time. `retention` makes the runtime run one
 * bounded {@link Retention} pass over the object's SQLite as it is built.
 *
 * @since 1.0.0
 */

import { Retention as EngineRetention, StepBoundary, WorkspaceSandbox } from "@smthrs/engine-store"
import { RunMetrics } from "@smthrs/flow"
import { Runtime } from "@smthrs/flows"
import { Ownership } from "@smthrs/run-store"
import * as Clock from "effect/Clock"
import * as Exit from "effect/Exit"
import * as Layer from "effect/Layer"
import * as Metric from "effect/Metric"
import type * as SqlClient from "effect/sql/SqlClient"
import * as CloudflareHost from "./CloudflareHost.vibe"
import { failureType } from "./internal/Observed.vibe"

/**
 * What one execution's runtime is configured with.
 *
 * @category models
 * @since 1.0.0
 */
export interface Options {
  /**
   * The Durable Object this runtime runs in, stable across its incarnations:
   * pass `ctx.id.toString()`. Every incarnation fences its writes as this
   * host, and one that finds a run held under this id by another incarnation
   * takes it at once.
   */
  readonly hostId: string
  /** The one execution this runtime drives. Every other run is refused. */
  readonly executionId: string
  /** Persisted intent's flow tag; avoids recovery queries for unrelated registrations. */
  readonly flow?: string | undefined
  /**
   * Delete this store's settled history as the runtime is built. Unset, the
   * runtime deletes nothing, as before.
   */
  readonly retention?: Retention | undefined
}

/**
 * Which settled runs one pass deletes from the store the runtime opens.
 *
 * The pass is `@smthrs/engine-store`'s `Retention.collect`, the one `smithers gc`
 * runs, over the engine's own terminal-run state: only a `completed`,
 * `failed` or `cancelled` run that finished at least `olderThanMs` ago, never
 * one a live run stands above or below, and never the execution this runtime
 * drives, so driving an aged settled execution again still answers its
 * recorded result. Each run goes with its journal, attempts, timers and
 * completions in one transaction. A run's history is the only account of what
 * it did, and its execution id stops deduplicating once it is deleted, so pick
 * `olderThanMs` longer than any caller retries that id.
 *
 * The pass runs before the engine's migrations and recovery, in the same
 * invocation. A failed pass deletes nothing, is logged and counted, and never
 * fails the execution.
 *
 * @category models
 * @since 1.0.0-rc.17
 */
export interface Retention {
  /** Delete terminal runs that finished at least this many milliseconds ago. A negative value is read as zero. */
  readonly olderThanMs: number
  /** Most runs one pass deletes; {@link defaultRetentionLimit} when unset. */
  readonly limit?: number | undefined
}

/**
 * Runs one retention pass deletes when `limit` is unset: more than an
 * invocation adds, so the store shrinks back to its window, and few enough to
 * keep the object's transaction short.
 *
 * @category constants
 * @since 1.0.0-rc.17
 */
export const defaultRetentionLimit = 100

/**
 * Retention passes, by `outcome`: `deleted`, `none` or `failed`.
 *
 * @category telemetry
 * @since 1.0.0-rc.17
 */
export const retentionPasses = Metric.counter("smithers_cloudflare_retention_passes", {
  description: "Engine retention passes in a Durable Object, by outcome",
  incremental: true
})

/**
 * Settled runs retention deleted.
 *
 * @category telemetry
 * @since 1.0.0-rc.17
 */
export const retainedRunsDeleted = Metric.counter("smithers_cloudflare_retention_runs_deleted", {
  description: "Settled engine runs deleted by retention in a Durable Object",
  incremental: true
})

/**
 * The log line each pass writes: its `outcome`, how many `runs` it deleted,
 * `durationMs`, and on failure the error's tag as `error.type`. Never a run
 * id, payload or failure message.
 *
 * @category telemetry
 * @since 1.0.0-rc.17
 */
export const retentionLog = "smithers.cloudflare.retention"

const retain = (executionId: string, retention: Retention): void!never!SqlClient.SqlClient =>
  Effect.withSpan(
    effect {
      const startedAt = try Clock.currentTimeMillis
      const exit = try Effect.exit(EngineRetention.collect({
        olderThanMs: startedAt - Math.max(0, retention.olderThanMs),
        limit: retention.limit ?? defaultRetentionLimit,
        pins: [executionId]
      }))
      const runs = Exit.isSuccess(exit) ? exit.value.runs.length : 0
      const outcome = Exit.isFailure(exit) ? "failed" : runs > 0 ? "deleted" : "none"
      const failure = Exit.isFailure(exit) ? { "error.type": failureType(exit.cause) } : {}
      const durationMs = (try Clock.currentTimeMillis) - startedAt
      try Effect.annotateCurrentSpan({
        "smithers.retention.outcome": outcome,
        "smithers.retention.runs": runs,
        ...failure
      })
      try Metric.update(Metric.withAttributes(retentionPasses, { outcome }), 1)
      if (runs > 0) try Metric.update(retainedRunsDeleted, runs)
      try Effect.annotateLogs(
        (Exit.isFailure(exit) ? Effect.logWarning : Effect.logInfo)(retentionLog),
        { outcome, runs, durationMs, ...failure }
      )
    },
    "smithers.cloudflare.retention"
  )

/**
 * Provides the durable engine for one execution, with `registerFlows`
 * registered, over the `SqlClient` the caller provides.
 *
 * The caller provides the `SqlClient`, for example `@smthrs/database`'s
 * `PostgresDatabase.layer` over a Hyperdrive connection string, and whatever
 * `registerFlows` requires beyond the engine.
 *
 * @category layers
 * @since 1.0.0
 */
export const layer = <Registered, RegistrationError, RegistrationRequirements>(
  options: Options,
  registerFlows: Layer.Layer<Registered, RegistrationError, RegistrationRequirements>
) =>
  runtime(options, registerFlows).pipe(
    // Built first, before the engine's migrations and recovery read the store.
    Layer.provideMerge(
      options.retention === undefined
        ? Layer.empty
        : Layer.effectDiscard(retain(options.executionId, options.retention))
    )
  )

const runtime = <Registered, RegistrationError, RegistrationRequirements>(
  options: Options,
  registerFlows: Layer.Layer<Registered, RegistrationError, RegistrationRequirements>
) =>
  Runtime.layer(
    {
      owner: { hostId: options.hostId },
      isAlive: Ownership.singleIncarnationLiveness,
      canExecute: (row) => Effect.succeed(row.runId === options.executionId),
      sweep: { host: options.executionId, ...(options.flow === undefined ? {} : { flow: options.flow }) },
      placement: "cloudflare"
    },
    StepBoundary.layerUnsupported,
    WorkspaceSandbox.layerUnsupported,
    registerFlows
  ).pipe(
    Layer.provide(CloudflareHost.layer),
    // Workers Logs are this host's telemetry: the usage lines (`flow.run.*`) go out at Info.
    Layer.provide(RunMetrics.layerInfoLines)
  )
