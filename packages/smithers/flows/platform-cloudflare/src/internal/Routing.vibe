/**
 * Which other executions a drive left for their own Durable Objects.
 *
 * A Durable Object drives one execution, and its runtime refuses every other
 * one. A drive can still create executions and make them due: a `.child()`
 * call admits a child, a `.to()` handoff admits the next round, and a
 * settlement makes the parents waiting on it due, or asks a linked child to
 * cancel, and a cancellation admits the run its flow declared for it
 * (`Flow.OnCancel`). The store records each of those, and `EngineStore.drive` records a
 * settled run's parent wakes again whenever it finds one missing, so the
 * object reads them back from the store after every drive, not from what the
 * drive happened to report before an isolate died.
 *
 * @since 1.0.0
 */

import { DurableEngineState, EngineStore, RunState } from "@smthrs/engine-store"
import { RunStore } from "@smthrs/run-store"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"

/**
 * What a drive left for other objects.
 *
 * - `start`: executions this one created that no object has driven yet, as
 *   the intents their own objects store.
 * - `wake`: executions with work due now that their own objects already
 *   hold: a parent this one's settlement made due, or a child or the next
 *   round asked to cancel.
 *
 * @category models
 * @since 1.0.0
 */
export interface Routes {
  readonly start: ReadonlyArray<{ readonly flow: string; readonly executionId: string; readonly payload: unknown }>
  readonly wake: ReadonlyArray<string>
}

const decodeState = Schema.decodeUnknownEffect(Schema.fromJsonString(RunState.RunState))

/**
 * Reads what driving `executionId` left for other objects.
 *
 * 1. The round it handed off to, if any, and the current round of each child
 *    lineage linked to it: to this round alone while the lineage runs, and to
 *    every round of it once its last round settled, since that settlement
 *    ends the linked children of every round. One with work due is started
 *    when it is still `pending`, since no object has its intent yet, and woken
 *    otherwise, as a child asked to cancel is.
 * 2. When it was cancelled, the cancellation run its flow declared, which its
 *    cancelled state names: started on its own object, since nothing else
 *    holds its intent.
 * 3. Its parents, when it settled and is the last round of its lineage: every
 *    parent the engine wakes for a settlement (the one its state names and
 *    the edges of every round), when that parent has work due. An earlier
 *    round's settlement wakes no parent; the lineage has not settled.
 *
 * "Due" is `EngineStore.nextWake` at or before now, so a parent that has
 * already consumed this settlement, a settled child and an unknown id are
 * left alone. Every read is one read transaction: one snapshot, and the
 * round trips of one transaction rather than one per read.
 *
 * @category operations
 * @since 1.0.0
 */
export const routes = (executionId: string) =>
  Effect.flatMap(DurableEngineState.DurableEngineState, (engineState) => engineState.readTransaction(read(executionId)))

/**
 * {@link routes}' reads, which it runs as one read transaction: one snapshot of what the drive left, and one
 * transaction's round trips for all of them rather than a transaction for each.
 */
const read = effect (executionId: string) => {
  const runs = try RunStore.RunStore
  const engineState = try DurableEngineState.DurableEngineState
  // Read the clock after `nextWake` does: it answers "now" with its own read.
  const due = effect (id: string) => {
    const wake = try EngineStore.nextWake(id)
    const nowMs = Math.floor(try Clock.currentTimeMillis)
    return Option.exists(wake, (at) => at <= nowMs)
  }

  const lineage = try runs.lineage(executionId)
  const index = lineage.findIndex((round) => round.runId === executionId)
  const self = lineage[index]!
  const successor = lineage[index + 1]
  const settled = successor === undefined &&
    (try Effect.sync(() => RunStore.isTerminalRunStatus(self.status)))

  const linked = new Set<string>()
  for (const round of settled ? lineage : [self]) {
    for (const edge of try engineState.runChildren(round.runId)) linked.add(edge.childId)
  }
  const next: Array<RunStore.RunRow> = successor === undefined ? [] : [successor]
  for (const child of linked) next.push(try runs.latestRound(child))
  const state = settled ? try decodeState(self.stateJson) : undefined
  const cancellation = state?.cancellation?.run
  if (cancellation !== undefined) next.push(try runs.latestRound(cancellation))

  const start: Array<Routes["start"][number]> = []
  const wake: Array<string> = []
  for (const row of next) {
    if (!(try due(row.runId))) continue
    if (row.status !== "pending") {
      wake.push(row.runId)
      continue
    }
    const admitted = try decodeState(row.stateJson)
    start.push({ flow: admitted.flowName, executionId: row.runId, payload: admitted.payload })
  }

  if (state !== undefined) {
    const parents = new Set<string>(state.parentExecutionId === undefined ? [] : [state.parentExecutionId])
    for (const round of lineage) {
      for (const edge of try engineState.runParents(round.runId)) parents.add(edge.parentId)
    }
    for (const parent of parents) {
      if (try due(parent)) wake.push(parent)
    }
  }
  return { start, wake } satisfies Routes
}
