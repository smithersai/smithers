{
  "name": "@smthrs/flows",
  "type": "module",
  "version": "1.0.0-rc.18",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "Barrel package re-exporting the whole @smthrs durable flow engine and its platform-neutral Runtime",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "durable-execution"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "durable-execution"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./index": "./src/index.ts",
    "./Runtime": "./src/Runtime.ts",
    "./NodeRuntime": null,
    "./SandboxedFlow": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "dist/vendor/**",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./*/index": null,
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./Runtime": {
        "import": {
          "types": "./dist/esm/Runtime.d.ts",
          "default": "./dist/esm/Runtime.js"
        },
        "require": {
          "types": "./dist/cjs/Runtime.d.ts",
          "default": "./dist/cjs/Runtime.js"
        }
      },
      "./NodeRuntime": null,
      "./SandboxedFlow": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/artifacts": "1.0.0-rc.18",
    "@smthrs/canonical": "1.0.0-rc.18",
    "@smthrs/capability": "1.0.0-rc.18",
    "@smthrs/crypto": "1.0.0-rc.18",
    "@smthrs/database": "1.0.0-rc.18",
    "@smthrs/engine": "1.0.0-rc.18",
    "@smthrs/engine-store": "1.0.0-rc.18",
    "@smthrs/flow": "1.0.0-rc.18",
    "@smthrs/jj": "1.0.0-rc.18",
    "@smthrs/journal": "1.0.0-rc.18",
    "@smthrs/kernel": "1.0.0-rc.18",
    "@smthrs/keys": "1.0.0-rc.18",
    "@smthrs/observability": "1.0.0-rc.18",
    "@smthrs/plan": "1.0.0-rc.18",
    "@smthrs/plan-store": "1.0.0-rc.18",
    "@smthrs/run-store": "1.0.0-rc.18",
    "@smthrs/sandbox": "1.0.0-rc.18",
    "@smthrs/step-cache": "1.0.0-rc.18",
    "@smthrs/sync": "1.0.0-rc.18",
    "@smthrs/time-travel": "1.0.0-rc.18"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.1.1",
    "@effect/platform-node-shared": "4.1.1",
    "@effect/sql-pg": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@eslint/js": "9.39.5",
    "@smthrs/control": "1.0.0-rc.18",
    "@smthrs/core": "1.0.0-rc.18",
    "@smthrs/model": "1.0.0-rc.18",
    "@smthrs/notifications": "1.0.0-rc.18",
    "@smthrs/patterns": "1.0.0-rc.18",
    "@smthrs/registry": "1.0.0-rc.18",
    "@smthrs/targets": "1.0.0-rc.18",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.1.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "microsandbox": "0.6.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vitest": "5.0.0",
    "@smthrs/platform-node": "1.0.0-rc.18"
  },
  "peerDependencies": {
    "effect": "4.1.1"
  }
}
