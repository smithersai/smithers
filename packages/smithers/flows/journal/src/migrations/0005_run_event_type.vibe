/**
 * Indexed exact event-type reads within a run.
 *
 * @since 1.0.0
 */

import * as Effect from "effect/Effect"
import * as SqlClient from "effect/sql/SqlClient"

/**
 * Keeps filtered cursor reads proportional to the matching entries.
 *
 * @category migrations
 * @since 1.0.0
 */
export const runEventType: void!unknown!SqlClient.SqlClient = effect {
  const sql = try SqlClient.SqlClient
  try Effect.suspend(() =>
    sql`CREATE INDEX flows_journal_events_run_event_type_idx ON flows_journal_events (run_id, event_type, seq)`
  )
}
