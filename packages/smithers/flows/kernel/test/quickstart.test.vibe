import { expect, it } from "@effect/vitest"
import { attended, unattended } from "../examples/quickstart.vibe"
import { makeWorkspace, rawHost } from "./fixtures/quickstartHost.ts"

it.effect("refuses an ungranted read with the capability it needed", effect () => {
  const root = try Effect.try(() => makeWorkspace())
  provide rawHost(root) {
    expect(try unattended(root)).toEqual(Option.some(expect.objectContaining({
      code: "permission_required",
      capability: expect.objectContaining({ action: "fs:read", resource: `${root}/README.md` }),
      tier: "sealed"
    })))
  }
})

it.effect("parks the read on an attended store and resumes it on a reply", effect () => {
  const root = try Effect.try(() => makeWorkspace())
  provide rawHost(root) {
    const { capability, contents } = try attended(root)
    expect(capability).toMatchObject({ action: "fs:read", resource: `${root}/README.md` })
    expect(contents).toBe("# hello")
  }
})
