{
  "name": "@smthrs/engine",
  "type": "module",
  "version": "1.0.0-rc.16",
  "license": "MIT",
  "smthrs": {
    "group": "engine"
  },
  "description": "The runtime that executes @smthrs/flow flows, plus HTTP and RPC transport projections",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/flows/engine"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "durability"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "durability"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./FlowEngine": {
      "types": "./src/FlowEngine/index.ts",
      "vibelang-source": "./src/FlowEngine/index.ts",
      "default": "./.vibelang/js/src/FlowEngine/index.js"
    },
    "./FlowEngine/*": null,
    "./internal/*": null,
    "./*/index": null,
    "./FlowProxy": {
      "types": "./src/FlowProxy.ts",
      "vibelang-source": "./src/FlowProxy.ts",
      "default": "./.vibelang/js/src/FlowProxy.js"
    },
    "./Hosts": {
      "types": "./.vibe/declarations/src/Hosts.d.vibe.ts",
      "vibelang-source": "./src/Hosts.vibe",
      "default": "./.vibelang/js/src/Hosts.js"
    },
    "./PlacedAction": {
      "types": "./.vibe/declarations/src/PlacedAction.d.vibe.ts",
      "vibelang-source": "./src/PlacedAction.vibe",
      "default": "./.vibelang/js/src/PlacedAction.js"
    },
    "./FlowProxyServer": {
      "types": "./src/FlowProxyServer.ts",
      "vibelang-source": "./src/FlowProxyServer.ts",
      "default": "./.vibelang/js/src/FlowProxyServer.js"
    },
    "./index": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    }
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "VENDOR.md",
    "docs/",
    ".vibelang/js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./FlowEngine": {
        "import": {
          "types": "./dist/esm/FlowEngine/index.d.ts",
          "default": "./dist/esm/FlowEngine/index.js"
        },
        "require": {
          "types": "./dist/cjs/FlowEngine/index.d.ts",
          "default": "./dist/cjs/FlowEngine/index.js"
        }
      },
      "./FlowEngine/*": null,
      "./internal/*": null,
      "./*/index": null,
      "./FlowProxy": {
        "import": {
          "types": "./dist/esm/FlowProxy.d.ts",
          "default": "./dist/esm/FlowProxy.js"
        },
        "require": {
          "types": "./dist/cjs/FlowProxy.d.ts",
          "default": "./dist/cjs/FlowProxy.js"
        }
      },
      "./Hosts": {
        "import": {
          "types": "./dist/esm/Hosts.d.ts",
          "default": "./dist/esm/Hosts.js"
        },
        "require": {
          "types": "./dist/cjs/Hosts.d.ts",
          "default": "./dist/cjs/Hosts.js"
        }
      },
      "./PlacedAction": {
        "import": {
          "types": "./dist/esm/PlacedAction.d.ts",
          "default": "./dist/esm/PlacedAction.js"
        },
        "require": {
          "types": "./dist/cjs/PlacedAction.d.ts",
          "default": "./dist/cjs/PlacedAction.js"
        }
      },
      "./FlowProxyServer": {
        "import": {
          "types": "./dist/esm/FlowProxyServer.d.ts",
          "default": "./dist/esm/FlowProxyServer.js"
        },
        "require": {
          "types": "./dist/cjs/FlowProxyServer.d.ts",
          "default": "./dist/cjs/FlowProxyServer.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.16",
    "@smthrs/crypto": "1.0.0-rc.16",
    "@smthrs/flow": "1.0.0-rc.16",
    "@smthrs/journal": "1.0.0-rc.16",
    "@smthrs/keys": "1.0.0-rc.16",
    "@smthrs/plan": "1.0.0-rc.16",
    "@smthrs/capability": "1.0.0-rc.16",
    "vibelang-runtime": "file:../../../../.vibelang-toolchain/vibelang-runtime-0.0.11-6a665783b5e4.tgz"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "fast-check": "4.9.0",
    "knip": "6.34.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "file:../../../../.vibelang-toolchain/vibelang-0.0.11-08394abdd788.tgz",
    "vibelang-vite": "file:../../../../.vibelang-toolchain/vibelang-vite-0.0.11-a43d2b04075f.tgz",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.1.1"
  }
}
