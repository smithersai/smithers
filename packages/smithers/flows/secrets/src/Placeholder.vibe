/**
 * Placeholders: the text a guest holds where a secret's value would be.
 *
 * A placeholder is `smthrs-secret-` and 64 lowercase hexadecimal characters.
 * It is worthless anywhere but the egress that knows it: only there does it
 * turn into its secret's value, and only for that secret's own hosts. A guest
 * that prints, logs or sends it elsewhere gives away nothing.
 *
 * {@link minter} derives placeholders with HMAC-SHA-256 under a key the host
 * holds, from a scope and a secret's name. The scope names what the guest is,
 * such as a repository, a branch and a sandbox generation, so a new
 * generation gets new placeholders and the old ones stop working, and the
 * host needs to store nothing to recognize them: it derives them again.
 *
 * @since 0.1.0
 */

module platform {
  import * as Effect from "effect/Effect"
  import * as Redacted from "effect/Redacted"
  import * as Schema from "effect/Schema"
  import { utf8 } from "./internal/bytes.ts"

  /**
   * What every placeholder starts with.
   *
   * @category constants
   * @since 0.1.0
   */
  export const prefix = "smthrs-secret-"
  /**
   * The shortest key {@link minter} accepts, in characters: 32, so a key
   * carries at least 128 bits even as hexadecimal.
   *
   * @category constants
   * @since 0.1.0
   */
  export const minimumKeyLength = 32
  /**
   * The key is shorter than {@link minimumKeyLength}.
   *
   * @category errors
   * @since 0.1.0
   */
  export class KeyTooShort extends Schema.TaggedError<KeyTooShort>()("@smthrs/secrets/Placeholder/KeyTooShort", {}) {}
  /**
   * Derives placeholders under one key.
   *
   * @category models
   * @since 0.1.0
   */
  export interface Minter {
    /**
     * The placeholder for secret `name` in `scope`: the same for the same
     * scope and name, and unrelated for any other.
     */
    readonly derive: (scope: string, name: string) => Effect.Effect<string>
  }
  const hex = (bytes: Uint8Array): string => Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("")
  /**
   * A {@link Minter} under `key`, imported once as a non-extractable HMAC key.
   * Fails with {@link KeyTooShort} for a key under 32 characters.
   *
   * @category constructors
   * @since 0.1.0
   */
  export const minter = (key: Redacted.Redacted<string>): Effect.Effect<Minter, KeyTooShort> =>
    Effect.gen(function*() {
      const raw = Redacted.value(key)
      if (raw.length < minimumKeyLength) return yield* new KeyTooShort()
      const hmac = yield* Effect.promise(() =>
        crypto.subtle.importKey("raw", utf8(raw), { name: "HMAC", hash: "SHA-256" }, false, ["sign"])
      )
      return {
        derive: (scope, name) =>
          Effect.promise(() => crypto.subtle.sign("HMAC", hmac, utf8(JSON.stringify(["placeholder", scope, name]))))
            .pipe(Effect.map((mac) => `${prefix}${hex(new Uint8Array(mac))}`))
      }
    })
}

export { KeyTooShort, minimumKeyLength, minter, prefix } from platform
export type { Minter } from platform

/**
 * Whether `text` is exactly one placeholder.
 *
 * @category predicates
 * @since 0.1.0
 */
export const is = (text: string): boolean => /^smthrs-secret-[0-9a-f]{64}$/.test(text)
/**
 * Every placeholder in `text`, in order, repeats included.
 *
 * @category parsing
 * @since 0.1.0
 */
export const find = (text: string): ReadonlyArray<string> => text.match(/smthrs-secret-[0-9a-f]{64}/g) ?? []
