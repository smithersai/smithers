/**
 * The docs quickstart as a runnable program: declare a migration set, compose
 * a SQLite database, write through the durable boundary, read the row and the
 * migration ledger back, and count what a delete changed.
 *
 * Run it with `node examples/quickstart.ts`; `test/examples.test.ts` runs it
 * against a temporary file so `docs/quickstart.md` and this program stay in
 * step.
 *
 * @since 1.0.0
 */

import * as DurableWriter from "@smthrs/database/DurableWriter"
import * as Migrations from "@smthrs/database/Migrations"
import * as NodeDatabase from "@smthrs/database/node/NodeDatabase"

const createNotes: void!unknown!SqlClient.SqlClient = effect {
  const sql = try SqlClient.SqlClient
  try sql`CREATE TABLE notes (id TEXT PRIMARY KEY, body TEXT NOT NULL)`
}

const notes: Migrations.MigrationSet = {
  namespace: "notes",
  idOffset: 0,
  migrations: { "0001_initial": createNotes }
}

/**
 * What one quickstart pass observed.
 *
 * @category models
 * @since 1.0.0
 */
export interface QuickstartResult {
  /** The migrations this pass applied, as `Migrations.run` reports them. */
  readonly applied: ReadonlyArray<readonly [id: number, name: string]>
  /** The note bodies after the insert. */
  readonly bodies: ReadonlyArray<string>
  /** Every row of the `flows_migrations` ledger. */
  readonly ledger: ReadonlyArray<{ readonly migration_id: number; readonly name: string }>
  /** Affected-row counts of the same delete run twice: the match, then the miss. */
  readonly deleted: readonly [first: number, second: number]
}

/**
 * Migrates the SQLite file at `filename`, inserts one note through
 * `DurableWriter`, reads it and the ledger back, then deletes it twice.
 *
 * The insert uses a fixed primary key, so a second run on a file a first run
 * left with the row still present fails with a `constraint` `DatabaseError`.
 * This program deletes the row before it returns, so reruns succeed and apply
 * no migration.
 *
 * Fails with `DatabaseError` when a write fails, and with `MigrationError` when
 * the ladder refuses.
 *
 * @param filename - The SQLite database file to create or open.
 * @returns The migrations applied, the note bodies, the ledger, and both delete counts.
 * @since 1.0.0
 * @category examples
 */
export const quickstart = (filename: string): Promise<QuickstartResult> => {
  const database = Layer.provideMerge(DurableWriter.layer(), NodeDatabase.layer({ filename }))

  const program = effect {
    const sql = try SqlClient.SqlClient
    const writer = try DurableWriter.DurableWriter
    const applied = try Migrations.run([notes])

    try writer.write(sql`INSERT INTO notes (id, body) VALUES ('first', 'hello')`)
    const rows = try sql<{ readonly body: string }>`SELECT body FROM notes ORDER BY id`
    const ledger = try sql<{
      readonly migration_id: number
      readonly name: string
    }>`SELECT migration_id, name FROM ${sql(Migrations.table)} ORDER BY migration_id`

    const deleteFirst = writer.write(
      sql`DELETE FROM notes WHERE id = ${"first"}`.raw |> Effect.flatMap(%, DurableWriter.affectedRows)
    )
    const first = try deleteFirst
    const second = try deleteFirst

    return {
      applied,
      bodies: rows.map((row) => row.body),
      ledger: ledger.map(({ migration_id, name }) => ({ migration_id: Number(migration_id), name })),
      deleted: [first, second] as const
    }
  }

  return Effect.runPromise(program |> Effect.provide(%, database) |> Effect.scoped(%))
}
