{
  "name": "@smthrs/gateway",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Effect workspace gateway contracts, projections, and supervision ports for flows",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/gateway"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "gateway",
    "control"
  ],
  "keywords": [
    "typescript",
    "effect",
    "gateway",
    "control"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Diagnosis": "./src/Diagnosis.ts",
    "./GatewayError": "./src/GatewayError.ts",
    "./GatewayProjection": "./src/GatewayProjection.ts",
    "./GatewayRpcs": "./src/GatewayRpcs.ts",
    "./GatewaySchema": "./src/GatewaySchema.ts",
    "./GatewayServer": "./src/GatewayServer.ts",
    "./Projections": "./src/Projections.ts",
    "./SuperviseRuntime": "./src/SuperviseRuntime.ts",
    "./index": "./src/index.ts",
    "./node/NodeGateway": "./src/node/NodeGateway.ts",
    "./test/TestSuperviseRuntime": "./src/test/TestSuperviseRuntime.ts",
    "./bun/BunGateway": "./src/bun/BunGateway.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Diagnosis": {
        "types": "./dist/esm/Diagnosis.d.ts",
        "import": "./dist/esm/Diagnosis.js",
        "require": "./dist/cjs/Diagnosis.js"
      },
      "./GatewayError": {
        "types": "./dist/esm/GatewayError.d.ts",
        "import": "./dist/esm/GatewayError.js",
        "require": "./dist/cjs/GatewayError.js"
      },
      "./GatewayProjection": {
        "types": "./dist/esm/GatewayProjection.d.ts",
        "import": "./dist/esm/GatewayProjection.js",
        "require": "./dist/cjs/GatewayProjection.js"
      },
      "./GatewayRpcs": {
        "types": "./dist/esm/GatewayRpcs.d.ts",
        "import": "./dist/esm/GatewayRpcs.js",
        "require": "./dist/cjs/GatewayRpcs.js"
      },
      "./GatewaySchema": {
        "types": "./dist/esm/GatewaySchema.d.ts",
        "import": "./dist/esm/GatewaySchema.js",
        "require": "./dist/cjs/GatewaySchema.js"
      },
      "./GatewayServer": {
        "types": "./dist/esm/GatewayServer.d.ts",
        "import": "./dist/esm/GatewayServer.js",
        "require": "./dist/cjs/GatewayServer.js"
      },
      "./Projections": {
        "types": "./dist/esm/Projections.d.ts",
        "import": "./dist/esm/Projections.js",
        "require": "./dist/cjs/Projections.js"
      },
      "./SuperviseRuntime": {
        "types": "./dist/esm/SuperviseRuntime.d.ts",
        "import": "./dist/esm/SuperviseRuntime.js",
        "require": "./dist/cjs/SuperviseRuntime.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./node/NodeGateway": {
        "types": "./dist/esm/node/NodeGateway.d.ts",
        "import": "./dist/esm/node/NodeGateway.js",
        "require": "./dist/cjs/node/NodeGateway.js"
      },
      "./test/TestSuperviseRuntime": {
        "types": "./dist/esm/test/TestSuperviseRuntime.d.ts",
        "import": "./dist/esm/test/TestSuperviseRuntime.js",
        "require": "./dist/cjs/test/TestSuperviseRuntime.js"
      },
      "./bun/BunGateway": {
        "types": "./dist/esm/bun/BunGateway.d.ts",
        "import": "./dist/esm/bun/BunGateway.js",
        "require": "./dist/cjs/bun/BunGateway.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/control": "1.0.0-rc.0",
    "@smthrs/sync": "1.0.0-rc.0",
    "@effect/platform-bun": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@smthrs/database": "1.0.0-rc.0",
    "@smthrs/engine-store": "1.0.0-rc.0",
    "@smthrs/flow": "1.0.0-rc.0",
    "@smthrs/flows": "1.0.0-rc.0",
    "@smthrs/journal": "1.0.0-rc.0",
    "@smthrs/kernel": "1.0.0-rc.0",
    "@smthrs/notifications": "1.0.0-rc.0",
    "@smthrs/registry": "1.0.0-rc.0",
    "@smthrs/run-store": "1.0.0-rc.0",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  }
}
