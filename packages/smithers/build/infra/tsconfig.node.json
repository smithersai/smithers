{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "PACKAGE.ts",
    "alchemy.run.ts",
    "deployment.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "PACKAGE.vibe",
    "alchemy.run.vibe",
    "deployment.vibe",
    "scripts/**/*.vibe",
    "vitest.config.vibe"
  ]
}
