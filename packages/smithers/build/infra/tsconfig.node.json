{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "PACKAGE.ts",
    "alchemy.run.ts",
    "deployment.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "PACKAGE.vibe",
    "alchemy.run.vibe",
    "deployment.vibe",
    "scripts/**/*.vibe",
    "vitest.config.vibe",
    "../../../repo-targets/src/vibelang-eslint.d.ts"
  ]
}
