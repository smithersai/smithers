{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "scripts/**/*.test.ts",
    "worker/test/**/*.ts",
    "scripts/**/*.test.vibe",
    "worker/test/**/*.vibe"
  ],
  "exclude": [
    "worker/test/cli-contract.test.ts",
    "worker/test/cli-output-contract.test.ts",
    "worker/test/cli-output-faults-contract.test.ts",
    "worker/test/cli-output-runner-contract.test.ts"
  ]
}
