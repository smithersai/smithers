{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "worker/**/*.ts",
    "worker/**/*.vibe"
  ],
  "exclude": [
    "worker/test/**"
  ]
}
