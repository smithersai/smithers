/**
 * Holds a host to the interpreter version a workspace declares, without
 * spawning anything. `Runtime.satisfies` answers the comparison alone, and
 * `Runtime.layerNoop` reports a fixed version through the same `verify` the
 * live `Runtime.layerNode` service runs after probing `node --version`.
 * `test/Examples.test.ts` runs it.
 */
import * as Runtime from "@smthrs/build/Runtime"

const platform = { os: "linux", arch: "x64", libc: "glibc" }

/** Answers each requirement against Node 26.10.0. */
export const compareVersions = () => ({
  atLeast: Runtime.satisfies(">=26.4.0", "26.10.0"),
  exact: Runtime.satisfies("=26.10.0", "v26.10.0"),
  below: Runtime.satisfies("<26", "26.10.0"),
  caret: Runtime.satisfies("^26.0.0", "26.10.0")
})

/**
 * Verifies a host that reports `version` against `>=26.4.0`, and resolves
 * with the measured version or the refusal's code.
 */
export const verifyHost = (version: string) =>
  Effect.runPromise(
    (effect {
      const runtime = try Runtime.Runtime
      return try runtime.verify
    })
      |> Effect.catchTag(%, "smithers-build/RuntimeError", (error) => Effect.succeed(error.code))
      |> Effect.provide(%, Runtime.layerNoop("node", { requirement: ">=26.4.0", platform, version }))
  )
