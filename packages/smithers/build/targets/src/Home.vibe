/**
 * The homepage a factory declares for its repository: `.smithers/home.json`.
 *
 * A repository's workspace chat opens with its homepage message, a README
 * alternative the maintainer declares in
 * `.smithers/FACTORY.ts` as `export const home = Smithers.Factory.Home({ blocks })`,
 * the second export beside the factory itself. Blocks are declared values,
 * never raw HTML, in the one home format `@smthrs/views` defines (`Home`),
 * which the app reads the file with. The app renders every block from data;
 * a string carrying an HTML tag is refused where it is written.
 *
 * The declaration is inert, like {@link Flow.Flow}. The `FactoryProjection`
 * target (`Factory.ts`) projects it into a checked-in JSON file beside
 * `.smithers/factory.json` the same way `ci.yml` and the root `tsconfig.json`
 * are projected: `write` renders it, `check` fails on drift, and the `lint`
 * verb never writes. The file is checked in so the public mirror serves it
 * signed out and a workspace without `node_modules` never has to evaluate
 * `FACTORY.ts`.
 *
 * @since 1.0.0
 */

import * as Views from "@smthrs/views"
import * as Schema from "effect/Schema"
import * as $platform from "./Home.platform.ts"

/**
 * The home file's format, one copy: `@smthrs/views`' `Home`, which the app
 * reads the file with. Every constant, schema and block below is that
 * package's own, under the names this module has always exported.
 */
const Format = Views.Home
/**
 * Maximum length of one block's title or one link's label (`Home.maximumTitleLength` of `@smthrs/views`).
 *
 * @category constants
 * @since 1.0.0
 */
export const maximumTitleLength = Format.maximumTitleLength
/**
 * Maximum length of one text block (`Home.maximumTextLength` of `@smthrs/views`).
 *
 * @category constants
 * @since 1.0.0
 */
export const maximumTextLength = Format.maximumTextLength
/**
 * Maximum length of one link URL (`Home.maximumUrlLength` of `@smthrs/views`).
 *
 * @category constants
 * @since 1.0.0
 */
export const maximumUrlLength = Format.maximumUrlLength
/**
 * Maximum number of blocks one home declares (`Home.maximumBlocks` of `@smthrs/views`).
 *
 * @category constants
 * @since 1.0.0
 */
export const maximumBlocks = Format.maximumBlocks
/**
 * The shape of raw HTML in a string (`Home.htmlPattern` of `@smthrs/views`): a
 * tag, a closing tag, a comment, or a processing instruction opener.
 *
 * @category constants
 * @since 1.0.0
 */
export const htmlPattern = Format.htmlPattern
/**
 * A one-line title or label: non-empty, bounded, one line, no HTML.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Title = Format.Title
/**
 * A paragraph of plain text: non-empty, bounded, no HTML.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Prose = Format.Prose
/**
 * A link target: a safe absolute `http` or `https` URL, or an origin-relative
 * path starting with one `/`, using the reader's schema.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Url = Format.Url
/**
 * A relative path that cannot escape the repository.
 *
 * @category schemas
 * @since 1.0.0
 */
export const RepositoryPath = Format.RepositoryPath
/**
 * A slash leaf name or repository flow id (`Home.FlowName` of `@smthrs/views`).
 *
 * @category schemas
 * @since 1.0.0
 */
export const PromptFlow = Format.FlowName
/**
 * A paragraph of plain text under an optional title.
 *
 * @category schemas
 * @since 1.0.0
 */
export const TextBlock = Format.TextBlock
/**
 * One link: the label the app shows and the URL it opens.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Link = Format.Link
/**
 * A list of links under an optional title.
 *
 * @category schemas
 * @since 1.0.0
 */
export const LinksBlock = Format.LinksBlock
/**
 * The repository's flows, which the app lists from its own catalog. The block carries no rows.
 *
 * @category schemas
 * @since 1.0.0
 */
export const FlowsBlock = Format.FlowsBlock
/**
 * A prompt: a heading over the way to ask, and the flow that takes the question.
 *
 * @category schemas
 * @since 1.0.0
 */
export const PromptBlock = Format.PromptBlock
/**
 * The pictures an app tile may wear: what the app's result looks like.
 *
 * @category schemas
 * @since 1.0.0
 */
export const AppPicture = Format.AppPicture
/**
 * An app: one flow's button, with a title and a picture.
 *
 * @category schemas
 * @since 1.0.0
 */
export const AppBlock = Format.AppBlock
/**
 * A repository markdown file, read at the home's own commit.
 *
 * @category schemas
 * @since 1.0.0
 */
export const MarkdownBlock = Format.MarkdownBlock
/**
 * The repository's live stack of changes, which the app reads itself. The block carries no rows.
 *
 * @category schemas
 * @since 1.0.0
 */
export const StackBlock = Format.StackBlock
/**
 * The view a repository flow declares (`Smithers.Flow({ view })`), drawn here
 * in its place: `Factory.Home({ blocks: [Smithers.Home.View({ flow })] })`.
 *
 * @category schemas
 * @since 1.0.0
 */
export const ViewBlock = Format.ViewBlock
/**
 * One declared block: any kind `@smthrs/views` reads, the landing page's
 * (`hero`, `code`, `cards`, `stats`, `releases`) and the live ones (`issues`,
 * `runs`) included.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Block = Format.Block
/**
 * One block of a flow's own view: every block that needs no server
 * resolution. A markdown block reads a file at main, which only the
 * homepage route resolves, and a view block inside a view would recurse.
 *
 * @category schemas
 * @since 1.0.0
 */
export const FlowViewBlock = Schema.Union([TextBlock, LinksBlock, FlowsBlock, PromptBlock, StackBlock, AppBlock])
/**
 * The view a flow declares: its blocks, in declaration order.
 *
 * @category schemas
 * @since 1.0.0
 */
export const FlowView = Schema.NonEmptyArray(FlowViewBlock).check(Schema.isMaxLength(maximumBlocks))
/**
 * One declared block.
 *
 * @category models
 * @since 1.0.0
 */
export type Block = typeof Block.Type
/**
 * The home declaration `.smithers/FACTORY.ts` exports as `home`.
 *
 * @category schemas
 * @since 1.0.0
 */
export const Declaration = Schema.TaggedStruct("HomeDeclaration", {
  blocks: Schema.NonEmptyArray(Block).check(Schema.isMaxLength(maximumBlocks))
})
/**
 * The home declaration `.smithers/FACTORY.ts` exports as `home`.
 *
 * @category models
 * @since 1.0.0
 */
export type Declaration = typeof Declaration.Type
/**
 * The document `.smithers/home.json` holds: the blocks, in declaration order.
 *
 * @category schemas
 * @since 1.0.0
 */
export schema Document {
  readonly blocks: ReadonlyArray<Block>
}
/**
 * The document `.smithers/home.json` holds.
 *
 * @category models
 * @since 1.0.0
 */
export type Document = typeof Document.Type
/**
 * Reports whether a value is a home declaration.
 *
 * @category guards
 * @since 1.0.0
 */
export const isHomeDeclaration: (value: unknown) => value is Declaration = Schema.is(Declaration)
const formatIssue = SchemaIssue.makeFormatterDefault()
/**
 * Reads one constructor's options as a plain object of enumerable data
 * properties, exactly once, or throws the reason it is not one. Shared with
 * the factory declaration in `Factory.ts`, so every declaration constructor
 * refuses the same shapes with the same words.
 *
 * @category validation
 * @since 1.0.0
 */
export const plainOptions = (name: string, options: unknown, keys: ReadonlySet<string>): Record<string, unknown> => $platform.plainOptions(name, options, keys)
/**
 * Decodes a value through a schema or throws a `TypeError` naming the
 * constructor and the first issue.
 *
 * @category validation
 * @since 1.0.0
 */
export const decode = <S extends Schema.Decoder<unknown, never>>(
  name: string,
  schema: S,
  value: unknown
): S["Type"] => {
  const result = Schema.decodeUnknownResult(schema)(value)
  if (Result.isFailure(result)) $raise(new TypeError(`${name}: ${formatIssue(result.failure.issue)}`))
  return result.success
}
/**
 * Freezes a value and every nested object it holds, so a declaration never
 * changes after it is written.
 *
 * @category validation
 * @since 1.0.0
 */
export const freezeDeep = <T>(value: T): T => {
  if (typeof value === "object" && value !== null) {
    for (const nested of Object.values(value as Record<string, unknown>)) freezeDeep(nested)
    Object.freeze(value)
  }
  return value
}
/**
 * What a `FACTORY.ts` writes for a text block.
 *
 * @category models
 * @since 1.0.0
 */
export interface TextOptions {
  readonly title?: string | undefined
  readonly text: string
}
/**
 * What a `FACTORY.ts` writes for a links block.
 *
 * @category models
 * @since 1.0.0
 */
export interface LinksOptions {
  readonly title?: string | undefined
  readonly links: ReadonlyArray<{ readonly label: string; readonly url: string }>
}
/**
 * What a `FACTORY.ts` writes for a flows block.
 *
 * @category models
 * @since 1.0.0
 */
export interface FlowsOptions {
  readonly title?: string | undefined
}
/**
 * What a `FACTORY.ts` writes for a prompt block.
 *
 * @category models
 * @since 1.0.0
 */
export interface PromptOptions {
  readonly flow?: string | undefined
  readonly title?: string | undefined
  readonly placeholder?: string | undefined
}
/**
 * What a `FACTORY.ts` writes for an app block.
 *
 * @category models
 * @since 1.0.0
 */
export interface AppOptions {
  readonly flow: string
  readonly title: string
  readonly picture: typeof AppPicture.Type
}
/**
 * What a `FACTORY.ts` writes for a markdown block.
 *
 * @category models
 * @since 1.0.0
 */
export interface MarkdownOptions {
  readonly path: string
  readonly title?: string | undefined
}
/**
 * What a `FACTORY.ts` writes for a stack block.
 *
 * @category models
 * @since 1.0.0
 */
export interface StackOptions {
  readonly title?: string | undefined
}
/**
 * What a `FACTORY.ts` writes for a view block.
 *
 * @category models
 * @since 1.0.0
 */
export interface ViewOptions {
  readonly flow: string
}
/**
 * What a `FACTORY.ts` writes for the home declaration.
 *
 * @category models
 * @since 1.0.0
 */
export interface HomeOptions {
  readonly blocks: ReadonlyArray<Block>
}
/**
 * Declares a paragraph of plain text.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Text = (options: TextOptions): typeof TextBlock.Type =>
  freezeDeep(decode("Home.Text", TextBlock, {
    type: "text",
    ...plainOptions("Home.Text", options, new Set(["title", "text"]))
  }))
/**
 * Declares a list of links.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Links = (options: LinksOptions): typeof LinksBlock.Type =>
  freezeDeep(decode("Home.Links", LinksBlock, {
    type: "links",
    ...plainOptions("Home.Links", options, new Set(["title", "links"]))
  }))
/**
 * Declares the featured-flows block.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Flows = (options: FlowsOptions = {}): typeof FlowsBlock.Type =>
  freezeDeep(decode("Home.Flows", FlowsBlock, {
    type: "flows",
    ...plainOptions("Home.Flows", options, new Set(["title"]))
  }))
/**
 * Declares the homepage prompt.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Prompt = (options: PromptOptions = {}): typeof PromptBlock.Type =>
  freezeDeep(decode("Home.Prompt", PromptBlock, {
    type: "prompt",
    ...plainOptions("Home.Prompt", options, new Set(["flow", "title", "placeholder"]))
  }))
/**
 * Declares an app: a flow presented as a picture tile on the home.
 *
 * @category constructors
 * @since 1.0.0
 */
export const App = (options: AppOptions): typeof AppBlock.Type =>
  freezeDeep(decode("Home.App", AppBlock, {
    type: "app",
    ...plainOptions("Home.App", options, new Set(["flow", "title", "picture"]))
  }))
/**
 * Declares a markdown file inside this repository.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Markdown = (options: MarkdownOptions): typeof MarkdownBlock.Type =>
  freezeDeep(decode("Home.Markdown", MarkdownBlock, {
    type: "markdown",
    ...plainOptions("Home.Markdown", options, new Set(["path", "title"]))
  }))
/**
 * Declares the repository's live mythical stack.
 *
 * @category constructors
 * @since 1.0.0
 */
export const Stack = (options: StackOptions = {}): typeof StackBlock.Type =>
  freezeDeep(decode("Home.Stack", StackBlock, {
    type: "stack",
    ...plainOptions("Home.Stack", options, new Set(["title"]))
  }))
/**
 * Draws a repository flow's declared view in this place.
 *
 * @category constructors
 * @since 1.0.0
 */
export const View = (options: ViewOptions): typeof ViewBlock.Type =>
  freezeDeep(decode("Home.View", ViewBlock, {
    type: "view",
    ...plainOptions("Home.View", options, new Set(["flow"]))
  }))
/**
 * Declares the repository's homepage from declared blocks.
 *
 * Every block has to be a value one of the block constructors returned, or
 * an equal plain value; a string, an element, or any other shape is refused
 * with the block index in the message.
 *
 * @example
 * ```ts
 * import { Smithers } from "@smthrs/targets"
 *
 * export const home = Smithers.Factory.Home({
 *   blocks: [
 *     Smithers.Home.Text({ text: "Smithers builds itself with Smithers." }),
 *     Smithers.Home.Flows({ title: "Try first" }),
 *     Smithers.Home.Markdown({ path: "README.md" })
 *   ]
 * })
 * ```
 *
 * @category constructors
 * @since 1.0.0
 */
export const Home = (options: HomeOptions): Declaration => {
  const plain = plainOptions("Factory.Home", options, new Set(["blocks"]))
  const blocks = plain["blocks"]
  if (!Array.isArray(blocks)) $raise(new TypeError("Factory.Home blocks must be an array of declared blocks"))
  blocks.forEach((block, index) => {
    if (typeof block !== "object" || block === null) {
      $raise(new TypeError(
        `Factory.Home block ${index} must be a declared block (Smithers.Home.Text, Links, Flows, Prompt, Markdown, Stack, App, View), not ${
          typeof block === "string" ? "a string" : typeof block
        }`
      ))
    }
  })
  return freezeDeep(decode("Factory.Home", Declaration, { _tag: "HomeDeclaration", blocks }))
}
/**
 * Renders the projected document: two-space indentation and a trailing
 * newline, so the checked-in file diffs like a hand-written one.
 *
 * @category rendering
 * @since 1.0.0
 */
export const render = (declaration: Declaration): string =>
  `${JSON.stringify(Schema.encodeSync(Document)({ blocks: declaration.blocks }), null, 2)}\n`
/**
 * Reads a rendered document back, or reports why the text is not one.
 *
 * @category parsing
 * @since 1.0.0
 */
export const parse = (text: string): Document | string => {
  let value: unknown
  try {
    value = JSON.parse(text)
  } catch (cause) {
    return `the homepage is not JSON: ${cause instanceof Error ? cause.message : String(cause)}`
  }
  const result = Schema.decodeUnknownResult(Document)(value)
  return Result.isFailure(result)
    ? `the homepage does not have the .smithers/home.json shape: ${formatIssue(result.failure.issue)}`
    : result.success
}

module $throw$ts {
export function raise(value: unknown): never { throw value }
}
import { raise as $raise } from $throw$ts
