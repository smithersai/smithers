/**
 * Persist the outcome of a rejected signal.
 *
 * @since 1.0.0
 */

import * as Dialect from "@smthrs/database/Dialect"
import * as Effect from "effect/Effect"
import * as SqlClient from "effect/sql/SqlClient"

/** Adds the rejection outcome, preserving legacy no-match rejections.
 * @category migrations
 * @since 1.0.0
 */
export const signalRejection = effect {
  const sql = try SqlClient.SqlClient
  try sql.withTransaction(effect {
    const columns = try Dialect.columns(sql, "control_signal_commands")
    if (columns.some((column) => column.name === "rejection")) return
    try sql`ALTER TABLE control_signal_commands ADD COLUMN rejection TEXT CHECK (rejection IS NULL OR rejection = 'unauthorized')`
  })
}
