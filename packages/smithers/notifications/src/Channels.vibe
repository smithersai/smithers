/**
 * Delivery channels: one short message sent to people outside the app, by
 * email or Telegram.
 *
 * A deployment configures a provider per channel and hands {@link layer} the
 * credentials; a caller hands {@link ChannelsService.send} a {@link Destination}
 * and a {@link Message}. Each send is one HTTP request, so a caller that wants
 * it durable runs it as a flow step and lets the engine retry it: every failure
 * is classified once, here, as a {@link DeliveryFailed} another attempt may
 * clear (with the provider's `Retry-After` as `retryAfterMillis`, which the
 * flow engine honors) or a {@link DeliveryRefused} it never will.
 *
 * ## Providers
 *
 * - Email goes through Resend's `POST /emails`, with the message's id as its
 *   `Idempotency-Key`, so a retried send within Resend's 24-hour window sends
 *   one email.
 * - Telegram goes through the Bot API's `sendMessage`, as plain text with link
 *   previews off. The Bot API has no idempotency key: a process that dies
 *   between Telegram's answer and the caller's record of it sends twice. Put
 *   the send in its own `irreversible` step: with an `idempotencyKey` it is at
 *   least once, without one at most once.
 *
 * ## Credentials
 *
 * The email API key travels in the `Authorization` header and the bot token in
 * the request's path. Neither reaches an error, a span or a log: failures carry
 * the channel, a code, the HTTP status and the provider's short error name, the
 * HTTP client's own span is off for these requests, and the send's span
 * records only the channel, the status and the outcome. Redirects are never
 * followed, so a credential never reaches an origin the deployment didn't name.
 *
 * @since 1.0.0
 */

/**
 * The channels a message can go out on.
 *
 * @category models
 * @since 1.0.0
 */
export const Channel = Schema.Literals(["email", "telegram"])

/**
 * A channel a message can go out on.
 *
 * @category models
 * @since 1.0.0
 */
export type Channel = typeof Channel.Type

/**
 * The most email recipients one message may name: Resend's own limit.
 *
 * @category constants
 * @since 1.0.0
 */
export const maxEmailRecipients = 50

const EMAIL = /^[^\s@<>(),;:"[\]\\]+@[^\s@<>(),;:"[\]\\]+\.[^\s@<>(),;:"[\]\\]+$/u

// A numeric chat id (a person's, a group's, or a supergroup's `-100…`), or a public channel's `@username`.
const CHAT = /^(?:-?[1-9]\d{0,19}|@[A-Za-z]\w{4,31})$/u

/**
 * Whether `value` is an email address this module sends to: one `@`, a dot in
 * the domain, no spaces, brackets or separators, at most 254 characters.
 *
 * @category refinements
 * @since 1.0.0
 */
export const isEmailAddress = (value: string): boolean => value.length <= 254 && EMAIL.test(value)

/**
 * Whether `value` is a Telegram chat id: a number such as `123456789` or
 * `-1001234567890`, or a public channel's `@username`.
 *
 * @category refinements
 * @since 1.0.0
 */
export const isTelegramChatId = (value: string): boolean => CHAT.test(value)

/**
 * An email address, as {@link isEmailAddress} reads it.
 *
 * @category models
 * @since 1.0.0
 */
export const EmailAddress = Schema.String.check(
  Schema.makeFilter(isEmailAddress, { expected: "an email address" })
)

/**
 * A Telegram chat id, as {@link isTelegramChatId} reads it.
 *
 * @category models
 * @since 1.0.0
 */
export const TelegramChatId = Schema.String.check(
  Schema.makeFilter(isTelegramChatId, { expected: "a Telegram chat id" })
)

/**
 * Where a message goes: 1 to {@link maxEmailRecipients} email addresses, or
 * one Telegram chat.
 *
 * @category models
 * @since 1.0.0
 */
export const Destination = Schema.Union([
  Schema.TaggedStruct("email", {
    to: Schema.NonEmptyArray(EmailAddress).check(Schema.isMaxLength(maxEmailRecipients))
  }),
  Schema.TaggedStruct("telegram", { chatId: TelegramChatId })
])

/**
 * Where a message goes.
 *
 * @category models
 * @since 1.0.0
 */
export type Destination = typeof Destination.Type

/**
 * One message: `id`, its idempotency key, the same on every attempt to send
 * it (1 to 256 printable ASCII characters); a subject line of up to 200
 * characters; and plain text of up to 3,500, so a Telegram message carrying
 * both stays under the Bot API's 4,096.
 *
 * @category models
 * @since 1.0.0
 */
export const Message = Schema.Struct({
  id: Schema.String.check(Schema.isPattern(/^[!-~]{1,256}$/u)),
  subject: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  text: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(3_500))
})

/**
 * One message.
 *
 * @category models
 * @since 1.0.0
 */
export type Message = typeof Message.Type

/**
 * A provider took the message: the channel, and the provider's id for it,
 * `null` when its answer named none.
 *
 * @category models
 * @since 1.0.0
 */
export const Receipt = Schema.Struct({ channel: Channel, providerId: Schema.NullOr(Schema.String) })

/**
 * A provider took the message.
 *
 * @category models
 * @since 1.0.0
 */
export type Receipt = typeof Receipt.Type

/**
 * Why a send failed in a way another attempt may clear: the provider couldn't
 * be reached, didn't answer in time, answered 5xx, 408 or 409, or rate limited
 * it (429).
 *
 * @category models
 * @since 1.0.0
 */
export const FailedCode = Schema.Literals(["unreachable", "timeout", "unavailable", "rate_limited"])

/**
 * Why a send failed in a way another attempt may clear.
 *
 * @category models
 * @since 1.0.0
 */
export type FailedCode = typeof FailedCode.Type

/**
 * Why a send was refused for good: the provider rejected the message or its
 * destination (a 3xx or another 4xx), the credential (401 or 403), or the
 * deployment has no provider for the channel.
 *
 * @category models
 * @since 1.0.0
 */
export const RefusedCode = Schema.Literals(["rejected", "unauthorized", "unconfigured"])

/**
 * Why a send was refused for good.
 *
 * @category models
 * @since 1.0.0
 */
export type RefusedCode = typeof RefusedCode.Type

const statusField = Schema.optional(Schema.Int)

// Only known diagnostics are retained; provider text may echo secrets or content.
const reasonField = Schema.optional(Schema.String.check(Schema.isMaxLength(120)))

/**
 * A send failed, and another attempt may clear it. A durable step lets the
 * engine retry it; `retryAfterMillis` is the provider's own wait, when it named
 * one, which the flow engine uses in place of its backoff. It holds no request,
 * url, header or destination.
 *
 * @category errors
 * @since 1.0.0
 */
export class DeliveryFailed extends Schema.TaggedError<DeliveryFailed>()("@smthrs/notifications/DeliveryFailed", {
  channel: Channel,
  code: FailedCode,
  status: statusField,
  reason: reasonField,
  retryAfterMillis: Schema.optional(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)))
}) {}

/**
 * A send was refused, and another attempt would be refused too: record it
 * and stop. It holds no request, url, header or destination.
 *
 * @category errors
 * @since 1.0.0
 */
export class DeliveryRefused extends Schema.TaggedError<DeliveryRefused>()("@smthrs/notifications/DeliveryRefused", {
  channel: Channel,
  code: RefusedCode,
  status: statusField,
  reason: reasonField
}) {}

/**
 * Either failure of a send, as a schema a flow step declares.
 *
 * @category errors
 * @since 1.0.0
 */
export const DeliveryError = Schema.Union([DeliveryFailed, DeliveryRefused])

/**
 * Either failure of a send.
 *
 * @category errors
 * @since 1.0.0
 */
export type DeliveryError = DeliveryFailed | DeliveryRefused

/**
 * The deployment's delivery channels.
 *
 * @category services
 * @since 1.0.0
 */
export interface ChannelsService {
  /** The channels this deployment has a provider for, in {@link Channel}'s order. */
  readonly available: ReadonlyArray<Channel>
  /**
   * Sends `message` to `destination` with one request to its channel's
   * provider. A destination or message outside its schema is refused
   * `rejected`, and a channel with no provider `unconfigured`, before any
   * request.
   */
  readonly send: (destination: Destination, message: Message) => Receipt!DeliveryError
}

/**
 * The {@link ChannelsService} tag.
 *
 * @category services
 * @since 1.0.0
 */
export service Channels: ChannelsService { static readonly key = "@smthrs/notifications/Channels";}

/**
 * Resend's API origin.
 *
 * @category constants
 * @since 1.0.0
 */
export const defaultEmailUrl = "https://api.resend.com"

/**
 * The Telegram Bot API's origin.
 *
 * @category constants
 * @since 1.0.0
 */
export const defaultTelegramUrl = "https://api.telegram.org"

/**
 * How long a send waits for its provider's whole answer.
 *
 * @category constants
 * @since 1.0.0
 */
export const defaultTimeout: Duration.Duration = Duration.seconds(10)

/**
 * The email provider: a Resend API key, the sender (`Name <address>` or an
 * address on a domain Resend verified), and Resend's origin
 * ({@link defaultEmailUrl} when absent).
 *
 * @category models
 * @since 1.0.0
 */
export interface EmailProvider {
  readonly apiKey: Redacted.Redacted<string>
  readonly from: string
  readonly url?: string | undefined
}

/**
 * The Telegram provider: a bot's token from BotFather, and the Bot API's
 * origin ({@link defaultTelegramUrl} when absent).
 *
 * @category models
 * @since 1.0.0
 */
export interface TelegramProvider {
  readonly token: Redacted.Redacted<string>
  readonly url?: string | undefined
}

/**
 * The providers a deployment configured, and how long each send waits.
 *
 * @category models
 * @since 1.0.0
 */
export interface Options {
  readonly email?: EmailProvider | undefined
  readonly telegram?: TelegramProvider | undefined
  readonly timeout?: Duration.Duration | undefined
}

/** An origin a provider is reached at: absolute `http:` or `https:`, without a trailing slash. */
const originOf = (raw: string, channel: Channel): string => {
  let parsed: URL | undefined
  try {
    parsed = new URL(raw)
  } catch {
    parsed = undefined
  }
  if (parsed === undefined || (parsed.protocol !== "http:" && parsed.protocol !== "https:")) {
    // The message names no url: a misconfigured one may hold a credential.
    $raise(new Error(`The ${channel} provider's url must be an absolute http: or https: URL`))
  }
  return raw.replace(/\/+$/u, "")
}

/** One provider's request for a message to `D`, and how to read its answer. */
interface Provider<D extends Destination = Destination> {
  readonly request: (destination: D, message: Message) => HttpClientRequest.HttpClientRequest
  readonly providerId: (body: unknown) => string | null
  readonly reason: (body: unknown) => string | undefined
  readonly retryAfterSeconds: (body: unknown) => unknown
}

const record = (value: unknown): Readonly<Record<string, unknown>> =>
  typeof value === "object" && value !== null ? value as Readonly<Record<string, unknown>> : {}

const safeReason = (value: unknown, allowed: ReadonlyArray<string>): string | undefined =>
  typeof value !== "string" || value.length === 0
    ? undefined
    : allowed.includes(value)
    ? value
    : "provider_rejected"

type EmailDestination = Extract<Destination, { readonly _tag: "email" }>
type TelegramDestination = Extract<Destination, { readonly _tag: "telegram" }>

const resend = (provider: EmailProvider): Provider<EmailDestination> => {
  const origin = originOf(provider.url ?? defaultEmailUrl, "email")
  return {
    request: (destination, message) =>
      HttpClientRequest.post(`${origin}/emails`).pipe(
        HttpClientRequest.bearerToken(Redacted.value(provider.apiKey)),
        HttpClientRequest.setHeader("Idempotency-Key", message.id),
        HttpClientRequest.bodyJsonUnsafe({
          from: provider.from,
          to: destination.to,
          subject: message.subject,
          text: message.text
        })
      ),
    providerId: (body) => {
      const id = record(body).id
      return typeof id === "string" && id.length > 0 && id.length <= 128 ? id : null
    },
    reason: (body) =>
      safeReason(record(body).name, ["validation_error", "rate_limit_exceeded", "daily_quota_exceeded"]),
    retryAfterSeconds: () => undefined
  }
}

const telegram = (provider: TelegramProvider): Provider<TelegramDestination> => {
  const origin = originOf(provider.url ?? defaultTelegramUrl, "telegram")
  return {
    request: (destination, message) =>
      HttpClientRequest.post(`${origin}/bot${Redacted.value(provider.token)}/sendMessage`).pipe(
        HttpClientRequest.bodyJsonUnsafe({
          chat_id: destination.chatId,
          text: `${message.subject}\n\n${message.text}`,
          link_preview_options: { is_disabled: true }
        })
      ),
    providerId: (body) => {
      if (record(body).ok !== true) return null
      const id = record(record(body).result).message_id
      return typeof id === "number" && Number.isSafeInteger(id) ? String(id) : null
    },
    reason: (body) => safeReason(record(body).description, ["Bad Request: chat not found"]),
    retryAfterSeconds: (body) => record(record(body).parameters).retry_after
  }
}

/** A wait in whole seconds, as a header or a body says it, in milliseconds; anything else is no wait. */
const millisOf = (seconds: unknown): number | undefined => {
  const value = typeof seconds === "string" && /^\d{1,9}$/u.test(seconds.trim())
    ? Number(seconds.trim())
    : seconds
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 ? value * 1_000 : undefined
}

/** What one answer means: delivered (2xx), worth another attempt, or refused for good. */
const classify = (
  channel: Channel,
  status: number,
  body: unknown,
  retryAfter: string | undefined,
  provider: Provider<never>
): Receipt!DeliveryError => {
  if (status >= 200 && status < 300) {
    const providerId = provider.providerId(body)
    return providerId === null
      ? Effect.fail(new DeliveryFailed({ channel, status, code: "unavailable", reason: "invalid_response" }))
      : Effect.succeed({ channel, providerId })
  }
  const reason = provider.reason(body)
  const detail = { channel, status, ...(reason === undefined ? {} : { reason }) }
  if (status === 429) {
    const wait = millisOf(retryAfter) ?? millisOf(provider.retryAfterSeconds(body))
    return Effect.fail(
      new DeliveryFailed({ ...detail, code: "rate_limited", ...(wait === undefined ? {} : { retryAfterMillis: wait }) })
    )
  }
  if (status >= 500 || status === 408 || status === 409) {
    return Effect.fail(new DeliveryFailed({ ...detail, code: "unavailable" }))
  }
  return Effect.fail(
    new DeliveryRefused({ ...detail, code: status === 401 || status === 403 ? "unauthorized" : "rejected" })
  )
}

/**
 * Runs a request with the Fetch transport's redirect following off, keeping every other default the host set: a 3xx
 * reaches {@link classify}, which refuses it, instead of a re-send of the credential to the origin it names.
 */
const withoutRedirects = <A, E, R>(effect: A!E!R): A!E!R =>
  Effect.flatMap(
    Effect.serviceOption(FetchHttpClient.RequestInit),
    (init) =>
      Effect.provideService(effect, FetchHttpClient.RequestInit, {
        ...(Option.isSome(init) ? init.value : {}),
        redirect: "manual"
      })
  )

const decodeDestination = Schema.decodeUnknownOption(Destination)
const decodeMessage = Schema.decodeUnknownOption(Message)

/**
 * The deployment's channels: email through Resend when `email` is given,
 * Telegram through the Bot API when `telegram` is, each send bounded by
 * `timeout` ({@link defaultTimeout}).
 *
 * The layer owns its Fetch transport and makes every request with redirect
 * following off, so a 3xx is refused `rejected` rather than followed with the
 * credential. Tests and hosts supply the transport as `FetchHttpClient.Fetch`.
 * A provider url that isn't absolute `http:` or `https:` fails the layer as a
 * defect whose message names no url.
 *
 * Each send is a span `notifications.channel.send` with the channel, the
 * answering status and the outcome, and nothing of the request: the HTTP
 * client's own span is off for it, and no trace context is sent to the
 * provider.
 *
 * @category layers
 * @since 1.0.0
 */
export const layer = (options: Options): Layer.Layer<Channels> =>
  Layer.effect(
    Channels,
    effect {
      const providers = try (Effect.try({
        try: () => ({
          email: options.email === undefined ? undefined : resend(options.email),
          telegram: options.telegram === undefined ? undefined : telegram(options.telegram)
        }),
        catch: (error) => error
      }) |> Effect.orDie(%))
      const client = HttpClient.withScope(try HttpClient.HttpClient)
      const timeout = options.timeout ?? defaultTimeout
      const available = Channel.literals.filter((channel) => providers[channel] !== undefined)

      /** The request `destination`'s provider makes for `message`, or none when the channel has no provider. */
      const requestFor = (destination: Destination, message: Message) => {
        if (destination._tag === "email") {
          return providers.email === undefined
            ? undefined
            : { provider: providers.email, request: providers.email.request(destination, message) }
        }
        return providers.telegram === undefined
          ? undefined
          : { provider: providers.telegram, request: providers.telegram.request(destination, message) }
      }

      const execute = (channel: Channel, provider: Provider<never>, request: HttpClientRequest.HttpClientRequest) =>
        client.execute(request)
        |> Effect.mapError(%, () => new DeliveryFailed({ channel, code: "unreachable" }))
        |> Effect.flatMap(%, (response) =>
          response.json
          |> Effect.orElseSucceed(%, (): unknown => undefined)
          |> Effect.flatMap(%, (body) => {
            const retryAfter = response.headers["retry-after"]
            return Effect.annotateCurrentSpan({ "http.response.status_code": response.status })
              |> Effect.andThen(%, classify(channel, response.status, body, retryAfter, provider))
          }))
        |> Effect.provideService(%, HttpClient.TracerDisabledWhen, () => true)
        |> Effect.provideService(%, HttpClient.TracerPropagationEnabled, false)
        |> withoutRedirects(%)
        |> Effect.timeoutOrElse(%, {
          duration: timeout,
          orElse: () => Effect.fail(new DeliveryFailed({ channel, code: "timeout" }))
        })
        |> Effect.scoped(%)

      const send = (destination: Destination, message: Message): Receipt!DeliveryError =>
        Effect.suspend(() => {
          const channel = destination._tag
          const decoded = Option.all([decodeDestination(destination), decodeMessage(message)])
          if (Option.isNone(decoded)) {
            return Effect.fail(new DeliveryRefused({ channel, code: "rejected", reason: "invalid_message" }))
          }
          const built = requestFor(...decoded.value)
          if (built === undefined) return Effect.fail(new DeliveryRefused({ channel, code: "unconfigured" }))
          return execute(channel, built.provider, built.request)
        })
        |> Effect.tap(%, () => Effect.annotateCurrentSpan({ "smithers.channel.outcome": "sent" }))
        |> Effect.tapError(%, (error) =>
          Effect.annotateCurrentSpan({
            "smithers.channel.outcome": error._tag === "@smthrs/notifications/DeliveryFailed" ? "failed" : "refused",
            "smithers.channel.code": error.code
          }))
        |> Effect.withSpan(%, "notifications.channel.send", {
          kind: "client",
          attributes: { "smithers.channel": destination._tag }
        })

      return Channels.of({ available, send })
    }
  ).pipe(Layer.provide(FetchHttpClient.layer))

module $throw$ts {
export function raise(value: unknown): never { throw value }
}
import { raise as $raise } from $throw$ts
