import { describe, expect, it } from "@effect/vitest"
import { collect, contextOf, keyed, sessionMeta } from "../../../../examples/use-cases/extract-intent/src/collect.vibe"
import { assistantLine, claudeLine, codexLine, live, sessionMetaLine, tree, userItemLine, userMessageLine } from "./fixtures.vibe"

const rollout = (time: string, id: string) => `sessions/2026/01/01/rollout-${time}-${id}.jsonl`
const tuiSession = "11111111-1111-4111-8111-111111111111"
const execSession = "22222222-2222-4222-8222-222222222222"
const appSession = "33333333-3333-4333-8333-333333333333"

describe("collect", () => {
  it.effect("reads Claude Code history with inline and cached pastes, once per prompt across config dirs", () => live(effect {
    const first = try tree({
      "history.jsonl": [
        claudeLine("Ship the docs site before the language release.", 1000, "/work/site", "s-claude-1"),
        claudeLine("[Pasted text #1 +3 lines] keep this spec", 2000, "/work/site", "s-claude-1", { "1": { id: 1, type: "text", content: "an inline paste" } }),
        claudeLine("[Pasted text #1] and this one", 3000, "/work/lang", "s-claude-2", { "1": { id: 1, type: "text", contentHash: "abc123" } }),
        "not json",
      ].join("\n"),
      "paste-cache/abc123.txt": "a cached paste",
    })
    const second = try tree({ "history.jsonl": claudeLine("Ship the docs site before the language release.", 1000, "/work/site", "s-claude-1") })
    const prompts = try collect({ claude: [first, second, "/no/such/dir"], codex: [] })
    try Effect.try(() => {
      expect(prompts.map((prompt) => [prompt.key, prompt.tool, prompt.ts, prompt.folder, prompt.pastes])).toEqual([
        ["c-1000-s-claude", "claude", 1000, "/work/site", []],
        ["c-2000-s-claude", "claude", 2000, "/work/site", ["an inline paste"]],
        ["c-3000-s-claude", "claude", 3000, "/work/lang", ["a cached paste"]],
      ])
    })
  }))

  it.effect("reads Codex history, takes each session's folder from its rollout, and skips exec and subagent sessions", () => live(effect {
    const home = try tree({
      "history.jsonl": [codexLine("A typed Codex prompt that names a durable rule.", 5, tuiSession), codexLine("A prompt whose rollout is gone.", 9, "44444444-4444-4444-8444-444444444444")].join("\n"),
      [rollout("2026-01-01T00-00-00", tuiSession)]: [sessionMetaLine(tuiSession, "/work/codex-app", "cli"), userItemLine("2026-01-01T00:00:05.000Z", "A typed Codex prompt that names a durable rule.")].join("\n"),
      [rollout("2026-01-01T00-01-00", execSession)]: [sessionMetaLine(execSession, "/work/lane", "exec", "codex_exec"), userItemLine("2026-01-01T00:01:00.000Z", "An agent's brief, not a person's prompt.")].join("\n"),
      [rollout("2026-01-01T00-02-00", appSession)]: [sessionMetaLine(appSession, "/work/older", "vscode"), userMessageLine("2026-01-01T00:02:00.000Z", "An older Codex prompt that never reached history.jsonl.")].join("\n"),
      "auth.json": "never read",
    })
    const prompts = try collect({ claude: [], codex: [home] })
    try Effect.try(() => {
      expect(prompts.map((prompt) => [prompt.tool, prompt.ts, prompt.folder, prompt.text])).toEqual([
        ["codex", 5000, "/work/codex-app", "A typed Codex prompt that names a durable rule."],
        ["codex", 9000, "?", "A prompt whose rollout is gone."],
        ["codex", Date.parse("2026-01-01T00:02:00.000Z"), "/work/older", "An older Codex prompt that never reached history.jsonl."],
      ])
    })
  }))

  it("keys prompts by tool, time and session, numbering ties", () => {
    const row = { tool: "codex" as const, ts: 7000, folder: "?", session: "abcdef0123", account: "a", pastes: [] }
    expect(keyed([{ ...row, text: "b" }, { ...row, text: "a" }]).map((prompt) => [prompt.key, prompt.text])).toEqual([["x-7000-abcdef01", "a"], ["x-7000-abcdef01-2", "b"]])
  })

  it("reads a rollout's session_meta", () => {
    expect(sessionMeta(sessionMetaLine(tuiSession, "/w", "cli"))).toEqual({ session: tuiSession, folder: "/w", interactive: true })
    expect(sessionMeta(sessionMetaLine(execSession, "/w", { subagent: {} }, "Codex Desktop"))?.interactive).toBe(false)
    expect(sessionMeta("{}")).toBeUndefined()
  })

  it.effect("finds what the assistant said just before a prompt, in Claude and Codex transcripts", () => live(effect {
    const claude = try tree({
      "history.jsonl": claudeLine("[Pasted text #1] yes, do option 2 and keep the old flag working", 1000, "/work/x", "s-claude-9"),
      "projects/-work-x/s-claude-9.jsonl": [
        JSON.stringify({ type: "assistant", message: { content: [{ type: "text", text: "Option 1 renames the flag. Option 2 keeps it." }] } }),
        JSON.stringify({ type: "user", isSidechain: true, message: { content: "yes, do option 2 and keep the old flag working" } }),
        JSON.stringify({ type: "user", message: { content: [{ type: "text", text: "[Pasted text #1] yes, do option 2 and keep the old flag working" }] } }),
      ].join("\n"),
    })
    const codex = try tree({
      "history.jsonl": codexLine("ok make that the default for every project", 5, tuiSession),
      [rollout("2026-01-01T00-00-00", tuiSession)]: [sessionMetaLine(tuiSession, "/work/y", "cli"), assistantLine("2026-01-01T00:00:01.000Z", "Should strict mode be the default?"), userItemLine("2026-01-01T00:00:05.000Z", "ok make that the default for every project")].join("\n"),
    })
    const roots = { claude: [claude], codex: [codex] }
    const prompts = try collect(roots)
    const context = try contextOf(roots, prompts)
    try Effect.try(() => expect([...context.values()]).toEqual(["Option 1 renames the flag. Option 2 keeps it.", "Should strict mode be the default?"]))
  }))
})
