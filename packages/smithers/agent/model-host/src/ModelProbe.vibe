/**
 * POST /api/model/test on the local host: ONE real request against a
 * configured model, on the real @smthrs/model stack. Generation goes through
 * the record's Route over a RequestExecutor built with no retries; a decision
 * model answers its questions through the real Evaluator and the answers are
 * decoded by the real Classifier. The request is the fixed Test unless the
 * caller composed one (the model-call card). One deadline covers the whole
 * call and is echoed in the timeout it produces.
 *
 * `test` is an Effect that never fails and never returns provider text, except
 * the generated words with the credential cut out of them.
 *
 * @since 1.0.0-rc.0
 */

import type { ModelStep } from "@smthrs/agent"
import { digestSync } from "@smthrs/crypto"
import { Action } from "@smthrs/flow"
import type { HttpClient as KernelHttpClient } from "@smthrs/kernel"
import { Classifier, Evaluator, ModelRequest } from "@smthrs/model"
import { ConfiguredModel } from "@smthrs/rpc"
import { Effect, Exit, Redacted, Schema, Stream } from "effect"

import { toEvaluatorLayer, toModel, type ToModelOptions } from "./ConfiguredModelRoute.vibe"
import { durableModelStream } from "./DurableModelCall.vibe"
import { localModelCatalog, modelFailureOf, planOnLocal } from "./LocalModel.vibe"
import type { LocalPlanned, ModelCredentials } from "./LocalModel.vibe"
import { nowMs } from "./ModelProbe.platform.ts"
import { providerTransport } from "./ProviderTransport.ts"

/**
 * How a probe reads credentials, reaches providers and bounds a call.
 *
 * @category models
 * @since 1.0.0-rc.0
 */
export interface ModelProbeOptions {
  readonly credentials?: ModelCredentials
  /** The record credentials are read from. The host passes the one it was started with. */
  readonly env: ConfiguredModel.ModelCredentialEnv
  /** False on the offline host, which may reach loopback only. */
  readonly egress: boolean
  /** The one deadline a test runs under. Defaults to MODEL_TEST_DEADLINE_MS. */
  readonly deadlineMs?: number
  /** Test override for the transport. */
  readonly fetch?: typeof globalThis.fetch
}

/**
 * The catalog this host reports and the one-call Test it runs.
 *
 * @category models
 * @since 1.0.0-rc.0
 */
export interface ModelProbe {
  readonly catalog: () => ConfiguredModel.ModelCatalog
  /** One call. With no input, the fixed Test of the model's kind. It never fails; a refusal is its result. */
  readonly test: (
    model: ConfiguredModel.ConfiguredModel,
    input?: ConfiguredModel.ModelCallInput
  ) => Effect.Effect<ConfiguredModel.ModelTestResult, never, ModelStep.Requirements>
}

type Outcome = { readonly output: ConfiguredModel.ModelCallOutput } | {
  readonly failure: ConfiguredModel.ModelTestFailure
}

const invalidProtocol: Outcome = { failure: { code: "invalid", field: "protocol" } }

const decodeQuestion = Schema.decodeUnknownEffect(Evaluator.Question)

/**
 * The classifier's answers in the contract's shape: the classifier reads the
 * type off the question, the wire states it on the answer.
 *
 * @category decoding
 * @since 1.0.0-rc.0
 */
export const modelAnswersOf = (
  questions: Readonly<Record<string, Evaluator.Question>>,
  answers: Readonly<Record<string, Classifier.Answer>>
): Record<string, ConfiguredModel.ModelAnswer> =>
  Object.fromEntries(
    Object.entries(answers).map(([id, answer]) => {
      const type = questions[id]?.type
      return [
        id,
        type === "boolean" && "probability" in answer ?
          { type, value: answer.value, probability: answer.probability }
          : type === "choice" && "confidence" in answer && typeof answer.value === "string"
          ? { type, value: answer.value, probabilities: answer.probabilities, confidence: answer.confidence }
          : type === "score" && "label" in answer
          ? {
            type,
            value: answer.value,
            label: answer.label,
            probabilities: answer.probabilities,
            confidence: answer.confidence
          }
          : answer as never
      ] as const
    })
  )

const generation = (
  planned: Extract<LocalPlanned, { ok: true }>,
  input: Extract<ConfiguredModel.ModelCallInput, { kind: "generation" }>,
  transport: Pick<ToModelOptions, "fetch" | "onRedirect">,
  bounded = true
): Effect.Effect<Outcome, unknown, ModelStep.Requirements> =>
  effect {
    const source = try toModel(planned.plan, planned.apiKey, { ...transport, execution: { maxRetries: 0 } })
    const request = try sync(() =>
      ModelRequest.ModelRequest.make({
        modelId: planned.plan.modelId,
        system: input.system.trim() === "" ? [] : [ModelRequest.SystemPart.make({ text: input.system })],
        messages: [{ role: "user", content: [{ type: "text", text: input.prompt }] }],
        tools: [],
        params: {
          ...(bounded ? { maxTokens: input.maxTokens } : {}),
          ...(input.temperature === undefined ? {} : { temperature: input.temperature })
        }
      })
    )
    const events = Array.from(
      try Stream.runCollect(
        durableModelStream(
          "model-host/probe/generation",
          { ...source, modelId: planned.plan.modelId, credential: Redacted.value(planned.apiKey) },
          request
        )
      )
    )
    // The durable boundary requires settlement, even for an answer with no text.
    const text = events.flatMap((event) => event.type === "text-delta" ? [event.text] : []).join("")
    const output: ConfiguredModel.ModelCallOutput = {
      kind: "generation",
      text: (try sync(() => ConfiguredModel.cutModelCredential(text, Redacted.value(planned.apiKey)))).slice(
        0,
        ConfiguredModel.MODEL_CALL_TEXT_MAX
      )
    }
    return { output }
  }

const decision = (
  planned: Extract<LocalPlanned, { ok: true }>,
  deadlineMs: number,
  input: Extract<ConfiguredModel.ModelCallInput, { kind: "decision" }>
): Effect.Effect<Outcome, unknown, KernelHttpClient.HttpClient> =>
  effect {
    // The questions become the classes every host builds, so their construction limits hold here too.
    const questions = Object.fromEntries(
      try Effect.forEach(Object.entries(input.questions), ([id, question]) =>
        Effect.map(decodeQuestion(question), (typed) => [id, typed] as const))
    )
    const evaluator = try Evaluator.Evaluator
    const state = try sync(() => ConfiguredModel.modelStateOf(input.state))
    const answer = try evaluator.evaluate({ state, questions })
    const decoded = try Effect.result(Classifier.decodeAnswers(questions, answer.answers))
    if (decoded._tag !== "Success") {
      return invalidProtocol
    }
    const output: ConfiguredModel.ModelCallOutput = {
      kind: "decision",
      answers: modelAnswersOf(questions, decoded.success)
    }
    return { output }
  }.pipe(Effect.provide(toEvaluatorLayer(planned.plan, planned.apiKey, deadlineMs)))

/**
 * POST /api/model/test on this host: one bounded call whose Effect never fails.
 * It runs in the caller's fiber, so the caller's services, tracer and logger
 * reach the provider call.
 *
 * @category constructors
 * @since 1.0.0-rc.0
 */
export const createModelProbe = (options: ModelProbeOptions): ModelProbe => {
  const deadlineMs = options.deadlineMs ?? ConfiguredModel.MODEL_TEST_DEADLINE_MS
  /** One rule for what is listed and what is tested, so the catalog offers no row a Test would refuse to dial. */
  const planOptions: ConfiguredModel.ModelPlanOptions = options.egress ? {} : { egress: false }

  const test = (
    model: ConfiguredModel.ConfiguredModel,
    input?: ConfiguredModel.ModelCallInput
  ): Effect.Effect<ConfiguredModel.ModelTestResult, never, ModelStep.Requirements> =>
    effect {
      const started = nowMs()
      const failed = (failure: ConfiguredModel.ModelTestFailure): ConfiguredModel.ModelTestResult =>
        ConfiguredModel.failedModelTest(failure, nowMs() - started, "local")
      // A credential store that cannot be read is a dependency failure; its
      // error may quote a secret, so it is dropped like a defect.
      const read = try Effect.exit(
        Effect.suspend(() => options.credentials?.refresh() ?? Effect.void).pipe(
          Effect.flatMap(() =>
            Effect.try(() =>
              planOnLocal(ConfiguredModel.bindingOf(model), options.env, planOptions, options.credentials)
            )
          )
        )
      )
      if (Exit.isFailure(read)) return failed({ code: "unreachable" })
      const planned = read.value
      if (!planned.ok) return failed(planned.failure)
      const request = input ?? try sync(() => ConfiguredModel.modelCallDefault(planned.plan.kind))
      // A prompt for a decision model, or questions for a generation model, fit no wire the record speaks.
      if (request.kind !== planned.plan.kind) return failed({ code: "invalid", field: "protocol" })
      const identity = try Effect.result(
        Effect.try(() => digestSync(JSON.stringify({ plan: planned.plan, request, deadlineMs })))
      )
      if (identity._tag === "Failure") return failed({ code: "unreachable" })
      const probe = effect {
        // A refused redirect fails the call as a transport error; the status it was answered is the result.
        let redirected: number | undefined
        const transport = {
          fetch: options.fetch,
          onRedirect: (status: number) => {
            redirected = status
          }
        }
        const exit = try Effect.exit(
          (request.kind === "decision"
            ? decision(planned, deadlineMs, request).pipe(
              Effect.provide(providerTransport(transport.fetch, transport.onRedirect))
            )
            : generation(
              planned,
              request,
              transport,
              input !== undefined || planned.plan.protocol !== "openai-responses-chatgpt"
            ))
            .pipe(
              Effect.catch((error) => Effect.succeed<Outcome>({ failure: modelFailureOf(error, deadlineMs) })),
              Effect.timeoutOrElse({
                duration: deadlineMs,
                orElse: () => Effect.succeed<Outcome>({ failure: { code: "timeout", deadlineMs } })
              })
            )
        )
        if (redirected !== undefined) return failed({ code: "refused", status: redirected })
        // A defect is a bug in this host, and its cause may hold a signed request: dropped, never logged or returned.
        if (!Exit.isSuccess(exit)) return failed({ code: "unreachable" })
        if ("failure" in exit.value) return failed(exit.value.failure)
        const { output } = exit.value
        const sample = try sync(() => ConfiguredModel.modelCallSample(output, Redacted.value(planned.apiKey)))
        return {
          ok: true,
          latencyMs: Math.max(0, Math.round(nowMs() - started)),
          sample,
          output
        } satisfies ConfiguredModel.ModelTestResult
      }
      // The decision protocol is an Evaluator, not a generation route. Seal
      // the bounded probe result with the SDK action, including safe refusals.
      const encoded = try Action.make({
        name: "model-host/probe",
        tier: "sealed",
        idempotencyKey: identity.success,
        success: Schema.String,
        execute: probe.pipe(Effect.flatMap((result) => sync(() => JSON.stringify(result))))
      })
      return try Effect.orDie(Effect.try(() => ConfiguredModel.ModelTestResultSchema.parse(JSON.parse(encoded))))
    }

  return { catalog: () => localModelCatalog(options.env, planOptions, options.credentials), test }
}
