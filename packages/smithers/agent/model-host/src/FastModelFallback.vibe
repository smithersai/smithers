/**
 * Host-selected fast-model fallbacks over the canonical model stream.
 *
 * @since 1.0.0
 */

import type { ModelStep } from "@smthrs/agent"
import { type Model, ModelError, type ModelEvent, ModelRequest } from "@smthrs/model"
import { Effect, Stream } from "effect"
import type { HostModelRoute } from "./ConfiguredModelRoute.vibe"
import { durableModelStream } from "./DurableModelCall.ts"

/**
 * One host-owned provider and its matching credential-free preparation.
 *
 * @category models
 * @since 1.0.0
 */
export interface ModelSource {
  readonly model: Model.Model
  readonly route: HostModelRoute
  readonly modelId: string
  readonly outputTokenLimitSupported?: boolean
  readonly credential?: string
  readonly additionalCredentials?: ReadonlyArray<string>
}

const notificationTimeouts = Metric.counter("smithers_model_host_fallback_notification_timeouts")

/**
 * Builds one model that streams from the first host-owned source and falls back
 * to the next only when a source fails as unavailable (authentication, rate limit,
 * quota, transport, call timeout or provider fault) before emitting any output.
 * A failure after output became visible, or on the last source, is returned as is.
 * `onFallback` runs with the index of the source about to be tried and is
 * interrupted after one second so a notification cannot block inference. With no
 * sources the stream fails with `no_route`.
 *
 * @since 1.0.0
 * @category constructors
 */
export const fastModelFallback = (
  sources: ReadonlyArray<ModelSource>,
  onFallback?: (index: number) => void!!,
  name = "model-host/fallback"
): {
  readonly stream: (
    request: ModelRequest.ModelRequest
  ) => Stream.Stream<ModelEvent.ModelEvent, Model.ModelFailure, ModelStep.Requirements>
} => ({
  stream: (request) =>
    Stream.suspend(() => {
      if (sources.length === 0) {
        return Stream.fail(new ModelError.ModelError({ code: "no_route", message: "Fast model unavailable" }))
      }
      const attempt = (
        index: number
      ): Stream.Stream<ModelEvent.ModelEvent, Model.ModelFailure, ModelStep.Requirements> => {
        const source = sources[index]!
        let emitted = false
        const { maxTokens: _maxTokens, ...unlimited } = request.params
        return durableModelStream(
          name + "/" + index,
          {
            ...source,
            additionalCredentials: sources.flatMap((
              item
            ) => [item.credential ?? "", ...(item.additionalCredentials ?? [])])
          },
          new ModelRequest.ModelRequest({
            ...request,
            modelId: source.modelId,
            params: source.outputTokenLimitSupported === false ? unlimited : request.params
          }),
          undefined,
          index === 0 ? undefined : () => (
            (onFallback?.(index) ?? Effect.void)
              |> Effect.timeoutOrElse(%, {
                duration: 1000,
                orElse: () =>
                  Effect.andThen(
                    Metric.update(notificationTimeouts, 1),
                    Effect.logWarning("Model fallback notification timed out")
                  )
              })
              |> withSpan(%, "model_host.fallback_notification")
          )
        ).pipe(
          Stream.tap(effect () => {
            emitted = true
          }),
          Stream.catch((error) => {
            const unavailable = error._tag === "flows/model/ModelError" &&
              ["authentication", "rate_limited", "quota_exceeded", "transport", "call_timeout", "provider_internal"]
                .includes(error.code)
            return !emitted && unavailable && index + 1 < sources.length
              ? attempt(index + 1)
              : Stream.fail(error)
          })
        )
      }
      return attempt(0)
    })
})
