/**
 * SDK model steps shared by the host's turns, selectors, probes and fallbacks.
 *
 * @since 1.0.0
 */

import { identity as keepDefect } from "effect/Function"
import { ModelStep } from "@smthrs/agent"
import { digestSync } from "@smthrs/crypto"
import { Action, RetryPolicy } from "@smthrs/flow"
import { CanonicalJson, type Model, ModelError, ModelEvent, type ModelRequest } from "@smthrs/model"
import { Effect, Exit, Queue, Schema, Stream } from "effect"
import type { ModelSource } from "./FastModelFallback.vibe"
import { StreamingCredentialCutter } from "./StreamingCredentialCutter.ts"

const Recorded = Schema.Struct({
  events: Schema.Array(ModelEvent.ModelEvent),
  error: Schema.optional(ModelError.ModelError)
})
const once = RetryPolicy.make({ initialMs: 1, factor: 1, maxMs: 1, maxAttempts: 1 })

/** Cut provider echoes before the SDK journals them, including split chunks. */
const safeModel = (source: ModelSource): Model.Model => ({
  ...source.model,
  stream: (request) =>
    Stream.suspend(() => {
      const cutter = () => new StreamingCredentialCutter(source.credential, source.additionalCredentials)
      const cut = (text: string) => {
        const value = cutter()
        return value.push(text) + value.finish()
      }
      if (
        [source.credential, ...(source.additionalCredentials ?? [])].every((value) =>
          value === undefined || value === ""
        )
      ) {
        let settled = false
        return source.model.stream(request).pipe(
          Stream.tap((event) =>
            Effect.sync(() => {
              if (event.type === "settle") settled = true
            })
          ),
          Stream.concat(Stream.suspend(() =>
            settled ? Stream.empty : Stream.fail(
              new ModelError.ModelError({
                code: "invalid_provider_output",
                message: "model stream ended without settlement"
              })
            )
          ))
        )
      }
      const text = new Map<string, StreamingCredentialCutter>()
      const thinking = new Map<string, StreamingCredentialCutter>()
      const push = (parts: Map<string, StreamingCredentialCutter>, id: string, value: string) => {
        let part = parts.get(id)
        if (part === undefined) {
          part = cutter()
          parts.set(id, part)
        }
        return part.push(value)
      }
      const finish = (
        parts: Map<string, StreamingCredentialCutter>,
        id: string,
        type: "text-delta" | "thinking-delta"
      ): ReadonlyArray<ModelEvent.ModelEvent> => {
        const tail = parts.get(id)?.finish() ?? ""
        parts.delete(id)
        return tail === "" ? [] : [{ type, id, text: tail }]
      }
      let settled = false
      const argumentsById = new Map<string, StreamingCredentialCutter>()
      return source.model.stream(request).pipe(
        Stream.mapEffect((event): Effect.Effect<ReadonlyArray<ModelEvent.ModelEvent>, ModelError.ModelError> => {
          if ("id" in event && cut(event.id) !== event.id) {
            return Effect.fail(
              new ModelError.ModelError({
                code: "invalid_provider_output",
                message: event.type.startsWith("tool-")
                  ? "tool call id contains the credential"
                  : "model event id contains the credential"
              })
            )
          }
          switch (event.type) {
            case "thinking-start":
              return event.signature !== undefined && cut(event.signature) !== event.signature
                ? Effect.fail(
                  new ModelError.ModelError({
                    code: "invalid_provider_output",
                    message: "model signature contains the credential"
                  })
                )
                : Effect.succeed([event])
            case "text-delta":
              return Effect.succeed([{ ...event, text: push(text, event.id, event.text) }])
            case "thinking-delta":
              return Effect.succeed([{ ...event, text: push(thinking, event.id, event.text) }])
            case "text-end":
              return Effect.succeed([...finish(text, event.id, "text-delta"), event])
            case "thinking-end":
              return Effect.succeed([...finish(thinking, event.id, "thinking-delta"), event])
            case "tool-result":
              return Effect.succeed([{ ...event, output: cut(event.output) }])
            case "tool-call-start":
              argumentsById.set(event.id, cutter())
              return Effect.succeed([{ ...event, name: cut(event.name) }])
            case "tool-call-delta": {
              const value = argumentsById.get(event.id)
              return Effect.succeed([{
                ...event,
                arguments: value === undefined ? cut(event.arguments) : value.push(event.arguments)
              }])
            }
            case "tool-call-end": {
              const tail = argumentsById.get(event.id)?.finish() ?? ""
              argumentsById.delete(event.id)
              return Effect.succeed([
                ...(tail === "" || event.arguments !== undefined
                  ? []
                  : [{ type: "tool-call-delta" as const, id: event.id, arguments: tail }]),
                { ...event, ...(event.arguments === undefined ? {} : { arguments: cut(event.arguments) }) }
              ])
            }
            case "retry":
              return Effect.succeed([{ ...event, code: cut(event.code) }])
            case "settle": {
              if (
                [event.responseId, event.sessionId, ...(event.itemIds ?? [])].some((id) =>
                  id !== undefined && cut(id) !== id
                )
              ) {
                return Effect.fail(
                  new ModelError.ModelError({
                    code: "invalid_provider_output",
                    message: "model settlement id contains the credential"
                  })
                )
              }
              settled = true
              return Effect.succeed([
                ...Array.from(thinking.keys()).flatMap((id) => finish(thinking, id, "thinking-delta")),
                ...Array.from(text.keys()).flatMap((id) => finish(text, id, "text-delta")),
                {
                  ...event,
                  ...(event.servedTier === undefined ? {} : { servedTier: cut(event.servedTier) }),
                  ...(event.timing?.failedTries === undefined ? {} : {
                    timing: {
                      ...event.timing,
                      failedTries: event.timing.failedTries.map((attempt) => ({ ...attempt, code: cut(attempt.code) }))
                    }
                  })
                }
              ])
            }
            default:
              return Effect.succeed([event])
          }
        }),
        Stream.flatMap(Stream.fromIterable),
        Stream.concat(Stream.suspend(() =>
          settled ? Stream.empty : Stream.fail(
            new ModelError.ModelError({
              code: "invalid_provider_output",
              message: "model stream ended without settlement"
            })
          )
        )),
        Stream.mapError((error) =>
          error._tag === "flows/model/ModelError"
            ? new ModelError.ModelError({
              code: error.code,
              message: cut(error.message),
              ...(error.httpStatus === undefined ? {} : { httpStatus: error.httpStatus }),
              ...(error.retryAfterMillis === undefined ? {} : { retryAfterMillis: error.retryAfterMillis })
            })
            : error
        )
      )
    })
})

/**
 * A single host attempt. A sealed envelope retains even transient refusals and
 * partial events so fallback selection replays without calling a failed primary
 * again. The SDK owns the provider lifecycle, cancellation, timing and billing.
 * The unbounded queue lets the provider drain while a journal writer is waiting.
 *
 * @category runners
 * @since 1.0.0
 */
export const durableModelStream = (
  name: string,
  source: ModelSource,
  request: ModelRequest.ModelRequest,
  callTimeoutMs?: number,
  onStart?: () => Effect.Effect<void>
): Stream.Stream<ModelEvent.ModelEvent, Model.ModelFailure, ModelStep.Requirements> =>
  Stream.callback<ModelEvent.ModelEvent, Model.ModelFailure, ModelStep.Requirements>((queue) =>
    effect {
      const prepared = try source.route.prepare(request)
      const { body, ...material } = prepared
      const key = try Effect.orDie(Effect.try({
        try: () =>
          digestSync(
            CanonicalJson.stringify({
              request: JSON.parse(JSON.stringify(request)),
              prepared: { ...material, body: Array.from(body) }
            })
          ),
        catch: keepDefect
      }))
      let executed = false
      const recorded = try Action.make({
        name: name + "/outcome",
        tier: "sealed",
        idempotencyKey: key,
        retryPolicy: once,
        success: Recorded,
        error: ModelStep.Failure,
        execute: effect {
          executed = true
          if (onStart !== undefined) try onStart()
          const events: Array<ModelEvent.ModelEvent> = []
          const result = try ModelStep.run({
            name,
            request,
            model: safeModel(source),
            route: source.route,
            retryPolicy: once,
            ...(callTimeoutMs === undefined ? {} : { callTimeoutMs }),
            onEvent: (event) =>
              Effect.sync(() => {
                events.push(event)
                Queue.offerUnsafe(queue, event)
              })
          }).pipe(
            Effect.catchTag("flows/model/ModelError", (error) => Effect.succeed({ events, error, replayed: false }))
          )
          // Preserve partial output on errors: fallback must never hide it.
          return { events, ...(result.error === undefined ? {} : { error: result.error }) }
        }
      })
      if (!executed) try Effect.forEach(recorded.events, (event) => Queue.offer(queue, event), { discard: true })
      if (recorded.error !== undefined) throw recorded.error
    }.pipe(
      Effect.mapError((error) =>
        error._tag === "/harness/HarnessError"
          ? new ModelError.ModelError({ code: "unknown", message: "durable model step failed" })
          : error
      ),
      Effect.onExit((exit) =>
        Effect.asVoid(Exit.isSuccess(exit) ? Queue.end(queue) : Queue.failCause(queue, exit.cause))
      )
    )
  )
