/**
 * Scan a flows tree, list its commands, and run one agent command string and
 * one HTTP request against the same routes.
 */
import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
import * as NodePath from "@effect/platform-node/NodePath"
import { Command, FileRouter, FlowInvoker, Incur } from "../src/index.ts"

/** The flows tree that ships beside this example. */
export const flowsRoot = `${import.meta.dirname}/flows`

const platform = Layer.merge(NodeFileSystem.layer, NodePath.layer)

// A host normally runs the flow durably. This boundary answers directly so the
// example shows only routing, decoding, and encoding.
const invoker = FlowInvoker.make({
  invoke: effect ({ input }) => ({ accepted: true, number: (input as { number: number }).number }),
})

/** Lists the agent commands under `root` and executes `commandString`. */
export effect function runAgentCommand(root: string, commandString: string) {
  provide platform, FlowInvoker.FlowInvoker = invoker {
    const { routes } = try FileRouter.scan({ root })
    const commands = try Command.make(routes)
    const output = try commands.execute(commandString)
    return { listed: commands.list(), output }
  }
}

/** Serves the routes under `root` over HTTP for one request, then closes. */
export effect function fetchCommand(root: string, request: Request) {
  provide platform, FlowInvoker.FlowInvoker = invoker {
    const { routes } = try FileRouter.scan({ root })
    const cli = try Incur.createCli("flows", routes)
    try {
      return try sync(async (cli, request): Promise<unknown> => (await cli.fetch(request)).json(), cli, request)
    } finally {
      try sync(async (cli) => cli.close(), cli)
    }
  }
}
