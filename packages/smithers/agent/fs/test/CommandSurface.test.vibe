import { describe, expect, it } from "@effect/vitest"
import * as Command from "../src/Command.vibe"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import { failureOf, invalidModule, makeRoute, specialModule } from "./helpers.vibe"
import { runModuleScript } from "./modules.ts"

describe("Command surface", () => {
  it.effect("advertises only executable model-visible modules in stable order", effect () => {
    const surface = try Command.make([
      makeRoute("z-hidden", undefined, { modelInvocable: false }),
      makeRoute("markdown", undefined, { kind: "markdown" }),
      makeRoute("skill", undefined, { kind: "skill" }),
      makeRoute("nested/visible"),
      makeRoute("alpha")
    ])

    expect(surface.list()).toEqual([
      { name: "alpha", description: "alpha description" },
      { name: "nested/visible", description: "nested/visible description" }
    ])
    expect(Object.isFrozen(surface.list())).toBe(true)
    expect(Object.isFrozen(surface)).toBe(true)
  })

  it.effect("round-trips listed slash names and schema-decodes flags", effect () => {
    const surface = try Command.make([makeRoute("nested/visible")])
    const slash = try surface.parse("nested/visible --number 42 --enabled --tags one --tags two")
    const spaced = try surface.parse("nested visible --number=7")

    expect(slash.route.name).toBe("nested/visible")
    expect(slash.input).toEqual({ enabled: true, number: 42, tags: ["one", "two"] })
    expect(spaced.input).toEqual({ number: 7 })
    expect(Object.isFrozen(slash.input)).toBe(true)
  })

  it.effect("invokes decoded input and encodes output", effect () => {
    const surface = try Command.make([makeRoute("review")])
    const seen: Array<FlowInvoker.Invocation> = []
    const invoker = FlowInvoker.make({
      invoke: effect (invocation) => {
        seen.push(invocation)
        return { accepted: true, number: (invocation.input as { number: number }).number }
      }
    })
    provide FlowInvoker.FlowInvoker = invoker {
      expect(try surface.execute("review --number 42")).toEqual({ accepted: true, number: 42 })
    }

    expect(seen).toHaveLength(1)
    expect(Object.isFrozen(seen[0])).toBe(true)
  })

  it.effect("snapshots programmatic input before loading and requires an exact name", effect () => {
    const surface = try Command.make([makeRoute("nested/visible")])
    const observed: Array<unknown> = []
    const invoker = FlowInvoker.make({
      invoke: effect ({ input }) => {
        observed.push(input)
        return { accepted: true, number: (input as { number: number }).number }
      }
    })
    provide FlowInvoker.FlowInvoker = invoker {
      const source: { mutable number: number } = { number: 1 }
      // Start the call before mutating its source, as runPromise would: the
      // fiber runs until route loading suspends it.
      const pending = fork (surface.call("nested/visible", source), { startImmediately: true })
      source.number = 2

      expect(try surface.call("nested/visible", { number: 1 })).toEqual({ accepted: true, number: 1 })
      expect(join pending).toEqual({ accepted: true, number: 1 })
      expect(observed).toEqual([{ number: 1 }, { number: 1 }])
      expect(Object.isFrozen(observed[0])).toBe(true)

      expect((try failureOf(surface.call("nested/visible/typo", { number: 1 }))).code).toBe("unknown_command")
      expect((try failureOf(surface.call(1 as never, { number: 1 } as never))).code).toBe("unknown_command")
    }
  })

  it.effect("returns typed decode, encode, and load failures without input disclosure", effect () => {
    const surface = try Command.make([
      makeRoute("review"),
      makeRoute("invalid", invalidModule)
    ])
    const badInput = try failureOf(surface.parse("review --number TOP-SECRET"))
    expect(badInput).toMatchObject({
      code: "decode_failed"
    })
    expect(JSON.stringify(badInput)).not.toContain("TOP-SECRET")

    expect((try failureOf(surface.parse("invalid --number 1"))).code).toBe("load_failed")

    provide FlowInvoker.layerNoop({ invoke: effect () => ({ accepted: "yes", number: 1 }) }) {
      expect((try failureOf(surface.execute("review --number 1"))).code).toBe("encode_failed")
    }
  })

  it.effect("loads paths containing URL structural characters", effect () => {
    const routeModule = new URL("../src/Route.vibe", import.meta.url).href
    const descriptorModule = new URL("../../registry/src/Descriptor.vibe", import.meta.url).href
    const script = `
      import { Effect, Option } from "effect"
      import * as Descriptor from ${JSON.stringify(descriptorModule)}
      import * as Route from ${JSON.stringify(routeModule)}
      const sourcePath = ${JSON.stringify(specialModule)}
      const route = {
        name: "special", segments: ["special"], kind: "module", sourcePath,
        description: Option.none(),
        input: new Descriptor.SchemaRefModule({ path: sourcePath, field: "input" }),
        output: new Descriptor.SchemaRefModule({ path: sourcePath, field: "output" }),
        capabilities: [], effects: { reads: [], writes: [], mode: "hermetic", onConflict: "serialize", tier: "sealed" },
        modelInvocable: true, placement: Option.none(), ui: Option.none()
      }
      const flow = await Effect.runPromise(Route.load(route))
      process.stdout.write(flow.description)
    `
    expect(try sync((script) => runModuleScript(script), script)).toBe("Special path fixture.")
  })
})
