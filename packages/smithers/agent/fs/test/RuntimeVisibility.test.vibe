import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
import * as NodePath from "@effect/platform-node/NodePath"
import { describe, expect, it } from "@effect/vitest"
import * as Command from "../src/Command.vibe"
import * as FileRouter from "../src/FileRouter.vibe"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import * as Incur from "../src/Incur.vibe"
import * as Route from "../src/Route.vibe"
import { hiddenRuntimeRoot as root } from "./fixtureRoots.ts"
import { failureOf } from "./helpers.vibe"

const platformLayer = Layer.merge(NodeFileSystem.layer, NodePath.layer)

function scan() {
  provide platformLayer {
    return FileRouter.scan({ root })
  }
}

const invoked: Array<string> = []
const invoker = FlowInvoker.make({
  invoke: (invocation) => {
    invoked.push(invocation.name)
    return invocation.input
  }
})

/** Runs a program with the recording invoker. */
function invoking<A, E>(program: Effect<A, E, FlowInvoker.FlowInvoker>): Effect<A, E, infer R> {
  provide FlowInvoker.FlowInvoker = invoker {
    return program()
  }
}

describe("runtime model visibility", () => {
  it.effect("refuses a flow hidden after its route metadata was captured") {
    const [scanned] = scan().routes
    expect(scanned?.modelInvocable).toBe(false)
    // Route metadata is caller-owned and can be stale: the author hid the flow
    // after a scan recorded it as visible.
    const stale = { ...scanned!, modelInvocable: true }

    const surface = Command.make([stale])
    expect(failureOf(invoking(surface.execute("hidden --number 1"))).code).toBe("load_failed")
    expect(failureOf(invoking(surface.call("hidden", { number: 1 }))).code).toBe("load_failed")
    expect(failureOf(invoking(surface.parse("hidden --number 1"))).code).toBe("load_failed")
    expect(invoked).toEqual([])
  }

  it.effect("refuses the stale route over Incur HTTP dispatch") {
    const [scanned] = scan().routes
    const stale = { ...scanned!, modelInvocable: true }
    const cli = invoking(Incur.createCli("app", [stale]))
    try {
      const response = sync(async (cli) => cli.fetch(new Request("http://localhost/hidden?number=1")), cli)
      expect(response.status).toBe(400)
      expect(sync(async (response) => response.json(), response)).toMatchObject({
        ok: false,
        error: { code: "load_failed" }
      })
      expect(invoked).toEqual([])
    } finally {
      sync(async (cli) => cli.close(), cli)
    }
  }

  it.effect("still loads the hidden flow for a route that is not model-invocable") {
    const [scanned] = scan().routes
    const loaded = Route.load(scanned!)
    expect(loaded.name).toBe("hidden")
  }
})
