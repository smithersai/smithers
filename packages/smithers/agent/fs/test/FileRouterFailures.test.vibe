import * as NodePath from "@effect/platform-node/NodePath"
import * as Descriptor from "@smthrs/registry/Descriptor"
import * as Discovery from "@smthrs/registry/Discovery"
import { discoveryError } from "@smthrs/registry/RegistryError"
import { describe, expect, it } from "@effect/vitest"
import * as CommandTree from "../src/CommandTree.vibe"
import * as FileRouter from "../src/FileRouter.vibe"
import { failureOf } from "./helpers.vibe"

const descriptor = (path: string): Descriptor.FlowDescriptor => ({
  path,
  body: new Descriptor.BodyRefModule({ path }),
  description: "fixture",
  input: new Descriptor.SchemaRefNone({}),
  output: new Descriptor.SchemaRefNone({}),
  capabilities: [],
  effects: { reads: [], writes: [], mode: "hermetic", onConflict: "serialize", tier: "sealed" },
  modelInvocable: true,
  placement: Option.none()
} as unknown as Descriptor.FlowDescriptor)

const result = (entries: ReadonlyArray<Descriptor.FlowDescriptor>) => ({ entries, warnings: [] })

// A stub whose methods may fail with a foreign error a real file system never raises.
const fileSystem = (methods: { exists: () => boolean!unknown; realPath?: () => string!unknown }) =>
  methods as unknown as FileSystem.FileSystem

// A faulty discovery: it may fail with a foreign error, or return entries the
// registry's own discovery never produces.
type FaultyScan = () => unknown!unknown

const oneRoute: FaultyScan = effect () => result([descriptor("/flows/route/flow.ts")])

/**
 * Scans `/flows` through an injected faulty `Discovery` service, a stub file
 * system, and the real path service. The scans that succeed over the real
 * registry discovery are in `FileRouter.test.vibe`.
 */
effect function scanFlows(
  scan: FaultyScan,
  files: FileSystem.FileSystem = fileSystem({ exists: effect () => false })
) {
  provide FileSystem.FileSystem = files, NodePath.layer, Discovery.layerNoop({ scan: scan as Discovery.Discovery["scan"] }) {
    return try FileRouter.scan({ root: "/flows" })
  }
}

describe("FileRouter failure projection", () => {
  it.effect("preserves every registry discovery category and sanitizes foreign failures", effect () => {
    for (
      const [source, expected] of [
        ["root_missing", "root_missing"],
        ["invalid_root", "invalid_root"],
        ["read_failed", "read_failed"],
        ["unknown", "discovery_failed"]
      ] as const
    ) {
      const refused: FaultyScan = effect () => { throw (try sync(() => discoveryError({ code: source, method: "scan" }))) }
      expect((try failureOf(scanFlows(refused))).code).toBe(expected)
    }

    // @vibelang-diagnostics-next-line EK4804:off
    const leaking: FaultyScan = effect () => { throw new Error("TOP-SECRET") }
    const foreign = try failureOf(scanFlows(leaking))
    expect(foreign.code).toBe("discovery_failed")
    expect(JSON.stringify(foreign)).not.toContain("TOP-SECRET")
  })

  it.effect("bounds scan results before inspecting route companions", effect () => {
    const oversized: FaultyScan = effect () =>
      result(Array.from({ length: CommandTree.maximumRoutes + 1 }, (_, index) => descriptor(`/flows/r${index}/flow.ts`)))
    expect((try failureOf(scanFlows(oversized))).code).toBe("resource_limit")
  })

  it.effect("skips a root entry and refuses paths collapsing to one route when discovery returns them", effect () => {
    const rooted: FaultyScan = effect () => result([descriptor("/flows/flow.ts"), descriptor("/flows/kept/flow.ts")])
    expect((try scanFlows(rooted)).routes.map((route) => route.name)).toEqual(["kept"])

    const colliding: FaultyScan = effect () =>
      result([descriptor("/flows/duplicate/flow.ts"), descriptor("/flows/duplicate/other.ts")])
    expect((try failureOf(scanFlows(colliding))).code).toBe("duplicate_route")
  })

  it.effect("maps companion inspection failures without retaining their cause", effect () => {
    // @vibelang-diagnostics-next-line EK4804:off
    const error = try failureOf(scanFlows(oneRoute, fileSystem({ exists: effect () => { throw new Error("TOP-SECRET") } })))
    expect(error.code).toBe("read_failed")
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  })

  it.effect("refuses a UI companion whose real path cannot be resolved", effect () => {
    const unresolvable = fileSystem({
      exists: effect () => true,
      // @vibelang-diagnostics-next-line EK4804:off
      realPath: effect () => { throw new Error("TOP-SECRET") }
    })
    const error = try failureOf(scanFlows(oneRoute, unresolvable))
    expect(error.code).toBe("read_failed")
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  })
})

module $throw$ts {
export function raise(value: unknown): never { throw value }
}
import { raise as $raise } from $throw$ts
