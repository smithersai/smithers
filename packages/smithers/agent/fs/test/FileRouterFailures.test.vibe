import * as NodePath from "@effect/platform-node/NodePath"
import * as Descriptor from "@smthrs/registry/Descriptor"
import { discoveryError } from "@smthrs/registry/RegistryError"
import { describe, expect, it } from "@effect/vitest"
import { vi } from "vitest"

const discovery = vi.hoisted(() => ({
  scan: undefined as undefined | ((options: unknown) => Effect<unknown, unknown>)
}))

vi.mock("@smthrs/registry/Discovery", (importOriginal) =>
  importOriginal<typeof import("@smthrs/registry/Discovery")>().then((actual) => ({
    ...actual,
    make: () => ({
      scan: (options: unknown) => discovery.scan!(options)
    })
  })))

import * as CommandTree from "../src/CommandTree.vibe"
import * as FileRouter from "../src/FileRouter.vibe"
import { failureOf } from "./helpers.vibe"

const descriptor = (path: string): Descriptor.FlowDescriptor => ({
  path,
  body: new Descriptor.BodyRefModule({ path }),
  description: "fixture",
  input: new Descriptor.SchemaRefNone({}),
  output: new Descriptor.SchemaRefNone({}),
  capabilities: [],
  effects: { reads: [], writes: [], mode: "hermetic", onConflict: "serialize", tier: "sealed" },
  modelInvocable: true,
  placement: Option.none()
} as unknown as Descriptor.FlowDescriptor)

const result = (entries: ReadonlyArray<Descriptor.FlowDescriptor>) => ({ entries, warnings: [] })

// A stub whose methods may fail with a foreign error a real file system never raises.
const fileSystem = (methods: { exists: () => Effect<boolean, unknown>; realPath?: () => Effect<string, unknown> }) =>
  methods as unknown as FileSystem.FileSystem

/** Scans `/flows` over the mocked discovery, a stub file system, and the real path service. */
function scanFlows(files: FileSystem.FileSystem = fileSystem({ exists: () => false })) {
  provide FileSystem.FileSystem = files, NodePath.layer {
    return FileRouter.scan({ root: "/flows" })
  }
}

describe("FileRouter failure projection", () => {
  it.effect("preserves every registry discovery category and sanitizes foreign failures") {
    for (
      const [source, expected] of [
        ["root_missing", "root_missing"],
        ["invalid_root", "invalid_root"],
        ["read_failed", "read_failed"],
        ["unknown", "discovery_failed"]
      ] as const
    ) {
      discovery.scan = () => throw discoveryError({ code: source, method: "scan" })
      expect(failureOf(scanFlows()).code).toBe(expected)
    }

    // @vibelang-diagnostics-next-line EK4804:off
    discovery.scan = () => throw new Error("TOP-SECRET")
    const foreign = failureOf(scanFlows())
    expect(foreign.code).toBe("discovery_failed")
    expect(JSON.stringify(foreign)).not.toContain("TOP-SECRET")
  }

  it.effect("bounds scan results before inspecting route companions") {
    discovery.scan = () =>
      result(Array.from({ length: CommandTree.maximumRoutes + 1 }, (_, index) => descriptor(`/flows/r${index}/flow.ts`)))
    expect(failureOf(scanFlows()).code).toBe("resource_limit")
  }

  it.effect("skips root entries and refuses paths collapsing to one route") {
    discovery.scan = () => result([descriptor("/flows/flow.ts"), descriptor("/flows/kept/flow.ts")])
    expect(scanFlows().routes.map((route) => route.name)).toEqual(["kept"])

    discovery.scan = () => result([descriptor("/flows/duplicate/flow.ts"), descriptor("/flows/duplicate/other.ts")])
    expect(failureOf(scanFlows()).code).toBe("duplicate_route")
  }

  it.effect("maps companion inspection failures without retaining their cause") {
    discovery.scan = () => result([descriptor("/flows/route/flow.ts")])
    // @vibelang-diagnostics-next-line EK4804:off
    const error = failureOf(scanFlows(fileSystem({ exists: () => throw new Error("TOP-SECRET") })))
    expect(error.code).toBe("read_failed")
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  }

  it.effect("refuses a UI companion whose real path cannot be resolved") {
    discovery.scan = () => result([descriptor("/flows/route/flow.ts")])
    const unresolvable = fileSystem({
      exists: () => true,
      // @vibelang-diagnostics-next-line EK4804:off
      realPath: () => throw new Error("TOP-SECRET")
    })
    const error = failureOf(scanFlows(unresolvable))
    expect(error.code).toBe("read_failed")
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  }
})
