import { describe, expect, it } from "@effect/vitest"
import { fetchCommand, flowsRoot, runAgentCommand } from "../examples/agent-command.vibe"
import { failureOf } from "./helpers.vibe"

describe("examples/agent-command", () => {
  it.effect("lists the scanned command and decodes the command-line number before invoking", effect () => {
    const result = try runAgentCommand(flowsRoot, "review --number 42")
    expect(result).toEqual({
      listed: [{ name: "review", description: "Review a pull request." }],
      output: { accepted: true, number: 42 }
    })
  })

  it.effect("refuses a command string the flow schema rejects", effect () => {
    expect(try failureOf(runAgentCommand(flowsRoot, "review --number forty-two"))).toMatchObject({
      code: "decode_failed"
    })
  })

  it.effect("serves the same route over HTTP", effect () => {
    const body = try fetchCommand(flowsRoot, new Request("http://localhost/review?number=7"))
    expect(body).toMatchObject({ ok: true, data: { accepted: true, number: 7 } })
  })
})
