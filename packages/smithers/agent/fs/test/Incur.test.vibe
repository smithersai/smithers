import { metadataGlobals, createMetadataFixture, removeMetadataFixture, nativeConsole } from "./modules.ts"
import { Request } from "./modules.ts"

import { $platform$4 } from "./Incur.test.platform.js";
import { $platform$3 } from "./Incur.test.platform.js";
import { $platform$2 } from "./Incur.test.platform.js";
import { $platform$1 } from "./Incur.test.platform.js";
import { $platform } from "./Incur.test.platform.js";
import * as Descriptor from "@smthrs/registry/Descriptor"
import { describe, expect, it, type Mock, vi } from "@effect/vitest"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import { FsError } from "../src/FsError.vibe"
import * as Incur from "../src/Incur.vibe"
import * as Route from "../src/Route.vibe"
import visible from "./fixtures/command/visible.ts"
import { failureOf, latchedInvoke, makeRoute, recordedImports, recordedModule, refinedModule } from "./helpers.vibe"

// Every test runs with `it.live`: a CLI keeps the services of the fiber that
// created it, so a test clock would freeze its metadata deadline and a test
// console would swallow the logger output these tests observe.

type Cli = Effect.Success<ReturnType<typeof Incur.createCli>>

/** Waits for a host promise; a rejection fails the test as a defect. */
effect function awaited<A>(pending: () => PromiseLike<A>): A!! {
  return try promise(async () => await pending())
}

/** Fails the test when a host wait outlasts its real-time deadline. */
effect function within<A, E>(program: A!E, milliseconds: number): A!E {
  return try Effect.timeoutOrElse(program, {
    duration: milliseconds,
    orElse: () => die(new Error("Metadata wait exceeded test deadline"))
  })
}

interface Gate {
  promise: Promise<void>
  release: () => void
}

const makeGate = (): Gate => {
  let release!: () => void
  const promise = new Promise<void>((resolve) => {
    release = resolve
  })
  return { promise, release }
}

/** A metadata load that waits for a gate and records its interruption. */
effect function gatedLoad(gate: Promise<void>, interrupted?: Mock) {
  return try onExit(effect {
    try awaited(() => gate)
    return visible
  }, effect (result) => {
    if (Exit.isFailure(result) && Cause.hasInterrupts(result.cause)) try sync(() => interrupted?.())
  })
}

effect function makeCli(routes: ReadonlyArray<Route.Route> = [makeRoute("review")], invoke?: FlowInvoker.FlowInvoker.Shape["invoke"]) {
  const seen: Array<FlowInvoker.Invocation> = []
  const invoker = FlowInvoker.make({
    invoke: invoke ?? (effect (invocation) => {
      seen.push(invocation)
      const number = (invocation.input as { number: number }).number
      return { accepted: true, number }
    })
  })
  provide FlowInvoker.FlowInvoker = invoker {
    return { cli: try Incur.createCli("flows", routes), seen }
  }
}

/** Creates a CLI whose host logs at debug level through the given logger layer. */
effect function debugCli(loggers: Layer.Layer<never>, invoker: FlowInvoker.FlowInvoker.Shape) {
  provide loggers, References.MinimumLogLevel = "Debug", FlowInvoker.FlowInvoker = invoker {
    return try Incur.createCli("flows", [makeRoute("review")])
  }
}

const capture = () => {
  const writes: Array<string> = []
  const exits: Array<number> = []
  return {
    writes,
    exits,
    options: {
      stdout: (value: string) => writes.push(value),
      exit: (code: number) => exits.push(code)
    }
  }
}

/** Captures `process.stdout` writes until the returned spy is restored. */
function spyOnStdout(writes: Array<string>) {
  return sync(() =>
    vi.spyOn($platform(), "write").mockImplementation(
      ((chunk: unknown) => {
        writes.push(String(chunk))
        return true
      }) as typeof process.stdout.write
    ))
}

/** Starts a discovery request; the pending promise resolves to the sorted OpenAPI paths. */
const paths = (cli: Cli): Promise<Array<string>> =>
  cli.fetch(new Request("http://localhost/openapi.json"))
    .then((response) => response.json() as Promise<{ paths: Readonly<Record<string, unknown>> }>)
    .then((spec) => Object.keys(spec.paths).sort())

const mcpRequest = (name: string, args: Readonly<Record<string, unknown>>, signal?: AbortSignal): Request =>
  new Request("http://localhost/mcp", {
    method: "POST",
    ...(signal === undefined ? {} : { signal }),
    headers: { "content-type": "application/json", accept: "application/json, text/event-stream" },
    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name, arguments: args } })
  })

/** Calls one tool on the MCP surface and returns the JSON-RPC payload. */
effect function tool(cli: Cli, name: string, args: Readonly<Record<string, unknown>>) {
  const response = try awaited(() => cli.fetch(mcpRequest(name, args)))
  return try awaited(() => response.json()) as {
    result: {
      isError?: boolean
      content: ReadonlyArray<{ text: string }>
    }
  }
}

const transports = ["HTTP", "CLI", "MCP"] as const

effect function call(cli: Cli, transport: typeof transports[number]) {
  if (transport === "HTTP") {
    const response = try awaited(() => cli.fetch(new Request("http://localhost/review?number=42")))
    return { failed: response.status >= 400, body: try awaited(() => response.text()) }
  }
  if (transport === "CLI") {
    const run = capture()
    try awaited(() => cli.serve(["review", "--number", "42", "--format", "json"], run.options))
    return { failed: run.exits.includes(1), body: run.writes.join("") }
  }
  const response = try tool(cli, "call_write_tool", { name: "review", arguments: { number: 42 } })
  return { failed: response.result.isError === true, body: JSON.stringify(response) }
}

describe("Incur projection", () => {
  it.live("bounds a native import stuck in top-level await and discovers sibling routes", effect () => {
    const gate = makeGate()
    const globals = metadataGlobals
    globals.fsMetadataGate = gate.promise
    const { directory, source } = try promise(() => createMetadataFixture())
    const { cli } = try makeCli([makeRoute("a-stuck", source), makeRoute("review")])
    const discovery = try Effect.orDie(Effect.try({ try: () => paths(cli), catch: (error) => error }))
    try ensuring(effect {
      expect(try within(awaited(() => discovery), 8_000)).toEqual(["/a-stuck", "/review"])
      const called = try tool(cli, "call_write_tool", { name: "a-stuck", arguments: {} })
      expect(called.result.isError).toBe(true)
      expect(called.result.content[0]!.text).toContain("The route metadata load timed out")
      expect((try call(cli, "MCP")).failed).toBe(false)
    }, effect {
      // Release this otherwise unbounded module only after the deadline
      // assertions so teardown leaves no outstanding module evaluation.
      gate.release()
      try awaited(() => discovery.catch(() => undefined))
      delete globals.fsMetadataGate
      try promise(() => removeMetadataFixture(directory))
    })
  })

  it.live.each(["/openapi.json", "/missing"])("cancels only the waiter for %s", effect (path) => {
    const gate = makeGate()
    const load = vi.spyOn(Route, "load").mockReturnValue(gatedLoad(gate.promise))
    const { cli } = try makeCli()
    const controller = new AbortController()
    const reason = new Error("request cancelled")
    const request = try Effect.sync(() => cli.fetch(new Request(`http://localhost${path}`, { signal: controller.signal })))
    const other = try Effect.sync(() => paths(cli))
    try ensuring(effect {
      try awaited(() => vi.waitFor(() => expect(load).toHaveBeenCalledTimes(1)))
      controller.abort(reason)
      try (within(awaited(() => expect(request).rejects.toBe(reason)), 500))
      expect(load).toHaveBeenCalledTimes(1)
      gate.release()
      expect(try awaited(() => other)).toEqual(["/review"])
    }, effect {
      gate.release()
      try awaited(() => Promise.allSettled([request, other]))
      load.mockRestore()
    })
  })

  it.live("does not start a metadata build for an already aborted request", effect () => {
    const load = vi.spyOn(Route, "load")
    const { cli } = try makeCli()
    const controller = new AbortController()
    const reason = new Error("already cancelled")
    controller.abort(reason)
    try ensuring(effect {
      try (awaited(() => 
        expect(cli.fetch(new Request("http://localhost/openapi.json", { signal: controller.signal })))
          .rejects.toBe(reason)
      ))
      expect(load).not.toHaveBeenCalled()
    
    }, effect {
      load.mockRestore()
    })
  })

  it.live("retries a rejected shared metadata build on the next request", effect () => {
    const load = vi.spyOn(Route, "load").mockReturnValueOnce(die(new Error("build failed once")))
    const { cli } = try makeCli()
    try ensuring(effect {
      try awaited(() => expect(paths(cli)).rejects.toThrow("build failed once"))
      expect(try awaited(() => paths(cli))).toEqual(["/review"])
      expect(try awaited(() => paths(cli))).toEqual(["/review"])
      expect(load).toHaveBeenCalledTimes(2)
    
    }, effect {
      load.mockRestore()
    })
  })

  it.live("cancels a request aborted synchronously while its shared build starts", effect () => {
    const controller = new AbortController()
    const reason = new Error("cancelled during startup")
    // The abort runs when the build calls `load`, before its program runs.
    const load = vi.spyOn(Route, "load").mockImplementationOnce((): typeof visible!! => {
      controller.abort(reason)
      return effect {
        return visible
      }
    })
    const { cli } = try makeCli()
    try ensuring(effect {
      try (awaited(() => 
        expect(cli.fetch(new Request("http://localhost/openapi.json", { signal: controller.signal })))
          .rejects.toBe(reason)
      ))
      expect(try awaited(() => paths(cli))).toEqual(["/review"])
      expect(load).toHaveBeenCalledTimes(1)
    
    }, effect {
      load.mockRestore()
    })
  })

  describe("request cancellation", () => {
    it.live("never invokes a flow for an already aborted request", effect () => {
      const { cli, seen } = try makeCli()
      const controller = new AbortController()
      const reason = new Error("cancelled before dispatch")
      controller.abort(reason)
      try (awaited(() => 
        expect(cli.fetch(new Request("http://localhost/review?number=42", { signal: controller.signal })))
          .rejects.toBe(reason)
      ))
      try (awaited(() => 
        expect(
          cli.fetch(mcpRequest("call_write_tool", { name: "review", arguments: { number: 42 } }, controller.signal))
        ).rejects.toBe(reason)
      ))
      expect(seen).toEqual([])
    })

    it.live("interrupts route selection when the request aborts", effect () => {
      const gate = makeGate()
      const interrupted = vi.fn()
      const load = vi.spyOn(Route, "load").mockReturnValue(gatedLoad(gate.promise, interrupted))
      const { cli, seen } = try makeCli()
      const controller = new AbortController()
      const request = try Effect.sync(() => cli.fetch(new Request("http://localhost/review?number=42", { signal: controller.signal })))
      try ensuring(effect {
        try awaited(() => vi.waitFor(() => expect(load).toHaveBeenCalledTimes(1)))
        controller.abort(new Error("cancelled during selection"))
        try (within(awaited(() => expect(request).rejects.toThrow("All fibers interrupted")), 500))
        expect(interrupted).toHaveBeenCalledTimes(1)
        expect(seen).toEqual([])
      
    }, effect {
        gate.release()
        try awaited(() => Promise.allSettled([request]))
        load.mockRestore()
    })
    })

    it.live.each(["HTTP", "MCP"] as const)(
      "interrupts an in-flight %s invocation when the request aborts",
      effect (transport) => {
        const latch = latchedInvoke()
        const { cli } = try makeCli(undefined, latch.invoke)
        const controller = new AbortController()
        const request = transport === "HTTP"
          ? new Request("http://localhost/review?number=42", { signal: controller.signal })
          : mcpRequest("call_write_tool", { name: "review", arguments: { number: 42 } }, controller.signal)
        const response = try Effect.sync(() => cli.fetch(request))
        const settled = try Effect.sync(() => Promise.allSettled([response]))
        try ensuring(effect {
          try (within(awaited(() => latch.started), 8_000))
          controller.abort(new Error("client went away"))
          // The abort interrupts the invocation fiber, which runs its finalizers
          // before the request settles.
          try (within(awaited(() => latch.finalized), 500))
          const [outcome] = try awaited(() => settled)
          if (outcome!.status === "fulfilled") {
            const result = outcome!.value
            if (transport === "HTTP") {
              expect(result.status).toBeGreaterThanOrEqual(400)
            } else {
              const payload = try awaited(() => result.json()) as {
                error?: unknown
                result?: { isError?: boolean }
              }
              expect(payload.error !== undefined || payload.result?.isError === true).toBe(true)
            }
          }
        }, effect {
          latch.release()
          try awaited(() => settled)
        })
      }
    )
  })

  it.live("closes the host by interrupting the build before projecting more routes", effect () => {
    const interrupted = vi.fn()
    const gate = makeGate()
    const load = vi.spyOn(Route, "load").mockReturnValue(gatedLoad(gate.promise, interrupted))
    const { cli } = try makeCli([makeRoute("first"), makeRoute("second")])
    const pending = try Effect.orDie(Effect.try({ try: () => paths(cli), catch: (error) => error }))
    // Install a rejection handler before closing the host.
    const settled = try Effect.orDie(Effect.try({ try: () => Promise.allSettled([pending]), catch: (error) => error }))
    try ensuring(effect {
      try awaited(() => vi.waitFor(() => expect(load).toHaveBeenCalledTimes(1)))
      try (within(awaited(() => cli.close()), 500))
      expect(interrupted).toHaveBeenCalledTimes(1)
      expect((try awaited(() => settled))[0]!.status).toBe("rejected")
      try awaited(() => expect(paths(cli)).rejects.toThrow("The CLI is closed"))
      try awaited(() => expect(cli.fetch(new Request("http://localhost/first"))).rejects.toThrow("The CLI is closed"))
      try awaited(() => expect(cli.serve(["--llms"], capture().options)).rejects.toThrow("The CLI is closed"))
      try awaited(() => cli.close())
      expect(load).toHaveBeenCalledTimes(1)
    
    }, effect {
      gate.release()
      try awaited(() => settled)
      load.mockRestore()
    })
  })

  it.live("carries typed inputs consistently over GET and JSON POST", effect () => {
    const { cli, seen } = try makeCli()
    const get = try awaited(() => cli.fetch(new Request("http://localhost/review?number=42&enabled=true")))
    const post = try awaited(() => cli.fetch(
      new Request("http://localhost/review", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ number: 43, tags: ["a", "b"] })
      })
    ))

    expect(get.status).toBe(200)
    expect((try awaited(() => get.json())).data).toEqual({ accepted: true, number: 42 })
    expect(post.status).toBe(200)
    expect((try awaited(() => post.json())).data).toEqual({ accepted: true, number: 43 })
    expect(seen.map((invocation) => invocation.input)).toEqual([
      { number: 42, enabled: true },
      { number: 43, tags: ["a", "b"] }
    ])
  })

  it.live("accepts declared flags from the CLI projection", effect () => {
    const { cli, seen } = try makeCli()
    const writes: Array<string> = []
    const write = try spyOnStdout(writes)
    try ensuring(effect {
      try awaited(() => cli.serve(["review", "--number", "44", "--format", "json"]))
    
    }, effect {
      try sync(() => write.mockRestore())
    })
    expect(seen[0]?.input).toEqual({ number: 44 })
    expect(writes.join("")).toContain("44")
  })

  it.live("carries an explicit null scalar input over a JSON body and MCP arguments", effect () => {
    const flow = {
      capabilities: [],
      effects: undefined,
      name: "scalar",
      input: Schema.NullOr(Schema.String),
      output: Schema.NullOr(Schema.String)
    } as const
    vi.spyOn(Route, "load").mockImplementation(effect () => flow)
    try ensuring(effect {
      const inputs: Array<unknown> = []
      const { cli } = try makeCli([makeRoute("scalar")], effect ({ input }) => {
        inputs.push(input)
        return input
      })
      const post = try awaited(() => cli.fetch(
        new Request("http://localhost/scalar", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ input: null })
        })
      ))
      expect(post.status).toBe(200)
      const called = try tool(cli, "call_write_tool", { name: "scalar", arguments: { input: null } })
      expect(called.result.isError).not.toBe(true)
      expect(inputs).toEqual([null, null])
    }, effect {
      vi.restoreAllMocks()
    })
  })

  it.live("advertises the real input schema on every discovery surface", effect () => {
    const { cli } = try makeCli()
    // The flow's own JSON Schema is the yardstick: a discovery surface that
    // publishes anything narrower or vaguer misdescribes what the flow takes.
    const declared = Schema.toJsonSchemaDocument(visible.input).schema as {
      properties: Readonly<Record<string, unknown>>
      required: ReadonlyArray<string>
    }

    const details = try tool(cli, "get_tool_details", { name: "review" })
    const advertised = (try ((foreignSyntaxErrorClass: typeof SyntaxError) => Effect.catch(Effect.try({ try: () => JSON.parse(details.result.content[0]!.text), catch: (error) => error }), (error) => error instanceof foreignSyntaxErrorClass ? Effect.fail(error) : Effect.die(error)))(SyntaxError)) as {
      inputSchema: {
        properties: Readonly<Record<string, unknown>>
        required: ReadonlyArray<string>
      }
    }
    expect(advertised.inputSchema.properties).toEqual(declared.properties)
    expect(advertised.inputSchema.required).toEqual(declared.required)

    const specResponse = try awaited(() => cli.fetch(new Request("http://localhost/openapi.json")))
    const spec = try awaited(() => specResponse.json()) as {
      paths: {
        "/review": {
          post: {
            requestBody: {
              content: {
                "application/json": {
                  schema: { properties: Readonly<Record<string, unknown>> }
                }
              }
            }
          }
        }
      }
    }
    expect(spec.paths["/review"].post.requestBody.content["application/json"].schema.properties).toEqual(
      declared.properties
    )

    const help = capture()
    try awaited(() => cli.serve(["review", "--schema"], help.options))
    expect(help.writes.join("")).toContain("number")
  })

  it.live("carries MCP tool arguments through to the invoked flow", effect () => {
    const { cli, seen } = try makeCli()
    const called = try tool(cli, "call_write_tool", { name: "review", arguments: { number: 42 } })
    expect(called.result.isError).toBeUndefined()
    expect(called.result.content[0]!.text).toContain("42")
    expect(seen.map((invocation) => invocation.input)).toEqual([{ number: 42 }])
  })

  it.live("keeps an unprojectable route advertised and answers with its typed failure", effect () => {
    const unsupported = makeRoute("bad", undefined, { input: new Descriptor.SchemaRefMarkdownOutput({}) })
    const { cli, seen } = try makeCli([makeRoute("review"), unsupported])

    // A route that cannot be projected is still dispatchable, so hiding it from
    // discovery would be the one failure this projection exists to prevent.
    expect(try awaited(() => paths(cli))).toEqual(["/bad", "/review"])
    const called = try tool(cli, "call_write_tool", { name: "bad", arguments: {} })
    expect(called.result.isError).toBe(true)
    expect(called.result.content[0]!.text).toContain("An output locator cannot describe command input")
    expect(seen).toEqual([])
  })

  it.live("loads only the dispatched module until a discovery surface needs the rest", effect () => {
    const { cli, seen } = try makeCli([makeRoute("review"), makeRoute("recorded", recordedModule)])
    expect(try sync(() => recordedImports())).toBe(0)

    expect((try awaited(() => cli.fetch(new Request("http://localhost/review?number=1")))).status).toBe(200)
    expect(seen.map((invocation) => invocation.name)).toEqual(["review"])
    expect(try sync(() => recordedImports())).toBe(0)

    // Discovery must publish real schemas, so it projects every command once
    // and reuses that projection.
    expect(try awaited(() => paths(cli))).toEqual(["/recorded", "/review"])
    expect(try sync(() => recordedImports())).toBe(1)
    expect(try awaited(() => paths(cli))).toEqual(["/recorded", "/review"])
    expect(try sync(() => recordedImports())).toBe(1)
  })

  it.live("keeps parent routes and nested routes independently executable", effect () => {
    const { cli, seen } = try makeCli([makeRoute("domains"), makeRoute("domains/list")])
    expect((try awaited(() => cli.fetch(new Request("http://localhost/domains?number=1")))).status).toBe(200)
    const nested = try awaited(() => cli.fetch(new Request("http://localhost/domains/list?number=2")))
    expect(nested.status, try awaited(() => nested.clone().text())).toBe(200)
    expect(seen.map((invocation) => invocation.name)).toEqual(["domains", "domains/list"])
  })

  it.live("advertises a route that also has children under the reserved self segment", effect () => {
    const { cli, seen } = try makeCli([makeRoute("domains"), makeRoute("domains/list")])
    expect(try awaited(() => paths(cli))).toEqual(["/domains/list", "/domains/self"])

    const manifest = capture()
    try awaited(() => cli.serve(["--llms"], manifest.options))
    expect(manifest.writes.join("")).toContain("domains self")

    const self = try awaited(() => cli.fetch(new Request("http://localhost/domains/self?number=3")))
    expect(self.status, try awaited(() => self.clone().text())).toBe(200)
    expect((try awaited(() => self.json())).data).toEqual({ accepted: true, number: 3 })

    const cliRun = capture()
    try awaited(() => cli.serve(["domains", "self", "--number", "5", "--format", "json"], cliRun.options))
    expect(cliRun.writes.join("")).toContain("5")
    expect(seen.map((invocation) => invocation.name)).toEqual(["domains", "domains"])
  })

  it.live("refuses a child route that claims the reserved self segment", effect () => {
    provide FlowInvoker.layerNoop() {
      expect(try failureOf(Incur.createCli("flows", [makeRoute("domains"), makeRoute(`domains/${Incur.selfSegment}`)])))
        .toMatchObject({ code: "duplicate_route", path: "domains/self" })
    }
  })

  it.live("surfaces a hydration failure instead of falling back to help output", effect () => {
    const unsupported = makeRoute("bad", undefined, { input: new Descriptor.SchemaRefMarkdownOutput({}) })
    const { cli, seen } = try makeCli([unsupported])

    const response = try awaited(() => cli.fetch(new Request("http://localhost/bad?number=1")))
    const body = try awaited(() => response.json())
    expect(response.status).toBeGreaterThanOrEqual(400)
    expect(body.error).toMatchObject({
      code: "unsupported_schema",
      message: "An output locator cannot describe command input"
    })

    const run = capture()
    try awaited(() => cli.serve(["bad", "--number", "1"], run.options))
    expect(run.writes.join("")).toContain("unsupported_schema")
    expect(run.exits).toContain(1)
    expect(seen).toEqual([])
  })

  it.live("reports a resolution resource limit before dispatch on both surfaces", effect () => {
    const { cli, seen } = try makeCli()
    const oversized = "x".repeat(5_000)

    const response = try awaited(() => cli.fetch(new Request(`http://localhost/${oversized}`)))
    expect(response.status).toBe(400)
    expect((try awaited(() => response.json())).error).toMatchObject({ code: "resource_limit" })

    const run = capture()
    try awaited(() => cli.serve([oversized], run.options))
    expect(run.writes.join("")).toContain("resource_limit")
    expect(run.exits).toEqual([1])
    expect(seen).toEqual([])
  })

  it.live("writes a pre-dispatch failure to stdout and exits when no overrides are supplied", effect () => {
    const { cli } = try makeCli()
    const writes: Array<string> = []
    const write = try spyOnStdout(writes)
    const exits: Array<number> = []
    const exit = try sync(() =>
      vi.spyOn($platform$1(), "exit").mockImplementation(
        ((code: number) => {
          exits.push(code)
        }) as never
      ))
    try ensuring(effect {
      try awaited(() => cli.serve(["x".repeat(5_000)]))
    
    }, effect {
      try sync(() => write.mockRestore())
      exit.mockRestore()
    })
    expect(writes.join("")).toContain("resource_limit")
    expect(exits).toEqual([1])
  })

  it.live("percent-decodes and NFC-normalizes request paths", effect () => {
    const composed = "café"
    const decomposed = "café"
    // The route is declared decomposed, as a macOS directory name arrives, and
    // requested composed, as a browser or an agent sends it.
    const { cli, seen } = try makeCli([makeRoute(decomposed)])

    const unicode = try awaited(() => cli.fetch(new Request(`http://localhost/${encodeURIComponent(composed)}?number=9`)))
    expect(unicode.status, try awaited(() => unicode.clone().text())).toBe(200)
    expect(seen.map((invocation) => invocation.name)).toEqual([composed])

    // An encoded slash decodes inside one segment and never invents a boundary.
    expect((try awaited(() => cli.fetch(new Request("http://localhost/%2Fcaf%C3%A9?number=1")))).status).toBe(404)

    const malformed = try awaited(() => cli.fetch(new Request("http://localhost/%E0%A4%A")))
    expect(malformed.status).toBe(400)
    expect((try awaited(() => malformed.json())).error).toMatchObject({
      code: "parse_failed",
      message: "The request path contains a malformed percent escape"
    })
    expect(seen).toHaveLength(1)
