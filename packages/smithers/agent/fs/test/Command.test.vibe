import { afterEach, describe, expect, it, vi } from "@effect/vitest"
import * as Command from "../src/Command.vibe"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import * as CommandLine from "../src/internal/CommandLine.vibe"
import * as SchemaBridge from "../src/internal/SchemaBridge.vibe"
import * as Route from "../src/Route.vibe"
import { failureOf, makeRoute } from "./helpers.vibe"

const encoder = new TextEncoder()

/**
 * Builds a command of exactly `totalBytes` UTF-8 bytes from `tokenCount`
 * space-separated tokens. Each token repeats a three-byte and a four-byte
 * character, so the command stays far below `maximumCommandBytes` when measured
 * as UTF-16 code units and every token stays far below `maximumTokenLength`.
 * That leaves the aggregate byte bound as the only bound the fixture can reach.
 */
const multibyteCommand = (totalBytes: number, tokenCount: number): string => {
  const contentBytes = totalBytes - (tokenCount - 1)
  const runs = Math.floor(contentBytes / (7 * tokenCount))
  const filler = "x".repeat(contentBytes - 7 * runs * tokenCount)
  return Array.from(
    { length: tokenCount },
    (_, index) => `${"漢𝄞".repeat(runs)}${index === tokenCount - 1 ? filler : ""}`
  ).join(" ")
}

describe("Command", () => {
  it.effect.each([0, 4_097, 16_384])("parses a %i-character flag value through the public surface", effect (length) => {
    const surface = try Command.make([makeRoute("review")])
    const value = "a".repeat(length)
    const parsed = try surface.parse(`review --tags "${value}" --tags a --number 1`)
    expect(parsed.input).toEqual({ tags: [value, "a"], number: 1 })
    expect(parsed.argv).toEqual(["review", "--tags", value, "--tags", "a", "--number", "1"])
  })

  it.effect("preserves command-token and route-name errors through the public surface", effect () => {
    const surface = try Command.make([makeRoute("review")])
    for (
      const [command, method, description] of [
        [
          `review --tags ${"a".repeat(CommandLine.maximumTokenLength + 1)} --tags a --number 1`,
          "CommandLine.lex",
          `A command token may contain at most ${CommandLine.maximumTokenLength} characters`
        ],
        [
          "a".repeat(Route.maximumRouteNameLength + 1),
          "CommandTree.resolve",
          "The command name exceeds its resource bounds"
        ]
      ] as const
    ) {
      expect(try failureOf(surface.parse(command))).toMatchObject({
        code: "resource_limit",
        method,
        description
      })
    }
  })

  it.effect("lexes quotes and escapes before parsing flags", effect () => {
    const argv = try CommandLine.lex(
      "review --title='fix bug' --number=4821 --tag one --tag=two --no-draft -- --literal value\\ with\\ spaces"
    )
    expect(argv).toEqual([
      "review",
      "--title=fix bug",
      "--number=4821",
      "--tag",
      "one",
      "--tag=two",
      "--no-draft",
      "--",
      "--literal",
      "value with spaces"
    ])
    expect(try CommandLine.parseFlags(argv.slice(1))).toEqual({
      args: ["--literal", "value with spaces"],
      options: {
        title: "fix bug",
        number: "4821",
        tag: ["one", "two"],
        draft: false
      }
    })
  })

  it.effect("keeps single-quoted text literal and honours escapes elsewhere", effect () => {
    expect(try CommandLine.lex("x 'a\\nb' 'C:\\path'")).toEqual([
      "x",
      "a\\nb",
      "C:\\path"
    ])
    expect(try CommandLine.lex("\"a\\\"b\"")).toEqual(["a\"b"])
    expect(try CommandLine.lex("a\\'b")).toEqual(["a'b"])
  })

  it.effect("does not evaluate shell syntax", effect () => {
    const argv = try CommandLine.lex("review '$HOME' \"$(whoami)\" `uname`")
    expect(argv).toEqual(["review", "$HOME", "$(whoami)", "`uname`"])
  })

  it.effect("reports unterminated quotes as parse failures", effect () => {
    expect((try failureOf(CommandLine.lex("review 'unterminated"))).code).toBe("parse_failed")
  })

  it.effect("uses null-prototype option storage and refuses prototype-sensitive names", effect () => {
    const parsed = try CommandLine.parseFlags([
      "--safe=one",
      "--safe",
      "two",
      "--safe=three",
      "--no-draft",
      "positional"
    ])
    expect(parsed).toEqual({
      args: ["positional"],
      options: { safe: ["one", "two", "three"], draft: false }
    })
    expect(Object.getPrototypeOf(parsed.options)).toBeNull()
    expect(Object.isFrozen(parsed.options)).toBe(true)

    for (
      const argv of [
        ["--constructor=secret"],
        ["--__proto__", "secret"],
        ["--no-constructor"],
        ["--prototype"],
        ["--=true"],
        ["--bad.name=x"]
      ]
    ) {
      const error = try failureOf(CommandLine.parseFlags(argv))
      expect(error.code).toBe("parse_failed")
      expect(JSON.stringify(error)).not.toContain("secret")
    }
  })

  it.effect("handles empty tokens and trailing escapes without shell evaluation", effect () => {
    expect(try CommandLine.lex("review \"\" tail\\")).toEqual(["review", "", "tail\\"])
    expect(try CommandLine.lex("   ")).toEqual([])
    expect(try CommandLine.lex("  review  ")).toEqual(["review"])
  })

  it.effect("enforces command, token, and argv resource bounds", effect () => {
    expect(try CommandLine.lex("x".repeat(CommandLine.maximumTokenLength))).toHaveLength(1)
    for (
      const command of [
        "x".repeat(CommandLine.maximumTokenLength + 1),
        `${"x".repeat(CommandLine.maximumTokenLength + 1)} `,
        "x".repeat(CommandLine.maximumCommandBytes + 1),
        "\ud800"
      ]
    ) {
      expect(try exit(CommandLine.lex(command)) is Exit.Failure).toBe(true)
    }

    const exact = Array.from({ length: CommandLine.maximumCommandTokens }, () => "x").join(" ")
    expect(try CommandLine.lex(exact)).toHaveLength(CommandLine.maximumCommandTokens)
    const tooMany = `${exact} x`
    expect(try exit(CommandLine.lex(tooMany)) is Exit.Failure).toBe(true)

    const hostile = try sync((target) =>
      new Proxy(target, {
        ownKeys: () => {
          throw new Error("trap")
        }
      }), ["--safe=x"])
    expect(try exit(CommandLine.parseFlags(hostile)) is Exit.Failure).toBe(true)
  })

  it.effect("bounds command bytes independently of the token bounds", effect () => {
    const tokenCount = 8
    const exact = multibyteCommand(CommandLine.maximumCommandBytes, tokenCount)
    const overBy1 = multibyteCommand(CommandLine.maximumCommandBytes + 1, tokenCount)

    // Both fixtures must be reachable by the byte bound alone: the token count
    // and every token length stay inside their own bounds, and the UTF-16 length
    // stays below the byte bound so a length-for-bytes guard admits both.
    for (const command of [exact, overBy1]) {
      const tokens = command.split(" ")
      expect(tokens).toHaveLength(tokenCount)
      expect(tokenCount).toBeLessThan(CommandLine.maximumCommandTokens)
      expect(Math.max(...tokens.map((token) => token.length))).toBeLessThan(CommandLine.maximumTokenLength)
      expect(command.length).toBeLessThan(CommandLine.maximumCommandBytes)
    }
    expect(encoder.encode(exact).byteLength).toBe(CommandLine.maximumCommandBytes)
    expect(encoder.encode(overBy1).byteLength).toBe(CommandLine.maximumCommandBytes + 1)

    expect(try CommandLine.lex(exact)).toEqual(exact.split(" "))

    expect(try failureOf(CommandLine.lex(overBy1))).toMatchObject({
      code: "resource_limit",
      method: "CommandLine.lex",
      description: `A command may contain at most ${CommandLine.maximumCommandBytes} UTF-8 bytes`
    })
  })

  it.effect("classifies output schema failures as encoding failures", effect () => {
    expect((try failureOf(SchemaBridge.encodeOutput(Schema.Number, "not-a-number"))).code).toBe("encode_failed")
  })
})

describe("Command.call decoded boundary", () => {
  afterEach(() => vi.restoreAllMocks())

  effect function surfaceFor(input: Schema.Top, output: Schema.Top) {
    const flow = { capabilities: [], effects: undefined, name: "scalar", input, output } as const
    vi.spyOn(Route, "load").mockImplementation(effect () => flow)
    return try Command.make([makeRoute("scalar")])
  }

  it.effect("returns decoded output from call and encoded output from execute", effect () => {
    const surface = try surfaceFor(Schema.Number, Schema.NumberFromString)
    provide FlowInvoker.layerNoop({ invoke: effect () => 42 }) {
      expect(try surface.call("scalar", 1)).toBe(42)
      expect(try surface.execute("scalar 1")).toBe("42")
    }
  })

  it.effect("accepts decoded transforming input in call and encoded input in execute", effect () => {
    const surface = try surfaceFor(Schema.NumberFromString, Schema.Number)
    const invoke = vi.fn<FlowInvoker.FlowInvoker["invoke"]>(effect ({ input }) => input)
    provide FlowInvoker.layerNoop({ invoke }) {
      expect(try surface.call("scalar", 42)).toBe(42)
      expect(try surface.execute("scalar 42")).toBe(42)
      expect(invoke.mock.calls.map(([invocation]) => invocation.input)).toEqual([42, 42])
      expect(try exit(surface.call("scalar", "42")) is Exit.Failure).toBe(true)
    }
    expect(invoke).toHaveBeenCalledTimes(2)
  })

  it.effect("refuses scalar tokens that execute would otherwise drop", effect () => {
    const surface = try surfaceFor(Schema.Number, Schema.NumberFromString)
    const invoke = vi.fn<FlowInvoker.FlowInvoker["invoke"]>(effect () => 42)
    provide FlowInvoker.layerNoop({ invoke }) {
      for (const command of ["scalar 1 --typo x", "scalar 1 2", "scalar 1 --input 2", "scalar --input 1 --typo x"]) {
        expect(try failureOf(surface.execute(command)), command).toMatchObject({ code: "decode_failed" })
      }
      expect(invoke).not.toHaveBeenCalled()
      expect(try surface.execute("scalar --input 1")).toBe("42")
    }
  })

  it.effect("refuses unsafe decoded input before loading or invoking", effect () => {
    const surface = try Command.make([makeRoute("review")])
    const invoke = vi.fn<FlowInvoker.FlowInvoker["invoke"]>(effect ({ input }) => input)
    let getterCalls = 0
    const accessor = Object.defineProperty({}, "number", {
      enumerable: true,
      get: () => ++getterCalls
    })
    provide FlowInvoker.layerNoop({ invoke }) {
      for (const input of [accessor, { number: NaN }, { number: 1, tags: ["x".repeat(65_537)] }]) {
        expect(try failureOf(surface.call("review", input as never))).toMatchObject({
          code: "decode_failed",
          method: "Command.call"
        })
      }
    }
    expect(getterCalls).toBe(0)
    expect(invoke).not.toHaveBeenCalled()
  })

  it.effect("refuses unsafe decoded output after invocation", effect () => {
    const surface = try surfaceFor(Schema.Number, Schema.Number)
    for (const output of [NaN, Infinity]) {
      provide FlowInvoker.layerNoop({ invoke: effect () => output }) {
        expect(try failureOf(surface.call("scalar", 1))).toMatchObject({
          code: "decode_failed",
          method: "Command.call"
        })
      }
    }
  })

  it.effect("refuses oversized and accessor output without reading its getter", effect () => {
    const surface = try surfaceFor(Schema.Struct({ value: Schema.String }), Schema.Struct({ value: Schema.String }))
    let getterCalls = 0
    const accessor = Object.defineProperty({}, "value", {
      enumerable: true,
      get: () => {
        getterCalls++
        return "secret"
      }
    })
    for (const output of [accessor, { value: "x".repeat(65_537) }]) {
      provide FlowInvoker.layerNoop({ invoke: effect () => output }) {
        expect(try exit(surface.call("scalar", { value: "ok" })) is Exit.Failure).toBe(true)
      }
    }
    expect(getterCalls).toBe(0)
  })

  it.effect("detaches input before pending route loading", effect () => {
    const flow = {
      capabilities: [],
      effects: undefined,
      name: "scalar",
      input: Schema.Struct({ number: Schema.Number }),
      output: Schema.Number
    } as const
    const loading = try Deferred.make<void>()
    const release = try Deferred.make<typeof flow>()
    vi.spyOn(Route, "load").mockImplementation(effect () => {
      try loading.succeed(undefined)
      return try release.await()
    })
    const surface = try Command.make([makeRoute("scalar")])
    const invoke = vi.fn<FlowInvoker.FlowInvoker["invoke"]>(effect ({ input }) => (input as { number: number }).number)
    const input: { mutable number: number } = { number: 1 }
    provide FlowInvoker.layerNoop({ invoke }) {
      const pending = fork surface.call("scalar", input)
      try loading.await()
      input.number = 2
      try release.succeed(flow)
      expect(join pending).toBe(1)
    }
    expect(invoke).toHaveBeenCalledWith(expect.objectContaining({ input: { number: 1 } }))
  })

  it.effect("preserves native decoded values on both sides of call", effect () => {
    const surface = try surfaceFor(Schema.DateFromString, Schema.DateFromString)
    const date = new Date("2026-01-01T00:00:00.000Z")
    provide FlowInvoker.layerNoop({ invoke: effect ({ input }) => input }) {
      const output = try surface.call("scalar", date)
      expect(output).toBeInstanceOf(Date)
      expect(output).toEqual(date)
    }
  })

  it.effect("rejects invalid decoded output with a sanitized typed error", effect () => {
    const surface = try surfaceFor(Schema.Number, Schema.NumberFromString)
    provide FlowInvoker.layerNoop({ invoke: effect () => "TOP-SECRET" }) {
      const error = try failureOf(surface.call("scalar", 1))
      expect(error).toMatchObject({ code: "decode_failed", method: "Command.call" })
      expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
    }
  })
})
