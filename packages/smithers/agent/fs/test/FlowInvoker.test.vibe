import { describe, expect, it, vi } from "@effect/vitest"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import visibleFlow from "./fixtures/command/visible.ts"
import { failureOf } from "./helpers.vibe"

const invocation = Object.freeze({ name: "visible", flow: visibleFlow, input: Object.freeze({ number: 1 }) })

describe("FlowInvoker", () => {
  it.effect("constructs a frozen service from an own data function", effect () => {
    const seen: Array<FlowInvoker.Invocation> = []
    const service = FlowInvoker.make({
      invoke: effect (input) => {
        seen.push(input)
        return "done"
      }
    })

    expect(Object.isFrozen(service)).toBe(true)
    expect(try service.invoke(invocation)).toBe("done")
    expect(seen).toEqual([invocation])
  })

  it.effect("fails closed without retaining invocation data", effect () => {
    const service = FlowInvoker.makeNoop()
    const error = try failureOf(service.invoke({ ...invocation, name: "TOP-SECRET" }))

    expect(Object.isFrozen(service)).toBe(true)
    expect(error).toMatchObject({ code: "invocation_unavailable", method: "FlowInvoker.invoke" })
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  })

  it.effect("accepts a valid override and provides it through the layer", effect () => {
    // The type argument makes the mocked lambda an invoker, which returns a program.
    const override = vi.fn<FlowInvoker.FlowInvoker["invoke"]>(effect () => "overridden")
    const service = FlowInvoker.makeNoop({ invoke: override })
    const result = do {
      provide FlowInvoker.FlowInvoker = service {
        try FlowInvoker.FlowInvoker.invoke(invocation)
      }
    }
    const layered = do {
      provide FlowInvoker.layerNoop({ invoke: override }) {
        try FlowInvoker.FlowInvoker.invoke(invocation)
      }
    }

    expect(result).toBe("overridden")
    expect(layered).toBe("overridden")
    expect(override).toHaveBeenCalledTimes(2)
  })
})
