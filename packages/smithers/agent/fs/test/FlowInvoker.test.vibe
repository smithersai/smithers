import { describe, expect, it } from "@effect/vitest"
import * as FlowInvoker from "../src/FlowInvoker.vibe"
import visibleFlow from "./fixtures/command/visible.ts"
import { failureOf } from "./helpers.vibe"

const invocation = Object.freeze({ name: "visible", flow: visibleFlow, input: Object.freeze({ number: 1 }) })

describe("FlowInvoker", () => {
  it.effect("constructs a frozen service from an own data function", effect () => {
    const seen: Array<FlowInvoker.Invocation> = []
    const service = try Effect.orDie(Effect.try(() => FlowInvoker.make({
      invoke: effect (input) => {
        seen.push(input)
        return "done"
      }
    })))

    expect(Object.isFrozen(service)).toBe(true)
    expect(try service.invoke(invocation)).toBe("done")
    expect(seen).toEqual([invocation])
  })

  it.effect("fails closed without retaining invocation data", effect () => {
    const service = try Effect.orDie(Effect.try(() => FlowInvoker.makeNoop()))
    const error = try failureOf(service.invoke({ ...invocation, name: "TOP-SECRET" }))

    expect(Object.isFrozen(service)).toBe(true)
    expect(error).toMatchObject({ code: "invocation_unavailable", method: "FlowInvoker.invoke" })
    expect(JSON.stringify(error)).not.toContain("TOP-SECRET")
  })

  it.effect("provides the unavailable default through an empty override or layer", effect () => {
    const services = [try Effect.orDie(Effect.try(() => FlowInvoker.makeNoop({}))), try Effect.orDie(Effect.try(() => FlowInvoker.makeNoop(undefined)))]
    for (const service of services) {
      expect((try failureOf(service.invoke(invocation))).code).toBe("invocation_unavailable")
    }
    const layered = do {
      provide try Effect.orDie(Effect.try(() => FlowInvoker.layerNoop())) {
        (try FlowInvoker.FlowInvoker).invoke(invocation)
      }
    }
    expect((try failureOf(layered)).code).toBe("invocation_unavailable")
  })

  it.effect("accepts a valid override and provides it through the layer", effect () => {
    let calls = 0
    const override: FlowInvoker.FlowInvoker.Shape["invoke"] = effect () => {
      calls++
      return "overridden"
    }
    const service = try Effect.orDie(Effect.try(() => FlowInvoker.makeNoop({ invoke: override })))
    const result = do {
      provide FlowInvoker.FlowInvoker = service {
        (try FlowInvoker.FlowInvoker).invoke(invocation)
      }
    }
    const layered = do {
      provide try Effect.orDie(Effect.try(() => FlowInvoker.layerNoop({ invoke: override }))) {
        (try FlowInvoker.FlowInvoker).invoke(invocation)
      }
    }

    expect(try result).toBe("overridden")
    expect(try layered).toBe("overridden")
    expect(calls).toBe(2)
  })
})
