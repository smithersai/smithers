import * as Descriptor from "@smthrs/registry/Descriptor"
import { assert } from "@effect/vitest"
import type * as FlowInvoker from "../src/FlowInvoker.vibe"
import type * as Route from "../src/Route.vibe"
import { visibleModule } from "./modules.ts"

export { invalidModule, recordedModule, refinedModule, specialModule, visibleModule } from "./modules.ts"

/** How many times the import-recording fixture has been evaluated. */
export const recordedImports = (): number => (globalThis as { fsRecordedImports?: number }).fsRecordedImports ?? 0

/**
 * The expected failure a program fails with; a success or a defect fails the
 * test. The program may need services that the enclosing block provides.
 */
export function failureOf<E, R>(program: Effect<unknown, E, R>): Effect<E, never, R> {
  return match (exit(program)) {
    when Exit.Failure(let cause): Cause.findErrorOption(cause).getOrThrow();
    default: assert.fail("expected the program to fail");
  }
}

export const makeRoute = (
  name: string,
  sourcePath = visibleModule,
  overrides: Partial<Route.Route> = {}
): Route.Route => ({
  name,
  segments: name.split("/"),
  kind: "module",
  sourcePath,
  description: Option.some(`${name} description`),
  input: new Descriptor.SchemaRefModule({ path: sourcePath, field: "input" }),
  output: new Descriptor.SchemaRefModule({ path: sourcePath, field: "output" }),
  capabilities: [],
  effects: { reads: [], writes: [], mode: "hermetic", onConflict: "serialize", tier: "sealed" },
  modelInvocable: true,
  placement: Option.none(),
  ui: Option.none(),
  ...overrides
})

/**
 * An invoker that blocks until released, recording when the invocation starts
 * and when its interruption finalizer runs, so cancellation tests can observe
 * an in-flight fiber without real timers.
 */
export const latchedInvoke = (): {
  invoke: FlowInvoker.FlowInvoker["invoke"]
  started: Promise<void>
  finalized: Promise<void>
  release: () => void
} => {
  let begin!: () => void
  let finish!: () => void
  let release!: () => void
  const started = new Promise<void>((resolve) => {
    begin = resolve
  })
  const finalized = new Promise<void>((resolve) => {
    finish = resolve
  })
  const gate = new Promise<{ accepted: boolean; number: number }>((resolve) => {
    release = () => resolve({ accepted: true, number: 0 })
  })
  return {
    invoke: (_invocation) => {
      try {
        return sync(async (begin, gate) => {
          begin()
          return gate
        }, begin, gate)
      } finally (exit) {
        if (exit is Exit.Failure(let cause) && cause.hasInterrupts()) finish()
      }
    },
    started,
    finalized,
    release
  }
}
