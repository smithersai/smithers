import * as NodeFileSystem from "@effect/platform-node/NodeFileSystem"
import * as NodePath from "@effect/platform-node/NodePath"
import { expect, layer } from "@effect/vitest"
import * as FileRouter from "../src/FileRouter.vibe"
import { routerRoot as root } from "./fixtureRoots.ts"
import { failureOf } from "./helpers.vibe"

const platformLayer = Layer.merge(NodeFileSystem.layer, NodePath.layer)

const fixtureSource = `import * as Schema from "effect/Schema"
import { Flow } from "@smthrs/core"
export default ({ capabilities: [], effects: undefined, input: Schema.Void, output: Schema.Unknown,  name: "fixture", description: "fixture"  })
`

effect function scan() {
  return try FileRouter.scan({ root })
}

layer(platformLayer)("FileRouter", (it) => {
  it.effect("routes directory entries by path without evaluating module bodies", effect () => {
    const path = try Path()
    const result = try scan()

    expect(result.routes.map((route) => route.name)).toEqual([
      "directives/panel",
      "directives/sandboxed",
      "domains",
      "domains/list",
      "mixed",
      "review",
      "skills/demo"
    ])
    expect(result.routes.find((route) => route.name === "review")?.segments).toEqual(["review"])
    expect(result.routes.find((route) => route.name === "domains/list")?.segments).toEqual(["domains", "list"])
    expect(result.routes.find((route) => route.name === "review")?.sourcePath).toBe(
      path.join(root, "review", "flow.ts")
    )
  })

  it.effect("preserves registry entry precedence and diagnostics", effect () => {
    const path = try Path()
    const result = try scan()

    expect(result.routes.find((route) => route.name === "mixed")?.kind).toBe("module")
    expect(result.routes.find((route) => route.name === "mixed")?.sourcePath).toBe(path.join(root, "mixed", "flow.ts"))
    expect(result.warnings).toEqual(expect.arrayContaining([
      expect.objectContaining({ code: "multiple_entry_files", path: path.join(root, "mixed") }),
      expect.objectContaining({ code: "root_level_entry", path: path.join(root, "flow.ts") }),
      expect.objectContaining({ code: "name_field_ignored", path: path.join(root, "review", "flow.ts") })
    ]))
  })

  it.effect("records UI companions without routing companions or colocated tests", effect () => {
    const path = try Path()
    const result = try scan()
    const review = result.routes.find((route) => route.name === "review")

    expect(review?.ui).toEqual(Option.some(path.join(root, "review", "ui.tsx")))
    expect(result.routes.some((route) => path.basename(route.sourcePath) === "ui.tsx")).toBe(false)
    expect(result.routes.some((route) => path.basename(route.sourcePath) === "flow.test.ts")).toBe(false)
  })

  it.effect("routes skills as metadata while leaving skill parsing lazy", effect () => {
    const result = try scan()
    const skill = result.routes.find((route) => route.name === "skills/demo")

    expect(skill).toMatchObject({ kind: "skill", sourcePath: expect.stringMatching(/SKILL\.md$/) })
  })

  it.effect("is deterministic", effect () => {
    const first = try scan()
    const second = try scan()

    expect(second).toEqual(first)
  })

  it.effect("resolves a relative root once and returns absolute immutable routes", effect () => {
    const path = try Path()
    const config: { mutable root: string } = { root: path.relative(path.resolve(), root) }
    // The scan starts at once, as runPromise would start it, so the root is
    // read before the caller rewrites its config.
    const pending = fork(FileRouter.scan(config), { startImmediately: true })
    config.root = "/"
    const result = join pending

    expect(result.routes.length).toBeGreaterThan(0)
    expect(result.routes.every((route) => path.isAbsolute(route.sourcePath))).toBe(true)
    expect(Object.isFrozen(result)).toBe(true)
    expect(Object.isFrozen(result.routes)).toBe(true)
  })

  it.effect("preserves a literal backslash segment on POSIX", effect () => {
    const fs = try FileSystem()
    const path = try Path()
    if (path.sep !== "/") return
    const temporary = try fs.makeTempDirectoryScoped({ prefix: "smithers-fs-router-" })
    try fs.makeDirectory(`${temporary}/a\\b`, { recursive: true })
    try fs.makeDirectory(`${temporary}/a/b`, { recursive: true })
    try fs.writeFileString(`${temporary}/a\\b/flow.ts`, fixtureSource)
    try fs.writeFileString(`${temporary}/a/b/flow.ts`, fixtureSource)
    const result = try FileRouter.scan({ root: temporary })
    expect(result.routes.map((route) => route.name)).toEqual(["a/b", "a\\b"])
  })

  it.effect("keeps scanning when one flow declares an empty description", effect () => {
    const fs = try FileSystem()
    const path = try Path()
    const temporary = try fs.makeTempDirectoryScoped({ prefix: "smithers-fs-empty-description-" })
    const source = effect (description: string) =>
      `import * as Schema from "effect/Schema"
export default ({ input: Schema.Void, output: Schema.Unknown, description: ${JSON.stringify(description)} })
`
    try fs.makeDirectory(path.join(temporary, "blank"), { recursive: true })
    try fs.makeDirectory(path.join(temporary, "named"), { recursive: true })
    try fs.writeFileString(path.join(temporary, "blank", "flow.ts"), try source(""))
    try fs.writeFileString(path.join(temporary, "named", "flow.ts"), try source("A named flow"))
    const result = try FileRouter.scan({ root: temporary })
    // Discovery accepts an empty literal, so one blank description must not
    // fail the scan for every sibling route.
    expect(result.routes.map((route) => [route.name, route.description])).toEqual([
      ["blank", Option.none()],
      ["named", Option.some("A named flow")]
    ])
  })

  it.effect("preserves discovery error codes and refuses hostile config", effect () => {
    expect((try failureOf(FileRouter.scan({ root: "/definitely/missing/smithers-flows" }))).code).toBe("root_missing")

    let called = false
    const config = Object.defineProperty({}, "root", {
      enumerable: true,
      get: () => {
        called = true
        return root
      }
    })
    expect((try failureOf(FileRouter.scan(config as FileRouter.ScanConfig))).code).toBe("invalid_root")
    expect(called).toBe(false)
  })
  it.effect("never routes a flow or UI companion whose real path leaves the root", effect () => {
    const fs = try FileSystem()
    const path = try Path()
    const temporary = try fs.makeTempDirectoryScoped({ prefix: "smithers-fs-escape-" })
    const flows = path.join(temporary, "flows")
    const outside = path.join(temporary, "outside")
    try fs.makeDirectory(path.join(flows, "inside"), { recursive: true })
    try fs.makeDirectory(path.join(flows, "linkedui"), { recursive: true })
    try fs.makeDirectory(path.join(outside, "escape"), { recursive: true })
    try fs.writeFileString(path.join(flows, "inside", "flow.ts"), fixtureSource)
    try fs.writeFileString(path.join(outside, "escape", "flow.ts"), fixtureSource)
    try fs.writeFileString(path.join(outside, "loose.ts"), fixtureSource)
    try fs.writeFileString(path.join(outside, "ui.tsx"), "export default null\n")
    try fs.symlink(path.join(outside, "escape"), path.join(flows, "dir"))
    try fs.makeDirectory(path.join(flows, "file"))
    try fs.symlink(path.join(outside, "loose.ts"), path.join(flows, "file", "flow.ts"))
    try fs.writeFileString(path.join(flows, "linkedui", "flow.ts"), fixtureSource)
    try fs.symlink(path.join(outside, "ui.tsx"), path.join(flows, "linkedui", "ui.tsx"))

    const result = try FileRouter.scan({ root: flows })

    expect(result.routes.map((route) => route.name)).toEqual(["inside", "linkedui"])
    expect(result.routes.find((route) => route.name === "linkedui")!.ui.isNone()).toBe(true)
    expect(result.warnings).toEqual(expect.arrayContaining([
      expect.objectContaining({ code: "outside_root", path: path.join(flows, "dir") }),
      expect.objectContaining({ code: "outside_root", path: path.join(flows, "file", "flow.ts") })
    ]))
  })
})
