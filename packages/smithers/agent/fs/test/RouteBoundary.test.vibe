import { throwingProxy } from "./modules.ts"
import * as Descriptor from "@smthrs/registry/Descriptor"
import { describe, expect, it, vi } from "@effect/vitest"
import * as Route from "../src/Route.vibe"
import { failureOf, invalidModule, makeRoute, visibleModule } from "./helpers.vibe"

describe("Route boundary", () => {
  it.effect("loads a canonical tagged flow and projects its schemas", effect () => {
    const modulePath = new URL("./fixtures/three-projections/flows/review/flow.ts", import.meta.url).pathname
    const loaded = try Route.load(makeRoute("review", modulePath))
    expect(loaded.name).toBe("review")
    expect(loaded.description).toBeUndefined()
    const canonical = try promise(async () => (await import("./fixtures/three-projections/flows/review/flow.ts")).default)
    expect(loaded.input).toBe(canonical.payloadSchema)
    expect(loaded.output).toBe(canonical.successSchema)
    expect(try Schema.decodeUnknownEffect(canonical.payloadSchema)({ number: 7 })).toEqual({ number: 7 })
    expect(try Schema.decodeUnknownEffect(canonical.successSchema)({ accepted: true, number: 7 })).toEqual({
      accepted: true,
      number: 7
    })
  })

  it.effect("copies and freezes complete route metadata", effect () => {
    const source = makeRoute("review", visibleModule, {
      capabilities: ["fs:read:**"],
      effects: {
        reads: ["src/**"],
        writes: ["dist/**"],
        mode: "expected",
        onConflict: "lane",
        tier: "compensable"
      },
      input: new Descriptor.SchemaRefInline({
        document: { type: "object", properties: { value: { type: "string" } } }
      }),
      output: new Descriptor.SchemaRefNone({}),
      placement: Option.some("sandbox"),
      ui: Option.some("/absolute/ui.tsx")
    })
    const snapshot = try Route.snapshot(source)
    ;(source.capabilities as Array<string>)[0] = "changed"
    ;(source.effects.reads as Array<string>)[0] = "changed"

    expect(snapshot).toMatchObject({
      name: "review",
      capabilities: ["fs:read:**"],
      effects: { reads: ["src/**"], writes: ["dist/**"], mode: "expected", onConflict: "lane" },
      modelInvocable: true
    })
    expect(Object.isFrozen(snapshot)).toBe(true)
    expect(Object.isFrozen(snapshot.effects)).toBe(true)
    expect(Object.isFrozen(snapshot.capabilities)).toBe(true)
  })

  it.effect("copies every schema locator variant", effect () => {
    const refs: ReadonlyArray<Descriptor.SchemaRef> = [
      new Descriptor.SchemaRefMarkdownArgs({}),
      new Descriptor.SchemaRefMarkdownOutput({}),
      new Descriptor.SchemaRefNone({}),
      new Descriptor.SchemaRefModule({ path: visibleModule, field: "input" }),
      new Descriptor.SchemaRefInline({ document: { type: "string" } })
    ]
    for (const [index, input] of refs.entries()) {
      const output = refs[(index + 1) % refs.length]!
      const snapshot = try Route.snapshot(makeRoute(`route-${index}`, visibleModule, { input, output }))
      expect(snapshot.input).not.toBe(input)
      expect(snapshot.input._tag).toBe(input._tag)
      expect(snapshot.output._tag).toBe(output._tag)
    }
  })

  it.effect("rejects malformed top-level fields without invoking accessors", effect () => {
    const base = makeRoute("review")
    const malformed: ReadonlyArray<Route.Route> = [
      { ...base, name: "different" },
      { ...base, segments: [] },
      { ...base, segments: ["."] },
      { ...base, segments: ["a/b"] },
      { ...base, segments: ["x".repeat(Route.maximumSegmentLength + 1)] },
      { ...base, kind: "other" as never },
      { ...base, sourcePath: "relative.ts" },
      { ...base, sourcePath: "file:relative.ts" },
      { ...base, sourcePath: "\ud800" },
      { ...base, description: "not-an-option" as never },
      { ...base, description: Option.some("") },
      { ...base, capabilities: [""] },
      { ...base, modelInvocable: "yes" as never },
      { ...base, placement: "not-an-option" as never },
      { ...base, placement: Option.some("elsewhere" as never) },
      { ...base, ui: Option.some("") }
    ]
    for (const route of malformed) expect((try failureOf(Route.snapshot(route))).code).toBe("invalid_route")

    const getter = vi.fn(() => "review")
    const accessor = Object.defineProperty({ ...base }, "name", { enumerable: true, get: getter })
    expect((try failureOf(Route.snapshot(accessor))).code).toBe("invalid_route")
    expect(getter).not.toHaveBeenCalled()

    const hostileOption = sync((target) => new Proxy(target, {
      has: () => {
        $raise(new Error("trap"))
      }
    }), {})
    expect((try failureOf(Route.snapshot({ ...base, description: hostileOption as never }))).code).toBe("invalid_route")
    expect((try failureOf(Route.snapshot({ ...base, placement: hostileOption as never }))).code).toBe("invalid_route")
  })

  it.effect("rejects malformed schema locators and effect declarations", effect () => {
    const base = makeRoute("review")
    const badRefs = [
      null,
      [],
      {},
      { _tag: "Unknown" },
      { _tag: "Module", path: "", field: "input" },
      { _tag: "Module", path: visibleModule, field: "other" },
      { _tag: "Inline", document: { value: undefined } },
      Object.defineProperty({ _tag: "None" }, "extra", { value: true, enumerable: true })
    ]
    for (const input of badRefs) {
      expect((try failureOf(Route.snapshot({ ...base, input: input as never }))).code).toBe("invalid_route")
    }

    const nullPrototype = Object.assign(Object.create(null), { _tag: "None" })
    expect((try Route.snapshot({ ...base, input: nullPrototype })).input._tag).toBe("None")
    const inherited = Object.create({ _tag: "None" })
    expect((try failureOf(Route.snapshot({ ...base, input: inherited }))).code).toBe("invalid_route")
    const tagGetter = vi.fn(() => "None")
    const accessorTag = Object.defineProperty({}, "_tag", { enumerable: true, get: tagGetter })
    expect((try failureOf(Route.snapshot({ ...base, input: accessorTag as never }))).code).toBe("invalid_route")
    expect(tagGetter).not.toHaveBeenCalled()
    const pathGetter = vi.fn(() => visibleModule)
    const accessorPath = Object.defineProperty({ _tag: "Module", field: "input" }, "path", {
      enumerable: true,
      get: pathGetter
    })
    expect((try failureOf(Route.snapshot({ ...base, input: accessorPath as never }))).code).toBe("invalid_route")
    expect(pathGetter).not.toHaveBeenCalled()
    const hostileRef = sync((target) => new Proxy(target, {
      getPrototypeOf: () => {
        $raise(new Error("trap"))
      }
    }), { _tag: "None" })
    expect((try failureOf(Route.snapshot({ ...base, input: hostileRef as never }))).code).toBe("invalid_route")

    for (
      const effects of [
        { ...base.effects, reads: [""] },
        { ...base.effects, writes: [1] },
        { ...base.effects, mode: "other" },
        { ...base.effects, onConflict: "other" },
        { ...base.effects, tier: "other" }
      ]
    ) {
      expect((try failureOf(Route.snapshot({ ...base, effects: effects as never }))).code).toBe("invalid_route")
    }
  })

  it.effect("rejects accessor tags and payloads inside Option fields without reading them", effect () => {
    const base = makeRoute("review")
    const getter = vi.fn(() => "/absolute/ui.tsx")
    const accessorPayload = () => Object.defineProperty(Option.some("original"), "value", { enumerable: true, get: getter })
    const tagGetter = vi.fn(() => "None")
    const accessorTag = () =>
      Object.defineProperty(Object.create(Option.none()), "_tag", { enumerable: true, get: tagGetter })
    for (const hostile of [accessorPayload, accessorTag]) {
      expect((try failureOf(Route.snapshot({ ...base, description: hostile() as never }))).code).toBe("invalid_route")
      expect((try failureOf(Route.snapshot({ ...base, placement: hostile() as never }))).code).toBe("invalid_route")
      expect((try failureOf(Route.snapshot({ ...base, ui: hostile() as never }))).code).toBe("invalid_route")
    }
    expect(try failureOf(Route.snapshot({ ...base, ui: accessorPayload() as never }))).toMatchObject({
      code: "invalid_route",
      path: "$.ui.value"
    })
    expect(getter).not.toHaveBeenCalled()
    expect(tagGetter).not.toHaveBeenCalled()
  })

  it.effect("canonicalizes route identity to NFC", effect () => {
    const route = try Route.snapshot(makeRoute("café/list"))
    expect(route.name).toBe("café/list")
    expect(route.segments).toEqual(["café", "list"])
  })

  it.effect("classifies executable routes and returns typed loader failures", effect () => {
    expect(Route.isCommandRoute(makeRoute("visible"))).toBe(true)
    expect(Route.isCommandRoute(makeRoute("hidden", undefined, { modelInvocable: false }))).toBe(false)
    expect(Route.isCommandRoute(makeRoute("markdown", undefined, { kind: "markdown" }))).toBe(false)

    expect((try failureOf(Route.load(makeRoute("markdown", undefined, { kind: "markdown" })))).code).toBe(
      "unsupported_body"
    )
    // One stable code, two descriptions: a caller can tell a bad path from a
    // module that loads but exports no flow.
    expect(try failureOf(Route.load(makeRoute("invalid", invalidModule)))).toMatchObject({
      code: "load_failed",
      description: "The selected flow module has no default flow export"
    })
    expect(try failureOf(Route.load(makeRoute("missing", "/definitely/missing/flow.ts")))).toMatchObject({
      code: "load_failed",
      description: "The selected flow module could not be imported"
    })
  })
})

module $throw$ts {
export function raise(value: unknown): never { throw value }
}
import { raise as $raise } from $throw$ts


it.effect("sanitizes a schema locator whose reflective operations throw", effect () => {
  const input = try sync(() => throwingProxy(new Descriptor.SchemaRefNone({})))
  const refusal = try failureOf(Route.snapshot(makeRoute("hostile", visibleModule, { input })))
  expect(refusal.code).toBe("invalid_route")
  expect(JSON.stringify(refusal)).not.toContain("trap")
})
