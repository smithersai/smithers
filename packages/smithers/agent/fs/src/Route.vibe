/**
 * The immutable metadata projection of a discovered flow, and its lazy loader.
 *
 * @since 0.1.0
 */

import type * as Flow from "@smthrs/core/Flow"
import * as RuntimeFlow from "@smthrs/flow/Flow"
import * as Descriptor from "@smthrs/registry/Descriptor"
import { fileSpecifier } from "@smthrs/registry/Executable"
import { FsError } from "./FsError.vibe"
import * as Boundary from "./internal/Boundary.ts"

/**
 * Maximum number of path segments in one route.
 *
 * @category constants
 * @since 0.1.0
 */
export const maximumRouteDepth = 64

/**
 * Maximum UTF-16 length of one route segment.
 *
 * @category constants
 * @since 0.1.0
 */
export const maximumSegmentLength = 255

/**
 * Maximum UTF-16 length of one slash-joined route name.
 *
 * @category constants
 * @since 0.1.0
 */
export const maximumRouteNameLength = 4_096

/**
 * Maximum UTF-16 length of one source or companion path.
 *
 * @category constants
 * @since 0.1.0
 */
export const maximumPathLength = 16_384

/**
 * Maximum number of capabilities declared by one route.
 *
 * @category constants
 * @since 0.1.0
 */
export const maximumCapabilities = 256

/**
 * How a route's body is stored on disk.
 *
 * @category models
 * @since 0.1.0
 */
export type Kind = "module" | "markdown" | "skill"

/**
 * A path-derived command route.
 *
 * Everything here comes from registry discovery, which never evaluates a flow
 * module. Materializing the flow is {@link load}.
 *
 * @category models
 * @since 0.1.0
 */
export interface Route {
  name: string
  segments: ReadonlyArray<string>
  kind: Kind
  sourcePath: string
  description: Option.Option<string>
  input: Descriptor.SchemaRef
  output: Descriptor.SchemaRef
  capabilities: ReadonlyArray<string>
  effects: Descriptor.EffectDeclaration
  modelInvocable: boolean
  placement: Option.Option<Descriptor.Placement>
  ui: Option.Option<string>
}

/**
 * Generated applications augment this map with route-specific input and output
 * types from the loaded schemas (Schema.Type, not Schema.Encoded).
 *
 * @example
 * ```ts
 * declare module "@smthrs/fs/Route" {
 *   interface Manifest {
 *     review: { readonly input: { readonly title: string }; readonly output: string }
 *   }
 * }
 * ```
 *
 * @category models
 * @since 0.1.0
 */
// Declaration merging intentionally starts from an empty manifest.
// eslint-disable-next-line @typescript-eslint/no-empty-object-type
export interface Manifest {}

/**
 * A route name, narrowed to generated manifest keys when one is available.
 *
 * @category models
 * @since 0.1.0
 */
export type Name = keyof Manifest extends never ? string : Extract<keyof Manifest, string>

/**
 * The decoded input accepted by Command.call for a named route.
 *
 * @category models
 * @since 0.1.0
 */
export type Input<N extends Name> = N extends keyof Manifest
  ? Manifest[N] extends { input: infer I } ? I : unknown
  : unknown

/**
 * The decoded output returned by Command.call for a named route.
 *
 * @category models
 * @since 0.1.0
 */
export type Output<N extends Name> = N extends keyof Manifest
  ? Manifest[N] extends { output: infer O } ? O : unknown
  : unknown

const invalidRoute = (path: string, description = "Route metadata violates the command contract"): FsError =>
  new FsError({ code: "invalid_route", method: "Route.snapshot", description, path })

const routeRequiredFields: ReadonlyArray<string> = [
  "name",
  "segments",
  "kind",
  "sourcePath",
  "description",
  "input",
  "output",
  "capabilities",
  "effects",
  "modelInvocable",
  "placement",
  "ui"
]
const effectRequiredFields: ReadonlyArray<string> = ["reads", "writes", "mode", "onConflict", "tier"]
const schemaAllowedKeys: ReadonlySet<string> = new Set(["_tag", "path", "field", "document"])

type SyncCheck<A> = { readonly ok: true; readonly value: A } | { readonly ok: false; readonly error: FsError }

const failRoute = (path: string, description?: string): { readonly ok: false; readonly error: FsError } => ({
  ok: false,
  error: invalidRoute(path, description)
})

const readTextSync = (
  value: unknown,
  path: string,
  maximum: number
): SyncCheck<string> => {
  if (
    typeof value !== "string" || value.length === 0 ||
    value.length > maximum || value.includes("\0") || !Boundary.isWellFormedText(value)
  ) return failRoute(path)
  return { ok: true, value }
}

const readSchemaFieldsSync = (input: unknown): SyncCheck<Readonly<Record<string, unknown>>> => {
  if (typeof input !== "object" || input === null || Array.isArray(input)) return failRoute("$")
  const prototype = Object.getPrototypeOf(input)
  const known = input instanceof Descriptor.SchemaRefMarkdownArgs ||
    input instanceof Descriptor.SchemaRefMarkdownOutput || input instanceof Descriptor.SchemaRefNone ||
    input instanceof Descriptor.SchemaRefModule || input instanceof Descriptor.SchemaRefInline
  if (!known && prototype !== Object.prototype && prototype !== null) return failRoute("$")
  const keys = Reflect.ownKeys(input)
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]!
    if (typeof key === "symbol" || !schemaAllowedKeys.has(key)) return failRoute("$")
  }
  const output: Record<string, unknown> = Object.create(null) as Record<string, unknown>
  const tagDesc = Object.getOwnPropertyDescriptor(input, "_tag")
  if (tagDesc === undefined || !("value" in tagDesc) || !tagDesc.enumerable) return failRoute("$._tag")
  output["_tag"] = tagDesc.value
  for (const key of ["path", "field", "document"]) {
    const descriptor = Object.getOwnPropertyDescriptor(input, key)
    if (descriptor === undefined) continue
    if (!("value" in descriptor) || !descriptor.enumerable) return failRoute(`$.${key}`)
    output[key] = descriptor.value
  }
  return { ok: true, value: output }
}

const readOptionSync = (input: unknown, path: string): SyncCheck<Option.Option<unknown>> => {
  const admitted = Boundary.inspectOption(input)
  if (!admitted.ok) return failRoute(`${path}${admitted.path.slice(1)}`)
  return { ok: true, value: admitted.value }
}

const readOptionTextSync = (input: unknown, path: string, maximum: number): SyncCheck<Option.Option<string>> => {
  const option = readOptionSync(input, path)
  if (!option.ok) return option
  if (Option.isNone(option.value)) return { ok: true, value: Option.none() }
  const checked = readTextSync(option.value.value, path, maximum)
  if (!checked.ok) return checked
  return { ok: true, value: Option.some(checked.value) }
}

const readOptionPlacementSync = (input: unknown): SyncCheck<Option.Option<Descriptor.Placement>> => {
  const option = readOptionSync(input, "$.placement")
  if (!option.ok) return option
  if (Option.isNone(option.value)) return { ok: true, value: Option.none() }
  const placement = option.value.value
  if (!(placement is "client" or "local" or "sandbox" or "remote")) return failRoute("$.placement")
  return { ok: true, value: Option.some(placement) }
}

const readSchemaRefSync = (input: unknown, path: string): SyncCheck<Descriptor.SchemaRef> => {
  const taggedResult = readSchemaFieldsSync(input)
  if (!taggedResult.ok) return taggedResult
  const tagged = taggedResult.value
  switch (tagged._tag) {
    case "MarkdownArgs":
      return { ok: true, value: new Descriptor.SchemaRefMarkdownArgs({}) }
    case "MarkdownOutput":
      return { ok: true, value: new Descriptor.SchemaRefMarkdownOutput({}) }
    case "None":
      return { ok: true, value: new Descriptor.SchemaRefNone({}) }
    case "Module": {
      const source = readTextSync(tagged.path, `${path}.path`, maximumPathLength)
      if (!source.ok) return source
      if (!(tagged.field is "input" or "output")) return failRoute(`${path}.field`)
      return { ok: true, value: new Descriptor.SchemaRefModule({ path: source.value, field: tagged.field }) }
    }
    case "Inline": {
      const admitted = Boundary.admitJson(tagged.document)
      if (!admitted.ok) return failRoute(`${path}.document${admitted.path.slice(1)}`)
      return { ok: true, value: new Descriptor.SchemaRefInline({ document: admitted.value }) }
    }
    default:
      return failRoute(`${path}._tag`)
  }
}

const readEffectDeclarationSync = (input: unknown): SyncCheck<Descriptor.EffectDeclaration> => {
  const admitted = Boundary.inspectRecord(input, effectRequiredFields, [])
  if (!admitted.ok) return failRoute(admitted.path)
  const data = admitted.value
  const reads = Boundary.stringArray(data.reads, {
    maxItems: maximumCapabilities,
    maxLength: maximumPathLength
  })
  const writes = Boundary.stringArray(data.writes, {
    maxItems: maximumCapabilities,
    maxLength: maximumPathLength
  })
  if (!reads.ok) return failRoute(`$.effects.reads${reads.path.slice(1)}`)
  if (!writes.ok) return failRoute(`$.effects.writes${writes.path.slice(1)}`)
  if (!(data.mode is "hermetic" or "expected")) return failRoute("$.effects.mode")
  if (!(data.onConflict is "serialize" or "lane" or "fail")) return failRoute("$.effects.onConflict")
  if (!(data.tier is "sealed" or "compensable" or "irreversible")) return failRoute("$.effects.tier")
  return {
    ok: true,
    value: Object.freeze({
      reads: reads.value,
      writes: writes.value,
      mode: data.mode,
      onConflict: data.onConflict,
      tier: data.tier
    })
  }
}

const isAbsolutePath = (value: string): boolean =>
  value.startsWith("file:///") || value.startsWith("/") || /^[A-Za-z]:[\\/]/.test(value)

// Single synchronous boundary hatch for hostile proxies: preserves every FsError
// while avoiding ~25 nested Effect.try frames per route.
const copyRouteSync = (input: Route): SyncCheck<Route> => {
  const admitted = Boundary.inspectRecord(input, routeRequiredFields, [])
  if (!admitted.ok) return failRoute(admitted.path)
  const data = admitted.value
  const segments = Boundary.stringArray(data.segments, {
    maxItems: maximumRouteDepth,
    maxLength: maximumSegmentLength
  })
  if (
    !segments.ok || segments.value.length === 0 ||
    segments.value.some((segment) => segment === "." || segment === ".." || segment.includes("/"))
  ) {
    return failRoute(segments.ok ? "$.segments" : `$.segments${segments.path.slice(1)}`)
  }
  // A directory name arrives decomposed on macOS and composed from a
  // browser or an agent, so one canonical form decides route identity.
  const normalized = Object.freeze(segments.value.map((segment) => segment.normalize("NFC")))
  const nameChecked = readTextSync(data.name, "$.name", maximumRouteNameLength)
  if (!nameChecked.ok) return nameChecked
  const name = nameChecked.value.normalize("NFC")
  if (name !== normalized.join("/")) {
    return failRoute("$.name", "Route name must equal its slash-joined segments")
  }
  if (!(data.kind is "module" or "markdown" or "skill")) return failRoute("$.kind")
  const sourcePathChecked = readTextSync(data.sourcePath, "$.sourcePath", maximumPathLength)
  if (!sourcePathChecked.ok) return sourcePathChecked
  const sourcePath = sourcePathChecked.value
  if (!isAbsolutePath(sourcePath)) return failRoute("$.sourcePath", "Route source paths must be absolute")
  const capabilities = Boundary.stringArray(data.capabilities, {
    maxItems: maximumCapabilities,
    maxLength: maximumPathLength
  })
  if (!capabilities.ok) return failRoute(`$.capabilities${capabilities.path.slice(1)}`)
  if (typeof data.modelInvocable !== "boolean") return failRoute("$.modelInvocable")

  const description = readOptionTextSync(data.description, "$.description", maximumPathLength)
  if (!description.ok) return description
  const inputRef = readSchemaRefSync(data.input, "$.input")
  if (!inputRef.ok) return inputRef
  const outputRef = readSchemaRefSync(data.output, "$.output")
  if (!outputRef.ok) return outputRef
  const effects = readEffectDeclarationSync(data.effects)
  if (!effects.ok) return effects
  const placement = readOptionPlacementSync(data.placement)
  if (!placement.ok) return placement
  const ui = readOptionTextSync(data.ui, "$.ui", maximumPathLength)
  if (!ui.ok) return ui

  return {
    ok: true,
    value: Object.freeze({
      name,
      segments: normalized,
      kind: data.kind,
      sourcePath,
      description: description.value,
      input: inputRef.value,
      output: outputRef.value,
      capabilities: capabilities.value,
      effects: effects.value,
      modelInvocable: data.modelInvocable,
      placement: placement.value,
      ui: ui.value
    })
  }
}

const copyRoute = effect (input: Route): Route!FsError => {
  const checked = try Effect.try({
    try: () => copyRouteSync(input),
    catch: () => invalidRoute("$")
  })
  if (!checked.ok) throw checked.error
  return checked.value
}

/**
 * Copies and validates caller-owned route metadata before asynchronous use.
 *
 * @category constructors
 * @since 0.1.0
 */
export const snapshot = copyRoute

/**
 * True only for routes the agent and Incur command surfaces may execute.
 *
 * @category guards
 * @since 0.1.0
 */
export const isCommandRoute = (route: Route): boolean => route.kind === "module" && route.modelInvocable

type Loaded = Pick<Flow.Any, "name" | "input" | "output"> & Partial<Pick<Flow.Any, "description">>

const loadFailed = (description: string): FsError =>
  new FsError({
    code: "load_failed",
    method: "Route.load",
    description
  })

const importFailed = (): FsError => loadFailed("The selected flow module could not be imported")

const exportMissing = (): FsError => loadFailed("The selected flow module has no default flow export")

// Mirrors the registry's static precedence: a boolean `modelInvocable` wins,
// otherwise `disableModelInvocation: true` hides the record.
const recordModelInvocable = (declared: object): boolean =>
  "modelInvocable" in declared && typeof declared.modelInvocable === "boolean"
    ? declared.modelInvocable
    : !("disableModelInvocation" in declared && declared.disableModelInvocation === true)

/**
 * Materializes the flow behind a route.
 *
 * Only module routes can be materialized here. Markdown and skill bodies are
 * registry inputs, not executable commands in this private adapter.
 *
 * A route marked model-invocable whose imported flow or schema record is
 * hidden (`modelInvocable: false`, or `disableModelInvocation: true` without a
 * boolean `modelInvocable`) fails with `load_failed`, so route metadata
 * captured before the author hid the flow cannot run it.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function load(input: Route): Loaded!FsError {
  const route = try snapshot(input)
  if (route.kind !== "module") {
    throw new FsError({
      code: "unsupported_body",
      method: "Route.load",
      description: "Only module routes are executable"
    })
  }
  const specifier = try sync(() => fileSpecifier(route.sourcePath))
  const module = try tryPromise({
    try: () => import(/* @vite-ignore */ specifier) as Promise<{ default?: unknown }>,
    catch: importFailed
  })
  const flow = try sync(() => RuntimeFlow.isFlow(module.default) ? module.default : undefined)
  if (flow !== undefined) {
    // Route metadata is caller-owned and can predate an edit that hid the
    // flow, so the runtime declaration has the final word: a flow its author
    // hid never reaches a model-facing surface.
    if (route.modelInvocable && !Context.get(flow.annotations, RuntimeFlow.ModelInvocable)) {
      throw loadFailed("The selected flow is not model-invocable")
    }
    return {
      name: flow._tag,
      description: flow.description,
      input: flow.payloadSchema,
      output: flow.successSchema
    }
  }
  if (
    typeof module.default !== "object" || module.default === null ||
    !("input" in module.default) || !Schema.isSchema(module.default.input) ||
    !("output" in module.default) || !Schema.isSchema(module.default.output)
  ) throw exportMissing()
  if (route.modelInvocable && !recordModelInvocable(module.default)) {
    throw loadFailed("The selected flow is not model-invocable")
  }
  return module.default as Loaded
}
