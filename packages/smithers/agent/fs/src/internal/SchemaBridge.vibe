/**
 * Bridges loaded Effect schemas to command-line shaped input.
 *
 * @private
 * @since 0.1.0
 */

import type * as Descriptor from "@smthrs/registry/Descriptor"
import { z } from "incur"
import { FsError } from "../FsError.vibe"
import * as Boundary from "./Boundary.ts"

/**
 * Positional values collected by the agent parser or Incur.
 *
 * @private
 * @since 0.1.0
 */
export type Positional = ReadonlyArray<string> | Readonly<Record<string, unknown>>

/**
 * Input assembled before authoritative Effect schema decoding.
 *
 * @private
 * @since 0.1.0
 */
export interface Assembly {
  value: unknown
}

/**
 * Declarative Incur descriptors plus the authoritative Effect decoder.
 *
 * @private
 * @since 0.1.0
 */
export interface CommandSchema {
  args: z.ZodObject<any> | undefined
  options: z.ZodObject<any> | undefined
  assemble: (args: Positional, options: Readonly<Record<string, unknown>>) => Assembly
  decode: (assembly: Assembly) => unknown!FsError
}

type JsonSchema = Readonly<Record<string, unknown>>

const schemaFailure = (code: "decode_failed" | "encode_failed", method: string): FsError =>
  new FsError({
    code,
    method,
    description: code === "encode_failed"
      ? "The flow output did not satisfy its schema"
      : "The command input did not satisfy the flow schema"
  })

/**
 * Runs a program and turns any cause, defects included, into one sanitized
 * failure. A loaded flow's `Schema.Top` types its decoding services as
 * `unknown`; one that needs a service dies here, and that defect is the
 * failure too.
 *
 * @private
 * @since 0.1.0
 */
export effect function recover<A>(program: A!unknown!unknown, failure: () => FsError): A!FsError {
  // @vibelang-diagnostics-next-line EK4810:off
  return match (try exit(program as A!unknown)) {
    when Exit.Success(let value): value;
    default: throw failure();
  }
}

const jsonValue = (value: unknown): unknown => {
  if (typeof value !== "string") return value
  try {
    return JSON.parse(value)
  } catch {
    return value
  }
}

const record = (input: unknown): JsonSchema | undefined =>
  typeof input === "object" && input !== null && !Array.isArray(input)
    ? input as JsonSchema
    : undefined

const unsupportedSchema = (): FsError =>
  new FsError({
    code: "unsupported_schema",
    method: "SchemaBridge.toCommandSchema",
    description: "The flow input schema cannot be projected into command input"
  })

effect function construct<A>(build: () => A): A!FsError {
  return try Effect.try({ try: build, catch: unsupportedSchema })
}

const resolveReference = effect (
  input: unknown,
  definitions: JsonSchema,
  seen = new Set<unknown>()
): JsonSchema!FsError => {
  const schema = record(input)
  if (schema === undefined || seen.has(schema)) throw unsupportedSchema()
  if (schema.$ref === undefined) return schema
  const reference = schema.$ref
  if (typeof reference !== "string" || !reference.startsWith("#/$defs/")) throw unsupportedSchema()
  seen.add(schema)
  const name = reference.slice("#/$defs/".length).replace(/~1/g, "/").replace(/~0/g, "~")
  return try resolveReference(Object.hasOwn(definitions, name) ? definitions[name] : undefined, definitions, seen)
}

const objectFor = effect (
  schema: JsonSchema,
  definitions: JsonSchema,
  ancestors: ReadonlySet<JsonSchema>
): z.ZodObject<any>!FsError => {
  const properties = record(schema.properties) ?? {}
  const required = new Set(Array.isArray(schema.required) ? schema.required : [])
  const shape: Record<string, z.ZodType> = Object.create(null) as Record<string, z.ZodType>
  for (const [name, property] of Object.entries(properties)) {
    const field = try zodFor(property, definitions, ancestors)
    shape[name] = required.has(name) ? field : try construct(() => field.optional())
  }
  const object = try construct(() => z.object(shape))
  if (schema.additionalProperties === false) return try construct(() => object.strict())
  const additional = try zodFor(schema.additionalProperties ?? true, definitions, ancestors)
  return try construct(() => object.catchall(additional))
}

const zodFor = effect (
  input: unknown,
  definitions: JsonSchema,
  ancestors: ReadonlySet<JsonSchema> = new Set()
): z.ZodType!FsError => {
  if (input === true) return try construct(() => z.unknown())
  if (input === false) return try construct(() => z.never())
  const schema = try resolveReference(input, definitions)
  if (ancestors.has(schema)) throw unsupportedSchema()
  const next = new Set(ancestors).add(schema)
  const project = effect (node: unknown): z.ZodType!FsError => try zodFor(node, definitions, next)
  const variants = schema.anyOf ?? schema.oneOf
  if (Array.isArray(variants)) {
    const choices = try forEach(variants, project)
    return try construct(() => z.union(choices))
  }
  if (Object.hasOwn(schema, "const")) {
    const literal = try construct(() => z.literal(schema.const as string | number | boolean | null))
    return typeof schema.const === "string" ? literal : try construct(() => z.preprocess(jsonValue, literal))
  }
  if (Array.isArray(schema.enum)) {
    const values = schema.enum
    if (values.every((value) => typeof value === "string")) {
      return try construct(() => z.enum(values as [string, ...Array<string>]))
    }
    const choices = try forEach(values, effect (value) => try project({ const: value }))
    return try construct(() => z.union(choices))
  }
  const type = schema.type
  if (Array.isArray(type)) {
    const choices = try forEach(type, effect (type) => try project({ ...schema, type }))
    return try construct(() => z.union(choices))
  }
  if (type === "string") return try construct(() => z.string())
  if (type === "integer") return try construct(() => z.preprocess(jsonValue, z.int()))
  // Coercion would silently invent input such as zero for an empty string.
  if (type === "number") return try construct(() => z.preprocess(jsonValue, z.number()))
  if (type === "boolean") return try construct(() => z.preprocess(jsonValue, z.boolean()))
  if (type === "null") return try construct(() => z.preprocess(jsonValue, z.null()))
  if (type === "array") {
    if (Array.isArray(schema.prefixItems)) {
      const items = try forEach(schema.prefixItems, effect (item, index) => {
        const field = try project(item)
        return index < Number(schema.minItems ?? 0) ? field : try construct(() => field.optional())
      })
      const tuple = try construct(() => z.tuple(items as [z.ZodType, ...Array<z.ZodType>]))
      if (schema.items === false || Number(schema.maxItems) <= items.length) return tuple
      const rest = try project(schema.items ?? true)
      return try construct(() => tuple.rest(rest))
    }
    const item = try project(schema.items ?? true)
    return try construct(() => z.array(item))
  }
  if (type === "object") {
    const object = try objectFor(schema, definitions, next)
    return try construct(() => z.preprocess(jsonValue, object))
  }
  if (type !== undefined || schema.allOf !== undefined || schema.not !== undefined) throw unsupportedSchema()
  return try construct(() => z.preprocess(jsonValue, z.unknown()))
}

const documentOf = (schema: Schema.Top): {
  root: JsonSchema
  definitions: JsonSchema
} => {
  // Objects are advertised closed. Effect's default (`"ignore"`) leaves every
  // struct open, which `objectFor` would project as `catchall(unknown)`; an
  // unknown flag or nested key would then pass the projection and be dropped
  // by the authoritative decoder instead of refused. Index signatures keep
  // their typed `additionalProperties` either way.
  const document = Schema.toJsonSchemaDocument(schema, { onExcessProperty: "error" })
  return {
    root: document.schema,
    definitions: document.definitions
  }
}

const objectDescriptors = effect (
  root: JsonSchema,
  definitions: JsonSchema
): {
  args: z.ZodObject<any> | undefined
  options: z.ZodObject<any>
}!FsError => {
  const options = try objectFor(root, definitions, new Set([root]))
  const shape = options.shape
  // Positionals are advertised only when the flow schema really has an `args`
  // field. Mounting one anywhere else would publish a parameter that the strict
  // options object is guaranteed to refuse.
  return {
    args: Object.hasOwn(shape, "args") ? try construct(() => z.object({ args: shape.args! })) : undefined,
    options
  }
}

const positionalRecord = (args: Positional): Readonly<Record<string, unknown>> => {
  if (!Array.isArray(args)) return args as Readonly<Record<string, unknown>>
  return args.length === 0 ? {} : { args }
}

/**
 * Joins positional tokens into the single argument string Markdown flows take.
 *
 * Incur delivers positionals as the record `{ args: ["a", "b"] }`, so the
 * tokens have to be read out of that key rather than off the record's values.
 * Anything that is not a list of strings is returned unchanged so the
 * authoritative `args: string` decode refuses it: `String(value)` would invoke
 * a caller-supplied `toString` and turn `["a", "b"]` into `"a,b"`.
 */
const positionalText = (args: Positional): unknown => {
  const values: unknown = Array.isArray(args) ? args : (args as Readonly<Record<string, unknown>>).args
  if (values === undefined) return ""
  if (!Array.isArray(values)) return values
  return values.every((value) => typeof value === "string") ? values.join(" ") : values
}

/**
 * Merges a scalar command's tokens into the one object its strict schema checks.
 *
 * A scalar flow takes its value from the first positional or the named
 * `input`, and every other token has to reach the strict `{ input }` object so
 * it is refused rather than dropped: a surplus positional is kept under
 * `args`, an unknown flag under its own name, and a positional beside a named
 * input is kept as a second `input` entry under `--input`, because keeping
 * either one alone would silently invoke the flow with half the input. Only
 * `undefined` counts as absent, so an explicit `null` reaches the flow schema,
 * which decides whether it is accepted.
 */
const scalarRecord = (args: Positional, options: Readonly<Record<string, unknown>>): Record<string, unknown> => {
  const positional: Readonly<Record<string, unknown>> = Array.isArray(args)
    ? args.length === 0 ? {} : { input: args[0], ...(args.length > 1 ? { args: args.slice(1) } : {}) }
    : args as Readonly<Record<string, unknown>>
  const merged: Record<string, unknown> = {}
  for (const [key, value] of Object.entries(positional)) {
    if (value !== undefined) merged[key] = value
  }
  for (const [key, value] of Object.entries(options)) {
    if (value !== undefined) merged[Object.hasOwn(merged, key) ? `--${key}` : key] = value
  }
  return merged
}

effect function decodeWith(schema: Schema.Top, zodSchema: z.ZodType, assembly: Assembly): unknown!FsError {
  const parsed = try Effect.try({ try: () => zodSchema.safeParse(assembly.value), catch: () => schemaFailure("decode_failed", "SchemaBridge.decodeInput") })
  if (!parsed.success) throw schemaFailure("decode_failed", "SchemaBridge.decodeInput")
  return try decodeInput(schema, parsed.data)
}

/**
 * Authoritatively decodes and snapshots one loaded flow input.
 *
 * @private
 * @since 0.1.0
 */
export effect function decodeInput(schema: Schema.Top, value: unknown): unknown!FsError {
  const decoded = try recover(Schema.decodeUnknownEffect(schema)(value), () => schemaFailure("decode_failed", "SchemaBridge.decodeInput"))
  if (decoded === undefined) return undefined
  const admitted = try sync(() => Boundary.admitJson(decoded))
  if (!admitted.ok) throw schemaFailure("decode_failed", "SchemaBridge.decodeInput")
  return admitted.value
}

// Projects a schema with a JSON Schema document; anything it cannot project throws.
const projectSchema = effect (schema: Schema.Top): CommandSchema!FsError => {
  const { definitions, root } = try construct(() => documentOf(schema))
  const resolved = try resolveReference(root, definitions)
  if (record(resolved.properties) !== undefined) {
    const descriptors = try objectDescriptors(resolved, definitions)
    const command = descriptors.options
    const projected: CommandSchema = {
      args: descriptors.args,
      options: descriptors.options,
      assemble: (args, options) => Object.freeze({ value: { ...positionalRecord(args), ...options } }),
      decode: (assembly) => decodeWith(schema, command, assembly)
    }
    return Object.freeze(projected)
  }

  const value = try zodFor(resolved, definitions)
  const command = try construct(() => z.object({ input: value }).strict())
  const projected: CommandSchema = {
    args: try construct(() => z.object({ input: value.optional() })),
    options: try construct(() => z.object({ input: value.optional() }).strict()),
    assemble: (args, options) => Object.freeze({ value: scalarRecord(args, options) }),
    decode: effect (assembly) => {
      const parsed = try Effect.try({ try: () => command.safeParse(assembly.value), catch: () => schemaFailure("decode_failed", "SchemaBridge.decodeInput") })
      if (!parsed.success) throw schemaFailure("decode_failed", "SchemaBridge.decodeInput")
      return try decodeInput(schema, parsed.data.input)
    }
  }
  return Object.freeze(projected)
}

/**
 * Projects a loaded route input schema onto command-line args and options.
 *
 * @private
 * @since 0.1.0
 */
export effect function toCommandSchema(ref: Descriptor.SchemaRef, schema: Schema.Top): CommandSchema!FsError {
  if (ref._tag === "MarkdownOutput") {
    throw new FsError({
      code: "unsupported_schema",
      method: "SchemaBridge.toCommandSchema",
      description: "An output locator cannot describe command input"
    })
  }
  if (ref._tag === "None") {
    const empty = try construct(() => z.object({}).strict())
    const none: CommandSchema = {
      // A schema-free command takes nothing, so it advertises no positionals.
      args: undefined,
      options: empty,
      assemble: (args, options) => Object.freeze({ value: { ...positionalRecord(args), ...options } }),
      decode: effect (assembly) => {
        if (Object.keys(assembly.value as Record<string, unknown>).length !== 0) {
          throw schemaFailure("decode_failed", "SchemaBridge.decodeInput")
        }
        return try recover(Schema.decodeUnknownEffect(schema)(undefined), () => schemaFailure("decode_failed", "SchemaBridge.decodeInput"))
      }
    }
    return Object.freeze(none)
  }
  if (ref._tag === "MarkdownArgs") {
    const command = try construct(() => z.object({ args: z.string() }).strict())
    const markdown: CommandSchema = {
      args: try construct(() => z.object({ args: z.array(z.string()).optional() })),
      options: try construct(() => z.object({}).strict()),
      assemble: (args, options) => Object.freeze({ value: { args: positionalText(args), ...options } }),
      decode: (assembly) => decodeWith(schema, command, assembly)
    }
    return Object.freeze(markdown)
  }
  return try recover(projectSchema(schema), () => unsupportedSchema())
}

/**
 * Encodes and snapshots a flow output through its declared schema.
 *
 * @private
 * @since 0.1.0
 */
export effect function encodeOutput(schema: Schema.Top, value: unknown): unknown!FsError {
  const encoded = try recover(Schema.encodeUnknownEffect(schema)(value), () => schemaFailure("encode_failed", "SchemaBridge.encodeOutput"))
  if (encoded === undefined) return undefined
  const admitted = try sync(() => Boundary.admitJson(encoded))
  if (!admitted.ok) throw schemaFailure("encode_failed", "SchemaBridge.encodeOutput")
  return admitted.value
}

/**
 * Snapshots programmatic input before any module-loading await.
 *
 * @private
 * @since 0.1.0
 */
export effect function snapshotInput(input: unknown): (Boundary.Json | undefined)!FsError!never {
  if (input === undefined) return undefined
  const admitted = try sync(() => Boundary.admitJson(input))
  if (!admitted.ok) throw schemaFailure("decode_failed", "SchemaBridge.snapshotInput")
  return admitted.value
}
