/**
 * Incur projection of executable, model-visible module routes.
 *
 * @since 0.1.0
 */

import type { Cli as IncurCli } from "incur"
import * as CommandTree from "./CommandTree.vibe"
import * as FlowInvoker from "./FlowInvoker.vibe"
import { FsError } from "./FsError.vibe"
import * as IncurHost from "./internal/IncurHost.ts"
import * as Invocation from "./internal/Invocation.vibe"
import * as SchemaBridge from "./internal/SchemaBridge.vibe"
import * as Route from "./Route.vibe"

export { selfSegment } from "./internal/IncurHost.ts"

// Incur's callbacks throw transport control signals, so settle outside the
// program whose typed failures are sanitized.
effect function refuse(context: IncurHost.Context, error: FsError): never!! {
  return try sync(() => context.error({ code: error.code, exitCode: 1, message: error.description }))
}

effect function execute(selected: IncurHost.SelectedRoute, context: IncurHost.Context): unknown!never!FlowInvoker.FlowInvoker {
  const outcome = try exit(Invocation.sanitize(effect {
    const input = try selected.schema.decode(selected.schema.assemble(context.args, context.options))
    const output = try (try FlowInvoker.FlowInvoker).invoke(Object.freeze({
      name: selected.route.name,
      flow: selected.flow,
      input
    }))
    return try SchemaBridge.encodeOutput(selected.flow.output, output)
  }, "Incur.execute", "Incur invocation failed"))
  if (outcome is Exit.Success(let output)) return try sync(() => context.ok(output))
  const cause = outcome.cause
  if (cause.reasons is [{ _tag: "Fail", error: FsError and let error }]) return try refuse(context, error)
  // Sanitizing leaves only interruption here.
  return try failCause(Cause.fromReasons<never>(cause.reasons.filter(Cause.isInterruptReason)))
}

effect function project(route: Route.Route): IncurHost.Projection!! {
  return Effect.timeoutOrElse(effect {
    const flow = try Route.load(route)
    const schema = try SchemaBridge.toCommandSchema(route.input, flow.input)
    return { _tag: "Ready" as const, selected: { route, flow, schema } }
  }, {
    duration: "5 seconds",
    orElse: effect () => {
      throw new FsError({
        code: "load_failed",
        method: "Incur.project",
        description: "The route metadata load timed out",
        path: route.name
      })
    }
  }) catch (error) => ({ _tag: "Failed" as const, error })
}

effect function projectAll(tree: CommandTree.CommandTree): ReadonlyMap<Route.Route, IncurHost.Projection>!! {
  const projections = new Map<Route.Route, IncurHost.Projection>()
  for (const route of CommandTree.traverse(tree)) projections.set(route, try project(route))
  return projections
}

effect function groupedRoutes(tree: CommandTree.CommandTree): ReadonlySet<Route.Route>!FsError {
  const grouped = new Set<Route.Route>()
  const stack: Array<CommandTree.CommandTree> = [tree]
  while (stack.length > 0) {
    const node = stack.pop()!
    const route = Option.getOrUndefined(node.route)
    if (route !== undefined && node.children.size > 0) {
      if (node.children.has(IncurHost.selfSegment)) {
        throw new FsError({
          code: "duplicate_route",
          method: "Incur.createCli",
          description: "A child route claims the reserved self segment",
          path: `${route.name}/${IncurHost.selfSegment}`
        })
      }
      grouped.add(route)
    }
    for (const child of node.children.values()) stack.push(child)
  }
  return grouped
}

effect function hydrate(
  tree: CommandTree.CommandTree,
  grouped: ReadonlySet<Route.Route>,
  tokens: ReadonlyArray<string>,
  dispatchTokens: ReadonlyArray<string>
): Option.Option<IncurHost.Selection>!FsError {
  const resolved = CommandTree.resolve(tree, tokens) catch effect (error) => {
    if (error.code === "unknown_command") return undefined
    throw error
  }
  if (resolved === undefined) return Option.none()
  const consumed = tokens.length - resolved.rest.length
  const viaSelf = resolved.rest[0] === IncurHost.selfSegment && grouped.has(resolved.route)
  const flow = try Route.load(resolved.route)
  const schema = try SchemaBridge.toCommandSchema(resolved.route.input, flow.input)
  return Option.some<IncurHost.Selection>({
    route: resolved.route,
    flow,
    schema,
    dispatch: Object.freeze(dispatchTokens.slice(0, viaSelf ? consumed + 1 : consumed))
  })
}

effect function select(
  tree: CommandTree.CommandTree,
  grouped: ReadonlySet<Route.Route>,
  tokens: ReadonlyArray<string>,
  dispatchTokens: ReadonlyArray<string>
): IncurHost.Outcome!! {
  return effect {
    return { _tag: "Selection" as const, selection: try hydrate(tree, grouped, tokens, dispatchTokens) }
  } catch (error) => ({ _tag: "Error" as const, error })
}

/**
 * Projects routes onto an Incur CLI while preserving metadata-only discovery.
 *
 * Dispatching one command loads only that command's module. Its actual Effect
 * input schema is then projected into Incur flags and remains the
 * authoritative decoder. A discovery surface must publish those flags, so the
 * first discovery request loads every command module once and reuses the
 * result. Each route has a five-second metadata deadline. Hosts must call
 * `close()` at shutdown to interrupt an active build and release its cache.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function createCli(
  name: string,
  routes: ReadonlyArray<Route.Route>
): (IncurCli.Cli & { close: () => Promise<void> })!FsError!FlowInvoker.FlowInvoker {
  const validated = try CommandTree.make(routes)
  const executable = CommandTree.traverse(validated).filter(Route.isCommandRoute)
  const tree = try CommandTree.make(executable)
  const grouped = try groupedRoutes(tree)
  const services = try Effect.context<FlowInvoker.FlowInvoker>()
  return try sync(() => IncurHost.mount({
    name,
    tree,
    run: Effect.runPromiseWith(services),
    programs: {
      execute,
      refuse,
      projectAll,
      select: (tokens, dispatchTokens) => select(tree, grouped, tokens, dispatchTokens)
    }
  }))
}
