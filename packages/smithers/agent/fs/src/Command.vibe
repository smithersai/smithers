/**
 * Agent-facing projection of executable, model-visible module routes.
 *
 * @since 0.1.0
 */

import type * as Flow from "@smthrs/core/Flow"
import * as CommandTree from "./CommandTree.vibe"
import * as FlowInvoker from "./FlowInvoker.vibe"
import { FsError } from "./FsError.vibe"
import * as Boundary from "./internal/Boundary.ts"
import * as CommandLine from "./internal/CommandLine.vibe"
import * as SchemaBridge from "./internal/SchemaBridge.vibe"
import * as Route from "./Route.vibe"

/**
 * A route advertised to an agent.
 *
 * @category models
 * @since 0.1.0
 */
export interface ListedCommand {
  name: string
  description: string | undefined
}

/**
 * A decoded command-string invocation.
 *
 * @category models
 * @since 0.1.0
 */
export interface ParsedCommand<A = unknown> {
  route: Route.Route
  argv: ReadonlyArray<string>
  input: A
}

/**
 * Runtime projection of a route manifest for agent use.
 *
 * @category models
 * @since 0.1.0
 */
export interface CommandSurface {
  /** Lists executable model-visible module routes without loading them. */
  list: () => ReadonlyArray<ListedCommand>
  /** Loads the selected module and schema-decodes an agent command string. */
  parse: (commandString: string) => Effect<ParsedCommand, FsError>
  /** Parses, invokes, and output-encodes an agent command string. */
  execute: (commandString: string) => Effect<unknown, FsError, FlowInvoker.FlowInvoker>
  /** Validates decoded input and output for an exact named route. */
  call: <N extends Route.Name>(
    name: N,
    input: Route.Input<N>
  ) => Effect<Route.Output<N>, FsError, FlowInvoker.FlowInvoker>
}

type Loaded = Pick<Flow.Any, "name" | "input" | "output"> & Partial<Pick<Flow.Any, "description">>

interface Prepared {
  route: Route.Route
  flow: Loaded
  argv: ReadonlyArray<string>
  input: unknown
}

// Admit and detach even when the typed value contains native Date leaves.
effect function snapshotDecoded(value: unknown): Effect<unknown, FsError, infer R> {
  const admitted = Boundary.admitDecoded(value)
  if (!admitted.ok) {
    throw new FsError({
      code: "decode_failed",
      method: "Command.call",
      description: "The decoded flow value did not satisfy the boundary"
    })
  }
  return admitted.value
}

effect function validateDecoded(
  schema: Schema.Top,
  value: unknown,
  field: "input" | "output"
): Effect<unknown, FsError, infer R> {
  const decoded = try SchemaBridge.recover(
    Schema.decodeUnknownEffect(Schema.toType(schema))(snapshotDecoded(value)),
    effect () =>
      new FsError({
        code: "decode_failed",
        method: "Command.call",
        description: `The decoded flow ${field} did not satisfy its schema`
      })
  )
  return try snapshotDecoded(decoded)
}

const routeArgv = (argv: ReadonlyArray<string>): ReadonlyArray<string> => {
  const first = argv[0]
  if (first === undefined || !first.includes("/")) return argv
  return Object.freeze([...first.split("/"), ...argv.slice(1)])
}

/**
 * Constructs a command surface from routes.
 *
 * Non-module, hidden, and non-model-invocable routes remain available from the
 * registry but never enter this executable projection.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function make(routes: ReadonlyArray<Route.Route>): Effect<CommandSurface, FsError, infer R> {
  const validated = try CommandTree.make(routes)
  const commandRoutes = CommandTree.traverse(validated).filter(Route.isCommandRoute)
  const tree = try CommandTree.make(commandRoutes)

  const prepare = effect (commandString: string): Effect<Prepared, FsError, infer R> => {
    const argv = try CommandLine.lex(commandString)
    const resolved = try CommandTree.resolve(tree, routeArgv(argv))
    const flow = try Route.load(resolved.route)
    const schema = try SchemaBridge.toCommandSchema(resolved.route.input, flow.input)
    const parsed = try CommandLine.parseFlags(resolved.rest)
    const input = try schema.decode(schema.assemble(parsed.args, parsed.options))
    return Object.freeze({ route: resolved.route, flow, argv, input })
  }

  const invoke = effect (route: Route.Route, flow: Loaded, input: unknown) =>
    try FlowInvoker.FlowInvoker.invoke(Object.freeze({ name: route.name, flow, input }))

  const listed = Object.freeze(
    CommandTree.traverse(tree).map((route) =>
      Object.freeze({
        name: route.name,
        description: route.description.getOrUndefined()
      })
    )
  )

  const surface: CommandSurface = {
    list: () => listed,
    parse: effect (commandString) => {
      const { argv, input, route } = try prepare(commandString)
      return Object.freeze({ route, argv, input })
    },
    execute: effect (commandString) =>
      try withSpan(
        effect {
          const { flow, input, route } = try prepare(commandString)
          return try SchemaBridge.encodeOutput(flow.output, try invoke(route, flow, input))
        },
        "Command.execute"
      ),
    call: effect <N extends Route.Name>(name: N, candidate: Route.Input<N>) =>
      try withSpan(
        effect {
          const input = try snapshotDecoded(candidate)
          const segments = typeof name === "string" ? name.split("/") : []
          const route = try CommandTree.resolveExact(tree, segments)
          const flow = try Route.load(route)
          const decoded = try validateDecoded(flow.input, input, "input")
          const output = try invoke(route, flow, decoded)
          return (try validateDecoded(flow.output, output, "output")) as Route.Output<N>
        },
        "Command.call"
      )
  }
  return Object.freeze(surface)
}
