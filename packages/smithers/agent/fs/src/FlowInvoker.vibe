/**
 * The seam between a resolved route and whatever actually runs a flow.
 *
 * @since 0.1.0
 */

import type * as Flow from "@smthrs/core/Flow"
import { FsError } from "./FsError.vibe"

/**
 * One materialized invocation.
 *
 * @category models
 * @since 0.1.0
 */
export interface Invocation {
  name: string
  flow: Pick<Flow.Any, "name" | "input" | "output"> & Partial<Pick<Flow.Any, "description">>
  input: unknown
}

/**
 * Executes a materialized flow.
 *
 * The projections in this package never execute a flow themselves: the harness
 * owns the run loop, permissions, and durability, so it supplies this service.
 *
 * @category services
 * @since 0.1.0
 */
export service FlowInvoker {
  static readonly key = "/fs/FlowInvoker"
  invoke(invocation: Invocation): Effect<unknown, FsError>
}

/**
 * Constructs a flow invoker from an implementation.
 *
 * @category constructors
 * @since 0.1.0
 */
export const make = (implementation: FlowInvoker.Shape): FlowInvoker.Shape => {
  return Object.freeze({ invoke: implementation.invoke })
}

/**
 * Constructs an invoker that fails every invocation.
 *
 * @category constructors
 * @since 0.1.0
 */
export const makeNoop = (overrides: Partial<FlowInvoker.Shape> = {}): FlowInvoker.Shape => {
  return make({
    invoke: overrides.invoke ?? (effect (_invocation) =>
      try withSpan(
        effect {
          throw new FsError({
            code: "invocation_unavailable",
            method: "FlowInvoker.invoke",
            description: "No flow invoker is installed"
          })
        },
        "FlowInvoker.invoke"
      ))
  })
}

/**
 * Provides an invoker that fails every invocation.
 *
 * @category layers
 * @since 0.1.0
 */
export const layerNoop = (overrides: Partial<FlowInvoker.Shape> = {}): Layer<FlowInvoker> =>
  Layer.succeed(FlowInvoker, makeNoop(overrides))
