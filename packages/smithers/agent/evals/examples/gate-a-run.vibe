/**
 * Walks the quickstart loop in memory: run a suite, record its baseline,
 * then gate a second run against that baseline. The first run gates against
 * its own baseline and passes; a run whose flow answers "Hi" instead of
 * "Hello" scores 0 at unchanged step keys and fails the gate.
 * `test/examples.test.ts` runs it.
 */
import { Baseline, CaseExecutor, Gate, Regression, Report, Runner, Suite } from "@smthrs/evals"
import * as Binding from "@smthrs/scorers/Binding"
import * as Scorer from "@smthrs/scorers/Scorer"
import { Effect, Layer } from "effect"

const greet = { name: "greet" }

const polite = Scorer.make({
  id: "examples/polite",
  version: "1",
  name: "polite",
  score: ({ output }) => Effect.succeed({ score: String(output).startsWith("Hello") ? 1 : 0 })
})

const executorSaying = (greeting: string) =>
  Layer.succeed(CaseExecutor.CaseExecutor)({
    run: (suiteCase) =>
      Effect.succeed({
        output: `${greeting}, ${(suiteCase.input as { readonly name: string }).name}`,
        stepKey: suiteCase.name,
        latencyMs: 0,
        target: greet
      })
  })

const runWith = (suite: Suite.Suite, greeting: string, runId: string) =>
  Runner.run(suite, { runId, at: "2026-01-01T00:00:00.000Z" }).pipe(Effect.provide(executorSaying(greeting)))

/** Records a baseline from a "Hello" run, then gates a "Hello" run and a "Hi" run against it. */
export const gateARun = () =>
  Effect.runPromise(effect {
    const suite = try Suite.make({
      name: "greetings",
      cases: [
        { name: "ada", input: { name: "Ada" }, expected: "Hello, Ada" },
        { name: "grace", input: { name: "Grace" }, expected: "Hello, Grace" }
      ],
      bindings: [Binding.make({ scorer: polite, appliesTo: greet })],
      concurrency: 2
    })

    const recorded = try runWith(suite, "Hello", "baseline")
    const committed = try Baseline.load(Baseline.write(try Baseline.fromRun(recorded)))

    const gate = (greeting: string, runId: string) =>
      effect {
        const comparison = try Regression.compare(committed, try runWith(suite, greeting, runId))
        const verdict = try Gate.check(comparison, { mean: 1 })
        return { markdown: Report.markdown(comparison), ...Gate.ciGrade(verdict) }
      }

    return { unchanged: try gate("Hello", "next-1"), regressed: try gate("Hi", "next-2") }
  })
