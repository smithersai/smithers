/**
 * Which occurrences one scheduler tick owes a trigger.
 *
 * @since 1.0.0-rc.0
 */

import * as Effect from "effect/Effect"
import * as CatchUp from "../CatchUp.vibe"
import * as Cron from "../Cron.ts"
import type { TriggerError } from "../TriggerError.ts"
import type { Registered } from "../TriggerStore.ts"

/**
 * The occurrences to claim, oldest first, and the watermark that stands once
 * every one of them has been dispatched.
 *
 * @private
 * @since 1.0.0-rc.0
 */
export interface Due {
  readonly occurrences: ReadonlyArray<number>
  readonly watermark: number
}

// A bound the declaration cannot honour is a statement about how much history
// to replay, not a reason to stop scheduling: the backlog beyond the bound is
// abandoned, loudly, and the current occurrence still fires.
const withinBound = (
  triggerId: string,
  owed: ReadonlyArray<Date>!TriggerError
): ReadonlyArray<Date>!TriggerError =>
  Effect.catch(owed, (error) =>
    error.code === "catch_up_bound_exceeded"
      ? Effect.as(
        Effect.annotateLogs(
          Effect.logWarning("A trigger abandoned catch-up work beyond its bound", error),
          { triggerId }
        ),
        [] as ReadonlyArray<Date>
      )
      : Effect.fail(error))

/**
 * Computes what a trigger owes at `now`, given the watermark this process has
 * already dispatched through, or `undefined` on first sight of the trigger.
 *
 * The answer depends on nothing but its arguments. The watermark is the
 * caller's to keep: it only moves forward, and only past occurrences the
 * caller finished dispatching.
 *
 * @private
 * @since 1.0.0-rc.0
 */
export const compute = effect (
  trigger: Registered,
  now: number,
  observed: number | undefined
): Due!TriggerError => {
  const cron = try Cron.parse(trigger.cron, trigger.timezone)
  const current = (try Cron.previousAtOrBefore(cron, new Date(now))).getTime()
  // First sight of this trigger in this process starts from the last fire
  // the store recorded. A trigger that has never fired starts from here
  // rather than from whatever occurrence last passed: registering a weekly
  // trigger on a Sunday evening owes nothing for the Monday six days gone,
  // which is what `catchUp` says.
  const since = observed ?? trigger.lastFiredAt
  if (since === undefined || current <= since) {
    return { occurrences: [], watermark: Math.max(current, observed ?? current) }
  }
  // A restart and a stall in this process missed the same boundaries, so
  // both ask the policy about the same interval, the current boundary
  // included. The stalled poll used to leave the current boundary out, so
  // `one` fired two runs and a bound of 2 fired three where a restart fired
  // one.
  //
  // When only the boundary that just passed is due, nothing was missed: a
  // bound of zero has nothing to refuse, so it is read as one. Every other
  // bound is still validated and searched exactly as stated.
  // Only a zero bound needs the boundary before this one, so no other tick
  // pays for that search.
  const lone = trigger.maxCatchUp === 0 &&
    (try Cron.previousAtOrBefore(cron, new Date(current - 1))).getTime() <= since
  const bound = lone ? 1 : trigger.maxCatchUp
  const owed = try withinBound(
    trigger.id,
    CatchUp.occurrences(trigger.catchUp, bound, new Date(since), new Date(now), cron)
  )
  // The current boundary is owed whatever the policy says about the
  // backlog. Under `none`, or once the bound abandoned the backlog, a
  // restart used to skip it.
  const occurrences = owed.map((occurrence) => occurrence.getTime())
  if (occurrences.at(-1) !== current) occurrences.push(current)
  return { occurrences, watermark: current }
}
