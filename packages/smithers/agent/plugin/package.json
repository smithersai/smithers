{
  "name": "@smthrs/plugin",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Vite-style typed plugin kernel for flows: hooks, resolution, and config execution",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/plugin"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "plugin",
    "hooks"
  ],
  "keywords": [
    "typescript",
    "effect",
    "plugin",
    "hooks"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Config": "./src/Config.ts",
    "./Hooks": "./src/Hooks.ts",
    "./Kernel": "./src/Kernel.ts",
    "./Plugin": "./src/Plugin.ts",
    "./PluginError": "./src/PluginError.ts",
    "./Plugins": "./src/Plugins.ts",
    "./Resolve": "./src/Resolve.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Config": {
        "types": "./dist/esm/Config.d.ts",
        "import": "./dist/esm/Config.js",
        "require": "./dist/cjs/Config.js"
      },
      "./Hooks": {
        "types": "./dist/esm/Hooks.d.ts",
        "import": "./dist/esm/Hooks.js",
        "require": "./dist/cjs/Hooks.js"
      },
      "./Kernel": {
        "types": "./dist/esm/Kernel.d.ts",
        "import": "./dist/esm/Kernel.js",
        "require": "./dist/cjs/Kernel.js"
      },
      "./Plugin": {
        "types": "./dist/esm/Plugin.d.ts",
        "import": "./dist/esm/Plugin.js",
        "require": "./dist/cjs/Plugin.js"
      },
      "./PluginError": {
        "types": "./dist/esm/PluginError.d.ts",
        "import": "./dist/esm/PluginError.js",
        "require": "./dist/cjs/PluginError.js"
      },
      "./Plugins": {
        "types": "./dist/esm/Plugins.d.ts",
        "import": "./dist/esm/Plugins.js",
        "require": "./dist/cjs/Plugins.js"
      },
      "./Resolve": {
        "types": "./dist/esm/Resolve.d.ts",
        "import": "./dist/esm/Resolve.js",
        "require": "./dist/cjs/Resolve.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/flow": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
