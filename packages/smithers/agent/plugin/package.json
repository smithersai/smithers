{
  "name": "@smthrs/plugin",
  "type": "module",
  "version": "1.0.0-rc.16",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Vite-style typed plugin kernel for flows: hooks, resolution, and config execution",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/plugin"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "plugin",
    "hooks"
  ],
  "keywords": [
    "typescript",
    "effect",
    "plugin",
    "hooks"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Bind": "./src/Bind.ts",
    "./Config": "./src/Config.ts",
    "./Contribution": "./src/Contribution.ts",
    "./Hooks": "./src/Hooks.ts",
    "./Host": "./src/Host.ts",
    "./JsonSchema": "./src/JsonSchema.ts",
    "./Kernel": "./src/Kernel.ts",
    "./Keys": "./src/Keys.ts",
    "./Load": "./src/Load.ts",
    "./Manifest": "./src/Manifest.ts",
    "./Plugin": "./src/Plugin.ts",
    "./PluginError": "./src/PluginError.ts",
    "./Plugins": "./src/Plugins.ts",
    "./Resolve": "./src/Resolve.ts",
    "./When": "./src/When.ts",
    "./index": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./*/index": null,
      "./Bind": {
        "import": {
          "types": "./dist/esm/Bind.d.ts",
          "default": "./dist/esm/Bind.js"
        },
        "require": {
          "types": "./dist/cjs/Bind.d.ts",
          "default": "./dist/cjs/Bind.js"
        }
      },
      "./Config": {
        "import": {
          "types": "./dist/esm/Config.d.ts",
          "default": "./dist/esm/Config.js"
        },
        "require": {
          "types": "./dist/cjs/Config.d.ts",
          "default": "./dist/cjs/Config.js"
        }
      },
      "./Contribution": {
        "import": {
          "types": "./dist/esm/Contribution.d.ts",
          "default": "./dist/esm/Contribution.js"
        },
        "require": {
          "types": "./dist/cjs/Contribution.d.ts",
          "default": "./dist/cjs/Contribution.js"
        }
      },
      "./Hooks": {
        "import": {
          "types": "./dist/esm/Hooks.d.ts",
          "default": "./dist/esm/Hooks.js"
        },
        "require": {
          "types": "./dist/cjs/Hooks.d.ts",
          "default": "./dist/cjs/Hooks.js"
        }
      },
      "./Host": {
        "import": {
          "types": "./dist/esm/Host.d.ts",
          "default": "./dist/esm/Host.js"
        },
        "require": {
          "types": "./dist/cjs/Host.d.ts",
          "default": "./dist/cjs/Host.js"
        }
      },
      "./JsonSchema": {
        "import": {
          "types": "./dist/esm/JsonSchema.d.ts",
          "default": "./dist/esm/JsonSchema.js"
        },
        "require": {
          "types": "./dist/cjs/JsonSchema.d.ts",
          "default": "./dist/cjs/JsonSchema.js"
        }
      },
      "./Kernel": {
        "import": {
          "types": "./dist/esm/Kernel.d.ts",
          "default": "./dist/esm/Kernel.js"
        },
        "require": {
          "types": "./dist/cjs/Kernel.d.ts",
          "default": "./dist/cjs/Kernel.js"
        }
      },
      "./Keys": {
        "import": {
          "types": "./dist/esm/Keys.d.ts",
          "default": "./dist/esm/Keys.js"
        },
        "require": {
          "types": "./dist/cjs/Keys.d.ts",
          "default": "./dist/cjs/Keys.js"
        }
      },
      "./Load": {
        "import": {
          "types": "./dist/esm/Load.d.ts",
          "default": "./dist/esm/Load.js"
        },
        "require": {
          "types": "./dist/cjs/Load.d.ts",
          "default": "./dist/cjs/Load.js"
        }
      },
      "./Manifest": {
        "import": {
          "types": "./dist/esm/Manifest.d.ts",
          "default": "./dist/esm/Manifest.js"
        },
        "require": {
          "types": "./dist/cjs/Manifest.d.ts",
          "default": "./dist/cjs/Manifest.js"
        }
      },
      "./Plugin": {
        "import": {
          "types": "./dist/esm/Plugin.d.ts",
          "default": "./dist/esm/Plugin.js"
        },
        "require": {
          "types": "./dist/cjs/Plugin.d.ts",
          "default": "./dist/cjs/Plugin.js"
        }
      },
      "./PluginError": {
        "import": {
          "types": "./dist/esm/PluginError.d.ts",
          "default": "./dist/esm/PluginError.js"
        },
        "require": {
          "types": "./dist/cjs/PluginError.d.ts",
          "default": "./dist/cjs/PluginError.js"
        }
      },
      "./Plugins": {
        "import": {
          "types": "./dist/esm/Plugins.d.ts",
          "default": "./dist/esm/Plugins.js"
        },
        "require": {
          "types": "./dist/cjs/Plugins.d.ts",
          "default": "./dist/cjs/Plugins.js"
        }
      },
      "./Resolve": {
        "import": {
          "types": "./dist/esm/Resolve.d.ts",
          "default": "./dist/esm/Resolve.js"
        },
        "require": {
          "types": "./dist/cjs/Resolve.d.ts",
          "default": "./dist/cjs/Resolve.js"
        }
      },
      "./When": {
        "import": {
          "types": "./dist/esm/When.d.ts",
          "default": "./dist/esm/When.js"
        },
        "require": {
          "types": "./dist/cjs/When.d.ts",
          "default": "./dist/cjs/When.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/canonical": "1.0.0-rc.16",
    "@smthrs/flow": "1.0.0-rc.16",
    "@smthrs/registry": "1.0.0-rc.16"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.5",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  }
}
