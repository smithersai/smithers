/**
 * The closed `when` grammar a slot entry or keybinding is conditioned on.
 *
 * A clause is `view == <plugin>/<name>`, `item.<field>` or `focus.input`,
 * optionally negated with a prefix `!`; clauses combine with `&&` only. There
 * is no `||` and no parentheses, so a condition is a plain conjunction a host
 * evaluates without running anything. An empty condition always holds.
 *
 * @since 1.1.0
 */

import * as Result from "effect/Result"
import * as Patterns from "./internal/patterns.ts"

/**
 * One term a clause tests.
 *
 * @category models
 * @since 1.1.0
 */
export type Term =
  | { readonly kind: "view"; readonly view: string }
  | { readonly kind: "item"; readonly field: string }
  | { readonly kind: "focus" }

/**
 * A term, possibly negated.
 *
 * @category models
 * @since 1.1.0
 */
export interface Clause {
  readonly negated: boolean
  readonly term: Term
}

/**
 * A parsed condition: every clause must hold.
 *
 * @category models
 * @since 1.1.0
 */
export interface When {
  readonly clauses: ReadonlyArray<Clause>
}

/**
 * What a condition is evaluated against: the open view, the selected row and
 * whether a text input has focus.
 *
 * @category models
 * @since 1.1.0
 */
export interface Context {
  readonly view?: string | undefined
  readonly item?: Readonly<Record<string, unknown>> | undefined
  readonly focusInput: boolean
}

/**
 * The condition that always holds.
 *
 * @category constructors
 * @since 1.1.0
 */
export const always: When = { clauses: [] }

const viewTerm = /^view\s*==\s*(\S+)$/

const term = (text: string): Term | undefined => {
  if (text === "focus.input") return { kind: "focus" }
  if (text.startsWith("item.")) {
    const field = text.slice("item.".length)
    return Patterns.field.test(field) ? { kind: "item", field } : undefined
  }
  const view = viewTerm.exec(text)?.[1]
  return view !== undefined && Patterns.qualified.test(view) ? { kind: "view", view } : undefined
}

/**
 * Parses a condition, or names the clause that is outside the grammar.
 *
 * @category parsing
 * @since 1.1.0
 */
export const parse = (text: string): Result.Result<When, string> => {
  if (text.trim() === "") return Result.succeed(always)
  const clauses: Array<Clause> = []
  for (const [index, raw] of text.split("&&").entries()) {
    const trimmed = raw.trim()
    const negated = trimmed.startsWith("!")
    const parsed = term(negated ? trimmed.slice(1).trimStart() : trimmed)
    if (parsed === undefined) return Result.fail(`clause ${index + 1} is outside the when grammar`)
    clauses.push({ negated, term: parsed })
  }
  return Result.succeed({ clauses })
}

const holds = (term: Term, context: Context): boolean => {
  switch (term.kind) {
    case "view":
      return context.view === term.view
    case "item":
      return context.item !== undefined && Object.hasOwn(context.item, term.field)
        && Boolean(context.item[term.field])
    case "focus":
      return context.focusInput
  }
}

/**
 * Whether a condition holds. `item.<field>` is the truthiness of the
 * selected row's field; with no row it is false.
 *
 * @category evaluation
 * @since 1.1.0
 */
export const evaluate = (when: When, context: Context): boolean =>
  when.clauses.every((clause) => holds(clause.term, context) !== clause.negated)

/**
 * The view a condition requires: its first un-negated `view ==` clause.
 *
 * @category accessors
 * @since 1.1.0
 */
export const view = (when: When): string | undefined => {
  for (const clause of when.clauses) {
    if (!clause.negated && clause.term.kind === "view") return clause.term.view
  }
  return undefined
}
