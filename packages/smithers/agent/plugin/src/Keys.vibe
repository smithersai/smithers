/**
 * The closed key grammar a keybinding declares, and matching pressed keys
 * against it.
 *
 * A binding is one or two strokes separated by one space (`g q`). A stroke is
 * any of `mod+`, `ctrl+`, `alt+`, `shift+` followed by a key: `a`–`z`,
 * `0`–`9`, `digit` (any of `1`–`9`), `enter`, `escape`, `tab`, `space`, the
 * four arrows, `/`, `?`, `[` or `]`. `mod` is Meta on a Mac and Control
 * elsewhere.
 *
 * @since 1.1.0
 */

import * as Result from "effect/Result"

/**
 * One stroke of a binding.
 *
 * @category models
 * @since 1.1.0
 */
export interface Stroke {
  readonly key: string
  readonly mod: boolean
  readonly ctrl: boolean
  readonly alt: boolean
  readonly shift: boolean
}

/**
 * A parsed binding: one or two strokes.
 *
 * @category models
 * @since 1.1.0
 */
export interface Keys {
  readonly strokes: ReadonlyArray<Stroke>
}

/**
 * A key the person pressed, as a `KeyboardEvent` reports it: `key` is
 * `KeyboardEvent.key` (case is ignored), the rest its modifier flags.
 *
 * @category models
 * @since 1.1.0
 */
export interface Pressed {
  readonly key: string
  readonly meta: boolean
  readonly ctrl: boolean
  readonly alt: boolean
  readonly shift: boolean
}

/**
 * How pressed keys compare with a binding. `matched` when every stroke was
 * pressed, `partial` when the pressed strokes are a proper prefix of it, and
 * `index` the digit pressed less one when the matching stroke is `digit`.
 *
 * @category models
 * @since 1.1.0
 */
export interface Match {
  readonly matched: boolean
  readonly partial: boolean
  readonly index?: number
}

/**
 * Matching options: `mac` maps `mod` to Meta, otherwise to Control.
 *
 * @category models
 * @since 1.1.0
 */
export interface Options {
  readonly mac: boolean
}

const named: ReadonlySet<string> = new Set([
  "digit",
  "enter",
  "escape",
  "tab",
  "space",
  "arrowup",
  "arrowdown",
  "arrowleft",
  "arrowright",
  "/",
  "?",
  "[",
  "]"
])
const modifiers = ["mod", "ctrl", "alt", "shift"] as const

const stroke = (text: string): Stroke | undefined => {
  const parts = text.split("+")
  const key = parts.pop()!
  if (!/^[a-z0-9]$/.test(key) && !named.has(key)) return undefined
  const flags = { mod: false, ctrl: false, alt: false, shift: false }
  for (const part of parts) {
    const modifier = modifiers.find((name) => name === part)
    if (modifier === undefined || flags[modifier]) return undefined
    flags[modifier] = true
  }
  return { key, ...flags }
}

/**
 * Parses a binding, or says why it is outside the grammar.
 *
 * @category parsing
 * @since 1.1.0
 */
export const parse = (text: string): Result.Result<Keys, string> => {
  const parts = text.split(" ")
  if (parts.length > 2) return Result.fail("a binding is at most two strokes")
  const strokes: Array<Stroke> = []
  for (const [index, part] of parts.entries()) {
    const parsed = stroke(part)
    if (parsed === undefined) return Result.fail(`stroke ${index + 1} is outside the key grammar`)
    strokes.push(parsed)
  }
  return Result.succeed({ strokes })
}

const keyName = (key: string): string => {
  const lower = key.toLowerCase()
  return lower === " " ? "space" : lower
}

/** The digit's index, `1` → 0 … `9` → 8, for a `digit` stroke; else whether the key is the stroke's. */
const strokeKey = (expected: string, pressed: string): number | boolean => {
  if (expected !== "digit") return expected === pressed
  return /^[1-9]$/.test(pressed) ? Number(pressed) - 1 : false
}

const sameModifiers = (expected: Stroke, pressed: Pressed, options: Options): boolean =>
  pressed.meta === (options.mac && expected.mod)
  && pressed.ctrl === (expected.ctrl || (!options.mac && expected.mod))
  && pressed.alt === expected.alt
  // `?` is typed with Shift on most layouts, so its Shift says nothing.
  && (expected.key === "?" || pressed.shift === expected.shift)

/**
 * Compares the strokes pressed since the keymap last reset with a binding.
 *
 * @category matching
 * @since 1.1.0
 */
export const match = (keys: Keys, pressed: ReadonlyArray<Pressed>, options: Options): Match => {
  if (pressed.length === 0 || pressed.length > keys.strokes.length) return { matched: false, partial: false }
  let index: number | undefined
  for (const [position, key] of pressed.entries()) {
    const expected = keys.strokes[position]!
    const found = strokeKey(expected.key, keyName(key.key))
    if (found === false || !sameModifiers(expected, key, options)) return { matched: false, partial: false }
    if (typeof found === "number") index = found
  }
  const matched = pressed.length === keys.strokes.length
  return index === undefined ? { matched, partial: !matched } : { matched, partial: !matched, index }
}
