/**
 * The GitHub REST client.
 *
 * Three behaviors are the reason this exists rather than a bare `HttpClient`:
 *
 * - **Retry classification.** The client makes exactly one request per call
 *   and never repeats it: the flow engine's retry policy, around the step that
 *   makes the call, is the only retry, and it survives a crash. What the client
 *   owns is the classification that policy reads. GitHub signals a rate limit
 *   as a 429 *and* as a 403 whose `x-ratelimit-remaining` is `0` or whose body
 *   mentions the secondary or abuse limit; all three are `retryable` for every
 *   method, because a rejected request was not performed, and carry the
 *   server's `Retry-After` or `x-ratelimit-reset` as `retryAfterMillis`, capped
 *   so a skewed clock cannot park a step for hours. A 5xx or a transport
 *   failure is `retryable` only for a read, with the 5xx's `Retry-After`: on a
 *   POST, PATCH, PUT, or DELETE the outcome is unknown, so the client reports
 *   `outcomeUnknown` and a step must reconcile before it writes again. A
 *   caller that knows its endpoint is idempotent opts in with
 *   `retryUnsafeWrites`.
 * - **Pagination.** `paginate` follows RFC 5988 `Link: rel="next"` within a
 *   declared page budget and says when it ran out.
 * - **Token hygiene.** The token reaches the `Authorization` header and
 *   nothing else, not a message, not `details`, not a log line, and every
 *   request URL, including a `rel="next"` target, is pinned to the configured
 *   API origin, and a 3xx fails rather than being followed, so neither a
 *   redirected link nor a `Location` header can carry the token elsewhere. The
 *   client sets the fetch transport's `redirect` to `"manual"` to keep it so,
 *   and sends no `b3` or `traceparent` header. Errors redact echoed
 *   credentials from summaries, details, and cause messages. The origin pin
 *   is not a path pin: a caller that builds a path from provider data uses
 *   `Repository.repositoryPath`, which validates each segment, because
 *   `new URL` resolves `..` inside a path.
 *
 * HTTP goes through the `HttpClient` in context, which the caller provides
 * through a layer, usually `FetchHttpClient.layer` from `effect/http`. A test
 * provides a client of its own to inject a transport fault.
 *
 * Interruption is forwarded to the `HttpClient`, so interrupting the fiber
 * aborts the request in flight rather than leaving it running. Every request
 * also carries its own deadline, `requestTimeout`, spanning the response
 * headers and the body read: a retry policy sees only attempts that end, so
 * without a deadline a peer that answers and then trickles the body forever
 * holds the call, and its step, open.
 *
 * @since 1.0.0
 */

import { Context, Duration, Effect, Layer, Option, Redacted, Schema } from "effect"
import * as HttpClient from "effect/http/HttpClient"
import * as HttpClientRequest from "effect/http/HttpClientRequest"
import {
  forCredentials,
  MAX_RETRY_AFTER_MS,
  retryAfterHeader,
  transportCause,
  webHeaders
} from "../core/CredentialHttp.vibe"
import { IntegrationError } from "../core/IntegrationError.ts"
import { redactedError } from "../core/RedactedError.ts"
import * as Environment from "../Environment.ts"
import { type GitHubConfig, resolve } from "./Config.vibe"

/**
 * The identity every host uses for GitHub HTTP requests, including outside the REST client.
 *
 * @category constants
 * @since 1.0.0
 */
export const USER_AGENT = "smithers-integrations"

/**
 * The response header in which the GitHub proxy names the instant a refused
 * request may be retried. A 429 that carries it was never sent to GitHub.
 *
 * @category constants
 * @since 1.0.0
 */
export const PROXY_RETRY_AT = "x-smithers-retry-at"

/**
 * The response header in which the GitHub proxy names why it refused.
 *
 * @category constants
 * @since 1.0.0
 */
export const PROXY_REASON = "x-smithers-rate-limit-reason"

/**
 * The largest `per_page` GitHub accepts.
 *
 * @category constants
 * @since 1.0.0
 */
export const MAX_PER_PAGE = 100

/**
 * The default page budget {@link GitHubClient.paginate} spends, and the
 * largest one it accepts.
 *
 * @category constants
 * @since 1.0.0
 */
export const DEFAULT_MAX_PAGES = 10

/**
 * The largest page budget {@link GitHubClient.paginate} accepts.
 *
 * @category constants
 * @since 1.0.0
 */
export const MAX_PAGES_LIMIT = 1000

/**
 * The REST verbs this client issues.
 *
 * @category models
 * @since 1.0.0
 */
export type RequestMethod = "GET" | "POST" | "PATCH" | "PUT" | "DELETE"

/**
 * The verbs whose effect the server may already have applied when the answer
 * is lost.
 *
 * A 5xx or a dropped connection on one of these does not say whether the
 * write happened, so the client reports `outcomeUnknown` rather than
 * `retryable`: see {@link RequestOptions.retryUnsafeWrites}.
 *
 * @category constants
 * @since 1.0.0
 */
export const UNSAFE_METHODS: ReadonlyArray<RequestMethod> = ["POST", "PATCH", "PUT", "DELETE"]

/**
 * Per-request options for a call whose response the client does not check.
 *
 * @category models
 * @since 1.0.0
 */
export interface RequestOptions {
  readonly query?: Readonly<Record<string, string | number | boolean | undefined>> | undefined
  /**
   * Classify a POST, PATCH, PUT, or DELETE whose answer was lost as
   * `retryable` while retaining `outcomeUnknown`, so a step's retry policy
   * may repeat it without losing the ambiguity report.
   *
   * Off by default. A 5xx or a transport failure on a write is the classic
   * ambiguous case: GitHub may have committed it and lost the answer, so
   * repeating posts a second comment or creates a second hook. Only a caller
   * that knows the endpoint is idempotent should turn this on. A rate limit is
   * `retryable` for every method regardless, because a rejected request was not
   * performed.
   */
  readonly retryUnsafeWrites?: boolean | undefined
}

/**
 * Per-request options that decode the response.
 *
 * The schema is required, and the request's result type is the schema's type:
 * a caller cannot name a response type the client never checked.
 *
 * @category models
 * @since 1.0.0
 */
export interface DecodedRequestOptions<A> extends RequestOptions {
  /** Decodes the response body, failing `decode-failed` when it does not fit. */
  readonly schema: Schema.Schema<A>
}

/**
 * One `paginate` walk's result.
 *
 * @category models
 * @since 1.0.0
 */
export interface Page {
  readonly items: ReadonlyArray<unknown>
  /**
   * True when the page budget ran out with a `rel="next"` link still
   * outstanding, so `items` is a prefix of the resource rather than all of it.
   */
  readonly truncated: boolean
  /** Included only with `withNext`: the outstanding cursor URL, or `null` at the end. */
  readonly next?: string | null | undefined
}

/**
 * The client service.
 *
 * @category services
 * @since 1.0.0
 */
export interface GitHubClient {
  /**
   * One REST call.
   *
   * Without a schema the result is the parsed JSON as `unknown`: nothing was
   * validated, so nothing is promised. Passing a
   * {@link DecodedRequestOptions.schema} is the only way to name the response
   * type, and the decode failing is reported as `decode-failed`.
   */
  readonly request: {
    <A>(
      method: RequestMethod,
      path: string,
      body: unknown,
      options: DecodedRequestOptions<A>
    ): Effect.Effect<A, IntegrationError>
    (
      method: RequestMethod,
      path: string,
      body?: unknown,
      options?: RequestOptions
    ): Effect.Effect<unknown, IntegrationError>
  }
  /**
   * Follows `Link: rel="next"` and concatenates the pages.
   *
   * The walk is bounded: `perPage` defaults to {@link MAX_PER_PAGE} and
   * `maxPages` to {@link DEFAULT_MAX_PAGES}, so the default ceiling is a
   * thousand items. Hitting the ceiling is reported as `truncated`, never as a
   * short but complete answer, because a caller that reconciles against a
   * truncated list plans work for resources it simply did not see.
   * `withNext: true` includes the outstanding cursor URL as `next`, or `null` at the end.
   */
  readonly paginate: (
    path: string,
    options?: {
      readonly perPage?: number | undefined
      readonly maxPages?: number | undefined
      readonly withNext?: boolean | undefined
    }
  ) => Effect.Effect<Page, IntegrationError>
  /**
   * How many items a list resource holds, and its first item, in one request.
   *
   * It starts at page one with one item (`page=1`, `per_page=1`), overriding
   * caller pagination, so the `rel="last"` link's
   * `page` is the count: a repository's branches, tags, commits or
   * contributors without walking them. A list with no `last` link holds what
   * its one page holds, zero or one item. `first` is that page's item, as
   * parsed JSON, or `undefined` for an empty list.
   */
  readonly count: (
    path: string,
    options?: RequestOptions
  ) => Effect.Effect<Count, IntegrationError>
}

/**
 * One `count` request's result.
 *
 * @category models
 * @since 1.0.0
 */
export interface Count {
  readonly total: number
  readonly first: unknown
}

/**
 * Service tag for the GitHub REST client.
 *
 * @category services
 * @since 1.0.0
 */
export const GitHubClient: Context.Service<GitHubClient, GitHubClient> = Context.Service(
  "@smthrs/integrations/GitHubClient"
)

/**
 * Whether a response is GitHub telling us to slow down.
 *
 * A 403 counts when the remaining budget is exhausted or the body names the
 * rate or abuse limit, which is how GitHub reports a secondary limit.
 *
 * @category refinements
 * @since 1.0.0
 */
export const isRateLimitResponse = (status: number, headers: Headers, body: unknown): boolean => {
  if (status === 429) return true
  if (status !== 403) return false
  if (headers.get("x-ratelimit-remaining") === "0") return true
  const message = typeof body === "object" && body !== null && "message" in body &&
      typeof (body as { message?: unknown }).message === "string"
    ? (body as { message: string }).message.toLowerCase()
    : ""
  return message.includes("rate limit") || message.includes("abuse")
}

/**
 * How long a rate limit asks a caller to wait, from `Retry-After` (whole
 * seconds) or `x-ratelimit-reset` (epoch seconds), capped at one minute. A
 * blank or malformed `Retry-After` is ignored.
 *
 * @category getters
 * @since 1.0.0
 */
export const retryAfterMs = (headers: Headers, nowMs: number = Date.now()): number | null => {
  const delay = retryAfterHeader(headers)
  if (delay !== null) return delay
  const reset = headers.get("x-ratelimit-reset")
  if (reset !== null) {
    const resetMs = Number(reset) * 1000 - nowMs
    if (Number.isFinite(resetMs) && resetMs > 0) return Math.ceil(Math.min(resetMs, MAX_RETRY_AFTER_MS))
  }
  return null
}

/**
 * A failure's `Retry-After` in full, rate limit or not, for a caller that holds its own calls for as long as GitHub
 * asked and reads a bare 403 with one as a limit. `retryAfterMillis` is the capped wait a step's retry policy honors.
 */
const retryAfterUncapped = (headers: Headers): { readonly retryAfterUncappedMillis?: number } => {
  const retryAfter = headers.get("retry-after")?.trim()
  return retryAfter !== undefined && /^\d+$/.test(retryAfter)
    ? { retryAfterUncappedMillis: Number(retryAfter) * 1000 }
    : {}
}

/**
 * When a spent rate limit resets, uncapped: `x-ratelimit-reset` as epoch
 * milliseconds, for a caller that tells a person when GitHub answers again.
 * `retryAfterMillis` is the capped wait a step's retry policy honors.
 */
const rateLimitReset = (headers: Headers): { readonly rateLimitResetAt?: number } => {
  const reset = headers.get("x-ratelimit-reset")
  return reset !== null && /^\d+$/.test(reset) ? { rateLimitResetAt: Number(reset) * 1000 } : {}
}

/**
 * The `rel="next"` URL in an RFC 5988 `Link` header, or `null`.
 *
 * @category getters
 * @since 1.0.0
 */
export const nextPageUrl = (linkHeader: string | null): string | null => linkTarget(linkHeader, "next")

// Commas can occur inside a URI or a quoted parameter. Parse link values and
// their parameters before looking for one token in the first `rel` value.
const linkTarget = (header: string | null, relation: string): string | null => {
  if (header === null) return null
  for (const link of header.matchAll(/<([^>]+)>((?:[^,<"]|"(?:\\.|[^"\\])*")*)/g)) {
    for (const parameter of link[2]!.matchAll(/;\s*([^=;\s]+)\s*=\s*(?:"((?:\\.|[^"\\])*)"|([^;\s]+))/g)) {
      if (parameter[1]!.toLowerCase() !== "rel") continue
      const relations = (parameter[2] ?? parameter[3]!).replace(/\\(.)/g, "$1").toLowerCase().split(/\s+/)
      if (relations.includes(relation)) return link[1]!
      break
    }
  }
  return null
}

/**
 * The `page` number of the `rel="last"` URL in an RFC 5988 `Link` header, or
 * `null` when there is none or it names no whole page number.
 *
 * @category getters
 * @since 1.0.0
 */
export const lastPageNumber = (linkHeader: string | null): number | null => {
  const target = linkTarget(linkHeader, "last")
  if (target === null || !URL.canParse(target, "https://api.github.com")) return null
  const page = new URL(target, "https://api.github.com").searchParams.get("page")
  return page !== null && /^[1-9]\d{0,9}$/.test(page) ? Number(page) : null
}

/**
 * A caller-supplied bound, or a typed `invalid-config` failure.
 *
 * `Infinity` as a page budget is an unbounded walk against a paid API, and a
 * fractional one silently truncates, so both are refused before the first
 * request rather than producing a strange result.
 */
const bounded = (
  name: string,
  value: number | undefined,
  fallback: number,
  min: number,
  max: number
): Effect.Effect<number, IntegrationError> => {
  if (value === undefined) return Effect.succeed(fallback)
  if (!Number.isSafeInteger(value) || value < min || value > max) {
    return Effect.fail(
      new IntegrationError(
        "invalid-config",
        `GitHub ${name} must be an integer between ${min} and ${max}.`,
        { [name]: value, retryable: false }
      )
    )
  }
  return Effect.succeed(value)
}

// Span attributes for a failed attempt: the classification, never the body.
const failureAttributes = (error: IntegrationError) =>
  Effect.annotateCurrentSpan({
    "integration.reason": error.reason,
    "http.response.status_code": error.details?.["status"] ?? null,
    "integration.retryable": error.details?.["retryable"] === true,
    "integration.rate_limited": error.details?.["rateLimited"] === true,
    "integration.retry_after_ms": error.details?.["retryAfterMillis"] ?? null,
    "integration.outcome_unknown": error.details?.["outcomeUnknown"] === true
  })

// The client over `http`. A bad config fails with an IntegrationError.
const build = effect (
  config: GitHubConfig,
  env: Readonly<Record<string, string | undefined>>,
  http: HttpClient.HttpClient
): GitHubClient!IntegrationError => {
  const resolved = resolve(config, env)
  // An App's client credentials replace any token: GitHub authenticates its
  // `/applications/{client_id}/...` endpoints with HTTP Basic. Percent-encoding
  // leaves only ASCII, which `btoa` encodes byte for byte.
  const credentials = config.clientCredentials
  const secret = credentials === undefined ? undefined : Redacted.value(credentials.clientSecret)
  const basic = credentials === undefined
    ? undefined
    : btoa([credentials.clientId, Redacted.value(credentials.clientSecret)].map(encodeURIComponent).join(":"))
  const token = basic === undefined ? resolved.token : undefined
  const integrationError = redactedError([
    token,
    token === undefined ? undefined : `Bearer ${token}`,
    secret,
    basic
  ])
  const baseUrl = resolved.apiBaseUrl.replace(/\/+$/, "")
  if (!URL.canParse(baseUrl)) {
    throw integrationError(
      "invalid-config",
      "GitHub apiBaseUrl must be a valid HTTP or HTTPS URL.",
      { apiBaseUrl: resolved.apiBaseUrl, retryable: false }
    )
  }
  const parsedBaseUrl = new URL(baseUrl)
  if (parsedBaseUrl.protocol !== "http:" && parsedBaseUrl.protocol !== "https:") {
    throw integrationError(
      "invalid-config",
      "GitHub apiBaseUrl must be a valid HTTP or HTTPS URL.",
      { apiBaseUrl: resolved.apiBaseUrl, retryable: false }
    )
  }
  const apiOrigin = parsedBaseUrl.origin
  // A zero or infinite deadline is not a deadline: the first would fail every
  // request and the second is the unbounded wait this option exists to close.
  const requestTimeout = Option.getOrUndefined(Duration.fromInput(resolved.requestTimeout))
  if (
    requestTimeout === undefined || !Duration.isFinite(requestTimeout) || Duration.toMillis(requestTimeout) <= 0
  ) {
    throw integrationError(
      "invalid-config",
      "GitHub requestTimeout must be a finite, positive duration.",
      { requestTimeout: String(resolved.requestTimeout), retryable: false }
    )
  }
  const requestTimeoutMs = Duration.toMillis(requestTimeout)

  // Every request carries the credential, so an absolute request URL and a
  // `rel="next"` target must stay on the configured API origin. A foreign
  // destination would receive the token.
  const onApiOrigin = (url: string): Effect.Effect<void, IntegrationError> => {
    const parsed = new URL(url)
    return (parsed.protocol === "http:" || parsed.protocol === "https:") && parsed.origin === apiOrigin
      ? Effect.void
      : Effect.fail(integrationError(
        "delivery-failed",
        `GitHub request refused: ${parsed.origin} is not the configured GitHub API origin.`,
        { origin: parsed.origin, apiOrigin, retryable: false }
      ))
  }

  const headers: Record<string, string> = {
    accept: "application/vnd.github+json",
    "user-agent": USER_AGENT,
    "x-github-api-version": "2022-11-28"
  }
  if (basic !== undefined) headers["authorization"] = `Basic ${basic}`
  else if (token !== undefined) headers["authorization"] = `Bearer ${token}`

  // `new URL` throws a bare TypeError for anything starting with "http" that
  // is not a URL (`httpx`, say). That throw runs before the request effect, so
  // it would escape the declared IntegrationError channel as a defect.
  const urlFor = effect (path: string, query?: RequestOptions["query"]): string!IntegrationError => {
    // Enterprise serves REST at /api/v3 and GraphQL at /api/graphql.
    const requestBase = path === "/graphql" ? baseUrl.replace(/\/api\/v3$/, "/api") : baseUrl
    const absolute = path.startsWith("http") ? path : `${requestBase}${path.startsWith("/") ? "" : "/"}${path}`
    if (!URL.canParse(absolute)) {
      throw integrationError("invalid-config", `GitHub request path is not a URL: ${path}`, {
        path,
        retryable: false
      })
    }
    const url = new URL(absolute)
    for (const [key, value] of Object.entries(query ?? {})) {
      if (value !== undefined) url.searchParams.set(key, String(value))
    }
    return url.toString()
  }


  // Serialized once, before the attempt. `JSON.stringify` throws on a cyclic
  // or unserializable body, and inside the transport attempt that throw was
  // reported as an unknown write outcome even though no request was sent.
  const encodeBody = (body: unknown): Effect.Effect<string | undefined, IntegrationError> =>
    body === undefined ? Effect.succeed(undefined) : Effect.try({
      try: () => JSON.stringify(body),
      catch: (cause) =>
        integrationError(
          "invalid-config",
          "GitHub request body could not be serialized as JSON.",
          { retryable: false, outcomeUnknown: false },
          { cause }
        )
    })

  interface Answer {
    readonly status: number
    readonly headers: Headers
    readonly json: unknown
  }

  const parseBody = (text: string): unknown => {
    if (text.length === 0) return null
    try {
      return JSON.parse(text)
    } catch {
      return text
    }
  }

  // One request, never repeated: a step's retry policy repeats the step.
  const requestOnce = (
    method: RequestMethod,
    url: string,
    body?: string,
    retryUnsafeWrites: boolean = false
  ): Effect.Effect<{ readonly json: unknown; readonly headers: Headers }, IntegrationError> => {
    // A rate limit is a refusal: the request was not performed, so repeating
    // it is safe for every verb. A 5xx or a dropped connection on a write is
    // not, because GitHub may have applied it and lost the answer.
    const unsafeWrite = UNSAFE_METHODS.includes(method)
    const mayRepeatAmbiguously = retryUnsafeWrites || !unsafeWrite
    const request = HttpClientRequest.make(method)(url, { headers })
    // Answered, not followed: `http` does not follow a redirect, which would
    // re-send the token to whatever host its Location names. A 3xx fails below
    // as non-2xx.
    const exchange: Effect.Effect<Answer, IntegrationError> = http.execute(
      body === undefined ? request : HttpClientRequest.bodyText(request, body, "application/json")
    ).pipe(
      // The transport's default span includes the full URL and query. The
      // enclosing GitHub span records only method, status and classification.
      Effect.provideService(HttpClient.TracerDisabledWhen, () => true),
      Effect.tap((response) => Effect.annotateCurrentSpan("http.response.status_code", response.status)),
      Effect.flatMap((response) =>
        Effect.map(response.text, (text) => ({
          status: response.status,
          headers: webHeaders(response.headers),
          json: parseBody(text)
        }))
      ),
      Effect.mapError((error) => {
        const cause = transportCause(error)
        return integrationError(
          "delivery-failed",
          `GitHub request failed: ${method} - ${cause instanceof Error ? cause.message : String(cause)}${
            unsafeWrite ? " (outcome unknown: the write may have been applied)" : ""
          }`,
          { method, retryable: mayRepeatAmbiguously, outcomeUnknown: unsafeWrite },
          { cause }
        )
      }),
      // The deadline spans the whole exchange, headers and body alike. The
      // timeout interrupts the attempt, which aborts the request and closes
      // the socket, so a stalled peer stops holding the caller. On a write it
      // is the same ambiguity a dropped connection is: GitHub may have applied
      // it, so the outcome is reported as unknown rather than repeated.
      Effect.timeoutOrElse({
        duration: requestTimeout,
        orElse: () =>
          Effect.fail(integrationError(
            "delivery-failed",
            `GitHub request timed out after ${requestTimeoutMs} ms: ${method}${
              unsafeWrite ? " (outcome unknown: the write may have been applied)" : ""
            }`,
            {
              method,
              retryable: mayRepeatAmbiguously,
              outcomeUnknown: unsafeWrite,
              timedOut: true,
              requestTimeoutMs
            }
          ))
      })
    )
    return onApiOrigin(url).pipe(
      Effect.andThen(exchange),
      Effect.flatMap((answer) => {
        const { status, headers, json } = answer
        // GraphQL can refuse a whole request with HTTP 200. Classify before
        // decoding so the step retains the server's wait. Partial data may
        // contain applied mutations, so it is not a known-safe refusal.
        const rateLimited = isRateLimitResponse(status, headers, json) ||
          ((status === 200 || status === 403) && /\/graphql$/.test(new URL(url).pathname) &&
            typeof json === "object" && json !== null && (!("data" in json) || json.data === null) &&
            "errors" in json && Array.isArray(json.errors) && json.errors.some((error: unknown) =>
              isRateLimitResponse(403, headers, error) ||
              (typeof error === "object" && error !== null && "type" in error && error.type === "RATE_LIMITED")
            ))
        if (status >= 200 && status < 300 && !rateLimited) {
          return Effect.succeed({ json: answer.json, headers: answer.headers })
        }
        // The GitHub proxy refused to wait that long: nothing was sent to
        // GitHub, and a retry before the instant it names only waits again.
        const proxyRetryAt = status === 429 ? Date.parse(headers.get(PROXY_RETRY_AT) ?? "") : Number.NaN
        if (Number.isFinite(proxyRetryAt)) {
          return Effect.fail(integrationError(
            "rate-limited",
            `GitHub request deferred by the rate limit: ${method} ${new URL(url).pathname} until ${
              new Date(proxyRetryAt).toISOString()
            }`,
            {
              status,
              method,
              path: new URL(url).pathname,
              reason: headers.get(PROXY_REASON),
              retryAt: new Date(proxyRetryAt).toISOString(),
              retryable: false,
              rateLimited: true,
              outcomeUnknown: false
            }
          ))
        }
        const serverError = status >= 500
        const outcomeUnknown = serverError && unsafeWrite && !rateLimited
        const retryable = rateLimited || (serverError && mayRepeatAmbiguously)
        // The wait the engine honors before another attempt. Only a rate limit
        // reads `x-ratelimit-reset`, which every response carries and which
        // says nothing about when a 5xx clears.
        const wait = rateLimited ? retryAfterMs(headers) : serverError ? retryAfterHeader(headers) : null
        const message = typeof json === "object" && json !== null && "message" in json
          ? ` ${String(json.message)}`
          : ""
        return Effect.fail(integrationError(
          "delivery-failed",
          `GitHub request failed: ${method} ${new URL(url).pathname} -> ${status}${message}${
            outcomeUnknown ? " (outcome unknown: the write may have been applied)" : ""
          }`,
          {
            status,
            method,
            path: new URL(url).pathname,
            retryable,
            rateLimited,
            outcomeUnknown,
            ...(wait === null ? {} : { retryAfterMillis: wait }),
            ...(rateLimited ? rateLimitReset(headers) : {}),
            ...retryAfterUncapped(headers),
            ratelimitRemaining: headers.get("x-ratelimit-remaining")
          }
        ))
      })
    )
  }

  const requestUrl = (
    method: RequestMethod,
    url: string,
    body?: string,
    retryUnsafeWrites?: boolean
  ): Effect.Effect<{ readonly json: unknown; readonly headers: Headers }, IntegrationError> =>
    requestOnce(method, url, body, retryUnsafeWrites).pipe(
      Effect.tapError((error) => failureAttributes(error)),
      Effect.withSpan("GitHubClient.request", {
        attributes: { "http.request.method": method }
      })
    )

  function request<A>(
    method: RequestMethod,
    path: string,
    body: unknown,
    options: DecodedRequestOptions<A>
  ): Effect.Effect<A, IntegrationError>
  function request(
    method: RequestMethod,
    path: string,
    body?: unknown,
    options?: RequestOptions
  ): Effect.Effect<unknown, IntegrationError>
  function request(
    method: RequestMethod,
    path: string,
    body?: unknown,
    options?: RequestOptions & { readonly schema?: Schema.Schema<any> | undefined }
  ): Effect.Effect<unknown, IntegrationError> {
    return Effect.all([urlFor(path, options?.query), encodeBody(body)]).pipe(
      Effect.flatMap(([url, encoded]) => requestUrl(method, url, encoded, options?.retryUnsafeWrites)),
      Effect.flatMap(({ json }) => {
        const schema = options?.schema
        if (schema === undefined) return Effect.succeed(json)
        return (Schema.decodeUnknownEffect(schema)(json) as Effect.Effect<unknown, unknown>).pipe(
          Effect.mapError((cause) =>
            integrationError(
              "decode-failed",
              `GitHub response for ${method} ${path} failed schema validation.`,
              { method, path },
              { cause }
            )
          )
        )
      })
    )
  }

  // A link target is resolved against the page that named it (RFC 8288), so a
  // relative `</x?page=2>` stays on that page's origin. A target that is not a
  // URL is the server's error; without this check `new URL` in the next
  // request's span threw a bare TypeError, a defect outside the declared channel.
  const resolveNext = (next: string | null, current: string): Effect.Effect<string | null, IntegrationError> => {
    if (next === null) return Effect.succeed(null)
    if (URL.canParse(next, current)) return Effect.succeed(new URL(next, current).toString())
    return Effect.fail(integrationError(
      "delivery-failed",
      `GitHub pagination failed: the rel="next" link target is not a URL.`,
      { path: new URL(current).pathname, retryable: false }
    ))
  }

  const paginate: GitHubClient["paginate"] = (path, options) =>
    (effect {
      const perPage = try bounded("perPage", options?.perPage, MAX_PER_PAGE, 1, MAX_PER_PAGE)
      const maxPages = try bounded("maxPages", options?.maxPages, DEFAULT_MAX_PAGES, 1, MAX_PAGES_LIMIT)
      const items: Array<unknown> = []
      let url: string | null = try urlFor(path, { per_page: perPage })
      let pages = 0
      while (url !== null && pages < maxPages) {
        const page: { readonly json: unknown; readonly headers: Headers } = try requestUrl("GET", url)
        if (Array.isArray(page.json)) items.push(...page.json)
        else if (page.json !== null) items.push(page.json)
        url = try resolveNext(nextPageUrl(page.headers.get("link")), url)
        pages += 1
      }
      try Effect.annotateCurrentSpan({ "github.pages": pages, "github.truncated": url !== null })
      return { items, truncated: url !== null, ...(options?.withNext === true ? { next: url } : {}) }
    }).pipe(Effect.withSpan("GitHubClient.paginate"))

  const count: GitHubClient["count"] = (path, options) =>
    (effect {
      const url = try urlFor(path, { ...options?.query, per_page: 1, page: 1 })
      const page = try requestUrl("GET", url)
      const items = Array.isArray(page.json) ? page.json : page.json === null ? [] : [page.json]
      const total = lastPageNumber(page.headers.get("link")) ?? items.length
      try Effect.annotateCurrentSpan({ "github.count": total })
      return { total, first: items[0] }
    }).pipe(Effect.withSpan("GitHubClient.count"))

  return GitHubClient.of({ request, paginate, count })
}

/**
 * Builds a REST client bound to `config`, over the `HttpClient` in context.
 *
 * `env` is the fallback source for anything `config` omits. Passing one
 * replaces the ambient environment rather than layering over it, so a caller
 * that supplies its own credentials cannot be surprised by an ambient
 * `GITHUB_TOKEN` deciding which account a call runs as.
 *
 * A malformed `apiBaseUrl` or `requestTimeout` fails with an `invalid-config`
 * `IntegrationError`. Provide the `HttpClient` with
 * `FetchHttpClient.layer` from `effect/http`, or a client of your own; the
 * client answers a redirect rather than following it, whichever you pass.
 *
 * @example
 * ```ts
 * import { GitHub } from "@smthrs/integrations"
 * import { Effect } from "effect"
 * import { FetchHttpClient } from "effect/http"
 *
 * const viewer = Effect.gen(function*() {
 *   const client = yield* GitHub.GitHubClient.make({})
 *   return yield* client.request("GET", "/user")
 * }).pipe(Effect.provide(FetchHttpClient.layer))
 * ```
 *
 * @category constructors
 * @since 1.0.0
 */
export const make = (
  config: GitHubConfig = {},
  env: Readonly<Record<string, string | undefined>> = Environment.ambientEnvironment()
): Effect.Effect<GitHubClient, IntegrationError, HttpClient.HttpClient> =>
  Effect.flatMap(Effect.service(HttpClient.HttpClient), (http) => build(config, env, forCredentials(http)))

/**
 * Layer for a client bound to `config`, over the `HttpClient` in context.
 *
 * @example
 * ```ts
 * import { GitHub } from "@smthrs/integrations"
 * import { Layer } from "effect"
 * import { FetchHttpClient } from "effect/http"
 *
 * const github = GitHub.GitHubClient.layer({}).pipe(Layer.provide(FetchHttpClient.layer))
 * ```
 *
 * @category layers
 * @since 1.0.0
 */
export const layer = (
  config: GitHubConfig = {},
  env: Readonly<Record<string, string | undefined>> = Environment.ambientEnvironment()
): Layer.Layer<GitHubClient, IntegrationError, HttpClient.HttpClient> => Layer.effect(GitHubClient)(make(config, env))
