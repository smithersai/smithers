// Fork support for a person's review change, over the shared GitHub Effect client.
import { GitHubClient } from "./GitHubClient.ts"
import { IntegrationError } from "../core/IntegrationError.ts"
import { requireRepositoryPath } from "./Repository.ts"
export const Fork = Schema.Struct({ name: Schema.String, owner: Schema.Struct({ login: Schema.String }), default_branch: Schema.String })
/** Use the owner's repository or this person's actual fork. Base proposals on the upstream default branch. */
export effect function ensureFork(owner: string, repo: string, login: string) {
  const client = try GitHubClient
  const source = try requireRepositoryPath(owner, repo)
  const target = try requireRepositoryPath(login, repo)
  const upstream = try client.request("GET", `/repos/${source}`, undefined, { schema: Fork })
  if (owner.toLowerCase() === login.toLowerCase()) return { ...upstream, sourceDefaultBranch: upstream.default_branch }
  const existing = try Effect.result(client.request("GET", `/repos/${target}`, undefined, { schema: Schema.Struct({ ...Fork.fields, fork: Schema.Boolean, parent: Schema.optionalKey(Schema.Struct({ full_name: Schema.String })) }) }))
  if (existing._tag === "Success" && existing.success.fork && existing.success.parent?.full_name.toLowerCase() === `${owner}/${repo}`.toLowerCase()) return { ...existing.success, sourceDefaultBranch: upstream.default_branch }
  if (existing._tag === "Success") throw new IntegrationError("invalid-config", "The proposal repository name is already occupied.")
  if (existing._tag === "Failure" && existing.failure.details?.status !== 404) throw existing.failure
  const prepared = try client.request("POST", `/repos/${source}/forks`, { default_branch_only: true }, { schema: Fork })
  return { ...prepared, sourceDefaultBranch: upstream.default_branch }
}
