import { Action, RetryPolicy } from "@smthrs/flow"
import * as Policy from "./AuthBrokerPolicy.vibe"
import type * as Auth from "./Auth.vibe"
import * as CookieKeys from "../core/CookieKeys.vibe"
import * as Pkce from "../core/Pkce.ts"
import { forCredentials } from "../core/CredentialHttp.ts"
import { WebCryptoCipher } from "@smthrs/control"
import { HttpClient, HttpClientRequest, HttpServerRequest, HttpServerResponse, UrlParams } from "effect/http"

/** Install in the host request context, before the HTTP tracer; query values include CSRF-sensitive state. */
export const httpPolicy = Layer.succeed(UrlParams.CurrentRedactedNames, [/.*/])

export const START = "/api/auth/broker/start"
export const EXCHANGE = "/api/auth/broker/exchange"
export const CALLBACK = "/api/auth/callback"
export const CONSENT = "/api/auth/broker/consent"
export const STATE_PREFIX = "broker_"
export const HEADERS = { "cache-control": "no-store", "referrer-policy": "no-referrer" }
export const REQUEST_TTL = 600_000
export const CODE_TTL = 60_000
export error BrokerRefused {}
export interface HostedSite { readonly origin: string; readonly secret: Redacted.Redacted<string> }
export type Keys = Effect.Success<ReturnType<typeof CookieKeys.make>>
/** Atomic, durable host boundary. Values are encrypted; keys and bindings are SHA-256 digests. */
export interface Store {
  readonly insert: (key: string, binding: string, value: string, expires: number) => boolean!BrokerRefused
  readonly take: (key: string, binding: string, now: number) => (string | undefined)!BrokerRefused
  /** Reads a live record and leaves it in place. */
  readonly peek: (key: string, binding: string, now: number) => (string | undefined)!BrokerRefused
}

/** Exact origins only. Even a real smithers.sh subdomain must appear in the deployment's hosted-site registry. */
export function canonicalOrigin(value: string, localDevelopment = false): boolean {
  try {
    const url = new URL(value)
    return url.origin === value &&
      (url.protocol === "https:" || (localDevelopment && url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)))
  } catch { return false }
}
export function allowedOrigin(value: string, sites: ReadonlyArray<HostedSite>, localDevelopment = false): boolean {
  return canonicalOrigin(value, localDevelopment) && sites.some(site => site.origin === value)
}

schema ConnectIntent { readonly person: number }
schema Claims {
  readonly origin: string
  readonly nonce: string
  readonly challenge: string
  readonly expires: number
  readonly connect?: ConnectIntent
}
schema Redemption {
  readonly origin: string
  readonly nonce: string
  readonly verifier: string
  readonly code: string
  readonly expires: number
}
schema Attempt { readonly claims: Claims; readonly verifier: string; readonly expires: number }
export schema Identity { readonly id: number; readonly login: string; readonly delegation?: string; readonly expires?: number }
schema Handoff { readonly claims: Claims; readonly expires: number; readonly person: Identity }
schema Consent { readonly claims: Claims; readonly expires: number; readonly person: Identity; readonly access: string; readonly refresh: string | null; readonly tokenExpires: number | null }
/** The per-person credential custodian. It answers a handle, never a token. */
export interface Connections {
  readonly install: (input: { readonly person: number; readonly origin: string; readonly login: string; readonly tokens: Auth.Tokens }) => { readonly delegation: string; readonly expires: number }!BrokerRefused
}
const decodeClaims = Schema.decodeUnknownEffect(Schema.fromJsonString(Claims))
const decodeRedemption = Schema.decodeUnknownEffect(Schema.fromJsonString(Redemption))
const decodeAttempt = Schema.decodeUnknownEffect(Schema.fromJsonString(Attempt))
const decodeHandoff = Schema.decodeUnknownEffect(Schema.fromJsonString(Handoff))
const decodeConsent = Schema.decodeUnknownEffect(Schema.fromJsonString(Consent))
const random = /^[A-Za-z0-9_-]{43}$/
// Digests arbitrary strings through the existing HMAC primitive, with a fixed public domain separator.
import * as Signature from "../core/Signature.ts"
const hash = (value: string) => Signature.computeHmacSha256Hex(value, "smithers-auth-broker-digest-v1")
const binding = (origin: string, nonce: string, challenge: string) => hash(JSON.stringify([origin, nonce, challenge]))
const refused = () => new BrokerRefused()
const checked = <A, E, R>(body: A!E!R) => Effect.mapError(body, refused)

/** Every observable field is fixed vocabulary; never record a URL, signature, code, nonce, identity or key. */
export function observed<A, E, R>(step: string, body: A!E!R) {
  return withSpan(Effect.tapError(Effect.tap(body, () => record(step, "accepted")), () => record(step, "refused")), "auth.broker." + step)
}
effect function record(step: string, outcome: string) {
  try Metric.update(Metric.withAttributes(Metric.counter("smithers_auth_broker_steps", { incremental: true }), { step, outcome }), 1)
  try Effect.logInfo("auth.broker").pipe(Effect.annotateLogs({ step, outcome }))
}

const revocationRetry = RetryPolicy.make({ initialMs: 100, factor: 2, maxMs: 1_000, maxAttempts: 3 })

/** A token stays in the identity step's closure; the cleanup action journals only null or a fixed failure. */
effect function discard(github: Auth.GitHubAuth["Service"], token: Redacted.Redacted<string>) {
  const revocation = try Effect.orDie(Effect.try(() => Action.make({
    name: "auth/broker/revoke", success: Schema.Null, error: Schema.Null,
    retryPolicy: revocationRetry,
    execute: Effect.as(Effect.mapError(github.revoke(token), () => null), null),
  })))
  try withSpan(effect {
    const outcome = revocation catch effect () => {
      try Metric.update(Metric.counter("smithers_auth_broker_revocation_failures", { incremental: true }), 1)
      try Effect.logWarning("auth.broker.revoke").pipe(Effect.annotateLogs({ outcome: "failed" }))
      return "failed"
    }
    if (outcome === "failed") return
    try Metric.update(Metric.counter("smithers_auth_broker_revocations", { incremental: true }), 1)
    try Effect.logInfo("auth.broker.revoke").pipe(Effect.annotateLogs({ outcome: "revoked" }))
  }, "auth.broker.revoke")
}

/** Real in-memory atomic store, useful for ephemeral hosts and protocol unit tests. Hosted brokers require durability. */
export effect function memoryStore(): Store!! {
  const rows = try Ref.make(new Map<string, { binding: string; value: string; expires: number }>())
  return {
    peek: (key, binding, now) => Ref.get(rows).pipe(Effect.map(rows => {
      const row = rows.get(key)
      return row === undefined || !Policy.liveRecord(row.binding, binding, row.expires, now) ? undefined : row.value
    })),
    insert: (key, binding, value, expires) => Ref.modify(rows, rows => {
      if (rows.has(key)) return [false, rows]
      const next = new Map(rows)
      next.set(key, { binding, value, expires })
      return [true, next]
    }),
    take: (key, binding, now) => Ref.modify(rows, rows => {
      const row = rows.get(key)
      if (row === undefined || !Policy.liveRecord(row.binding, binding, row.expires, now)) return [undefined, rows]
      const next = new Map(rows)
      next.delete(key)
      return [row.value, next]
    }),
  }
}

export effect function site(options: { readonly origin: string; readonly brokerOrigin: string; readonly secret: Redacted.Redacted<string>; readonly localDevelopment?: boolean }) {
  if (!canonicalOrigin(options.origin, options.localDevelopment) || !canonicalOrigin(options.brokerOrigin, options.localDevelopment) || Redacted.value(options.secret).length < 32) throw refused()
  const keys = try CookieKeys.make({ primary: options.secret }, "primary")
  const sign = (purpose: string, claims: unknown) => keys.sign(purpose, JSON.stringify(claims))
  return {
    begin: (intent?: { readonly connect: ConnectIntent }) => observed("site_start", effect {
      const pair = try checked(Pkce.createPkcePair())
      const claims: Claims = { origin: options.origin, nonce: try keys.token, challenge: pair.codeChallenge, expires: (try Clock.currentTimeMillis) + REQUEST_TTL, ...(intent === undefined ? {} : { connect: intent.connect }) }
      const returnTo = try sign("broker_return", claims)
      return { claims, verifier: pair.codeVerifier, returnTo, location: options.brokerOrigin + START + "?" + new URLSearchParams({ origin: options.origin, return_to: returnTo }) }
    }),
    redemption: (pending: { readonly claims: Claims; readonly verifier: string }, code: string) => sign("broker_exchange", {
      origin: options.origin, nonce: pending.claims.nonce, verifier: pending.verifier, code, expires: pending.claims.expires,
    }),
    exchange: (signed: string) => observed("site_exchange", effect {
      const ambient = try HttpClient.HttpClient
      const http = try checked(Effect.try(() => forCredentials(ambient)))
      const response = try checked(http.execute(HttpClientRequest.post(options.brokerOrigin + EXCHANGE).pipe(
        HttpClientRequest.bodyJsonUnsafe({ origin: options.origin, request: signed }),
      )))
      if (response.status !== 200) throw refused()
      const identity = try checked(Schema.decodeUnknownEffect(Identity)(try checked(response.json)))
      if (!Number.isSafeInteger(identity.id) || identity.id <= 0 || !/^[a-zA-Z0-9-]{1,39}$/.test(identity.login)) throw refused()
      return identity
    }).pipe(Effect.provideService(HttpClient.TracerDisabledWhen, () => true)),
  }
}

/** Protocol only: hosts journal operations and provide the store's atomicity and encrypted-at-rest key. */
export effect function make(options: {
  readonly origin: string; readonly sites: ReadonlyArray<HostedSite>; readonly keys: Keys; readonly store: Store
  readonly encryptionKey: Redacted.Redacted<string>; readonly github: Auth.GitHubAuth["Service"]; readonly localDevelopment?: boolean
  readonly connections?: Connections
}) {
  if (!canonicalOrigin(options.origin, options.localDevelopment) || new Set(options.sites.map(site => site.origin)).size !== options.sites.length || new Set(options.sites.map(site => Redacted.value(site.secret))).size !== options.sites.length || options.sites.some(site => !canonicalOrigin(site.origin, options.localDevelopment) || Redacted.value(site.secret).length < 32)) throw refused()
  const cipher = try checked(WebCryptoCipher.make({ key: options.encryptionKey }))
  const context = (key: string) => ({ id: key, name: "auth_broker", version: 1 })
  const seal = effect (key: string, value: unknown) => JSON.stringify(try checked(cipher.seal(Redacted.make(JSON.stringify(value)), context(key))))
  const open = effect (key: string, value: string) => {
    const sealed = try checked(Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ nonce: Schema.String, ciphertext: Schema.String })))(value))
    return Redacted.value(try checked(cipher.open(sealed, context(key))))
  }
  const fresh = effect (expires: number, ttl: number) => {
    const now = try Clock.currentTimeMillis
    if (!Number.isSafeInteger(expires) || !Policy.validDeadline(expires, now, ttl)) throw refused()
    return now
  }
  const verify = effect (origin: string, purpose: string, signed: string) => {
    if (!allowedOrigin(origin, options.sites, options.localDevelopment) || signed.length > 4096) throw refused()
    const site = options.sites.find(site => site.origin === origin)!
    const keys = try CookieKeys.make({ primary: site.secret }, "primary")
    const verified = try keys.verify(purpose, signed)
    if (Option.isNone(verified)) throw refused()
    return verified.value.value
  }
  const discard = (token: Redacted.Redacted<string>) => options.github.revoke(token).pipe(Effect.catch(() => record("revoke", "failed")))
  const openConsent = effect (consent: string, cookie: string | undefined, take: boolean) => {
    if (!random.test(consent)) throw refused()
    const browser = try options.keys.verify("broker_consent", cookie)
    if (Option.isNone(browser) || browser.value.value !== consent) throw refused()
    const key = "consent/" + (try hash(consent))
    const digest = try hash(consent)
    const stored = try (take ? options.store.take : options.store.peek)(key, digest, try Clock.currentTimeMillis)
    if (stored === undefined) throw refused()
    const parsed = try checked(decodeConsent(try open(key, stored)))
    try fresh(parsed.expires, REQUEST_TTL)
    return parsed
  }
  const writeHandoff = effect (claims: Claims, person: Identity) => {
    const handoff = try options.keys.token
    const codeKey = "code/" + (try hash(handoff))
    const expires = (try Clock.currentTimeMillis) + CODE_TTL
    if (!(try options.store.insert(codeKey, try binding(claims.origin, claims.nonce, claims.challenge), try seal(codeKey, { claims, expires, person }), expires))) throw refused()
    return claims.origin + CALLBACK + "#" + new URLSearchParams({ code: handoff, state: claims.nonce })
  }
  return {
    consentCookie: (consent: string) => options.keys.sign("broker_consent", consent),
    consentPage: (consent: string, cookie: string | undefined) => observed("consent_page", effect {
      const parsed = try openConsent(consent, cookie, false)
      return { html: consentHtml(new URL(parsed.claims.origin).host, parsed.person.login, consent) }
    }),
    /** The only step that installs a credential: same-origin POST, once. GitHub skips its own prompt for an authorized person. */
    consent: (consent: string, answer: "connect" | "cancel", cookie: string | undefined) => observed("consent", effect {
      const parsed = try openConsent(consent, cookie, true)
      const tokens: Auth.Tokens = { accessToken: Redacted.make(parsed.access), refreshToken: parsed.refresh === null ? null : Redacted.make(parsed.refresh), expiresAt: parsed.tokenExpires }
      if (answer === "cancel" || options.connections === undefined) {
        try discard(tokens.accessToken)
        return parsed.claims.origin + "/"
      }
      const installed = try options.connections.install({ person: parsed.person.id, origin: parsed.claims.origin, login: parsed.person.login, tokens })
      return try writeHandoff(parsed.claims, { id: parsed.person.id, login: parsed.person.login, delegation: installed.delegation, expires: installed.expires })
    }),
    start: (origin: string, signed: string) => observed("start", effect {
      const claims = try checked(decodeClaims(try verify(origin, "broker_return", signed)))
      const now = try fresh(claims.expires, REQUEST_TTL)
      if (claims.origin !== origin || !random.test(claims.nonce) || !random.test(claims.challenge) || (claims.connect !== undefined && options.connections === undefined)) throw refused()
      const requestKey = "request/" + (try hash(signed))
      if (!(try options.store.insert(requestKey, "used", "", claims.expires))) throw refused()
      const state = STATE_PREFIX + (try options.keys.token)
      const key = "attempt/" + (try hash(state))
      const pair = try checked(Pkce.createPkcePair())
      const expires = Math.min(claims.expires, now + REQUEST_TTL)
      const stored = try seal(key, { claims, verifier: pair.codeVerifier, expires })
      if (!(try options.store.insert(key, try hash(state), stored, expires))) throw refused()
      return { location: options.github.authorizeUrl({ state, codeChallenge: pair.codeChallenge, redirectUri: options.origin + CALLBACK }), cookie: try options.keys.sign("broker_browser", state) }
    }),
    callback: (state: string, code: string, cookie: string | undefined) => observed("callback", effect {
      if (!callbackState(state) || code.length === 0 || code.length > 4096) throw refused()
      const browser = try options.keys.verify("broker_browser", cookie)
      if (Option.isNone(browser) || browser.value.value !== state) throw refused()
      const key = "attempt/" + (try hash(state))
      const stored = try options.store.take(key, try hash(state), try Clock.currentTimeMillis)
      if (stored === undefined) throw refused()
      const pending = try checked(decodeAttempt(try open(key, stored)))
      try fresh(pending.expires, REQUEST_TTL)
      if (!allowedOrigin(pending.claims.origin, options.sites, options.localDevelopment)) throw refused()
      const tokens = try checked(options.github.exchange({ code: Redacted.make(code), codeVerifier: Redacted.make(pending.verifier), redirectUri: options.origin + CALLBACK }))
      const person = try ensuring(checked(options.github.user(tokens.accessToken)), discard(options.github, tokens.accessToken))
      if (!Number.isSafeInteger(person.id) || person.id <= 0 || !/^[a-zA-Z0-9-]{1,39}$/.test(person.login)) throw refused()
      if (pending.claims.connect !== undefined) {
        // GitHub keeps ten tokens per person and App: every token the connection does not keep is revoked.
        if (person.id !== pending.claims.connect.person) { try discard(tokens.accessToken); throw refused() }
        const consent = try options.keys.token
        const consentKey = "consent/" + (try hash(consent))
        const consentExpires = (try Clock.currentTimeMillis) + REQUEST_TTL
        if (!(try options.store.insert(consentKey, try hash(consent), try seal(consentKey, { claims: pending.claims, expires: consentExpires, person: { id: person.id, login: person.login }, access: Redacted.value(tokens.accessToken), refresh: tokens.refreshToken === null ? null : Redacted.value(tokens.refreshToken), tokenExpires: tokens.expiresAt }), consentExpires))) throw refused()
        return options.origin + CONSENT + "?" + new URLSearchParams({ consent })
      }
      try discard(tokens.accessToken)
      return try writeHandoff(pending.claims, { id: person.id, login: person.login })
    }),
    exchange: (origin: string, signed: string) => observed("exchange", effect {
      const claims = try checked(decodeRedemption(try verify(origin, "broker_exchange", signed)))
      const now = try fresh(claims.expires, REQUEST_TTL)
      if (claims.origin !== origin || !random.test(claims.nonce) || !random.test(claims.code)) throw refused()
      const challenge = try checked(Pkce.deriveCodeChallenge(claims.verifier))
      const key = "code/" + (try hash(claims.code))
      const stored = try options.store.take(key, try binding(origin, claims.nonce, challenge), now)
      if (stored === undefined) throw refused()
      const handoff = try checked(decodeHandoff(try open(key, stored)))
      if (handoff.claims.origin !== origin || handoff.claims.nonce !== claims.nonce || handoff.claims.challenge !== challenge) throw refused()
      try fresh(handoff.expires, CODE_TTL)
      return handoff.person
    }),
  }
}

/** The fragment never reaches HTTP/access logs; erase it before submitting a same-origin POST. No third-party assets. */
export const HANDOFF_PAGE = `<!doctype html><meta name="referrer" content="no-referrer"><title>Sign in</title><script>
const p=new URLSearchParams(location.hash.slice(1));history.replaceState(null,"",location.pathname);
fetch(location.pathname,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({code:p.get("code"),state:p.get("state")})}).then(r=>r.ok?r.json():{location:"/?sign-in=failed"}).then(a=>location.replace(a.location||"/")).catch(()=>location.replace("/?sign-in=failed"));
</script>`
export const HANDOFF_CSP = "default-src 'none'; script-src 'sha256-GIDYQwpM0yJZjomirUAQiFzuA0To64XMN+VUcwhLmyM='; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`)
export function consentHtml(host: string, login: string, consent: string): string {
  return `<!doctype html><meta name="referrer" content="no-referrer"><title>Connect GitHub</title><form method="post"><input type="hidden" name="consent" value="${escapeHtml(consent)}"><p>Connect ${escapeHtml(host)} to GitHub as @${escapeHtml(login)}?</p><button name="answer" value="connect">Connect</button> <button name="answer" value="cancel">Cancel</button></form>`
}
export const CONSENT_CSP = "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"

/** Shared route adapter; the host runs each invocation as a durable step. No redirect from an unverified request. */
export effect function serve<R>(broker: Omit<Effect.Success<ReturnType<typeof make>>, "callback"> & {
  readonly callback: (state: string, code: string, cookie: string | undefined) => string!BrokerRefused!R
}, origin: string) {
  const request = try HttpServerRequest.HttpServerRequest
  const url = new URL(request.originalUrl, origin)
  const cookieName = origin.startsWith("https:") ? "__Host-smithers-broker" : "smithers-broker"
  const bad = () => HttpServerResponse.jsonUnsafe({ error: "sign-in" }, { status: 400, headers: HEADERS })
  if (url.origin !== origin) return bad()
  const cookie = (response: HttpServerResponse.HttpServerResponse, value: string, age: number) => HttpServerResponse.setCookieUnsafe(response, cookieName, value, {
    httpOnly: true, secure: origin.startsWith("https:"), sameSite: "lax", path: "/", maxAge: Duration.millis(age),
  })
  return (effect {
    if (url.pathname === START && request.method === "GET") {
      const start = try broker.start(url.searchParams.get("origin") ?? "", url.searchParams.get("return_to") ?? "")
      return cookie(HttpServerResponse.redirect(start.location, { status: 303, headers: HEADERS }), start.cookie, REQUEST_TTL)
    }
    if (url.pathname === CALLBACK && request.method === "GET") {
      const location = try broker.callback(url.searchParams.get("state") ?? "", url.searchParams.get("code") ?? "", request.cookies[cookieName])
      const pendingConsent = location.startsWith(origin + CONSENT) ? new URL(location).searchParams.get("consent") : null
      return cookie(HttpServerResponse.redirect(location, { status: 303, headers: HEADERS }), pendingConsent === null ? "" : try broker.consentCookie(pendingConsent), pendingConsent === null ? 0 : REQUEST_TTL)
    }
    if (url.pathname === CONSENT && request.method === "GET") {
      const page = try broker.consentPage(url.searchParams.get("consent") ?? "", request.cookies[cookieName])
      return HttpServerResponse.text(page.html, { contentType: "text/html; charset=utf-8", headers: { ...HEADERS, "content-security-policy": CONSENT_CSP } })
    }
    if (url.pathname === CONSENT && request.method === "POST") {
      if (request.headers.origin !== origin || request.headers["sec-fetch-site"] !== "same-origin" || Number(request.headers["content-length"]) > 2048) return bad()
      const text = try checked(request.text.pipe(Effect.provideService(HttpServerRequest.MaxBodySize, ByteSize.bytes(2048)), Effect.timeout("3 seconds")))
      const form = new URLSearchParams(text)
      const answer = form.get("answer")
      if (answer !== "connect" && answer !== "cancel") return bad()
      return cookie(HttpServerResponse.redirect(try broker.consent(form.get("consent") ?? "", answer, request.cookies[cookieName]), { status: 303, headers: HEADERS }), "", 0)
    }
    if (url.pathname === EXCHANGE && request.method === "POST") {
      if (Number(request.headers["content-length"]) > 8192) return bad()
      const text = try checked(request.text.pipe(Effect.provideService(HttpServerRequest.MaxBodySize, ByteSize.bytes(8192)), Effect.timeout("3 seconds")))
      const body = try checked(Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ origin: Schema.String, request: Schema.String })))(text))
      return HttpServerResponse.jsonUnsafe(try broker.exchange(body.origin, body.request), { headers: HEADERS })
    }
    return HttpServerResponse.empty({ status: 405, headers: HEADERS })
  } catch () => cookie(bad(), "", 0))
}

export interface Sql {
  readonly exec: (query: string, ...bindings: Array<string | number>) => { readonly toArray: () => Array<Record<string, unknown>> }
}
/** workerd SQLite's conditional DELETE RETURNING is the single-use linearization point, across object restarts. */
export effect function sqliteStore(sql: Sql): Store!BrokerRefused {
  try checked(Effect.try(() => sql.exec("CREATE TABLE IF NOT EXISTS auth_broker_records (key TEXT PRIMARY KEY, binding TEXT NOT NULL, value TEXT NOT NULL, expires INTEGER NOT NULL)")))
  try checked(Effect.try(() => sql.exec("CREATE INDEX IF NOT EXISTS auth_broker_expiry ON auth_broker_records(expires)")))
  return {
    peek: (key, binding, now) => checked(effect {
      const rows = try Effect.try(() => sql.exec("SELECT value FROM auth_broker_records WHERE key = ? AND binding = ? AND expires > ?", key, binding, now).toArray())
      return rows.length === 1 ? String(rows[0]!.value) : undefined
    }),
    insert: (key, binding, value, expires) => checked(effect {
      // Prune expired receipts inside the journaled write, never with a background timer or retry loop.
      const now = try Clock.currentTimeMillis
      try Effect.try(() => sql.exec("DELETE FROM auth_broker_records WHERE expires <= ?", now))
      const rows = try Effect.try(() => sql.exec("INSERT INTO auth_broker_records (key,binding,value,expires) VALUES (?,?,?,?) ON CONFLICT(key) DO NOTHING RETURNING key", key, binding, value, expires).toArray())
      return rows.length === 1
    }),
    take: (key, binding, now) => checked(effect {
      const rows = try Effect.try(() => sql.exec("DELETE FROM auth_broker_records WHERE key = ? AND binding = ? AND expires > ? RETURNING value", key, binding, now).toArray())
      return rows.length === 1 ? String(rows[0]!.value) : undefined
    }),
  }
}

/** Distinguish the broker's 50-character state from the existing app's 43-character OAuth nonce. */
export function handles(url: string): boolean {
  const parsed = new URL(url, "https://broker.invalid")
  return parsed.pathname === START || parsed.pathname === EXCHANGE || parsed.pathname === CONSENT || (parsed.pathname === CALLBACK && callbackState(parsed.searchParams.get("state") ?? ""))
}

function callbackState(state: string): boolean {
  return /^broker_[A-Za-z0-9_-]{43}$/.test(state)
}
