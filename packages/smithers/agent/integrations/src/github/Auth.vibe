import * as Core from "../core.ts"
import { forCredentials, isSecureEndpoint } from "../core/CredentialHttp.ts"
import * as GitHubClient from "./GitHubClient.ts"
import { requireFullNamePath } from "./Repository.ts"
import type { HttpClient } from "effect/http"
import { HttpClient as Client } from "effect/http"

// What sign-in asks of GitHub (docs/features/sign-in.md): the Smithers GitHub App's user authorization, with PKCE S256
// and `state`, its 8-hour `ghu_` tokens and single-use `ghr_` refresh tokens, who the person is, their permission on
// the repository, and revoking a token at sign-out. It is a service, so a test injects a GitHub that refuses or fails;
// `GitHubAuth.layer` is the real one, over `@smthrs/integrations` and the `HttpClient` in context. Failures carry the
// step and a reason, never GitHub's text or a token.

/** Where GitHub's web and API live, unless set: github.com. */
export const GITHUB_WEB = "https://github.com"
export const GITHUB_API = "https://api.github.com"

/** `GITHUB_APP_SLUG`: the Smithers GitHub App's name in its URLs, `smithers` unless set: where Install goes. */
export const appSlug = Config.schema(Schema.String.check(Schema.isPattern(/^[a-z0-9][a-z0-9-]{0,99}$/)), "GITHUB_APP_SLUG")
  .pipe(Config.withDefault("smithers"))

/**
 * GitHub didn't do what sign-in asked:
 * - `rejected`: a definite no, such as a used or expired code or refresh token, or a token GitHub no longer accepts;
 * - `misconfigured`: GitHub refused the App's client id, secret or callback URL, or device flow is disabled;
 * - `unavailable`: no answer, a rate limit, a server error, or an answer outside its contract.
 */
export class GitHubRefused extends Schema.TaggedError<GitHubRefused>()("@smthrs/mvp/auth/GitHubRefused", {
  step: Schema.Literals(["exchange", "refresh", "user", "permission", "revoke", "device"]),
  reason: Schema.Literals(["rejected", "misconfigured", "unavailable"]),
}) {}

/** A user access token, when it expires (epoch ms; `null` when GitHub didn't say), and its refresh token. */
export interface Tokens {
  readonly accessToken: Redacted.Redacted<string>
  readonly expiresAt: number | null
  readonly refreshToken: Redacted.Redacted<string> | null
}

/** A person's permission on a repository, as GitHub names it; `none` when they can't see it. */
export type Permission = "admin" | "maintain" | "write" | "triage" | "read" | "none"

/**
 * What GitHub answers when a device flow starts: the code the person enters at `verificationUri`, and the device
 * code the client polls with. Starting one needs only the App's client id, so a CLI or an MCP server can sign a
 * person in on a host without a browser. The App must have device flow enabled.
 */
export interface DeviceSignIn {
  readonly deviceCode: Redacted.Redacted<string>
  readonly userCode: string
  readonly verificationUri: string
  readonly intervalSeconds: number
  readonly expiresInSeconds: number
}

/**
 * One poll of a running device flow: `pending` and `slowDown` say ask again later (after `intervalSeconds` when
 * GitHub slowed the poll down), `denied` and `expired` end the flow, and `authorized` carries the person's tokens.
 */
export type DevicePoll =
  | { readonly status: "pending" }
  | { readonly status: "slowDown"; readonly intervalSeconds: number | null }
  | { readonly status: "denied" }
  | { readonly status: "expired" }
  | { readonly status: "authorized"; readonly tokens: Tokens }

export service GitHubAuth {
  static readonly key = "@smthrs/mvp/auth/GitHubAuth"
    /** The URL of GitHub's authorization page for one sign-in. */
    readonly authorizeUrl: (request: {
      readonly state: string
      readonly codeChallenge: string
      readonly redirectUri: string
    }) => string
    /** Redeems the code GitHub's callback carried, with the PKCE verifier and the same redirect URI. */
    readonly exchange: (request: {
      readonly code: Redacted.Redacted<string>
      readonly codeVerifier: Redacted.Redacted<string>
      readonly redirectUri: string
    }) => Tokens!GitHubRefused
    /** Trades a refresh token, once, for new tokens. */
    readonly refresh: (refreshToken: Redacted.Redacted<string>) => Tokens!GitHubRefused
    /** Who the token belongs to: GitHub's numeric id and login. */
    readonly user: (
      accessToken: Redacted.Redacted<string>,
    ) => { readonly id: number; readonly login: string }!GitHubRefused
    /** The token's person's permission on `repository` (`owner/name`). */
    readonly permission: (
      accessToken: Redacted.Redacted<string>,
      repository: string,
    ) => Permission!GitHubRefused
    /**
     * Revokes a user access token on GitHub, as the App. A token GitHub no longer has (revoked, expired or never
     * issued) counts as revoked. Fails `misconfigured` when GitHub refuses the App's client credentials.
     */
    readonly revoke: (accessToken: Redacted.Redacted<string>) => void!GitHubRefused
    /**
     * Starts GitHub's device flow: the code the person enters at `verificationUri`. Needs only the App's client
     * id; the client secret is never sent. Fails `misconfigured` when device flow is disabled or GitHub refuses the client.
     */
    readonly deviceCode: () => DeviceSignIn!GitHubRefused
    /**
     * One poll for the person's answer to a device flow. `pending` and `slowDown` are outcomes, not failures;
     * a client id GitHub refuses mid-flow fails `misconfigured`.
     */
    readonly deviceToken: (deviceCode: Redacted.Redacted<string>) => DevicePoll!GitHubRefused
  
  /**
   * The real GitHub, as the App `clientId` with `clientSecret`, over the `HttpClient` in context. `webBaseUrl` and
   * `apiBaseUrl` default to github.com.
   */
}

export const layer = (options: {
    readonly clientId: string
    readonly clientSecret: Redacted.Redacted<string>
    readonly webBaseUrl?: string
    readonly apiBaseUrl?: string
  }): Layer.Layer<GitHubAuth, never, HttpClient.HttpClient> =>
    Layer.effect(GitHubAuth, make(options))

schema User { readonly id: number; readonly login: string }

const DeviceCodeAnswer = Schema.Struct({
  device_code: Schema.NonEmptyString,
  user_code: Schema.NonEmptyString,
  verification_uri: Schema.NonEmptyString,
  expires_in: Schema.Number,
  interval: Schema.optional(Schema.Number),
})

const DeviceGrantAnswer = Schema.Struct({
  access_token: Schema.NonEmptyString,
  expires_in: Schema.optional(Schema.Number),
})

const DeviceErrorAnswer = Schema.Struct({
  error: Schema.String,
  interval: Schema.optional(Schema.Number),
})

const isDeviceMisconfigured = Schema.is(Schema.Struct({
  error: Schema.Literals(["device_flow_disabled", "incorrect_client_credentials", "unauthorized_client", "invalid_client"]),
}))

const Repository = Schema.Struct({
  permissions: Schema.optional(
    Schema.Struct({
      admin: Schema.Boolean,
      maintain: Schema.optional(Schema.Boolean),
      push: Schema.Boolean,
      triage: Schema.optional(Schema.Boolean),
      pull: Schema.Boolean,
    }),
  ),
})

/** The HTTP status an `@smthrs/integrations` failure answered with, if any. */
const statusOf = (error: Core.IntegrationError.IntegrationError) => error.details?.["status"]

/**
 * What an `@smthrs/integrations` failure means for sign-in: a refused grant, or a 401, 403 or 404 that isn't a rate
 * limit, is `rejected`; a refused client is `misconfigured`; anything else is `unavailable`.
 */
const reasonOf = (error: Core.IntegrationError.IntegrationError): GitHubRefused["reason"] => {
  if (error.reason === "permission-denied") return "rejected"
  if (error.reason === "invalid-config" || error.reason === "credentials-missing") return "misconfigured"
  const status = statusOf(error)
  return error.details?.["rateLimited"] !== true && (status === 401 || status === 403 || status === 404)
    ? "rejected"
    : "unavailable"
}

const make = effect (options: {
  readonly clientId: string
  readonly clientSecret: Redacted.Redacted<string>
  readonly webBaseUrl?: string
  readonly apiBaseUrl?: string
}) => {
  const web = options.webBaseUrl ?? GITHUB_WEB
  const apiBaseUrl = options.apiBaseUrl ?? GITHUB_API
  const endpoint = {
    tokenUrl: `${web}/login/oauth/access_token`,
    clientId: options.clientId,
    clientSecret: options.clientSecret,
    provider: "GitHub",
  }
  // The services the `@smthrs/integrations` calls need: the caller's `HttpClient`.
  const context = try (Effect.context<HttpClient.HttpClient>() |> withUserAgent(%))
  // Translate the typed transport failure into a fresh public failure; transport traces stay on the client span.
  const refused = (step: GitHubRefused["step"]) => (error: Core.IntegrationError.IntegrationError) =>
    new GitHubRefused({ step, reason: reasonOf(error) })
  const tokens = (grant: Core.OAuthToken.Grant) =>
    Effect.map(Clock.currentTimeMillis, (now): Tokens => ({
      accessToken: grant.accessToken,
      expiresAt: grant.expiresInSeconds === null ? null : now + grant.expiresInSeconds * 1000,
      refreshToken: grant.refreshToken,
    }))
  // A client acting as the person, never the ambient environment's token.
  const asPerson = (accessToken: Redacted.Redacted<string>) =>
    GitHubClient.make({ token: Redacted.value(accessToken), apiBaseUrl }, {})
  // A client acting as the App's OAuth client (HTTP Basic), for `/applications/<client id>/...`.
  const asApp = GitHubClient.make({
    clientCredentials: { clientId: options.clientId, clientSecret: options.clientSecret },
    apiBaseUrl,
  }, {})

  const decodeDeviceStart = Schema.decodeUnknownEffect(DeviceCodeAnswer)
  const decodeDeviceGrant = Schema.decodeUnknownEffect(DeviceGrantAnswer)
  const decodeDeviceError = Schema.decodeUnknownOption(DeviceErrorAnswer)

  /**
   * One form POST to a GitHub device-flow endpoint with the client id and never the secret, decoded as JSON.
   * Credential HTTP settings refuse redirects and trace propagation; the 30-second deadline covers headers and body.
   * A JSON `device_flow_disabled`, `incorrect_client_credentials`, `unauthorized_client` or `invalid_client`
   * error is `misconfigured` at any status, as are 401/404. Other non-2xx or malformed answers are `unavailable`.
   */
  const deviceJson = (path: string, form: Record<string, string>) => (effect {
    const misconfigured = () => new GitHubRefused({ step: "device", reason: "misconfigured" })
    const url = try Effect.mapError(Effect.try(() => new URL(web + path)), misconfigured)
    if (!isSecureEndpoint(url)) throw misconfigured()
    const http = try Client.HttpClient
    const body = new URLSearchParams({ client_id: options.clientId, ...form }).toString()
    const request = HttpClientRequest.post(url.toString()).pipe(
      HttpClientRequest.setHeader("accept", "application/json"),
      HttpClientRequest.bodyText(body, "application/x-www-form-urlencoded"),
    )
    const unavailable = () => new GitHubRefused({ step: "device", reason: "unavailable" })
    const credentialHttp = try Effect.mapError(Effect.try(() => forCredentials(http)), unavailable)
    const response = try Effect.mapError(credentialHttp.execute(request), unavailable)
    const text = try Effect.mapError(response.text, unavailable)
    if (response.status === 401 || response.status === 404) throw new GitHubRefused({ step: "device", reason: "misconfigured" })
    const answer = try Effect.mapError(Effect.try(() => JSON.parse(text) as unknown), unavailable)
    if (isDeviceMisconfigured(answer)) throw new GitHubRefused({ step: "device", reason: "misconfigured" })
    if (response.status < 200 || response.status >= 300) throw unavailable()
    return answer
  }) |> timeoutOrElse(%, {
    duration: Core.OAuthToken.DEFAULT_REQUEST_TIMEOUT,
    orElse: effect () => { throw new GitHubRefused({ step: "device", reason: "unavailable" }) },
  })

  return GitHubAuth.of({
    authorizeUrl: ({ state, codeChallenge, redirectUri }) =>
      Core.AuthorizationUrl.buildAuthorizationUrl({
        authorizationEndpoint: `${web}/login/oauth/authorize`,
        clientId: options.clientId,
        redirectUri,
        state,
        codeChallenge,
        codeChallengeMethod: "S256",
      }),
    exchange: ({ code, codeVerifier, redirectUri }) =>
      (do { const catchProgram = Core.OAuthToken.exchangeCode({ ...endpoint, code, codeVerifier, redirectUri }); effect { return catchProgram catch effect (error) => throw refused("exchange")(error) } })
        |> Effect.flatMap(%, tokens)
        |> Effect.provide(%, context),
    refresh: (refreshToken) =>
      (do { const catchProgram = Core.OAuthToken.exchangeRefreshToken({ ...endpoint, refreshToken }); effect { return catchProgram catch effect (error) => throw refused("refresh")(error) } })
        |> Effect.flatMap(%, tokens)
        |> Effect.provide(%, context),
    user: (accessToken) =>
      (do { const catchProgram = (asPerson(accessToken)
        |> Effect.flatMap(%, (client) => client.request("GET", "/user", undefined, { schema: User }))
        |> Effect.map(%, ({ id, login }) => ({ id, login }))); effect { return catchProgram catch effect (error) => throw refused("user")(error) } })
        |> Effect.provide(%, context),
    permission: (accessToken, repository) =>
      (do { const catchProgram = (asPerson(accessToken)
        // An `owner/repo` that is not a name GitHub issues is `invalid-config`: `misconfigured`, with no request.
        |> Effect.flatMap(%, (client) =>
          Effect.flatMap(requireFullNamePath(repository), (path) => client.request("GET", `/repos/${path}`, undefined, { schema: Repository }))
        )
        |> Effect.map(%, ({ permissions }): Permission =>
          permissions === undefined
            ? "none"
            : permissions.admin
            ? "admin"
            : permissions.maintain === true
            ? "maintain"
            : permissions.push
            ? "write"
            : permissions.triage === true
            ? "triage"
            : permissions.pull
            ? "read"
            : "none"
        )
        // A repository the person can't see is a 404, not a failure: they have no permission on it.
        |> Effect.catchIf(
          %, (error) => statusOf(error) === 404,
          () => Effect.succeed<Permission>("none"),
        )); effect { return catchProgram catch effect (error) => throw refused("permission")(error) } })
        |> Effect.provide(%, context),
    // `DELETE /applications/<client id>/token`: 204 when revoked, 404 when absent; 422 is validation/spam failure.
    // Revoking twice is harmless, so a retried step may send it again.
    revoke: (accessToken) =>
      asApp
        |> Effect.flatMap(%, (client) =>
          client.request("DELETE", `/applications/${encodeURIComponent(options.clientId)}/token`, {
            access_token: Redacted.value(accessToken),
          }, { retryUnsafeWrites: true })
        )
        |> Effect.asVoid(%)
        |> Effect.catchIf(
          %, (error) => statusOf(error) === 404,
          () => Effect.void,
        )
        // As the App, a refusal is GitHub refusing the App's client credentials.
        |> Effect.catch(%, (error) =>
          Effect.fail(new GitHubRefused({
            step: "revoke",
            reason: reasonOf(error) === "rejected" ? "misconfigured" : reasonOf(error),
          }))
        )
        |> Effect.provide(%, context),
    // GitHub's device flow: start with the client id alone, then poll until the person answers. A refused poll
    // arrives as 200 with an `error` field; the person's "no" and an expired code are outcomes, not failures.
    deviceCode: () =>
      (effect {
        const answer = try deviceJson("/login/device/code", {})
        const decoded = try Effect.mapError(decodeDeviceStart(answer), () => new GitHubRefused({ step: "device", reason: "unavailable" }))
        const signIn: DeviceSignIn = {
          deviceCode: Redacted.make(decoded.device_code),
          userCode: decoded.user_code,
          verificationUri: decoded.verification_uri,
          intervalSeconds: decoded.interval ?? 5,
          expiresInSeconds: decoded.expires_in,
        }
        return signIn
      }) |> Effect.provide(%, context),
    deviceToken: (deviceCode) =>
      (effect {
        const answer = try deviceJson("/login/oauth/access_token", {
          grant_type: "urn:ietf:params:oauth:grant-type:device_code",
          device_code: Redacted.value(deviceCode),
        })
        const refused = decodeDeviceError(answer)
        if (Option.isSome(refused)) {
          const code = refused.value.error
          if (code === "authorization_pending") return { status: "pending" } as DevicePoll
          if (code === "slow_down") return { status: "slowDown", intervalSeconds: refused.value.interval ?? null } as DevicePoll
          if (code === "access_denied") return { status: "denied" } as DevicePoll
          if (code === "expired_token") return { status: "expired" } as DevicePoll
          throw new GitHubRefused({
            step: "device",
            reason: "unavailable",
          })
        }
        const decoded = try Effect.mapError(decodeDeviceGrant(answer), () => new GitHubRefused({ step: "device", reason: "unavailable" }))
        const now = try Clock.currentTimeMillis
        const tokens: Tokens = {
          accessToken: Redacted.make(decoded.access_token),
          expiresAt: decoded.expires_in === undefined ? null : now + decoded.expires_in * 1000,
          refreshToken: null,
        }
        return { status: "authorized", tokens } as DevicePoll
      }) |> Effect.provide(%, context),
  })
}

/** Identify calls to GitHub even in hosts where fetch supplies no User-Agent. */
export const withUserAgent = <A, E, R>(program: A!E!R) =>
  Effect.provideServiceEffect(program, Client.HttpClient, Effect.map(Client.HttpClient, http =>
    Client.mapRequest(http, request => HttpClientRequest.setHeader(request, "user-agent", GitHubClient.USER_AGENT))))

/** Hosted-site sign-in through this app's registered callback. */
export * as Broker from "./AuthBroker.vibe"

/** Whether GitHub showed a page before a callback, after one of our revocations or not. */
export * as Consent from "./AuthConsent.vibe"
