/**
 * Repository file contents over the {@link GitHubClient} in context.
 *
 * A plain operation, not a durable action: the flow step that calls it
 * chooses the token by providing the client. The path and ref are validated
 * before they become a request, so a hostile path cannot walk the
 * token-bearing request to another endpoint, and the base64 GitHub answers is
 * decoded with `atob` and `TextDecoder`, which every platform the package
 * runs on provides.
 *
 * @since 1.0.0
 */

import { IntegrationError } from "../core/IntegrationError.ts"
import { GitHubClient } from "./GitHubClient.ts"
import { requireRepositoryPath } from "./Repository.vibe"

/**
 * A text file's contents and its blob SHA.
 *
 * @category models
 * @since 1.0.0
 */
export interface TextFile {
  readonly sha: string
  readonly text: string
}

/**
 * The longest ref {@link getText} accepts.
 *
 * @category constants
 * @since 1.0.0
 */
export const MAX_REF_LENGTH = 255

// GitHub's answer for a file up to 1 MB. A larger file answers `encoding:
// "none"`, a directory an array, and a symlink or submodule another `type`;
// none of them fits.
schema FileAnswer {
  type: "file"
  encoding: "base64"
  content: string
  sha: string
}

// Whether `value` holds a control character (C0 or DEL) or `also`: the
// backslash some clients read as a separator in a path, a space in a ref.
const holds = (value: string, also: string): boolean =>
  [...value].some((char) => char === also || char.charCodeAt(0) <= 0x1F || char.charCodeAt(0) === 0x7F)

const invalid = (field: string, message: string): IntegrationError =>
  new IntegrationError("invalid-config", message, { field, retryable: false })

const requireFilePath = (path: string): string!IntegrationError => {
  const segments = typeof path === "string" && !holds(path, "\\") ? path.split("/") : []
  const valid = segments.length > 0 &&
    segments.every((segment) => segment.length > 0 && segment !== "." && segment !== "..")
  return valid
    ? Effect.try({
      try: () => segments.map(encodeURIComponent).join("/"),
      catch: () => invalid("path", "A GitHub file path must contain well-formed Unicode.")
    })
    : Effect.fail(invalid(
      "path",
      "A GitHub file path must be relative, with non-empty segments, no `.` or `..` segment, no backslash and no control character."
    ))
}

const requireRef = (ref: string | undefined): string | undefined!IntegrationError =>
  ref === undefined ||
    (typeof ref === "string" && ref.length > 0 && ref.length <= MAX_REF_LENGTH && !holds(ref, " "))
    ? Effect.succeed(ref)
    : Effect.fail(
      invalid("ref", `A GitHub ref must be 1 to ${MAX_REF_LENGTH} characters, without spaces or control characters.`)
    )

// GitHub wraps the base64 with newlines. `atob` throws on anything else that
// is not base64, and a fatal decoder on bytes that are not UTF-8.
const utf8 = new TextDecoder("utf-8", { fatal: true })

const decodeText = (content: string, path: string): string!IntegrationError =>
  Effect.try({
    try: () => utf8.decode(Uint8Array.from(atob(content.replace(/\s/g, "")), (char) => char.charCodeAt(0))),
    catch: (cause) =>
      new IntegrationError("decode-failed", `GitHub response for GET ${path} is not base64 UTF-8 text.`, {
        method: "GET",
        path
      }, { cause })
  })

/**
 * The text of file `path` at `options.ref` (the default branch when absent):
 * `GET /repos/{owner}/{repo}/contents/{path}?ref=…`. Answers `Option.none()`
 * when GitHub answers 404.
 *
 * `path` is relative, with non-empty segments, no `.` or `..` segment, no
 * backslash and no control character; each segment is encoded. `ref` is 1 to
 * {@link MAX_REF_LENGTH} characters without spaces or control characters.
 *
 * Fails `decode-failed` when the path names a directory, a symlink or a
 * submodule, a file over GitHub's 1 MB contents limit, or bytes that are not
 * UTF-8.
 *
 * @category getters
 * @since 1.0.0
 */
export const getText = (
  owner: string,
  repo: string,
  path: string,
  options?: { readonly ref?: string | undefined }
): Option<TextFile>!IntegrationError!GitHubClient =>
  (effect {
    const client = try GitHubClient
    const repository = try requireRepositoryPath(owner, repo)
    const file = try requireFilePath(path)
    const ref = try requireRef(options?.ref)
    const requestPath = `/repos/${repository}/contents/${file}`
    return try (client.request("GET", requestPath, undefined, { schema: FileAnswer, query: { ref } })
      |> Effect.flatMap(%, (answer) =>
        Effect.map(decodeText(answer.content, requestPath), (text) => Option.some({ sha: answer.sha, text })))
      |> Effect.catchIf(
        %,
        (error) =>
          error.details?.["status"] === 404,
        () => Effect.succeed(Option.none<TextFile>())
      ))
  })
  |> withSpan(%, "GitHub.Contents.getText", { attributes: { "github.owner": owner, "github.repo": repo } })
