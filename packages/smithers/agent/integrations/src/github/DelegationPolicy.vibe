// What a hosted site may ask smithers.sh to do on a person's behalf. Pure: the only authority on an operation's meaning.
export type Scope = "issues" | "proposals"
export interface Grant {
  readonly repository: string
  /** GitHub's immutable id: a renamed or transferred repository stops matching. */
  readonly repositoryId: number
  readonly scopes: ReadonlyArray<Scope>
  readonly paths: ReadonlyArray<string>
  readonly branchPrefix: string
  readonly labelPrefix: string
}
export type Operation =
  | { readonly kind: "issue.create"; readonly repository: string; readonly title: string; readonly body: string; readonly since: string }
  | { readonly kind: "comment.create"; readonly repository: string; readonly number: number; readonly body: string }
  | { readonly kind: "issue.assign"; readonly repository: string; readonly number: number; readonly assignees: ReadonlyArray<string> }
  | { readonly kind: "issue.close"; readonly repository: string; readonly number: number }
  | { readonly kind: "issue.link"; readonly repository: string; readonly parent: number; readonly childNumber: number }
  | { readonly kind: "label.create"; readonly repository: string; readonly name: string; readonly color: string }
  | { readonly kind: "label.add"; readonly repository: string; readonly number: number; readonly labels: ReadonlyArray<string> }
  | { readonly kind: "label.remove"; readonly repository: string; readonly number: number; readonly label: string }
  | { readonly kind: "branch.create"; readonly repository: string; readonly prefix: string; readonly label: string; readonly at: string }
  | { readonly kind: "commit.create"; readonly repository: string; readonly branch: string; readonly expectedHeadOid: string; readonly headline: string; readonly additions: ReadonlyArray<{ readonly path: string; readonly contents: string }>; readonly deletions: ReadonlyArray<string> }
  | { readonly kind: "pull.create"; readonly repository: string; readonly head: string; readonly base: string; readonly title: string; readonly body: string }

const same = (left: string, right: string) => left.toLowerCase() === right.toLowerCase()
export function grantOf(grants: ReadonlyArray<Grant>, repository: string): Grant | undefined {
  return grants.find((grant) => same(grant.repository, repository))
}

// The URL parser drops tab, LF and CR before it resolves dot segments, so `.<tab>.` would reach GitHub as `..`.
const control = (char: string) => char < " " || char === "\x7f"
function safePath(path: string): boolean {
  if (path.includes("\\") || path.includes("%") || [...path].some(control)) return false
  return path.split("/").every((segment) => segment !== "" && segment !== "." && segment !== ".." && segment.toLowerCase() !== ".github")
}
/** A folder prefix: relative, safe segments, ending in `/`. Anything else matches nothing, so a typo grants nothing. */
const folder = (prefix: string) => prefix.length > 1 && prefix.endsWith("/") && safePath(prefix.slice(0, -1))
/** `value` lies strictly inside the folder `prefix`, compared by whole segments. */
const inside = (prefix: string, value: string) => folder(prefix) && value.length > prefix.length && value.startsWith(prefix)
const underGrant = (grant: Grant, path: string) => safePath(path) && grant.paths.some((prefix) => inside(prefix, path))
const labelled = (grant: Grant, label: string) => grant.labelPrefix.length > 0 && label.length > grant.labelPrefix.length && label.startsWith(grant.labelPrefix)

/**
 * A registry entry smithers.sh may load: an `owner/name` repository with a positive id, at least one folder path, a
 * folder branch prefix and a non-empty label prefix. Hosts refuse a registry holding any other entry.
 */
export function validGrant(grant: Grant): boolean {
  const named = /^[A-Za-z0-9-]+\/[A-Za-z0-9._-]+$/.test(grant.repository)
  return named && Number.isSafeInteger(grant.repositoryId) && grant.repositoryId > 0 &&
    grant.paths.length > 0 && grant.paths.every(folder) && folder(grant.branchPrefix) && grant.labelPrefix.length > 0
}

/** The site names only the upstream repository; smithers.sh derives the fork from the credential's own login. */
export function permits(grants: ReadonlyArray<Grant>, login: string, operation: Operation): boolean {
  const grant = grantOf(grants, operation.repository)
  if (grant === undefined) return false
  switch (operation.kind) {
    case "branch.create":
      return grant.scopes.includes("proposals") && inside(grant.branchPrefix, operation.prefix)
    case "commit.create":
      return grant.scopes.includes("proposals") && inside(grant.branchPrefix, operation.branch) && operation.deletions.length === 0 && operation.additions.length > 0 && operation.additions.every((file) => underGrant(grant, file.path))
    case "pull.create": {
      const separator = operation.head.indexOf(":")
      return grant.scopes.includes("proposals") && separator > 0 && same(operation.head.slice(0, separator), login) && inside(grant.branchPrefix, operation.head.slice(separator + 1))
    }
    case "label.create":
      return grant.scopes.includes("issues") && labelled(grant, operation.name)
    case "label.add":
      return grant.scopes.includes("issues") && operation.labels.length > 0 && operation.labels.every((label) => labelled(grant, label))
    case "label.remove":
      return grant.scopes.includes("issues") && labelled(grant, operation.label)
    default:
      return grant.scopes.includes("issues")
  }
}

const READS = ["issues", "pulls", "contents", "git/ref", "git/matching-refs", "branches", "commits", "assignees"]

/**
 * GET only. The repository a read names, under a path reads may take: a grant's repository (`fork: false`) or the same-named repository the person owns
 * (`fork: true`). The caller still proves it: the upstream by its immutable id, the person's copy as a fork of it.
 */
export interface ReadTarget { readonly grant: Grant; readonly owner: string; readonly name: string; readonly fork: boolean }
export function readTarget(grants: ReadonlyArray<Grant>, login: string, path: string): ReadTarget | undefined {
  const pathname = path.split("?")[0]!
  if (!pathname.startsWith("/repos/") || !safePath(pathname.slice(1))) return undefined
  const [owner, name, ...rest] = pathname.slice("/repos/".length).split("/")
  if (owner === undefined || name === undefined) return undefined
  const tail = rest.join("/")
  if (tail !== "" && !READS.some((read) => tail === read || tail.startsWith(read + "/"))) return undefined
  const upstream = grantOf(grants, `${owner}/${name}`)
  if (upstream !== undefined) return { grant: upstream, owner, name, fork: false }
  const copied = same(owner, login) ? grants.find((grant) => same(grant.repository.split("/")[1]!, name)) : undefined
  return copied === undefined ? undefined : { grant: copied, owner, name, fork: true }
}


export function liveDelegation(state: string, expires: number, now: number): boolean {
  return state === "active" && expires > now
}

/** A repository a hosted site may read for signed-out visitors through smithers.sh's App (0165, public reads). */
export interface Read { readonly repository: string; readonly repositoryId: number }
const NAMED = /^[A-Za-z0-9-]+\/[A-Za-z0-9._-]+$/
/** A registry `reads` entry smithers.sh may load: an `owner/name` repository with a positive id. */
export function validRead(read: Read): boolean {
  return NAMED.test(read.repository) && Number.isSafeInteger(read.repositoryId) && read.repositoryId > 0
}
const QUERY = /^[A-Za-z0-9._~%=&:+,-]*$/
export const MAX_READ_PATH = 2048
/**
 * The listed repository a public GET reads, or undefined: `/repos/<owner>/<name>` or `/repositories/<id>` (the form
 * GitHub's `rel="next"` links take), or one of its read collections, safe segments and a plain query. No person takes
 * part, so no fork is admitted.
 */
export function publicRead(reads: ReadonlyArray<Read>, path: string): Read | undefined {
  if (path.length > MAX_READ_PATH) return undefined
  const mark = path.indexOf("?")
  const pathname = mark < 0 ? path : path.slice(0, mark)
  if (!QUERY.test(mark < 0 ? "" : path.slice(mark + 1)) || !safePath(pathname.slice(1))) return undefined
  const byId = pathname.startsWith("/repositories/")
  if (!byId && !pathname.startsWith("/repos/")) return undefined
  const segments = pathname.slice(byId ? "/repositories/".length : "/repos/".length).split("/")
  // An id is matched as GitHub writes it: decimal digits with no leading zero.
  const id = byId ? segments.shift()! : ""
  if (byId && !/^[1-9][0-9]*$/.test(id)) return undefined
  const [owner, name] = byId ? ["", ""] : [segments.shift(), segments.shift()]
  if (owner === undefined || name === undefined) return undefined
  const read = reads.find((entry) => validRead(entry) && (byId ? String(entry.repositoryId) === id : same(entry.repository, `${owner}/${name}`)))
  const tail = segments.join("/")
  return read !== undefined && (tail === "" || READS.some((collection) => tail === collection || tail.startsWith(collection + "/"))) ? read : undefined
}
