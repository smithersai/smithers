// Extracted from apps/mvp/worker/github/Calls.ts: the explicit token always wins over the environment.
import * as GitHubClient from "./GitHubClient.ts"
import { HttpClient } from "effect/http"

/** Provide a GitHub client for exactly this credential. Never reads an ambient token. */
export const withToken = (token: Redacted.Redacted<string>, apiBaseUrl: string) =>
  <A, E, R>(program: A!E!R): A!E!(Exclude<R, GitHubClient.GitHubClient> | HttpClient.HttpClient) => effect {
    const client = try Effect.orDie(GitHubClient.make({ token: Redacted.value(token), apiBaseUrl }, {}))
    return try Effect.provideService(program, GitHubClient.GitHubClient, client)
  }
