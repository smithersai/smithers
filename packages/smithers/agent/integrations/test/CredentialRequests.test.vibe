import { describe, expect, it } from "@effect/vitest"
import { FetchHttpClient, HttpClient } from "effect/http"
import { TestClock } from "effect/testing"
import { Core, GitHub } from "../src/index.ts"
import { json, startFixture } from "./Fixture.ts"
import { rejectingTransport } from "./Http.ts"

const secret = Redacted.make("credential-private")

describe("credential endpoint transport security", () => {
  it.effect.each([
    "http://auth.example.test/token",
    "http://localhost.example.test/token",
    "http://127.0.0.1.example.test/token",
    "http://126.0.0.1/token",
    "http://128.0.0.1/token",
    "http://[2001:db8::1]/token",
  ])("refuses non-loopback cleartext before sending credentials: %s", (url) => effect {
    provide HttpClient.HttpClient = try Effect.try(() => rejectingTransport("must not send credentials")) {
      const endpoint = { tokenUrl: url, clientId: "client", clientSecret: secret }
      const refreshToken = try Effect.try(() => Core.OAuthToken.memoryStore(secret))
      const operations: ReadonlyArray<unknown!Core.IntegrationError.IntegrationError!HttpClient.HttpClient> = [
        Core.OAuthToken.make({ ...endpoint, refreshToken }),
        Core.OAuthToken.exchangeCode({ ...endpoint, code: secret, codeVerifier: secret, redirectUri: "https://site.example/callback" }),
        Core.OAuthToken.exchangeRefreshToken({ ...endpoint, refreshToken: secret }),
        GitHub.GitHubClient.make({ apiBaseUrl: url, token: Redacted.value(secret) }, {}),
      ]
      for (const operation of operations) {
        const failure = try Effect.flip(operation)
        try Effect.try(() => {
          expect(failure.reason).toBe("invalid-config")
          expect(failure.details?.retryable).toBe(false)
          expect(JSON.stringify(failure)).not.toContain(Redacted.value(secret))
        })
      }
    }
  })

  it.effect.each([
    "https://auth.example.test/token",
    "http://localhost:8000/token",
    "http://127.0.0.1:8000/token",
    "http://127.255.255.254:8000/token",
    "http://[::1]:8000/token",
  ])("accepts HTTPS and loopback HTTP configuration: %s", (url) => effect {
    provide HttpClient.HttpClient = try Effect.try(() => rejectingTransport("construction must not send")) {
      const refreshToken = try Effect.try(() => Core.OAuthToken.memoryStore(secret))
      try Core.OAuthToken.make({ tokenUrl: url, clientId: "client", refreshToken })
      try GitHub.GitHubClient.make({ apiBaseUrl: url, token: Redacted.value(secret) }, {})
    }
  })
})

describe("credential request deadlines", () => {
  it.effect.each([
    ["device start", "headers"], ["device start", "body"],
    ["device poll", "headers"], ["device poll", "body"],
    ["broker exchange", "headers"], ["broker exchange", "body"],
  ] as const)("bounds credential requests including stalled headers and body: %j", ([operation, stage]) => scoped(effect {
    const fixture = try acquireRelease(
      promise(() => startFixture((_request, response) => {
        if (stage === "body") {
          response.writeHead(200, { "content-type": "application/json" })
          response.flushHeaders()
          response.write("{")
        }
      })),
      fixture => promise(() => fixture.close()),
    )
    const headersReceived = try Deferred.make<void>()
    const ambient = try Effect.provide(HttpClient.HttpClient, FetchHttpClient.layer)
    const transport = try Effect.try(() => HttpClient.transform(ambient, call =>
      tap(call, () => Deferred.succeed(headersReceived, undefined))))
    const call: unknown!(GitHub.Auth.GitHubRefused | GitHub.Auth.Broker.BrokerRefused)!HttpClient.HttpClient = operation === "broker exchange"
      ? Effect.flatMap(GitHub.Auth.Broker.site({
        origin: "https://site.example", brokerOrigin: fixture.origin,
        secret: Redacted.make("s".repeat(32)), localDevelopment: true,
      }), site => site.exchange("redemption-private"))
      : (Effect.flatMap(GitHub.Auth.GitHubAuth, auth => operation === "device start"
        ? asVoid(auth.deviceCode())
        : asVoid(auth.deviceToken(Redacted.make("device-private"))))
        |> Effect.provide(%, GitHub.Auth.layer({
          clientId: "client", clientSecret: secret, webBaseUrl: fixture.origin,
        })))
    const fiber = fork Effect.provideService(exit(call), HttpClient.HttpClient, transport)
    if (stage === "body") try Deferred.await(headersReceived)
    else try promise(() => fixture.arrived)
    try TestClock.adjust("29999 millis")
    try Effect.try(() => expect(fiber.pollUnsafe()).toBeUndefined())
    try TestClock.adjust("1 millis")
    try Effect.try(() => expect(fiber.pollUnsafe()).toBeDefined())
    const result = join fiber
    try Effect.try(() => {
      expect(result._tag).toBe("Failure")
      if (Exit.isFailure(result)) {
        const failure = Cause.squash(result.cause)
        if (operation === "broker exchange") expect(failure).toBeInstanceOf(GitHub.Auth.Broker.BrokerRefused)
        else expect(failure).toMatchObject({ step: "device", reason: "unavailable" })
        expect(JSON.stringify(failure)).not.toMatch(/credential-private|device-private|redemption-private/)
      }
      expect(fixture.requests).toHaveLength(1)
    })
  }))
})

it.effect.each(["start", "poll"] as const)("refuses a device %s redirect without forwarding credentials or trace headers", operation => scoped(effect {
  const receiver = try acquireRelease(
    promise(() => startFixture((_request, response) => json(response, 200, {
      device_code: "device-private", user_code: "ABCD", verification_uri: "https://github.com/login/device",
      expires_in: 900, access_token: "access-private",
    }))),
    fixture => promise(() => fixture.close()),
  )
  const redirector = try acquireRelease(
    promise(() => startFixture((_request, response) => {
      response.writeHead(307, { location: receiver.origin })
      response.end()
    })),
    fixture => promise(() => fixture.close()),
  )
  provide GitHub.Auth.layer({ clientId: "client", clientSecret: secret, webBaseUrl: redirector.origin }).pipe(
    Layer.provide(FetchHttpClient.layer),
  ) {
    const auth = try GitHub.Auth.GitHubAuth
    const result = try withSpan(exit(operation === "start" ? asVoid(auth.deviceCode()) : asVoid(auth.deviceToken(secret))), "device-test")
    try Effect.try(() => {
      expect(result._tag).toBe("Failure")
      if (Exit.isFailure(result)) expect(Cause.squash(result.cause)).toMatchObject({ step: "device", reason: "unavailable" })
      expect(receiver.requests).toHaveLength(0)
      expect(redirector.requests).toHaveLength(1)
      expect(redirector.requests[0]!.headers.traceparent).toBeUndefined()
      expect(redirector.requests[0]!.headers.b3).toBeUndefined()
      expect(redirector.requests[0]!.headers["user-agent"]).toBe(GitHub.GitHubClient.USER_AGENT)
    })
  }
}))

it.effect.each([
  "http://auth.example.test",
  "http://localhost.example.test",
  "http://127.0.0.1.example.test",
  "http://126.0.0.1",
  "http://128.0.0.1",
  "http://[2001:db8::1]",
  "ftp://auth.example.test",
  "not a URL",
])("refuses insecure device endpoints before contacting the transport: %s", webBaseUrl => effect {
  const attempts = try Ref.make(0)
  const transport = try Effect.try(() => HttpClient.transform(rejectingTransport("must not send"), call =>
    andThen(Ref.update(attempts, n => n + 1), call)))
  provide GitHub.Auth.layer({ clientId: "client", clientSecret: secret, webBaseUrl }).pipe(
    Layer.provide(Layer.succeed(HttpClient.HttpClient, transport)),
  ) {
    const auth = try GitHub.Auth.GitHubAuth
    for (const call of [asVoid(auth.deviceCode()), asVoid(auth.deviceToken(secret))]) {
      const failure = try Effect.flip(call)
      try Effect.try(() => {
        expect(failure).toMatchObject({ step: "device", reason: "misconfigured" })
        expect(JSON.stringify(failure)).not.toContain(Redacted.value(secret))
      })
    }
  }
  const count = try Ref.get(attempts)
  try Effect.try(() => expect(count).toBe(0))
})
