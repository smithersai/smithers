{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Process containment tests share the source scanner from the flow suite.
    "rootDir": "../../../..",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*"]
}
