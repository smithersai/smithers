/**
 * A tree another machine listed, served as a read-only `FileSystem`.
 *
 * `RemoteSearch` lists a root on the machine with `find` and brings back the
 * bytes the search reads with `tar`; this module holds what came back and
 * answers what the walk, the globs, and the matcher ask of a filesystem, so
 * `PortableSearch` can search the copy as it searches a host.
 *
 * @since 1.0.0-rc.8
 */

import type * as Path from "@smthrs/kernel/Path"
import * as FileSystem from "effect/FileSystem"
import * as Tar from "./Tar.ts"

/**
 * What one listed path is: `d` a directory, `u` a directory the machine's
 * user may not list, `f` a file, `o` anything else, and a symbolic link to a
 * directory (`D`), to a file (`F`), or to neither (`L`).
 *
 * @private
 * @since 1.0.0-rc.8
 */
export type Kind = "d" | "u" | "f" | "o" | "D" | "F" | "L"

/**
 * One machine's listing of a root, and the bytes it brought back, by
 * absolute path.
 *
 * @private
 * @since 1.0.0-rc.8
 */
export interface Tree {
  readonly kinds: ReadonlyMap<string, Kind>
  readonly children: ReadonlyMap<string, ReadonlyArray<string>>
  readonly contents: ReadonlyMap<string, Uint8Array>
}

const kinds: ReadonlySet<string> = new Set(["d", "u", "f", "o", "D", "F", "L"])

/**
 * The member names `tar` wrote for absolute paths, which it strips of their
 * leading `/`, as those paths again.
 *
 * @private
 * @since 1.0.0-rc.8
 */
export const absolute = (members: ReadonlyMap<string, Uint8Array>): ReadonlyMap<string, Uint8Array> =>
  new Map([...members].map(([name, bytes]) => [`/${name}`, bytes]))

/**
 * Reads NUL-terminated `<kind><path>` records up to an `E` record, then the
 * tar stream of `.gitignore` files after it. `root` is the listed root, which
 * is nobody's child. `undefined` when the bytes are not that shape.
 *
 * @private
 * @since 1.0.0-rc.8
 */
export const parse = (bytes: Uint8Array, root: string, path: Path.Path): Tree | undefined => {
  const decoder = new TextDecoder()
  const listed = new Map<string, Kind>()
  const children = new Map<string, Array<string>>()
  let offset = 0
  for (;;) {
    const end = bytes.indexOf(0, offset)
    if (end === -1) return undefined
    const record = decoder.decode(bytes.subarray(offset, end))
    offset = end + 1
    if (record === "E") break
    const kind = record.slice(0, 1)
    if (!kinds.has(kind)) return undefined
    const entry = record.slice(1)
    listed.set(entry, kind as Kind)
    if (entry === root) continue
    const parent = path.dirname(entry)
    const siblings = children.get(parent)
    if (siblings === undefined) children.set(parent, [path.basename(entry)])
    else siblings.push(path.basename(entry))
  }
  const ignores = Tar.files(bytes.subarray(offset))
  return ignores === undefined ? undefined : { kinds: listed, children, contents: absolute(ignores) }
}

const refusal = (tag: PlatformError.SystemErrorTag, method: string, path: string): PlatformError =>
  PlatformError.systemError({ _tag: tag, module: "FileSystem", method, pathOrDescriptor: path })

/** What `stat` says each kind is: links resolved, a dangling one absent. */
const types: Readonly<Record<Kind, FileSystem.File.Type | undefined>> = {
  d: "Directory",
  u: "Directory",
  D: "Directory",
  f: "File",
  F: "File",
  o: "Unknown",
  L: undefined,
}

const info = (type: FileSystem.File.Type, size: number): FileSystem.File.Info => ({
  type,
  size: ByteSize.bytes(BigInt(size)),
  mtime: Option.none(),
  atime: Option.none(),
  birthtime: Option.none(),
  dev: 0n,
  ino: Option.none(),
  mode: 0,
  nlink: Option.none(),
  uid: Option.none(),
  gid: Option.none(),
  rdev: Option.none(),
  blksize: Option.none(),
  blocks: Option.none(),
})

/**
 * The tree as a read-only `FileSystem`, resolving paths with `path`. A file
 * whose bytes did not come back is one the machine's user could not read,
 * which the in-process peer skips exactly as it skips such a file on a host.
 *
 * @private
 * @since 1.0.0-rc.8
 */
export const fileSystem = (tree: Tree, path: Path.Path): FileSystem.FileSystem => {
  const kindOf = (value: string) => tree.kinds.get(path.resolve(value))
  const readFile = (value: string) => {
    const bytes = tree.contents.get(path.resolve(value))
    if (bytes !== undefined) return bytes
    const type = types[kindOf(value) ?? "L"]
    throw refusal(
      type === "File" ? "PermissionDenied" : type === undefined ? "NotFound" : "BadResource",
      "readFile",
      value,
    )
  }
  return FileSystem.makeNoop({
    stat: (value) => {
      const type = types[kindOf(value) ?? "L"]
      return type === undefined
        ? throw refusal("NotFound", "stat", value)
        : info(type, tree.contents.get(path.resolve(value))?.length ?? 0)
    },
    readDirectory: (value) => {
      const kind = kindOf(value)
      if (kind === "d") return [...tree.children.get(path.resolve(value)) ?? []]
      const tag = kind === "u" ? "PermissionDenied" : kind === undefined || kind === "L" ? "NotFound" : "BadResource"
      throw refusal(tag, "readDirectory", value)
    },
    readLink: (value) => {
      const kind = kindOf(value)
      return kind === "D" || kind === "F" || kind === "L"
        ? ""
        : throw refusal(kind === undefined ? "NotFound" : "BadResource", "readLink", value)
    },
    readFile,
    readFileString: (value) => Effect.map(readFile(value), (bytes) => new TextDecoder().decode(bytes)),
    stream: (value) => Stream.fromEffect(readFile(value)),
  })
}
