/**
 * Platform-neutral opening context selection. Hosts inject retrieval and judgment
 * and seal the returned snapshot as a flow step before starting an agent.
 * @since 1.0.0
 */

import { Context, Effect, Layer } from "effect"
import type { MemoryError } from "./MemoryError.vibe"
import * as Recall from "./Recall.vibe"
import type { Row } from "./SnapshotRecorder.vibe"
import { render } from "./Source.ts"

/**
 * A source's recalled document or skill, before judgment.
 * @category constructors
 * @since 1.0.0
 */
export interface Candidate {
  readonly kind: "memory" | "skill"
  readonly bank: string
  readonly key: string
  readonly text: string
}

/**
 * A judge's probability that the candidate is unnecessary.
 * @category constructors
 * @since 1.0.0
 */
export interface Verdict {
  readonly index: number
  readonly unnecessary: number
  readonly withheld: boolean
}

/**
 * A frozen selection, including counts safe for telemetry.
 * @category constructors
 * @since 1.0.0
 */
export interface Selection {
  readonly rows: ReadonlyArray<Row>
  readonly recalled: number
  readonly judged: number
  readonly inserted: number
  readonly filtered: number
  readonly skillsRecalled: number
  readonly skillsInserted: number
  readonly bytes: number
}

/**
 * Keyword shortlist used for both memories and skills; ties preserve source order.
 * @category constructors
 * @since 1.0.0
 */
export const shortlist = (
  query: string,
  candidates: ReadonlyArray<Candidate>,
  limit = 30
): ReadonlyArray<Candidate> => {
  const ignored = new Set([
    "the",
    "a",
    "an",
    "is",
    "are",
    "it",
    "its",
    "so",
    "now",
    "person",
    "conversation",
    "asks",
    "far",
    "smithers"
  ])
  const words = (text: string) => text.toLowerCase().match(/[\p{L}\p{N}_-]+/gu) ?? []
  const terms = [...new Set(words(query))].filter((word) => !ignored.has(word))
  const capacity = Number.isFinite(limit) ? Math.max(0, Math.floor(limit)) : 0
  const ranked = candidates.map((item, index) => ({
    item,
    index,
    score: terms.reduce((score, term) => score + Number(new Set(words(`${item.key} ${item.text}`)).has(term)), 0)
  })).sort((a, b) => b.score - a.score || a.index - b.index)
  // Reserve half the shortlist for each kind before filling spare slots, so
  // a busy memory bank cannot prevent every skill from reaching the judge.
  const reserve = Math.floor(capacity / 2)
  const kept = new Set([
    ...ranked.filter(({ item }) => item.kind === "memory").slice(0, reserve),
    ...ranked.filter(({ item }) => item.kind === "skill").slice(0, reserve)
  ])
  for (const item of ranked) {
    if (kept.size >= capacity) break
    kept.add(item)
  }
  return ranked.filter((item) => kept.has(item)).map(({ item }) => item)
}

/**
 * Rank whole rows using one injected judge over a bounded keyword shortlist.
 * The byte cost of the complete escaped render is a conservative token bound;
 * a host may also supply a tokenizer. Unjudged or malformed verdicts fail
 * closed. No content is logged. Cancellation and typed failures propagate.
 * @category constructors
 * @since 1.0.0
 */
export const select = <E, R>(options: {
  readonly query: string
  readonly candidates: ReadonlyArray<Candidate>
  readonly judge: (items: ReadonlyArray<Candidate>) => Effect.Effect<ReadonlyArray<Verdict>, E, R>
  readonly tokenBudget: number
  readonly maxCandidates?: number
  readonly tokens?: (rendered: string) => number
}): Effect.Effect<Selection, E, R> =>
  effect {
    const items = shortlist(options.query, options.candidates, options.maxCandidates)
    const verdicts = items.length === 0 ? [] : try options.judge(items)
    const seen = new Set<number>()
    const ranked = verdicts.filter(({ index, unnecessary, withheld }) => {
      if (
        !Number.isSafeInteger(index) || index < 0 || index >= items.length || seen.has(index) ||
        !Number.isFinite(unnecessary) || unnecessary < 0 || unnecessary > 1
      ) return false
      seen.add(index)
      return !withheld
    }).sort((a, b) => a.unnecessary - b.unnecessary || a.index - b.index)
    const rows: Array<Row> = []
    const encoder = new TextEncoder()
    const cost = options.tokens ?? ((text: string) => encoder.encode(text).byteLength)
    const budget = Number.isFinite(options.tokenBudget) ? Math.max(0, Math.floor(options.tokenBudget)) : 0
    let skillsInserted = 0
    for (const { index } of ranked) {
      const item = items[index]!
      const row: Row = { origin: "recall", bank: item.bank, key: item.key, text: item.text }
      const tokens = cost(render([...rows, row]))
      if (!Number.isFinite(tokens) || tokens < 0 || tokens > budget) continue
      rows.push(row)
      if (item.kind === "skill") skillsInserted++
    }
    return {
      rows,
      recalled: options.candidates.length,
      judged: items.length,
      inserted: rows.length,
      filtered: options.candidates.length - rows.length,
      skillsRecalled: options.candidates.filter((item) => item.kind === "skill").length,
      skillsInserted,
      bytes: rows.length === 0 ? 0 : encoder.encode(render(rows)).byteLength
    }
  }

/**
 * Host-owned sources. A future wiki adapter joins here; no filesystem is assumed.
 * @category constructors
 * @since 1.0.0
 */
export class Sources extends Context.Service<Sources, {
  readonly recall: (query: string) => Effect.Effect<ReadonlyArray<Candidate>, MemoryError>
}>()("@smthrs/memory/Opening/Sources") {}

/**
 * Adapt configured durable banks; the host owns and authorizes the bank list.
 * @category constructors
 * @since 1.0.0
 */
export const layerSources = (banks: ReadonlyArray<string>, skills: ReadonlyArray<Candidate> = []) =>
  Layer.effect(
    Sources,
    effect {
      const recall = try Recall.Recall
      return {
        recall: (query: string) =>
          recall.recall({ banks, query, maxTokens: 16_384 }).pipe(
            Effect.map((rows) => [...rows.map((row): Candidate => ({ ...row, kind: "memory" })), ...skills])
          )
      }
    }
  )

/**
 * Keep the newest query context within the recall service's UTF-8 limit.
 * Whole code points are retained, including when a boundary meets an emoji.
 * @category constructors
 * @since 1.0.0
 */
export const boundedQuery = (query: string, maxBytes = Recall.MAX_RECALL_QUERY_BYTES): string => {
  const budget = Number.isFinite(maxBytes) ? Math.max(0, Math.floor(maxBytes)) : 0
  const encoder = new TextEncoder()
  let used = 0
  const kept: Array<string> = []
  for (const character of [...query].reverse()) {
    used += encoder.encode(character).byteLength
    if (used > budget) break
    kept.push(character)
  }
  return kept.reverse().join("")
}
