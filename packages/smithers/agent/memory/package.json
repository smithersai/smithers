{
  "name": "@smthrs/memory",
  "type": "module",
  "version": "1.0.0-rc.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Effect services for durable cross-run facts, history, notes, recall, and maintenance",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/memory"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "memory"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "memory"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./*/index": null,
    "./Bank": "./src/Bank.ts",
    "./Database": "./src/Database.ts",
    "./Embedding": "./src/Embedding.ts",
    "./Flows": "./src/Flows.ts",
    "./Maintenance": "./src/Maintenance.ts",
    "./MemoryError": "./src/MemoryError.ts",
    "./MemoryStore": "./src/MemoryStore.ts",
    "./MemoryTrellis": "./src/MemoryTrellis.ts",
    "./Migrations": "./src/Migrations.ts",
    "./Namespace": "./src/Namespace.ts",
    "./Recall": "./src/Recall.ts",
    "./RecallFts": "./src/RecallFts.ts",
    "./RecallKeyword": "./src/RecallKeyword.ts",
    "./RecallSemantic": "./src/RecallSemantic.ts",
    "./SnapshotRecorder": "./src/SnapshotRecorder.ts",
    "./Source": "./src/Source.ts",
    "./WithMemory": "./src/WithMemory.ts",
    "./index": "./src/index.ts",
    "./test/TestMemory": "./src/test/TestMemory.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./internal/*": null,
      "./*/index": null,
      "./Bank": {
        "types": "./dist/esm/Bank.d.ts",
        "import": "./dist/esm/Bank.js",
        "require": "./dist/cjs/Bank.js"
      },
      "./Database": {
        "types": "./dist/esm/Database.d.ts",
        "import": "./dist/esm/Database.js",
        "require": "./dist/cjs/Database.js"
      },
      "./Embedding": {
        "types": "./dist/esm/Embedding.d.ts",
        "import": "./dist/esm/Embedding.js",
        "require": "./dist/cjs/Embedding.js"
      },
      "./Flows": {
        "types": "./dist/esm/Flows.d.ts",
        "import": "./dist/esm/Flows.js",
        "require": "./dist/cjs/Flows.js"
      },
      "./Maintenance": {
        "types": "./dist/esm/Maintenance.d.ts",
        "import": "./dist/esm/Maintenance.js",
        "require": "./dist/cjs/Maintenance.js"
      },
      "./MemoryError": {
        "types": "./dist/esm/MemoryError.d.ts",
        "import": "./dist/esm/MemoryError.js",
        "require": "./dist/cjs/MemoryError.js"
      },
      "./MemoryStore": {
        "types": "./dist/esm/MemoryStore.d.ts",
        "import": "./dist/esm/MemoryStore.js",
        "require": "./dist/cjs/MemoryStore.js"
      },
      "./MemoryTrellis": {
        "types": "./dist/esm/MemoryTrellis.d.ts",
        "import": "./dist/esm/MemoryTrellis.js",
        "require": "./dist/cjs/MemoryTrellis.js"
      },
      "./Migrations": {
        "types": "./dist/esm/Migrations.d.ts",
        "import": "./dist/esm/Migrations.js",
        "require": "./dist/cjs/Migrations.js"
      },
      "./Namespace": {
        "types": "./dist/esm/Namespace.d.ts",
        "import": "./dist/esm/Namespace.js",
        "require": "./dist/cjs/Namespace.js"
      },
      "./Recall": {
        "types": "./dist/esm/Recall.d.ts",
        "import": "./dist/esm/Recall.js",
        "require": "./dist/cjs/Recall.js"
      },
      "./RecallFts": {
        "types": "./dist/esm/RecallFts.d.ts",
        "import": "./dist/esm/RecallFts.js",
        "require": "./dist/cjs/RecallFts.js"
      },
      "./RecallKeyword": {
        "types": "./dist/esm/RecallKeyword.d.ts",
        "import": "./dist/esm/RecallKeyword.js",
        "require": "./dist/cjs/RecallKeyword.js"
      },
      "./RecallSemantic": {
        "types": "./dist/esm/RecallSemantic.d.ts",
        "import": "./dist/esm/RecallSemantic.js",
        "require": "./dist/cjs/RecallSemantic.js"
      },
      "./SnapshotRecorder": {
        "types": "./dist/esm/SnapshotRecorder.d.ts",
        "import": "./dist/esm/SnapshotRecorder.js",
        "require": "./dist/cjs/SnapshotRecorder.js"
      },
      "./Source": {
        "types": "./dist/esm/Source.d.ts",
        "import": "./dist/esm/Source.js",
        "require": "./dist/cjs/Source.js"
      },
      "./WithMemory": {
        "types": "./dist/esm/WithMemory.d.ts",
        "import": "./dist/esm/WithMemory.js",
        "require": "./dist/cjs/WithMemory.js"
      },
      "./index": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./test/TestMemory": {
        "types": "./dist/esm/test/TestMemory.d.ts",
        "import": "./dist/esm/test/TestMemory.js",
        "require": "./dist/cjs/test/TestMemory.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/core": "1.0.0-rc.0",
    "@smthrs/database": "1.0.0-rc.0",
    "@smthrs/patterns": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.112",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.9",
    "dprint": "0.57.1",
    "effect": "4.0.0-rc.112",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  }
}
