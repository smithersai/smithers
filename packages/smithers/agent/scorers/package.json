{
  "name": "@smthrs/scorers",
  "type": "module",
  "version": "1.0.0-rc.16",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Flow-native scoring and durable observations for caller-owned flow steps",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/scorers"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "flow",
    "scorers"
  ],
  "keywords": [
    "typescript",
    "effect",
    "flow",
    "scorers"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./internal/*": null,
    "./migrations/*": null,
    "./*/index": null,
    "./Binding": "./src/Binding.ts",
    "./Checks": "./src/Checks.ts",
    "./Rubric": "./src/Rubric.ts",
    "./Sampling": "./src/Sampling.ts",
    "./ScoreGate": "./src/ScoreGate.ts",
    "./ScoreStore": "./src/ScoreStore.ts",
    "./Scorer": "./src/Scorer.ts",
    "./ScorerError": "./src/ScorerError.ts",
    "./SqlScoreStore": "./src/SqlScoreStore.ts",
    "./index": "./src/index.ts",
    "./Scorers": "./src/Scorers.ts",
    "./Scoring": "./src/Scoring.ts",
    "./Runner": null,
    "./RunnerLive": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./internal/*": null,
      "./migrations/*": null,
      "./*/index": null,
      "./Binding": {
        "import": {
          "types": "./dist/esm/Binding.d.ts",
          "default": "./dist/esm/Binding.js"
        },
        "require": {
          "types": "./dist/cjs/Binding.d.ts",
          "default": "./dist/cjs/Binding.js"
        }
      },
      "./Checks": {
        "import": {
          "types": "./dist/esm/Checks.d.ts",
          "default": "./dist/esm/Checks.js"
        },
        "require": {
          "types": "./dist/cjs/Checks.d.ts",
          "default": "./dist/cjs/Checks.js"
        }
      },
      "./Rubric": {
        "import": {
          "types": "./dist/esm/Rubric.d.ts",
          "default": "./dist/esm/Rubric.js"
        },
        "require": {
          "types": "./dist/cjs/Rubric.d.ts",
          "default": "./dist/cjs/Rubric.js"
        }
      },
      "./Sampling": {
        "import": {
          "types": "./dist/esm/Sampling.d.ts",
          "default": "./dist/esm/Sampling.js"
        },
        "require": {
          "types": "./dist/cjs/Sampling.d.ts",
          "default": "./dist/cjs/Sampling.js"
        }
      },
      "./ScoreGate": {
        "import": {
          "types": "./dist/esm/ScoreGate.d.ts",
          "default": "./dist/esm/ScoreGate.js"
        },
        "require": {
          "types": "./dist/cjs/ScoreGate.d.ts",
          "default": "./dist/cjs/ScoreGate.js"
        }
      },
      "./ScoreStore": {
        "import": {
          "types": "./dist/esm/ScoreStore.d.ts",
          "default": "./dist/esm/ScoreStore.js"
        },
        "require": {
          "types": "./dist/cjs/ScoreStore.d.ts",
          "default": "./dist/cjs/ScoreStore.js"
        }
      },
      "./Scorer": {
        "import": {
          "types": "./dist/esm/Scorer.d.ts",
          "default": "./dist/esm/Scorer.js"
        },
        "require": {
          "types": "./dist/cjs/Scorer.d.ts",
          "default": "./dist/cjs/Scorer.js"
        }
      },
      "./ScorerError": {
        "import": {
          "types": "./dist/esm/ScorerError.d.ts",
          "default": "./dist/esm/ScorerError.js"
        },
        "require": {
          "types": "./dist/cjs/ScorerError.d.ts",
          "default": "./dist/cjs/ScorerError.js"
        }
      },
      "./SqlScoreStore": {
        "import": {
          "types": "./dist/esm/SqlScoreStore.d.ts",
          "default": "./dist/esm/SqlScoreStore.js"
        },
        "require": {
          "types": "./dist/cjs/SqlScoreStore.d.ts",
          "default": "./dist/cjs/SqlScoreStore.js"
        }
      },
      "./index": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./Scorers": {
        "import": {
          "types": "./dist/esm/Scorers.d.ts",
          "default": "./dist/esm/Scorers.js"
        },
        "require": {
          "types": "./dist/cjs/Scorers.d.ts",
          "default": "./dist/cjs/Scorers.js"
        }
      },
      "./Scoring": {
        "import": {
          "types": "./dist/esm/Scoring.d.ts",
          "default": "./dist/esm/Scoring.js"
        },
        "require": {
          "types": "./dist/cjs/Scoring.d.ts",
          "default": "./dist/cjs/Scoring.js"
        }
      },
      "./Runner": null,
      "./RunnerLive": null
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "node ../../flows/database/scripts/test-matrix.mjs",
    "test:matrix": "node ../../flows/database/scripts/test-matrix.mjs"
  },
  "dependencies": {
    "@smthrs/core": "1.0.0-rc.16",
    "@smthrs/database": "1.0.0-rc.16",
    "@smthrs/journal": "1.0.0-rc.16",
    "@smthrs/sandbox": "1.0.0-rc.16"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.5",
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vitest": "5.0.0",
    "@effect/platform-node": "4.0.5",
    "@smthrs/kernel": "1.0.0-rc.16",
    "@smthrs/platform-node": "1.0.0-rc.16",
    "@smthrs/flow": "workspace:*",
    "@smthrs/plan": "workspace:*"
  }
}
