/**
 * Classify a support ticket, retrieve knowledge, draft a reply, and escalate only risky or uncertain tickets.
 *
 * Port of the 0.x `support-deflector.jsx`. A classifier agent labels the
 * ticket's category, sentiment, confidence and risk; a retrieval agent finds
 * articles for it; a drafting agent writes the reply. The ticket is escalated
 * when the classifier asks to, the risk is high, its confidence is under 60,
 * article coverage is under 40, or draft confidence is under 50. An escalated
 * ticket goes to an escalation agent and settles `escalated`; any other settles
 * `deflected` with no further model call.
 *
 * 0.x's `outcome-*` tasks were static values, so here they are pure `Node.map`s.
 * 0.x's prompts were placeholders that printed their props; these are minimal prompts over the same props.
 * 0.x gave the agents `read`, `grep` and `bash` tools; in 1.0 tools are the host's registered flows (see `25-agent-tools-in-sandbox.ts`).
 */
import * as AgentAction from "@smthrs/agent/AgentAction"
import { Flow } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

const seat = "anthropic:claude-sonnet-5-5"

const Percent = Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 100 }))

/** The classifier's labels. */
export const Classification = Schema.Struct({
  category: Schema.Literals(["billing", "bug", "how-to", "account", "feature-request", "outage"]),
  sentiment: Schema.Literals(["positive", "neutral", "frustrated", "angry"]),
  confidence: Percent,
  riskLevel: Schema.Literals(["low", "medium", "high"]),
  escalate: Schema.Boolean,
  reasoning: Schema.String,
})

schema Article {
  title: string
  relevance: Percent
  snippet: string
  source: string
}

/** The articles retrieval found, and how well they cover the ticket. */
export const Knowledge = Schema.Struct({ articles: Schema.Array(Article), coverageScore: Percent })

/** The drafted reply. */
export const Draft = Schema.Struct({
  subject: Schema.String,
  body: Schema.String,
  tone: Schema.Literals(["empathetic", "professional", "technical"]),
  suggestedActions: Schema.Array(Schema.String),
  confidenceInDraft: Percent,
})

/** The package handed to a person. */
export const Escalation = Schema.Struct({
  reason: Schema.String,
  priority: Schema.Literals(["urgent", "high", "normal"]),
  assignTo: Schema.String,
  context: Schema.String,
})

/** What the flow settles with. */
export const Outcome = Schema.Struct({
  status: Schema.Literals(["deflected", "escalated"]),
  ticketId: Schema.String,
  summary: Schema.String,
})

/** Labels the ticket. */
export const Classify = AgentAction.make("examples/SupportDeflector/Classify", {
  payload: { subject: Schema.String, body: Schema.String, customer: Schema.String },
  output: Classification,
  seat,
  system: [
    `You are a support ticket classifier. Analyze the inbound ticket and determine
its category, customer sentiment, confidence level, and whether it should be escalated.
Escalate when risk is high, sentiment is angry, or the issue involves data loss / security.`,
  ],
  prompt: ({ body, customer, subject }) =>
    `Classify this support ticket.\n\nSubject: ${subject}\nBody: ${body}\nCustomer: ${customer}`,
})

/** Finds articles for the classified ticket. */
export const Retrieve = AgentAction.make("examples/SupportDeflector/Retrieve", {
  payload: { category: Schema.String, reasoning: Schema.String, subject: Schema.String },
  output: Knowledge,
  seat,
  system: [
    `You are a knowledge-base retrieval specialist. Given a classified support ticket,
search for relevant documentation, FAQ entries, and past resolutions. Return the most relevant
articles with relevance scores. Aim for high coverage so the draft agent can compose a reply.`,
  ],
  prompt: ({ category, reasoning, subject }) =>
    `Find knowledge for this ticket.\n\nSubject: ${subject}\nCategory: ${category}\nReasoning: ${reasoning}`,
})

/** Drafts the reply from the labels and the articles. */
export const DraftReply = AgentAction.make("examples/SupportDeflector/DraftReply", {
  payload: {
    category: Schema.String,
    sentiment: Schema.String,
    articles: Schema.Array(Article),
    subject: Schema.String,
    body: Schema.String,
  },
  output: Draft,
  seat,
  system: [
    `You are a support response drafter. Using the classification and retrieved knowledge,
compose a helpful, accurate reply. Match the tone to the customer's sentiment — be empathetic with
frustrated users, concise with technical users. Include actionable next steps.`,
  ],
  prompt: ({ articles, body, category, sentiment, subject }) =>
    `Draft a reply to this ticket.\n\nSubject: ${subject}\nBody: ${body}\nCategory: ${category}\nSentiment: ${sentiment}\nArticles: ${
      JSON.stringify(articles)
    }`,
})

/** Prepares the escalation package. */
export const Escalate = AgentAction.make("examples/SupportDeflector/Escalate", {
  payload: {
    ticketId: Schema.String,
    category: Schema.String,
    riskLevel: Schema.String,
    sentiment: Schema.String,
    reasoning: Schema.String,
    draftConfidence: Schema.Number,
    coverageScore: Schema.Number,
  },
  output: Escalation,
  seat,
  system: [
    `You are an escalation specialist. When a ticket cannot be safely deflected,
prepare a thorough escalation package with context, priority, and recommended assignee
so the human agent can resolve it quickly.`,
  ],
  prompt: (ticket) => `Escalate this ticket.\n\nTicket: ${JSON.stringify(ticket)}`,
})

type Classification = typeof Classification.Type
type Knowledge = typeof Knowledge.Type
type Draft = typeof Draft.Type

interface Evidence {
  readonly classification: Classification
  readonly knowledge: Knowledge
  readonly draft: Draft
}

/** 0.x's escalation rule. */
const shouldEscalate = ({ classification, draft, knowledge }: Evidence): boolean =>
  classification.escalate
  || classification.riskLevel === "high"
  || classification.confidence < 60
  || knowledge.coverageScore < 40
  || draft.confidenceInDraft < 50

/** The flow: classify, retrieve, draft, then escalate or deflect. */
export const SupportDeflector = Flow.make("examples/SupportDeflector", {
  payload: {
    ticket: Schema.optional(Schema.Struct({
      id: Schema.optional(Schema.String),
      subject: Schema.optional(Schema.String),
      body: Schema.optional(Schema.String),
      customer: Schema.optional(Schema.String),
    })),
  },
  success: Outcome,
  error: AgentAction.AgentFailure,
  body: ({ ticket = {} }) => {
    const { body = "", customer = "unknown", id: ticketId = "unknown", subject = "" } = ticket
    return Node.bindPlanned(
      Classify.call({ subject, body, customer }),
      (classification: Planned.Planned<Classification>) =>
        Node.bindPlanned(
          Retrieve.call({ category: classification.category, reasoning: classification.reasoning, subject }),
          (knowledge: Planned.Planned<Knowledge>) =>
            Node.bindPlanned(
              DraftReply.call({
                category: classification.category,
                sentiment: classification.sentiment,
                articles: knowledge.articles,
                subject,
                body,
              }),
              (draft: Planned.Planned<Draft>) =>
                Node.branch(Node.succeed({ classification, knowledge, draft }), {
                  if: shouldEscalate,
                  then: () =>
                    Node.andThen(
                      Escalate.call({
                        ticketId,
                        category: classification.category,
                        riskLevel: classification.riskLevel,
                        sentiment: classification.sentiment,
                        reasoning: classification.reasoning,
                        draftConfidence: draft.confidenceInDraft,
                        coverageScore: knowledge.coverageScore,
                      }),
                      Node.map(
                        Node.succeed({ category: classification.category, riskLevel: classification.riskLevel }),
                        ({ category, riskLevel }): typeof Outcome.Type => ({
                          status: "escalated",
                          ticketId,
                          summary: `Ticket escalated to human agent — ${riskLevel} risk, ${category} category`,
                        }),
                      ),
                    ),
                  else: () =>
                    Node.map(
                      Node.succeed({ tone: draft.tone, articles: knowledge.articles }),
                      ({ articles, tone }): typeof Outcome.Type => ({
                        status: "deflected",
                        ticketId,
                        summary: `Auto-replied with ${tone} response covering ${articles.length} knowledge articles`,
                      }),
                    ),
                }),
            ),
        ),
    )
  },
})

/** Every step the flow calls. */
export const layer = Layer.mergeAll(Classify.layer, Retrieve.layer, DraftReply.layer, Escalate.layer)
