  runProbes: Schema.optional(Schema.Boolean),
  runTests: Schema.optional(Schema.Boolean),
  runSweeps: Schema.optional(Schema.Boolean)
})

type OperatorPlan = typeof OperatorPlan.Type

/** {@link OperatorPlan} as the JSON Schema the operator's answer is checked against. */
const operatorPlanSchema = {
  type: "object",
  properties: {
    approved: { type: "boolean" },
    comments: { type: "string" },
    runLifetimes: { type: "boolean" },
    runPhaseA: { type: "boolean" },
    runCompile: { type: "boolean" },
    runUngate: { type: "boolean" },
    runProbes: { type: "boolean" },
    runTests: { type: "boolean" },
    runSweeps: { type: "boolean" }
  },
  required: ["approved"]
}

