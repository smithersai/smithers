/**
 * Run Bun's Zig-to-Rust port pipeline: classify ownership, port files, compile by crate tier, ungate, probe, swarm tests, sweep.
 *
 * Port of the 0.x `bun-port-smithers/workflow.tsx` and its seven subflows. An
 * operator first approves the run and may switch phases off. The enabled
 * phases then run in order, each as its own child run: lifetime
 * classification with three adversarial votes per sampled field, Phase A
 * implement-verify-fix per file, crate check loops tier by tier (25 rounds),
 * ungate loops with two reviewers and a decider (5 rounds), panic-probe rounds
 * (5), per-area test loops (30) merged one area at a time, and audit sweep
 * loops (3). An approval gate stops the run when the lifetime UNKNOWN rate or
 * the compile gate count crosses its threshold and the operator denies it.
 *
 * 0.x's `<Subflow>` is `.child()`; a fan-out over a list known only at run time (lifetime votes, probe fixes) is a nested child.
 * 0.x's `<HumanTask>` and `<ApprovalGate onDeny="fail">` are `HumanTask` questions in this flow; a gate asks a yes/no confirm, and a "no" fails the run.
 * 0.x's `<Loop until>` with `ctx.latest` is a planned recursion that hands each round the previous round's result.
 * 0.x's `<MergeQueue maxConcurrency={1}>` is a chain where each merge waits for the one before; the per-area merges declare that chain directly.
 * 0.x's `<Signal>` for external CI is a `WaitFor` named `test-swarm:external-ci`; its 24-hour `onTimeout="fail"` is the host's to enforce.
 * 0.x's `<Worktree>` per test area is host placement (see `40-sandbox-placement.ts`); the prompt still names the area branch.
 * 0.x's step cache, memory recall/remember and scorers are not ported; 0.x's dry-run agents are the test script.
 * 0.x split Claude Code writers and Pi reviewers; every step here takes the examples' seat, and in 1.0 tools are the host's registered flows (see `25-agent-tools-in-sandbox.ts`).
 * 0.x prompts ended with the output schema; `AgentAction` renders and enforces it instead.
 */
import * as AgentAction from "@smthrs/agent/AgentAction"
import { type Action, Flow, HumanTask, Interpreter, WaitFor } from "@smthrs/flow"
import * as Bounded from "@smthrs/patterns/Bounded"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

const seat = "anthropic:claude-sonnet-5-5"

const Count = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))
const Positive = Schema.Int.check(Schema.isGreaterThan(0))
const Fraction = Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 1 }))

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------

/** The seven phases, in the order they run. */
export const phases = ["lifetimes", "phaseA", "compile", "ungate", "probes", "tests", "sweeps"] as const

/** One phase name. */
export const Phase = Schema.Literals(phases)
type Phase = typeof Phase.Type

/** One Zig file to port. */
export const ZigFile = Schema.Struct({
  zig: Schema.String,
  loc: Schema.optional(Count),
  crate: Schema.optional(Schema.String)
})

/** One crate and the tier it compiles in. */
export const Crate = Schema.Struct({ name: Schema.String, tier: Schema.optional(Count) })

/** One ungate/proper-port target. */
export const Target = Schema.Struct({
  id: Schema.String,
  crate: Schema.String,
  file: Schema.String,
  reason: Schema.optional(Schema.String)
})

/** One behavior probe. */
export const Probe = Schema.Struct({ id: Schema.String, cmd: Schema.String, expect: Schema.optional(Schema.String) })

/** One focused test area. */
export const TestArea = Schema.Struct({ id: Schema.String, glob: Schema.String, crate: Schema.String })

/** One audit sweep. */
export const Sweep = Schema.Struct({
  id: Schema.String,
  kind: Schema.String,
  pattern: Schema.String,
  scope: Schema.String
})

type ZigFile = typeof ZigFile.Type
type Target = typeof Target.Type
type Probe = typeof Probe.Type
type TestArea = typeof TestArea.Type
type Sweep = typeof Sweep.Type

