/**
 * Extract incoming invoices, check them against approval rules, and queue the flagged ones for approvers.
 *
 * Port of the 0.x `invoice-approval-watch.jsx`. An extractor agent parses the
 * source into invoices, a rule-checker agent flags and risk-scores each one
 * against the approval threshold (default 5000), and a router agent assigns
 * an approver, priority and recommended action to the invoices marked as
 * needing approval. The router runs even when nothing is flagged and is told
 * how many invoices were processed in all.
 *
 * As in 0.x, the approval queue is the router's typed answer; no step waits on a person.
 * 0.x's prompts were placeholders that printed their props; these are minimal prompts written from the same props.
 * 0.x gave the agents `read`, `grep` and `bash` tools; in 1.0 tools are the host's registered flows (see `25-agent-tools-in-sandbox.ts`).
 */
import * as AgentAction from "@smthrs/agent/AgentAction"
import { Flow } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

const seat = "anthropic:claude-sonnet-5-5"

/** One extracted invoice. `currency` defaults to USD when the extractor omits it, as 0.x's did. */
export const Invoice = Schema.Struct({
  id: Schema.String,
  invoiceNumber: Schema.String,
  vendorName: Schema.String,
  vendorId: Schema.optional(Schema.String),
  amount: Schema.Number,
  currency: Schema.String.pipe(Schema.withDecodingDefaultKey(Effect.succeed("USD"))),
  lineItems: Schema.Array(Schema.Struct({
    description: Schema.String,
    quantity: Schema.Number,
    unitPrice: Schema.Number,
    total: Schema.Number
  })),
  dueDate: Schema.optional(Schema.String),
  poNumber: Schema.optional(Schema.String),
  sourceFile: Schema.String
})

/** The extractor's answer. */
export const InvoiceData = Schema.Struct({ invoices: Schema.Array(Invoice) })

/** One invoice's rule check. */
export const ValidationResult = Schema.Struct({
  invoiceId: Schema.String,
  invoiceNumber: Schema.String,
  vendorName: Schema.String,
  amount: Schema.Number,
  flags: Schema.Array(Schema.Literals([
    "high-value",
    "duplicate-suspect",
    "vendor-mismatch",
    "missing-po",
    "unusual-line-items",
    "over-budget",
    "new-vendor",
    "none"
  ])),
  riskScore: Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 1 })),
  needsApproval: Schema.Boolean,
  reasoning: Schema.String
})

/** The rule checker's answer. */
export const Validation = Schema.Struct({ results: Schema.Array(ValidationResult) })

/** The approval queue the flow settles with. */
export const ApprovalQueue = Schema.Struct({
  totalProcessed: Schema.Number,
  autoApproved: Schema.Number,
  queuedForApproval: Schema.Number,
  rejected: Schema.Number,
  queue: Schema.Array(Schema.Struct({
    invoiceId: Schema.String,
    invoiceNumber: Schema.String,
    vendorName: Schema.String,
    amount: Schema.Number,
    flags: Schema.Array(Schema.String),
    riskScore: Schema.Number,
    assignedApprover: Schema.String,
    priority: Schema.Literals(["urgent", "standard", "low"]),
    recommendedAction: Schema.Literals(["approve", "review", "reject"]),
    reasoning: Schema.String
  })),
  summary: Schema.String
})

/** Parses the source into invoices. */
export const Extract = AgentAction.make("examples/InvoiceApprovalWatch/Extract", {
  payload: { source: Schema.String, files: Schema.NullOr(Schema.Array(Schema.Json)), inboxFilter: Schema.Json },
  output: InvoiceData,
  seat,
  system: [
    `You are an invoice data extractor. Parse incoming emails, PDFs,
and attachments to extract structured invoice data. Identify invoice number,
vendor, line items, amounts, PO references, and due dates. Handle multiple
formats and normalize currency values.`
  ],
  prompt: ({ files, inboxFilter, source }) =>
    `Extract every invoice from this source.\n\nSource: ${source}\nFiles: ${JSON.stringify(files)}\nInbox filter: ${
      JSON.stringify(inboxFilter)
    }`
})

/** Flags and risk-scores each invoice against the approval rules. */
export const Validate = AgentAction.make("examples/InvoiceApprovalWatch/Validate", {
  payload: {
    invoices: InvoiceData.fields.invoices,
    approvalThreshold: Schema.Number,
    vendorAllowlist: Schema.NullOr(Schema.Array(Schema.Json)),
    duplicateWindow: Schema.String
  },
  output: Validation,
  seat,
  system: [
    `You are an invoice validation agent. Check each extracted invoice
against approval rules: flag high-value invoices above threshold, detect potential
duplicates, verify vendor records, check PO matching, and identify unusual line
items. Assign a risk score and determine whether human approval is needed.`
  ],
  prompt: ({ approvalThreshold, duplicateWindow, invoices, vendorAllowlist }) =>
    `Check each invoice against the approval rules.\n\nApproval threshold: ${approvalThreshold}\nDuplicate window: ${duplicateWindow}\nVendor allowlist: ${
      JSON.stringify(vendorAllowlist)
    }\nInvoices: ${JSON.stringify(invoices)}`
})

/** Assigns each flagged invoice an approver, a priority and a recommended action. */
export const Route = AgentAction.make("examples/InvoiceApprovalWatch/Route", {
  payload: {
    flaggedInvoices: Validation.fields.results,
    totalProcessed: Schema.Number,
    approverMapping: Schema.Json,
    escalationRules: Schema.Json
  },
  output: ApprovalQueue,
  seat,
  system: [
    `You are an approval queue coordinator. Take validated invoices
that need human review and route them to the correct approver based on amount
thresholds, department, and vendor tier. Auto-approve clean invoices below
threshold. Prioritize by due date urgency and risk score.`
  ],
  prompt: ({ approverMapping, escalationRules, flaggedInvoices, totalProcessed }) =>
    `Route the flagged invoices to approvers.\n\nTotal processed: ${totalProcessed}\nApprover mapping: ${
      JSON.stringify(approverMapping)
    }\nEscalation rules: ${JSON.stringify(escalationRules)}\nFlagged invoices: ${JSON.stringify(flaggedInvoices)}`
})

/** The invoices that need approval, and how many were checked. Pure, so it is a `Node.map`, not a step. */
const flagged = ({ results }: typeof Validation.Type) => ({
  flaggedInvoices: results.filter((result) => result.needsApproval),
  totalProcessed: results.length
})

/** The flow: extract, validate, route the flagged invoices. */
export const InvoiceApprovalWatch = Flow.make("examples/InvoiceApprovalWatch", {
  payload: {
    source: Schema.optional(Schema.String),
    files: Schema.optional(Schema.NullOr(Schema.Array(Schema.Json))),
    inboxFilter: Schema.optional(Schema.Json),
    approvalThreshold: Schema.optional(Schema.Number),
    vendorAllowlist: Schema.optional(Schema.NullOr(Schema.Array(Schema.Json))),
    duplicateWindow: Schema.optional(Schema.String),
    approverMapping: Schema.optional(Schema.Json),
    escalationRules: Schema.optional(Schema.Json)
  },
  success: ApprovalQueue,
  error: AgentAction.AgentFailure,
  body: ({
    approvalThreshold = 5000,
    approverMapping = null,
    duplicateWindow = "30d",
    escalationRules = null,
    files = null,
    inboxFilter = null,
    source = "email",
    vendorAllowlist = null
  }) =>
    Node.bindPlanned(
      Extract.call({ source, files, inboxFilter }),
      (data: Planned.Planned<typeof InvoiceData.Type>) =>
        Node.bindPlanned(
          Node.map(
            Validate.call({ invoices: data.invoices, approvalThreshold, vendorAllowlist, duplicateWindow }),
            flagged
          ),
          (checked: Planned.Planned<ReturnType<typeof flagged>>) =>
            Route.call({
              flaggedInvoices: checked.flaggedInvoices,
              totalProcessed: checked.totalProcessed,
              approverMapping,
              escalationRules
            })
        )
    )
})

/** Every step the flow calls. */
export const layer = Layer.mergeAll(Extract.layer, Validate.layer, Route.layer)
