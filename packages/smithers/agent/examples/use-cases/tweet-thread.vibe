/**
 * Post a pre-written countdown thread to X, one reply after another, three seconds apart.
 *
 * Port of the 0.x `tweet-thread.jsx`. The thread is 25 fixed tweets. The first
 * is posted on its own; each later one waits three seconds after the post
 * before it and replies to that post's id. A post without X credentials is
 * recorded as not posted, and the next tweet then starts a new thread, as in
 * 0.x; a post the X API refuses fails the run.
 *
 * 0.x's `<Timer duration="3s">` is `Sleep.action`, a durable timer the plan shows between posts.
 * Each post is an `irreversible` action with no idempotency key, so the engine never retries it: X takes no idempotency key, and a retry could post a tweet twice.
 * 0.x posted through `twitter-api-v2`, which the examples package does not depend on; `xLayer` signs the same API v2 request with OAuth 1.0a itself.
 */
import { Action, Flow, Sleep } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import * as Effect from "effect/Effect"
import * as Schema from "effect/Schema"
import { postSigned, xEnvironment } from "./tweet-thread.platform.ts"

/** The thread, in posting order: 0.x's pre-generated countdown, verbatim. */
export const tweets: ReadonlyArray<string> = [
