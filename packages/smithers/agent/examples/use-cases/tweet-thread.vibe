/** How long the thread waits between posts. */
export const delayMillis = 3_000

/** The X API v2 endpoint a post goes to. */
export const endpoint = "https://api.x.com/2/tweets"

/** What one post did. */
export const TweetPost = Schema.Struct({
  tweetId: Schema.String,
  posted: Schema.Boolean,
  error: Schema.optional(Schema.String)
})

/** The X API refused a post, or could not be reached (`status` 0). */
export class PostRefused extends Schema.TaggedError<PostRefused>()("examples/TweetThread/PostRefused", {
  status: Schema.Number,
  body: Schema.String
}) {}

/** Posts one tweet, as a reply when `replyToId` is a non-empty id. */
export const PostTweet = Action.make("examples/TweetThread/Post", {
  payload: { text: Schema.String, replyToId: Schema.optional(Schema.String) },
  success: TweetPost,
  error: PostRefused,
  tier: "irreversible"
})

type TweetPost = typeof TweetPost.Type

/** RFC 3986 percent-encoding, which OAuth 1.0a signs over. */
/**
 * The live X implementation. It reads the four `X_*` variables on every post,
 * as 0.x did, and records a post it has no credentials for as not posted.
 */
export const xLayer = PostTweet.toLayer(({ replyToId, text }) =>
  effect {
    const { accessSecret, accessToken, apiKey, apiSecret } = xEnvironment()
    if (!apiKey || !apiSecret || !accessToken || !accessSecret) {
      return {
        tweetId: "",
        posted: false,
        error: "Missing X_API_KEY, X_API_SECRET, X_ACCESS_TOKEN, or X_ACCESS_SECRET env vars."
      }
    }
    const body = replyToId ? { text, reply: { in_reply_to_tweet_id: replyToId } } : { text }
    const response = try Effect.tryPromise({
      try: () => postSigned(endpoint, { apiKey, apiSecret, accessToken, accessSecret }, body),
      catch: (cause) => new PostRefused({ status: 0, body: String(cause) })
    })
    if (!response.ok) throw new PostRefused({ status: response.status, body: response.text })
    const { data } = try Effect.orDie(
      Effect.try({
        try: () => JSON.parse(response.text) as { readonly data: { readonly id: string } },
        catch: (error) => error
      })
    )
    return { tweetId: data.id, posted: true }
  }
)

// `Sleep.action` is a system action that declares no requirement, so only the post appears here.
type Requirements = Action.Requirement<"examples/TweetThread/Post">

type Failure = PostRefused | Sleep.SleepRequestInvalid

/**
 * Posts tweet `index` and everything after it. Every tweet after the first
 * waits for the post before it, sleeps, and then replies to it: the sleep does
 * not read the previous post, so `Node.andThen` holds it back.
 */
const post = (
  index: number,
  previous: Planned.Planned<TweetPost> | undefined,
  posted: ReadonlyArray<Planned.Planned<TweetPost>>
): Node.Node<ReadonlyArray<TweetPost>, Failure, Requirements> => {
  const text = tweets[index]
  if (text === undefined) return Node.succeed(posted)
  const rest = Node.capture(
    { index },
    (current: Planned.Planned<TweetPost>) => post(index + 1, current, [...posted, current])
  )
  if (previous === undefined) return Node.bindPlanned(PostTweet.call({ text }), rest)
  return Node.andThen(
    Node.andThen(Node.succeed(previous), Sleep.action.call({ millis: delayMillis })),
    Node.bindPlanned(PostTweet.call({ text, replyToId: previous.tweetId }), rest)
  )
}

/** The thread, posted in order. It settles with every post's result. */
export const TweetThread = Flow.make("examples/TweetThread", {
  payload: {},
  success: Schema.Array(TweetPost),
  error: Schema.Union([PostRefused, Sleep.SleepRequestInvalid]),
  body: Node.capture({ action: PostTweet.name, tweets, delayMillis }, () => post(0, undefined, []))
})

/** The live X post; the interpreter supplies the durable timer. */
export const layer = xLayer
