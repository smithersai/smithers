/**
 * Plan, generate, run and heal end-to-end tests from a product brief, then report.
 *
 * Port of the 0.x `playwright-test-agent.jsx`. A planner agent turns the brief
 * into user flows, and a generator agent writes the specs. Then each round
 * runs the specs; a failing run goes to a healer agent, whose specs the next
 * round runs. A passing run ends the rounds, and so does `maxIterations`
 * (default 4), whose last heal still runs as it did in 0.x. A reporter agent
 * summarizes every attempt and run.
 *
 * 0.x's `<Loop until={passed} maxIterations onMaxReached="return-last">` is the planned recursion `17-review-loop.ts` uses. `ReviewLoop` does not fit: it does not revise after its last review, and 0.x reports every run.
 * 0.x's runner agent ran the Playwright command; here that is the deterministic `RunTests` action a host implements, so a test never starts a browser.
 * 0.x's prompts asked for a reply matching the output schema; `AgentAction` renders and enforces the output schema instead.
 * 0.x gave the agents `read`, `write`, `bash` and `grep` tools; in 1.0 tools are the host's registered flows (see `25-agent-tools-in-sandbox.ts`).
 */
import * as AgentAction from "@smthrs/agent/AgentAction"
import { Action, Flow } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import type * as Effect from "effect/Effect"
import * as Layer from "effect/Layer"
import * as Schema from "effect/Schema"

const seat = "anthropic:claude-sonnet-5-5"

/** The planner's user flows. */
export const TestPlan = Schema.Struct({
  appUrl: Schema.String,
  flows: Schema.Array(Schema.Struct({
    name: Schema.String,
    goal: Schema.String,
    steps: Schema.Array(Schema.String),
    assertions: Schema.Array(Schema.String),
    risk: Schema.Literals(["low", "medium", "high"])
  })),
  assumptions: Schema.Array(Schema.String)
})

/** The specs a generator or healer wrote. */
export const GeneratedTests = Schema.Struct({
  files: Schema.Array(Schema.Struct({
    path: Schema.String,
    summary: Schema.String,
    flowNames: Schema.Array(Schema.String)
  })),
  commands: Schema.Array(Schema.String),
  notes: Schema.String
})

/** One run of the specs. */
export const TestRun = Schema.Struct({
  passed: Schema.Boolean,
  command: Schema.String,
  total: Schema.Number,
  failed: Schema.Number,
  failures: Schema.Array(Schema.Struct({
    file: Schema.String,
    message: Schema.String,
    tracePath: Schema.optional(Schema.String),
    screenshotPath: Schema.optional(Schema.String)
  })),
  artifacts: Schema.Array(Schema.String)
})

/** The reporter's summary, which the flow settles with. */
export const FinalReport = Schema.Struct({
  status: Schema.Literals(["passed", "needs-human-review", "failed"]),
  coverageSummary: Schema.String,
  iterations: Schema.Number,
  artifacts: Schema.Array(Schema.String),
  nextActions: Schema.Array(Schema.String)
})

/** What the host's runner is asked to run. */
export const RunRequest = Schema.Struct({
  generatedTests: GeneratedTests,
  command: Schema.String,
  appUrl: Schema.String
})

type GeneratedTests = typeof GeneratedTests.Type
type TestRun = typeof TestRun.Type

/** Plans the flows to cover. */
export const PlanTests = AgentAction.make("examples/PlaywrightTestAgent/Plan", {
  payload: {
    appUrl: Schema.String,
    productBrief: Schema.String,
    seedTest: Schema.NullOr(Schema.String),
    existingTestGlob: Schema.String
  },
  output: TestPlan,
  seat,
  system: [
    `You are an E2E test planner. Explore the product brief, existing tests,
and app routes. Produce a focused Playwright plan with flows, steps, assertions,
and risk. Prefer user-visible behavior over implementation details.`
  ],
  prompt: (input) =>
    `Plan Playwright E2E coverage for the supplied app and product brief. Include user flows, steps, assertions, risk, and assumptions.\n\nINPUT: ${
      JSON.stringify(input)
    }`
})

/** Writes specs for the plan. */
export const GenerateTests = AgentAction.make("examples/PlaywrightTestAgent/Generate", {
  payload: { plan: TestPlan, testDirectory: Schema.String, appUrl: Schema.String },
  output: GeneratedTests,
  seat,
  system: [
    `You are a Playwright test generator. Write tests under tests/generated
or the requested test directory. Keep selectors stable, set up fixtures explicitly,
and do not weaken assertions to make tests pass.`
  ],
  prompt: (input) =>
    `Generate Playwright tests from the approved test plan. Write only under the requested test directory and keep assertions meaningful.\n\nINPUT: ${
      JSON.stringify(input)
    }`
})

/** Runs the specs. Deterministic: a host implements it with the Playwright CLI. */
export const RunTests = Action.make("examples/PlaywrightTestAgent/RunTests", {
  payload: RunRequest,
  success: TestRun
})

/** Repairs the specs a run failed. */
export const HealTests = AgentAction.make("examples/PlaywrightTestAgent/Heal", {
  payload: {
    generatedTests: GeneratedTests,
    latestRun: TestRun,
    productBrief: Schema.String,
    assertionPolicy: Schema.String
  },
  output: GeneratedTests,
  seat,
  system: [
    `You are a Playwright test healer. Repair broken selectors, waits,
fixtures, and setup. Preserve the user-story assertions unless you explicitly
explain why an assertion was invalid.`
  ],
  prompt: (input) =>
    `Repair failing Playwright tests without weakening business assertions. Focus on selectors, waits, fixtures, setup, and invalid assumptions.\n\nINPUT: ${
      JSON.stringify(input)
    }`
})

/** Summarizes every attempt and run. */
export const ReportRun = AgentAction.make("examples/PlaywrightTestAgent/Report", {
  payload: {
    plan: TestPlan,
    generatedAttempts: Schema.Array(GeneratedTests),
    runs: Schema.Array(TestRun),
    passed: Schema.Boolean
  },
  output: FinalReport,
  seat,
  system: [
    `You are an E2E QA reporter. Summarize generated coverage, remaining
failures, artifacts, and concrete follow-up actions.`
  ],
  prompt: (input) =>
    `Summarize the Playwright agent run: coverage, pass/fail status, iterations, artifacts, and next actions.\n\nINPUT: ${
      JSON.stringify(input)
    }`
})

/** What every round reads, fixed when the body plans. */
interface Settings {
  readonly plan: Planned.Planned<typeof TestPlan.Type>
  readonly appUrl: string
  readonly command: string
  readonly productBrief: string
  readonly assertionPolicy: string
  readonly maxIterations: number
}

type Requirements = Action.Requirement<
  | "examples/PlaywrightTestAgent/RunTests"
  | "examples/PlaywrightTestAgent/Heal"
  | "examples/PlaywrightTestAgent/Report"
>

/**
 * Round `iteration`: run the latest specs, report on a pass, otherwise heal
 * and run again until the last planned round, whose heal still runs.
 * `attempts` and `runs` hold planned references in the order they ran.
 */
const round = (
  settings: Settings,
  iteration: number,
  latest: Planned.Planned<GeneratedTests>,
  attempts: ReadonlyArray<Planned.Planned<GeneratedTests>>,
  runs: ReadonlyArray<Planned.Planned<TestRun>>
): Node.Node<typeof FinalReport.Type, AgentAction.AgentFailure, Requirements> =>
  Node.branch(RunTests.call({ generatedTests: latest, command: settings.command, appUrl: settings.appUrl }), {
    if: (run) => run.passed,
    then: (run) =>
      ReportRun.call({ plan: settings.plan, generatedAttempts: attempts, runs: [...runs, run], passed: true }),
    else: (run) =>
      Node.bindPlanned(
        HealTests.call({
          generatedTests: latest,
          latestRun: run,
          productBrief: settings.productBrief,
          assertionPolicy: settings.assertionPolicy
        }),
        (healed: Planned.Planned<GeneratedTests>) =>
          iteration >= settings.maxIterations
            ? ReportRun.call({
              plan: settings.plan,
              generatedAttempts: [...attempts, healed],
              runs: [...runs, run],
              passed: false
            })
            : round(settings, iteration + 1, healed, [...attempts, healed], [...runs, run])
      )
  })

/** The flow. `maxIterations` is real at plan time, so it sets how many rounds the plan holds. */
export const PlaywrightTestAgent = Flow.make("examples/PlaywrightTestAgent", {
  payload: {
    appUrl: Schema.optional(Schema.String),
    productBrief: Schema.optional(Schema.String),
    story: Schema.optional(Schema.String),
    seedTest: Schema.optional(Schema.String),
    existingTestGlob: Schema.optional(Schema.String),
    testDirectory: Schema.optional(Schema.String),
    testCommand: Schema.optional(Schema.String),
    assertionPolicy: Schema.optional(Schema.String),
    maxIterations: Schema.optional(Schema.Int.check(Schema.isGreaterThan(0)))
  },
  success: FinalReport,
  error: AgentAction.AgentFailure,
  body: ({
    appUrl = "http://localhost:3000",
    assertionPolicy = "Do not remove or weaken business-critical assertions.",
    existingTestGlob = "tests/**/*.spec.{ts,tsx}",
    maxIterations = 4,
    productBrief,
    seedTest,
    story,
    testCommand = "npx playwright test tests/generated --trace retain-on-failure",
    testDirectory = "tests/generated"
  }) => {
    const brief = productBrief ?? story ?? ""
    return Node.bindPlanned(
      PlanTests.call({ appUrl, productBrief: brief, seedTest: seedTest ?? null, existingTestGlob }),
      (plan: Planned.Planned<typeof TestPlan.Type>) =>
        Node.bindPlanned(
          GenerateTests.call({ plan, testDirectory, appUrl }),
          (generated: Planned.Planned<GeneratedTests>) =>
            round(
              { plan, appUrl, command: testCommand, productBrief: brief, assertionPolicy, maxIterations },
              1,
              generated,
              [generated],
              []
            )
        )
    )
  }
})

/** What a host supplies for the step that leaves the model. */
export interface Host {
  readonly runTests: (request: typeof RunRequest.Type) => TestRun!!
}

/** Every step the flow calls, with the host's test runner. */
export const layer = (host: Host) =>
  Layer.mergeAll(
    PlanTests.layer,
    GenerateTests.layer,
    RunTests.toLayer(host.runTests),
    HealTests.layer,
    ReportRun.layer
  )
