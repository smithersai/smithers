/**
 * Resolve a prompt from a given string, a cached entry, or a Socratic question loop with a person.
 *
 * Port of the 0.x `components/extract-prompt/` `<ExtractPrompt>` component. A
 * provided prompt of at least 32 characters passes through, and so does a
 * cached entry; neither asks a model. Otherwise a drafter agent fills the
 * R-C-T-F slots (role, context, task, format) and scores its own draft. A
 * draft that reaches the threshold (1.0 for high stakes, 0.7 for low, or an
 * explicit `threshold`) settles the flow; below it, the person answers the
 * draft's one Socratic question and the drafter refines, for at most
 * `maxTurns` drafts (default 10), settling with the last draft at the bound.
 *
 * 0.x's drafter asked the person itself through an `ask-user` bash script; here the flow asks the draft's `nextQuestion` as a `HumanTask` and hands the answer to the next draft.
 * 0.x's loop ended on the score alone, so a draft the person overrode below the threshold still asks again until the bound; kept.
 * 0.x's cache I/O (`MarkdownPromptCache`, `SqlitePromptCache`) was the caller's job, so the flow takes the cache hit as `cached`; the optional `scorers` observability hook is not ported.
 * 0.x's slot fields had zod defaults; here the drafter fills every slot, and `AgentAction` renders and enforces the output schema instead of the prompt's JSON instruction.
 */
import * as AgentAction from "@smthrs/agent/AgentAction"
import { type Action, Flow, HumanTask } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import type * as Planned from "@smthrs/plan/Planned"
import * as Schema from "effect/Schema"

const seat = "anthropic:claude-sonnet-5-5"

/** A provided prompt shorter than this, once trimmed, is extracted rather than passed through. */
export const minTrivialLength = 32

const Fraction = Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 1 }))

/** How sure the person must be before a draft is good enough. */
export const Stakes = Schema.Literals(["high", "low"])

/** The threshold a stakes label stands for: every slot strongly filled for high stakes, good enough for low. */
export const stakesToThreshold = (stakes: typeof Stakes.Type): number => stakes === "high" ? 1.0 : 0.7

/** The R-C-T-F slots, plus the auxiliary ones that often matter. */
export schema Structured {
  readonly role: string
  readonly context: string
  readonly task: string
  readonly format: string
  readonly constraints: ReadonlyArray<string>
  readonly successCriteria: ReadonlyArray<string>
  readonly outOfScope: ReadonlyArray<string>
}

/** The Socratic principle the next question applies. */
export const Principle = Schema.Literals([
  "definition",
  "elenchus",
  "hypothesis-elimination",
  "generalization",
  "induction",
  "dialectic",
  "maieutic",
  "analogy",
  "irony",
  "recollection",
  "none"
])

/** One draft of the extracted prompt, and what the flow settles with. */
export const RctfPrompt = Schema.Struct({
  prompt: Schema.String.annotate({ description: "Rendered prompt body, suitable for paste into an LLM." }),
  structured: Structured,
  score: Fraction.annotate({ description: "Self-score for R-C-T-F slot completeness." }),
  scoreReason: Schema.String,
  nextQuestion: Schema.String.annotate({ description: "One Socratic follow-up question; empty when ready." }),
  nextPrinciple: Principle,
  resolved: Schema.Boolean,
  overridden: Schema.Boolean.annotate({ description: "True if the user told you to ship below the threshold." }),
  overrideReason: Schema.NullOr(Schema.String)
})

/** A prompt a caller's cache returned for the same key. */
export const CachedPrompt = Schema.Struct({
  key: Schema.String,
  prompt: Schema.String,
  structured: Schema.Record(Schema.String, Schema.Json),
  schema: Schema.Literals(["rctf", "prd", "freeform"]),
  stakes: Stakes,
  score: Schema.Number,
  scoreReason: Schema.String,
  createdAt: Schema.String,
  source: Schema.Literals(["extracted", "manual"]),
  overridden: Schema.Boolean
})

type RctfPrompt = typeof RctfPrompt.Type

const emptyStructured: typeof Structured.Type = {
  role: "",
  context: "",
  task: "",
  format: "",
  constraints: [],
  successCriteria: [],
  outOfScope: []
}

/** The draft a provided prompt stands for. */
const provided = (prompt: string): RctfPrompt => ({
  prompt,
  structured: emptyStructured,
  score: 1.0,
  scoreReason: "Provided directly by caller; no extraction performed.",
  nextQuestion: "",
  nextPrinciple: "none",
  resolved: true,
  overridden: false,
  overrideReason: null
})

/** The draft a cache hit stands for. Unrecognizable cached slots are replaced by empty ones, as in 0.x. */
const fromCache = (cached: typeof CachedPrompt.Type): RctfPrompt => {
  const s = cached.structured
  const structured = typeof s.role === "string" && typeof s.context === "string" && typeof s.task === "string"
      && typeof s.format === "string"
    ? {
      role: s.role,
      context: s.context,
      task: s.task,
      format: s.format,
      constraints: Schema.is(Schema.Array(Schema.String))(s.constraints) ? s.constraints : [],
      successCriteria: Schema.is(Schema.Array(Schema.String))(s.successCriteria) ? s.successCriteria : [],
      outOfScope: Schema.is(Schema.Array(Schema.String))(s.outOfScope) ? s.outOfScope : []
    }
    : emptyStructured
  return {
    prompt: cached.prompt,
    structured,
    score: cached.score,
    scoreReason: `cached: ${cached.scoreReason}`,
    nextQuestion: "",
    nextPrinciple: "none",
    resolved: true,
    overridden: cached.overridden,
    overrideReason: null
  }
}

const scoreBanner = (score: number | undefined, threshold: number, stakes: string): string => {
  if (score === undefined) return `Score: pending. Threshold: ${threshold} (stakes: ${stakes}).`
  if (score >= threshold) {
    return `✅ Score ${score.toFixed(2)} ≥ threshold ${threshold} (stakes: ${stakes}). I think this is ready.`
  }
  return `⚠ Score ${score.toFixed(2)} < threshold ${threshold} (stakes: ${stakes}). Not yet ready by my judgment.`
}

const priorDraftBlock = (draft: RctfPrompt | undefined): string =>
  draft === undefined ? "" : [
    "## Prior draft",
    "```json",
    JSON.stringify(draft, null, 2),
    "```",
    "",
    "Refine this draft. If a slot is already strongly filled, leave it.",
    "Identify the weakest slot and ask one Socratic question to improve it."
  ].join("\n")

/** One draft: refine the prior draft with the person's answer, ask one question, and self-score. */
export const Draft = AgentAction.make("examples/ExtractPrompt/Draft", {
  payload: {
    context: Schema.String,
    threshold: Schema.Number,
    stakes: Stakes,
    priorDraft: Schema.optional(RctfPrompt),
    answer: Schema.optional(Schema.String)
  },
  output: RctfPrompt,
  seat,
  system: [
    `You are a prompt extraction agent. Your job: turn an under-specified
human request into a high-quality, structured prompt suitable for paste
into another LLM.`
  ],
  prompt: ({ answer, context, priorDraft, stakes, threshold }) =>
    `# Extract Prompt (R-C-T-F via Socratic questioning)

You will run inside a loop. Each iteration:

1. Read the prior draft (if any) and the user's last answer.
2. Identify the **weakest R-C-T-F slot** and ask **one** Socratic
   follow-up question to fill it. Pick exactly one principle from the
   list below; do not bundle multiple questions.
3. Update the structured draft.
4. **Self-score** the result on \`[0, 1]\` for R-C-T-F slot completeness.
   Be strict: 1.0 means every slot is strongly and unambiguously filled.
5. If \`score >= threshold\` AND the slots are coherent, set
   \`resolved: true\` and leave \`nextQuestion\` empty.

## R-C-T-F slots (the structure to fill)

- **Role** — who is the LLM in this prompt? ("a senior security
  engineer", "a friendly tutor for 5-year-olds")
- **Context** — what background does the LLM need to be effective?
  (codebase facts, constraints, prior decisions)
- **Task** — what exactly is the LLM being asked to do?
- **Format** — what shape should the output take? (markdown, JSON,
  bullet list, code block)

Plus auxiliary slots that often matter:

- **Constraints** — hard rules the output must satisfy
- **Success criteria** — how the human will judge "done"
- **Out of scope** — explicit non-goals that prevent drift

## Socratic principles (pick ONE for the next question)

| Principle              | When to use                                                   |
| ---------------------- | ------------------------------------------------------------- |
| definition             | The user's terms are ambiguous; pin them down                 |
| elenchus               | The user's stated request contradicts itself                  |
| hypothesis-elimination | Multiple plausible readings; rule one out                     |
| generalization         | Surface the broader principle behind a specific request       |
| induction              | Several examples are given; ask for the rule                  |
| dialectic              | Two competing concerns need resolution                        |
| maieutic               | Draw out a latent assumption the user hasn't stated           |
| analogy                | A familiar analogue would clarify scope                       |
| irony                  | The literal request is implausible; gently surface the gap    |
| recollection           | The user already answered something you should reuse          |
| none                   | The prompt is complete; no more questions                     |

## Asking the user

Put your one question in \`nextQuestion\`. The user is asked it after this
iteration, and their answer comes back to you in the next one.

## Self-score rubric

Compute four sub-scores and average them:

- Role:    0.0 missing → 0.5 vague → 1.0 specific and operational
- Context: 0.0 missing → 0.5 generic → 1.0 enough to act without guessing
- Task:    0.0 vague   → 0.5 unambiguous verb → 1.0 unambiguous + scoped
- Format:  0.0 missing → 0.5 mentioned → 1.0 explicit shape and size

Put the average in \`score\` and a one-sentence justification in \`scoreReason\`.

## Score banner (current state from the loop)

${scoreBanner(priorDraft?.score, threshold, stakes)}

(Threshold for this run: ${threshold}. Stakes: ${stakes}.)

## Override behavior (human-in-the-loop)

The human has the final word. If you have asked enough questions and the
score is still below the threshold, the human may answer "ship it" or
similar. When that happens:

- set \`resolved: true\`
- set \`overridden: true\`
- set \`overrideReason\` to the verbatim user reason
- do not silently inflate \`score\`; keep it honest

If the human says "ship it" while the score is already at/above threshold,
just set \`resolved: true\` (no override needed).

If the human says "keep going" or asks a new question, continue the loop:
ask one more Socratic question, refine the draft, and recompute the score.

## Inputs

${context ? `## Context\n${context}` : ""}

${priorDraftBlock(priorDraft)}

${answer === undefined ? "" : `## The user's answer to your last question\n${answer}`}

## Output

Fill \`prompt\` with the rendered, paste-ready prompt body assembled from the
structured slots. Fill \`nextQuestion\` with the next Socratic question (empty
when \`resolved: true\`).`
})

type Requirements = Action.Requirement<"examples/ExtractPrompt/Draft">

type Failure = AgentAction.AgentFailure | HumanTask.HumanTaskFailed

/** What every draft of one extraction is told besides the prior draft and the answer. */
interface Loop {
  readonly context: string
  readonly threshold: number
  readonly stakes: typeof Stakes.Type
  readonly maxTurns: number
}

/**
 * Draft `turn`: settle once the draft reaches the threshold or the bound,
 * otherwise ask the person the draft's question and draft again with the
 * answer.
 */
const extract = (
  loop: Loop,
  turn: number,
  priorDraft: Planned.Planned<RctfPrompt> | undefined,
  answer: Planned.Planned<string> | undefined
): Node.Node<RctfPrompt, Failure, Requirements> =>
  Node.branch(
    Draft.call({ context: loop.context, threshold: loop.threshold, stakes: loop.stakes, priorDraft, answer }),
    {
      if: Node.capture({ threshold: loop.threshold }, function(draft: RctfPrompt) {
        return draft.score >= this.threshold
      }),
      then: Node.capture({}, (draft) => Node.succeed(draft)),
      else: Node.capture({ loop, turn }, (draft) =>
        turn >= loop.maxTurns
          ? Node.succeed(draft)
          : Node.bindPlanned(
            HumanTask.decode(Schema.String)(
              HumanTask.action.call({ name: `extract-prompt-${turn}`, kind: "ask", prompt: draft.nextQuestion })
            ),
            Node.capture({ loop, turn }, (reply: Planned.Planned<string>) => extract(loop, turn + 1, draft, reply))
          ))
    }
  )

/** The flow. Its payload is real at plan time, so the passthroughs are decided before anything runs. */
export const ExtractPrompt = Flow.make("examples/ExtractPrompt", {
  payload: {
    prompt: Schema.optional(Schema.String),
    cached: Schema.optional(CachedPrompt),
    stakes: Schema.optional(Stakes),
    threshold: Schema.optional(Fraction),
    maxTurns: Schema.optional(Schema.Int.check(Schema.isGreaterThan(0))),
    context: Schema.optional(Schema.String)
  },
  success: RctfPrompt,
  error: Schema.Union([AgentAction.AgentFailure, HumanTask.HumanTaskFailed]),
  body: Node.capture({}, ({ cached, context = "", maxTurns = 10, prompt, stakes = "low", threshold }) => {
    if (prompt !== undefined && prompt.trim().length >= minTrivialLength) return Node.succeed(provided(prompt))
    if (cached !== undefined) return Node.succeed(fromCache(cached))
    return extract(
      { context, threshold: threshold ?? stakesToThreshold(stakes), stakes, maxTurns },
      1,
      undefined,
      undefined
    )
  })
})

/** Every step the flow calls. */
export const layer = Draft.layer
