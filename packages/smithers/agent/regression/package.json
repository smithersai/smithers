{
  "name": "@smthrs/eval-agent",
  "private": true,
  "smthrs": {
    "group": "tooling"
  },
  "type": "module",
  "version": "0.0.0",
  "description": "Offline flows-agent evaluation suite, gated on the committed baseline, and the character runner for agent profiles",
  "scripts": {
    "check": "vibelang -p tsconfig.json --noEmit",
    "test": "bun run.vibe",
    "character": "bun character/run.ts",
    "test:character": "bun test character"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@smthrs/agent": "workspace:*",
    "@smthrs/core": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/evals": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/scorers": "workspace:*",
    "effect": "4.1.1",
    "yaml": "2.9.0",
    "vibelang-runtime": "0.0.14-pre.b9285da0f2be"
  },
  "devDependencies": {
    "@smthrs/targets": "workspace:*",
    "@types/node": "26.4.1",
    "bun-types": "^1.4.0",
    "typescript": "5.9.3",
    "vibelang": "0.0.14-pre.b9285da0f2be"
  },
  "imports": {
    "#vibelang/emitted/character/rubric": {
      "types": "./character/rubric.ts",
      "vibelang-source": "./character/rubric.ts",
      "default": "./.vibelang/js/character/rubric.js"
    },
    "#vibelang/emitted/character/world": {
      "types": "./character/world.ts",
      "vibelang-source": "./character/world.ts",
      "default": "./.vibelang/js/character/world.js"
    }
  }
}
