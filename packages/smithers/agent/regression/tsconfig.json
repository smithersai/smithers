{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["vibelang-source"],
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "module": "Node18",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "inlineSources": false,
    "sourceMap": false,
    // `character/*.test.ts` are `bun:test` suites, so the checked set needs Bun's globals as well as Node's.
    "types": ["bun-types", "node"]
  },
  "include": ["*.ts", "character/*.ts", "*.vibe", "character/*.vibe"],
  "exclude": ["PACKAGE.ts"]
}
