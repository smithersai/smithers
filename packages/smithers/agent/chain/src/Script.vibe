/**
 * The authored artifact of one link: flow-script text plus its content
 * digest.
 *
 * The digest is the replay identity of every call the script makes
 * (https://chain.smithers.sh/contract/). Extraction implements gate 1
 * (shape): the author's output must contain exactly one fenced flow block.
 *
 * @since 0.1.0
 */

import * as Digest from "@smthrs/core/Digest"
import { isWellFormed } from "./internal/unicode.ts"

/**
 * A link's flow-script text paired with the content digest that keys every
 * call it makes.
 *
 * @category models
 * @since 0.1.0
 * @slop
 */
export const Script = Schema.Struct({
  text: Schema.String,
  digest: Schema.String
})

/**
 * The decoded form of {@link Script}.
 *
 * @category models
 * @since 0.1.0
 * @slop
 */
export type Script = typeof Script.Type

/**
 * Builds a script from its text, digesting it.
 *
 * @category constructors
 * @since 0.1.0
 * @slop
 */
export const make = (text: string): Script => ({ text, digest: $invoke(Digest,() => (text)) })

/**
 * The result of applying the shape gate: an extracted script, or the
 * rejection prose the next authoring reads.
 *
 * @category models
 * @since 0.1.0
 * @slop
 */
export type Extraction =
  | { readonly _tag: "Extracted"; readonly script: Script }
  | { readonly _tag: "Rejected"; readonly reason: string }

// Closes the way a markdown fence closes: on a line holding only a run of
// backticks at least as long as the opening run, plus trailing blanks. A
// lazy match on any "\n```" would end the block at an inner "```js" line
// inside a template literal and hand the runner a truncated script.
const fence = /(?<!`)(`{3,})flow\n([\s\S]*?)\n\1`*[ \t]*(?=\n|$)/g

/**
 * Applies the shape gate to raw author output: exactly one fenced `flow`
 * block, whose body becomes the script. The block opens with three or more
 * backticks followed by `flow` and closes on a line holding only at least
 * as many backticks, so a longer opening fence can carry inner fences.
 * CRLF line endings are read as LF, so the script text always uses LF. A
 * block holding an unpaired UTF-16 surrogate is rejected: it has no digest.
 *
 * @category gates
 * @since 0.1.0
 * @slop
 */
export const extract = (raw: string): Extraction => {
  // Some routes return CRLF text; the fence only knows LF line ends.
  const blocks = [...raw.replace(/\r\n/g, "\n").matchAll(fence)]
  const first = blocks[0]
  if (first === undefined) {
    return { _tag: "Rejected", reason: "the author output contains no ```flow block" }
  }
  if (blocks.length > 1) {
    return {
      _tag: "Rejected",
      reason: `the author output contains ${blocks.length} \`\`\`flow blocks, expected exactly one`
    }
  }
  // The capture group always participates when the fence matches.
  const text = first[2] as string
  if (!isWellFormed(text)) {
    return { _tag: "Rejected", reason: "the ```flow block holds an unpaired UTF-16 surrogate, which is not text" }
  }
  return { _tag: "Extracted", script: make(text) }
}

module $call$ts {
export function invoke<T extends {"digest":Function}>(target:T,arg0:()=>Parameters<Extract<T["digest"],(...args:any[])=>any>>[0]):ReturnType<Extract<T["digest"],(...args:any[])=>any>> { return target["digest"](arg0()) }
}
import { invoke as $invoke } from $call$ts
