{
  "name": "@smthrs/chain",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "private": true,
  "description": "The Agent Chain spine: an append-only journal, keyed replayable calls, and the trampoline that runs model-authored flow scripts",
  "homepage": "https://github.com/smithersai/smithers",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/agent/chain"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "tags": [
    "typescript",
    "effect",
    "chain",
    "harness",
    "durability"
  ],
  "keywords": [
    "typescript",
    "effect",
    "chain",
    "harness",
    "durability"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./CallKey": {
      "types": "./.vibe/declarations/src/CallKey.d.vibe.ts",
      "vibelang-source": "./src/CallKey.vibe",
      "default": "./.vibelang/js/src/CallKey.js"
    },
    "./Observation": {
      "types": "./.vibe/declarations/src/Observation.d.vibe.ts",
      "vibelang-source": "./src/Observation.vibe",
      "default": "./.vibelang/js/src/Observation.js"
    },
    "./internal/ChildRunError": {
      "types": "./.vibe/declarations/src/internal/ChildRunError.d.vibe.ts",
      "vibelang-source": "./src/internal/ChildRunError.vibe",
      "default": "./.vibelang/js/src/internal/ChildRunError.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "vibelang-source": "./src/*.ts",
      "default": "./.vibelang/js/src/*.js"
    },
    "./internal/*": null,
    "./*/index": null,
    "./Author": {
      "types": {
        "default": "./.vibe/declarations/src/Author.d.vibe.ts"
      },
      "vibelang-source": "./src/Author.vibe",
      "default": "./.vibelang/js/src/Author.js"
    },
    "./AuthorDeclaration": {
      "types": {
        "default": "./src/AuthorDeclaration.ts"
      },
      "vibelang-source": "./src/AuthorDeclaration.ts",
      "default": "./.vibelang/js/src/AuthorDeclaration.js"
    },
    "./Catalog": {
      "types": {
        "default": "./.vibe/declarations/src/Catalog.d.vibe.ts"
      },
      "vibelang-source": "./src/Catalog.vibe",
      "default": "./.vibelang/js/src/Catalog.js"
    },
    "./Authorize": {
      "types": {
        "default": "./src/Authorize.ts"
      },
      "vibelang-source": "./src/Authorize.ts",
      "default": "./.vibelang/js/src/Authorize.js"
    },
    "./Script": {
      "types": {
        "default": "./.vibe/declarations/src/Script.d.vibe.ts"
      },
      "vibelang-source": "./src/Script.vibe",
      "default": "./.vibelang/js/src/Script.js"
    },
    "./Outcome": {
      "types": {
        "default": "./.vibe/declarations/src/Outcome.d.vibe.ts"
      },
      "vibelang-source": "./src/Outcome.vibe",
      "default": "./.vibelang/js/src/Outcome.js"
    },
    "./Event": {
      "types": {
        "default": "./.vibe/declarations/src/Event.d.vibe.ts"
      },
      "vibelang-source": "./src/Event.vibe",
      "default": "./.vibelang/js/src/Event.js"
    },
    "./internal/childRun": {
      "types": {
        "default": "./src/internal/childRun.ts"
      },
      "vibelang-source": "./src/internal/childRun.ts",
      "default": "./.vibelang/js/src/internal/childRun.js"
    },
    "./Journal": {
      "types": {
        "default": "./.vibe/declarations/src/Journal.d.vibe.ts"
      },
      "vibelang-source": "./src/Journal.vibe",
      "default": "./.vibelang/js/src/Journal.js"
    },
    "./JsonBoundary": {
      "types": {
        "default": "./src/JsonBoundary.ts"
      },
      "vibelang-source": "./src/JsonBoundary.ts",
      "default": "./.vibelang/js/src/JsonBoundary.js"
    },
    "./ScriptRunner": {
      "types": {
        "default": "./src/ScriptRunner.ts"
      },
      "vibelang-source": "./src/ScriptRunner.ts",
      "default": "./.vibelang/js/src/ScriptRunner.js"
    },
    "./Steering": {
      "types": {
        "default": "./.vibe/declarations/src/Steering.d.vibe.ts"
      },
      "vibelang-source": "./src/Steering.vibe",
      "default": "./.vibelang/js/src/Steering.js"
    },
    "./Chain": {
      "types": {
        "default": "./src/Chain.ts"
      },
      "vibelang-source": "./src/Chain.ts",
      "default": "./.vibelang/js/src/Chain.js"
    },
    "./internal/failureCode": {
      "types": {
        "default": "./src/internal/failureCode.ts"
      },
      "vibelang-source": "./src/internal/failureCode.ts",
      "default": "./.vibelang/js/src/internal/failureCode.js"
    },
    "./MemoryEntries": {
      "types": {
        "default": "./src/MemoryEntries.ts"
      },
      "vibelang-source": "./src/MemoryEntries.ts",
      "default": "./.vibelang/js/src/MemoryEntries.js"
    },
    "./ModelAuthor": {
      "types": {
        "default": "./.vibe/declarations/src/ModelAuthor.d.vibe.ts"
      },
      "vibelang-source": "./src/ModelAuthor.vibe",
      "default": "./.vibelang/js/src/ModelAuthor.js"
    },
    "./internal/prompts": {
      "types": {
        "default": "./src/internal/prompts.ts"
      },
      "vibelang-source": "./src/internal/prompts.ts",
      "default": "./.vibelang/js/src/internal/prompts.js"
    },
    "./Prompt": {
      "types": {
        "default": "./src/Prompt.ts"
      },
      "vibelang-source": "./src/Prompt.ts",
      "default": "./.vibelang/js/src/Prompt.js"
    },
    "./internal/QuickJsJobs": {
      "types": {
        "default": "./.vibe/declarations/src/internal/QuickJsJobs.d.vibe.ts"
      },
      "vibelang-source": "./src/internal/QuickJsJobs.vibe",
      "default": "./.vibelang/js/src/internal/QuickJsJobs.js"
    },
    "./QuickJsRunner": {
      "types": {
        "default": "./src/QuickJsRunner.ts"
      },
      "vibelang-source": "./src/QuickJsRunner.ts",
      "default": "./.vibelang/js/src/QuickJsRunner.js"
    },
    "./RegistryCatalog": {
      "types": {
        "default": "./.vibe/declarations/src/RegistryCatalog.d.vibe.ts"
      },
      "vibelang-source": "./src/RegistryCatalog.vibe",
      "default": "./.vibelang/js/src/RegistryCatalog.js"
    },
    "./SubChains": {
      "types": {
        "default": "./.vibe/declarations/src/SubChains.d.vibe.ts"
      },
      "vibelang-source": "./src/SubChains.vibe",
      "default": "./.vibelang/js/src/SubChains.js"
    },
    "./index": {
      "types": {
        "default": "./src/index.ts"
      },
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    }
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    ".vibelang/js",
    "src/SubChains.vibe"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "./*": {
        "types": "./dist/esm/*.d.ts",
        "import": "./dist/esm/*.js",
        "require": "./dist/cjs/*.js"
      },
      "./internal/*": null,
      "./*/index": null
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "prompts": "node scripts/prompts.mjs",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@smthrs/capability": "workspace:*",
    "@smthrs/core": "workspace:*",
    "@smthrs/memory": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "effect": "4.1.1",
    "quickjs-emscripten-core": "0.32.0",
    "vibelang-runtime": "file:../../../../.vibelang-toolchain/vibelang-runtime-0.0.11-6a665783b5e4.tgz"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@eslint/js": "9.39.5",
    "@smthrs/testing": "workspace:*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "file:../../../../.vibelang-toolchain/vibelang-0.0.11-71bb3aebbfe6.tgz",
    "vibelang-vite": "file:../../../../.vibelang-toolchain/vibelang-vite-0.0.11-a43d2b04075f.tgz",
    "vitest": "5.0.0"
  }
}
