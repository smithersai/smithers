{
  "name": "@smthrs/terminal-frame",
  "version": "0.1.0",
  "smthrs": {
    "group": "agent"
  },
  "private": true,
  "description": "A shell's terminal for Smithers UIs: xterm.js in an opaque-origin frame that a pinned CSP keeps off the network, while the page holds the connection. Kept out of @smthrs/ui so pages without a terminal never load it.",
  "homepage": "https://github.com/smithersai/smithers/tree/main/packages/smithers/ui/terminal-frame",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/ui/terminal-frame"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "check": "vibelang -p tsconfig.json --noEmit",
    "test": "bun test --isolate ./test",
    "generate": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@smthrs/ui": "workspace:*",
    "@smthrs/views": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.2",
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.13.2",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~5.9.3"
  }
}
