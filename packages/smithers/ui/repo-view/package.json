{
  "name": "@smthrs/repo-view",
  "version": "0.1.0",
  "smthrs": {
    "group": "agent"
  },
  "private": true,
  "description": "The heavy views of a repository for Smithers UIs: the repository browser, a file highlighted by Shiki, a highlighted diff and the Milkdown Markdown editor, kept out of @smthrs/ui so pages that show no code never load them.",
  "homepage": "https://github.com/smithersai/smithers/tree/main/packages/smithers/ui/repo-view",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/ui/repo-view"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "check": "vibelang -p tsconfig.json --noEmit",
    "test": "bun test --isolate test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.11",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@pierre/diffs": "1.5.2",
    "@smthrs/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.2",
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "20.13.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~5.9.3",
    "vibelang": "file:../../../../.vibelang-toolchain/vibelang-0.0.11-ef39e96004c2.tgz"
  }
}
