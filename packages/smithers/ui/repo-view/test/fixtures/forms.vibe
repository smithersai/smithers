abstract class LookupError extends Error {}
class MissingLookup extends LookupError {}
error NotFound { id: string }
schema Code = "missing" | "found"
module text {
  export function clean(s: string): string { return s.trim() }
}
import { clean } from text
import text
interface User { name: string }
service Users { find(id: string): User!NotFound }
effect function greet(id: string) {
  const user = (try Users).find(id) catch () => ({ name: "none" })
  return user.name
}
