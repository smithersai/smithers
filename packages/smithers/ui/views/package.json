{
  "name": "@smthrs/views",
  "type": "module",
  "version": "1.0.0-rc.16",
  "license": "MIT",
  "smthrs": {
    "group": "agent"
  },
  "description": "Generated views as safe arbitrary output: check a model-written TSX module, render it to HTML in a QuickJS presentation realm, and frame it behind a pinned CSP and a validated MessageChannel bridge",
  "homepage": "https://github.com/smithersai/smithers/tree/main/packages/smithers/ui/views",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/smithers/ui/views"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "keywords": [
    "effect",
    "quickjs",
    "sandbox",
    "generative-ui",
    "csp",
    "iframe"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../../../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@smthrs/crypto": "1.0.0-rc.16",
    "@smthrs/flow": "1.0.0-rc.16",
    "@smthrs/harness": "1.0.0-rc.16",
    "sucrase": "3.35.1",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@eslint/js": "9.39.5",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "fast-check": "4.9.0",
    "madge": "8.0.0",
    "miniflare": "5.20261019.0-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  }
}
