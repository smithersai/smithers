{
  // vibelang --fix-vip-only refused 1 call that may have run before VIP-1 (decided detail 274): EK4802 is an error until each is migrated by hand; remove this setting when --fix-vip-only refuses none.
  "vibe": {"severities": {"EK4802": "error"}},
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "resolveJsonModule": true,
    // test/HomeTargets.test.ts reads @smthrs/targets' sources, which use ES2024's String#isWellFormed.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*"]
}
