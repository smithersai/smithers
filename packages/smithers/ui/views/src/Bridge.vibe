/**
 * The four messages between a generated view's frame and the page that shows
 * it, and the checks the page runs on every message the frame sends.
 *
 * | Method | Direction | What it does |
 * | --- | --- | --- |
 * | `ui/initialize` | frame to page, request | the frame's runtime asks once with the nonce the page wrote into it; the reply carries `{ html, theme, size }` and transfers a `MessagePort` |
 * | `ui/notifications/host-context-changed` | page to frame | new HTML or a new theme |
 * | `ui/notifications/size-changed` | frame to page | the content's height |
 * | `smithers/interaction` | frame to page | `{ event, arg?, values? }` from a real click or submit on a `data-event` element |
 *
 * Every message is JSON-RPC 2.0, and the names follow MCP Apps where the two
 * overlap. Only `ui/initialize` travels by `postMessage` on the window; every
 * later message uses the transferred port.
 *
 * {@link receive} is what the page runs on a message from the port. It
 * decodes the message, bounds it, refuses an event the view did not declare,
 * and admits at most {@link maxInteractionsPerSecond} interactions a second.
 *
 * @since 0.1.0
 */

import * as Option from "effect/Option"
import * as Schema from "effect/Schema"
import * as Interactions from "./Interactions.vibe"
import { jsonLength } from "./internal/bytes.ts"

/**
 * The largest form values one interaction may carry, as UTF-8 JSON.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxValuesBytes = 16 * 1024

/**
 * The largest view state, as UTF-8 JSON.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxStateBytes = 16 * 1024

/**
 * The largest HTML one render may produce, in UTF-8 bytes.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxHtmlBytes = 512 * 1024

/**
 * How many interactions the page admits from one frame in any second.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxInteractionsPerSecond = 10

/**
 * The most form values one interaction may carry.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxValues = 64

/**
 * The shortest and tallest an `inline` view's frame may be, in CSS pixels.
 *
 * @category constants
 * @since 0.1.0
 */
export const inlineHeight = { min: 80, max: 480 } as const

/**
 * The tallest height a frame may report. A larger report is malformed.
 *
 * @category constants
 * @since 0.1.0
 */
export const maxReportedHeight = 1_000_000

/**
 * Where a view shows: `inline` in the message, `full` on its own page.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Size = Schema.Literals(["inline", "full"])

/**
 * Where a view shows.
 *
 * @category models
 * @since 0.1.0
 */
export type Size = typeof Size.Type

/**
 * The page's color theme, as the frame applies it.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Theme = Schema.Literals(["light", "dark"])

/**
 * The page's color theme.
 *
 * @category models
 * @since 0.1.0
 */
export type Theme = typeof Theme.Type

/**
 * The per-mount secret the page writes into the frame's document. Only the
 * frame it wrote can answer with it.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Nonce = Schema.String.check(Schema.isPattern(/^[A-Za-z0-9_-]{22,128}$/))

const Id = Schema.Union([Schema.String.check(Schema.isMaxLength(64)), Schema.Int])

/**
 * `ui/initialize`: the frame's first and only window message.
 *
 * @category schemas
 * @since 0.1.0
 */
export schema Initialize {
  readonly jsonrpc: "2.0"
  readonly id: Id
  readonly method: "ui/initialize"
  readonly params: { readonly nonce: Nonce }
}

/**
 * `ui/initialize`.
 *
 * @category models
 * @since 0.1.0
 */
export type Initialize = typeof Initialize.Type

/**
 * What the frame needs to show the view: the sanitized-on-arrival HTML, the
 * theme, and the size it shows at.
 *
 * @category schemas
 * @since 0.1.0
 */
export schema HostContext {
  readonly html: string
  readonly theme: Theme
  readonly size: Size
}

/**
 * What the frame needs to show the view.
 *
 * @category models
 * @since 0.1.0
 */
export type HostContext = typeof HostContext.Type

/**
 * The page's answer to `ui/initialize`, posted with the port it transfers.
 *
 * @category schemas
 * @since 0.1.0
 */
export schema InitializeResult {
  readonly jsonrpc: "2.0"
  readonly id: Id
  readonly result: HostContext
}

/**
 * The page's answer to `ui/initialize`.
 *
 * @category models
 * @since 0.1.0
 */
export type InitializeResult = typeof InitializeResult.Type

/**
 * `ui/notifications/host-context-changed`: new HTML, a new theme, or both.
 *
 * @category schemas
 * @since 0.1.0
 */
export const HostContextChanged = Schema.Struct({
  jsonrpc: Schema.Literal("2.0"),
  method: Schema.Literal("ui/notifications/host-context-changed"),
  params: Schema.Struct({ html: Schema.optionalKey(Schema.String), theme: Schema.optionalKey(Theme) })
})

/**
 * `ui/notifications/host-context-changed`.
 *
 * @category models
 * @since 0.1.0
 */
export type HostContextChanged = typeof HostContextChanged.Type

/**
 * `ui/notifications/size-changed`: the content's height in CSS pixels.
 *
 * @category schemas
 * @since 0.1.0
 */
export const SizeChanged = Schema.Struct({
  jsonrpc: Schema.Literal("2.0"),
  method: Schema.Literal("ui/notifications/size-changed"),
  params: Schema.Struct({
    height: Schema.Number.check(Schema.isFinite(), Schema.isBetween({ minimum: 0, maximum: maxReportedHeight }))
  })
})

/**
 * `ui/notifications/size-changed`.
 *
 * @category models
 * @since 0.1.0
 */
export type SizeChanged = typeof SizeChanged.Type

/**
 * One form value an interaction carries.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Value = Schema.Union([Schema.String, Schema.Number.check(Schema.isFinite()), Schema.Boolean])

/**
 * The form values an interaction carries, by field name.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Values = Schema.Record(Schema.String, Value).check(
  Schema.isPropertyNames(Schema.String.check(Schema.isMaxLength(128))),
  Schema.isMaxProperties(maxValues)
)

/**
 * The form values an interaction carries.
 *
 * @category models
 * @since 0.1.0
 */
export type Values = typeof Values.Type

/**
 * `smithers/interaction`: a real click or submit on a `data-event` element.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Interaction = Schema.Struct({
  jsonrpc: Schema.Literal("2.0"),
  method: Schema.Literal("smithers/interaction"),
  params: Schema.Struct({
    event: Interactions.Name,
    arg: Schema.optionalKey(Interactions.Arg),
    values: Schema.optionalKey(Values)
  })
})

/**
 * `smithers/interaction`.
 *
 * @category models
 * @since 0.1.0
 */
export type Interaction = typeof Interaction.Type

/**
 * Every message the frame sends over its port.
 *
 * @category schemas
 * @since 0.1.0
 */
export const FrameMessage = Schema.Union([SizeChanged, Interaction])

/**
 * Every message the frame sends over its port.
 *
 * @category models
 * @since 0.1.0
 */
export type FrameMessage = typeof FrameMessage.Type

/**
 * Why the page refused a message:
 *
 * - `wrong_source`: a window message that did not come from this mount's frame
 *   with its nonce;
 * - `malformed`: not one of the bridge's messages;
 * - `too_large`: form values over {@link maxValuesBytes};
 * - `undeclared`: an event the view did not declare;
 * - `rate_limited`: more than {@link maxInteractionsPerSecond} interactions in
 *   one second.
 *
 * @category schemas
 * @since 0.1.0
 */
export const Refusal = Schema.Literals(["wrong_source", "malformed", "too_large", "undeclared", "rate_limited"])

/**
 * Why the page refused a message.
 *
 * @category models
 * @since 0.1.0
 */
export type Refusal = typeof Refusal.Type

/**
 * What the page does with one message from the frame.
 *
 * @category models
 * @since 0.1.0
 */
export type Verdict =
  | { readonly _tag: "Resize"; readonly height: number }
  | { readonly _tag: "State"; readonly event: Interactions.Event }
  | {
    readonly _tag: "Message"
    readonly event: Interactions.Event
    readonly label: string
    readonly values: Values
  }
  | { readonly _tag: "Refused"; readonly reason: Refusal }

/**
 * The times, in milliseconds, of the interactions admitted in the last
 * second. Start with an empty array.
 *
 * @category models
 * @since 0.1.0
 */
export type RateWindow = ReadonlyArray<number>

const decodeFrameMessage = Schema.decodeUnknownOption(FrameMessage)
const decodeInitialize = Schema.decodeUnknownOption(Initialize)

/**
 * Decides what to do with one message from a frame's port.
 *
 * `now` is the page's clock in milliseconds. The returned `window` replaces
 * the one passed in. A refused interaction does not count against the rate.
 *
 * @category receiving
 * @since 0.1.0
 */
export const receive = (input: {
  readonly message: unknown
  readonly declared: Interactions.Declared
  readonly window: RateWindow
  readonly now: number
}): { readonly verdict: Verdict; readonly window: RateWindow } => {
  const refuse = (reason: Refusal): infer _ => ({ verdict: { _tag: "Refused", reason } as const, window: input.window })
  const decoded = decodeFrameMessage(input.message)
  if (Option.isNone(decoded)) return refuse("malformed")
  const message = decoded.value
  if (message.method === "ui/notifications/size-changed") {
    return { verdict: { _tag: "Resize", height: message.params.height }, window: input.window }
  }
  const { arg, event: name, values = {} } = message.params
  const valuesBytes = jsonLength(values)
  /* v8 ignore next -- `Values` admits only strings, finite numbers and booleans in a plain record, so its JSON always exists; the guard keeps the bound total */
  if (valuesBytes === undefined || valuesBytes > maxValuesBytes) return refuse("too_large")
  const declared = Interactions.lookup(input.declared, name)
  if (Option.isNone(declared)) return refuse("undeclared")
  const recent = input.window.filter((at) => input.now - at < 1000 && at <= input.now)
  if (recent.length >= maxInteractionsPerSecond) return { ...refuse("rate_limited"), window: recent }
  const window = [...recent, input.now]
  const event: Interactions.Event = arg === undefined ? { name } : { name, arg }
  return declared.value.kind === "state"
    ? { verdict: { _tag: "State", event }, window }
    : { verdict: { _tag: "Message", event, label: declared.value.label, values }, window }
}

/**
 * Checks the frame's `ui/initialize`: it must decode and carry `nonce`. The
 * caller checks the other half, that the message came from this mount's
 * frame (`event.source === iframe.contentWindow`); an opaque `null` origin is
 * never identity.
 *
 * @category receiving
 * @since 0.1.0
 */
export const acceptInitialize = (message: unknown, nonce: string): Option.Option<Initialize> =>
  Option.filter(decodeInitialize(message), (initialize) => initialize.params.nonce === nonce)

/**
 * The reply to an accepted `ui/initialize`.
 *
 * @category constructors
 * @since 0.1.0
 */
export const initializeResult = (initialize: Initialize, context: HostContext): InitializeResult => ({
  jsonrpc: "2.0",
  id: initialize.id,
  result: context
})

/**
 * A `ui/notifications/host-context-changed` notification.
 *
 * @category constructors
 * @since 0.1.0
 */
export const hostContextChanged = (params: HostContextChanged["params"]): HostContextChanged => ({
  jsonrpc: "2.0",
  method: "ui/notifications/host-context-changed",
  params
})

/**
 * The height an `inline` frame takes for a reported content height: clamped
 * to {@link inlineHeight}.
 *
 * @category sizing
 * @since 0.1.0
 */
export const inlineFrameHeight = (reported: number): number =>
  Math.min(inlineHeight.max, Math.max(inlineHeight.min, Math.ceil(reported)))
