{
  "name": "@smthrs/effect-tanstack-db",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "smthrs": {
    "group": "agent"
  },
  "description": "TanStack DB collections, live queries and mutations as Effect services, streams and typed effects, with every row decoded by an Effect Schema",
  "homepage": "https://github.com/smithersai/smithers/tree/main/packages/effect-tanstack-db",
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/effect-tanstack-db"
  },
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "keywords": [
    "effect",
    "tanstack-db",
    "local-first",
    "collections",
    "live-query"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src examples --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -b tsconfig.json && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@eslint/js": "9.39.5",
    "@journeyapps/wa-sqlite": "1.7.2",
    "@tanstack/browser-db-sqlite-persistence": "0.2.36",
    "@tanstack/db": "0.15.1",
    "@tanstack/db-sqlite-persistence-core": "0.4.11",
    "@tanstack/offline-transactions": "1.1.3",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "effect": "4.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "@tanstack/db": "0.15.1",
    "@tanstack/db-sqlite-persistence-core": "0.4.11",
    "@tanstack/offline-transactions": "1.1.3",
    "effect": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@tanstack/offline-transactions": {
      "optional": true
    }
  }
}
