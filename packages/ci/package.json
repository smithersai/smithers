{
  "name": "smithers-ci",
  "version": "1.0.0-rc.18",
  "license": "MIT",
  "author": "Smithers",
  "description": "Fast CI for agents",
  "sideEffects": [],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "bin": {
    "smithers-ci": "./bin/smithers-ci.mjs"
  },
  "files": [
    "bin/*.mjs",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/package.json",
    "dist/vendor/**",
    "docs/**/*.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "vibelang -p tsconfig.test.json --noEmit && eslint \"src/**/*.ts\" \"examples/**/*.ts\" --no-error-on-unmatched-pattern --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -p tsconfig.json --noEmit && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@smthrs/cli": "1.0.0-rc.18",
    "@smthrs/crypto": "1.0.0-rc.18",
    "@smthrs/engine": "1.0.0-rc.18",
    "@smthrs/evals": "1.0.0-rc.18",
    "@smthrs/flow": "1.0.0-rc.18",
    "@smthrs/model": "1.0.0-rc.18",
    "@smthrs/plan": "1.0.0-rc.18",
    "@smthrs/platform-node": "1.0.0-rc.18",
    "@smthrs/scorers": "1.0.0-rc.18",
    "@smthrs/targets": "1.0.0-rc.18",
    "@types/ws": "8.18.2",
    "jsonc-parser": "3.3.1",
    "redis": "6.2.1",
    "undici": "8.12.4",
    "vibelang-runtime": "0.0.13",
    "ws": "8.22.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "effect": "4.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      }
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@biomejs/biome": "2.6.8",
    "@effect/language-service": "0.87.2",
    "@effect/platform-node": "4.1.1",
    "@effect/platform-node-shared": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@eslint/js": "9.39.5",
    "@smthrs/cli": "1.0.0-rc.18",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "cspell": "10.4.1",
    "dprint": "0.57.1",
    "effect": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-8": "npm:eslint@8.57.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "eslint-plugin-yml": "3.10.0",
    "jest": "30.5.2",
    "knip": "6.34.0",
    "madge": "8.0.0",
    "mocha": "12.0.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vitest": "5.0.0"
  },
  "smthrs": {
    "group": "tooling",
    "npmReadme": "scripts/npm-readme.md",
    "privateEffectAdapters": [
      "@effect/platform-node",
      "@effect/platform-node-shared"
    ]
  },
  "homepage": "https://github.com/smithersai/smithers",
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/ci"
  }
}
