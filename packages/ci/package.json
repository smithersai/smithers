{
  "name": "smithers-ci",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Smithers",
  "description": "Smart CI that only runs what changed",
  "sideEffects": [],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "bin": {
    "smithers-ci": "./bin/smithers-ci.mjs"
  },
  "files": [
    "bin/*.mjs",
    "src/**/*.ts",
    "src/**/*.vibe",
    "docs/**/*.md",
    "README.md"
  ],
  "scripts": {
    "lint": "vibelang -p tsconfig.test.json --noEmit && eslint \"src/**/*.ts\" \"examples/**/*.ts\" --no-error-on-unmatched-pattern --max-warnings=0 && dprint check",
    "format": "dprint fmt",
    "build": "node scripts/build.mjs",
    "check": "vibelang -p tsconfig.json --noEmit && vibelang -p tsconfig.test.json --noEmit",
    "circular": "node ../repo-targets/scripts/circular.mjs",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@smthrs/cli": "1.0.0-rc.18",
    "@smthrs/crypto": "1.0.0-rc.18",
    "@smthrs/engine": "1.0.0-rc.18",
    "@smthrs/evals": "1.0.0-rc.18",
    "@smthrs/flow": "1.0.0-rc.18",
    "@smthrs/model": "1.0.0-rc.18",
    "@smthrs/plan": "1.0.0-rc.18",
    "@smthrs/platform-node": "1.0.0-rc.18",
    "@smthrs/scorers": "1.0.0-rc.18",
    "@smthrs/targets": "1.0.0-rc.18",
    "effect": "4.1.1",
    "jsonc-parser": "3.3.1",
    "vibelang-runtime": "0.0.13",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.1.1",
    "@eslint/js": "9.39.5",
    "@smthrs/cli": "1.0.0-rc.18",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "dprint": "0.57.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-unicorn": "65.0.0",
    "madge": "8.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vitest": "5.0.0"
  },
  "smthrs": {
    "group": "tooling"
  },
  "homepage": "https://github.com/smithersai/smithers",
  "bugs": {
    "url": "https://github.com/smithersai/smithers/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smithersai/smithers.git",
    "directory": "packages/ci"
  }
}
