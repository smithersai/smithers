/**
 * Runs `smithers-ci` inside the test process, on the real Node host, with
 * its console recorded. A faulty service replaces one host service for an
 * unhappy path.
 */

import { Evaluator } from "@smthrs/model"
import { ci } from "../../src/contract/Inventory.ts"
import type { GeneratedFile } from "../../src/contract/Parts.ts"
import { cli, type Parts } from "../../src/cli/Cli.vibe"
import { type Environment, type Host, layer } from "../../src/cli/Host.vibe"
import type * as Scoring from "../../src/select/Scoring.ts"

/**
 * Runs the program and resolves to its exit code. `directory` is where it
 * was started, when that is not the repository's top directory. `model`
 * replaces the model the host reads from `environment`.
 */
export async function inProcess(
  args: ReadonlyArray<string>,
  root: string,
  chosen: Parts<Host>,
  sink: Console.Console,
  environment: Environment,
  faulty?: Layer.Layer<FileSystem.FileSystem, never, FileSystem.FileSystem>,
  directory?: string,
  model?: Layer.Layer<Evaluator.Evaluator>
): Promise<number> {
  const run = cli(args, root, chosen, directory)
  const withFiles = faulty === undefined ? run : Effect.provide(run, faulty)
  const program = (model === undefined ? withFiles : Effect.provide(withFiles, model))
    |> Effect.provide(%, layer(environment))
    |> Effect.provideService(%, Console.Console, sink)
  return await runPromise(program)
}

type Items = typeof Scoring.State.Type["items"]

/** A model that answers every question it is asked with a low chance of failure. */
export const answeringModel = Evaluator.layerScripted((request) =>
  Object.fromEntries((request.state as typeof Scoring.State.Type).items.flatMap(({ item }) => [
    [`fails${item}`, { probability: 0 }],
    [`why${item}`, { choice: "none" }]
  ]))
)

/**
 * The answering model, except that it cannot be reached for a question whose
 * items `lost` picks.
 */
export const modelLostFor = (lost: (items: Items) => boolean) =>
  Layer.effect(Evaluator.Evaluator, effect {
    const answering = try Evaluator.Evaluator
    return Evaluator.Evaluator.of({
      evaluate: (request) =>
        lost((request.state as typeof Scoring.State.Type).items)
          ? fail(new Evaluator.EvaluatorError({ code: "unreachable", message: Evaluator.unreachableMessage }))
          : answering.evaluate(request)
    })
  }) |> Layer.provide(%, answeringModel)

/**
 * The real file system, except that writing a file fails as a full disk does.
 */
export const fullDisk = Layer.effect(FileSystem.FileSystem, effect {
  const fs = try FileSystem.FileSystem
  const full: FileSystem.FileSystem = {
    ...fs,
    writeFileString: (path: string) =>
      Effect.fail(PlatformError.systemError({ _tag: "Unknown", module: "FileSystem", method: "writeFileString", pathOrDescriptor: path, description: "no space left on device" }))
  }
  return full
})

/**
 * The real file system, except that it cannot say what kind of file a path holds.
 */
export const noStat = Layer.effect(FileSystem.FileSystem, effect {
  const fs = try FileSystem.FileSystem
  const blind: FileSystem.FileSystem = {
    ...fs,
    stat: (path: string) =>
      Effect.fail(PlatformError.systemError({ _tag: "PermissionDenied", module: "FileSystem", method: "stat", pathOrDescriptor: path }))
  }
  return blind
})

/**
 * What the parts on `main` generate for the repository at `root`, for the shared cache named.
 */
export async function generated(
  root: string,
  chosen: Parts<Host>,
  environment: Environment,
  cache?: string
): Promise<ReadonlyArray<GeneratedFile>> {
  return await runPromise(
    Effect.provide(
      effect { return try chosen.files(try chosen.decompose(root, ci(try chosen.read(root))), { cache }) },
      layer(environment)
    )
  )
}
