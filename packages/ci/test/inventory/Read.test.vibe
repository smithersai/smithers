import * as NodeServices from "@effect/platform-node/NodeServices"
import { expect, it } from "@effect/vitest"
import * as PlatformError from "effect/PlatformError"
import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner, make as makeSpawner } from "effect/process/ChildProcessSpawner"
import { commitMark, Inventory, parentMark, smithersBuild, uncommittedChanges } from "../../src/contract/Inventory.vibe"
import { read } from "../../src/inventory/index.vibe"

const denied = (method: string) =>
  PlatformError.systemError({ _tag: "PermissionDenied", module: "FileSystem", method })

effect function git(root: string, args: ReadonlyArray<string>) {
  const spawner = try ChildProcessSpawner
  const code = try spawner.exitCode(ChildProcess.make("git", ["-C", root, ...args]))
  try Effect.try(() => expect(Number(code)).toBe(0))
}

/** Writes files into a new directory and commits them, so the directory is a real repository. */
effect function repository(files: Readonly<Record<string, string>>) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = try fs.makeTempDirectoryScoped()
  for (const [name, text] of Object.entries(files)) {
    try fs.makeDirectory(path.dirname(path.join(root, name)), { recursive: true })
    try fs.writeFileString(path.join(root, name), text)
  }
  try git(root, ["init", "--quiet"])
  try git(root, ["add", "--all"])
  try git(root, ["-c", "user.name=t", "-c", "user.email=t@example.test", "commit", "--quiet", "--allow-empty", "-m", "c"])
  return root
}

const workflow = `
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with: { bun-version: 1.3.0 }
      - run: bun run build
  test:
    needs: build
    runs-on: \${{ matrix.os }}
    strategy: { matrix: { os: [ubuntu-latest, macos-latest] } }
    steps:
      - run: bun test
        env: { CODECOV_TOKEN: "\${{ secrets.CODECOV_TOKEN }}", CI: "true" }
`

const allSources = {
  ".github/workflows/ci.yml": workflow,
  ".github/workflows/broken.yaml": "jobs: [unclosed",
  ".github/workflows/notes.txt": "not a workflow",
  "Justfile": "build:\n  zig build\n",
  "package.json": JSON.stringify({
    packageManager: "bun@1.3.0",
    workspaces: ["packages/*", "tools/**", "!packages/skip", "bad/{a,b}"],
    scripts: { test: "vitest run" }
  }),
  "bun.lock": "",
  "turbo.json": `{ "tasks": { "build": {} } }`,
  ".nvmrc": "22\n",
  "packages/a/package.json": `{ "scripts": { "build": "tsc" } }`,
  "packages/a/turbo.json": "{}",
  "packages/skip/package.json": `{ "scripts": { "build": "tsc" } }`,
  "packages/no-manifest/readme.md": "x",
  "packages/node_modules/package.json": `{ "scripts": { "build": "tsc" } }`,
  "tools/deep/er/package.json": `{ "scripts": { "lint": "x" } }`,
  "packages/file.txt": "x"
}

it.layer(NodeServices.layer)("read", (it) => {
  it.effect("treats a child below a regular file as absent and reports a link loop", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = try repository({ ".smithers": "file" })
      try fs.symlink(".nvmrc", path.join(root, ".nvmrc"))
      const inventory = try read(root)
      try Effect.try(() => {
        expect((inventory.unsupported ?? []).some((entry) => entry.feature === smithersBuild)).toBe(false)
        expect((inventory.unsupported ?? []).some((entry) => entry.detail.includes(".smithers/WORKSPACE"))).toBe(false)
        expect((inventory.unsupported ?? []).some((entry) => entry.detail === ".nvmrc: it could not be read (BadResource)")).toBe(true)
      })
    })

  it.effect("reads all four sources of a real repository into a valid inventory", () =>
    effect {
      const root = try repository(allSources)
      try git(root, ["remote", "add", "origin", "https://user:hunter2@github.com/acme/widgets.git"])
      const inventory = try read(root)
      const decoded = try Schema.decodeUnknownEffect(Inventory)(inventory)
      try Effect.try(() => {
        expect(decoded.repository).toBe("acme/widgets")
        expect(decoded.commit).toMatch(/^[0-9a-f]{40}$/)
        expect(decoded.jobs.map((job) => job.id)).toEqual([
          "ci.yml:build",
          "ci.yml:test",
          "justfile:build",
          "package.json:test",
          "packages/a/package.json:build",
          "tools/deep/er/package.json:lint",
          "turbo.json:build"
        ])
        expect(decoded.unsupported?.map((entry) => entry.feature)).toEqual([
          "malformed-file",
          "workspace-pattern",
          "package-turbo"
        ])
        const test = decoded.jobs[1]
        expect(test?.needs).toEqual(["ci.yml:build"])
        expect(test?.matrix).toEqual([{ os: "ubuntu-latest" }, { os: "macos-latest" }])
        expect(test?.steps[0]).toMatchObject({
          command: "bun test",
          env: { CI: "true" },
          secrets: ["CODECOV_TOKEN"],
          secretEnv: { CODECOV_TOKEN: "CODECOV_TOKEN" }
        })
        expect(decoded.jobs[0]?.unsupported[0]?.feature).toBe("host-action")
        expect(decoded.jobs[4]?.steps[0]).toMatchObject({ command: "bun run build", cwd: "packages/a" })
        expect(decoded.jobs[6]?.steps[0]?.command).toBe("bunx turbo run build")
        expect(decoded.toolchains).toContainEqual({ name: "node", source: ".nvmrc", version: "22" })
        expect(decoded.toolchains).toContainEqual({
          name: "bun",
          source: ".github/workflows/ci.yml",
          version: "1.3.0",
          job: "ci.yml:build",
          action: "oven-sh/setup-bun@v2"
        })
        expect(decoded.toolchains).toContainEqual({ name: "just", source: "Justfile" })
        // A runner starts a workflow for an event: the inventory holds each event's file for a replay to write.
        expect(Object.keys(decoded.events ?? {})).toEqual(["pull_request", "push", "merge_group"])
        expect(JSON.parse(decoded.events?.["push"] ?? "")).toMatchObject({
          after: commitMark,
          before: parentMark,
          repository: { full_name: "acme/widgets" }
        })
        expect(JSON.stringify(decoded)).not.toContain("hunter2")
      })
    })

  it.effect("reads the local actions and workflows a workflow names, for the branch the remote calls its default", () =>
    effect {
      const root = try repository({
        ".github/workflows/ci.yml": `
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - if: github.ref == 'refs/heads/trunk' && github.repository == 'acme/widgets'
        run: echo on trunk
      - uses: ./.github/actions/setup
      - uses: ./../outside
  shared:
    uses: ./.github/workflows/called.yml
`,
        ".github/workflows/other.yaml": "on: push\njobs: { again: { runs-on: ubuntu-latest, steps: [{ uses: ./.github/actions/setup }] } }",
        ".github/workflows/called.yml": "on: { workflow_call: }\njobs: { c: { runs-on: ubuntu-latest, steps: [{ run: echo called }] } }",
        ".github/actions/setup/action.yml":
          "runs: { using: composite, steps: [{ uses: ./.github/actions/inner }, { run: echo setup, shell: bash }] }",
        ".github/actions/inner/action.yaml": "runs: { using: composite, steps: [{ run: echo inner, shell: bash }] }"
      })
      try git(root, ["remote", "add", "origin", "https://github.com/acme/widgets.git"])
      try git(root, ["symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/trunk"])
      const inventory = try read(root)
      const commandsOf = (id: string) => inventory.jobs.find((job) => job.id === id)?.steps.map((step) => step.command)
      try Effect.try(() => {
        expect(commandsOf("ci.yml:build")).toEqual(["echo on trunk", "echo inner", "echo setup"])
        expect(commandsOf("other.yaml:again")).toEqual(["echo inner", "echo setup"])
        expect(commandsOf("ci.yml:shared/c")).toEqual(["echo called"])
        expect(inventory.jobs.find((job) => job.id === "ci.yml:build")?.unsupported).toEqual([
          { feature: "uses", detail: ".github/workflows/ci.yml: ./../outside has no command to run" }
        ])
      })
    })

  it.effect("takes the branch checked out as the default when no remote names one, and none when HEAD is detached", () =>
    effect {
      const workflow = `
on: push
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - if: github.ref == 'refs/heads/dev'
        run: echo on dev
      - run: echo \${{ github.repository }}
`
      const root = try repository({ ".github/workflows/ci.yml": workflow })
      try git(root, ["checkout", "--quiet", "-b", "dev"])
      const onBranch = try read(root)
      try git(root, ["checkout", "--quiet", "--detach"])
      const detached = try read(root)
      const notes = (inventory: typeof onBranch) => inventory.jobs[0]?.unsupported.map((entry) => entry.detail)
      const unnamed = ".github/workflows/ci.yml: build step 2 depends on github.repository: the repository's name is not known here"
      try Effect.try(() => {
        expect(onBranch.jobs[0]?.steps.map((step) => step.command)).toEqual(["echo on dev"])
        expect(notes(onBranch)).toEqual([unnamed])
        expect(detached.jobs[0]?.steps).toEqual([])
        expect(notes(detached)).toEqual([
          ".github/workflows/ci.yml: build step 1 runs only if github.ref == 'refs/heads/dev': the default branch is not known here",
          unnamed
        ])
      })
    })

  it.effect("names a repository with no remote after its directory and reads no CI as no jobs", () =>
    effect {
      const path = try Path.Path
      const root = try repository({ "readme.md": "x" })
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.repository).toBe(path.basename(root))
        // No runner starts anything here, so there is no event to write a file for.
        expect(inventory.events).toBeUndefined()
        expect(inventory.jobs).toEqual([])
        expect(inventory.toolchains).toEqual([])
        expect(inventory.unsupported).toBeUndefined()
      })
    })

  it.effect("reads workspaces from pnpm-workspace.yaml and a lowercase hidden justfile", () =>
    effect {
      const root = try repository({
        ".justfile": "a:\n  echo a\n",
        "pnpm-workspace.yaml": "packages:\n  - libs/*\n  - exact/one\n  - missing/one\n  - plugins/p-*\n",
        "pnpm-lock.yaml": "",
        "package.json": "{}",
        "libs/x/package.json": `{ "scripts": { "t": "x" } }`,
        "exact/one/package.json": `{ "scripts": { "t": "x" } }`,
        "plugins/p-a/package.json": `{ "scripts": { "t": "x" } }`,
        "plugins/other/package.json": `{ "scripts": { "t": "x" } }`
      })
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.jobs.map((job) => job.id)).toEqual([
          "justfile:a",
          "exact/one/package.json:t",
          "libs/x/package.json:t",
          "plugins/p-a/package.json:t"
        ])
        expect(inventory.jobs[0]?.file).toBe(".justfile")
        expect(inventory.jobs[1]?.steps[0]?.command).toBe("pnpm run t")
      })
    })

  it.effect("stops following a symbolic link cycle", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = try repository({
        "package.json": `{ "workspaces": ["apps/**"] }`,
        "apps/a/package.json": `{ "scripts": { "t": "x" } }`
      })
      try fs.symlink(path.join(root, "apps"), path.join(root, "apps/a/loop"))
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.jobs[0]?.id).toBe("apps/a/package.json:t")
        expect(inventory.jobs.every((job) => job.id.split("/").length < 40)).toBe(true)
      })
    })

  it.effect("reports links outside the checkout and omits their tool pins, workflows and packages", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = try repository({ "package.json": '{"workspaces":["packages/*"]}' })
      const other = try fs.makeTempDirectoryScoped()
      try fs.writeFileString(path.join(other, "pin"), "22\n")
      try fs.writeFileString(path.join(other, "package.json"), '{"scripts":{"extra":"echo external"}}')
      try fs.makeDirectory(path.join(root, ".github"))
      try fs.makeDirectory(path.join(root, "packages"))
      try fs.symlink(other, path.join(root, ".github/workflows"))
      try fs.symlink(other, path.join(root, "packages/linked"))
      try fs.symlink(path.join(other, "pin"), path.join(root, ".nvmrc"))
      try fs.symlink(path.join(other, "pin"), path.join(root, "WORKSPACE.ts"))
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.jobs).toEqual([])
        expect(inventory.toolchains).toEqual([])
        expect(inventory.unsupported).toContainEqual({ feature: smithersBuild, detail: "WORKSPACE.ts" })
        expect(inventory.unsupported?.filter((entry) => entry.feature === "unreadable-file").map((entry) => entry.detail))
          .toEqual(["WORKSPACE.ts", ".github/workflows", "packages/linked", ".nvmrc"].map((file) => `${file}: its symbolic link leaves the checkout`))
      })
    })

  it.effect("reads quoted local references and reports malformed workspace YAML and duplicate justfiles", () =>
    effect {
      const root = try repository({
        ".github/workflows/ci.yml": 'on: push\njobs:\n  check:\n    runs-on: ubuntu-latest\n    steps:\n      - "uses": "./local tool"\n',
        "local tool/action.yml": "runs: { using: composite, steps: [{ run: echo local, shell: bash }] }",
        "pnpm-workspace.yaml": "packages: [",
        "Justfile": "a:\n  echo one\n", "justfile": "a:\n  echo two\n"
      })
      const result = try read(root)
      try Effect.try(() => {
        expect(result.jobs[0]?.steps[0]?.command).toBe("echo local")
        expect(result.jobs.filter((job) => job.id === "justfile:a")).toHaveLength(0)
        expect(result.unsupported?.[0]?.detail).toContain("Justfile, justfile")
        expect(result.unsupported?.map((entry) => entry.feature)).toEqual(["unreadable-file", "malformed-file"])
      })
    })

  it.effect("finds deep packages through overlapping globstars and keeps package turbo.jsonc", () =>
    effect {
      const directory = ["packages", ...Array<string>(15).fill("deep")].join("/")
      const root = try repository({
        "package.json": '{"workspaces":["packages/**/**","packages/**/deep/**"]}',
        [`${directory}/package.json`]: '{"scripts":{"t":"echo ok"}}',
        [`${directory}/turbo.jsonc`]: "{}"
      })
      const result = try read(root)
      try Effect.try(() => {
        expect(result.jobs.map((job) => job.id)).toEqual([`${directory}/package.json:t`])
        expect(result.unsupported?.[0]?.detail).toContain(`${directory}/turbo.jsonc`)
      })
    })

  it.effect("records a file it cannot read", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = try repository({ "readme.md": "x" })
      try fs.makeDirectory(path.join(root, "package.json"))
      try fs.makeDirectory(path.join(root, ".github/workflows/odd.yml"), { recursive: true })
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.jobs).toEqual([])
        expect(inventory.unsupported?.map((entry) => entry.feature)).toEqual(["unreadable-file", "unreadable-file"])
        expect(inventory.unsupported?.[0]?.detail).toContain(".github/workflows/odd.yml: it could not be read")
        expect(inventory.unsupported?.[1]?.detail).toContain("package.json: it could not be read")
      })
    })

  it.effect("says when the working tree is not the commit it names", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const path = try Path.Path
      const root = try repository({ "readme.md": "x" })
      try fs.writeFileString(path.join(root, "readme.md"), "changed")
      const inventory = try read(root)
      try Effect.try(() => {
        expect(inventory.unsupported).toEqual([{
          feature: uncommittedChanges,
          detail: `the working tree differs from ${inventory.commit}`
        }])
      })
    })

  it.effect("reports filesystem failures alongside the sources it can read", () =>
    effect {
      const root = try repository({
        ".github/workflows/ci.yml": workflow,
        "package.json": '{"workspaces":["packages/*"]}',
        "packages/a/package.json": "{}",
        ".nvmrc": "22",
        ".ruby-version": "3"
      })
      const real = try FileSystem.FileSystem
      const faulty: FileSystem.FileSystem = {
        ...real,
        realPath: (file) => file.endsWith("/.") || file.endsWith(".nvmrc") ? fail(denied("realPath")) : real.realPath(file),
        readDirectory: (file) => file.endsWith("/workflows") ? fail(denied("readDirectory")) : real.readDirectory(file),
        stat: (file) => file.endsWith("/packages/a") ? fail(denied("stat")) : real.stat(file),
        readFileString: (file) => file.endsWith(".ruby-version") ? fail(denied("readFileString")) : real.readFileString(file)
      }
      provide FileSystem.FileSystem = faulty {
        const inventory = try read(`${root}/.`)
        try Effect.try(() => {
          const details = inventory.unsupported?.map((entry) => entry.detail)
          expect(details).toEqual(expect.arrayContaining([
            ".github/workflows: it could not be listed (PermissionDenied)",
            "packages/a: it could not be inspected (PermissionDenied)",
            ".nvmrc: it could not be read (PermissionDenied)",
            ".ruby-version: it could not be read (PermissionDenied)"
          ]))
        })
      }
    })

  it.effect("keeps the distinction between a failed git query and an empty result", () =>
    effect {
      const root = try repository({ Makefile: "test:\n\techo ok\n" })
      const current = try read(root)
      const real = try ChildProcessSpawner
      const faulty = makeSpawner((command) =>
        command._tag === "StandardCommand" && command.args.some((arg) => arg === "ls-files" || arg === "status")
          ? fail(denied("spawn"))
          : real.spawn(command)
      )
      provide ChildProcessSpawner = faulty {
        const inventory = try read(root)
        try Effect.try(() => {
          expect(current.jobs.map((job) => job.name)).toEqual(["test"])
          expect(inventory.jobs).toEqual([])
          expect(inventory.unsupported).toEqual([
            { feature: "unreadable-file", detail: ".: working-tree status could not be read" },
            { feature: "unreadable-file", detail: "Makefile: tracked files could not be read" }
          ])
        })
      }
    })

  it.effect("reports when a workspace pattern runs out of traversal budget", () =>
    effect {
      const root = try repository({ "package.json": '{"workspaces":["*/**"]}', "packages/a": "" })
      const real = try FileSystem.FileSystem
      const path = try Path.Path
      const canonical = try real.realPath(root)
      const directory = try real.stat(canonical)
      const children = Array.from({ length: 5_100 }, (_, index) => `package-${index}`)
      const child = (file: string) => /^package-\d+$/.test(path.basename(file))
      const tree: FileSystem.FileSystem = {
        ...real,
        realPath: (file) => child(file) ? succeed(file) : real.realPath(file),
        stat: (file) => child(file) ? succeed(directory) : real.stat(file),
        readDirectory: (file) => file === canonical ? succeed(children) : child(file) ? succeed([]) : real.readDirectory(file)
      }
      provide FileSystem.FileSystem = tree {
        const inventory = try read(root)
        try Effect.try(() => expect(inventory.unsupported?.some((entry) => entry.feature === "workspace-pattern"
          && entry.detail.includes("exceeded"))).toBe(true))
      }
    })

  it.effect("names the workspace of a repository that already builds with Smithers build", () =>
    effect {
      const root = try repository({
        "WORKSPACE.ts": "export const Workspace = {}\n",
        "package.json": JSON.stringify({ scripts: { test: "vitest run" } })
      })
      const inventory = try read(root)
      try Effect.try(() => expect(inventory.unsupported).toContainEqual({ feature: smithersBuild, detail: "WORKSPACE.ts" }))
    })

  it.effect("fails with not-a-repository outside a repository", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const root = try fs.makeTempDirectoryScoped()
      const failure = try flip(read(root))
      try Effect.try(() => expect(failure).toMatchObject({ code: "not-a-repository", part: "inventory" }))
    })

  it.effect("fails with not-a-repository on a repository with no commit", () =>
    effect {
      const fs = try FileSystem.FileSystem
      const root = try fs.makeTempDirectoryScoped()
      try git(root, ["init", "--quiet"])
      const failure = try flip(read(root))
      try Effect.try(() => expect(failure.code).toBe("not-a-repository"))
    })

  it.effect("fails with not-a-repository when git cannot start", () =>
    effect {
      const root = try repository({ "readme.md": "x" })
      const broken = makeSpawner(() => fail(PlatformError.systemError({
        _tag: "NotFound",
        module: "ChildProcess",
        method: "spawn"
      })))
      provide ChildProcessSpawner = broken {
        const failure = try flip(read(root))
        try Effect.try(() => expect(failure.code).toBe("not-a-repository"))
      }
    })
})
