/** A clock a test moves ahead, to see which parts of a replay a wall time holds. */
import { ChildProcessSpawner, make as makeSpawner } from "effect/process/ChildProcessSpawner"
import { Options } from "../../src/replay/index.vibe"
import { linkTargets, smthrs } from "./fixture.ts"
import { noUpkeep } from "../../src/replay/Git.vibe"

/** One hour in milliseconds: far longer than any step of a test runs. */
export const hour = 3_600_000

/** How long making a job's directories removable takes at the moment `removal`: far longer than a test's run. */
export const removalHold = 30_000

/**
 * Runs `work` on the machine's clock, moved ahead by an hour at each
 * `moment`: each time the replay prepares a copy for the generated targets
 * (`prepare`), or each time it starts `git checkout` (`checkout`). A wall
 * time that holds the moment is an hour longer for each one. At `removal`
 * the clock is not moved: making a job's directories removable before they
 * are removed takes {@link removalHold} of real time, and a wall time that
 * waits for it is at least that long.
 */
export const jumping = <A, E, R>(moment: "prepare" | "checkout" | "removal", work: A!E!R) => effect {
  const live = try Clock.Clock
  const real = try ChildProcessSpawner
  let ahead = 0
  const clock: Clock.Clock = {
    currentTimeMillisUnsafe: () => live.currentTimeMillisUnsafe() + ahead,
    currentTimeMillis: sync(() => live.currentTimeMillisUnsafe() + ahead),
    currentTimeNanosUnsafe: () => live.currentTimeNanosUnsafe(),
    currentTimeNanos: live.currentTimeNanos,
    monotonicTimeNanosUnsafe: () => live.monotonicTimeNanosUnsafe(),
    monotonicTimeNanos: live.monotonicTimeNanos,
    sleep: (duration) => live.sleep(duration)
  }
  const processes = makeSpawner((process) => {
    // On a copy a step has written, git runs in the jail, so `git checkout` is looked for among a command's words.
    const words = process._tag === "StandardCommand" ? [process.command, ...process.args.map(String)] : []
    // git is given `noUpkeep` before its own arguments.
    const checkout = words[words.indexOf("git") + 1 + noUpkeep.length] === "checkout"
    if (moment === "checkout" && checkout) ahead += hour
    if (moment === "removal" && words[0] === "chmod") {
      return effect {
        try live.sleep(Duration.millis(removalHold))
        return try real.spawn(process)
      }
    }
    return real.spawn(process)
  })
  provide Clock.Clock = clock, ChildProcessSpawner = processes, Options = {
    smthrs: [smthrs],
    reruns: 1,
    prepare: (directory) =>
      sync(() => {
        linkTargets(directory)
        if (moment === "prepare") ahead += hour
      })
  } {
    return try work
  }
}
