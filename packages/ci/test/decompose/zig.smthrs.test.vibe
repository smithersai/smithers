import { WebCrypto } from "@smthrs/crypto"
import { NodeHost } from "@smthrs/platform-node"
import { describe, expect, it } from "@effect/vitest"
import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { ci, type Step } from "../../src/contract/Inventory.ts"
import { path as targetMapPath, TargetMap } from "../../src/contract/TargetMap.ts"
import { split } from "../../src/decompose/index.ts"
import * as ZigSteps from "../../src/decompose/Zig.ts"
import { files } from "../../src/generate/index.ts"
import { read } from "../../src/inventory/index.ts"
import { observes } from "../cli/repo.ts"

/**
 * The whole path on a real Zig repository: its Justfile is read, its `zig build test --summary all` is split by the real Zig
 * strategy, the targets are generated and the real `smthrs` runs them. Needs Zig 0.17 and git, and a host that
 * can record what a step reads (Linux with `strace`): on any other host a step that names no inputs runs on every
 * change, so there is nothing to see.
 */

const host = Layer.mergeAll(NodeHost.layer, WebCrypto.layer)

/** A cold Zig compiles its own build runner first, and the build machine is shared. */
const limit = 1_200_000

const fixture = new URL("../fixtures/closure-zig/project", import.meta.url).pathname
const smthrs = new URL("../../../smithers/bin/smithers.mjs", import.meta.url).pathname
const prefix = "//:"

const justfile = "tidy:\n    ./tidy.sh\n\ntest:\n    zig build test --summary all\n\nci: tidy test\n"
/** A workflow whose one job tests the Zig project in `project`. */
const workflow = [
  "name: ci",
  "on: push",
  "jobs:",
  "  test:",
  "    runs-on: ubuntu-latest",
  "    steps:",
  "      - uses: actions/checkout@v4",
  "      - name: Test",
  "        run: zig build test --summary all",
  "        working-directory: project",
  ""
].join("\n")
const tidy = "#!/usr/bin/env bash\nset -euo pipefail\nzig fmt --check build.zig >/dev/null\n"

/** A test that makes a directory where it starts, as `std.testing.tmpDir` does for every Zig test that needs one. */
const writes = `
test "gamma writes where it starts" {
    var tmp = std.testing.tmpDir(.{});
    defer tmp.cleanup();
}
`

interface Ran {
  readonly code: number
  readonly out: string
}

/** Runs a command to its end and keeps what it printed. */
effect function run(cwd: string, command: string, args: ReadonlyArray<string>) {
  const spawner = try ChildProcessSpawner
  return try scoped(effect {
    const handle = try spawner.spawn(ChildProcess.make(command, [...args], { cwd, stdin: "ignore" }))
    const out = try Stream.mkString(Stream.decodeText(handle.all))
    return { code: Number(try handle.exitCode), out } satisfies Ran
  })
}

effect function write(root: string, file: string, text: string, mode?: number) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  try fs.makeDirectory(path.dirname(path.join(root, file)), { recursive: true })
  try fs.writeFileString(path.join(root, file), text)
  if (mode !== undefined) try fs.chmod(path.join(root, file), mode)
}

effect function append(root: string, file: string, text: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  try write(root, file, `${try fs.readFileString(path.join(root, file))}${text}`)
}

/** The text Smithers build replaces, in a step's environment, with the directory it keeps its cache in. */
const cacheToken = "{smthrs:cache-directory}"

/** Where a step finds a directory of the tool cache, with Smithers build's cache directory at `state`. */
const placed = (variable: string, state: string): string =>
  (ZigSteps.environment[variable] as string).replace(cacheToken, state)

/**
 * The fixture project as a repository whose CI is `just ci`: `tidy`, then `test`. `state` is where Smithers build
 * keeps its cache for it: a directory beside the repository, as a runner's temporary directory is.
 */
effect function repository(state: string) {
  const fs = try FileSystem.FileSystem
  const root = try fs.makeTempDirectoryScoped({ prefix: "smithers-ci-zig-split-" })
  try fs.copy(fixture, root)
  try write(root, "Justfile", justfile)
  try write(root, "tidy.sh", tidy, 0o755)
  try append(root, "src/gamma.zig", writes)
  return try committed(root, state)
}

/** The fixture project in `project`, in a repository whose CI is a workflow that tests it there. */
effect function nested(state: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = try fs.makeTempDirectoryScoped({ prefix: "smithers-ci-zig-nested-" })
  try fs.copy(fixture, path.join(root, "project"))
  try write(root, ".github/workflows/ci.yml", workflow)
  return try committed(root, state)
}

/** Gives the repository at `root` a warm tool cache, in `state`, and its first commit. */
effect function committed(root: string, state: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  try write(root, ".gitignore", ".zig-cache\nzig-out\n")
  // This machine's Zig has already compiled its own build runner; a new repository's tool cache starts from that.
  const environment = try run(root, "zig", ["env"])
  const warm = /\.global_cache_dir = "([^"]+)"/.exec(environment.out)?.[1]
  const seeded = placed("ZIG_GLOBAL_CACHE_DIR", state)
  if (warm !== undefined && (try fs.exists(warm))) {
    try fs.makeDirectory(path.dirname(seeded), { recursive: true })
    try fs.copy(warm, seeded)
  }
  for (const args of [["init", "--quiet"], ["add", "--all"], ["-c", "user.name=t", "-c", "user.email=t@example.test", "commit", "--quiet", "-m", "c"]]) {
    expect((try run(root, "git", args)).code).toBe(0)
  }
  return root
}

/**
 * Reads the repository's CI, splits it and writes the generated files. Returns the split steps and the most
 * targets that may run at once.
 */
effect function generate(root: string) {
  const inventory = try read(root)
  const after = try split(root, ci(inventory))
  const generated = try files(after)
  for (const file of generated) try write(root, file.path, file.content)
  const map = try Schema.decodeUnknownEffect(Schema.fromJsonString(TargetMap))(
    generated.find((file) => file.path === targetMapPath)?.content
  )
  return { steps: after.jobs.flatMap((job) => job.steps), maxJobs: map.maxJobs }
}

const Record = Schema.fromJsonString(Schema.Struct({
  results: Schema.Array(Schema.Struct({ label: Schema.String, status: Schema.String }))
}))

/**
 * Runs every target, as many at once as Smithers build chooses, with the programs in `first` before the others on
 * `PATH`, and gives each one's status.
 */
effect function statuses(root: string, state: string, name: string, first: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const results = path.join(state, `${name}.json`)
  const ran = try run(root, "sh", [
    "-c",
    `PATH="$1:$PATH" exec node "$0" ci //... --cache-dir "$3" --results-file "$2" --ui plain`,
    smthrs,
    first,
    results,
    state
  ])
  const record = try Schema.decodeUnknownEffect(Record)(try fs.readFileString(results))
  return {
    out: ran.out,
    statuses: Object.fromEntries(record.results.map((result) => [result.label.slice(prefix.length), result.status]))
  }
}

const alpha = "justfile-test-1-test-alpha"
const beta = "justfile-test-1-test-beta"
const gamma = "justfile-test-1-test-gamma"
const tidied = "justfile-tidy-1"
const job = "ci.yml-test-1"

describe.skipIf(!observes)("zig build test on a real repository", () => {
  it.live("becomes one step per test root, and a change reruns only the roots that read it", effect () => {
    provide host {
      try scoped(effect {
        const fs = try FileSystem.FileSystem
        const path = try Path.Path
        const state = try fs.makeTempDirectoryScoped({ prefix: "smithers-ci-zig-state-" })
        const root = try repository(state)
        const { steps, maxJobs } = try generate(root)
        const brief = (step: Step) => [step.id, step.command, step.inputs, step.from, step.atOnce, step.env]
        const from = "justfile:test:1"
        expect(steps.map(brief)).toEqual([
          ["justfile:tidy:1", "./tidy.sh", undefined, undefined, undefined, {}],
          // The flag only changes what Zig prints, so each root's build is given it.
          [`${from}:test-alpha`, "zig build test-alpha --summary all", undefined, from, true, ZigSteps.environment],
          [`${from}:test-beta`, "zig build test-beta --summary all", undefined, from, true, ZigSteps.environment],
          [`${from}:test-gamma`, "zig build test-gamma --summary all", undefined, from, true, ZigSteps.environment]
        ])
        // One build ran the three roots at the same time, so nothing holds the targets to one at a time.
        expect(maxJobs).toBeUndefined()

        // The Zig every step starts: a program of two lines that starts this machine's Zig.
        const tools = path.join(try fs.makeTempDirectoryScoped({ prefix: "smithers-ci-zig-" }), "bin")
        const real = (try run(root, "sh", ["-c", "command -v zig"])).out.trim()
        try write(tools, "zig", `#!/bin/sh\nexec ${real} "$@"\n`, 0o755)

        // Each step runs in the open and its run is recorded: `tidy`, which the test roots follow, and each root.
        const first = try statuses(root, state, "first", tools)
        expect([first.statuses, first.out]).toEqual([{ [tidied]: "ran", [alpha]: "ran", [beta]: "ran", [gamma]: "ran" }, first.out])
        // Nothing changed, so no step runs again.
        expect((try statuses(root, state, "second", tools)).statuses).toEqual({ [tidied]: "hit", [alpha]: "hit", [beta]: "hit", [gamma]: "hit" })
        // Zig kept its caches in the tool cache, which is in Smithers build's cache directory and not in the
        // checkout. A test made its directory where it started, as Zig's tests do.
        expect(ZigSteps.environment["ZIG_LOCAL_CACHE_DIR"]).toBe(`${cacheToken}/tools/zig/local`)
        expect(try fs.exists(path.join(placed("ZIG_LOCAL_CACHE_DIR", state), "o"))).toBe(true)
        expect(try fs.exists(path.join(root, ".flows"))).toBe(false)
        expect(try fs.exists(path.join(root, ".zig-cache", "tmp"))).toBe(true)

        // A file one root reads reruns that root.
        try append(root, "src/gamma.zig", "\n// edited\n")
        expect((try statuses(root, state, "gamma", tools)).statuses).toEqual({ [tidied]: "hit", [alpha]: "hit", [beta]: "hit", [gamma]: "ran" })
        // A file two roots import reruns those two.
        try append(root, "src/shared.zig", "\n// edited\n")
        expect((try statuses(root, state, "shared", tools)).statuses).toEqual({ [tidied]: "hit", [alpha]: "ran", [beta]: "ran", [gamma]: "hit" })
        // A file no root reads reruns none.
        try write(root, "NOTES.md", "changed\n")
        expect((try statuses(root, state, "notes", tools)).statuses).toEqual({ [tidied]: "hit", [alpha]: "hit", [beta]: "hit", [gamma]: "hit" })

        // The Zig a step started is among the files it read: another Zig at the same place reruns all four.
        try write(tools, "zig", `#!/bin/sh\n# another release\nexec ${real} "$@"\n`, 0o755)
        expect((try statuses(root, state, "zig", tools)).statuses).toEqual({ [tidied]: "ran", [alpha]: "ran", [beta]: "ran", [gamma]: "ran" })
        expect((try statuses(root, state, "again", tools)).statuses).toEqual({ [tidied]: "hit", [alpha]: "hit", [beta]: "hit", [gamma]: "hit" })
      })
    }
  }, limit)

  it.live("keeps a build with a flag, in a directory under the root, from running again on a fresh checkout", effect () => {
    provide host {
      try scoped(effect {
        const fs = try FileSystem.FileSystem
        const path = try Path.Path
        const state = try fs.makeTempDirectoryScoped({ prefix: "smithers-ci-zig-state-" })
        const root = try nested(state)
        const { steps } = try generate(root)
        // The flag keeps the step whole. It is still told where Zig keeps its caches: the directories a step at the
        // root is given, each named whole.
        expect(steps.map((step) => [step.command, step.cwd, step.env])).toEqual([
          ["zig build test --summary all", "project", ZigSteps.environment]
        ])
        const tools = path.dirname((try run(root, "sh", ["-c", "command -v zig"])).out.trim())
        const first = try statuses(root, state, "first", tools)
        expect([first.statuses, first.out]).toEqual([{ [job]: "ran" }, first.out])
        // The caches are the repository's one tool cache, outside the checkout: none is beside the project.
        expect(try fs.exists(path.join(placed("ZIG_LOCAL_CACHE_DIR", state), "o"))).toBe(true)
        expect(try fs.exists(path.join(root, "project", ".flows"))).toBe(false)
        expect(try fs.exists(path.join(root, ".flows"))).toBe(false)

        // A fresh checkout holds the tracked files and the cache a CI run restores, and nothing Zig left beside
        // `build.zig`. With Zig's cache there, the step would have read files that are now gone, and run again.
        try fs.remove(path.join(root, "project", ".zig-cache"), { recursive: true, force: true })
        const fresh = try statuses(root, state, "fresh", tools)
        expect([fresh.statuses, fresh.out]).toEqual([{ [job]: "hit" }, fresh.out])

        // It still runs again when a file it compiled changes.
        try append(root, "project/src/beta.zig", "\n// edited\n")
        expect((try statuses(root, state, "edited", tools)).statuses).toEqual({ [job]: "ran" })
      })
    }
  }, limit)
})
