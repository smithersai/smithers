// The eval as a Smithers eval: Suite, CaseExecutor, Runner and scorers from @smthrs/evals and @smthrs/scorers, with
// the real `score` on the in-memory flow engine. The judge is scripted here; evals/fast-mode.eval.vibe uses a live one.
import { describe, expect, it } from "@effect/vitest"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Evaluator } from "@smthrs/model"
import { failure } from "../../src/select/Failure.ts"
import { day } from "../../src/select/Features.ts"
import * as Eval from "../../src/select/Eval.vibe"
import * as Measure from "../../src/select/Measure.ts"
import { type Host, score } from "../../src/select/Score.vibe"
import type * as Scoring from "../../src/select/Scoring.ts"
import { seen } from "./support.vibe"

const now = Date.UTC(2026, 10, 14)
const options = { name: "example", runId: "run-1", at: "2026-11-14T00:00:00.000Z" }

const rate = (d7: number) => ({ failureRates: { d7, d14: d7, d28: d7, d56: d7 } })

// A history before the test week, then three changes inside it. c2 fails the target that failed before; c3 fails
// one that never did; c4 fails nothing.
const observations = [
  seen(now - 20 * day, "c1", "//a:test", true),
  seen(now - 3 * day, "c2", "//a:test", true, rate(1)),
  seen(now - 3 * day, "c2", "//b:test", false, rate(0)),
  seen(now - 2 * day, "c3", "//a:test", false, rate(1)),
  seen(now - 2 * day, "c3", "//b:test", true, rate(0)),
  seen(now, "c4", "//a:test", false, rate(0.5)),
  seen(now, "c4", "//b:test", false, { ...rate(0), testCount: 9 })
]

/** A judge that answers a target's recent failure rate as its chance of failure. */
const judge = Evaluator.layerScripted((request) => {
  const state = request.state as typeof Scoring.State.Type
  return Object.fromEntries(state.items.flatMap(({ item, targetFailureRate }) => [
    [`fails${item}`, { probability: targetFailureRate.last7Days }],
    [`why${item}`, { choice: targetFailureRate.last7Days > 0 ? "history" : "none" }]
  ]))
})

const host = Layer.mergeAll(FlowEngine.layerMemory, WebCrypto.layer, judge)

describe("Eval.run", () => {
  it.live("scores each change of the newest week, grades it, and measures the whole test set", () => effect {
    provide host {
      const services = try context<Host>()
      const outcome = try Eval.run(options, observations, (rows) => Effect.provideContext(score(rows), services))
      try Effect.try(() => {
        expect(outcome.split.history.map((observation) => observation.row.commit)).toEqual(["c1"])
        expect(outcome.run.cases.map((each) => each.case)).toEqual(["c2", "c3", "c4"])
        expect(outcome.unfinished).toEqual([])
        // Per change, at the starting settings: a score cutoff of 0.05 and the top 5 select both targets.
        expect(outcome.run.observations.map((each) => [each.case, each.scorerName, each.kind === "score" ? each.score : each.kind, each.kind === "score" ? each.reason : ""])).toEqual([
          ["c2", "caught", 1, "1 of 1 failures selected"],
          ["c2", "skipped", 0, "0 of 2 targets skipped"],
          ["c3", "caught", 1, "1 of 1 failures selected"],
          ["c3", "skipped", 0, "0 of 2 targets skipped"],
          ["c4", "caught", 1, "no failure to catch"],
          ["c4", "skipped", 0, "0 of 2 targets skipped"]
        ])
        const report = outcome.report!
        expect(report).toMatchObject({ rows: 6, changes: 3, failures: 2, failedChanges: 2, recall: "measured" })
        // With no top-N, a cutoff of 0.5 selects only the targets with a history: it catches c2's failure and misses c3's.
        const half = report.byScore.find((point) => point.settings.scoreCutoff === 0.5)!
        expect(half.metrics).toMatchObject({ selected: 3, testRecall: 0.5, changeRecall: 0.5, selectionRate: 0.5 })
        expect(Measure.render("example", report)).toContain("test recall 0.500 (1 of 2), change recall 0.500 (1 of 2), selection rate 0.500 (3 of 6)")
      })
    }
  })

  it.live("caps the test set at evenly spaced changes when asked", () => effect {
    const constant = (rows: ReadonlyArray<{ readonly commit: string; readonly target: string }>) => succeed(rows.map((row) => ({ commit: row.commit, target: row.target, score: 0.5 })))
    const outcome = try Eval.run({ ...options, changes: 2, concurrency: 2 }, observations, constant)
    try Effect.try(() => {
      expect(outcome.run.cases.map((each) => each.case)).toEqual(["c2", "c3"])
      expect(outcome.split.test).toHaveLength(4)
      expect(outcome.report).toMatchObject({ rows: 4, changes: 2, failures: 2 })
    })
  })

  it.effect("scores one change at a time unless told otherwise", () => effect {
    const one = try Eval.suite("example", observations)
    const three = try Eval.suite("example", observations, 3)
    try Effect.try(() => {
      expect([one.concurrency, three.concurrency]).toEqual([1, 3])
      expect(one.cases.map((each) => each.name)).toEqual(["c1", "c2", "c3", "c4"])
    })
  })

  it.live("reports nothing when a change could not be scored: part of a test set has no recall", () => effect {
    const unavailable = failure("model-unavailable", "The judge did not score the rows: No judge is configured")
    const outcome = try Eval.run(options, observations, (rows) => rows[0]!.commit === "c3" ? fail(unavailable) : succeed(rows.map((row) => ({ commit: row.commit, target: row.target, score: 0.5 }))))
    try Effect.try(() => {
      expect(outcome.unfinished).toEqual(["c3"])
      expect(outcome.report).toBeUndefined()
      expect(outcome.run.cases.find((each) => each.case === "c3")!.error!.message).toBe("Target failed for case 'c3': model-unavailable: The judge did not score the rows: No judge is configured")
    })
  })

  it.live("refuses a recall for a test week with no failure", () => effect {
    const green = observations.filter((observation) => observation.row.commit === "c4")
    const outcome = try Eval.run(options, green, (rows) => succeed(rows.map((row) => ({ commit: row.commit, target: row.target, score: 0.01 }))))
    try Effect.try(() => {
      expect(outcome.report!.recall).toBe("refused: no entry failed, so there is no failure to recall")
      expect(outcome.report!.start.metrics).toEqual({ rows: 2, selected: 2, failures: 0, failedChanges: 0, selectionRate: 1 })
    })
  })
})

describe("Eval.executor", () => {
  it.effect("fails a case whose input is not rows", () => effect {
    const failed = try flip(Eval.executor(() => succeed([])).run({ name: "bad", input: { rows: "none" } }))
    try Effect.try(() => {
      expect(failed.code).toBe("executor")
      expect(failed.message).toBe("Case bad holds no entries")
    })
  })
})

describe("Eval.caught and Eval.skipped", () => {
  const rows = observations.filter((observation) => observation.row.commit === "c3").map((observation) => observation.row)

  it.effect("grade a change by what the starting settings select", () => effect {
    // Only a:test scores above the cutoff, and the top 5 still take b:test, the failure.
    const output = [{ commit: "c3", target: "//a:test", score: 0.9 }, { commit: "c3", target: "//b:test", score: 0 }]
    const caught = try Eval.caught.score({ input: { rows }, output })
    const skipped = try Eval.skipped.score({ input: { rows }, output })
    try Effect.try(() => {
      expect(caught).toEqual({ score: 1, reason: "1 of 1 failures selected" })
      expect(skipped).toEqual({ score: 0, reason: "0 of 2 targets skipped" })
    })
  })

  it.effect("fail when the case's rows or its scores cannot be read", () => effect {
    const noRows = try flip(Eval.caught.score({ input: {}, output: [] }))
    const noScores = try flip(Eval.skipped.score({ input: { rows }, output: [{ commit: "c3" }] }))
    try Effect.try(() => {
      expect(noRows.message).toContain("The entries of a fast-mode case could not be read")
      expect(noScores.message).toContain("The scores of a fast-mode case could not be read")
    })
  })
})
