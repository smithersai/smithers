// `score` on the real in-memory flow engine. The judge is @smthrs/model's own scripted Evaluator;
// the live judge is the eval's (evals/fast-mode.eval.vibe).
import { describe, expect, it } from "@effect/vitest"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Evaluator } from "@smthrs/model"
import * as Selection from "../../src/contract/Selection.vibe"
import { asked as answered, layer, layerAsked, layerKept, score, ScoreFlow } from "../../src/select/Score.vibe"
import { unavailable } from "../../src/select/Failure.vibe"
import * as Scoring from "../../src/select/Scoring.vibe"
import { row } from "./support.vibe"

/** Every request the scripted judge answered. */
interface Asked { requests: number; questions: number }

/** A judge that answers each item's recent failure rate as its chance of failure. */
const judge = (asked: Asked) => Evaluator.layerScripted((request) => {
  const state = request.state as typeof Scoring.State.Type
  asked.requests += 1
  asked.questions += Object.keys(request.questions).length
  return Object.fromEntries(state.items.flatMap(({ item, targetFailureRate }) => [
    [`fails${item}`, { probability: targetFailureRate.last7Days }],
    [`why${item}`, { choice: targetFailureRate.last7Days > 0 ? "history" : "none" }]
  ]))
})

const host = (evaluator: Layer.Layer<Evaluator.Evaluator>) => Layer.mergeAll(FlowEngine.layerMemory, WebCrypto.layer, evaluator)

const rate = (d7: number) => ({ failureRates: { d7, d14: 0, d28: 0, d56: 0 } })

describe("score", () => {
  it.live("scores every row from 0 to 1 with a reason, asking once per distinct feature set", () => effect {
    const asked: Asked = { requests: 0, questions: 0 }
    const rows = [
      row("c1", "//a:test", false, rate(0.8)),
      row("c1", "//a:lint", false, rate(0)),
      row("c1", "//a:check", false, rate(0)),
      row("c2", "//a:test", false, rate(0.8))
    ]
    provide host(judge(asked)) {
      const scores = try score(rows)
      try Effect.try(() => {
        expect(scores).toEqual([
          { commit: "c1", target: "//a:test", score: 0.8 },
          { commit: "c1", target: "//a:lint", score: 0, reason: Scoring.skipReasons.none },
          { commit: "c1", target: "//a:check", score: 0, reason: Scoring.skipReasons.none },
          { commit: "c2", target: "//a:test", score: 0.8 }
        ])
        expect(asked).toEqual({ requests: 1, questions: 4 })
        expect(Selection.select(scores.filter((each) => each.commit === "c1"), { scoreCutoff: 0.5, countCutoff: 0 })).toEqual(["//a:test"])
      })
    }
  })

  it.live("asks in batches, and never asks again for a batch it already scored", () => effect {
    const asked: Asked = { requests: 0, questions: 0 }
    const rows = Array.from({ length: Scoring.batchSize * 2 + 1 }, (_, index) => row("c1", `//t${index}:test`, false, { testCount: index }))
    provide host(judge(asked)) {
      const first = try score(rows)
      const requests = asked.requests
      const again = try score(rows)
      try Effect.try(() => {
        expect(first).toHaveLength(rows.length)
        expect(requests).toBe(3)
        expect(again).toEqual(first)
        expect(asked.requests).toBe(3)
      })
    }
  })

  it.live("asks again when the questions changed: an old answer never replays for a new question", () => effect {
    const asked: Asked = { requests: 0, questions: 0 }
    const items = [row("c1", "//a:test").features]
    provide Layer.provideMerge(layer, host(judge(asked))) {
      try ScoreFlow.execute({ items, questions: "digest-1" }, { executionId: "old" })
      try ScoreFlow.execute({ items, questions: "digest-1" }, { executionId: "old" })
      const replayed = asked.requests
      try ScoreFlow.execute({ items, questions: "digest-2" }, { executionId: "new" })
      try Effect.try(() => {
        expect(replayed).toBe(1)
        expect(asked.requests).toBe(2)
      })
    }
  })

  it.live("scores several changes at once on one host", () => effect {
    // A judge slow enough that the four calls overlap: each waits until all four have asked.
    const arrived = try Deferred.make<void>()
    let asking = 0
    const slow = Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
      evaluate: (request) => effect {
        asking += 1
        if (asking === 4) try Deferred.succeed(arrived, undefined)
        try Deferred.await(arrived)
        return {
          answers: Object.fromEntries(Object.keys(request.questions).map((id) => [
            id,
            id.startsWith("fails") ? { type: "boolean" as const, probability: 0.25 } : { type: "choice" as const, choice: "none" }
          ])),
          latencyMs: 0
        }
      }
    }))
    provide host(slow) {
      const scored = try Effect.forEach(
        [1, 2, 3, 4],
        (change) => score([row(`c${change}`, "//a:test", false, { testCount: change })]),
        { concurrency: "unbounded" }
      )
      try Effect.try(() => {
        expect(scored.map((scores) => scores.map((each) => [each.commit, each.score]))).toEqual([
          [["c1", 0.25]],
          [["c2", 0.25]],
          [["c3", 0.25]],
          [["c4", 0.25]]
        ])
      })
    }
  })

  it.live("lets one call return while another call on the same host still asks", () => effect {
    // The first call asks in two waves: as many requests as run at once, then one more. The judge holds each
    // request until the test lets it go: requests 1 to 4 are the first wave, 5 is the other call's, 6 the last.
    const asked = { first: try Deferred.make<void>(), other: try Deferred.make<void>(), last: try Deferred.make<void>() }
    const release = { first: try Deferred.make<void>(), other: try Deferred.make<void>(), last: try Deferred.make<void>() }
    let arrived = 0
    const held = Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
      evaluate: (request) => effect {
        arrived += 1
        const mine = arrived
        if (mine === Scoring.concurrency) try Deferred.succeed(asked.first, undefined)
        if (mine === Scoring.concurrency + 1) try Deferred.succeed(asked.other, undefined)
        if (mine === Scoring.concurrency + 2) try Deferred.succeed(asked.last, undefined)
        try Deferred.await(
          mine <= Scoring.concurrency ? release.first : mine === Scoring.concurrency + 1 ? release.other : release.last
        )
        return {
          answers: Object.fromEntries(Object.keys(request.questions).map((id) => [
            id,
            id.startsWith("fails") ? { type: "boolean" as const, probability: 0.25 } : { type: "choice" as const, choice: "none" }
          ])),
          latencyMs: 0
        }
      }
    }))
    const many = Array.from(
      { length: Scoring.batchSize * Scoring.concurrency + 1 },
      (_, index) => row("c1", `//t${index}:test`, false, { testCount: index })
    )
    provide host(held) {
      const first = fork score(many)
      try Deferred.await(asked.first)
      const other = fork score([row("c2", "//other:test", false, { testCount: 100_000 })])
      try Deferred.await(asked.other)
      // The first call's last request starts while the other call runs, and the other call returns before it ends.
      try Deferred.succeed(release.first, undefined)
      try Deferred.await(asked.last)
      try Deferred.succeed(release.other, undefined)
      const others = try join other
      try Deferred.succeed(release.last, undefined)
      const ended = try Fiber.await(first)
      try Effect.try(() => {
        expect(others.map((each) => each.score)).toEqual([0.25])
        // The engine once ran this call's last request in the other call's registration, which closed with it.
        expect(Exit.isSuccess(ended)).toBe(true)
      })
    }
  })

  it.live("counts the questions the judge answered, and none for a batch whose answer it already holds", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    const rows = [
      row("c1", "//a:test", false, rate(0.8)),
      row("c1", "//a:lint", false, rate(0)),
      row("c1", "//a:check", false, rate(0))
    ]
    provide host(judge(seen)), layerAsked {
      const before = try answered()
      try score(rows)
      const once = try answered()
      try score(rows)
      const twice = try answered()
      try score([row("c2", "//b:test", false, { testCount: 44 })])
      const thrice = try answered()
      try Effect.try(() => {
        // Two feature sets, then the same batch again, then one new feature set.
        expect([before, once, twice, thrice]).toEqual([0, 2, 2, 3])
        expect(seen.requests).toBe(2)
      })
    }
  })

  it.live("counts nothing for a question the judge could not answer", () => effect {
    const unreachable = Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
      evaluate: () => fail(new Evaluator.EvaluatorError({ code: "unreachable", message: Evaluator.unreachableMessage }))
    }))
    provide host(unreachable), layerAsked {
      try flip(score([row("c1", "//a:test")]))
      const count = try answered()
      try Effect.try(() => {
        expect(count).toBe(0)
      })
    }
  })

  it.live("keeps one count for every program of a process whose host provides none", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    provide host(judge(seen)) {
      const before = try answered()
      try score([row("c1", "//shared:test", false, { testCount: 31_337 })])
      const after = try answered()
      try Effect.try(() => {
        expect(after - before).toBe(1)
      })
    }
  })

  it.live("asks once for a feature set, also when it comes back beside another one", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    const a = row("c1", "//a:test", false, rate(0.8))
    const b = row("c1", "//b:test", false, rate(0.2))
    const c = row("c2", "//c:test", false, rate(0.4))
    provide host(judge(seen)), layerAsked, layerKept {
      const first = try score([a, b])
      // The second change has one feature set the first had and one new one: only the new one is a question.
      const second = try score([{ ...a, commit: "c2" }, c])
      const count = try answered()
      try Effect.try(() => {
        expect(first.map((each) => each.score)).toEqual([0.8, 0.2])
        expect(second).toEqual([
          { commit: "c2", target: "//a:test", score: 0.8 },
          { commit: "c2", target: "//c:test", score: 0.4 }
        ])
        expect(count).toBe(3)
        // Two questions for each feature set the judge was sent: 2 feature sets, then 1.
        expect(seen).toEqual({ requests: 2, questions: 6 })
      })
    }
  })

  it.live("shares an overlapping feature across concurrent batches", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    const a = row("c1","//a:test",false,rate(0.8))
    const b = row("c1","//b:test",false,rate(0.2))
    const c = row("c2","//c:test",false,rate(0.4))
    provide host(judge(seen)), layerKept {
      const [left,right] = try.all [score([a,b]),score([{...b,commit:"c2"},c])]
      expect(left[1]!.score).toBe(right[0]!.score)
      expect(seen.questions).toBe(6)
    }
  })
  it.live("asks nothing when every feature set of a change was answered before", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    const a = row("c1", "//a:test", false, rate(0.8))
    provide host(judge(seen)), layerKept {
      try score([a])
      // Two entries of the next change share that feature set: neither is a question.
      const again = try score([
        { ...a, commit: "c2", target: "//other:test" },
        { ...a, commit: "c2", target: "//third:test" }
      ])
      try Effect.try(() => {
        expect(again).toEqual([
          { commit: "c2", target: "//other:test", score: 0.8 },
          { commit: "c2", target: "//third:test", score: 0.8 }
        ])
        expect(seen.requests).toBe(1)
      })
    }
  })

  it.live("keeps no answer on a host that provides no place for them", () => effect {
    const seen: Asked = { requests: 0, questions: 0 }
    const a = row("c1", "//a:test", false, rate(0.8))
    const b = row("c1", "//b:test", false, rate(0.2))
    provide host(judge(seen)) {
      try score([a])
      try score([a, b])
      try Effect.try(() => {
        expect(seen.requests).toBe(2)
      })
    }
  })

  it.live("scores no rows without asking", () => effect {
    const asked: Asked = { requests: 0, questions: 0 }
    provide host(judge(asked)) {
      const scores = try score([])
      try Effect.try(() => {
        expect(scores).toEqual([])
        expect(asked.requests).toBe(0)
      })
    }
  })

  it.live("fails model-unavailable when the judge cannot answer, and scores nothing by guess", () => effect {
    // A faulty judge: it is configured with no key.
    const unconfigured = Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
      evaluate: () => fail(new Evaluator.EvaluatorError({ code: "unconfigured", message: "No judge is configured" }))
    }))
    provide host(unconfigured) {
      const failed = try flip(score([row("c1", "//a:test")]))
      try Effect.try(() => {
        expect(failed).toEqual({ code: "model-unavailable", message: unavailable({ _tag: "flows/model/ClassifierError", code: "unconfigured" } as never), part: "select" })
      })
    }
  })

  it.live("asks again when the judge answers something that is not a score", () => effect {
    let requests = 0
    const flaky = Evaluator.layerScripted(() => {
      requests += 1
      return { fails0: { probability: 0.5 }, why0: { choice: requests === 1 ? "weather" : "churn" } }
    })
    provide host(flaky) {
      const scores = try score([row("c1", "//a:test")])
      try Effect.try(() => {
        expect(scores).toEqual([{ commit: "c1", target: "//a:test", score: 0.5, reason: Scoring.skipReasons.churn }])
        expect(requests).toBe(2)
      })
    }
  })

  it.live("fails model-unavailable when every attempt is answered with something that is not a score", () => effect {
    let requests = 0
    const malformed = Evaluator.layerScripted(() => {
      requests += 1
      return { fails0: { probability: 0.5 }, why0: { choice: "weather" } }
    })
    provide host(malformed) {
      const failed = try flip(score([row("c1", "//a:test")]))
      try Effect.try(() => {
        expect(failed.code).toBe("model-unavailable")
        expect(failed.message).toBe(unavailable({ _tag: "flows/model/ClassifierError", code: "invalid_answer" } as never))
        expect(requests).toBe(Scoring.attempts)
      })
    }
  })

  it.live("lets every batch settle when one fails: the failure is typed, and no batch is cut off", () => effect {
    // The batch holding test count 0 is refused; the other batch answers only after that refusal.
    const refused = try Deferred.make<void>()
    let answered = 0
    const partial = Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
      evaluate: (request) => effect {
        const state = request.state as typeof Scoring.State.Type
        if (state.items.some((item) => item.testsInTarget === 0)) {
          try Deferred.succeed(refused, undefined)
          throw new Evaluator.EvaluatorError({ code: "unconfigured", message: "No judge is configured" })
        }
        try Deferred.await(refused)
        try yieldNow
        answered += 1
        return {
          answers: Object.fromEntries(Object.keys(request.questions).map((id) => [
            id,
            id.startsWith("fails") ? { type: "boolean" as const, probability: 0.25 } : { type: "choice" as const, choice: "none" }
          ])),
          latencyMs: 0
        }
      }
    }))
    const rows = Array.from({ length: Scoring.batchSize + 1 }, (_, index) => row("c1", `//t${index}:test`, false, { testCount: index }))
    provide host(partial) {
      const exit = try Effect.exit(score(rows))
      try Effect.try(() => {
        expect(Exit.isFailure(exit) && Cause.hasInterrupts(exit.cause)).toBe(false)
        expect(Exit.isFailure(exit) && Cause.hasFails(exit.cause)).toBe(true)
        expect(answered).toBe(1)
      })
    }
  })
})
