/**
 * The Zig strategy for contract 9: every file a build step or an entry file
 * reaches, as the Zig toolchain itself reports it.
 *
 * Nothing here parses Zig source. The step graph comes from
 * `zig build --print-configuration`, the files a compile step read come from
 * the cache manifest the compiler wrote for it, and the files a bare entry
 * file reads come from the compiler's own report over `--listen=-`.
 * `docs/strategies/zig.md` has the design and its sources.
 *
 * @since 0.1.0
 */

import { digest as sha256 } from "@smthrs/crypto"
import type * as EffectDigest from "effect/crypto/Digest"
import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Closure } from "../../contract/Closure.vibe"
import type { Failure } from "../../contract/Parts.vibe"
import * as Draft from "./Draft.ts"
import * as Graph from "./Graph.ts"
import * as Manifest from "./Manifest.ts"
import * as Protocol from "./Protocol.ts"
import * as Zon from "./Zon.ts"

/**
 * The name this strategy writes in `Closure.strategy`.
 *
 * @category constants
 * @since 0.1.0
 */
export const strategy = "zig"

/**
 * The Zig release line this strategy reads. The configuration text, the build
 * server protocol and the manifest layout are all new in 0.17 and none is
 * stable, so another line is refused, not guessed at.
 *
 * @category constants
 * @since 0.1.0
 */
export const supported = "0.17."

/**
 * Why no closure could be produced at all. A consumer treats any of these as
 * "every step is affected".
 *
 * @category errors
 * @since 0.1.0
 */
export error ZigClosureError {
  code: "zig-unavailable" | "unsupported-version" | "configure-failed" | "unknown-step" | "build-stopped"
  message: string
}

/**
 * Where the Zig project is and how to run Zig on it.
 *
 * @category models
 * @since 0.1.0
 */
export interface Project {
  /** The repository's absolute path. Closure paths are relative to it. */
  readonly root: string
  /** The directory holding `build.zig`, relative to `root`. The root itself when omitted. */
  readonly directory?: string | undefined
  /** The Zig executable. `zig` on the search path when omitted. */
  readonly zig?: string | undefined
  /** Arguments every `zig build` gets, such as `-Doptimize=ReleaseSafe`. They change what a step reads. */
  readonly args?: ReadonlyArray<string> | undefined
  /** The cache directory to build in. `.zig-cache` beside `build.zig` when omitted. A probe uses a private subdirectory of an explicit cache. */
  readonly cache?: string | undefined
  /** Maximum bytes per Zig stdout response. */
  readonly outputLimit?: number
  /** Maximum wall time for one subprocess, in milliseconds. */
  readonly timeoutMs?: number
}

/**
 * One step a closure can be asked for.
 *
 * @category models
 * @since 0.1.0
 */
export interface StepName {
  readonly name: string
  /** True when `zig build <name>` accepts the name. */
  readonly named: boolean
  /** True when the step runs a test binary. */
  readonly test: boolean
}

interface Session {
  readonly project: Project
  readonly directory: string
  readonly cache: string
  readonly zig: string
  readonly version: string
}

interface Ran {
  readonly out: Uint8Array
  readonly err: string
  readonly code: number
}

/** The last lines of what a command wrote to its standard error, for a message. */
const tail = (text: string): string => text.trim().split("\n").slice(-12).join("\n")

/**
 * Runs Zig in the project directory. A request is written to its standard
 * input, which then stays open: Zig 0.17.1's build server panics if its input
 * closes while it is still building, and leaves by itself once it reads the
 * request's exit message. A Zig that a signal ended has the exit code -1.
 */
effect function run(session: Session, args: ReadonlyArray<string>, request?: Uint8Array): Ran!ZigClosureError!ChildProcessSpawner {
  const spawner = try ChildProcessSpawner
  const command = ChildProcess.make(session.zig, args, {
    cwd: session.directory,
    stdin: request === undefined ? "ignore" : { stream: Stream.make(request), endOnDone: false },
    stdout: "pipe",
    stderr: "pipe"
  })
  const execution = scoped(effect {
    const handle = try spawner.spawn(command)
    let size = 0
    let err = ""
    const chunks: Array<Uint8Array> = []
    const stdout = Stream.runForEach(handle.stdout, effect (chunk) => {
      size += chunk.length
      if (size > (session.project.outputLimit ?? 64 * 1024 * 1024)) {
        throw new ZigClosureError({ code: "build-stopped", message: "Zig exceeded its output limit" })
      }
      chunks.push(chunk)
    })
    const stderr = Stream.runForEach(Stream.decodeText(handle.stderr), (chunk) => sync(() => {
      err = (err + chunk).slice(-8192)
    }))
    try all([stdout, stderr], { concurrency: 2 })
    const code = map(handle.exitCode, Number) catch () => -1
    return { out: Protocol.join(chunks), err, code }
  })
  const result = timeoutOption(execution, session.project.timeoutMs ?? 600_000) catch effect (cause) => {
    if (cause._tag === "ZigClosureError") throw cause
    throw new ZigClosureError({ code: "zig-unavailable", message: `${session.zig} did not run: ${cause.message}` })
  }
  if (Option.isNone(result)) throw new ZigClosureError({ code: "build-stopped", message: "Zig exceeded its time limit" })
  return result.value
}

/** Checks the Zig release and settles the directories every later command uses. */
effect function open(project: Project): Session!ZigClosureError!(ChildProcessSpawner | Path.Path | FileSystem.FileSystem) {
  const path = try Path.Path
  const fs = try FileSystem.FileSystem
  const root = fs.realPath(project.root) catch effect (error) => {
    throw new ZigClosureError({ code: "configure-failed", message: error.message })
  }
  const directory = path.join(root, project.directory ?? "")
  const session = {
    project: { ...project, root },
    directory,
    cache: path.resolve(directory, project.cache ?? ".zig-cache"),
    zig: project.zig ?? "zig",
    version: ""
  }
  const ran = try run(session, ["version"])
  const version = Protocol.utf8(ran.out).trim()
  if (ran.code !== 0 || !version.startsWith(supported)) {
    throw new ZigClosureError({
      code: "unsupported-version",
      message: `Zig ${supported}x is needed and ${session.zig} is ${version === "" ? "unknown" : version}`
    })
  }
  return { ...session, version }
}

const place = (session: Session, path: Path.Path): Draft.Place => ({
  root: session.project.root,
  directory: session.directory,
  version: session.version,
  path
})

/** The arguments of a `zig build` in this session. */
const build = (session: Session, ...first: ReadonlyArray<string>): ReadonlyArray<string> =>
  ["build", ...first, "--cache-dir", session.cache, ...(session.project.args ?? [])]

/** Reads the step graph. `build.zig` runs here if its result is not cached. */
effect function graph(session: Session): Graph.Graph!ZigClosureError!(ChildProcessSpawner | FileSystem.FileSystem) {
  const fs = try FileSystem.FileSystem
  return try scoped(effect {
    // Default to the checkout for jailed builds. An explicit cache can be writable even when the sources are read-only.
    const privateCache = effect {
      let directory = session.directory
      if (session.project.cache !== undefined) {
        directory = session.cache
        try fs.makeDirectory(directory, { recursive: true })
      }
      return try fs.makeTempDirectoryScoped({ directory, prefix: ".smithers-ci-zig-" })
    }
    const cache = privateCache catch effect (error) => {
      throw new ZigClosureError({ code: "configure-failed", message: error.message })
    }
    return try configured({ ...session, cache })
  })
}

effect function configured(session: Session): Graph.Graph!ZigClosureError!ChildProcessSpawner {
  const ran = try run(session, build(session, "--print-configuration"))
  if (ran.code !== 0) {
    throw new ZigClosureError({ code: "configure-failed", message: `build.zig did not configure:\n${tail(ran.err)}` })
  }
  const parsed = Zon.parse(Protocol.utf8(ran.out))
  if (!parsed.ok) throw new ZigClosureError({ code: "configure-failed", message: `Invalid Zig configuration at ${parsed.offset}: ${parsed.message}` })
  const read = Graph.read(parsed.value)
  if (read === undefined) {
    throw new ZigClosureError({ code: "configure-failed", message: "zig build printed a configuration this strategy cannot read" })
  }
  return read
}

/**
 * Lists the steps a closure can be asked for.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function steps(
  project: Project
): ReadonlyArray<StepName>!ZigClosureError!(ChildProcessSpawner | Path.Path | FileSystem.FileSystem) {
  const read = try graph(try open(project))
  const named = new Set(read.named.values())
  return read.steps.map((step) => ({ name: step.name, named: named.has(step.index), test: step.test }))
}

/**
 * The named steps each build step only groups, as `Graph.grouped` reads
 * them: `test` that depends on `test-core` and `test-cli` and does nothing
 * else gives those two names. A step that does work of its own, or that the
 * build does not have, gives none. Nothing is built.
 *
 * @param project - Where the project is.
 * @param names - Step names, as `zig build` takes them.
 * @returns One list per name, in order.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function groupsOf(
  project: Project,
  names: ReadonlyArray<string>
): ReadonlyArray<ReadonlyArray<string>>!ZigClosureError!(ChildProcessSpawner | Path.Path | FileSystem.FileSystem) {
  if (names.length === 0) return []
  const read = try graph(try open(project))
  return names.map((name) => {
    const index = read.named.get(name)
    return index === undefined ? [] : Graph.grouped(read, index)
  })
}

// Keep only last request's successful lookups per filesystem. A hint changes scan order only:
// the manifest must still exist in this cache and its current bytes must still match the output.
const recentManifests = new WeakMap<FileSystem.FileSystem, { directory: string; names: Map<string, string> }>()

/** The requested manifests, verified against the output digest derived from their current bytes. */
effect function manifests(session: Session, wanted: Set<string>): ReadonlyMap<string, ReadonlyArray<Manifest.Input>>!!(FileSystem.FileSystem | Path.Path) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = path.join(session.cache, "h")
  const names = fs.readDirectory(directory) catch () => []
  const found = new Map<string, ReadonlyArray<Manifest.Input>>()
  const cached = recentManifests.get(fs)
  const order = new Set<string>()
  const available = new Set(names.filter(Manifest.isName))
  if (cached?.directory === directory) {
    for (const digest of wanted) {
      const name = cached.names.get(digest)
      if (name !== undefined && available.has(name)) order.add(name)
    }
  }
  for (const name of available) order.add(name)
  const matched = new Map<string, string>()
  for (const name of order) {
    if (wanted.size === 0) break
    const bytes = fs.readFile(path.join(directory, name)) catch () => new Uint8Array()
    const inputs = Manifest.decode(bytes)
    if (inputs !== undefined) {
      const digest = Manifest.outputDigest(name, inputs)
      if (wanted.delete(digest)) {
        found.set(digest, inputs)
        matched.set(digest, name)
      }
    }
  }
  recentManifests.set(fs, { directory, names: matched })
  return found
}

/** Files a path a step declares: a file is followed, a directory or a missing path is reported. */
effect function declare(session: Session, into: Draft.Draft, step: Graph.Step, declared: string): void!!(FileSystem.FileSystem | Path.Path) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const kind = map(fs.stat(path.join(session.directory, declared)), (info) => info.type) catch () => "Missing" as const
  if (kind === "Missing") into.unresolved.push({ from: step.name, specifier: declared })
  else Draft.admit(place(session, path), into, step.name, { prefix: "build-root", path: declared, directory: kind !== "File" })
}

/** Reads and digests every file the drafts name, then writes the closures. */
effect function finish(
  session: Session,
  drafts: ReadonlyArray<Draft.Draft>
): ReadonlyArray<Closure>!!(FileSystem.FileSystem | Path.Path | EffectDigest.Digest) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = path.resolve(session.project.root)
  const paths = new Set(drafts.flatMap((made) => [...made.files, ...made.directories]))
  const resolved = new Map<string, string>()
  const indirect = new Set<string>()
  for concurrent(16) (const file of paths) {
    const source = path.join(root, file)
    const actual = fs.realPath(source) catch () => undefined
    if (actual === undefined) continue
    const relative = path.relative(root, actual)
    if (relative === "" || relative === ".." || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) continue
    resolved.set(file, relative)
    if (actual !== source) {
      const link = fs.readLink(source) catch () => ""
      if (path.resolve(path.dirname(source), link) !== actual) indirect.add(file)
    }
  }
  const digests = new Map<string, string>()
  for concurrent(16) (const file of new Set(drafts.flatMap((made) => [...made.files]))) {
    const actual = resolved.get(file)
    if (actual === undefined) continue
    const digest = flatMap(fs.readFile(path.join(root, actual)), (bytes) => sha256(bytes)) catch () => undefined
    if (digest !== undefined) {
      digests.set(file, digest)
      digests.set(actual, digest)
    }
  }
  for (const made of drafts) {
    for (const paths of [made.files, made.directories]) {
      for (const file of [...paths]) {
        const actual = resolved.get(file)
        if (actual !== undefined) paths.add(actual)
        if (indirect.has(file) || (paths === made.directories && (actual === undefined || actual !== file))) {
          made.dynamic.push({ from: file, specifier: "a directory or link chain cannot be tracked exactly" })
        }
      }
    }
  }
  return drafts.map((made) => Draft.close(strategy, made, digests))
}

/**
 * The closure of each named build step: every file the step and the steps it
 * depends on read.
 *
 * Compile steps are built, into `project.cache`, because only the compiler
 * knows what it read. No test and no other command with side effects is run.
 *
 * @param project - Where the project is.
 * @param names - Step names: one `zig build` accepts, such as `test`, or a
 * step's own name, such as `run test`.
 * @returns One closure per name, in order, each with the name as its entry.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function ofSteps(
  project: Project,
  names: ReadonlyArray<string>
): ReadonlyArray<Closure>!ZigClosureError!(FileSystem.FileSystem | Path.Path | ChildProcessSpawner | EffectDigest.Digest) {
  if (names.length === 0) return []
  const session = try open(project)
  const where = place(session, try Path.Path)
  const read = try graph(session)
  const asked: Array<{ readonly name: string; readonly reached: ReadonlyArray<Graph.Step> }> = []
  for (const name of names) {
    const step = Graph.find(read, name)
    if (step === undefined) throw new ZigClosureError({ code: "unknown-step", message: `zig build has no step named ${name}` })
    asked.push({ name, reached: Graph.reach(read, step.index) })
  }
  const toBuild = [...new Set(asked.flatMap((entry) => entry.reached.filter(Draft.compiles).map((step) => step.index)))]
  const ran = try run(session, build(session, "--listen=-"), Protocol.buildRequest(toBuild))
  const reply = Protocol.decodeBuild(ran.out)
  // Maker 0.17.1 can await its closed Io.Select after it has sent build-completed.
  // Only that shutdown panic is tolerated, and only with a fully framed successful configuration.
  const shutdownPanic = session.version === "0.17.1" && ran.err.includes("panic: attempt to unwrap error: Closed")
  if (!reply.completed || reply.configurationFailed || (ran.code !== 0 && !shutdownPanic)) {
    throw new ZigClosureError({
      code: reply.configurationFailed ? "configure-failed" : "build-stopped",
      message: `${reply.configurationFailed ? "zig build could not configure" : "zig build stopped before it finished"}:\n${tail(ran.err)}`
    })
  }
  const outputs = [reply.configuration, ...reply.steps.flatMap((step) => step.outputs.map((output) => output.path))]
  const found = try manifests(session, new Set(outputs.flatMap((path) => Draft.outputOf(path ?? "") ?? [])))
  const results = new Map(reply.steps.map((result) => [result.step, result]))
  const configured = Draft.listed(found, reply.configuration)
  const drafts: Array<Draft.Draft> = []
  for (const entry of asked) {
    const made = Draft.make(entry.name)
    if (configured === undefined) made.dynamic.push({ from: "build.zig", specifier: "it reads something Zig does not track" })
    else for (const input of configured) Draft.admit(where, made, "build.zig", input)
    for (const step of entry.reached) {
      for (const reason of step.open) made.dynamic.push({ from: step.name, specifier: reason })
      for (const declared of step.paths) try declare(session, made, step, declared)
      Draft.settle(where, made, step, results.get(step.index), found)
    }
    drafts.push(made)
  }
  return try finish(session, drafts)
}

/**
 * The closure of each entry file compiled on its own, as `zig test FILE`
 * compiles it, with no `build.zig`.
 *
 * The compiler analyzes the file and emits nothing. A file that does not
 * compile still yields a closure; what stopped it is in `unresolved`.
 *
 * @param project - Where the project is. `args` is not used.
 * @param files - Entry files, relative to the directory holding the project.
 * @returns One closure per file, in order, each with the file as its entry.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function ofFiles(
  project: Project,
  files: ReadonlyArray<string>
): ReadonlyArray<Closure>!ZigClosureError!(FileSystem.FileSystem | Path.Path | ChildProcessSpawner | EffectDigest.Digest) {
  if (files.length === 0) return []
  const session = try open(project)
  const where = place(session, try Path.Path)
  const drafts: Array<Draft.Draft> = []
  for (const file of files) {
    const made = Draft.make(file)
    Draft.admit(where, made, file, { prefix: "build-root", path: file, directory: false })
    const ran = try run(session, ["test", file.startsWith("-") ? `./${file}` : file, "-fno-emit-bin", "--listen=-", "--cache-dir", session.cache], Protocol.compileRequest)
    const reply = Protocol.decodeCompile(ran.out)
    if (reply.inputs === undefined) made.unresolved.push({ from: file, specifier: "the compiler reported no files" })
    else for (const input of reply.inputs) Draft.admit(where, made, file, { ...input, directory: false })
    if (reply.inputs !== undefined && (ran.code !== 0 || !reply.completed)) {
      made.unresolved.push({ from: file, specifier: "the compiler stopped before it finished" })
    }
    Draft.report(made, file, reply.problems)
    drafts.push(made)
  }
  return try finish(session, drafts)
}

/** A `ZigClosureError` as contract 10's failure. Only a Zig of another release is `unsupported`. */
const failure = (error: ZigClosureError): Failure => ({
  code: error.code === "unsupported-version" ? "unsupported" : "command-failed",
  message: error.message,
  part: "closure"
})

/**
 * Contract 10's `CloseEntries` for Zig: the closure of each entry in the
 * repository at `root`, which holds `build.zig`.
 *
 * An entry that ends in `.zig` is an entry file, compiled on its own as
 * {@link ofFiles} does. Any other entry is a build step's name, as
 * {@link ofSteps} takes it.
 *
 * @param root - The repository's absolute path.
 * @param entries - Step names and entry files.
 * @returns One closure per entry, in order.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function close(
  root: string,
  entries: ReadonlyArray<string>
): ReadonlyArray<Closure>!Failure!(FileSystem.FileSystem | Path.Path | ChildProcessSpawner | EffectDigest.Digest) {
  const isFile = (entry: string): boolean => entry.endsWith(".zig")
  const unique = [...new Set(entries)]
  const closed = all([ofFiles({ root }, unique.filter(isFile)), ofSteps({ root }, unique.filter((entry) => !isFile(entry)))])
  const [files, steps] = closed catch effect (error) => {
    throw failure(error)
  }
  const made = new Map([...files, ...steps].map((closure) => [closure.entries[0], closure]))
  return entries.map((entry) => made.get(entry)!)
}

/**
 * The named steps each build step of the repository at `root` only groups,
 * for the part that splits a CI step: {@link groupsOf} with contract 10's
 * failure.
 *
 * @param root - The repository's absolute path.
 * @param steps - Step names, as `zig build` takes them.
 * @returns One list per step, in order; empty for a step that is not a group.
 *
 * @category strategy
 * @since 0.1.0
 */
export effect function groups(
  root: string,
  steps: ReadonlyArray<string>
): ReadonlyArray<ReadonlyArray<string>>!Failure!(ChildProcessSpawner | Path.Path | FileSystem.FileSystem) {
  return groupsOf({ root }, steps) catch effect (error) => {
    throw failure(error)
  }
}
