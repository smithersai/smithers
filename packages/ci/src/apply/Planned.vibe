/**
 * Whether Smithers build plans the targets of the files `apply` writes,
 * before any is written.
 *
 * It plans them in a copy of the repository at the commit `HEAD` names, made
 * with `git clone --shared`, that holds the generated files, with a home and
 * a cache of its own: nothing is written into the repository or the home. A job whose targets it refuses to plan
 * stays in the repository's own workflow and is named with
 * Smithers build's words, as every job left out is. So `apply` never writes a
 * job Smithers build will not run. When every target plans at once, no job is
 * planned alone; when they do not, each job is, to find the ones refused. A
 * refusal no job meets alone keeps every job in the repository's workflow.
 *
 * Smithers build runs here on the person's machine, in no jail, and it loads
 * every build file of the tree it plans as a module. So the copy holds no
 * build file but the generated ones before it is started: one the repository
 * holds at `HEAD` and in the working tree stops the plan, and `apply` with it,
 * and one the working tree no longer holds is removed from the copy
 * (`Former.declares`). It is started with what a step gets of the machine and
 * nothing else of the person's, and is given a time to answer in.
 *
 * A plan that fails for another reason than its targets, a full disk, a
 * missing program, a plan that does not end, says nothing about a job. It
 * fails `apply`, which then writes nothing: were the job left out for it, a
 * fault of this machine would be written into the repository's CI.
 *
 * @since 0.1.0
 */

import { thisMachine } from "../inventory/Tools.ts"
import { errorLine } from "../contract/Command.vibe"
import type { NotReplayed } from "../contract/Inventory.vibe"
import { type Failure, type GeneratedFile, writtenFiles } from "../contract/Parts.vibe"
import { path as targetMapPath, TargetMap } from "../contract/TargetMap.vibe"
import { inheritedEnvironmentNames } from "@smthrs/targets/Exec"
import { ambientEnvironment } from "../replay/Environment.ts"
import { exec } from "../replay/Process.vibe"
import { runGit } from "../inventory/HostGit.vibe"
import { check } from "./Check.vibe"
import { declaredRefusal, declares } from "./Former.vibe"
import { compiledCaches, Options } from "../replay/Replay.vibe"

/**
 * The feature of a job left out because Smithers build refuses to plan its
 * targets.
 *
 * @category constants
 * @since 0.1.0
 */
export const refusedByBuild = "build-refused"

/** A failure of the check itself, which `apply` reports as its own. */
const failed = (code: Failure["code"], message: string): Failure => ({ code, message, part: "cli" })

/** The most of what Smithers build printed that is kept: its error is at the end. */
const kept = 64 * 1024

/** A Node runtime warning line that accompanies a command's own output. */
const nodeWarning = /^\(node:\d+\)\s+\w*Warning:|^\(Use `node --trace-warnings /
// A terminal control sequence, or else one escape character. Removing a sequence can join an escape character before
// it to the text after it as a new sequence (`ESC ESC [ m [ 3 1 m`), so no escape character is left.
const ansiControl = /\u001b\[[0-?]*[ -/]*[@-~]|\u001b/g

// The last complete refusal, even if an earlier log line has an unmatched brace. A frame
// parses just its own fields: each completed child is replaced with {} (or an invalid token).
// This keeps deeply nested or malformed output linear instead of reparsing overlapping slices.
const messageIn = (text: string): string | undefined => {
  interface Frame {
    start: number
    unread: number
    parts: Array<string>
    previous: string | undefined
  }
  const open: Array<Frame> = []
  let message: string | undefined
  // A quoted JSON string occupies one token, including its escapes. Braces inside it are data.
  for (const token of text.matchAll(/"(?:\\[^\r\n]|[^"\\\r\n])*"|[{}]/g)) {
    if (token[0] === "{") {
      open.push({ start: token.index, unread: token.index, parts: [], previous: message })
    } else if (token[0] === "}") {
      const frame = open.pop()
      if (frame === undefined) continue
      const end = token.index + 1
      frame.parts.push(text.slice(frame.unread, end))
      let replacement = "{}"
      try {
        const record = JSON.parse(frame.parts.join("")) as { readonly message?: unknown }
        // A complete outer record owns the diagnostic. A message in its metadata is not a refusal.
        const words = typeof record.message === "string" ? record.message.replace(ansiControl, "").trim() : ""
        message = words === "" ? frame.previous : words
      } catch {
        replacement = "?"
      }
      const parent = open.at(-1)
      if (parent !== undefined) {
        parent.parts.push(text.slice(parent.unread, frame.start), replacement)
        parent.unread = end
      }
    }
  }
  return message
}

/**
 * Smithers build's own words for a refusal, in one line: the message of the
 * error it printed as JSON, else the last substantive line it printed.
 *
 * @category accessors
 * @since 0.1.0
 */
export const refusalOf = (printed: string): string => {
  const raw = printed.replace(ansiControl, "").split("\n").filter((line) => line.trim() !== "")
  const useful = raw.filter((line) => !nodeWarning.test(line.trim()))
  return errorLine(messageIn(useful.join("\n")) ?? useful.at(-1) ?? raw.at(-1) ?? "it printed nothing")
}

/**
 * How long Smithers build may take over one plan of the generated files when
 * nothing says otherwise: ten minutes. A plan reads declarations and runs no
 * step, and ends in seconds.
 *
 * @category constants
 * @since 0.1.0
 */
export const planLimit: Duration.Input = "10 minutes"

/**
 * What a failed plan says when the failure is this machine's and no word
 * about the targets: no room, no memory, no descriptor, no right to a file.
 */
const machineFault =
  /\b(?:ENOSPC|EDQUOT|ENOMEM|EMFILE|ENFILE|EIO|EROFS|EACCES|EPERM|ETIMEDOUT)\b|no space left on device|out of memory|heap limit/i

/**
 * Smithers build's refusal of the targets it was asked to plan, in its own
 * words, or `undefined` when what it printed is no such refusal: it printed
 * no error of its own as JSON, as a program that could not start or was
 * stopped does not, or its error is a fault of this machine.
 *
 * @category accessors
 * @since 0.1.0
 */
export const refusedTargets = (printed: string): string | undefined => {
  const useful = printed.replace(ansiControl, "").split("\n").filter((line) => !nodeWarning.test(line.trim()))
  const message = messageIn(useful.join("\n"))
  return message === undefined || machineFault.test(message) ? undefined : errorLine(message)
}

/** Labels of generated targets pinned to a host other than this machine, which `smthrs ci <label> --plan` refuses by OS. */
const otherHostLabels = (files: ReadonlyArray<GeneratedFile>, host: string = thisMachine().host): ReadonlySet<string> => {
  const declaration = files.find((file) => file.path === ".smithers/WORKSPACE.smithers")
  if (declaration === undefined) return new Set()
  const otherSteps = new Set<string>()
  for (const match of declaration.content.matchAll(/^const (step\d+) = S\.Shell\.(?:Build|Test)\(\{([\s\S]*?)^\}\)/gm)) {
    const pinned = /^  hosts: \["([a-z0-9]+)"\]/m.exec(match[2]!)
    if (pinned !== null && pinned[1] !== host) otherSteps.add(match[1]!)
  }
  if (otherSteps.size === 0) return new Set()
  const labels = new Set<string>()
  for (const match of declaration.content.matchAll(/^    "([^"]+)": (step\d+)/gm)) {
    if (otherSteps.has(match[2]!)) labels.add(`//:${match[1]!}`)
  }
  return labels
}

/** The labels of each job's targets runnable on this host, by job, in the order the target map names them. */
const labelsByJob = (map: TargetMap, skip: ReadonlySet<string>): ReadonlyMap<string, ReadonlySet<string>> => {
  const jobs = new Map<string, Set<string>>()
  for (const entry of map.targets) {
    if (skip.has(entry.label)) continue
    jobs.set(entry.job, (jobs.get(entry.job) ?? new Set<string>()).add(entry.label))
  }
  return jobs
}

/**
 * The jobs of `files` whose targets Smithers build, started as `smthrs`,
 * refuses to plan in a copy of the repository at `root`, each with why. The
 * copy holds `files` and none of the files of an earlier `smithers-ci` that
 * `apply` would remove from it. Nothing when it plans them all, or when the
 * files hold no target.
 *
 * It fails `unsupported` when the copy holds a build file the generator did
 * not write, before Smithers build is started, and `command-failed` when a
 * plan does not end within `limit` or fails for a reason that is not its
 * targets'.
 *
 * @category checking
 * @since 0.1.0
 */
export effect function refusals(
  smthrs: readonly [string, ...Array<string>],
  root: string,
  files: ReadonlyArray<GeneratedFile>,
  limit: Duration.Input = planLimit
) {
  const git = effect (cwd: string, args: ReadonlyArray<string>) => {
    const result = runGit(root, cwd, args) catch effect (cause) => {
      throw failed("command-failed", `could not run git: ${errorLine(cause)}`)
    }
    if (result.code !== 0) throw failed("command-failed", `git ${args[0]} failed: ${errorLine(result.diagnostic)}`)
    return result.text
  }
  const written = files.find((file) => file.path === targetMapPath)
  if (written === undefined) return []
  const map = Schema.decodeUnknownEffect(Schema.fromJsonString(TargetMap))(written.content) catch effect (cause) => {
    throw failed("invalid-document", `the target map the generator wrote is not one: ${cause.message}`)
  }
  const jobs = labelsByJob(map, otherHostLabels(files))
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  return try scoped(effect {
    const work = fs.makeTempDirectory({ prefix: "smithers-ci-plan-" }) catch effect (cause) => {
      throw failed("command-failed", `could not make a directory: ${errorLine(cause)}`)
    }
    // The copy goes when the plan is done; one that cannot be removed is left, and says nothing of the repository.
    try addFinalizer(() => ignore(fs.remove(work, { recursive: true, force: true })))
    // The copy keeps the repository's name, which a build can read, in a directory of its own: a repository named
    // `home` or `cache` is then never the directory Smithers build is given as its home or its cache.
    const copy = path.join(work, "repository", path.basename(root))
    const commit = (try git(root, ["rev-parse", "--verify", "HEAD"])).trim()
    try git(work, ["clone", "--quiet", "--shared", "--no-checkout", root, copy])
    try git(copy, ["checkout", "--quiet", "--detach", commit])
    // Every build file of the commit, which Smithers build would read. One the working tree no longer holds, in
    // any way, a link to nowhere included, goes from the copy: the plan is of the files the person has, and removing
    // a build file is what a refusal below asks for.
    const declared = (try git(copy, ["ls-files", "-z"])).split("\0").filter(declares)
    const working = (try git(root, ["ls-files", "--cached", "--others", "--exclude-standard", "-z"])).split("\0").filter(declares)
    const overlays = (try git(root, ["ls-files", "--others", "-z", "--", ".smithers/config.*"])).split("\0").filter(declares)
    const previous = (try check(root, files)).former
    const candidates = [...new Set([...declared, ...working.filter((file) => !previous.includes(file)), ...overlays])].sort()
    const gone: Array<string> = []
    for (const file of candidates) {
      const at = path.join(root, file)
      const missing = fs.stat(at) catch (error) => error.reason._tag === "NotFound"
      const link = fs.readLink(at) catch () => undefined
      if (missing === true && link === undefined) gone.push(file)
    }
    if (gone.length > 0) try git(copy, ["rm", "--quiet", "-r", "--ignore-unmatch", "--", ...gone])
    // What an earlier smithers-ci wrote at this commit goes, as apply removes it.
    const former = (try check(copy, files)).former
    if (former.length > 0) try git(copy, ["rm", "--quiet", "-r", "--ignore-unmatch", "--", ...former])
    // Smithers build loads every build file of the tree it plans, and nothing of the repository runs here.
    const generated = new Set(writtenFiles(files).map((file) => file.path))
    const stray = candidates.filter((file) => !gone.includes(file) && !former.includes(file) && !generated.has(file))
    if (stray.length > 0) throw { code: "unsupported", message: declaredRefusal(stray), part: "generate" } satisfies Failure
    if (jobs.size === 0) return []
    // The copy holds the files apply would write, and Smithers build is given a home of its own beside it.
    const home = path.join(work, "home")
    const cache = path.join(work, "cache")
    const prepared = effect {
      try fs.makeDirectory(home)
      for (const file of writtenFiles(files)) {
        const at = path.join(copy, file.path)
        try fs.makeDirectory(path.dirname(at), { recursive: true })
        try fs.writeFileString(at, file.content)
      }
    }
    prepared catch effect (cause) => {
      throw failed("command-failed", `could not write the files apply writes into a copy: ${errorLine(cause)}`)
    }
    // Its whole environment: what a step gets of the machine, a home of its own, and nothing else of the person's
    // but where compiled code is kept.
    const ambient = ambientEnvironment()
    const environment = {
      ...Object.fromEntries(inheritedEnvironmentNames.map((name) => [name, ambient[name]])),
      // Where VibeLang keeps compiled code, which holds no credential: without it every plan compiles Smithers
      // build's own sources again.
      VIBELANG_CACHE_DIR: ambient["VIBELANG_CACHE_DIR"],
      HOME: home,
      XDG_CACHE_HOME: path.join(home, ".cache"),
      XDG_CONFIG_HOME: path.join(home, ".config"),
      XDG_DATA_HOME: path.join(home, ".local", "share"),
      XDG_STATE_HOME: path.join(home, ".local", "state"),
      ...compiledCaches(cache, false)
    }
    const [command, ...first] = smthrs
    /**
     * Smithers build's refusal of `labels`, the targets of `whose`, or `undefined` when it plans them. A plan that
     * does not end in time, or fails with no refusal of its targets, fails here.
     */
    const plan = (labels: ReadonlyArray<string>, whose: string) =>
      effect {
        const ran = try timeoutOption(
          exec(
            command,
            [...first, "ci", ...labels, "--plan", "--format", "json", "--workspace", copy, "--cache-dir", cache],
            copy,
            environment,
            kept,
            undefined,
            true
          ),
          limit
        )
        if (Option.isNone(ran)) {
          throw failed(
            "command-failed",
            `Smithers build did not plan ${whose} within ${Duration.format(Duration.fromInputUnsafe(limit))}, so nothing is written`
          )
        }
        if (ran.value.exitCode === 0) return undefined
        const refusal = refusedTargets(ran.value.text)
        if (refusal === undefined) {
          throw failed(
            "command-failed",
            `Smithers build could not plan ${whose}, so nothing is written: ${refusalOf(ran.value.text)}`
          )
        }
        return refusal
      }
    // The generated targets by name: `//...` would ask for whatever else the tree declares.
    const whole = try plan([...jobs.values()].flatMap((labels) => [...labels]), "the generated files")
    if (whole === undefined) return []
    const refused: Array<NotReplayed> = []
    for (const [job, labels] of jobs) {
      const alone = try plan([...labels], `the targets of ${job}`)
      if (alone !== undefined) refused.push({ job, reasons: [{ feature: refusedByBuild, detail: alone }] })
    }
    if (refused.length > 0) return refused
    // A refusal no job meets alone is of the jobs together, and is kept in Smithers build's words for each.
    return [...jobs.keys()].map((job) => ({ job, reasons: [{ feature: refusedByBuild, detail: whole }] }))
  })
}

/**
 * The jobs of `files` that Smithers build, as this program starts it, refuses
 * to run in the repository at `root`; see {@link refusals}.
 *
 * @category checking
 * @since 0.1.0
 */
export effect function planned(root: string, files: ReadonlyArray<GeneratedFile>) {
  return try refusals((try Options).smthrs, root, files)
}
