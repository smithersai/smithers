/**
 * What is checked before generated files are written into a repository by
 * `apply`, and at each commit a replay runs: whether every generated path
 * can be written there, and which files of an earlier `smithers-ci` are
 * removed. A replay writes nothing into its copy; it checks so that a commit
 * `apply` would refuse is listed and not replayed.
 *
 * Every generated path is checked before any is written, so a refusal leaves
 * the directory as it was. A path is refused when its real location is
 * outside the directory (a link in the path), when a file is where a
 * directory must go or a directory where the file must go, and when the file
 * there is one `smithers-ci` did not write. A build file of the repository's
 * own that Smithers build would read beside the generated ones is refused
 * the same way.
 *
 * The same check says what writing the files would change, file by file:
 * `apply --check` prints that in place of writing.
 *
 * @since 0.1.0
 */

import { type Failure, type GeneratedFile, writtenFiles } from "../contract/Parts.vibe"
import { overwriteRefusal, wrote } from "../native/Workspace.vibe"
import { besidePaths, besideRefusal, formerPaths } from "./Former.vibe"

/**
 * What writing the generated files would do to one path: write a file that
 * is `missing`, replace one whose bytes `differ`, or remove one an earlier
 * `smithers-ci` wrote (`unused`).
 *
 * @category models
 * @since 0.1.0
 */
export interface Change {
  readonly path: string
  readonly change: "missing" | "differs" | "unused"
}

/**
 * What a check of the generated paths gives: `former`, the files an earlier
 * `smithers-ci` wrote where the generated files no longer go, which whoever
 * writes the generated files removes, and `changes`, every path whose bytes
 * `apply` would change, in the order it writes them. An empty list means the
 * files on disk are the ones it would write. `apply` writes the generated
 * files and nothing else: no line of the repository's `.gitignore`, because
 * nothing Smithers build keeps is in the checkout.
 *
 * @category models
 * @since 0.1.0
 */
export interface Checked {
  readonly former: ReadonlyArray<string>
  readonly changes: ReadonlyArray<Change>
}

/** What is at a path `apply` would write: nothing, a file, or something that stops the write. */
data Place {
  Absent
  Present
  Refused { why: string }
}

/** One refusal for everything wrong with the paths `apply` would write. */
const refuse = (problems: ReadonlyArray<string>): Failure => ({
  code: "unsupported",
  message: problems.join("; "),
  part: "generate"
})

/** A path and each directory above it, outermost first. */
const prefixesOf = (path: string): ReadonlyArray<string> => {
  const segments = path.split(/[\\/]/)
  return segments.map((_, index) => segments.slice(0, index + 1).join("/"))
}

/**
 * What is at `path` in the repository at `root`, whose real location is
 * `realRoot`. Each directory above the path is looked at too: a link in the
 * path is followed by a write.
 */
effect function placeOf(root: string, realRoot: string, path: string) {
  const fs = try FileSystem.FileSystem
  const paths = try Path.Path
  for (const prefix of prefixesOf(path)) {
    const at = paths.join(root, prefix)
    const real = fs.realPath(at) catch () => undefined
    if (real === undefined) {
      // Nothing is there, so it can be made; unless it is a link, which a write would follow.
      const link = fs.readLink(at) catch () => undefined
      return link === undefined
        ? Place.Absent()
        : Place.Refused({ why: `${prefix} is a link to ${link}, which does not exist` })
    }
    if (real !== realRoot && !real.startsWith(`${realRoot}${paths.sep}`)) {
      return Place.Refused({ why: `${prefix} is a link to ${real}, outside the repository` })
    }
    const kind = fs.stat(at) catch () => undefined
    if (prefix !== path && kind?.type !== "Directory") {
      return Place.Refused({ why: `${prefix} is not a directory, so ${path} cannot be written` })
    }
    if (prefix === path && kind?.type !== "File") return Place.Refused({ why: `${path} is not a file` })
  }
  return Place.Present()
}

/** The text of the file at `path`, or `undefined` when it cannot be read. */
effect function textOf(path: string) {
  const fs = try FileSystem.FileSystem
  return fs.readFileString(path) catch () => undefined
}

/** True when the file at `path` holds exactly the bytes `apply` writes for `content`. */
effect function holds(path: string, content: string) {
  const fs = try FileSystem.FileSystem
  const bytes = fs.readFile(path) catch () => undefined
  const wanted = new TextEncoder().encode(content)
  return bytes !== undefined && bytes.length === wanted.length && bytes.every((byte, index) => byte === wanted[index])
}

/**
 * Checks every path of `files` that is written, in the repository or the
 * copy of one at `root`, and writes nothing. It fails `unsupported` with one refusal that
 * names every path that cannot be written; otherwise it gives the files of
 * an earlier `smithers-ci` to remove and every path `apply` would change.
 *
 * @category accessors
 * @since 0.1.0
 */
export effect function check(root: string, files: ReadonlyArray<GeneratedFile>) {
  const fs = try FileSystem.FileSystem
  const paths = try Path.Path
  const realRoot = fs.realPath(root) catch () => root
  const problems: Array<string> = []
  const kept: Array<string> = []
  const changes: Array<Change> = []
  const placed = writtenFiles(files)
  for (const file of placed) {
    const place = try placeOf(root, realRoot, file.path)
    if (place._tag === "Refused") problems.push(place.why)
    if (place._tag === "Absent") changes.push({ path: file.path, change: "missing" })
    if (place._tag !== "Present") continue
    // A file that cannot be read is the owner's.
    const at = paths.join(root, file.path)
    const text = try textOf(at)
    if (text === undefined || !wrote(file.path, text)) kept.push(file.path)
    else if (!(try holds(at, file.content))) changes.push({ path: file.path, change: "differs" })
  }
  if (kept.length > 0) problems.push(overwriteRefusal(kept))
  // What an earlier smithers-ci left where the files no longer go is removed. What Smithers build would read
  // beside the generated files, and the owner wrote, stops the write.
  const written = new Set(placed.map((file) => file.path))
  const former: Array<string> = []
  const beside: Array<string> = []
  for (const path of new Set([...formerPaths, ...besidePaths])) {
    if (written.has(path)) continue
    const read = besidePaths.includes(path)
    const place = try placeOf(root, realRoot, path)
    // A link or a directory where Smithers build reads is refused as it is for a generated path. A parent that is
    // in the way is already refused for the generated file that goes under it.
    if (read && place._tag === "Refused" && !problems.includes(place.why) && !place.why.endsWith("cannot be written")) {
      problems.push(place.why)
    }
    if (place._tag !== "Present") continue
    const text = try textOf(paths.join(root, path))
    if (text !== undefined && formerPaths.includes(path) && wrote(path, text)) former.push(path)
    else if (read) beside.push(path)
  }
  if (beside.length > 0) problems.push(besideRefusal(beside))
  if (problems.length > 0) throw refuse(problems)
  changes.push(...former.map((path): Change => ({ path, change: "unused" })))
  return { former, changes } satisfies Checked
}
