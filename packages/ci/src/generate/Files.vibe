/**
 * The generate part (contract 10).
 *
 * @since 0.1.0
 */

import type { Ci } from "../contract/Inventory.vibe"
import type { Failure, GeneratedFile, GenerateOptions } from "../contract/Parts.vibe"
import { renderFiles } from "./Render.ts"
import { planSteps } from "./Steps.vibe"

/**
 * The Smithers workspace, targets, target map and CI workflow for a
 * repository's CI. The same CI always gives the same bytes, and nothing is
 * written.
 *
 * @category parts
 * @since 0.1.0
 */
export effect function files(inventory: Ci, options?: GenerateOptions): ReadonlyArray<GeneratedFile>!Failure {
  const plan = try fromResult(planSteps(inventory))
  return try fromResult(renderFiles(inventory, plan, options, () => planSteps(inventory, false)))
}
