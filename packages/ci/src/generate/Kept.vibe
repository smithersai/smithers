/**
 * The steps of the generated workflow that send a job's results out as the
 * repository's own workflow did (`Inventory.KeptStep`): an upload of an
 * artifact, a coverage report, test results.
 *
 * Such a step runs on the runner, after `smthrs ci`, once for each variant of
 * its job that the generated workflow runs. Smithers build leaves that job's
 * checkout where the step before it finds it (`keptDirectory`), with what each
 * of its steps left, also when every step reused its result. The step before
 * the kept one puts that checkout in the runner's workspace, where the action
 * reads its inputs, and the kept step runs as the repository wrote it, with
 * the variant's matrix values written in.
 *
 * @since 0.1.0
 */

import { expand, type Job, type KeptStep, runnerOf } from "../contract/Inventory.vibe"
import { split } from "../inventory/Expression.ts"
import { type Variant, variantKey } from "./Expressions.vibe"
import type { StepPlan } from "./Steps.vibe"
import * as Yaml from "./Yaml.vibe"

/**
 * One place a kept step runs: the job, its variant, the machine Smithers build
 * runs its targets on, and the condition of the generated matrix entry that
 * runs them, such as `matrix.os == 'ubuntu-latest'`.
 *
 * @category models
 * @since 0.1.0
 */
export interface KeptPlace {
  readonly job: Job
  readonly variant: Variant
  readonly machine: string
  readonly entry: string
}

/**
 * Where Smithers build leaves the checkout of the `index`th kept machine on
 * the runner when its run ends.
 *
 * @category constants
 * @since 0.1.0
 */
export const keptDirectory = (index: number): string => `\${{ runner.temp }}/smthrs-kept/${index}`

/**
 * The variable that tells Smithers build which machines to keep when the
 * run ends, and where: a JSON object from a machine's name to a directory.
 *
 * @category constants
 * @since 0.1.0
 */
export const keepVariable = "SMTHRS_KEEP_MACHINES"

/**
 * One kept step at one place, with the number of the directory its
 * machine's checkout is kept in.
 *
 * @category models
 * @since 0.1.0
 */
export interface KeptRun {
  readonly step: KeptStep
  readonly place: KeptPlace
  readonly index: number
}

/**
 * Every kept step of `jobs` at each place the generated workflow runs its
 * job: once for each variant that has a target on a machine, under the
 * matrix entry that runs it. Each machine has a directory of its own. A
 * step that cannot be written for a variant (`keptNotes`) has no run there.
 *
 * @category rendering
 * @since 0.1.0
 */
export const keptRuns = (
  jobs: ReadonlyArray<Job>,
  plan: Pick<StepPlan, "targets" | "legs">
): ReadonlyArray<KeptRun> => placed(jobs, plan).filter((run) => unwritten(run.step, run.place.variant) === undefined)

/**
 * One line for each kept step of `jobs` the generated workflow does not run
 * at a place, with why: the step reads the job's matrix in a way that has no
 * faithful form in the generated workflow, whose own matrix holds other keys.
 *
 * @category rendering
 * @since 0.1.0
 */
export const keptNotes = (
  jobs: ReadonlyArray<Job>,
  plan: Pick<StepPlan, "targets" | "legs">
): ReadonlyArray<string> =>
  placed(jobs, plan).flatMap(({ place, step }) => {
    const why = unwritten(step, place.variant)
    return why === undefined ? [] : [`${place.job.id}${variantName(place.variant)}: ${step.uses} is not run: ${why}`]
  })

// Every kept step at every place, whether or not it can be written there. A machine's directory has the same number
// either way.
const placed = (jobs: ReadonlyArray<Job>, plan: Pick<StepPlan, "targets" | "legs">): ReadonlyArray<KeptRun> => {
  const runs: Array<KeptRun> = []
  let index = 0
  for (const job of jobs) {
    const kept = job.kept ?? []
    const seen = new Set<string>()
    for (const target of plan.targets) {
      if (kept.length === 0 || target.job !== job.id || target.machine === undefined) continue
      const key = variantKey(target.variant)
      if (seen.has(key)) continue
      seen.add(key)
      const leg = plan.legs.find((each) => each.labels.includes(target.label))
      const runner = runnerOf(job, target.variant) ?? ""
      const entry = leg !== undefined
        ? `matrix.leg == ${literal(leg.id)}`
        : runner.includes(",")
        ? `join(matrix.os, ',') == ${literal(runner)}`
        : `matrix.os == ${literal(runner)}`
      const place = { job, variant: target.variant, machine: target.machine, entry }
      for (const step of kept) runs.push({ step, place, index })
      index += 1
    }
  }
  return runs
}

/**
 * The value of `keepVariable` for `runs`: each machine once, with its
 * directory on the runner.
 *
 * @category rendering
 * @since 0.1.0
 */
export const keepValue = (runs: ReadonlyArray<KeptRun>): string => {
  const directories = new Map(runs.map((run) => [run.place.machine, run.index]))
  // GitHub writes each directory as JSON text (`toJSON`), not this program: a Windows runner's temporary directory
  // is `D:\a\_temp`, and a backslash written into a JSON string as it stands makes the whole value unreadable.
  return `{${
    [...directories].map(([machine, index]) =>
      `${fenced(JSON.stringify(machine))}:\${{ toJSON(format('{0}/smthrs-kept/${index}', runner.temp)) }}`
    ).join(",")
  }}`
}

// A matrix value written into an expression as GitHub reads text.
const literal = (value: string): string => `'${value.replaceAll("'", "''")}'`

// Text GitHub leaves as it is: an expression it would read in the text is written as the string it stands for.
const fenced = (text: string): string => text.replaceAll("${{", "${{ '${{' }}")

// Every `matrix.<key>` an expression reads, outside its strings, becomes the variant's value. The generated
// workflow's own matrix holds other keys.
const fillExpression = (expression: string, variant: Variant): string =>
  expression.split(/('(?:[^']|'')*')/).map((piece, at) =>
    at % 2 === 1 ? piece : piece.replace(
      /(?<![\w.])matrix\.([\w.-]+)/gi,
      (_whole, key: string) => {
        const found = Object.keys(variant).find((held) => held.toLowerCase() === key.toLowerCase())
        return literal(found === undefined ? "" : variant[found] as string)
      }
    )
  ).join("")

// One place an expression reads `matrix`, outside its strings: the keys after it, and what follows them when that
// is a `.*` or a `[`.
const matrixRead = /(?<![\w.])matrix(?![\w-])((?:\.[\w-]+)*)(\.\*|\[)?/gi

// Why an expression cannot be written with the variant's values, or `undefined` when it can.
//
// `fillExpression` writes `matrix.<key>` only. `matrix` alone, `matrix.*` and `matrix['key']` would be read against
// the generated workflow's matrix, which holds the runner, the leg and the tools. And a variant holds each value as
// text: `true` and `false` of the workflow file arrive as the texts `true` and `false`, and GitHub reads a text
// that is not empty as true and compares it with `true` as a number, so the written expression would decide
// otherwise than the original. `alone` is true where an expression that is one such key and nothing else gives the
// same text either way: every place but a condition.
const unwrittenExpression = (expression: string, variant: Variant, alone: boolean): string | undefined => {
  const outside = expression.split(/('(?:[^']|'')*')/).filter((_piece, at) => at % 2 === 0)
  for (const [, keys, after] of outside.flatMap((piece) => [...piece.matchAll(matrixRead)])) {
    if (keys === "" || after !== undefined) {
      return "an expression reads the matrix other than as matrix.<key>, and the matrix of this workflow holds other keys."
    }
    const key = (keys as string).slice(1).toLowerCase()
    const found = Object.keys(variant).find((held) => held.toLowerCase() === key)
    const value = found === undefined ? "" : variant[found]
    if ((value === "true" || value === "false") && !(alone && /^matrix\.[\w.-]+$/i.test(expression))) {
      return `an expression reads matrix.${key}, which is ${value} here: this workflow can write it only as text, ` +
        "which GitHub does not read as true or false."
    }
  }
  return undefined
}

// Why a kept step cannot be written for a variant, or `undefined` when it can.
const unwritten = (step: KeptStep, variant: Variant): string | undefined => {
  if (step.if !== undefined) {
    if (mixed(step.if)) return "its condition holds text beside a ${{ }}, which is no one expression."
    const why = unwrittenExpression(conditionOf(step.if), variant, false)
    if (why !== undefined) return why
  }
  const texts = [
    step.name,
    ...Object.values(step.with ?? {}),
    ...Object.values(step.env ?? {}),
    step.continueOnError,
    step.timeoutMinutes
  ].flatMap((text) => text === undefined ? [] : [text])
  for (const text of texts) {
    for (const [, expression] of split(expand(text, variant)).pieces) {
      const why = unwrittenExpression(expression, variant, true)
      if (why !== undefined) return why
    }
  }
  return undefined
}

// A text with each `${{ }}` given the variant's matrix values.
const fillText = (text: string, variant: Variant): string => {
  const { pieces, rest } = split(expand(text, variant))
  return pieces.map(([before, expression]) => `${before}\${{ ${fillExpression(expression, variant)} }}`).join("") +
    rest
}

// A condition, written with or without `${{ }}`, as an expression. GitHub reads an `if` as one expression and
// takes each `${{ }}` in it away, so each is written as the expression it holds, in brackets: an expression inside
// an expression is one GitHub refuses the whole workflow for.
//
// A condition with text beside a `${{ }}` has no such form that is sure to be read as it was (`run-${{ matrix.mode }}`
// would be written `run-('fast')`, which is no expression), so `keptRuns` leaves its step out (`mixed`).
const conditionOf = (text: string | undefined): string => {
  if (text === undefined) return "success()"
  const { pieces, rest } = split(text)
  const [only] = pieces
  if (pieces.length === 1 && only !== undefined && only[0].trim() === "" && rest.trim() === "") return only[1]
  return pieces.map(([before, expression]) => `${before}(${expression})`).join("") + rest
}

// True when a condition holds a `${{ }}` and text beside it.
const mixed = (text: string): boolean => {
  const { pieces, rest } = split(text)
  return pieces.length > 0 && (pieces.length > 1 || pieces.some(([before]) => before.trim() !== "") || rest.trim() !== "")
}

const filled = (values: Readonly<Record<string, string>>, variant: Variant): ReadonlyArray<Yaml.Entry> =>
  Object.entries(values).map(([name, held]) => Yaml.entry(name, fillText(held, variant)))

// A value GitHub reads as a boolean or a number where the step's own keys want one.
const typed = (text: string): Yaml.Value =>
  text === "true" || text === "false" ? text === "true" : /^[0-9]+$/.test(text) ? Number(text) : text

// The variant as a person reads it: ` (python 3.12)`, or nothing.
const variantName = (variant: Variant): string => {
  const values = Object.keys(variant).sort().map((key) => `${key} ${variant[key]}`)
  return values.length === 0 ? "" : ` (${values.join(", ")})`
}

// The variable the step before a kept one reads its job's kept checkout from.
const keptVariable = "SMTHRS_KEPT"

// The id of the step that puts a job's checkout in the workspace before the `order`th kept step of the workflow. A
// kept step's own id ends in `-` and a number, so the two never meet.
const restoreId = (order: number): string => `smthrs_files_${order}`

// What that step runs. Nothing is removed until the kept checkout is known to be there. The workspace's `.git`
// stays, and the kept checkout's goes over it: Smithers build gives a job's checkout the commit, the index and the
// refs, and has it read its objects from the workspace's store (`objects/info/alternates`). Removing that store
// would leave the kept checkout a history it cannot read.
const restore = [
  `if [ ! -d "$${keptVariable}" ]; then`,
  `  echo "::error::smithers-ci: this job's files were not kept:" \\`,
  `    "smthrs ci ended before it left them." >&2`,
  `  exit 1`,
  `fi`,
  `find "$GITHUB_WORKSPACE" -mindepth 1 -maxdepth 1 ! -name .git \\`,
  `  -exec rm -rf {} +`,
  `cp -a "$${keptVariable}/." "$GITHUB_WORKSPACE/"`,
  ``
].join("\n")

/**
 * The two steps that run one kept step at one place: the one that puts the
 * job's checkout in the runner's workspace, then the kept step. Both run
 * only on the matrix entry that runs the job's targets, under the kept
 * step's own condition, so `if: always()` still runs after a failed step.
 * The kept step runs only when the first one succeeded: under `always()` it
 * would otherwise send out whatever an earlier job left in the workspace,
 * under this job's name. `order` is the step's place among the workflow's
 * kept steps, which names the first step.
 *
 * The first step is a bash script on every runner, a Windows one too, and
 * reads the kept directory from its environment: the runner's temporary
 * directory is never part of the script's text, where a quote or a `$` in it
 * would be read as shell. When the run ended before it kept the job's
 * checkout, the step fails and leaves the workspace as it is.
 *
 * @category rendering
 * @since 0.1.0
 */
export const keptSteps = (
  step: KeptStep,
  place: KeptPlace,
  index: number,
  order: number
): ReadonlyArray<Yaml.Item> => {
  const { entry, job, variant } = place
  const own = fillExpression(conditionOf(step.if), variant)
  const condition = `\${{ ${entry} && (${own}) }}`
  const restored = `\${{ ${entry} && steps.${restoreId(order)}.outcome == 'success' && (${own}) }}`
  const where = `${job.id}${variantName(variant)}`
  const directory = keptDirectory(index)
  return [
    Yaml.item(Yaml.mapping([
      Yaml.entry("name", `Files of ${where}`),
      Yaml.entry("id", restoreId(order)),
      Yaml.entry("if", condition),
      Yaml.entry("shell", "bash"),
      Yaml.entry("run", restore),
      Yaml.entry("env", Yaml.mapping([Yaml.entry(keptVariable, directory)]))
    ])),
    Yaml.item(Yaml.mapping([
      Yaml.entry("name", `${step.name === undefined ? step.uses : fillText(step.name, variant)}: ${where}`),
      ...(step.id === undefined ? [] : [Yaml.entry("id", `${step.id}-${index}`)]),
      Yaml.entry("if", restored),
      Yaml.entry("uses", step.uses),
      ...(step.with === undefined ? [] : [Yaml.entry("with", Yaml.mapping(filled(step.with, variant)))]),
      ...(step.env === undefined ? [] : [Yaml.entry("env", Yaml.mapping(filled(step.env, variant)))]),
      ...(step.continueOnError === undefined
        ? []
        : [Yaml.entry("continue-on-error", typed(fillText(step.continueOnError, variant)))]),
      ...(step.timeoutMinutes === undefined
        ? []
        : [Yaml.entry("timeout-minutes", typed(fillText(step.timeoutMinutes, variant)))])
    ]))
  ]
}
