/**
 * What a script does on a machine where `sudo` refuses.
 *
 * A replay never runs `sudo`: every step finds a stand-in first that refuses.
 * A script written for machines with and without `sudo` asks before it uses
 * it, and ends when the answer is no:
 *
 *     if ! command -v sudo >/dev/null 2>&1 || ! sudo -n true 2>/dev/null; then
 *       echo "no sudo here; skipping"
 *       exit 0
 *     fi
 *     sudo tee /etc/apt/apt.conf.d/99-lock-timeout
 *
 * In a replay the answer is always no, so the script ends at `exit` and the
 * `sudo tee` never runs.
 *
 * This module does not read shell. It knows one shape, written out below, and
 * a script either starts with exactly that shape or is left as written. The
 * shape holds nothing a shell works out: no variable, no substitution, no
 * escape, no line that goes on at the next. Before it come only blank lines,
 * comments and `set` with the usual flags, so nothing has given `sudo`,
 * `exit` or `echo` another meaning. So bash reads the shape as this module
 * does, ends at its `exit`, and never reads what follows.
 *
 * An independent review found, twice, scripts that a reader of general shell
 * took for safe and bash ran to a `sudo`. A shape cannot be talked round.
 *
 * @since 0.1.0
 */

/** A blank line or a comment. */
const blank = String.raw`[ \t]*(?:#[^\n]*)?\n`

/** `set -e`, `set -euo pipefail`, `set -o errexit` and the like: the flags that only change how failures are met. */
const options = String.raw`[ \t]*set(?: [-+][euxo]+(?: (?:pipefail|errexit|nounset|xtrace))?)+[ \t]*\n`

/** Output sent nowhere, as a test that asks a question sends it. */
const quiet = String.raw`(?: (?:1?>|2>|&>) ?/dev/null| 2>&1)*`

/** The ways a script asks whether `sudo` works without a password. */
const question = String.raw`sudo (?:-n true|-n -v|--non-interactive true)`

/** A test that is true where `sudo` refuses: there is no `sudo`, or it does not work without a password. */
const test = String.raw`(?:! command -v sudo${quiet} \|\| )?! ${question}${quiet}`

/** Text a shell takes as written: quoted with nothing to expand inside, or bare words of plain characters. */
const text = String.raw`(?:"[^"$\x60\\\n]*"|'[^'\n]*'|[A-Za-z0-9_.,:/=@%+-]+)`

/** A line that says something, on either stream. */
const says = String.raw`[ \t]*echo(?: ${text})*(?: 1?>&2)?[ \t]*\n`

const shape = new RegExp(
  String.raw`^(?:${blank}|${options})*`
    + String.raw`[ \t]*if ${test}[ \t]*(?:;[ \t]*|\n[ \t]*)then[ \t]*\n`
    + String.raw`(?:${says}|${blank})*`
    + String.raw`[ \t]*exit(?: \d{1,3})?[ \t]*\n`
    + String.raw`[ \t]*fi[ \t]*(?:\n|$)`
)

/**
 * A script as it runs where `sudo` refuses. One that starts with the shape
 * above is that shape alone, with `false` where it asks: the rest never runs.
 * Any other script is returned as written.
 *
 * @category reading
 * @since 0.1.0
 */
export const withoutSudo = (script: string): string => {
  const [guard] = shape.exec(script) ?? []
  return guard === undefined ? script : guard.replace(new RegExp(question), "false")
}
