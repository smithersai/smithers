/**
 * Small readers for values that come out of YAML and JSON files.
 *
 * @since 0.1.0
 */

/**
 * True for a plain mapping.
 *
 * @category guards
 * @since 0.1.0
 */
export const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value)

/**
 * The text of a scalar, as a workflow runner would print it. A null is empty;
 * lists and mappings have no scalar text.
 *
 * @category readers
 * @since 0.1.0
 */
export const asScalar = (value: unknown): string | undefined => {
  if (typeof value === "string") return value
  if (typeof value === "number" || typeof value === "boolean") return String(value)
  return value === null ? "" : undefined
}

/**
 * The strings of a value that is one string or a list of strings. Anything
 * else is `undefined`.
 *
 * @category readers
 * @since 0.1.0
 */
export const asStrings = (value: unknown): ReadonlyArray<string> | undefined => {
  if (typeof value === "string") return [value]
  if (!Array.isArray(value)) return undefined
  const items: ReadonlyArray<unknown> = value
  return items.every((item) => typeof item === "string") ? items : undefined
}

/**
 * Quotes one word for a POSIX shell. A word with nothing special stays bare.
 *
 * @category readers
 * @since 0.1.0
 */
export const shellQuote = (word: string): string =>
  /^(?![#-])[\w@%+=:,./#-]+$/.test(word) ? word : `'${word.replaceAll("'", `'\\''`)}'`

/**
 * Quotes one word of a command that names a program and its flags, where a
 * leading dash is meant.
 *
 * @category readers
 * @since 0.1.0
 */
export const shellWord = (word: string): string => (/^-[\w-]+$/.test(word) ? word : shellQuote(word))

/** Commands the shell itself provides, which `sh` and `bash` do not run alike. */
const shellBuiltins = new Set(
  (". : [ alias bg bind break builtin caller cd command compgen complete continue declare dirs disown echo enable eval "
    + "exec exit export false fc fg getopts hash help history jobs kill let local logout mapfile popd printf pushd pwd "
    + "read readarray readonly return set shift shopt source suspend test times trap true type typeset ulimit umask "
    + "unalias unset wait").split(" ")
)

/**
 * True for a line that is a program and plain words, which `sh` and `bash`
 * run alike, so it needs no shell named around it.
 *
 * @category readers
 * @since 0.1.0
 */
export const isPlainCommand = (line: string): boolean =>
  /^[\w@%+=:,./ -]+$/.test(line) && !line.startsWith("-") && !shellBuiltins.has(line.split(" ")[0] as string)

/**
 * A directory relative to the repository root in its shortest form, the root
 * being empty. A directory outside the repository is `undefined`.
 *
 * @category readers
 * @since 0.1.0
 */
export const normalizeDirectory = (text: string): string | undefined => {
  if (text.startsWith("/")) return undefined
  const parts: Array<string> = []
  for (const part of text.split("/")) {
    if (part === "..") {
      if (parts.pop() === undefined) return undefined
    } else if (part !== "" && part !== ".") {
      parts.push(part)
    }
  }
  return parts.join("/")
}
