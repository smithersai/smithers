/**
 * The one kind of secret a job is read without: the credentials of a remote
 * build cache.
 *
 * A step that receives a secret is never run, because without the secret it
 * is not what its CI runs, and a tool that publishes falls back to the
 * credentials of whoever runs it. A remote build cache is different. GitHub
 * gives a pull request from a fork no secret, so the variable is empty there
 * and the job runs without that cache: the same commands, the same verdicts,
 * more work. A workflow is read as that run. The variable is set to the empty
 * string, no secret is passed or named as received, and the step lists the
 * variable in `withheld`, so the report can say the baseline ran without the
 * cache.
 *
 * @since 0.1.0
 */

import type { Job } from "../contract/Inventory.vibe"
import { isRecord } from "./Values.vibe"

/** The variables that hold nothing but the way into a remote build cache. */
const variables: ReadonlySet<string> = new Set([
  "TURBO_TOKEN",
  "TURBO_TEAM",
  "NX_CLOUD_ACCESS_TOKEN",
  "GRADLE_ENTERPRISE_ACCESS_KEY",
  "DEVELOCITY_ACCESS_KEY",
  "CACHIX_AUTH_TOKEN"
])

/** A value that is one secret and nothing else. */
const secretAlone = /^\s*\$\{\{\s*secrets\.[\w-]+\s*\}\}\s*$/

/**
 * True for a variable that only opens a remote build cache.
 *
 * @category secrets
 * @since 0.1.0
 */
export const isCacheCredential = (variable: string): boolean => variables.has(variable)

/** An `env:` mapping with each cache credential that comes from a secret set to nothing. */
const emptied = (env: unknown): unknown => {
  if (!isRecord(env)) return env
  const entries = Object.entries(env).map(([name, value]): [string, unknown] =>
    isCacheCredential(name) && typeof value === "string" && secretAlone.test(value) ? [name, ""] : [name, value]
  )
  return Object.fromEntries(entries)
}

const withEnv = (owner: unknown): unknown =>
  isRecord(owner) && owner["env"] !== undefined ? { ...owner, env: emptied(owner["env"]) } : owner

/**
 * A workflow with every cache credential that comes from a secret left
 * empty, in its own `env:`, each job's and each step's. Anything that is not
 * a workflow is returned as it is.
 *
 * @category secrets
 * @since 0.1.0
 */
export const leaveCacheEmpty = (workflow: unknown): unknown => {
  if (!isRecord(workflow) || !isRecord(workflow["jobs"])) return workflow
  const jobs = Object.entries(workflow["jobs"]).map(([key, job]): [string, unknown] => {
    const steps: unknown = isRecord(job) ? job["steps"] : undefined
    const read = withEnv(job)
    return [key, isRecord(read) && Array.isArray(steps) ? { ...read, steps: steps.map(withEnv) } : read]
  })
  return { ...(withEnv(workflow) as Record<string, unknown>), jobs: Object.fromEntries(jobs) }
}

/**
 * A job with `withheld` on each step that runs with a cache credential
 * empty: the names of those variables. A step that sets the variable itself,
 * to a plain value, is not one.
 *
 * @category secrets
 * @since 0.1.0
 */
export const markWithheld = (job: Job): Job => {
  const marked = job.steps.map((step) => {
    const withheld = Object.keys(step.env).filter((name) => isCacheCredential(name) && step.env[name] === "").sort()
    return withheld.length === 0 ? step : { ...step, withheld }
  })
  return marked.every((step, index) => step === job.steps[index]) ? job : { ...job, steps: marked }
}
