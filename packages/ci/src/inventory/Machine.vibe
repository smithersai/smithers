/**
 * Reads a repository's CI for the machine it is on: what `read` reads, with
 * each CI job this machine cannot run marked, so it is left out and listed.
 *
 * It looks for the tools the CI's setup actions stand for, on `PATH`, and
 * asks recognized binaries for their versions once per inventory. It asks
 * the package manager whether the packages a job installs are already there.
 * It installs nothing and changes nothing.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Inventory, Job } from "../contract/Inventory.vibe"
import type { ReadInventory } from "../contract/Parts.vibe"
import { answers, type Question, questionsFor, withInstalled } from "./MachineChanges.vibe"
import { validToolName } from "./Setup.vibe"
import { read } from "./Read.vibe"
import { type HostPath, hostPath, probeEnvironment } from "./HostPath.ts"
import {
  type Found,
  machinePath,
  type Machine,
  neededTools,
  onMachine,
  programsOf,
  runsOn,
  thisMachine,
  versionIn
} from "./Tools.ts"

/** How long a program may take to print its version. One that takes longer is on the machine, at no known version. */
const patience = "30 seconds"

interface Probe {
  readonly search: HostPath
  readonly head: string | undefined
  readonly patience: NonNullable<Machine["patience"]>
}

/** A version or package query can read machine configuration, but cannot inherit shell startup hooks. */
const shell = (probe: Probe, line: string, args: ReadonlyArray<string>) =>
  ChildProcess.make("/bin/bash", ["--noprofile", "--norc", "-c", line, "smithers-ci", ...args], {
    stdin: "ignore",
    cwd: "/",
    env: {
      PATH: probe.search.path,
      COREPACK_ENABLE_NETWORK: "0",
      ...probeEnvironment()
    },
    extendEnv: false
  })

/** These binaries implement a read-only version query. Other names may be located but are never invoked. */
const versioned = new Set([
  "node", "go", "python", "python3", "ruby", "bun", "uv", "just", "zig", "cargo", "clang", "java", "dotnet",
  "pnpm", "npm", "yarn", "terraform", "ghc", "Rscript", "xcodebuild", "rustc", "cmake", "nix", "brew", "deno"
])

const versionFlag = new Map([
  ["go", "version"], ["zig", "version"], ["java", "-version"], ["xcodebuild", "-version"]
])

/** Preserve argv[0] for multicall tools (e.g. a cargo symlink to rustup), and execute the checked target. */
const runProgram = 'name=$1; program=$2; head=$3; shift 3; '
const invoke = '(exec -a "$name" "$program" "$@")'
const limitOutput = (bytes: number) => `(exec -a head "$head" -c ${bytes})`

/** The first 4 KiB of a trusted program's version response. */
effect function printed(probe: Probe, program: string, executable: string, tool: string) {
  if (probe.head === undefined) return ""
  const spawner = try ChildProcessSpawner
  const line = `${runProgram}${invoke} 2>&1 | ${limitOutput(4096)}`
  const args = program === "docker" ? [tool, "version"] : [versionFlag.get(program) ?? "--version"]
  return timeout(spawner.string(shell(probe, line, [program, executable, probe.head, ...args])), probe.patience) catch () => ""
}

/** A new inventory samples this machine once per tool; a later inventory samples it again. */
effect function find(probe: Probe, tool: string, canProbe: boolean): (Found | undefined)!!ChildProcessSpawner {
  if (!validToolName(tool)) return undefined
  for (const program of programsOf(tool)) {
    if (!canProbe) return { program }
    const there = probe.search.program(program)
    if (there === undefined) continue
    if (!versioned.has(program) && tool !== "buildx" && tool !== "compose") return { program }
    return { program, version: versionIn(try printed(probe, program, there, tool)) }
  }
  return undefined
}

/** Whether the package manager succeeded and confirmed that this package is present. */
effect function installed(probe: Probe, question: Question) {
  const [name, ...args] = question.argv
  const executable = probe.search.program(name)
  if (executable === undefined || probe.head === undefined) return false
  const spawner = try ChildProcessSpawner
  const line = `${runProgram}set -o pipefail; out=$(${invoke} 2>/dev/null | ${limitOutput(65536)}) && printf "%s" "$out"`
  const output = timeout(spawner.string(shell(probe, line, [name, executable, probe.head, ...args])), probe.patience) catch () => ""
  return answers(question, output)
}

/**
 * The inventory as `machine` can run it. A job that does nothing to the
 * machine but install packages it already has runs without those steps
 * (`MachineChanges.withInstalled`). The rest is `Tools.onMachine` of what was
 * found there: it asks about a tool only when a CI job with a variant on the
 * machine's system sets it up.
 *
 * @category parts
 * @since 0.1.0
 */
export effect function onThisMachine(inventory: Inventory, machine: Machine = thisMachine(), root = ".") {
  const search = hostPath(root, machinePath(machine))
  const probe: Probe = { search, head: search.program("head"), patience: machine.patience ?? patience }
  const here = (job: Job) => runsOn(job, machine.host)
  const present = new Set<string>()
  for (const question of questionsFor(inventory, here)) {
    if (try installed(probe, question)) present.add(`${question.manager}\n${question.name}`)
  }
  const settled = withInstalled(inventory, here, (manager, name) => present.has(`${manager}\n${name}`))
  const found = new Map<string, Found>()
  const tools = neededTools(settled, machine.host)
  if (tools.length === 0) return onMachine(settled, machine.host, found)
  // A machine without a probe shell has reported nothing about which tools it lacks.
  const spawner = try ChildProcessSpawner
  const shellStatus = spawner.exitCode(shell(probe, ":", [])) catch () => undefined
  for (const tool of tools) {
    const have = try find(probe, tool, shellStatus !== undefined)
    if (have !== undefined) found.set(tool, have)
  }
  return onMachine(settled, machine.host, found)
}

/**
 * Reads the CI of the repository at `root` for this machine, with the
 * contract 10 type `ReadInventory`. A replay reads with it; `inventory` and
 * `apply` read with `read`, whose answer is the same on every machine.
 *
 * @category parts
 * @since 0.1.0
 */
export const readHere: ReadInventory<FileSystem.FileSystem | Path.Path | ChildProcessSpawner> = effect function (root) {
  return try onThisMachine(try read(root), undefined, root)
}
