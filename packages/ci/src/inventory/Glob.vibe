/**
 * The patterns `hashFiles` takes, for a cache key.
 *
 * On GitHub `hashFiles('**\/package-lock.json')` hashes the files the pattern
 * names in an order its runner decides, so its value cannot be worked out
 * anywhere else. A cache key does not have to be GitHub's, only the same from
 * one run to the next and another when a named file changes. So for a cache
 * step, and only there, a pattern is read: the files it names are hashed in
 * sorted order.
 *
 * A pattern is read as the action's glob reads it, as far as a cache key
 * needs: `*` and `?` within one name, `**` across directories, `[abc]`, a
 * leading `!` to leave files out, a directory for every file under it, and
 * several patterns as one list. Each becomes a regular expression over a
 * file's path from the repository root, which `grep -E` reads.
 *
 * @since 0.1.0
 */

/**
 * The files to hash. The last matching inclusion or exclusion decides whether
 * to hash a path. Both lists hold extended regular expressions over the whole path.
 *
 * @category models
 * @since 0.1.0
 */
export interface Files {
  readonly take: ReadonlyArray<string>
  readonly leave: ReadonlyArray<string>
  /** Written order when a later inclusion can override an exclusion. Negative indexes count exclusions from -1. */
  readonly order?: ReadonlyArray<number>
}

const special = /[.+^$(){}|\\]/

const escapeClassChar = (ch: string): string => (ch === "\\" ? "\\\\" : ch)

const characterClassOf = (body: string): string | "slash" | undefined => {
  const negated = body.startsWith("!") || body.startsWith("^")
  const rest = negated ? body.slice(1) : body
  if (rest.length === 0) return undefined
  let out = negated ? "^" : ""
  let i = 0
  let lastWasRange = false
  while (i < rest.length) {
    const ch = rest[i] as string
    if (ch === "[" && (rest[i + 1] === ":" || rest[i + 1] === "." || rest[i + 1] === "=")) return undefined
    if (ch === "-" && lastWasRange && i + 1 < rest.length) return undefined
    if (i + 2 < rest.length && rest[i + 1] === "-") {
      const hi = rest[i + 2] as string
      if (ch.charCodeAt(0) > hi.charCodeAt(0)) return undefined
      if (!negated && ch.charCodeAt(0) <= 47 && hi.charCodeAt(0) >= 47) return "slash"
      out += `${escapeClassChar(ch)}-${escapeClassChar(hi)}`
      i += 3
      lastWasRange = true
    } else {
      if (!negated && ch === "/") return "slash"
      out += escapeClassChar(ch)
      i += 1
      lastWasRange = false
    }
  }
  if (negated) {
    // Only a `-` that stands for itself moves behind the `/`: one that ends a range (`+--`) would start another.
    out = !lastWasRange && out.endsWith("-") ? `${out.slice(0, -1)}/-` : `${out}/`
  }
  return `[${out}]`
}

/**
 * The regular expression of one pattern, or `undefined` for a pattern that
 * names nothing inside the repository: an absolute path, `~`, or a path
 * through `..`. Sets that could match a directory separator are also refused.
 *
 * @category reading
 * @since 0.1.0
 */
export const regexOf = (pattern: string): string | undefined => {
  const path = pattern.replace(/^(?:\.\/)+/, "").replace(/\/+$/, "")
  if (path === "" || path.startsWith("/") || path.startsWith("~") || path.split("/").includes("..")) return undefined
  let regex = ""
  for (let at = 0; at < path.length; at += 1) {
    const char = path[at] as string
    const close = char === "[" ? path.indexOf("]", at + 1) : -1
    const charClass = close > 0 ? characterClassOf(path.slice(at + 1, close)) : undefined
    if (path.startsWith("**", at)) {
      const atBoundary = at === 0 || path[at - 1] === "/"
      while (path[at + 1] === "*") at += 1
      if (atBoundary && path[at + 1] === "/") {
        regex += "(.*/)?"
        at += 1
      } else regex += atBoundary && at + 1 === path.length ? ".*" : "[^/]*"
    } else if (char === "*") regex += "[^/]*"
    else if (char === "?") regex += "[^/]"
    else if (charClass === "slash") return undefined
    else if (charClass !== undefined) {
      regex += charClass
      at = close
    } else regex += special.test(char) || char === "[" || char === "]" ? `\\${char}` : char
  }
  // A directory names every file under it.
  return `^${regex}(/.*)?$`
}

/**
 * The files a list of patterns names, or `undefined` when one of them names
 * nothing inside the repository, or none of them takes a file. A pattern may
 * hold several, one to a line.
 *
 * @category reading
 * @since 0.1.0
 */
export const filesOf = (patterns: ReadonlyArray<string>): Files | undefined => {
  const take: Array<string> = []
  const leave: Array<string> = []
  const order: Array<number> = []
  let reincludes = false
  for (const line of patterns.flatMap((pattern) => pattern.split("\n")).map((entry) => entry.trim())) {
    if (line === "" || line.startsWith("#")) continue
    const regex = regexOf(line.replace(/^!/, ""))
    if (regex === undefined) return undefined
    if (line.startsWith("!")) order.push(-leave.push(regex))
    else {
      reincludes ||= leave.length > 0
      order.push(take.length)
      take.push(regex)
    }
  }
  return take.length === 0 ? undefined : { take, leave, ...(reincludes ? { order } : {}) }
}
