/**
 * The replay: runs past commits as the baseline, in normal mode and in fast
 * mode, each in its own copy of the repository, and compares every target's
 * verdict.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import type * as PlatformError from "effect/PlatformError"
import { type ChildProcessHandle, ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import {
  ci,
  type Inventory,
  type NotReplayed,
  notReplayed,
  refusal,
  shell,
  stepTimeoutHours
} from "../contract/Inventory.ts"
import type { Failure, GeneratedFile, ReplayParts, ReplayRequest } from "../contract/Parts.ts"
import type { NotReplayedCommit, ReplayCommit, ReplayReport } from "../contract/ReplayReport.ts"
import { type Mode, RunRecord, type TargetResult } from "../contract/RunRecord.ts"
import { defaultSettings, type Row } from "../contract/Selection.ts"
import { path as targetMapPath, TargetMap } from "../contract/TargetMap.ts"
import { check } from "../apply/index.ts"
import { refusal as ownWorkspace } from "../native/Workspace.ts"
import { noPushUrl, stepEnvironment, thisHost } from "./Environment.ts"
import {
  addRerun,
  blocked,
  choose,
  cycleIn,
  excludeLines,
  failure,
  firstAttempt,
  flakyOf,
  isBlocked,
  jobsFor,
  labelsOf,
  maxReruns,
  mismatchesOf,
  nothingToReplay,
  planOfPrinted,
  predictedSafe,
  PrintedPlan,
  recordOf,
  recovered,
  replayable,
  reportOf,
  selectionOf,
  splitOf,
  type Station,
  stationsOf,
  stepsThrough,
  targetsOf,
  totalsOf,
  type Unit,
  withoutCredentials
} from "./Summary.ts"

/** The cache directory, kept between commits. Smithers build never reads it as a source. */
const cacheDirectory = ".flows"
const outputLimit = 4000

/**
 * The host services a replay uses.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = ChildProcessSpawner | FileSystem.FileSystem | Path.Path

/**
 * How the replay runs on this machine. `smthrs` is the command that starts
 * Smithers build, `reruns` how often a failed target reruns, and `prepare`
 * makes the checkout the generated targets run in loadable, such as by
 * linking the package the generated files import. A baseline checkout is
 * never prepared: it is what a fresh clone is. `stepTimeout` is how long one
 * baseline step may run; without it the limit is the one generated targets
 * have (`Inventory.stepTimeoutHours`).
 *
 * @category services
 * @since 0.1.0
 */
export service Options {
  readonly smthrs: readonly [string, ...Array<string>]
  readonly reruns: number
  readonly prepare: (directory: string) => void!Failure
  readonly stepTimeout?: Duration.Input | undefined
  static readonly defaultValue = () => ({
    smthrs: ["smthrs"] as const,
    reruns: maxReruns,
    prepare: (_directory: string): void!Failure => Effect.void
  })
}

/**
 * Where a replay says what it is running: one line as each mode of each commit
 * starts, such as `2/5 3f2a1c9 baseline`. Silent unless provided.
 *
 * @category services
 * @since 0.1.0
 */
export service Progress {
  readonly say: (line: string) => void!!
  static readonly defaultValue = () => ({
    say: (_line: string): void!! => Effect.void
  })
}

/**
 * Runs the targets named, or every target when none are named.
 *
 * @category models
 * @since 0.1.0
 */
export type Execute<R> = (targets: ReadonlyArray<string> | undefined) => ReadonlyArray<TargetResult>!Failure!R

interface Output {
  readonly exitCode: number
  readonly text: string
}

interface Measured {
  readonly results: ReadonlyArray<TargetResult>
  readonly wallMs: number
}

/** What one commit's own CI gives the replay: the files to write, the units to run, and what is left out. */
interface Prepared {
  readonly inventory: Inventory
  readonly generated: ReadonlyArray<GeneratedFile>
  readonly units: ReadonlyArray<Unit>
  /** Every target of the units, each once. */
  readonly labels: ReadonlyArray<string>
  readonly splits: ReadonlyMap<string, ReadonlyArray<string>>
  readonly left: ReadonlyArray<NotReplayed>
  /** How many generated targets may run at once. */
  readonly jobs: number | undefined
}

/** A step that could not start, for example because its directory does not exist at this commit, failed. */
const noStart: Output = { exitCode: 127, text: "" }

/** The exit code of a step stopped at its time limit, as `timeout` reports it. */
const timedOut = 124

const describe = (cause: { readonly message: string }): string => cause.message

/**
 * Runs a command to its end, with end of file on its standard input. `env` is added to this process's environment.
 * With `step`, the command is a CI step: `env` is its whole environment, and it is stopped, and has failed, when it
 * runs longer than the limit.
 */
effect function exec(
  command: string,
  args: ReadonlyArray<string>,
  cwd: string,
  env: Readonly<Record<string, string | undefined>>,
  limit: number,
  output: (handle: ChildProcessHandle) => Stream.Stream<Uint8Array, PlatformError.PlatformError> = (handle) => handle.all,
  step: { readonly limit: Duration.Input } | undefined = undefined
) {
  const spawner = try ChildProcessSpawner
  return scoped(effect {
    const handle = try spawner.spawn(
      ChildProcess.make(command, [...args], {
        cwd,
        env: { ...env },
        extendEnv: step === undefined,
        stdin: "ignore",
        forceKillAfter: "5 seconds"
      })
    )
    const kept = try Ref.make("")
    const reader = fork (output(handle)
      |> Stream.decodeText(%)
      |> Stream.runForEach(%, (chunk: string) => Ref.update(kept, (text) => (text + chunk).slice(-limit))))
    const waited = step === undefined
      ? Option.some(try handle.exitCode)
      : try timeoutOption(handle.exitCode, step.limit)
    // Leaving the scope stops a step that is still running.
    if (Option.isNone(waited)) return { exitCode: timedOut, text: try Ref.get(kept) } satisfies Output
    const exitCode = waited.value
    // A process a step left running keeps the pipe open, so only complete output is waited for without a limit.
    if (limit === Number.POSITIVE_INFINITY) try Fiber.join(reader)
    else try timeoutOption(Fiber.await(reader), "1 second")
    return { exitCode: Number(exitCode), text: try Ref.get(kept) } satisfies Output
  }) catch effect (cause) => {
    throw failure("command-failed", `could not run ${command}: ${describe(cause)}`)
  }
}

effect function git(cwd: string, args: ReadonlyArray<string>) {
  const output = try exec("git", args, cwd, {}, Number.POSITIVE_INFINITY)
  if (output.exitCode !== 0) {
    throw failure("command-failed", `git ${args[0]} failed: ${output.text.slice(-outputLimit)}`)
  }
  return output.text
}

const lines = (text: string): ReadonlyArray<string> => text.split("\n").filter((line) => line !== "")

effect function checkout(copy: string, commit: string) {
  try git(copy, ["checkout", "--quiet", "--force", "--detach", commit])
  try git(copy, ["clean", "-ffdxq", "-e", cacheDirectory])
}

/**
 * Runs a first pass to its verdicts: each failed target reruns until it passes
 * or `reruns` runs out, and when a rerun passes, the targets that waited on it
 * run. `rounds` bounds how often that can repeat.
 *
 * @category internals
 * @since 0.1.0
 */
export effect function settle<R>(
  execute: Execute<R>,
  first: ReadonlyArray<TargetResult>,
  reruns: number,
  rounds: number
): ReadonlyArray<TargetResult>!Failure!R {
  let settled: ReadonlyArray<TargetResult> = first.map(firstAttempt)
  for (let rerun = 0; rerun < reruns; rerun++) {
    const failing = settled.filter((result) => result.status === "failed")
    if (failing.length === 0) break
    const again = new Map((try execute(failing.map((result) => result.label))).map((result) => [result.label, result]))
    settled = settled.map((result) => result.status === "failed" ? addRerun(result, again.get(result.label)) : result)
  }
  const waiting = settled.filter(isBlocked).map((result) => result.label)
  if (rounds === 0 || waiting.length === 0 || !settled.some(recovered)) return settled
  const ran = (try execute(waiting)).filter((result) => waiting.includes(result.label))
  const next = new Map((try settle(execute, ran, reruns, rounds - 1)).map((result) => [result.label, result]))
  return settled.map((result) => next.get(result.label) ?? result)
}

/**
 * Runs one way of running a commit and times it. The time holds `checkout`
 * and the first pass, which a CI machine spends too. It leaves out `equip`,
 * what only a replay does between the two, and the reruns that label flaky
 * targets.
 */
effect function measure<R>(
  checkout: void!Failure!R,
  equip: void!Failure!R,
  execute: Execute<R>,
  targets: ReadonlyArray<string> | undefined,
  reruns: number
) {
  const start = try Clock.currentTimeMillis
  try checkout
  const checkedOut = try Clock.currentTimeMillis
  try equip
  const equipped = try Clock.currentTimeMillis
  const first = try execute(targets)
  const wallMs = (try Clock.currentTimeMillis) - equipped + (checkedOut - start)
  const results = try settle(execute, first, reruns, first.length)
  return { results, wallMs } satisfies Measured
}

/**
 * Replays the last `request.commits` commits and reports.
 *
 * Each commit runs its own CI: the inventory is read, split and turned into
 * targets from that commit's own tree, so a commit that renamed a script or a
 * job is replayed with the names it had. The newest commit's CI must be
 * replayable. An older commit whose CI is not (it had none, or none of it
 * runs on this machine) is left out of the times and listed.
 *
 * The baseline runs the CI's steps as they are. The targets come from the CI
 * after `parts.decompose` split its steps, when the part is given, and a split
 * step's verdict is the combined verdict of its targets.
 *
 * Each baseline job gets a fresh checkout, as each gets its own machine in CI,
 * and jobs run at once unless `request.jobs` limits them. The jobs of one
 * shared tree (`Inventory.treeOf`: the recipes of a Justfile, the scripts of a
 * `package.json`) run one after another in one checkout, and the first failure
 * stops them. A baseline step gets a target's environment and time limit, and
 * its checkout holds nothing a fresh clone does not. Generated targets also
 * stay within the target map's `maxJobs`. Commits run oldest
 * first and the normal and fast copies keep their caches between commits, so
 * the first commit starts cold.
 *
 * Wall time is what a CI machine spends on the commit once it is ready: the
 * checkout, and the first pass, which for a mode holds the start of Smithers
 * build and its planning. What only a replay does is not counted: writing the
 * generated files into the copy, which `apply` commits once, and linking the
 * package they import. Neither are the reruns that label flaky targets.
 *
 * @category parts
 * @since 0.1.0
 */
export const run = <R>(request: ReplayRequest, parts: ReplayParts<R>): ReplayReport!Failure!(R | Host) =>
  scoped(effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const options = try Options
    const progress = try Progress
    effect function orFail<A, E extends { readonly message: string }, S>(work: A!E!S, what: string) {
      return work catch effect (cause) => {
        throw failure("command-failed", `${what}: ${describe(cause)}`)
      }
    }
    const work = try orFail(fs.makeTempDirectoryScoped({ prefix: "smithers-ci-replay-" }), "could not make a directory")
    const source = path.join(work, "source")
    const root = path.resolve(request.root)
    const cloned = try exec("git", ["clone", "--quiet", "--no-checkout", root, source], work, {}, outputLimit)
    if (cloned.exitCode !== 0) throw failure("not-a-repository", `${root} is not a git repository`)
    const head = try exec("git", ["rev-parse", "--verify", "--quiet", "HEAD"], source, {}, outputLimit)
    if (head.exitCode !== 0) throw failure("not-a-repository", `${root} is a git repository with no commit to replay`)
    const history = lines(try git(source, ["rev-list", "--first-parent", `--max-count=${request.commits}`, "HEAD"]))
    const commits = [...history].reverse()

    // A copy has the repository's directory name and remote, so a reader names it as it does in place.
    const origin = try exec("git", ["config", "--get", "remote.origin.url"], root, {}, outputLimit, (handle) => handle.stdout)

    /** A checkout of `commit` at `copy`. It fetches from the repository's remote and can push nowhere. */
    effect function cloneAt(copy: string, commit: string) {
      const noPush = ["--config", `remote.origin.pushurl=${noPushUrl}`]
      try git(work, ["clone", "--quiet", "--shared", "--no-checkout", ...noPush, source, copy])
      if (origin.exitCode === 0) try git(copy, ["remote", "set-url", "origin", withoutCredentials(origin.text)])
      try checkout(copy, commit)
    }

    effect function copyAt(name: string, commit: string) {
      const copy = path.join(work, name, path.basename(root))
      try cloneAt(copy, commit)
      return copy
    }

    const normalCopy = try copyAt("normal", "HEAD")

    /**
     * What the CI of the commit checked out in the normal copy gives the replay: read, split and generated from that
     * commit's own tree. It fails `unsupported` when nothing of that CI can be replayed on this machine.
     */
    effect function prepared(): Prepared!Failure!(R | Host) {
      const inventory: Inventory = try parts.read(normalCopy)
      const why = ownWorkspace(inventory) ?? refusal(inventory)
      if (why !== undefined) throw failure("unsupported", why)
      const narrowed = ci(inventory)
      const split = parts.decompose === undefined ? narrowed : try parts.decompose(normalCopy, narrowed)
      const generated = try parts.files(split, { cache: request.cache })
      // A commit can hold a link, or a file its owner wrote, where a generated file goes: nothing is written then.
      check(normalCopy, generated) catch effect (cause) => {
        throw failure("unsupported", cause.message)
      }
      const mapFile = generated.find((file) => file.path === targetMapPath)
      if (mapFile === undefined) throw failure("invalid-document", `the generated files have no ${targetMapPath}`)
      const targetMap = Schema.decodeUnknownEffect(Schema.fromJsonString(TargetMap))(mapFile.content) catch effect () => {
        throw failure("invalid-document", `${targetMapPath} is not a target map`)
      }
      // A variant for another system, and a job with a step that has no target, are left out and listed.
      const replayed = replayable(narrowed, targetMap, thisHost())
      const labels = [...new Set(targetsOf(replayed.units))]
      if (labels.length === 0) throw failure("unsupported", nothingToReplay(replayed.left))
      const cycle = cycleIn(replayed.units)
      if (cycle !== undefined) throw failure("invalid-document", `job ${cycle} needs itself`)
      return {
        inventory,
        generated,
        units: replayed.units,
        labels,
        splits: splitOf(replayed.units),
        left: [...notReplayed(inventory), ...replayed.left],
        jobs: jobsFor(request.jobs, targetMap.maxJobs)
      }
    }

    // The newest commit's CI must be replayable: it is what the repository runs today.
    const newest = try prepared()
    const fastCopy = request.modes.includes("fast") ? try copyAt("fast", "HEAD") : undefined

    /** Makes a checked-out copy one the generated targets run in. A repository that ran `apply` holds all of it. */
    effect function equip(copy: string, own: Prepared) {
      for (const file of own.generated) {
        const target = path.resolve(copy, file.path)
        try orFail(fs.makeDirectory(path.dirname(target), { recursive: true }), `could not write ${file.path}`)
        try orFail(fs.writeFileString(target, file.content), `could not write ${file.path}`)
      }
      try options.prepare(copy)
      // Everything untracked now is the replay's own: the generated files, the cache, what `prepare` linked. Listed in
      // the copy's exclude file, it leaves `git status` as clean as in the baseline's fresh clone.
      const untracked = try git(copy, ["ls-files", "--others", "--directory", "--exclude-per-directory=.gitignore", "-z"])
      const info = path.join(copy, ".git", "info")
      try orFail(fs.makeDirectory(info, { recursive: true }), "could not write .git/info/exclude")
      try orFail(fs.writeFileString(path.join(info, "exclude"), excludeLines(untracked)), "could not write .git/info/exclude")
    }

    let runs = 0
    const cacheEnv = request.cache === undefined ? {} : { SMITHERS_CACHE_URL: request.cache }

    effect function planOf(copy: string, own: Prepared) {
      const [command, ...prefix] = options.smthrs
      const args = [...prefix, "ci", ...own.labels, "--plan", "--format", "json", "--workspace", copy]
      const planned = try exec(command, args, copy, cacheEnv, Number.POSITIVE_INFINITY, (handle) => handle.stdout)
      const printed = Schema.decodeUnknownEffect(Schema.fromJsonString(PrintedPlan))(planned.text) catch effect () => {
        throw failure("command-failed", `smthrs ci --plan printed no plan: ${planned.text.slice(-outputLimit)}`)
      }
      return planOfPrinted(printed)
    }

    const smithers = (copy: string, own: Prepared): Execute<Host> => (targets) => effect {
      const selected = targets ?? own.labels
      if (selected.length === 0) return []
      runs += 1
      const file = path.join(work, `run-${runs}.json`)
      const [command, ...prefix] = options.smthrs
      const args = [
        ...prefix,
        "ci",
        ...selected,
        "--workspace",
        copy,
        "--cache-dir",
        cacheDirectory,
        "--results-file",
        file,
        "--ui",
        "plain",
        ...(own.jobs === undefined ? [] : ["--jobs", String(own.jobs)])
      ]
      const output = try exec(command, args, copy, cacheEnv, outputLimit)
      const unreadable = () => failure("command-failed", `smthrs ci wrote no run record: ${output.text}`)
      const text = fs.readFileString(file) catch effect () => {
        throw unreadable()
      }
      const record = Schema.decodeUnknownEffect(Schema.fromJsonString(RunRecord))(text) catch effect () => {
        throw unreadable()
      }
      return record.results
    }

    const stepLimit = options.stepTimeout ?? Duration.hours(stepTimeoutHours)

    /**
     * One run of the baseline: its units' steps in order in one fresh checkout, named as the repository is. A step
     * that fails blocks every step after it.
     */
    effect function runSequence(sequence: ReadonlyArray<Unit>, commit: string, wanted: ReadonlySet<string> | undefined) {
      return try scoped(effect {
        const directory = try orFail(fs.makeTempDirectoryScoped({ directory: work }), "could not make a directory")
        const copy = path.join(directory, path.basename(root))
        try cloneAt(copy, commit)
        const results: Array<TargetResult> = []
        let failed: string | undefined = undefined
        for (const step of stepsThrough(sequence, wanted)) {
          if (failed !== undefined) {
            results.push(blocked(step.label, failed))
            continue
          }
          const start = try Clock.currentTimeMillis
          const argv = [...shell.slice(1), step.command]
          const environment = stepEnvironment(step.env)
          const output = exec(shell[0], argv, path.join(copy, step.cwd), environment, outputLimit, undefined, {
            limit: stepLimit
          }) catch () => noStart
          const durationMs = (try Clock.currentTimeMillis) - start
          const passed = output.exitCode === 0
          results.push({ label: step.label, status: passed ? "ran" : "failed", key: "", durationMs })
          if (!passed) failed = step.label
        }
        return wanted === undefined ? results : results.filter((result) => wanted.has(result.label))
      })
    }

    const baseline = (commit: string, own: Prepared): Execute<Host> => (targets) => effect {
      const wanted = targets === undefined ? undefined : new Set(targets)
      const chosen = stationsOf(own.units, wanted)
      const atOnce = chosen.reduce((total, station) => total + station.runs.length, 0)
      const limit = try Semaphore.make(Math.max(1, request.jobs ?? atOnce))
      const plan: Array<Station & { readonly gate: Deferred.Deferred<boolean> }> = []
      for (const station of chosen) plan.push({ ...station, gate: try Deferred.make<boolean>() })
      const collected: Array<TargetResult> = []
      for concurrent (const station of plan) {
        let needsPassed = true
        for (const need of plan.filter((other) => other.jobs.some((job) => station.needs.includes(job)))) {
          needsPassed = (try Deferred.await(need.gate)) && needsPassed
        }
        const results: Array<TargetResult> = []
        for concurrent (const sequence of station.runs) {
          if (needsPassed) {
            results.push(...(try limit.withPermits(1)(runSequence(sequence, commit, wanted))))
          } else {
            const waiting = sequence.flatMap((unit) => labelsOf(unit, wanted))
            results.push(...waiting.map((label) => blocked(label, station.needs.join(", "))))
          }
        }
        collected.push(...results)
        try Deferred.succeed(station.gate, needsPassed && results.every((result) => result.status === "ran"))
      }
      return collected
    }

    const commitsDone: Array<ReplayCommit> = []
    const commitsLeft: Array<NotReplayedCommit> = []
    const allRows: Array<Row> = []
    let flaky = 0
    const selected = new Map<string, ReadonlyArray<string>>()

    /**
     * An older commit's own CI, read from its own tree. A commit whose CI cannot be replayed, because it had none or
     * because none of it runs here, is not a failed replay: the reason is kept and the commit is listed.
     */
    effect function preparedAt(commit: string) {
      try checkout(normalCopy, commit)
      return prepared() catch effect (cause) => {
        if (cause.code !== "unsupported" && cause.code !== "invalid-document") throw cause
        return { reason: cause.message }
      }
    }

    for (const [index, commit] of commits.entries()) {
      const at = `${index + 1}/${commits.length} ${commit.slice(0, 7)}`
      const own = index === commits.length - 1 ? newest : try preparedAt(commit)
      if ("reason" in own) {
        try progress.say(`${at} not replayed`)
        commitsLeft.push({ commit, reason: own.reason })
        continue
      }
      const changed = lines(try git(source, ["show", "--format=", "--name-only", "--diff-merges=first-parent", commit]))
      try progress.say(`${at} baseline`)
      const base = try measure(Effect.void, Effect.void, baseline(commit, own), undefined, options.reruns)
      const baseRecord = recordOf(base.results, commit, base.wallMs)
      try progress.say(`${at} normal`)
      const normal = try measure(
        checkout(normalCopy, commit),
        equip(normalCopy, own),
        smithers(normalCopy, own),
        undefined,
        options.reruns
      )
      const normalRecord = recordOf(normal.results, commit, normal.wallMs, "normal")
      let fastPart: Pick<ReplayCommit, "fast"> = {}
      let fastMismatches: ReturnType<typeof mismatchesOf> = []
      flaky += flakyOf([baseRecord, normalRecord])
      if (fastCopy !== undefined) {
        const rows = try parts.rows(normalCopy, normalRecord, try planOf(normalCopy, own))
        const scores = try parts.score(rows)
        const choice = choose(scores, request.settings ?? defaultSettings)
        const labels = normal.results.map((result) => result.label).filter((label) => !choice.skipped.has(label))
        try progress.say(`${at} fast`)
        const fast = try measure(
          checkout(fastCopy, commit),
          equip(fastCopy, own),
          smithers(fastCopy, own),
          labels,
          options.reruns
        )
        const byLabel = new Map(fast.results.map((result) => [result.label, result]))
        const merged = normal.results.map((result) => byLabel.get(result.label) ?? predictedSafe(result.label))
        const fastRecord = recordOf(merged, commit, fast.wallMs, "fast" satisfies Mode)
        fastPart = { fast: totalsOf(fastRecord) }
        fastMismatches = mismatchesOf("fast", baseRecord, fastRecord, own.splits)
        flaky += flakyOf([fastRecord])
        allRows.push(...rows)
        selected.set(commit, choice.selected)
      }
      commitsDone.push({
        commit,
        changedFiles: changed.length,
        baseline: totalsOf(baseRecord),
        normal: totalsOf(normalRecord),
        mismatches: [...mismatchesOf("normal", baseRecord, normalRecord, own.splits), ...fastMismatches],
        ...fastPart
      })
    }
    return reportOf(newest.inventory, commitsDone, {
      selection: fastCopy === undefined ? undefined : selectionOf(allRows, selected),
      left: newest.left,
      flaky,
      commitsLeft
    })
  })
