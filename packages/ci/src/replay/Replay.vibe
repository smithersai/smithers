/**
 * Where Node keeps the compiled code of `smthrs` between runs, in the
 * directory Smithers build keeps its cache in: a later run starts sooner.
 * The generated workflow names the same directory and carries it from one
 * run to the next, so a replay starts `smthrs` as that workflow does.
 *
 * @category constants
 * @since 0.1.0
 */
export const compiledCode = "node-compile-cache"

/**
 * Where a `smthrs` that runs from source keeps what it compiled of itself
 * in a jail, in the directory Smithers build keeps its cache in, beside the
 * copy. In the jail `/tmp` is the mode's own, which it finds empty at every
 * commit, as a CI run does, and the person's own compiled code is in sight
 * but cannot be written: every start would compile `smthrs` again. With no
 * jail `smthrs` keeps it where the person's own `smthrs` does, so a replay
 * compiles nothing the person's machine has compiled before. An installed
 * `smthrs` compiles nothing either way.
 *
 * @category constants
 * @since 0.1.0
 */
export const compiledSource = "vibelang-cache"

/**
 * Where a `smthrs` started for a mode keeps its compiled code, given the
 * directory Smithers build keeps the mode's cache in and whether the mode
 * runs in a jail: Node's always in that directory ({@link compiledCode}),
 * and its own there only in a jail ({@link compiledSource}).
 *
 * @category constructors
 * @since 0.1.0
 */
export const compiledCaches = (cache: string, jailed: boolean): Readonly<Record<string, string>> => ({
  NODE_COMPILE_CACHE: `${cache}/${compiledCode}`,
  ...(jailed ? { VIBELANG_CACHE_DIR: `${cache}/${compiledSource}` } : {})
})

/**
 * The host services a replay uses.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = ChildProcessSpawner | FileSystem.FileSystem | Path.Path

/**
 * How the replay runs on this machine. `smthrs` is the command that starts
 * Smithers build, `reruns` how often a failed target reruns when the request
 * names no number, and `prepare`
 * runs before the generated targets do, with the directory that holds the
 * workspace file, and fails when this machine cannot run them. For a generated
 * workspace file that is a directory of the replay's own, beside the checkout.
 * Nothing is put into a checkout, a step would find it there: each is what a
 * fresh clone is. `stepTimeout` is how long one
 * baseline step may run; without it the limit is the one generated targets
 * have (`Inventory.stepTimeoutHours`). `confine` says whether this machine can
 * hold a step in a file-system jail; without it the machine is asked. `cores`
 * is how many baseline jobs run at once when the request sets no limit; without
 * it, the machine's core count. `processes` is where a step's processes are
 * read and stopped, and `cpuTick` how often they are read for the CPU time
 * the steps use. `environment` holds the variables of the person who runs
 * the replay, which the program keeps out of its own process; without it they
 * are read from the process. `smthrsWithToken` starts Smithers build as
 * `smthrs` does and reads the token of the shared cache from its standard input;
 * without it the replay's Smithers build gets no token.
 *
 * @category services
 * @since 0.1.0
 */
export service Options {
  readonly smthrs: readonly [string, ...Array<string>]
  readonly reruns: number
  readonly prepare: (directory: string) => void!Failure
  readonly stepTimeout?: Duration.Input | undefined
  readonly confine?: (() => Probe) | undefined
  readonly cores?: number | undefined
  readonly processes?: Table | undefined
  readonly cpuTick?: Duration.Input | undefined
  readonly environment?: Readonly<Record<string, string | undefined>> | undefined
  readonly smthrsWithToken?: readonly [string, ...Array<string>] | undefined
  static readonly defaultValue = () => ({
    smthrs: ["smthrs"] as const,
    reruns: maxReruns,
    prepare: (_directory: string): void!Failure => Effect.void
  })
}

/**
 * Where a replay says what it is running: one line as each mode of each commit
 * starts, such as `2/5 3f2a1c9 baseline`. Silent unless provided.
 *
 * @category services
 * @since 0.1.0
 */
export service Progress {
  readonly say: (line: string) => void!!
  static readonly defaultValue = () => ({
    say: (_line: string): void!! => Effect.void
  })
}

/**
 * Runs the targets named, or every target when none are named.
 *
 * @category models
 * @since 0.1.0
 */
export type Execute<R> = (targets: ReadonlyArray<string> | undefined) => ReadonlyArray<TargetResult>!Failure!R

interface Measured {
  readonly results: ReadonlyArray<TargetResult>
  readonly wallMs: number
  /** The CPU time the first pass's steps used, when their processes could be read. */
  readonly cpuMs: number | undefined
}

/**
 * Says which run the steps that start from now on belong to: their CPU time
 * is added to its bucket. With `undefined` they belong to none.
 *
 * @category models
 * @since 0.1.0
 */
export type Counting = (bucket: CpuBucket | undefined) => void

/** What one commit's own CI gives the replay: the files to write, the units to run, and what is left out. */
interface Prepared {
  readonly inventory: Inventory
  /** The generated workspace file, which Smithers build is pointed at. */
  readonly declaration: GeneratedFile
  /** Files an earlier smithers-ci wrote, which this commit holds where Smithers build would read them too. */
  readonly former: ReadonlyArray<string>
  /** The files `apply` writes into the repository, and whether this commit lacks one: `apply` was not run on it. */
  readonly generated: ReadonlyArray<GeneratedFile>
  readonly applies: boolean
  readonly units: ReadonlyArray<Unit>
  /** Every target of the units, each once. */
  readonly labels: ReadonlyArray<string>
  readonly splits: ReadonlyMap<string, ReadonlyArray<string>>
  readonly left: ReadonlyArray<NotReplayed>
  /** How many generated targets may run at once. */
  readonly jobs: number | undefined
}

/** The run in the copy that holds the files `apply` writes: the commit its steps see, and why a step failed there. */
interface Applied {
  readonly seen: string
  readonly causes: Map<string, string>
}

/**
 * Where one mode runs a commit: its copy of the repository, and, beside the copy and never in it, the directory
 * Smithers build keeps its cache in and the directory of the generated workspace file.
 */
interface Site {
  readonly copy: string
  readonly place: Confined
  readonly cache: string
  readonly declared: string
}

/**
 * Runs a first pass to its verdicts: each failed target reruns until it passes
 * or `reruns` runs out, and when a rerun passes, the targets that waited on it
 * run. `rounds` bounds how often that can repeat. A target that failed as it
 * did in the run before (`last`) is not run again: twice the same is broken.
 * `tally` gains how many targets ran again and how long that took.
 *
 * @category internals
 * @since 0.1.0
 */
export effect function settle<R>(
  execute: Execute<R>,
  first: ReadonlyArray<TargetResult>,
  reruns: number,
  rounds: number,
  last: ReadonlyMap<string, string> = new Map(),
  tally: RerunTally = { count: 0, ms: 0 }
): ReadonlyArray<TargetResult>!Failure!R {
  let settled: ReadonlyArray<TargetResult> = first.map(firstAttempt)
  // A `while`, not `for (let rerun = 0; ...)`: V8's coverage gives the statements after a `for (let ...)` loop the
  // count of the loop's body (Node 26.5: a function called 14 times whose loop body ran 32 times reports 32 for the
  // line after the loop). The `if` below then has "returned" more often than "reached", its other arm goes negative,
  // and the suite reads one branch as never taken though every arm runs.
  let rerun = 0
  while (rerun < reruns) {
    rerun += 1
    // A step stopped for making no progress would only wait as long again.
    const failing = new Set(
      settled.filter((result) => result.status === "failed" && !madeNoProgress(result) && !failedAsBefore(last, result))
        .map((result) => result.label)
    )
    if (failing.size === 0) break
    const start = try Clock.currentTimeMillis
    const again = new Map((try execute([...failing])).map((result) => [result.label, result]))
    tally.count += failing.size
    tally.ms += (try Clock.currentTimeMillis) - start
    settled = settled.map((result) => failing.has(result.label) ? addRerun(result, again.get(result.label)) : result)
  }
  const waiting = settled.filter(isBlocked).map((result) => result.label)
  if (rounds === 0 || waiting.length === 0 || !settled.some(recovered)) return settled
  const ran = (try execute(waiting)).filter((result) => waiting.includes(result.label))
  const next = new Map((try settle(execute, ran, reruns, rounds - 1, last, tally)).map((result) => [result.label, result]))
  return settled.map((result) => next.get(result.label) ?? result)
}

/**
 * Runs one way of running a commit and times it. The time holds `checkout`
 * and the first pass, which a CI machine spends too. It leaves out `equip`,
 * what only a replay does between the two, and the reruns that label flaky
 * targets. `last` holds what the way's steps failed with in its run before,
 * and afterwards what they failed with in this one. The CPU time of the first
 * pass's steps is counted, through `counting`, and of nothing else.
 */
effect function measure<R>(
  checkout: void!Failure!R,
  equip: void!Failure!R,
  execute: Execute<R>,
  targets: ReadonlyArray<string> | undefined,
  reruns: number,
  last: LastFailures,
  tally: RerunTally,
  counting: Counting = () => undefined
) {
  const start = try Clock.currentTimeMillis
  try checkout
  const checkedOut = try Clock.currentTimeMillis
  try equip
  const equipped = try Clock.currentTimeMillis
  const used: CpuBucket = { ms: 0, seen: false }
  counting(used)
  const first = try ensuring(execute(targets), sync(() => counting(undefined)))
  const wallMs = (try Clock.currentTimeMillis) - equipped + (checkedOut - start)
  const results = try settle(execute, first, reruns, first.length, last, tally)
  remember(last, results)
  return { results, wallMs, cpuMs: usedBy(used) } satisfies Measured
}

/**
 * The scores of one commit's rows, or, when the model cannot answer, the
 * reason as text. Any other failure stays a failure.
 *
 * @category internals
 * @since 0.1.0
 */
export effect function scoresOrReason<R>(score: ScoreRows<R>, rows: ReadonlyArray<Row>) {
  return score(rows) catch effect (cause) => {
    if (cause.code !== "model-unavailable") throw cause
    return cause.message
  }
}

/**
 * Replays the last `request.commits` commits and reports.
 *
 * Each commit runs its own CI: the inventory is read, split and turned into
 * targets from that commit's own tree, so a commit that renamed a script or a
 * job is replayed with the names it had. The newest commit's CI must be
 * replayable. An older commit whose CI is not (it had none, or none of it
 * runs on this machine) is left out of the times and listed.
 *
 * The baseline runs the CI's steps as they are. The targets come from the CI
 * after `parts.decompose` split its steps, when the part is given, and a split
 * step's verdict is the combined verdict of its targets.
 *
 * Each baseline job gets a fresh checkout, as each gets its own machine in CI.
 * At most as many jobs run at once as normal mode runs targets: `request.jobs`,
 * never above the target map's `maxJobs`, and the machine's core count when
 * neither says. The jobs of one shared tree (`Inventory.treeOf`: the recipes of a Justfile, the scripts of a
 * `package.json`) run one after another in one checkout, and the first failure
 * stops them. A baseline step gets a target's environment and time limit, and
 * its checkout holds nothing a fresh clone does not. Every step, baseline or
 * target, gets a home and a temporary directory the replay made, a `git` that
 * refuses to push, and, where the machine can hold one, the same file-system
 * jail: it can write its checkout, that home and that directory, and cannot
 * read the person's credentials. Generated targets also
 * stay within the target map's `maxJobs`. Commits run oldest
 * first and normal and fast mode keep their caches between commits.
 *
 * With `request.warm`, every way first runs once at the parent of the oldest
 * commit, in its own home, and fills what it keeps from one commit to the
 * next: its cache and what its steps save for a later run. A job's home is
 * empty at every run, so a tool's own cache there is not carried over. A CI
 * run has what the run before it kept, so the
 * first counted commit starts as one does. That run is in no time but
 * `ReplayReport.firstRun`, and a mode's failure in it is no failure of the
 * replay. When the oldest commit has no commit before it, or that commit has
 * no CI that runs here, the first counted commit starts with an empty cache
 * and the report says why (`ReplayReport.cold`).
 *
 * With `request.trial`, the baseline's first run finds the jobs that cannot
 * pass on this machine: the warm run at the parent, or, when there is none, a
 * run at the oldest commit in a home and a store of its own, which warms
 * nothing a counted run reads. A job that fails it runs once more, at the
 * newest commit. One that fails again is left out at every commit and listed
 * (`Inventory.failsHere`) with its step, its exit code, the first line of
 * its error and both commits; one that passes was flaky or broken at that one
 * commit, and stays. When the first run leaves out half or more of the jobs
 * that could run here, the replay fails `unsupported` with each of them and
 * its reason: a speedup over the rest would not be this CI's.
 *
 * A copy holds the commit's files and nothing else. What Smithers build keeps
 * between commits (its cache, and the compiled code of `smthrs`), the
 * generated workspace file and the run records are in the replay's own
 * directory, beside the copies, and Smithers build is pointed at them. No
 * ignore line, exclude entry or index bit hides anything: a step that lists
 * its checkout, by any means, sees what a fresh clone holds.
 *
 * After `apply` the repository holds the generated files, committed. With
 * `request.applied` the newest commit runs once more, in normal mode, in a
 * copy of its own made as `apply` leaves the repository: the files written
 * and committed, as one commit in the replayed commit's place, with its
 * parents, message, author and dates: the commit a person pushes after
 * `apply`, which every step of that run is given as its commit. A step that
 * passed and fails there is a mismatch of normal
 * mode at that commit, and says why (`Mismatch.cause`): which tool read
 * which file as one of the repository's own, or that the step fails once
 * those files are committed. A step that read none of them is answered from
 * the cache. The run's time is `ReplayReport.appliedMs` and is in no way's
 * time: `apply` is run once, by a person.
 *
 * The baseline, normal mode and fast mode each have a home and a temporary
 * directory of their own. No way is timed with a cache another way paid for.
 * A baseline job is a machine: beside its fresh checkout it has a home and a
 * temporary directory nothing else wrote to, empty when its first step starts
 * and removed when its last step ends, as each job of a workflow starts on a
 * runner of its own. A mode finds its home and its temporary directory empty
 * at every commit, as a CI run does, and the targets of each GitHub job name
 * a machine (`StepTarget.machine`): Smithers build runs them in a copy of the
 * checkout, a home and a temporary directory of the job's own, made when a
 * step of the job has to run and removed with the run. A tool that keeps a
 * cache for its user, as Zig, Go and every package manager do, so fills it
 * again in every job that runs, in each way, as it does in CI. What a mode
 * keeps between commits is in its copy's cache directory.
 *
 * Wall time is what a CI machine spends on the commit once it is ready: the
 * checkout, and the first pass, which for a mode holds the start of Smithers
 * build and its planning. What only a replay does is not counted: writing the
 * generated workspace file, which `apply` commits once. Neither are the
 * reruns that label flaky targets.
 *
 * A failed step runs again `request.reruns` times, or as often as the host
 * sets, until it passes. A step that fails with the exit code and first error
 * line it failed with in the same way's run of the commit before, or in the
 * first run, is not run again: twice the same is broken. The report says how
 * many steps ran again and how long that took (`ReplayReport.reruns`).
 *
 * The CPU time of each way's steps is in the report beside its wall time
 * (`RunTotals.cpuMs`), for the same run the wall time covers. A step's CPU
 * time does not reach the program that started it, so the machine's
 * processes are read while the step runs, and every process under the step
 * is counted for itself. On a machine whose processes cannot be read the
 * report has no CPU time.
 *
 * When the model fast mode needs stops answering, the baseline and normal mode
 * still run for every commit, fast mode runs for no further commit, and the
 * report holds no fast-mode number and says why (`fastNotMeasured`).
 *
 * Every failed step is reported with its name, exit code and the first line of
 * its error output. When no step passes in the baseline of any commit, the
 * replay fails `unsupported` with the newest commit's first failure: the CI
 * does not run on this machine.
 *
 * @category parts
 * @since 0.1.0
 */
export const run = <R>(request: ReplayRequest, parts: ReplayParts<R>): ReplayReport!Failure!(R | Host) =>
  scoped(effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const options = try Options
    const progress = try Progress
    const work = try orFail(fs.makeTempDirectoryScoped({ prefix: "smithers-ci-replay-" }), "could not make a directory")
    const source = path.join(work, "source")
    const root = path.resolve(request.root)
    // The variables of the person who runs the replay. The token of the shared cache `--cache` names is one: it
    // reaches Smithers build alone, on a pipe.
    const person = options.environment ?? ambientEnvironment()
    const token = request.cache === undefined ? undefined : person["SMITHERS_CACHE_TOKEN"]
    // Without the person's word, no step reaches a container daemon and no job that starts one is replayed.
    const allowDocker = request.allowDocker === true
    // Each way has a home of its own: none finds a cache another way filled.
    const places = try orFail(
      confine(
        work,
        options.confine ?? probeWith,
        progress.say,
        [...options.smthrs, ...(options.smthrsWithToken ?? []), ...searchPath()],
        allowDocker,
        person,
        root
      ),
      "could not make the steps' homes"
    )
    // Where `smthrs` writes its run records: the one place it can write that a step run on its own cannot.
    const records = path.join(work, "records")
    try orFail(fs.makeDirectory(records), "could not make a directory")
    // Where a baseline step keeps files from one run to the next, as a cache step does: outside every checkout and
    // every home, so a job that starts on a new machine finds what an earlier commit's job saved. A target keeps
    // them in the cache directory of its own copy, so each way of running a commit has a store of its own.
    const kept = path.join(work, "kept")
    try orFail(fs.makeDirectory(kept), "could not make a directory")
    // The run that only finds what passes here has a store of its own: it saves nothing a counted run restores.
    const keptTrial = path.join(work, "kept-trial")
    try orFail(fs.makeDirectory(keptTrial), "could not make a directory")
    const cloned = try exec("git", ["clone", "--quiet", "--no-checkout", root, source], work, {}, outputLimit)
    if (cloned.exitCode !== 0) throw failure("not-a-repository", `${root} is not a git repository`)
    const head = try exec("git", ["rev-parse", "--verify", "--quiet", "HEAD"], source, {}, outputLimit)
    if (head.exitCode !== 0) throw failure("not-a-repository", `${root} is a git repository with no commit to replay`)
    const history = lines(try git(source, ["rev-list", "--first-parent", `--max-count=${request.commits}`, "HEAD"]))
    const commits = [...history].reverse()

    // A copy has the repository's directory name and remote, so a reader names it as it does in place.
    const origin = try originOf(root)

    /** Checks `commit` out in `copy` and removes every file the commit does not hold: nothing of ours is there. */
    const checkout = (copy: string, commit: string, place: Confined) => checkoutAt(copy, commit, place, [])

    /**
     * A checkout of `commit` at `copy`, for the steps of `place`. It fetches from the repository's remote and can
     * push nowhere.
     */
    effect function cloneAt(copy: string, commit: string, place: Confined) {
      try cloneCopy(work, source, copy, origin)
      try checkout(copy, commit, place)
    }

    /**
     * Where a mode runs: its copy at `commit`, and beside it the two directories of the replay's own that
     * Smithers build is pointed at, so the copy holds the commit's files and nothing else.
     */
    effect function siteAt(way: Way, commit: string) {
      const copy = path.join(work, way, path.basename(root))
      try cloneAt(copy, commit, places[way])
      // Not under `kept`, which a baseline step may write: no way reads what another way keeps.
      const cache = path.join(work, "state", way)
      const declared = path.join(work, "declared", way)
      try orFail(fs.makeDirectory(cache, { recursive: true }), "could not make a directory")
      try orFail(fs.makeDirectory(declared, { recursive: true }), "could not make a directory")
      return { copy, place: places[way], cache, declared } satisfies Site
    }

    const normal = try siteAt("normal", "HEAD")
    const normalCopy = normal.copy
    const spawner = try ChildProcessSpawner
    /**
     * Runs a part on the normal copy, which the targets wrote: every `git` the part starts there runs as a step
     * does, in the jail, so a command a step left in the copy's `.git/config` never runs outside it.
     */
    effect function onNormalCopy<A, E, S>(part: A!E!S) {
      provide ChildProcessSpawner = reading(spawner, places.normal, normalCopy) {
        return try part
      }
    }

    // What the first run found does not pass on this machine.
    const failedHere: Array<FailedHere> = []

    /**
     * What the CI of the commit checked out in the normal copy gives the replay: read, split and generated from that
     * commit's own tree. It fails `unsupported` when nothing of that CI can be replayed on this machine.
     */
    effect function prepared(): Prepared!Failure!(R | Host) {
      const read: Inventory = try onNormalCopy(parts.read(normalCopy))
      const inventory = withoutFailedHere(allowDocker ? allowingDocker(read) : read, failedHere)
      const why = ownWorkspace(inventory) ?? refusal(inventory)
      if (why !== undefined) throw failure("unsupported", why)
      const narrowed = ci(inventory)
      const split = parts.decompose === undefined
        ? narrowed
        : try onNormalCopy(parts.decompose(normalCopy, narrowed))
      // A target passes on what tells git to refuse a push, as the baseline's step is told, and with Docker allowed
      // where the person's container daemon is.
      const inheritEnv = [...Object.keys(pushRefusal), ...Object.keys(places.normal.daemon)]
      const generated = try parts.files(split, { cache: request.cache, inheritEnv })
      // A commit can hold a link, or a file its owner wrote, where a generated file goes: nothing is written then.
      const checked = check(normalCopy, generated) catch effect (cause) => {
        throw failure("unsupported", cause.message)
      }
      const mapFile = generated.find((file) => file.path === targetMapPath)
      if (mapFile === undefined) throw failure("invalid-document", `the generated files have no ${targetMapPath}`)
      const targetMap = Schema.decodeUnknownEffect(Schema.fromJsonString(TargetMap))(mapFile.content) catch effect () => {
        throw failure("invalid-document", `${targetMapPath} is not a target map`)
      }
      // A variant for another system, and a job with a step that has no target, are left out and listed.
      const replayed = replayable(narrowed, targetMap, thisHost())
      const labels = [...new Set(targetsOf(replayed.units))]
      if (labels.length === 0) throw failure("unsupported", nothingToReplay(replayed.left))
      const cycle = cycleIn(replayed.units)
      if (cycle !== undefined) throw failure("invalid-document", `job ${cycle} needs itself`)
      // Smithers build is pointed at this one file, beside the copy. A repository with a workspace file of its own
      // is replayed by its own targets and never comes here.
      const declaration = declarationOf(generated)
      if (declaration === undefined) throw failure("invalid-document", "the generated files have no workspace file")
      return {
        inventory,
        declaration,
        former: checked.former,
        generated: writtenFiles(generated),
        applies: checked.changes.some((change) => change.change === "missing"),
        units: replayed.units,
        labels,
        splits: splitOf(replayed.units),
        left: [...notReplayed(inventory), ...variantsFailedHere(inventory, failedHere), ...replayed.left],
        jobs: jobsFor(request.jobs, targetMap.maxJobs)
      }
    }

    // The newest commit's CI must be replayable: it is what the repository runs today.
    let newest = try prepared()
    const fast = request.modes.includes("fast") ? try siteAt("fast", "HEAD") : undefined

    /** Where a site's generated workspace file is: beside the copy, under the name the generator gave it. */
    const declarationAt = (site: Site, declaration: GeneratedFile): string =>
      path.join(site.declared, path.basename(declaration.path))

    /**
     * Gives Smithers build what it reads for a commit, beside the copy and never in it: the generated workspace
     * file, and what makes that file loadable. A repository that ran `apply` holds the file as one of its own; a
     * replayed commit does not, so its copy is left as the commit has it.
     */
    effect function equip(site: Site, own: Prepared) {
      try orFail(
        fs.writeFileString(declarationAt(site, own.declaration), own.declaration.content),
        `could not write ${own.declaration.path}`
      )
      // A commit made after an earlier `apply` holds that layout's files; `apply` removes them as it writes these.
      for (const former of own.former) {
        try orFail(fs.remove(path.resolve(site.copy, former)), `could not remove ${former}`)
      }
      try options.prepare(site.declared)
    }

    /**
     * What points Smithers build at a site: the copy is the workspace, and the generated workspace file and the
     * cache directory are beside it. A copy as `apply` leaves it (`applied`) holds the workspace file itself.
     */
    const pointed = (site: Site, own: Prepared, applied = false): ReadonlyArray<string> => [
      "--workspace",
      site.copy,
      ...(applied ? [] : ["--workspace-file", declarationAt(site, own.declaration)]),
      "--cache-dir",
      site.cache
    ]

    const reads = readsListener()
    /** Says once in a replay that this machine cannot record what a step reads, when `smthrs` reports that. */
    const heard = effect (chunk: string) => {
      const sentence = reads(chunk)
      if (sentence !== undefined) try progress.say(sentence)
    }

    let runs = 0
    // Where this machine has the software a GitHub runner comes with. A step with runner text is told.
    const software = softwareEnvironment(person)
    /**
     * The whole environment of a `smthrs` started for a site: what a step of the way gets of the machine, with its
     * home, the stand-ins first on `PATH` and the push refusal, then where the shared cache and the compiled code
     * are. Its targets take from it only what they name. Nothing else of the person's reaches it, the jail around
     * it, or what it starts: a step can read the environment of every process it runs beside.
     */
    /**
     * What a run gives the steps of `commit` in one way of running it, as a runner gives it to every step: the
     * commit, the run's id, number and attempt, and where the event files of the commit are. The files are written
     * here, outside every step, so a step that opens one has read a file that is another at the next commit, and a
     * step that opens none has read nothing of the commit. `seen` is the commit the steps find checked out, where
     * that is another than `commit`: the one that holds the files `apply` writes, in `commit`'s place.
     */
    effect function givenAt(commit: string, place: Confined, own: Prepared, seen: string = commit) {
      const count = Number(try git(source, ["rev-list", "--count", commit]))
      const [, parent] = (lines(try git(source, ["rev-list", "--parents", "--max-count=1", commit]))[0] as string).split(" ")
      const directory = path.join(work, "events", path.basename(place.home))
      try orFail(fs.makeDirectory(directory, { recursive: true }), "could not write the event files")
      for (const [name, text] of eventFiles(own.inventory.events ?? {}, seen, parent)) {
        try orFail(fs.writeFileString(path.join(directory, name), text), "could not write the event files")
      }
      return { ...runValues(seen, count), [eventsVariable]: directory }
    }

    const startEnv = (site: Site) => ({
      ...stepEnvironment({ ...software, ...site.place.daemon }, site.place),
      ...jobHomes(site.place),
      ...(request.cache === undefined ? {} : { SMITHERS_CACHE_URL: request.cache }),
      ...compiledCaches(site.cache, site.place.jail !== undefined)
    })

    effect function planOf(site: Site, own: Prepared) {
      const plan = ["ci", ...own.labels, "--plan", "--format", "json", ...pointed(site, own)]
      const [command, ...args] = held(site.place, [site.copy, site.cache], [...options.smthrs, ...plan])
      const planned = try exec(command, args, site.copy, startEnv(site), Number.POSITIVE_INFINITY, stdoutOf, true)
      const printed = Schema.decodeUnknownEffect(Schema.fromJsonString(PrintedPlan))(planned.text) catch effect () => {
        throw failure("command-failed", `smthrs ci --plan printed no plan: ${planned.text.slice(-outputLimit)}`)
      }
      return planOfPrinted(printed)
    }

    /**
     * Runs the targets of `commit` at a site, in the place of the way the site belongs to. With `applied` the
     * site's copy holds the files `apply` writes, in the commit `applied.seen`, which every step is given as its
     * commit; and `applied.causes` gains, by label, why a target failed over a file `apply` wrote.
     */
    const smithers = (
      commit: string,
      site: Site,
      own: Prepared,
      applied?: Applied
    ): Execute<Host> => (targets) => effect {
      const causes = applied?.causes
      const selected = targets ?? own.labels
      if (selected.length === 0) return []
      runs += 1
      const file = path.join(records, `run-${runs}.json`)
      // With a token to give, Smithers build is started by the program that reads it from a pipe.
      const starter = token === undefined ? undefined : options.smthrsWithToken
      const [command, ...args] = held(site.place, [site.copy, records, site.cache], [
        ...(starter ?? options.smthrs),
        "ci",
        ...selected,
        ...pointed(site, own, causes !== undefined),
        "--results-file",
        file,
        "--ui",
        "plain",
        ...(own.jobs === undefined ? [] : ["--jobs", String(own.jobs)])
      ])
      const watch = try watchFor(stall.minutes, stall.table)
      const given = try givenAt(commit, site.place, own, applied?.seen)
      const environment = { ...startEnv(site), ...given, ...printsNotes }
      const handed = starter === undefined ? undefined : token
      const output = try exec(command, args, site.copy, environment, printedLimit, undefined, true, heard, watch, handed, count)
      const stalled = try Ref.get(watch.stalled)
      const record = effect {
        const text = try fs.readFileString(file)
        return try Schema.decodeUnknownEffect(Schema.fromJsonString(RunRecord))(text)
      } catch () => undefined
      if (record === undefined && !stalled) {
        throw failure("command-failed", `smthrs ci wrote no run record: ${output.text.slice(-outputLimit)}`)
      }
      const recorded = record === undefined ? undefined : withReasons(record.results, output.text)
      const results = stalled
        ? stoppedResults(recorded, selected, watch.limitMs, noProgress(stall.minutes))
        : recorded as ReadonlyArray<TargetResult>
      if (causes !== undefined) {
        // What a failed target printed may name a file `apply` wrote: a tool of the repository read it as one of
        // its own. A mismatch of that target then says so.
        const said = failureTexts(output.text)
        const written = own.generated.map((file) => file.path)
        for (const result of results) {
          const cause = result.status === "failed" ? seenIn(said.get(result.label), written) : undefined
          if (cause !== undefined) causes.set(result.label, cause)
        }
      }
      return results
    }

    /**
     * Puts the files `apply` writes into the commit checked out in `copy`: one commit in `commit`'s place, with
     * its parents, message, author, committer and both dates, whose tree is the commit's with those files in it
     * and the former ones out. It is the commit a person pushes after `apply`, so what reads the commit itself,
     * such as `git log -1`, a count of the commits or a check of the newest message, finds what it finds in that
     * person's CI. Gives the new commit.
     */
    effect function commitApplied(copy: string, commit: string, own: Prepared, place: Confined) {
      for (const file of own.generated) {
        const target = path.resolve(copy, file.path)
        try orFail(fs.makeDirectory(path.dirname(target), { recursive: true }), `could not write ${file.path}`)
        try orFail(fs.writeFileString(target, file.content), `could not write ${file.path}`)
      }
      for (const former of own.former) {
        try orFail(fs.remove(path.resolve(copy, former)), `could not remove ${former}`)
      }
      const paths = [...own.generated.map((file) => file.path), ...own.former]
      try git(copy, ["add", "--all", "--force", "--", ...paths], place)
      // Amending keeps the parents, the author and the author's date. Who committed, and when, are given.
      const [name, email, date] = lines(try git(source, ["show", "--no-patch", "--format=%cn%n%ce%n%cI", commit]))
      const committer = {
        GIT_COMMITTER_NAME: name as string,
        GIT_COMMITTER_EMAIL: email as string,
        GIT_COMMITTER_DATE: date as string
      }
      const amend = ["commit", "--amend", "--no-edit", "--cleanup=verbatim", "--quiet", "--no-verify", "--allow-empty"]
      try git(copy, ["-c", "commit.gpgsign=false", ...amend], place, committer)
      return (try git(copy, ["rev-parse", "HEAD"], place)).trim()
    }

    /**
     * The newest commit once more, in normal mode, in a copy that holds the files `apply` writes: the commit a
     * person pushes after `apply`, which every step of the run is given as its commit. It is a copy of its own, so
     * the copies the three ways run in hold the commit's
     * files and nothing else. A step that read none of the files is answered from normal mode's cache. It gives
     * how long the run took, and the mismatches of normal mode that only this run shows: every step that passed
     * on the commit's files and fails here, each with the line that says why. It gives nothing when the request
     * does not ask for the run, when no step passed, and at a commit that holds the files already: that one is as
     * `apply` leaves it.
     */
    effect function asApplied(at: string, commit: string, own: Prepared, baseRecord: RunRecord, normalRecord: RunRecord) {
      // A run record also holds the group of files every step names, when the steps are many enough to share
      // one. It is no step: `smthrs ci` refuses it when it is asked for by name.
      const steps = new Set(own.labels)
      const passed = normalRecord.results.flatMap((result) =>
        (result.status === "ran" || result.status === "hit") && steps.has(result.label) ? [result.label] : []
      )
      if (request.applied !== true || !own.applies || passed.length === 0) return undefined
      return try scoped(effect {
        const start = try Clock.currentTimeMillis
        try progress.say(`${at} with the files apply writes`)
        // The run starts in the checkout normal mode's runs started in, as a person's next CI run does: Smithers build
        // names a job's machine by its workspace's path, and a tool that wrote a path of that machine into a cache
        // normal mode saved finds it again. Normal mode's copy waits beside it until the run ends.
        const site = normal
        const aside = path.join(work, "applied", path.basename(root))
        try orFail(fs.makeDirectory(path.dirname(aside), { recursive: true }), "could not make a directory")
        try orFail(fs.rename(normalCopy, aside), "could not move normal mode's copy")
        try addFinalizer(() => ignore(fs.rename(aside, normalCopy)))
        try orFail(fresh(normalCopy), "could not make a directory")
        try cloneAt(site.copy, commit, site.place)
        const seen = try commitApplied(site.copy, commit, own, site.place)
        const causes = new Map<string, string>()
        // Its reruns are not the replay's: they are in no count of the report.
        const second = try measure(
          Effect.void,
          Effect.void,
          smithers(commit, site, own, { causes, seen }),
          passed,
          reruns,
          new Map(),
          { count: 0, ms: 0 }
        )
        const failed = new Map(second.results.flatMap((result) => result.status === "failed" ? [[result.label, result] as const] : []))
        // A step that names none of the files still fails only beside them: the line says so and lists them.
        const written = own.generated.map((file) => file.path)
        for (const label of failed.keys()) {
          if (!causes.has(label)) causes.set(label, failsApplied(written))
        }
        const results = normalRecord.results.map((result) => failed.get(result.label) ?? result)
        // A step that this run failed carries its line; a mismatch normal mode already had carries none.
        const mismatches = mismatchesOf("normal", baseRecord, { ...normalRecord, results }, own.splits, causes)
          .filter((entry) => entry.cause !== undefined)
        return { mismatches, ms: (try Clock.currentTimeMillis) - start }
      })
    }

    const stepLimit = options.stepTimeout ?? Duration.hours(stepTimeoutHours)
    const stall: StallLimit = {
      minutes: request.stallMinutes ?? defaultStallMinutes,
      table: options.processes ?? tableFor()
    }
    // The CPU time of a step is read from its processes while it runs: none of it reaches this program.
    const cpu = try cpuWatch(stall.table, options.cpuTick)
    // The run whose steps are counted now: a way's first pass of a commit, or none.
    let counted: CpuBucket | undefined = undefined
    const counting: Counting = (bucket) => {
      counted = bucket
    }
    const count: Count = (pid) => {
      const bucket = counted
      if (bucket === undefined) return uncounted(pid)
      const ended = cpu.track(pid)
      return () => addTo(bucket, ended())
    }

    /**
     * One run of the baseline: its units' steps in order in one fresh checkout, named as the repository is. A step
     * that fails blocks every step after it.
     */
    effect function runSequence(
      sequence: ReadonlyArray<Unit>,
      name: string,
      commit: string,
      wanted: ReadonlySet<string> | undefined,
      way: Confined,
      store: string,
      given: Readonly<Record<string, string>>
    ) {
      return try scoped(effect {
        // A job is a machine: its home and its temporary directory are its own, and gone when it ends.
        const place = try orFail(machine(way, name), "could not make the home of a job")
        const directory = try orFail(fresh(path.join(work, `${path.basename(way.home)}-copy-${name}`)), "could not make a directory")
        const copy = path.join(directory, path.basename(root))
        try cloneAt(copy, commit, place)
        const results: Array<TargetResult> = []
        let failed: string | undefined = undefined
        for (const step of stepsThrough(sequence, wanted)) {
          if (failed !== undefined) {
            results.push(blocked(step.label, failed))
            continue
          }
          const start = try Clock.currentTimeMillis
          const [program, ...argv] = held(place, [copy, store], [...shell, step.command])
          // Only a step whose text names the variable is given it: the text takes it away before the step's own
          // script starts, and a step with no such text would hand it on.
          const told = step.command.includes(stateVariable) ? { [stateVariable]: store } : {}
          // A step with runner text is told where this machine has a runner's software, and keeps its job's
          // state in the job's own temporary directory.
          const found = step.command.includes(runnerEntry) ? { ...software, [jobTemporaryVariable]: place.tmp } : {}
          // A step no runner starts is given the run's variables its script names: what its target passes on.
          const run = givenTo(step.command, given)
          const environment = stepEnvironment({ ...found, ...place.daemon, ...run, ...step.env, ...told }, place)
          // A step that cannot start, for example because its directory does not exist at this commit, has failed.
          const output = runStep(program, argv, path.join(copy, step.cwd), environment, stepLimit, stall, count)
            catch (cause) => ({ timedOut: false, stalled: false, exitCode: undefined, stderr: `could not start: ${describe(cause)}`, stdout: "" } satisfies StepRun)
          const durationMs = (try Clock.currentTimeMillis) - start
          if (output.exitCode === 0) {
            results.push({ label: step.label, status: "ran", key: "", durationMs })
            continue
          }
          results.push({
            label: step.label,
            status: "failed",
            key: "",
            durationMs,
            error: output.stalled ? noProgress(stall.minutes) : output.timedOut ? pastLimit(stepLimit) : reasonOf(output),
            command: commandLine(step.written),
            ...(output.exitCode === undefined ? {} : { exitCode: output.exitCode })
          })
          failed = step.label
        }
        return wanted === undefined ? results : results.filter((result) => wanted.has(result.label))
      })
    }

    const baseline = (commit: string, own: Prepared, place: Confined = places.baseline): Execute<Host> => (targets) => effect {
      const wanted = targets === undefined ? undefined : new Set(targets)
      const chosen = stationsOf(own.units, wanted)
      const store = place === places.trial ? keptTrial : kept
      const limit = try Semaphore.make(own.jobs ?? options.cores ?? coreCount())
      const given = try givenAt(commit, place, own)
      const plan: Array<Station & { readonly gate: Deferred.Deferred<boolean> }> = []
      for (const station of chosen) plan.push({ ...station, gate: try Deferred.make<boolean>() })
      const runs = plan.flatMap((station) => station.runs)
      const names = new Map(runNames(runs).map((name, index) => [runs[index] as ReadonlyArray<Unit>, name]))
      const collected: Array<TargetResult> = []
      for concurrent (const station of plan) {
        let needsPassed = true
        for (const need of plan.filter((other) => other.jobs.some((job) => station.needs.includes(job)))) {
          needsPassed = (try Deferred.await(need.gate)) && needsPassed
        }
        const results: Array<TargetResult> = []
        for concurrent (const sequence of station.runs) {
          if (needsPassed) {
            results.push(...(try limit.withPermits(1)(runSequence(sequence, names.get(sequence) as string, commit, wanted, place, store, given))))
          } else {
            const waiting = sequence.flatMap((unit) => labelsOf(unit, wanted))
            results.push(...waiting.map((label) => blocked(label, station.needs.join(", "))))
          }
        }
        collected.push(...results)
        try Deferred.succeed(station.gate, needsPassed && results.every((result) => result.status === "ran"))
      }
      // Jobs finish in any order; a report lists their steps in the order of the CI.
      const order = new Map(own.units.flatMap((unit) => unit.steps).map((step, index) => [step.label, index]))
      return collected.toSorted((a, b) => (order.get(a.label) as number) - (order.get(b.label) as number))
    }

    /**
     * An older commit's own CI, read from its own tree. A commit whose CI cannot be replayed, because it had none or
     * because none of it runs here, is not a failed replay: the reason is kept and the commit is listed.
     */
    effect function preparedAt(commit: string) {
      try checkout(normalCopy, commit, normal.place)
      return prepared() catch effect (cause) => {
        if (cause.code !== "unsupported" && cause.code !== "invalid-document") throw cause
        return { reason: cause.message }
      }
    }

    const tip = commits.at(-1) as string
    const oldest = commits[0] as string
    // How often a failed step runs again: what the person asked for, else what the host sets.
    const reruns = request.reruns ?? options.reruns
    // How often a job that fails the first run runs again before it is left out.
    const again = Math.min(1, reruns)
    const tally: RerunTally = { count: 0, ms: 0 }
    // What each way's steps failed with in its run before: the same failure again is not run again.
    const last: Record<"baseline" | "normal" | "fast", LastFailures> = {
      baseline: new Map(),
      normal: new Map(),
      fast: new Map()
    }

    /**
     * Runs the baseline once at `at`, in `place`, and leaves out what cannot pass on this machine. A unit that fails
     * runs once more, at the newest commit and in the home of the run that only judges: a commit that was broken
     * and fixed since so leaves nothing out, and neither does one flaky failure. A unit that fails again is left
     * out at every commit, with the commits it failed at. A unit that was kept from running by a failure before it
     * runs again without that failure, as it will in the replay. Gives the time of the first pass, and what is
     * left of the CI at `at`: nothing, when all of it is left out and the newest commit still has a job.
     */
    effect function judge(at: string, whole: Prepared, place: Confined) {
      const passed = new Set<string>()
      let firstFailure: StepFailure | undefined = undefined
      let wallMs: number | undefined = undefined
      let own: Prepared | undefined = whole
      while (own !== undefined) {
        const waiting = own.units.filter((unit) => !passed.has(unitKey(unit)))
        const wanted = waiting.flatMap((unit) => labelsOf(unit, undefined))
        const start = try Clock.currentTimeMillis
        const ran = try baseline(at, own, place)(wanted)
        wallMs ??= (try Clock.currentTimeMillis) - start
        // A step that fails this way again at the first counted commit is broken, not flaky.
        remember(last.baseline, ran)
        const results = try settle(baseline(tip, newest, places.trial), ran, again, wanted.length, new Map(), tally)
        const found = trialOf(waiting, results, stepNames(own.units))
        for (const key of found.passed) passed.add(key)
        if (found.first === undefined) break
        const first: StepFailure = firstFailure ?? found.first
        firstFailure = first
        // A job that ran once more failed at the newest commit too.
        const twice = failedTwice(results)
        const ranAgain = (entry: FailedHere): boolean =>
          waiting.some((unit) => unitKey(unit) === unitKey(entry) && unit.steps.some((step) => twice.has(step.label)))
        const named = found.failed.map((entry) => failedAt(entry, ranAgain(entry) ? [at, tip] : [at]))
        for (const entry of named) try progress.say(`fails here: ${entry.job}: ${entry.reason}`)
        failedHere.push(...named)
        // With what failed left out, nothing may be left to replay: then no job can pass here.
        try checkout(normalCopy, tip, normal.place)
        newest = prepared() catch effect (cause) => {
          throw cause.code === "unsupported" ? failure("unsupported", noJobPassed(at, first, ranAgainAt(again, at, tip))) : cause
        }
        const left: Prepared | { readonly reason: string } = at === tip ? newest : try preparedAt(at)
        own = "reason" in left ? undefined : left
      }
      return { wallMs: wallMs as number, own }
    }

    /**
     * The run of every way at `at`, the commit before the oldest replayed one, which fills what each keeps from one
     * commit to the next. With `request.trial` the baseline's is also the run that finds what passes here. A mode
     * runs what the baseline's run left, and its failure is not the replay's: the cache holds what passed.
     */
    effect function warmed(at: string, first: Prepared) {
      const short = at.slice(0, 7)
      try progress.say(`first run ${short} baseline`)
      const judged = request.trial === true
        ? try judge(at, first, places.baseline)
        : {
          wallMs: (try measure(Effect.void, Effect.void, baseline(at, first), undefined, 0, last.baseline, tally)).wallMs,
          own: first
        }
      const own = judged.own
      effect function mode(way: "normal" | "fast", site: Site | undefined) {
        if (own === undefined || site === undefined) return undefined
        try progress.say(`first run ${short} ${way}`)
        const run = measure(
          checkout(site.copy, at, site.place),
          equip(site, own),
          smithers(at, site, own),
          undefined,
          0,
          last[way],
          tally
        ) catch effect (cause) => {
          try progress.say(`the first run in ${way} mode did not finish: ${firstLine(cause.message)}`)
          return undefined
        }
        return run?.wallMs
      }
      const normalMs = try mode("normal", normal)
      const fastMs = try mode("fast", fast)
      return {
        commit: at,
        baselineMs: judged.wallMs,
        ...(normalMs === undefined ? {} : { normalMs }),
        ...(fastMs === undefined ? {} : { fastMs })
      } satisfies FirstRun
    }

    /**
     * Finds what passes here when no way runs before the first counted commit: the baseline runs once at the oldest
     * commit whose CI can be replayed, in a home and a store of its own, so it warms nothing a counted run reads.
     * Gives the time it took.
     */
    effect function trial() {
      const start = try Clock.currentTimeMillis
      let at = tip
      let own = newest
      for (const commit of commits.slice(0, -1)) {
        const found = try preparedAt(commit)
        if ("reason" in found) continue
        at = commit
        own = found
        break
      }
      try progress.say(`checking which jobs pass on this machine at ${at.slice(0, 7)}`)
      try judge(at, own, places.trial)
      return (try Clock.currentTimeMillis) - start
    }

    /** The first run of every way, or why there is none though one was asked for. */
    effect function start() {
      if (request.warm !== true) return {}
      const parent = try exec("git", ["rev-parse", "--verify", "--quiet", `${oldest}^`], source, {}, outputLimit, stdoutOf)
      if (parent.exitCode !== 0) return { cold: noCommitBefore(oldest) }
      const before = parent.text.trim()
      const own = try preparedAt(before)
      if ("reason" in own) return { cold: noCiBefore(oldest) }
      return { firstRun: try warmed(before, own) }
    }

    // The jobs that could run here before the first run took any out.
    const could = new Set(newest.units.map((unit) => unit.job))
    const started: { readonly firstRun?: FirstRun; readonly cold?: string } = try start()
    const trialMs = started.firstRun === undefined && request.trial === true ? try trial() : undefined
    // A speedup over less than half of a CI is not that CI's: the replay says what it left out, and stops.
    const stayed = new Set(newest.units.map((unit) => unit.job))
    const few = tooFewLeft(could.size, newest.left.filter((entry) => could.has(entry.job) && !stayed.has(entry.job)))
    if (few !== undefined) throw failure("unsupported", few)

    const commitsDone: Array<ReplayCommit> = []
    const commitsLeft: Array<NotReplayedCommit> = []
    const baselines: Array<RunRecord> = []
    const allRows: Array<Row> = []
    let flaky = 0
    let fastFlaky = 0
    let fastNotMeasured: string | undefined = undefined
    // How long the run as `apply` leaves the repository took, when there was one.
    let appliedMs: number | undefined = undefined
    const selected = new Map<string, ReadonlyArray<string>>()

    for (const [index, commit] of commits.entries()) {
      const at = `${index + 1}/${commits.length} ${commit.slice(0, 7)}`
      const own = index === commits.length - 1 ? newest : try preparedAt(commit)
      if ("reason" in own) {
        try progress.say(`${at} not replayed`)
        commitsLeft.push({ commit, reason: own.reason })
        continue
      }
      const changed = lines(try git(source, ["show", "--format=", "--name-only", "--diff-merges=first-parent", commit]))
      try progress.say(`${at} baseline`)
      const base = try measure(
        Effect.void,
        Effect.void,
        baseline(commit, own),
        undefined,
        reruns,
        last.baseline,
        tally,
        counting
      )
      const baseRecord = recordOf(base.results, commit, base.wallMs)
      baselines.push(baseRecord)
      const names = stepNames(own.units)
      try progress.say(`${at} normal`)
      // A mode starts each commit as a CI run starts: with a home and a temporary directory nothing wrote to.
      try orFail(renew(places.normal), "could not empty the home of normal mode")
      const ran = try measure(
        checkout(normalCopy, commit, normal.place),
        equip(normal, own),
        smithers(commit, normal, own),
        undefined,
        reruns,
        last.normal,
        tally,
        counting
      )
      const normalRecord = recordOf(ran.results, commit, ran.wallMs, "normal")
      let fastPart: Pick<ReplayCommit, "fast"> = {}
      let fastMismatches: ReturnType<typeof mismatchesOf> = []
      flaky += flakyOf([baseRecord, normalRecord])
      if (fast !== undefined && fastNotMeasured === undefined) {
        const rows = try onNormalCopy(parts.rows(normalCopy, normalRecord, try planOf(normal, own)))
        const scores = try scoresOrReason(parts.score, rows)
        if (typeof scores === "string") {
          fastNotMeasured = scores
          try progress.say(`${at} fast not measured`)
        } else {
          const choice = choose(scores, request.settings ?? defaultSettings)
          const labels = ran.results.map((result) => result.label).filter((label) => !choice.skipped.has(label))
          try progress.say(`${at} fast`)
          try orFail(renew(places.fast), "could not empty the home of fast mode")
          const sped = try measure(
            checkout(fast.copy, commit, fast.place),
            equip(fast, own),
            smithers(commit, fast, own),
            labels,
            reruns,
            last.fast,
            tally,
            counting
          )
          const run = fastRunOf(
            ran.results,
            sped.results,
            commit,
            sped.wallMs,
            baseRecord,
            names,
            own.splits,
            undefined,
            sped.cpuMs
          )
          fastPart = run.part
          fastMismatches = run.mismatches
          fastFlaky += run.flaky
          allRows.push(...rows)
          selected.set(commit, choice.selected)
        }
      }
      // The newest commit is the one `apply` is run on.
      const applied = index === commits.length - 1
        ? try asApplied(at, commit, own, baseRecord, normalRecord)
        : undefined
      if (applied !== undefined) appliedMs = applied.ms
      commitsDone.push({
        commit,
        changedFiles: changed.length,
        baseline: totalsOf(baseRecord, names, base.cpuMs),
        normal: totalsOf(normalRecord, names, ran.cpuMs),
        mismatches: [
          ...mismatchesOf("normal", baseRecord, normalRecord, own.splits),
          ...(applied === undefined ? [] : applied.mismatches),
          ...fastMismatches
        ],
        ...fastPart
      })
    }
    // One commit where nothing passes is a failed commit. When nothing passes at any, the CI does not run here.
    const nothing = nothingPassed(baselines, stepNames(newest.units))
    if (nothing !== undefined) throw failure("unsupported", nothing)
    return finishedReport(newest.inventory, commitsDone, {
      fastAsked: fast !== undefined,
      rows: allRows,
      selected,
      left: newest.left,
      flaky,
      fastFlaky,
      commitsLeft,
      fastNotMeasured,
      jobs: jobsCovered(newest.units, newest.left),
      trialMs,
      appliedMs,
      reruns: tally,
      firstRun: started.firstRun,
      cold: started.cold
    })
  })
