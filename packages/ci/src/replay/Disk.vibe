/**
 * Keeps a replay from filling the disk. A job of a large repository can hold
 * tens of gigabytes in its machine, and a replay runs several at once: a full
 * disk in the middle of a run fails every program on the machine, not only
 * the replay. So the replay reads the free space of the disk that holds its
 * folder while it runs. Under a floor it starts no new job until running
 * ones end and their machines are gone; under half the floor it ends what
 * runs. When space does not come back, the replay ends with one line that
 * says what it held.
 *
 * @since 0.1.0
 */

import type { Failure } from "../contract/Parts.vibe"
import { gigabyte, heldUnder, sizeOf, type Space, spaceOf } from "./DiskSpace.ts"
import { failure } from "./Summary.vibe"

/**
 * The least free space a replay leaves on the disk that holds its folder:
 * 5 GB, or 2% of the disk when that is more. A machine needs room beside the
 * replay for its own programs to keep working.
 *
 * @category constants
 * @since 0.1.0
 */
export const floorBytes = 5 * gigabyte

/**
 * The share of the disk a replay leaves free when it is more than
 * {@link floorBytes}.
 *
 * @category constants
 * @since 0.1.0
 */
export const floorShare = 0.02

/**
 * The free space a replay leaves on a disk of `total` bytes.
 *
 * @category constants
 * @since 0.1.0
 */
export const floorOf = (total: number): number => Math.max(floorBytes, total * floorShare)

/**
 * How often the free space is read while a replay runs.
 *
 * @category constants
 * @since 0.1.0
 */
export const defaultDiskTick: Duration.Input = "2 seconds"

/**
 * The disk as a replay reads it: `space` gives the free space and the size of
 * the file system that holds a path, or `undefined` where the machine does
 * not say, and `held` the bytes the files under a path take on it.
 *
 * @category services
 * @since 0.1.0
 */
export service DiskSpace {
  readonly space: (path: string) => (Space | undefined)!!
  readonly held: (path: string) => number!!
  static readonly defaultValue = () => ({
    effect space(path: string) {
      return tryPromise(() => spaceOf(path)) catch () => undefined
    },
    // Reading a tree never fails: what cannot be read holds nothing.
    effect held(path: string) {
      return try promise((signal) => heldUnder(path, signal))
    }
  })
}

/** A size in gigabytes, rounded down (`round` Math.floor) or up (Math.ceil) to the decimals one sentence uses. */
const gigabytes = (bytes: number, digits: number, round: (value: number) => number): string =>
  `${(round((Math.max(0, bytes) / gigabyte) * 10 ** digits) / 10 ** digits).toFixed(digits)} GB`

/** The decimals a size of `bytes` is said with: none from 10 GB, one below. */
const digitsFor = (bytes: number): number => bytes >= 10 * gigabyte ? 0 : 1

/**
 * Free space under the floor, said so that it reads as under: what is free
 * rounded down and the floor rounded up, to the same decimals. 4.97 GB under
 * 5 GB reads "4.9 GB free, under the 5.0 GB", never "5 GB under the 5 GB".
 */
const apart = (free: number, floor: number): readonly [string, string] =>
  [gigabytes(free, digitsFor(floor), Math.floor), gigabytes(floor, digitsFor(floor), Math.ceil)]

/** A size to free, rounded up so that it is never nothing: 0.1 GB, 1.2 GB, 14 GB. */
const toFree = (bytes: number): string => gigabytes(bytes, digitsFor(bytes), Math.ceil)

/** Jobs' machines holding less than this held nothing a smaller --jobs would give back. */
const machinesWorthJobs = gigabyte / 10

/**
 * The line a replay ends with when the disk would fill. It says what is free
 * and what the replay leaves free so that the first is plainly under the
 * second, and advises fewer jobs at once only when the jobs' machines held
 * space a smaller `--jobs` gives back; otherwise it says how much to free.
 *
 * @category rendering
 * @since 0.1.0
 */
export const stoppedLine = (folder: string, free: number, floor: number, held: number, machines: number): string => {
  const [freeText, floorText] = apart(free, floor)
  const advice = machines >= machinesWorthJobs
    ? "Run it with fewer jobs at once (--jobs) or with more free space"
    : `Free ${toFree(floor - free)} more on that disk, or set TMPDIR to a folder on a disk with more room`
  return `the replay stopped before the disk filled: the disk that holds ${folder} has ${freeText} free, under the ` +
    `${floorText} a replay leaves free (5 GB, or 2% of the disk when that is more); the replay held ` +
    `${sizeOf(held)} there, ${sizeOf(machines)} of it in its jobs' machines. ${advice}`
}

/**
 * What a replay says while a job waits for disk space.
 *
 * @category rendering
 * @since 0.1.0
 */
export const waitingLine = (free: number, floor: number): string => {
  const [freeText, floorText] = apart(free, floor)
  return `waiting for disk space: ${freeText} free, under the ${floorText} a replay leaves free; ` +
    "no job starts until a running one ends"
}

/**
 * The disk under watch while a replay runs. `admit` waits until a job may
 * start and counts it as running until `release`; it gives false when the
 * replay must stop instead, after `leftBehind` removed what finished jobs
 * left, which is all of it once no job runs. `ended` ends when the replay must
 * stop now: free space fell under half the floor, or a job could not start.
 * It and `admit` then fail with the line the replay ends with, which
 * `stopped` gives. `most` is the largest sampled allocation under the replay
 * directory, or `undefined` where the machine cannot report disk space.
 *
 * @category models
 * @since 0.1.0
 */
export interface DiskWatch {
  readonly admit: (leftBehind: void!!) => void!Failure
  readonly release: void!!
  readonly ended: never!Failure
  readonly stopped: (string | undefined)!!
  readonly most: (number | undefined)!!
}

/**
 * A watch of the disk that holds `folder`, the replay's folder, whose jobs'
 * machines are under `machines`. It reads the free space every `tick` until
 * its scope closes, and says `waitingLine` through `say` when a job waits.
 * Where the machine does not say how much is free, nothing waits or stops.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function diskWatch(
  folder: string,
  machines: string | ReadonlyArray<string>,
  say: (line: string) => void!!,
  tick: Duration.Input = defaultDiskTick
) {
  const disk = try DiskSpace
  const done = try Deferred.make<string>()
  const first = try disk.space(folder)
  const floor = first === undefined ? 0 : floorOf(first.total)
  let free = first?.free ?? 0
  let most = 0
  let running = 0
  let waiting = false
  let stoppedAt: number | undefined = undefined
  effect function read() {
    const now = try disk.space(folder)
    if (first === undefined || now === undefined) return
    free = now.free
  }
  effect function sampleHeld() {
    const held = try disk.held(folder)
    most = Math.max(most, held)
    return held
  }
  // The first line stands: a job and the watch may both find the disk full.
  effect function stop() {
    if (stoppedAt !== undefined) return
    stoppedAt = free
    const [freeText, floorText] = apart(free, floor)
    try Deferred.succeed(done, `the replay stopped before the disk filled: the disk that holds ${folder} has ${freeText} free, under the ${floorText} a replay leaves free`)
  }
  const ended = effect {
    throw failure("command-failed", try Deferred.await(done))
  }
  // The report asks for sizes after active jobs have received the stop signal. All callers share the walk.
  const details = try cached(effect {
    const held = try sampleHeld()
    let jobs = 0
    for (const root of typeof machines === "string" ? [machines] : machines) {
      jobs += try disk.held(root)
    }
    return stoppedLine(folder, stoppedAt as number, floor, held, jobs)
  })
  effect function watching() {
    while (stoppedAt === undefined) {
      try sleep(tick)
      try read()
      if (free < floor / 2) try stop()
    }
  }
  fork.scoped watching()
  // A large directory walk must never delay a free-space check or the emergency stop.
  effect function sampling() {
    while (first !== undefined && stoppedAt === undefined && free >= floor / 2) {
      try sleep(tick)
      if (stoppedAt === undefined && free >= floor / 2) try sampleHeld()
    }
  }
  fork.scoped sampling()
  return {
    admit: (leftBehind) => effect {
      while (stoppedAt === undefined) {
        try read()
        if (stoppedAt !== undefined) break
        if (free >= floor) {
          waiting = false
          running += 1
          return
        }
        if (running === 0) {
          try leftBehind
          try read()
          if (stoppedAt !== undefined) break
          if (free >= floor) {
            running += 1
            return
          }
          try stop()
        } else {
          if (!waiting) try say(waitingLine(free, floor))
          waiting = true
          try sleep(tick)
        }
      }
      try ended
    },
    release: sync(() => {
      running -= 1
    }),
    ended,
    stopped: suspend(() => stoppedAt === undefined ? succeed(undefined) : details),
    most: effect {
      if (first === undefined) return undefined
      if (stoppedAt === undefined) try sampleHeld()
      return most
    }
  } satisfies DiskWatch
}
