/**
 * A baseline job's process namespace. On a CI runner a program a step leaves
 * running, as a server started in the background, lives until the job's last
 * step has ended, and the job's next step talks to it. A baseline job whose
 * steps run in a jail runs them all in one jail, held by a keeper
 * (`@smthrs/targets/JobKeeper`): what a step leaves there lives on for the
 * steps after it, no other job sees it, and it ends with the job.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { childrenOf, endedOrNamed, endOrphans, keeper, processes, socketName } from "@smthrs/targets/JobKeeper"
import { type Confined, held } from "./Confine.vibe"
import { launcherEnvironment, nodePath, reaperProgram } from "./Environment.ts"
import { exec, outputLimit } from "./Process.vibe"

/**
 * A baseline job's keeper: the directory it listens in, and the process
 * whose tree holds every process of the job.
 *
 * @category models
 * @since 0.1.0
 */
export interface Keeper {
  readonly directory: string
  readonly pid: number
}

/**
 * Starts the keeper of a job whose steps run in `place`'s jail and write
 * `writable`, listening in a new directory under `parent`, and waits until it
 * listens. When the scope closes the keeper is ended, and every process of
 * the job with it, and its directory is removed. Nothing where the job has no
 * jail, or the keeper does not listen within ten seconds: there a program a
 * step leaves running ends with its step. When the scope closes it waits for
 * the job's namespace to be empty; what still runs ten seconds on is named
 * through `say`.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function keeperIn(
  place: Confined,
  writable: ReadonlyArray<string>,
  parent: string,
  say: (line: string) => Effect.Effect<void>
) {
  if (place.jail === undefined) return undefined
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const spawner = try ChildProcessSpawner
  try fs.makeDirectory(parent, { recursive: true })
  // A directory of this job's own: a socket another job's keeper left is never this job's.
  const directory = try fs.makeTempDirectory({ directory: parent, prefix: "job-" })
  try addFinalizer(() => effect {
    fs.remove(directory, { recursive: true, force: true }) catch effect () => {
      try say(`smithers-ci: replay left a keeper directory it could not remove: ${directory}`)
    }
  })
  const [program, ...args] = held(place, [...writable, directory], keeper(nodePath()))
  const handle = try spawner.spawn(
    ChildProcess.make(program, args, {
      cwd: directory,
      env: launcherEnvironment,
      extendEnv: false,
      // Its input stays open while this process lives: however this process ends, the job ends with it.
      stdin: "pipe",
      stdout: "ignore",
      stderr: "ignore",
      forceKillAfter: "1 second"
    })
  )
  // The jail ends when the process that holds it does, and every process of the job with it. The bubblewrap ends as
  // soon as the namespace's command has, before the kernel has ended every process in it; the namespace's first
  // process ends only after all of them, so the scope waits for that too: nothing of the job, no port it held,
  // outlives it. The first process is noted once the keeper listens, while the bubblewrap that started it runs.
  const first: Array<number> = []
  try addFinalizer(() =>
    ignore(effect {
      try ignore(handle.kill({ killSignal: "SIGKILL" }))
      const still = try promise(() => endedOrNamed(first))
      if (still !== undefined) try say(`smithers-ci: ${still}`)
    })
  )
  for (let waited = 0; waited < 10_000; waited += 20) {
    if (try fs.exists(path.join(directory, socketName))) {
      first.push(...childrenOf(Number(handle.pid)))
      return { directory, pid: Number(handle.pid) } satisfies Keeper
    }
    if (!(try handle.isRunning)) return undefined
    try sleep("20 millis")
  }
  return undefined
}

/**
 * Whether the jail of `place` can hold a job's processes: start a process
 * namespace of its own inside it, as a keeper's jail and Smithers build's
 * machines inside the jail of a mode do, within thirty seconds. Where it
 * cannot, a program a step leaves running ends with its step, in every way of
 * running a commit, and a job with a step that leaves one is left out.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function keepsPrograms(place: Confined) {
  if (place.jail === undefined) return false
  const [program, ...args] = held(place, [], [
    place.jail.bwrap,
    "--dev-bind",
    "/",
    "/",
    "--unshare-pid",
    "--proc",
    "/proc",
    "--die-with-parent",
    "--",
    "true"
  ])
  // Asked once, with a limit: a jail that cannot start one never holds the replay up.
  const tried = timeoutOption(exec(program, args, "/", launcherEnvironment, outputLimit, undefined, true), "30 seconds")
    catch () => Option.none()
  return Option.isSome(tried) && tried.value.exitCode === 0
}

/**
 * The program a step of a job in `place` runs under when nothing keeps what
 * it leaves running: `smthrs-observe --reap`, which ends whatever the step
 * left, however it detached, a second after the step's command has ended, as
 * a runner ends a job's programs. Asked once, with a limit. None where the
 * place has a jail (its process namespace ends with each step), where `find`
 * finds no program, or where it does not answer.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function reaperIn(place: Confined, find: () => string | undefined = reaperProgram) {
  if (place.jail !== undefined) return undefined
  const program = find()
  if (program === undefined) return undefined
  const tried = timeoutOption(exec(program, ["--probe", "--reap"], "/", launcherEnvironment, outputLimit, undefined, true), "30 seconds")
    catch () => Option.none()
  return Option.isSome(tried) && tried.value.exitCode === 0 ? program : undefined
}

/**
 * `argv` run under `reaper` ({@link reaperIn}), or as it is where there is none.
 *
 * @category constructors
 * @since 0.1.0
 */
export const reapedBy = (
  argv: readonly [string, ...Array<string>],
  reaper: string | undefined
): readonly [string, ...Array<string>] => reaper === undefined ? argv : [reaper, "--reap", "--", ...argv]

/**
 * The processes of this user when a step starts, where nothing else ends
 * what the step leaves running: no keeper (`job`) holds its job and no
 * reaper ({@link reaperIn}) runs it, as on macOS. None elsewhere.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function processesBefore(job: Keeper | undefined, reaper: string | undefined) {
  if (job !== undefined || reaper !== undefined) return undefined
  return try promise(() => processes())
}

/**
 * Ends what a step left running in the job's `directory` that has left its
 * process tree, where {@link processesBefore} listed `before`: a program
 * the system adopted, working in that directory. Nothing where `before` is
 * none.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function endLeftIn(before: ReadonlyMap<number, number> | undefined, directory: string) {
  if (before === undefined) return
  try promise(() => endOrphans(before, directory))
}

