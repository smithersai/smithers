/**
 * What a replay sets up before it runs a step of a past commit: the home and
 * temporary directory its steps get, the hook that refuses a push, and the
 * jail it holds its steps in.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { gitConfig, hooksDirectory, type Place, prePush } from "./Environment.ts"
import {
  credentials,
  type Jail,
  jailed,
  type Mask,
  type Probe,
  temporaryOf,
  temporaryRoots,
  unjailed
} from "./Jail.ts"

/**
 * Where the steps of one replay run: their home and temporary directory, the
 * directory of the hook that refuses a push, and the jail, when this machine
 * can hold one.
 *
 * @category models
 * @since 0.1.0
 */
export interface Confined extends Place {
  readonly hooks: string
  readonly jail: Jail | undefined
}

/**
 * Makes the steps' home and temporary directory under `work`, and asks the
 * machine for a jail. The home holds the hook and nothing of the person's.
 * On a machine that cannot jail a step, `say` is told once. `programs` are
 * the paths the replay runs its own programs from. A jailed step finds the
 * machine's temporary directories replaced by the replay's own, and still
 * reads there the programs, the caches the machine names, and `work`.
 *
 * A step can leave a directory nothing can be removed from, as Go leaves its
 * module cache, so before `work` is removed everything under both
 * directories is made writable again.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function confine(
  work: string,
  probe: () => Probe,
  say: (line: string) => void!!,
  programs: ReadonlyArray<string>
) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const spawner = try ChildProcessSpawner
  const home = path.join(work, "home")
  const tmp = path.join(work, "tmp")
  const hooks = path.join(home, hooksDirectory)
  try fs.makeDirectory(hooks, { recursive: true })
  try fs.makeDirectory(tmp)
  try addFinalizer(() =>
    ignore(scoped(effect {
      const unlock = ChildProcess.make("chmod", ["-R", "u+rwX", home, tmp], {
        stdin: "ignore",
        stdout: "ignore",
        stderr: "ignore"
      })
      try (try spawner.spawn(unlock)).exitCode
    }))
  )
  const hook = path.join(hooks, "pre-push")
  try fs.writeFileString(hook, prePush)
  try fs.chmod(hook, 0o755)
  try fs.writeFileString(path.join(home, ".gitconfig"), gitConfig)
  const found = probe()
  if ("refusal" in found) {
    try say(unjailed(found.refusal))
    return { home, tmp, hooks, jail: undefined } satisfies Confined
  }
  const masks: Array<Mask> = []
  for (const hidden of [...credentials.map((name) => path.join(found.home, name)), ...found.hidden]) {
    // A link is hidden where it leads, so the credential is out of sight by every name it has.
    const real = fs.realPath(hidden) catch () => undefined
    if (real === undefined) continue
    masks.push({ path: real, directory: (try fs.stat(real)).type === "Directory" })
  }
  const temporary = temporaryOf(found.tmp)
  const caches: Array<string> = []
  for (const cache of found.caches) {
    if (try fs.exists(cache)) caches.push(cache)
  }
  const visible = [...temporaryRoots(programs, temporary), ...caches, work]
  return { home, tmp, hooks, jail: { bwrap: found.bwrap, masks, tmp, temporary, visible } } satisfies Confined
}

/**
 * The command that runs `argv` as a step of the replay: in the jail, where it
 * can write its home, its temporary directory and `writable`, or as it is on
 * a machine with no jail. The hook stays read-only.
 *
 * @category rendering
 * @since 0.1.0
 */
export const held = (
  place: Confined,
  writable: ReadonlyArray<string>,
  argv: readonly [string, ...Array<string>]
): readonly [string, ...Array<string>] => jailed(place.jail, [place.home, ...writable], [place.hooks], argv)
