/**
 * What a replay sets up before it runs a step of a past commit: the home and
 * temporary directory the steps of each way get, the hook that refuses a
 * push, the stand-ins for `sudo`, `su` and `doas`, and the jail it holds its
 * steps in.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner, make as makeSpawner } from "effect/process/ChildProcessSpawner"
import {
  ambientEnvironment,
  daemonEnvironment,
  gitConfig,
  hooksDirectory,
  type Place,
  prePush,
  standIns,
  stepEnvironment
} from "./Environment.ts"
import {
  credentials,
  installOf,
  type Jail,
  jailed,
  keyringFilter,
  type Mask,
  type Probe,
  temporaryOf,
  temporaryRoots,
  unjailed
} from "./Jail.ts"

/**
 * The ways a replay runs a commit: the repository's CI as it is, the modes,
 * and the one run that finds what can pass on this machine.
 *
 * @category models
 * @since 0.1.0
 */
export type Way = "baseline" | "normal" | "fast" | "trial"

/**
 * Where the steps of one way of a replay run: their home and temporary
 * directory, the directory of the hook that refuses a push, what they are
 * told of a container daemon, and the jail, when this machine can hold one.
 *
 * @category models
 * @since 0.1.0
 */
export interface Confined extends Place {
  readonly hooks: string
  readonly daemon: Readonly<Record<string, string>>
  readonly jail: Jail | undefined
}

/**
 * The place of each way. No way finds what another left in its home or its
 * temporary directory.
 *
 * @category models
 * @since 0.1.0
 */
export type Places = Readonly<Record<Way, Confined>>

/**
 * Makes a home and a temporary directory for each way under `work`, writes
 * the stand-ins beside them, where a jailed step can run them and not change
 * them, and asks the machine for a jail. Each home starts with the hook and
 * nothing else, and lasts until the replay ends: a tool that keeps a cache
 * for its user fills it once in the baseline, once in normal mode and once in
 * fast mode, so no way is timed with a cache another way paid for. On a
 * machine that cannot jail a step, `say` is told once. `programs` are the
 * paths the replay runs its own programs from. A jailed step finds the
 * machine's temporary directories replaced by its way's own, and still reads
 * there the programs, the caches the machine names, and `work`.
 *
 * A jailed step finds the person's home directory empty. What is put back,
 * read-only, is what it has a use for: the tools on `PATH` that are installed
 * there, the installs of `programs`, and `checkout`, the person's repository.
 * A version manager looks for its versions under `HOME`, so each step's home
 * holds a link to where they are. Nothing else of the home is there: no
 * directory of settings, no history, no file a program keeps a token in,
 * whatever its name.
 *
 * A step never reaches a container daemon: whoever talks to one can have it
 * mount any file of the machine. A step that starts `docker`,
 * `docker-compose`, `podman` or `nerdctl` by name starts a stand-in that
 * refuses with one line, the person's `DOCKER_HOST` is not passed on, and in
 * the jail the daemons' sockets are empty. With `allowDocker` none of the
 * three holds: those programs have no stand-in, the variable is passed, and
 * the sockets stay, also those in the session's runtime directory, which is
 * otherwise hidden whole.
 *
 * A step can leave a directory nothing can be removed from, as Go leaves its
 * module cache, so before `work` is removed everything under the homes and
 * the temporary directories is made writable again.
 *
 * `person` holds the variables of the person who runs the replay. The program
 * keeps them out of its own process, so without `person` they are read from
 * the process.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function confine(
  work: string,
  probe: (environment: Readonly<Record<string, string | undefined>>) => Probe,
  say: (line: string) => void!!,
  programs: ReadonlyArray<string>,
  allowDocker: boolean,
  person?: Readonly<Record<string, string | undefined>>,
  checkout?: string
) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const spawner = try ChildProcessSpawner
  const homes = path.join(work, "home")
  const tmps = path.join(work, "tmp")
  const guard = path.join(work, "guard")
  const environment = person ?? ambientEnvironment()
  try fs.makeDirectory(homes)
  try fs.makeDirectory(tmps)
  try fs.makeDirectory(guard)
  for (const [program, script] of standIns(allowDocker)) {
    const standIn = path.join(guard, program)
    try fs.writeFileString(standIn, script)
    try fs.chmod(standIn, 0o755)
  }
  try addFinalizer(() =>
    ignore(scoped(effect {
      const unlock = ChildProcess.make("chmod", ["-R", "u+rwX", homes, tmps], {
        stdin: "ignore",
        stdout: "ignore",
        stderr: "ignore"
      })
      try (try spawner.spawn(unlock)).exitCode
    }))
  )
  const found = probe(environment)
  effect function make(way: Way) {
    const home = path.join(homes, way)
    const tmp = path.join(tmps, way)
    const hooks = path.join(home, hooksDirectory)
    try fs.makeDirectory(hooks, { recursive: true })
    try fs.makeDirectory(tmp)
    const hook = path.join(hooks, "pre-push")
    try fs.writeFileString(hook, prePush)
    try fs.chmod(hook, 0o755)
    try fs.writeFileString(path.join(home, ".gitconfig"), gitConfig)
    // Where a version manager looks for its versions: under the home, which is the step's own.
    for (const link of "refusal" in found ? [] : found.tools.homes) {
      try fs.makeDirectory(path.dirname(path.join(home, link.path)), { recursive: true })
      try fs.symlink(link.target, path.join(home, link.path))
    }
    return { home, tmp, guard, hooks, daemon: daemonEnvironment(allowDocker, environment) }
  }
  const made = {
    baseline: try make("baseline"),
    normal: try make("normal"),
    fast: try make("fast"),
    trial: try make("trial")
  }
  if ("refusal" in found) {
    try say(unjailed(found.refusal, allowDocker))
    return {
      baseline: { ...made.baseline, jail: undefined },
      normal: { ...made.normal, jail: undefined },
      fast: { ...made.fast, jail: undefined },
      trial: { ...made.trial, jail: undefined }
    } satisfies Places
  }
  // A socket is hidden where it really is: `/var/run` is a link to `/run` on most machines.
  const daemons: Array<string> = []
  for (const socket of found.daemons) {
    const real = fs.realPath(socket) catch () => undefined
    if (real !== undefined && !daemons.includes(real)) daemons.push(real)
  }
  // What a step still reads inside a hidden directory: the tools, the installs of the replay's own programs, and
  // the person's repository. Each is named where it really is.
  const within = (directory: string, each: string): boolean => each.startsWith(`${directory}/`)
  const readable: Array<string> = [...found.tools.reads]
  for (const program of programs) {
    // A program named without its directory is found on `PATH`, among the tools.
    if (!path.isAbsolute(program)) continue
    const real = fs.realPath(program) catch () => undefined
    if (real === undefined || (try fs.stat(real)).type === "Directory") continue
    const marked: Array<string> = []
    for (let directory = path.dirname(real); directory !== path.dirname(directory); directory = path.dirname(directory)) {
      if (try fs.exists(path.join(directory, "pnpm-workspace.yaml"))) marked.push(directory)
    }
    // The install, or what of it lies in a hidden directory: the program's own directory, or the program alone.
    readable.push(installOf(real, (directory) => marked.includes(directory)), path.dirname(real), real)
  }
  if (checkout !== undefined) {
    const repository = fs.realPath(checkout) catch () => undefined
    if (repository !== undefined) readable.push(repository)
  }
  const masks: Array<Mask> = []
  const hidden = [
    found.home,
    ...credentials.map((name) => path.join(found.home, name)),
    ...found.hidden,
    ...(allowDocker ? [] : daemons)
  ]
  for (const each of hidden) {
    // A link is hidden where it leads, so the credential is out of sight by every name it has.
    const real = fs.realPath(each) catch () => undefined
    if (real === undefined) continue
    // What is hidden already, by another name or with the directory it lies in, is hidden once.
    if (masks.some((mask) => mask.path === real || (mask.directory && within(mask.path, real)))) continue
    const directory = (try fs.stat(real)).type === "Directory"
    if (!directory) {
      masks.push({ path: real, directory })
      continue
    }
    // A directory that holds one hidden already takes its place: what is put back there is put back here.
    for (let index = masks.length - 1; index >= 0; index--) {
      if (within(real, (masks[index] as Mask).path)) masks.splice(index, 1)
    }
    // With Docker allowed, a daemon's socket in a hidden directory stays.
    const kept = daemons.filter((socket) => within(real, socket))
    // A path put back inside another that is put back is there already.
    const inside = [...new Set(readable.filter((each) => within(real, each)))]
    const reads = inside.filter((each) => !inside.some((other) => within(other, each)))
    const links = found.tools.links.filter((link) => within(real, link.path) && !reads.some((read) => within(read, link.path)))
    masks.push({
      path: real,
      directory,
      ...(allowDocker ? { kept } : {}),
      ...(reads.length === 0 ? {} : { readable: reads }),
      ...(links.length === 0 ? {} : { links })
    })
  }
  const temporary = temporaryOf(found.tmp)
  const caches: Array<string> = []
  for (const cache of found.caches) {
    if (try fs.exists(cache)) caches.push(cache)
  }
  const visible = [...temporaryRoots(programs, temporary), ...caches, work]
  // The filter that refuses a step the keys of the person's session, where bubblewrap reads it and no step writes it.
  const filter = path.join(work, "keyring-filter")
  try fs.writeFile(filter, keyringFilter())
  const jailOf = (tmp: string): Jail => ({ bwrap: found.bwrap, masks, tmp, temporary, visible, filter })
  return {
    baseline: { ...made.baseline, jail: jailOf(made.baseline.tmp) },
    normal: { ...made.normal, jail: jailOf(made.normal.tmp) },
    fast: { ...made.fast, jail: jailOf(made.fast.tmp) },
    trial: { ...made.trial, jail: jailOf(made.trial.tmp) }
  } satisfies Places
}

/**
 * The command that runs `argv` as a step of the replay: in the jail, where it
 * can write its home, its temporary directory and `writable`, or as it is on
 * a machine with no jail. The hook stays read-only.
 *
 * @category rendering
 * @since 0.1.0
 */
export const held = (
  place: Confined,
  writable: ReadonlyArray<string>,
  argv: readonly [string, ...Array<string>]
): readonly [string, ...Array<string>] => jailed(place.jail, [place.home, ...writable], [place.hooks], argv)

/**
 * The process runner a part is given while it reads `copy`, a checkout of a
 * past commit that a step may have written. What a part starts there runs
 * that commit's code: git runs the commands its repository's configuration
 * names, such as `core.fsmonitor` under `git status` and `git ls-files`, and
 * a step can write that configuration; `zig build` runs the commit's
 * `build.zig` to say what its steps are. So every command the part starts
 * runs as a step of `place` does: in the jail, where it can write the copy
 * and that way's home, with a step's environment, the variables the part
 * itself gives the command, and nothing else of the person's. Each command
 * of a pipe runs so.
 *
 * @category constructors
 * @since 0.1.0
 */
export const reading = (real: ChildProcessSpawner["Service"], place: Confined, copy: string) => {
  const asStep = (command: ChildProcess.Command): ChildProcess.Command => {
    if (command._tag === "PipedCommand") {
      return ChildProcess.pipeTo(asStep(command.left), asStep(command.right), command.options)
    }
    const [program, ...before] = held(place, [copy], [command.command])
    const given: Record<string, string> = {}
    for (const [name, value] of Object.entries(command.options.env ?? {})) {
      if (value !== undefined) given[name] = Redacted.isRedacted(value) ? Redacted.value(value) : value
    }
    return ChildProcess.make(program, [...before, ...command.args], {
      ...command.options,
      // A command is told its repository on the command line or by its directory, never by the program's own.
      cwd: command.options.cwd ?? copy,
      env: stepEnvironment(given, place),
      extendEnv: false
    })
  }
  return makeSpawner((command) => real.spawn(asStep(command)))
}
