/**
 * What a replay sets up before it runs a step of a past commit: the home and
 * temporary directory the steps of each way get, the hook that refuses a
 * push, the stand-ins for `sudo`, `su` and `doas`, and the jail it holds its
 * steps in.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner, make as makeSpawner } from "effect/process/ChildProcessSpawner"
import { gitArguments } from "./Git.vibe"
import {
  ambientEnvironment,
  launcherEnvironment,
  withEnvironment,
  daemonEnvironment,
  gitConfig,
  hooksDirectory,
  jobHomeVariable,
  type Place,
  prePush,
  softwareEnvironment,
  standIns,
  stepEnvironment
} from "./Environment.ts"
import {
  credentials,
  installOf,
  type Jail,
  jailed,
  keyringFilter,
  type Link,
  type Mask,
  type Probe,
  temporaryOf,
  temporaryRoots,
  unjailed
} from "./Jail.ts"

/**
 * The ways a replay runs a commit: the repository's CI as it is, the modes,
 * and the one run that finds what can pass on this machine.
 *
 * @category models
 * @since 0.1.0
 */
export type Way = "baseline" | "normal" | "fast" | "trial"

/**
 * Where the steps of one way of a replay run: their home and temporary
 * directory, the directory of the hook that refuses a push, what they are
 * told of a container daemon, and the jail, when this machine can hold one.
 *
 * @category models
 * @since 0.1.0
 */
export interface Confined extends Place {
  /** A home as every job's starts: the configuration that names the sealed hook, `links`, and nothing else. Never written. */
  readonly template: string
  /** The links every home of a step starts with, from the home: where a version manager looks for its versions. */
  readonly links: ReadonlyArray<{ readonly path: string; readonly target: string }>
  readonly hooks: string
  readonly daemon: Readonly<Record<string, string>>
  readonly jail: Jail | undefined
  /**
   * What the jail keeps in sight for the replay's own `smthrs` alone: where one started from source keeps its
   * compiled code, in the machine's temporary directory. A step has no use for it.
   */
  readonly caches?: ReadonlyArray<string> | undefined
}

/**
 * The place of each way. No way finds what another left in its home or its
 * temporary directory.
 *
 * @category models
 * @since 0.1.0
 */
export type Places = Readonly<Record<Way, Confined>>

/**
 * Checks each name under the controller's work directory, including the root and the leaf.
 * A missing component ends the walk. Removing the first link itself never enters its target.
 */
effect function checkPath(work: string, directory: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const parts = path.relative(work, directory).split(path.sep).filter(Boolean)
  if (directory.split(path.sep).includes("..") || parts[0] === "..") throw new Error(`replay cleanup outside its work directory: ${directory}`)
  let current = path.resolve(work)
  for (const part of ["", ...parts]) {
    current = path.join(current, part)
    const info = fs.lstat(current) catch effect (error) => {
      if (error.reason._tag !== "NotFound") throw error
      return undefined
    }
    if (info === undefined) return false
    if (info.type === "SymbolicLink") {
      try fs.remove(current)
      throw new Error(`replay cleanup refused a symlink: ${current}`)
    }
  }
  return true
}

/** A step can leave a directory nothing can be removed from. Only chmod checked command-line operands. */
effect function unlock(work: string, directories: ReadonlyArray<string>) {
  const present: Array<string> = []
  for (const directory of directories) {
    if (try checkPath(work, directory)) present.push(directory)
  }
  if (present.length === 0) return
  const spawner = try ChildProcessSpawner
  try ignore(scoped(effect {
    const command = ChildProcess.make("chmod", ["-R", "--", "u+rwX", ...present], {
      stdin: "ignore",
      stdout: "ignore",
      stderr: "ignore"
    })
    try (try spawner.spawn(command)).exitCode
  }))
}

/**
 * The name, in a replay's directory, of its clone of the person's repository.
 * git makes the objects of a clone on the same disk links to the repository's
 * own files, so a mode changed there is changed in the repository: nothing in
 * it is made writable, and nothing in it needs to be.
 *
 * @category constants
 * @since 0.1.0
 */
export const sourceDirectory = "source"

/**
 * Makes everything in `work`, a replay's directory, writable again, but its
 * clone of the person's repository ({@link sourceDirectory}).
 */
effect function unlockWork(work: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  try checkPath(work, work)
  const names = fs.readDirectory(work) catch (): ReadonlyArray<string> => []
  const own = names.filter((name) => name !== sourceDirectory).map((name) => path.join(work, name))
  try unlock(work, own)
}

/**
 * Makes `home` a home for steps: the configuration pointing at the shared pre-push hook, `links`, and
 * nothing else. A version manager looks for its versions under the home, so each link leads to where they are.
 */
effect function furnish(home: string, links: Confined["links"], hooks: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  try fs.makeDirectory(home, { recursive: true })
  try fs.writeFileString(path.join(home, ".gitconfig"), gitConfig(hooks))
  for (const link of links) {
    try fs.makeDirectory(path.dirname(path.join(home, link.path)), { recursive: true })
    try fs.symlink(link.target, path.join(home, link.path))
  }
}

/**
 * Makes a home and a temporary directory for each way under `work`, writes
 * the stand-ins beside them, where a jailed step can run them and not change
 * them, and asks the machine for a jail. Each home starts with its Git configuration and tool links. A job never runs in a way's own home for long: a baseline job
 * gets one of its own (`machine`), a mode's is emptied before each commit
 * (`renew`), and Smithers build gives the targets of each job a machine with a
 * home that starts as a copy of `template`. So a tool that keeps a cache for
 * its user fills it again in every job, as on a CI machine, and no way is
 * timed with a cache another way paid for. On a
 * machine that cannot jail a step, `say` is told once. `programs` are the
 * paths the replay runs its own programs from. A jailed step finds the
 * machine's temporary directories replaced by its way's own, and still reads
 * there the programs, the caches the machine names, and `work`.
 *
 * A jailed step finds the person's home directory empty. What is put back,
 * read-only, is what it has a use for: the tools on `PATH` that are installed
 * there, the installs of `programs`, `checkout`, the person's repository, and
 * the software a GitHub runner comes with where the person's variables say it
 * is (`Inventory.runnerSoftware`).
 * A version manager looks for its versions under `HOME`, so each step's home
 * holds a link to where they are. Nothing else of the home is there: no
 * directory of settings, no history, no file a program keeps a token in,
 * whatever its name.
 *
 * A step never reaches a container daemon: whoever talks to one can have it
 * mount any file of the machine. A step that starts `docker`,
 * `docker-compose`, `podman` or `nerdctl` by name starts a stand-in that
 * refuses with one line, the person's `DOCKER_HOST` is not passed on, and in
 * the jail the daemons' sockets are empty. With `allowDocker` none of the
 * three holds: those programs have no stand-in, the variable is passed, and
 * the sockets stay, also those in the session's runtime directory, which is
 * otherwise hidden whole.
 *
 * A step can leave a directory nothing can be removed from, as Go leaves its
 * module cache, so before `work` is removed everything in it is made
 * writable again: the homes, the temporary directories, and the machines of a
 * run that Smithers build set aside and had not removed when it ended. Only
 * the clone of the person's repository is left as it is
 * ({@link sourceDirectory}).
 *
 * `person` holds the variables of the person who runs the replay. The program
 * keeps them out of its own process, so without `person` they are read from
 * the process. A machine without a working jail refuses unless the operator
 * sets SMITHERS_CI_ALLOW_UNCONFINED=1 for a trusted repository. A controller
 * that requires confinement takes precedence over that opt-in.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function confine(
  work: string,
  probe: (environment: Readonly<Record<string, string | undefined>>) => Probe,
  say: (line: string) => void!!,
  programs: ReadonlyArray<string>,
  allowDocker: boolean,
  person?: Readonly<Record<string, string | undefined>>,
  checkout?: string
) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const spawner = try ChildProcessSpawner
  const homes = path.join(work, "home")
  const tmps = path.join(work, "tmp")
  const guard = path.join(work, "guard")
  const environment = person ?? ambientEnvironment()
  const found = probe(environment)
  if ("refusal" in found) {
    const reason = `the replay requires a jail: ${found.refusal}`
    if (environment["SMITHERS_CI_REQUIRE_JAIL"] === "1") throw new Error(reason)
    if (found.trustedRepository !== true && environment["SMITHERS_CI_ALLOW_UNCONFINED"] !== "1") {
      throw new Error(`${reason}. For a trusted repository only, the operator may set SMITHERS_CI_ALLOW_UNCONFINED=1`)
    }
  }
  const hooks = path.join(work, hooksDirectory)
  try fs.makeDirectory(hooks, { recursive: true })
  const hook = path.join(hooks, "pre-push")
  try fs.writeFileString(hook, prePush)
  try fs.chmod(hook, 0o755)
  try fs.makeDirectory(homes)
  try fs.makeDirectory(tmps)
  try fs.makeDirectory(guard)
  for (const [program, script] of standIns(allowDocker)) {
    const standIn = path.join(guard, program)
    try fs.writeFileString(standIn, script)
    try fs.chmod(standIn, 0o755)
  }
  // Not the homes and the temporary directories alone: the machines Smithers build set aside are there too, and
  // the command that removes them ends with the build when the build runs in a jail.
  try addFinalizer(() => ignore(unlockWork(work)))
  // Where a version manager looks for its versions: under the home, which is the step's own with a jail and
  // without one.
  const links = "refusal" in found ? found.homes ?? [] : found.tools.homes
  // What Smithers build starts the home of each job's machine from, in normal and fast mode.
  const template = path.join(homes, "template")
  try furnish(template, links, hooks)
  effect function make(way: Way) {
    const home = path.join(homes, way)
    const tmp = path.join(tmps, way)
    try fs.makeDirectory(tmp)
    try furnish(home, links, hooks)
    return {
      home,
      tmp,
      guard,
      template,
      links,
      hooks,
      daemon: daemonEnvironment(allowDocker, environment)
    }
  }
  const made = {
    baseline: try make("baseline"),
    normal: try make("normal"),
    fast: try make("fast"),
    trial: try make("trial")
  }
  if ("refusal" in found) {
    try say(unjailed(found.refusal, allowDocker))
    return {
      baseline: { ...made.baseline, jail: undefined },
      normal: { ...made.normal, jail: undefined },
      fast: { ...made.fast, jail: undefined },
      trial: { ...made.trial, jail: undefined }
    } satisfies Places
  }
  // A socket is hidden where it really is: `/var/run` is a link to `/run` on most machines.
  const daemons: Array<string> = []
  for (const socket of found.daemons) {
    const real = fs.realPath(socket) catch () => undefined
    if (real !== undefined && !daemons.includes(real)) daemons.push(real)
  }
  // What a step still reads inside a hidden directory: the tools, the installs of the replay's own programs, and
  // the runner's SDKs. Each is named where it really is.
  const within = (directory: string, each: string): boolean => each.startsWith(`${directory}/`)
  const readable: Array<string> = [...found.tools.reads]
  for (const program of programs) {
    // A program named without its directory is found on `PATH`, among the tools.
    if (!path.isAbsolute(program)) continue
    const real = fs.realPath(program) catch () => undefined
    if (real === undefined || (try fs.stat(real)).type === "Directory") continue
    const marked: Array<string> = []
    for (let directory = path.dirname(real); directory !== path.dirname(directory); directory = path.dirname(directory)) {
      if (try fs.exists(path.join(directory, "pnpm-workspace.yaml"))) marked.push(directory)
    }
    // The install, or what of it lies in a hidden directory: the program's own directory, or the program alone.
    readable.push(installOf(real, (directory) => marked.includes(directory)), path.dirname(real), real)
  }
  const repository = checkout === undefined ? undefined : fs.realPath(checkout) catch () => undefined
  // The software a GitHub runner comes with, where this machine has it: a step is told these paths, and an SDK often
  // lies in the home, as `~/Android/Sdk` does. A path that is a link stays a link.
  const softwareLinks: Array<Link> = []
  for (const value of Object.values(softwareEnvironment(environment))) {
    if (!path.isAbsolute(value)) continue
    const real = fs.realPath(value) catch () => undefined
    if (real === undefined) continue
    readable.push(real)
    if (real !== value) softwareLinks.push({ path: value, target: real })
  }
  // A broad tool prefix can itself contain the live checkout. Bind only disjoint tool paths.
  const metadata = repository === undefined ? [] : scoped(effect {
    const command = ChildProcess.make("git", gitArguments(["rev-parse", "--path-format=absolute", "--git-common-dir", "--absolute-git-dir"]), {
      cwd: repository, env: launcherEnvironment, extendEnv: false, stdin: "ignore", stderr: "ignore"
    })
    const child = try spawner.spawn(command)
    const paths = try (child.stdout |> Stream.decodeText(%) |> Stream.mkString(%))
    return Number(try child.exitCode) === 0 ? paths.trimEnd().split("\n") : []
  }) catch (): Array<string> => []
  const privatePaths = repository === undefined ? metadata : [repository, ...metadata]
  const outsideCheckout = (entry: string) => privatePaths.every((root) => entry !== root && !within(root, entry) && !within(entry, root))
  const masks: Array<Mask> = []
  const hidden = [
    found.home,
    ...metadata,
    ...credentials.map((name) => path.join(found.home, name)),
    ...found.hidden,
    ...(repository === undefined ? [] : [repository]),
    ...(allowDocker ? [] : daemons)
  ]
  for (const each of hidden) {
    // A link is hidden where it leads, so the credential is out of sight by every name it has.
    const real = fs.realPath(each) catch () => undefined
    if (real === undefined) continue
    // What is hidden already, by another name or with the directory it lies in, is hidden once.
    if (masks.some((mask) => mask.path === real || (mask.directory && within(mask.path, real)))) continue
    const directory = (try fs.stat(real)).type === "Directory"
    if (!directory) {
      masks.push({ path: real, directory })
      continue
    }
    // A directory that holds one hidden already takes its place: what is put back there is put back here.
    for (let index = masks.length - 1; index >= 0; index--) {
      if (within(real, (masks[index] as Mask).path)) masks.splice(index, 1)
    }
    // With Docker allowed, a daemon's socket in a hidden directory stays.
    const kept = daemons.filter((socket) => within(real, socket))
    // A path put back inside another that is put back is there already.
    const inside = [...new Set(readable.filter((each) => within(real, each) && outsideCheckout(each)))]
    const reads = inside.filter((each) => !inside.some((other) => within(other, each)))
    const links = [...new Map([...found.tools.links, ...softwareLinks].map((link) => [link.path, link])).values()]
      .filter((link) => within(real, link.path) && !reads.some((read) => within(read, link.path)))
    masks.push({
      path: real,
      directory,
      ...(allowDocker ? { kept } : {}),
      ...(reads.length === 0 ? {} : { readable: reads }),
      ...(links.length === 0 ? {} : { links })
    })
  }
  const temporary = temporaryOf(found.tmp)
  const caches: Array<string> = []
  for (const cache of found.caches) {
    if (try fs.exists(cache)) caches.push(cache)
  }
  // bubblewrap refuses to keep in sight a path that is not there. npx puts the `node_modules/.bin` of every
  // directory above the one it starts in on `PATH`, so a replay started under /tmp names /tmp/node_modules.
  const roots: Array<string> = []
  for (const root of temporaryRoots(programs, temporary)) {
    if (try fs.exists(root)) roots.push(root)
  }
  // A tool kept in a temporary directory, as a corepack cache `COREPACK_HOME` names there, stays in sight over the
  // jail's own, read-only as it is everywhere else.
  const tools = found.tools.reads.filter((each) => temporary.some((directory) => within(directory, each)))
  const visible = [...roots, ...caches, ...tools].filter(outsideCheckout).concat(work)
  // The filter that refuses a step the keys of the person's session, where bubblewrap reads it and no step writes it.
  const filter = path.join(work, "keyring-filter")
  try fs.writeFile(filter, keyringFilter())
  const jailOf = (tmp: string): Jail => ({
    bwrap: found.bwrap,
    masks,
    tmp,
    temporary,
    visible,
    filter,
    ...(found.scope === undefined ? {} : { scope: found.scope })
  })
  return {
    baseline: { ...made.baseline, jail: jailOf(made.baseline.tmp), caches },
    normal: { ...made.normal, jail: jailOf(made.normal.tmp), caches },
    fast: { ...made.fast, jail: jailOf(made.fast.tmp), caches },
    trial: { ...made.trial, jail: jailOf(made.trial.tmp), caches }
  } satisfies Places
}

/**
 * Resolve controller commands before hiding the checkout. A local launcher sees the clean committed tree at
 * its own read-only location, with its installed dependencies and the explicitly selected program files.
 * No part of the running checkout is mounted over its mask.
 */
export effect function plannerRuntime<E, R>(
  root: string,
  directory: string,
  commands: ReadonlyArray<string>,
  prepare: () => ReadonlyArray<string>!E!R
) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const repository = try fs.realPath(root)
  const paths = new Map<string, string>()
  const mounts = new Map<string, string>()
  for (const word of commands) {
    if (!path.isAbsolute(word)) continue
    const real = fs.realPath(word) catch () => word
    if (real.startsWith(repository + path.sep)) {
      const target = path.join(directory, path.relative(repository, real))
      paths.set(word, target)
      mounts.set(real, target)
    } else paths.set(word, real)
  }
  if (mounts.size > 0) {
    const packages = try prepare()
    const folders = new Set<string>()
    for (const pkg of ["package.json", ...packages]) {
      const modules = path.join(path.dirname(pkg), "node_modules")
      const source = path.join(repository, modules)
      // A workspace dependency may be a relative link inside node_modules. Keeping the layout makes it
      // resolve into the committed runtime tree. Never mount a directory selected through a live symlink.
      const real = fs.realPath(source) catch () => undefined
      if (real === source) folders.add(source)
    }
    // A file already supplied by a dependency mount needs no second mount.
    for (const file of mounts.keys()) {
      if ([...folders].some((folder) => file.startsWith(folder + path.sep))) mounts.delete(file)
    }
    for (const folder of folders) mounts.set(folder, path.join(directory, path.relative(repository, folder)))
    for (const [source, target] of mounts) {
      // The committed snapshot can contain links. Never create a mount point through one.
      let parent = directory
      for (const part of path.relative(directory, target).split(path.sep)) {
        parent = path.join(parent, part)
        const info = fs.lstat(parent) catch effect (error) => {
          if (error.reason._tag !== "NotFound") throw error
          return undefined
        }
        if (info?.type === "SymbolicLink") throw new Error("a replay launcher mount point is a symlink")
        if (info !== undefined) continue
        if (parent === target && !folders.has(source)) try fs.writeFileString(parent, "", { flag: "wx" })
        else try fs.makeDirectory(parent)
      }
    }
  }
  return { paths, mounts: [...mounts] }
}

/**
 * The command that runs `argv` as a step of the replay: in the jail, where it
 * can write its home, its temporary directory and `writable`, or as it is on
 * a machine with no jail. The hook stays read-only.
 *
 * @category rendering
 * @since 0.1.0
 */
export const held = (
  place: Confined,
  writable: ReadonlyArray<string>,
  argv: readonly [string, ...Array<string>]
): readonly [string, ...Array<string>] => jailed(place.jail, [place.home, ...writable], [place.hooks], argv)

/**
 * Removes `directory` and everything in it. A step can leave a tree deeper
 * than the longest path the system takes, which the platform's removal cannot
 * walk: `rm` then removes it, a directory at a time. When removing a subtree,
 * pass its work root so that every component is checked before either removal.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function removeTree(directory: string, work: string = directory) {
  const fs = try FileSystem.FileSystem
  if (!(try checkPath(work, directory))) return
  fs.remove(directory, { recursive: true, force: true }) catch effect (cause) => {
    if (!(try checkPath(work, directory))) return
    const spawner = try ChildProcessSpawner
    const command = ChildProcess.make("rm", ["-rf", "--", directory], { stdin: "ignore", stdout: "ignore", stderr: "ignore" })
    try ignore(scoped(effect {
      try (try spawner.spawn(command)).exitCode
    }))
    if (try fs.exists(directory)) throw cause
  }
}

/**
 * An empty directory at `directory`, made writable and removed when the scope
 * closes. What an earlier run left there is removed first: a step can leave a
 * directory nothing can be removed from, so everything is made writable before.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function fresh(directory: string, work: string = directory) {
  const fs = try FileSystem.FileSystem
  const clear = effect {
    if (!(try checkPath(work, directory))) return
    try unlock(work, [directory])
    try removeTree(directory, work)
  }
  try clear
  try fs.makeDirectory(directory, { recursive: true })
  try addFinalizer(() => ignore(clear))
  return directory
}

/**
 * Removes `directory`, a replay's directory, and everything in it, also
 * where a step left a directory nothing can be removed from. What still
 * cannot be removed is reported once to the caller.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function discard(directory: string, say: (line: string) => void!! = () => Effect.void) {
  effect {
    try unlockWork(directory)
    try removeTree(directory)
  } catch effect () => { try say(`smithers-ci: replay left a directory it could not remove: ${directory}`) }
}

/**
 * The place of one job: the home `home` and the temporary directory `tmp`,
 * beside the stand-ins, the daemon and what the jail hides of `place`, its
 * way. A runner gives every job the same paths, so a job is given stable
 * ones at every commit (`Summary.machinePaths`): a tool that
 * wrote one of them into what a cache step saved finds it again when a later
 * job restores it. Both are empty but for the hook, as a CI runner starts each
 * job, and both are removed when the scope closes: no other job and no other
 * commit finds what the job wrote there.
 *
 * `alone` is true for a job that has a machine of its own in every mode. Its
 * target finds in `/tmp` what the job wrote and nothing else, so its baseline
 * step is shown the same: the compiled code the replay's own `smthrs` keeps
 * in the machine's temporary directory (`Confined.caches`) is out of sight.
 * The steps of a job with no machine run beside that `smthrs` in a mode, and
 * see what it sees in both.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function machine(place: Confined, home: string, tmp: string, alone: boolean = false) {
  const work = (try Path.Path).dirname(place.guard)
  try fresh(home, work)
  try fresh(tmp, work)
  try furnish(home, place.links, place.hooks)
  const own = alone ? place.caches ?? [] : []
  return {
    ...place,
    home,
    tmp,
    jail: place.jail === undefined
      ? undefined
      : { ...place.jail, tmp, visible: place.jail.visible.filter((each) => !own.includes(each)) }
  } satisfies Confined
}

/**
 * Empties the home and the temporary directory of `place`, the place of a
 * mode: the home starts with fresh Git configuration and tool links. A replay does this
 * before a mode runs a commit, as a CI runner starts every run with a home
 * nothing wrote to. What a mode keeps from one commit to the next is in its
 * copy's cache directory, which the generated workflow carries between runs.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function renew(place: Confined) {
  const fs = try FileSystem.FileSystem
  const work = (try Path.Path).dirname(place.guard)
  try unlock(work, [place.home, place.tmp])
  try removeTree(place.home, work)
  try removeTree(place.tmp, work)
  try fs.makeDirectory(place.tmp)
  try furnish(place.home, place.links, place.hooks)
}

/**
 * What a `smthrs` of `place` is told beside a step's environment: the home
 * the machine of every job starts from. Smithers build runs the targets of
 * one job in a checkout, a home and a temporary directory of the job's own,
 * made for the run and removed with it, so no job finds what another job or
 * another commit wrote.
 *
 * @category rendering
 * @since 0.1.0
 */
export const jobHomes = (place: Confined): Readonly<Record<string, string>> => ({ [jobHomeVariable]: place.template })

/**
 * The process runner a part is given while it reads `copy`, a checkout of a
 * past commit that a step may have written. What a part starts there runs
 * that commit's code: git runs the commands its repository's configuration
 * names, such as `core.fsmonitor` under `git status` and `git ls-files`, and
 * a step can write that configuration; `zig build` runs the commit's
 * `build.zig` to say what its steps are. So every command the part starts
 * runs as a step of `place` does: in the jail, where it can write the copy
 * and that way's home, with a step's environment, the variables the part
 * itself gives the command, and nothing else of the person's. Each command
 * of a pipe runs so.
 *
 * @category constructors
 * @since 0.1.0
 */
export const reading = (real: ChildProcessSpawner["Service"], place: Confined, copy: string) => {
  const asStep = (command: ChildProcess.Command): ChildProcess.Command => {
    if (command._tag === "PipedCommand") {
      return ChildProcess.pipeTo(asStep(command.left), asStep(command.right), command.options)
    }
    const given: Record<string, string> = {}
    for (const [name, value] of Object.entries(command.options.env ?? {})) {
      if (value !== undefined) given[name] = Redacted.isRedacted(value) ? Redacted.value(value) : value
    }
    const workload = withEnvironment(stepEnvironment(given, place), [command.command])
    const [program, ...args] = held(place, [copy], workload)
    return ChildProcess.make(program, [...args, ...command.args], {
      ...command.options,
      // A command is told its repository on the command line or by its directory, never by the program's own.
      cwd: command.options.cwd ?? copy,
      env: launcherEnvironment,
      extendEnv: false
    })
  }
  return makeSpawner((command) => real.spawn(asStep(command)))
}
