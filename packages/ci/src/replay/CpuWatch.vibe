/**
 * Reads the machine's processes while a replay runs, and keeps the CPU time
 * of each step that is running.
 *
 * @since 0.1.0
 */

import { cpuMsOf, type CpuMeter, meterOf, observe } from "./Cpu.ts"
import type { Table, TableHost } from "./Stall.vibe"

/**
 * How often every process of the machine is read when no one says, where
 * the processes under a step cannot be read alone. A step's last moments
 * before it ends are not seen, so a shorter time counts more of a short step
 * and costs more reading: 2,500 processes cost 90 ms of processor time each
 * time.
 *
 * @category constants
 * @since 0.1.0
 */
export const defaultCpuTick: Duration.Input = "2 seconds"

/**
 * The longest time between two readings of the processes under one step,
 * where the machine says which processes a process started (`Table.under`).
 * Reading one step's processes costs the same however busy the machine is,
 * so they are read often: every two seconds lost a third of the CPU time of
 * a job of four 10 s steps.
 *
 * @category constants
 * @since 0.1.0
 */
export const nearTick: Duration.Input = "250 millis"

/**
 * The shortest time between two readings of the processes under one step.
 *
 * @category constants
 * @since 0.1.0
 */
export const leastTick: Duration.Input = "50 millis"

/**
 * A step's processes are read again when this share of the time the step has
 * run has passed, between {@link leastTick} and {@link nearTick}. What a
 * step uses after its last reading is not seen, so a step that takes half a
 * second and one that takes a minute each lose a twentieth of their time at
 * most, and a step under a second is not lost whole between two readings.
 *
 * @category constants
 * @since 0.1.0
 */
export const shareOfAge = 1 / 20

/**
 * Counts the CPU time of process trees. `track` starts counting the tree
 * under a process and gives what ends the count: the milliseconds the tree
 * was seen to use, or `undefined` when this machine's processes could not be
 * read while it ran.
 *
 * @category models
 * @since 0.1.0
 */
export interface CpuWatch {
  readonly track: (pid: number) => () => number | undefined
}

/**
 * A watch that reads `table` until its scope closes: the processes under
 * each step as often as {@link shareOfAge} says, never less often than every
 * `tick`, and where the table cannot read one step's processes, every
 * process of the machine every `tick`.
 *
 * @category constructors
 * @since 0.1.0
 */
export effect function cpuWatch(table: Table, tick: Duration.Input = defaultCpuTick) {
  const clock = try Clock.Clock
  const meters = new Map<CpuMeter, { read: boolean; readonly started: number; last: number }>()
  const most = Duration.toMillis(Duration.min(Duration.fromInputUnsafe(tick), Duration.fromInputUnsafe(nearTick)))
  const least = Math.min(most, Duration.toMillis(Duration.fromInputUnsafe(leastTick)))
  // Whether one step's processes can be read alone: a table that has the reader may still find that this kernel
  // lists no process's children, and says so the first time it is asked.
  let alone = table.under
  effect function whole() {
    const entries = try table.read
    if (entries === undefined) return
    for (const [meter, state] of meters) {
      observe(meter, entries)
      state.read = meter.seen.size > 0
    }
  }
  effect function each(under: NonNullable<Table["under"]>) {
    for (const [meter, state] of [...meters]) {
      const now = clock.currentTimeMillisUnsafe()
      const due = Math.min(most, Math.max(least, (now - state.started) * shareOfAge))
      if (now - state.last < due) continue
      const entries = try under(meter.root)
      if (entries === undefined) {
        alone = undefined
        return
      }
      observe(meter, entries)
      state.read = meter.seen.size > 0
      state.last = now
    }
  }
  effect function reading() {
    while (true) {
      const under = alone
      try sleep(under === undefined ? tick : Duration.millis(least))
      // Nothing is read while no step runs.
      if (meters.size === 0) continue
      if (under === undefined) try whole()
      else try each(under)
    }
  }
  fork.scoped reading()
  return {
    track: (pid) => {
      const meter = meterOf(pid)
      const now = clock.currentTimeMillisUnsafe()
      const state = { read: false, started: now, last: now }
      meters.set(meter, state)
      return () => {
        meters.delete(meter)
        return state.read ? cpuMsOf(meter) : undefined
      }
    }
  } satisfies CpuWatch
}

/**
 * The host services a watch needs: what reading the processes needs, and the
 * scope its reading ends with.
 *
 * @category models
 * @since 0.1.0
 */
export type CpuHost = TableHost | Scope.Scope
