/**
 * Scores rows: for each, the chance its target fails on its change.
 *
 * @since 0.1.0
 */

import { Action, Flow, type FlowRuntime, Interpreter, RetryPolicy } from "@smthrs/flow"
import * as Semaphore from "effect/Semaphore"
import type { Digest } from "effect/crypto/Digest"
import type { SecureRandom } from "effect/crypto/SecureRandom"
import { Classifier, type Evaluator } from "@smthrs/model"
import { Node } from "@smthrs/plan"
import { Features, type Row } from "../contract/Selection.vibe"
import { failure, unavailable } from "./Failure.vibe"
import * as Scoring from "./Scoring.vibe"

/**
 * The durable step: one request to the judge for one batch of feature sets.
 * Its recorded answer replays, so a run that resumes pays for no batch twice.
 * The engine tries a request the judge failed up to `Scoring.attempts` times.
 *
 * @category flows
 * @since 0.1.0
 */
export const ScoreBatch = Action.make("ci/select/ScoreBatch", {
  payload: { items: Schema.Array(Features), questions: Schema.String },
  success: Schema.Array(Scoring.Reading),
  error: Classifier.ClassifierError,
  nondeterministic: true,
  retryPolicy: RetryPolicy.make({ initialMs: 250, factor: 2, maxMs: 5000, maxAttempts: Scoring.attempts })
})

/**
 * The flow that scores one batch. `questions` is the digest of what the judge
 * is asked. Equal batches under equal questions are one execution, so a
 * recorded answer never replays for a question that has since changed.
 *
 * @category flows
 * @since 0.1.0
 */
export const ScoreFlow = Flow.make("ci/select/Score", {
  payload: { items: Schema.Array(Features), questions: Schema.String },
  success: Schema.Array(Scoring.Reading),
  error: Classifier.ClassifierError,
  body: Node.capture({}, (payload) => ScoreBatch.call(payload))
})

/**
 * A count that starts at 0.
 *
 * @category constructors
 * @since 0.1.0
 */
export function counter(): Asked.Shape {
  let answered = 0
  return {
    add: (questions: number) =>
      sync(() => {
        answered += questions
      }),
    total: () => sync(() => answered)
  }
}

/**
 * How many questions the judge has answered: one per feature set of each
 * batch it answered. A batch whose recorded answer replays asks nothing and
 * adds nothing. A host that reports the count provides its own
 * ({@link layerAsked}); without one, every program in the process shares one
 * count.
 *
 * @category services
 * @since 0.1.0
 */
export service Asked {
  add(questions: number): void!!
  total(): number!!
  static readonly defaultValue = () => counter()
}

/**
 * A count of its own for one run of a program.
 *
 * @category layers
 * @since 0.1.0
 */
export const layerAsked = Layer.sync(Asked, counter)

/** A place that keeps nothing. */
const forgetful: Kept.Shape = { get: () => succeed(undefined), set: () => Effect.void }

/**
 * The answers the judge gave in this run of the program, by feature set
 * (`Scoring.keyOf`). {@link score} asks only about the feature sets it finds
 * no answer for, so a feature set is asked about once in a run, whichever
 * change it comes back in. A host with no place of its own keeps none.
 *
 * @category services
 * @since 0.1.0
 */
export service Kept {
  readonly locks?: (key: string) => Semaphore.Semaphore
  get(key: string): (Scoring.Reading | undefined)!!
  set(key: string, reading: Scoring.Reading): void!!
  static readonly defaultValue = () => forgetful
}

/**
 * A place in memory for the answers of one run of a program.
 *
 * @category layers
 * @since 0.1.0
 */
export const layerKept = Layer.sync(Kept, () => {
  const held = new Map<string, Scoring.Reading>()
  const locks = new Map<string, Semaphore.Semaphore>()
  return {
    locks: (key: string) => {
      const found = locks.get(key)
      if (found !== undefined) return found
      const lock = Semaphore.makeUnsafe(1)
      locks.set(key, lock)
      return lock
    },
    get: (key: string) => sync(() => held.get(key)),
    set: (key: string, reading: Scoring.Reading) =>
      sync(() => {
        held.set(key, reading)
      })
  }
})

/**
 * How many questions the judge has answered so far.
 *
 * @category scores
 * @since 0.1.0
 */
export effect function asked() {
  return try (try Asked).total()
}

/**
 * Asks the host's judge about one batch, and counts the questions it answered.
 *
 * @category flows
 * @since 0.1.0
 */
export effect function judge(items: ReadonlyArray<Features>) {
  const answers = try Scoring.classifier(items.length).evaluate(Scoring.stateOf(items))
  try (try Asked).add(items.length)
  return Scoring.readingsOf(items.length, answers)
}

/**
 * Registers {@link ScoreFlow} and its step with the host's flow engine.
 * {@link score} provides it for each call.
 *
 * @category layers
 * @since 0.1.0
 */
export const layer = Interpreter.layerWithImplementations(ScoreFlow, ScoreBatch.toLayer(({ items }) => judge(items)))

/**
 * What {@link score} needs from its host: the judge, a flow engine, and
 * Effect's `Digest` and `SecureRandom`.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = Evaluator.Evaluator | FlowRuntime.FlowRuntime | Digest | SecureRandom

const cacheKey = (features: Features) => JSON.stringify([Scoring.classifier(1).digest, Scoring.stateOf([features])])

/**
 * One score per row, from 0 to 1, with a one-line reason.
 *
 * Rows with equal features share one question, and a feature set the host
 * keeps an answer for ({@link Kept}) is not asked about again. The questions
 * go to the host's judge in batches, each batch one durable flow step on the
 * host's flow engine. A judge that cannot answer fails `model-unavailable`;
 * nothing is scored by guess.
 *
 * @category scores
 * @since 0.1.0
 */
export effect function score(rows: ReadonlyArray<Row>) {
  const kept = try Kept
  const work = scoreWith(rows, kept)
  // Concurrent callers sharing a cache acquire matching feature locks in the same order.
  if (kept.locks === undefined) return try work
  const locks = kept.locks
  const keys = [...new Set(rows.map((row) => cacheKey(row.features)))].sort()
  return try keys.reduce((effect, key) => locks(key).withPermits(1)(effect), work)
}

effect function scoreWith(rows: ReadonlyArray<Row>, kept: Kept.Shape) {
  const known = new Map<string, Scoring.Reading>()
  const unanswered: Array<Row> = []
  for (const row of rows) {
    const key = Scoring.keyOf(row.features)
    if (known.has(key)) continue
    const reading = try kept.get(cacheKey(row.features))
    if (reading === undefined) unanswered.push(row)
    else known.set(key, reading)
  }
  const asked = Scoring.batches(unanswered)
  provide layer, Flow.layerExecutionIds(Flow.derived) {
    // Every batch settles before any failure is reported, so one failed batch never cuts another off mid-request.
    const settled = try Effect.forEach(
      asked,
      (items) => Effect.result(ScoreFlow.execute({ items, questions: JSON.stringify([Scoring.classifier(items.length).digest, Scoring.stateOf(items)]) })),
      { concurrency: Scoring.concurrency }
    )
    const answered: Array<ReadonlyArray<Scoring.Reading>> = []
    for (const batch of settled) {
      if (Result.isFailure(batch)) throw failure("model-unavailable", unavailable(batch.failure))
      answered.push(batch.success)
    }
    for (const [batch, items] of asked.entries()) {
      for (const [item, features] of items.entries()) try kept.set(cacheKey(features), answered[batch]![item]!)
    }
    return Scoring.scoresOf(rows, asked, answered, known)
  }
}
