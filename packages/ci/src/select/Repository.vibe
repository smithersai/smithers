/**
 * What a repository's history says about one change, read with git.
 *
 * @since 0.1.0
 */

import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Failure } from "../contract/Parts.vibe"
import { errorLine } from "../contract/Command.vibe"
import { failure } from "./Failure.vibe"
import { type Commit, day, horizonDays } from "./Features.vibe"
import { runGit } from "../inventory/HostGit.vibe"

/**
 * One change as its repository records it: when it was made, the files it
 * touched, the commits of the 56 days before it, and every file at it.
 *
 * @category models
 * @since 0.1.0
 */
export interface Change {
  readonly at: number
  readonly files: ReadonlyArray<string>
  readonly history: ReadonlyArray<Commit>
  readonly tree: ReadonlyArray<string>
}

/**
 * Reads a change from the repository at `root`. It starts its processes
 * with the runner of whoever calls it, so a caller that holds a repository's
 * `git` in a jail holds this one's too.
 *
 * @category services
 * @since 0.1.0
 */
export service Repository {
  change(root: string, commit: string): Change!Failure!ChildProcessSpawner
}

/** With -z, paths are literal and only NUL separates them. */
const paths = (text: string): ReadonlyArray<string> => text.split("\0").filter((file) => file !== "")

/** Two NULs start a commit header. Git inserts one newline before its first path, even if the path starts with a newline. */
const commitsOf = (text: string): ReadonlyArray<Commit> =>
  text.split(/\0{2,}/).slice(1).map((block) => {
    const [seconds, ...files] = paths(block.replace("\0\n", "\0"))
    return { at: Number(seconds) * 1000, files }
  })

/** Runs one git command in `root` with the caller's process runner: its exit code and what it printed. */
effect function run(root: string, args: ReadonlyArray<string>) {
  const result = runGit(root, root, ["-c", "core.quotePath=false", ...args]) catch effect (error) => {
    throw failure("command-failed", `git ${args[0]} could not run in ${root}: ${error.message}`)
  }
  return { ...result, diagnostic: errorLine(result.diagnostic) }
}

/** What one git command printed, or `command-failed` when it exits nonzero. */
effect function read(root: string, args: ReadonlyArray<string>) {
  const { code, text, diagnostic } = try run(root, args)
  if (code !== 0) throw failure("command-failed", `git ${args[0]} exited ${code} in ${root}${diagnostic ? `: ${diagnostic}` : ""}`)
  return text
}

/**
 * Reads changes with the `git` on the host's path, started with the process
 * runner of the caller. The replay calls it with a runner that holds `git`
 * in the jail: `root` is then a copy a step may have written, with its
 * `.git/config`.
 *
 * A directory that is no git repository fails `not-a-repository`, a commit
 * the repository does not hold fails `invalid-document`, and a git command
 * that cannot run or exits nonzero fails `command-failed`.
 *
 * @category layers
 * @since 0.1.0
 */
export const layerGit = Layer.sync(Repository, () => {
  let previous: { readonly root: string; readonly oid: string; readonly at: number; readonly history: ReadonlyArray<Commit>; readonly files: ReadonlyArray<string> } | undefined
  return {
    change: effect (root: string, commit: string) => {
      const shallow = try run(root, ["rev-parse", "--is-shallow-repository"])
      if (shallow.code !== 0) {
        if (!shallow.diagnostic.includes("not a git repository")) throw failure("command-failed", `git rev-parse exited ${shallow.code}: ${shallow.diagnostic}`)
        throw failure("not-a-repository", `${root} is not a git repository`)
      }
      if (shallow.text.trim() === "true") throw failure("invalid-document", `The history at ${root} is shallow`)
      const resolved = try run(root, ["rev-parse", "--verify", "--end-of-options", `${commit}^{commit}`])
      if (resolved.code !== 0) throw failure("invalid-document", `The repository at ${root} holds no commit ${commit}`)
      const oid = resolved.text.trim()
      const shown = try read(root, ["show", "--no-patch", "--format=%ct%n%P", oid, "--"])
      const [seconds, parents = ""] = shown.split("\n")
      const at = Number(seconds) * 1000
      const parent = parents.split(" ")[0]!
      const tree = paths(try read(root, ["ls-tree", "-z", "-r", "--name-only", oid]))
      const files = parent === "" ? tree : paths(try read(root, ["diff", "--no-renames", "-z", "--name-only", parent, oid, "--"]))
      const since = Math.max(0, Math.floor((at - horizonDays * day) / 1000))
      // A parent older than the window can itself have a parent inside it when commit clocks are out of order.
      const prior = previous
      const history: ReadonlyArray<Commit> = parent === "" ? [] :
        prior !== undefined && prior.root === root && prior.oid === parent && prior.at <= at
          ? [{ at: prior.at, files: prior.files }, ...prior.history].filter((entry) => entry.at >= since * 1000)
          : commitsOf(try read(root, ["log", "--no-renames", "-z", `--since-as-filter=@${since} +0000`, "--format=%x00%x00%ct", "--name-only", parent]))
      // At a merge the next log must visit all parents, including the side branch.
      previous = parents.includes(" ") ? undefined : { root, oid, at, files, history }
      return { at, files, history, tree }
    }
  }
})
