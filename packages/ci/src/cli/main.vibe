/**
 * Runs `smithers-ci` on Node: the host services every part may ask for,
 * `NodeHost.layer` from `@smthrs/platform-node`, plus the standard streams
 * and terminal the command line needs.
 *
 * @since 0.1.0
 */

import { NodeStdio, NodeTerminal } from "@effect/platform-node"
import { NodeHost } from "@smthrs/platform-node"
import { cli, type Parts } from "./Cli.vibe"
import { parts } from "./parts.ts"

/**
 * The host the program provides to itself and to every part.
 *
 * @category layers
 * @since 0.1.0
 */
export const layer = Layer.mergeAll(NodeHost.layer, NodeStdio.layer, NodeTerminal.layer)

/**
 * Runs the program with `args` in the repository at `root` over the given
 * parts, and resolves to the exit code.
 *
 * @category running
 * @since 0.1.0
 */
export async function run(args: ReadonlyArray<string>, root: string, chosen: Parts<NodeHost.NodeHost>): Promise<number> {
  return await runPromise(Effect.provide(cli(args, root, chosen), layer))
}

/**
 * Runs the program over the parts on `main`.
 *
 * @category running
 * @since 0.1.0
 */
export async function main(args: ReadonlyArray<string>, root: string): Promise<number> {
  return await run(args, root, parts)
}
