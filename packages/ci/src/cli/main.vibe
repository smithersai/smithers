/**
 * Runs `smithers-ci` on Node over the host in `Host.vibe`.
 *
 * @since 0.1.0
 */

import { cli, type Parts } from "./Cli.vibe"
import { type Environment, type Host, layer } from "./Host.vibe"
import { parts } from "./parts.ts"

/**
 * Runs the program with `args` in the repository at `root` over the given
 * parts, and resolves to the exit code. `environment` chooses fast mode's
 * judge.
 *
 * @category running
 * @since 0.1.0
 */
export async function run(
  args: ReadonlyArray<string>,
  root: string,
  environment: Environment,
  chosen: Parts<Host>
): Promise<number> {
  return await runPromise(Effect.provide(cli(args, root, chosen), layer(environment)))
}

/**
 * Runs the program over the parts on `main`.
 *
 * @category running
 * @since 0.1.0
 */
export async function main(args: ReadonlyArray<string>, root: string, environment: Environment): Promise<number> {
  return await run(args, root, environment, parts)
}
