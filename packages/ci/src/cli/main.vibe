/**
 * Runs `smithers-ci` on Node over the host in `Host.vibe`.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { exitCodes as codes, name } from "../contract/Command.ts"
import { recorderRefusal } from "../replay/Environment.ts"
import { discard } from "../replay/index.ts"
import { cli, type Parts } from "./Cli.vibe"
import { type Environment, type Host, layer } from "./Host.vibe"
import { parts } from "./parts.ts"
import { deaf, exitCodes, idle, type Listen, type Signal, uncaught } from "./Signals.ts"
import { broken, nothingTold, stoppedCode, type Told, unanswered } from "./Stage.ts"

/**
 * The top directory of the repository that holds `directory`, as git names
 * it; `directory` itself when it is in no repository, which each command
 * then reports in its own words.
 *
 * @category accessors
 * @since 0.1.0
 */
export effect function rootOf(directory: string) {
  const spawner = try ChildProcessSpawner
  const top = spawner.string(ChildProcess.make("git", ["-C", directory, "rev-parse", "--show-toplevel"])) catch () => ""
  return top.trim() === "" ? directory : top.trim()
}

/**
 * Ends with a signal's exit code when the first of the signals arrives. It
 * stops listening to both then, and when it is interrupted, so a second
 * signal ends the process at once.
 */
const signalled = (listen: Listen) =>
  callback<number>((resume) => {
    const stops: Array<() => void> = []
    const stop = () => stops.forEach((each) => each())
    const hear = (signal: Signal) =>
      stops.push(listen(signal, () => {
        stop()
        resume(succeed(exitCodes[signal]))
      }))
    hear("SIGINT")
    hear("SIGTERM")
    return sync(stop)
  })

/**
 * Ends with the first error nothing caught, wherever it was thrown. It stops
 * listening then, and when it is interrupted.
 */
const thrown = (listen: Listen) =>
  callback<unknown>((resume) => {
    const stops: Array<() => void> = []
    const stop = () => stops.forEach((each) => each())
    for (const event of uncaught) {
      stops.push(listen(event, (cause) => {
        stop()
        resume(succeed(cause))
      }))
    }
    return sync(stop)
  })

/**
 * Ends when nothing is left that could wake the program: what it still
 * waits for will never answer. It stops listening when it is interrupted.
 */
const drained = (listen: Listen) => callback<void>((resume) => sync(listen(idle, () => resume(Effect.void))))

/**
 * Ends the program's work and leaves the machine as a program that ended by
 * itself does: its steps are stopped and its temporary copies removed. Work
 * that will not end, because it waits where it cannot be interrupted, is
 * left where it is, and the directories its replay kept its copies in are
 * removed here.
 */
effect function ended(working: Fiber.Fiber<number>, told: Ref.Ref<Told>, listen: Listen) {
  try.race [Fiber.interrupt(working), drained(listen)]
  for (const directory of (try Ref.get(told)).directories) try discard(directory)
}

/**
 * Runs the program with `args` from `directory`, a directory of the
 * repository, over the given parts, and resolves to the exit code.
 * `environment` chooses fast mode's judge.
 *
 * A signal `listen` hears interrupts the program: its steps are stopped and
 * its temporary copies removed before this resolves, to the signal's exit
 * code.
 *
 * The program always ends with an exit code of its own and a line. Work that
 * stops before it has an answer is ended the same way, with one line on
 * standard error that says where it was, and the exit code `failed`: an error
 * no part answers for, an error nothing caught, and work that waits for an
 * answer when `listen` hears that nothing is left that could give one.
 *
 * @category running
 * @since 0.1.0
 */
export async function run(
  args: ReadonlyArray<string>,
  directory: string,
  environment: Environment,
  chosen: Parts<Host>,
  listen: Listen = deaf
): Promise<number> {
  const program = effect {
    // A recorder Smithers build does not know would be its default without a word: refused before anything runs.
    const refused = recorderRefusal(environment)
    if (refused !== undefined) {
      try Console.error(`${name}: ${refused}. Run ${name} --help for the commands and flags.`)
      return codes.usage
    }
    return try cli(args, try rootOf(directory), chosen, directory)
  }
  return await runPromise(effect {
    const told = try Ref.make<Told>(nothingTold)
    provide layer(environment, told) {
      const working = fork.detached program
      const first = try.race [
        map(Fiber.await(working), (exit) =>
          Exit.isSuccess(exit)
            ? ({ _tag: "answered", code: exit.value }) as const
            : ({ _tag: "broken", cause: Cause.squash(exit.cause) }) as const
        ),
        map(signalled(listen), (code) => ({ _tag: "signalled", code }) as const),
        map(thrown(listen), (cause) => ({ _tag: "broken", cause }) as const),
        as(drained(listen), { _tag: "drained" } as const)
      ]
      if (first._tag === "answered") return first.code
      if (first._tag === "signalled") {
        try ended(working, told, listen)
        return first.code
      }
      const said = try Ref.get(told)
      try Console.error(first._tag === "drained" ? unanswered(said) : broken(said, first.cause))
      try ended(working, told, listen)
      return stoppedCode
    }
  })
}

/**
 * Runs the program over the parts on `main`.
 *
 * @category running
 * @since 0.1.0
 */
export async function main(
  args: ReadonlyArray<string>,
  directory: string,
  environment: Environment,
  listen: Listen = deaf
): Promise<number> {
  return await run(args, directory, environment, parts, listen)
}
