/**
 * Runs `smithers-ci` on Node over the host in `Host.vibe`.
 *
 * @since 0.1.0
 */

import { cli, type Parts } from "./Cli.vibe"
import { type Host, layer } from "./Host.vibe"
import { parts } from "./parts.ts"

/**
 * The host the program provides to itself and to every part.
 *
 * @category layers
 * @since 0.1.0
 */
export { layer }

/**
 * Runs the program with `args` in the repository at `root` over the given
 * parts, and resolves to the exit code.
 *
 * @category running
 * @since 0.1.0
 */
export async function run(args: ReadonlyArray<string>, root: string, chosen: Parts<Host>): Promise<number> {
  return await runPromise(Effect.provide(cli(args, root, chosen), layer))
}

/**
 * Runs the program over the parts on `main`.
 *
 * @category running
 * @since 0.1.0
 */
export async function main(args: ReadonlyArray<string>, root: string): Promise<number> {
  return await run(args, root, parts)
}
