/**
 * The parts `smithers-ci` runs with, each imported from its own directory
 * through contract 10.
 *
 * @since 0.1.0
 */

import { planned } from "../apply/Planned.vibe"
import { split } from "../decompose/index.ts"
import { files } from "../generate/index.vibe"
import { read, readHere } from "../inventory/index.vibe"
import * as Native from "../native/index.vibe"
import { run } from "../replay/index.vibe"
import { html, text } from "../report/index.vibe"
import { asked, rows, score } from "../select/index.vibe"
import type { Parts } from "./Cli.vibe"
import type { Host } from "./Host.vibe"

/**
 * Every part, as the program calls them. `planned` asks Smithers build to
 * plan the files `apply` would write.
 *
 * @category parts
 * @since 0.1.0
 */
export const parts: Parts<Host> = {
  read,
  readHere,
  decompose: split,
  files,
  run: Native.run<Host>(run),
  text,
  html,
  rows,
  score,
  asked,
  planned
}
