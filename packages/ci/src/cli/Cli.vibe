/**
 * The `smithers-ci` program: contract 7's commands, flags and exit codes,
 * run over contract 10's parts.
 *
 * The program implements no part. It parses the command line, calls the parts
 * it is given, prints their documents, writes what `apply` and `--out` ask
 * for, and turns the outcome into one exit code.
 *
 * @since 0.1.0
 */

import { CliConfig, CliError, CliOutput, Command, Flag, GlobalFlag } from "effect/cli"
import { type Change, check } from "../apply/index.vibe"
import * as Surface from "../contract/Command.vibe"
import {
  allowingDocker,
  changesMachine,
  ci,
  Inventory,
  keepingPrograms,
  keptOnRunner,
  type NotReplayed,
  notReplayed,
  ownWorkspace,
  refusal
} from "../contract/Inventory.vibe"
import {
  type AskedQuestions,
  type BuildRows,
  type Decompose,
  type Failure,
  type GeneratedFile,
  type GenerateFiles,
  type ReadInventory,
  type RenderReport,
  type ReplayRequest,
  type RunReplay,
  type ScoreRows,
  writtenFiles
} from "../contract/Parts.vibe"
import { wholeScriptSentence } from "../contract/Reasons.vibe"
import { ReplayReport } from "../contract/ReplayReport.vibe"
import type { Mode } from "../contract/RunRecord.vibe"
import * as Native from "../native/index.vibe"
import { runningAsRoot } from "./Root.ts"
import { uncommittedFooter } from "../native/Workspace.vibe"
import * as Preflight from "./Preflight.vibe"

/**
 * The parts the program calls, one function each, as contract 10 names them.
 * `R` is the host services they need; the program provides them.
 *
 * @category models
 * @since 0.1.0
 */
export interface Parts<R> {
  readonly read: ReadInventory<R>
  /**
   * Reads the CI for this machine, for a replay: a job this machine cannot run is marked. Without it a replay
   * reads with `read`.
   */
  readonly readHere?: ReadInventory<R> | undefined
  readonly decompose: Decompose<R>
  /**
   * The split that starts no program of the repository: it reads files and nothing else. `apply`, `apply --check`
   * and `inventory` split with it, so that listing a stranger's repository, or checking its generated files, runs
   * none of its code on this machine, and so that `apply` writes the same files on a machine with the
   * repository's tools as on one without. A replay splits with `decompose`. Without it, every command does.
   */
  readonly decomposeStatic?: Decompose<R> | undefined
  readonly files: GenerateFiles<R>
  readonly run: RunReplay<R>
  readonly text: RenderReport
  readonly html: RenderReport
  readonly rows: BuildRows<R>
  readonly score: ScoreRows<R>
  /** How many questions the model has answered, for the report; without it the report gives the time alone. */
  readonly asked?: AskedQuestions<R> | undefined
  /**
   * The jobs Smithers build will not run, from the files `apply` would write, each with Smithers build's words.
   * Without it, every job the generator wrote is written.
   */
  readonly planned?:
    | ((root: string, files: ReadonlyArray<GeneratedFile>) => ReadonlyArray<NotReplayed>!Failure!R)
    | undefined
}

/**
 * The exit code for a part's failure, from contract 7's `failureExitCodes`.
 *
 * @category exit codes
 * @since 0.1.0
 */
export function exitCodeOf(failure: Failure): number {
  return Surface.failureExitCodes[failure.code]
}

/** A terminal's control sequences: an escape with what it introduces, to the byte that ends it. */
// eslint-disable-next-line no-control-regex -- The escape and bell characters are what this expression removes.
const controlSequence = /\u001b(?:\[[0-?]*[ -/]*[@-~]|\][^\u0007\u001b]*(?:\u0007|\u001b\\)?|[@-Z\\^_])/g

/**
 * Text of a repository, or of a program it ran, as the terminal may show it: a control sequence is taken out, and
 * every other control character but newline and tab becomes U+FFFD. What a past commit printed can then neither
 * move the cursor, clear the screen nor rename the window.
 *
 * @category exit codes
 * @since 0.1.0
 */
export function shown(value: string): string {
  return value.replace(controlSequence, "").replace(/[^\P{Cc}\n\t]/gu, "\uFFFD")
}

/**
 * The one line the program prints for a part's failure. A model that cannot
 * be reached is the person's to fix, so that line names no part of the program.
 * A message can repeat what a repository's own program printed, so it is
 * printed as `shown` gives it.
 *
 * @category exit codes
 * @since 0.1.0
 */
export function lineOf(failure: Failure): string {
  return shown(
    failure.code === "model-unavailable"
      ? `${Surface.name}: ${failure.message}`
      : `${Surface.name}: ${failure.part}: ${failure.message}`
  )
}

const failed = (message: string): Failure => ({ code: "command-failed", message, part: "cli" })

/** The inventory with each job Smithers build refused marked with why, so it is left out as any job is. */
const refusedIn = (inventory: Inventory, refused: ReadonlyArray<NotReplayed>): Inventory => {
  const why = new Map(refused.map((entry) => [entry.job, entry.reasons]))
  return {
    ...inventory,
    jobs: inventory.jobs.map((job) => {
      const reasons = why.get(job.id)
      return reasons === undefined ? job : { ...job, unsupported: [...job.unsupported, ...reasons] }
    })
  }
}

/** Renders a report; a renderer that throws is the report part's failure. */
effect function render(renderer: RenderReport, report: ReplayReport) {
  return try Effect.try({
    try: () => renderer(report),
    catch: (error): Failure => ({ code: "command-failed", message: `could not render the report: ${Surface.errorLine(error)}`, part: "report" })
  })
}

/**
 * A `--cache` value as a URL parser reads it, or `undefined` when it is no http or https URL. It is parsed once, by
 * the parser everything that later reads the value uses, so what is checked here is what is read there. A value with
 * a space or a control character is none: a parser drops a tab or a line end from a URL, and the generated workflow
 * holds the value as it was typed, where a line end would break the line it is written on.
 *
 * @category accessors
 * @since 0.1.0
 */
export const cacheUrlOf = (value: string): URL | undefined => {
  // Written with both slashes: a parser reads `https:/host` and `https:host` as the same URL, and no workflow should.
  if (/[\s\p{Cc}]/u.test(value) || !/^https?:\/\//i.test(value) || !URL.canParse(value)) return undefined
  // Its scheme is http or https: the test above reads the scheme as the parser does.
  return new URL(value)
}

/** True for a `--cache` URL that names a user or a password, however its slashes are written. */
const hasCredential = (value: string): boolean => {
  const url = cacheUrlOf(value)
  return url !== undefined && (url.username !== "" || url.password !== "")
}

/**
 * A usage error repeats the value it refuses, and a URL's user name and
 * password are a secret: they are cut out of what is printed. Everything
 * from a scheme's colon and slashes to the last `@` of the word goes, so a
 * value written with one slash or none (`https:/user:word@host`, which a URL
 * parser still reads as a credential) loses its password too.
 */
const withoutCredential = (text: string): string => text.replace(/(\b[a-z][a-z0-9+.-]*:\/*)[^\s"]*@/gi, "$1")

/**
 * Parser and selector errors both echo arguments and are presented on one line. They name jobs, whose ids a
 * repository's workflow chooses, so the line is printed as `shown` gives it.
 */
const usageMessage = (message: string): string => withoutCredential(shown(message).replace(/\s+/g, " ").trim())

const atLeastOne = (): string => "1 or more"

/** A flag's help from contract 7, with its default when it has a value. */
const helpOf = (flag: keyof typeof Surface.flags): string => {
  const { default: fallback, help } = Surface.flags[flag]
  return fallback === "" || fallback === "false" ? help : `${help} Default: ${fallback}.`
}

const commits = Flag.Int("commits").pipe(
  Flag.filter((value) => value >= 1, atLeastOne),
  Flag.withDefault(Number(Surface.flags.commits.default)),
  Flag.withDescription(helpOf("commits"))
)

const mode = Flag.Literals("mode", ["normal", "fast", "both"]).pipe(
  Flag.withDefault(Surface.flags.mode.default),
  Flag.withDescription(helpOf("mode"))
)

const jobs = Flag.Int("jobs").pipe(
  Flag.filter((value) => value >= 1, atLeastOne),
  Flag.optional,
  Flag.withDescription(helpOf("jobs"))
)

const cache = Flag.String("cache").pipe(
  Flag.filter((value) => cacheUrlOf(value) !== undefined, () => "an http or https URL"),
  Flag.filter(
    (value) => !hasCredential(value),
    () => "a URL with no user name or password; the cache's token is read from SMITHERS_CACHE_TOKEN"
  ),
  Flag.optional,
  Flag.withDescription(helpOf("cache"))
)

const job = Flag.String("job").pipe(
  Flag.atLeast(0),
  Flag.withDescription(helpOf("job"))
)

const targets = Flag.String("targets").pipe(
  Flag.map((value) => value.split(",").map((pattern) => pattern.trim()).filter((pattern) => pattern !== "")),
  Flag.filter((patterns) => patterns.length > 0, () => "one or more Smithers build patterns, such as //packages/ci/..."),
  Flag.optional,
  Flag.withDescription(helpOf("targets"))
)

const out = Flag.String("out").pipe(
  Flag.filter((value) => value.length > 0, () => "a file path"),
  Flag.optional,
  Flag.withDescription(helpOf("out"))
)

const json = Flag.Boolean("json").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("json"))
)

const allowRoot = Flag.Boolean("allow-root").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("allow-root"))
)

const allowDocker = Flag.Boolean("allow-docker").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("allow-docker"))
)

const noTrial = Flag.Boolean("no-trial").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("no-trial"))
)

const noApplyCheck = Flag.Boolean("no-apply-check").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("no-apply-check"))
)

const cold = Flag.Boolean("cold").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("cold"))
)

const reruns = Flag.Int("reruns").pipe(
  Flag.filter((value) => value >= 0, () => "0 or more"),
  Flag.withDefault(Number(Surface.flags.reruns.default)),
  Flag.withDescription(helpOf("reruns"))
)

const stallMinutes = Flag.Finite("stall-minutes").pipe(
  Flag.filter((value) => value > 0, () => "a number of minutes above 0"),
  Flag.withDefault(Number(Surface.flags["stall-minutes"].default)),
  Flag.withDescription(helpOf("stall-minutes"))
)

const replayFlags = {
  commits,
  mode,
  jobs,
  cache,
  job,
  targets,
  noTrial,
  noApplyCheck,
  cold,
  reruns,
  stallMinutes,
  out,
  json,
  allowRoot,
  allowDocker
}

const checkOnly = Flag.Boolean("check").pipe(
  Flag.withDefault(false),
  Flag.withDescription(helpOf("check"))
)

/** What `apply --check` prints for one file `apply` would change. */
const changeLine = (change: Change): string => {
  const what = {
    missing: "is missing",
    differs: "is out of date",
    unused: "is no longer used"
  }[change.change]
  return `${change.path} ${what}: run ${Surface.name} apply`
}

/** What `--mode` asks the replay to run. */
const modes: Record<"normal" | "fast" | "both", ReadonlyArray<Mode>> = {
  normal: ["normal"],
  fast: ["fast"],
  both: ["normal", "fast"]
}

interface ReplayInput {
  readonly commits: number
  readonly mode: "normal" | "fast" | "both"
  readonly jobs: Option.Option<number>
  readonly cache: Option.Option<string>
  readonly job: ReadonlyArray<string>
  readonly targets: Option.Option<ReadonlyArray<string>>
  readonly out: Option.Option<string>
  readonly json: boolean
  readonly allowRoot: boolean
  readonly allowDocker: boolean
  readonly noTrial: boolean
  readonly noApplyCheck: boolean
  readonly cold: boolean
  readonly reruns: number
  readonly stallMinutes: number
}

/**
 * Who runs the program. A replay starts a repository's past commands, and as
 * root nothing on the machine is out of their reach.
 *
 * @category services
 * @since 0.1.0
 */
export service RunningUser {
  readonly isRoot: () => boolean
  static readonly defaultValue = () => ({ isRoot: runningAsRoot })
}

const rootRefusal =
  `${Surface.name}: refusing to run as root, where a past commit's commands could change this machine; run it as another user, or pass --allow-root to accept that`

const requestOf = (root: string, input: ReplayInput): ReplayRequest => ({
  root,
  commits: input.commits,
  modes: modes[input.mode],
  jobs: Option.getOrUndefined(input.jobs),
  cache: Option.getOrUndefined(input.cache),
  targets: Option.getOrUndefined(input.targets),
  ...(input.job.length === 0 ? {} : { only: input.job }),
  trial: !input.noTrial,
  ...(input.noApplyCheck ? {} : { applied: true }),
  warm: !input.cold,
  reruns: input.reruns,
  stallMinutes: input.stallMinutes,
  ...(input.allowDocker ? { allowDocker: true } : {})
})

/**
 * Why the jobs asked for (`--job`) cannot be replayed as asked, or nothing when they can: a repository that builds
 * with Smithers build is replayed by its own targets, fast mode is not measured over some jobs only, and every id
 * must name a job of the CI.
 */
const jobRefusal = (input: ReplayInput, read: Inventory): string | undefined => {
  if (input.job.length === 0) return undefined
  if (Option.isSome(input.targets) || ownWorkspace(read) !== undefined) {
    return "--job chooses CI jobs, and --targets the targets of a repository that builds with Smithers build: give one"
  }
  if (input.mode !== "normal") {
    return "--job is not measured with fast mode: give --mode normal, or leave --job out to measure fast mode over every job"
  }
  const unknown = Surface.unknownJobs(read, input.job)
  return unknown.length === 0 ? undefined : Surface.unknownJobsSentence(read, unknown)
}

/** The inventory as the person has it replayed and applied: with `--allow-docker`, the jobs that run Docker too. */
const allowed = (inventory: Inventory, allow: boolean): Inventory => allow ? allowingDocker(inventory) : inventory


/** A document as indented JSON, checked against its schema on the way out. */
effect function documentOf<S extends Schema.Top>(schema: S, value: S["Type"], part: Failure["part"]) {
  const encoded = Schema.encodeUnknownEffect(schema)(value) catch effect (error) => {
    throw { code: "invalid-document", message: error.message, part } satisfies Failure
  }
  return JSON.stringify(encoded, null, 2)
}

/** Repository text for a terminal: control characters other than newline and tab become U+FFFD. */
const clean = (value: string): string => value.replace(/[^\P{Cc}\n\t]/gu, "\uFFFD")

/**
 * `within`, the path from the repository's top directory to a file, when the file is inside the repository, or
 * `undefined` when it is outside it. A name that only starts with two dots, as `..report.html` does, is inside; a
 * path on another drive, which Windows gives back whole, is outside.
 *
 * @category accessors
 * @since 0.1.0
 */
export const insideOf = (
  paths: { readonly isAbsolute: (path: string) => boolean; readonly sep: string },
  within: string
): string | undefined =>
  within === ".." || within.startsWith(`..${paths.sep}`) || paths.isAbsolute(within) ? undefined : within

/**
 * A plain listing of an inventory for a person. A command's later lines are
 * indented under its first, and nothing from the repository reaches the
 * terminal as a control character.
 */
function inventoryText(inventory: Inventory): string {
  const lines = [`${inventory.repository} at ${inventory.commit}`]
  // What belongs to a file and to no job: a workflow that does not parse is seen here or nowhere.
  for (const unsupported of inventory.unsupported ?? []) {
    lines.push(`unsupported ${unsupported.feature}: ${unsupported.detail}`)
  }
  // Several jobs of one file may set the same tool up: it is listed once.
  const tools = inventory.toolchains.map((tool) =>
    `toolchain ${tool.name}${tool.version === undefined ? "" : ` ${tool.version}`} (${tool.source})`
  )
  lines.push(...new Set(tools))
  for (const job of inventory.jobs) {
    const needs = job.needs.length === 0 ? "" : `, needs ${job.needs.join(", ")}`
    lines.push(`job ${job.id} (${job.source} ${job.file}${needs})`)
    for (const step of job.steps) {
      const where = step.cwd === "" || step.cwd === "." ? "" : `  (in ${step.cwd})`
      lines.push(`  $ ${step.command.replaceAll("\n", "\n    ")}${where}`)
      // A step that runs a script of several commands and cannot be split says why.
      if (step.whole !== undefined) lines.push(`    ${wholeScriptSentence(step.whole)}`)
    }
    for (const unsupported of job.unsupported) {
      lines.push(`  unsupported ${unsupported.feature}: ${unsupported.detail}`)
    }
  }
  return clean(lines.join("\n"))
}

/** Refuses a generated path that is empty, absolute, leaves the root, or repeats. */
effect function checkPaths(files: ReadonlyArray<GeneratedFile>) {
  const seen = new Set<string>()
  for (const file of files) {
    const segments = file.path.split(/[\\/]/)
    const escapes = file.path === "" || /^([\\/]|[A-Za-z]:)/.test(file.path) || segments.includes("..")
    if (escapes || seen.has(file.path)) {
      const reason = escapes ? "is not inside the repository" : "appears twice"
      throw { code: "invalid-document", message: `generated path ${JSON.stringify(file.path)} ${reason}`, part: "generate" } satisfies Failure
    }
    seen.add(file.path)
  }
  return files
}

/**
 * Writes one file, creating its directory. A host error becomes a `cli` failure.
 *
 * The content is written to a new file beside the path, which then takes the path's place in one step. A file
 * already there is never opened for writing: one that shares its content with a file elsewhere, as every file of a
 * checkout copied with hard links does, would otherwise change in both places. With `within`, the directory the
 * file goes into must really be that one: a directory that became a link since the paths were checked is refused.
 */
effect function write(path: string, content: string, within: string) {
  const fs = try FileSystem.FileSystem
  const paths = try Path.Path
  const directory = paths.dirname(path)
  const staged = paths.join(directory, `.${paths.basename(path)}.${(try Random.nextInt).toString(36)}.smithers-ci`)
  const written = scoped(effect {
    try fs.makeDirectory(directory, { recursive: true })
    const real = try fs.realPath(directory)
    if (real !== within) {
      throw failed(`${directory} is now ${real}, and no generated file is written through a link`)
    }
    // A new file, never one that is there: `wx` fails for a name that exists, a link included.
    const previous = fs.lstat(path) catch effect (error) => {
      if (error.reason._tag !== "NotFound") throw error
      return undefined
    }
    const mode = previous?.type === "File" ? previous.mode & 0o777 : undefined
    const file = try acquireRelease(fs.open(staged, { flag: "wx", mode }), (_, exit) =>
      Exit.isFailure(exit) ? ignore(fs.remove(staged, { force: true })) : Effect.void
    )
    try file.writeAll(new TextEncoder().encode(content))
    if (mode !== undefined) try fs.chmod(staged, mode)
    try fs.rename(staged, path)
  })
  written catch effect (error) => {
    throw failed(`could not write ${path}: ${error.message}`)
  }
}

/** Removes one file an earlier smithers-ci wrote. A host error becomes a `cli` failure. */
effect function remove(path: string) {
  const fs = try FileSystem.FileSystem
  fs.remove(path) catch effect (error) => {
    throw failed(`could not remove ${path}: ${error.message}`)
  }
}

/** The feature the inventory records when the working tree differs from the commit it names. */
const uncommitted = "uncommitted-changes"

/** What the default command's report ends with: what the run wrote to the repository. */
const wroteLine = (file: string | undefined): string =>
  file === undefined ? "This run wrote nothing to the repository." : `This run wrote one file to the repository: ${file}.`

/**
 * The command tree. `root` is the repository's top directory and `directory`
 * where the program was started, which a relative `--out` is read from. A
 * handler that finishes sets its exit code in `status`; a part's failure
 * leaves through the error channel.
 */
function commandOf<R>(root: string, directory: string, parts: Parts<R>, status: Ref.Ref<number>) {
  const settle = (code: number) => Ref.set(status, code)

  /** True when the jobs asked for cannot be replayed as asked (`jobRefusal`): it has said why and set the exit code. */
  effect function refusesJobs(input: ReplayInput, read: Inventory) {
    const why = jobRefusal(input, read)
    if (why === undefined) return false
    try Console.error(`${Surface.name}: ${usageMessage(why)}`)
    try settle(Surface.exitCodes.usage)
    return true
  }

  /** True when the program is root and was not told that is fine: it has said so and set the exit code. */
  effect function refusesRoot(input: ReplayInput) {
    const user = try RunningUser
    if (input.allowRoot || !user.isRoot()) return false
    try Console.error(rootRefusal)
    try settle(Surface.exitCodes.usage)
    return true
  }

  /** The split of the commands that only read the repository, or write its generated files. */
  const still = parts.decomposeStatic ?? parts.decompose
  const replayParts = {
    read: parts.readHere ?? parts.read,
    decompose: parts.decompose,
    files: parts.files,
    rows: parts.rows,
    score: parts.score,
    asked: parts.asked
  }
  /**
   * The files `apply` writes. Smithers build plans them first: a job it will not run stays in the repository's own
   * workflow, named with its words, and so does every job that needs it, and the files are made again without them.
   */
  const generate = (read: Inventory, cache: Option.Option<string>, allowDocker: boolean) =>
    effect {
      // A job on a Linux runner keeps what its steps leave running until it ends; one on macOS stays as it is.
      let inventory = keepingPrograms(read, keptOnRunner)
      while (true) {
        const why = Native.refusal(inventory) ?? refusal(inventory)
        if (why !== undefined) throw { code: "unsupported", message: why, part: "inventory" } satisfies Failure
        // Nothing of the repository runs for its files to be written or checked: the split only reads.
        const split = try still(root, ci(inventory))
        // The workflow's own check runs `apply` as it was run here.
        // A job left out stays in the repository's own workflow, and the notes name it with why.
        const options = {
          cache: Option.getOrUndefined(cache),
          left: notReplayed(inventory),
          ...(allowDocker ? { allowDocker } : {})
        }
        const all = try checkPaths(try parts.files(split, options))
        // Every path is checked before Smithers build plans: a refusal of a path is said as itself.
        const checked = try check(root, all)
        // A statement, not `cond ? [] : try ...`: with a `yield*` ending a conditional on the line before, the
        // coverage converter (ast-v8-to-istanbul 1.0.5 to 1.0.8) counts the `if` below as never false, though V8
        // counted the line after it.
        let refused: ReadonlyArray<NotReplayed> = []
        if (parts.planned !== undefined) refused = try parts.planned(root, all)
        // The target map is the program's own document: it is not written into the repository.
        if (refused.length === 0) return { files: writtenFiles(all), checked }
        inventory = refusedIn(inventory, refused)
      }
    }

  /**
   * Where the `--out` file `file` really is. `link` is the first link in its path below the repository's top
   * directory, when there is one: the page is not written through it, wherever it leads, because a link in a
   * stranger's repository names a file of the person's. `written` is the path from the repository's top directory
   * when the file's real location is inside the repository and nothing refuses the write.
   */
  effect function placeOfOut(file: string) {
    const fs = try FileSystem.FileSystem
    const paths = try Path.Path
    const realRoot = fs.realPath(root) catch () => root
    let canonical = paths.parse(file).root
    for (const segment of file.slice(canonical.length).split(paths.sep)) {
      const next = paths.join(canonical, segment)
      const below = insideOf(paths, paths.relative(realRoot, next))
      if (below) {
        const leads = fs.readLink(next) catch () => undefined
        if (leads !== undefined) return { link: below, written: undefined, canonical: next }
        canonical = next
      } else {
        // An external prefix, including an alias for the repository or one of its ancestors.
        canonical = fs.realPath(next) catch () => next
      }
    }
    return { link: undefined, written: insideOf(paths, paths.relative(realRoot, canonical)), canonical }
  }

  /** The failure for an `--out` file whose path holds the link `link`. */
  const throughLink = (file: string, link: string): Failure =>
    failed(`could not write ${file}: ${link} is a link, and the report is not written through a link in the repository`)

  /**
   * Asks the model one small question when the replay will need it, so a model that cannot answer stops the
   * program before anything is copied or run.
   */
  effect function checkModel(input: ReplayInput) {
    if (input.mode === "normal") return
    parts.score([Preflight.row]) catch effect (cause) => {
      if (cause.code !== "model-unavailable") throw cause
      throw { ...cause, message: `${cause.message} ${Preflight.withoutTheModel}` } satisfies Failure
    }
  }

  /**
   * Replays and prints. A replay runs commits, so changes that are not committed are named on standard error
   * before it starts. `footer` is given the report and the `--out` file when it is inside the repository. A report
   * whose fast mode could not be measured is printed whole, and the program then says so and exits `failed`.
   */
  effect function replayAndPrint(
    input: ReplayInput,
    read: Inventory,
    footer: (report: ReplayReport, written: string | undefined) => string
  ) {
    const paths = try Path.Path
    const target = Option.map(input.out, (out) => paths.resolve(directory, out))
    // Refused before the replay, which can take hours, and again where the page is written.
    if (Option.isSome(target)) {
      const early = try placeOfOut(target.value)
      if (early.link !== undefined) throw throughLink(target.value, early.link)
    }
    try checkModel(input)
    if (read.unsupported?.some((entry) => entry.feature === uncommitted)) {
      try Console.error(`${Surface.name}: the working tree has changes that are not committed; a replay runs commits, so they are not replayed`)
    }
    const report = try parts.run(requestOf(root, input), replayParts)
    const document = try documentOf(ReplayReport, report, "replay")
    // The page is written after the report is printed, so the footer says where it will be before it is there: its
    // real location, whatever link the path the person gave goes through.
    let place: { readonly link: string | undefined; readonly written: string | undefined; readonly canonical: string } = {
      canonical: "",
      link: undefined,
      written: undefined
    }
    if (Option.isSome(target)) place = try placeOfOut(target.value)
    const written = place.written
    // The report is printed first: a page that cannot be written, or rendered, then loses nothing of a replay that
    // took hours. The program still says so and fails.
    try Console.log(input.json ? document : `${try render(parts.text, report)}${footer(report, written)}`)
    if (Option.isSome(target)) {
      // A link a step of the replay left in the path: the report is printed, and the page is not written.
      if (place.link !== undefined) throw throughLink(target.value, place.link)
      try write(place.canonical, try render(parts.html, report), paths.dirname(place.canonical))
      try Console.error(`${Surface.name}: wrote ${place.canonical}`)
    }
    // A replay the disk stopped is reported to the commit before, and is a failure of the program's own.
    if (report.stopped !== undefined) {
      try Console.error(shown(`${Surface.name}: ${report.stopped}`))
      try settle(Surface.exitCodes.failed)
      return
    }
    if (report.fastNotMeasured !== undefined) {
      try Console.error(shown(`${Surface.name}: fast mode was not measured. ${report.fastNotMeasured}`))
      try settle(Surface.exitCodes.failed)
      return
    }
    try settle(report.mismatches > 0 ? Surface.exitCodes.mismatch : Surface.exitCodes.ok)
  }

  const apply = Command.make("apply", { cache, check: checkOnly, allowDocker }, effect (input) => {
    // Every path was checked before the first is written, so a refusal leaves nothing written.
    const read = allowed(try parts.read(root), input.allowDocker)
    const { files, checked } = try generate(read, input.cache, input.allowDocker)
    if (input.check) {
      // What the writes below would change, from the same files: nothing is written.
      for (const change of checked.changes) try Console.log(changeLine(change))
      if (checked.changes.length === 0) try Console.log(`${Surface.name}: the generated files are up to date`)
      try settle(checked.changes.length === 0 ? Surface.exitCodes.ok : Surface.exitCodes.mismatch)
      return
    }
    const paths = try Path.Path
    const fs = try FileSystem.FileSystem
    const realRoot = fs.realPath(root) catch () => root
    for (const file of files) {
      // Each goes into the directory the check found for it, and takes the place of the file there in one step.
      try write(paths.join(root, file.path), file.content, paths.join(realRoot, paths.dirname(file.path)))
      try Console.log(`wrote ${file.path}`)
    }
    // What an earlier smithers-ci wrote where the repository's own tools read it: its content is in the files above.
    for (const former of checked.former) {
      try remove(paths.join(root, former))
      try Console.log(`removed ${former}`)
    }
    try Console.log(`${Surface.name}: wrote ${files.length} files`)
  }).pipe(Command.withDescription(Surface.commands.apply))

  /**
   * The inventory with why each step that runs a script of several commands stays one step (`Step.whole`), as the
   * splitter finds it. A CI nothing of which can be run, or that cannot be split here, is listed as it was read.
   */
  effect function withWholeScripts(read: Inventory) {
    const narrowed = ci(read)
    if (narrowed.jobs.length === 0) return read
    const split = still(root, narrowed) catch () => narrowed
    const whys = new Map(split.jobs.flatMap((job) =>
      job.steps.flatMap((step) => step.whole === undefined ? [] : [[step.id, step.whole] as const])
    ))
    const told = (step: Inventory["jobs"][number]["steps"][number]) => {
      const why = whys.get(step.id)
      return why === undefined ? step : { ...step, whole: why }
    }
    return { ...read, jobs: read.jobs.map((job) => ({ ...job, steps: job.steps.map(told) })) }
  }

  const inventory = Command.make("inventory", { json }, effect (input) => {
    const found = try parts.read(root)
    // A document that breaks its contract is refused before anything is read from it.
    try documentOf(Inventory, found, "inventory")
    const read = try withWholeScripts(found)
    try Console.log(input.json ? try documentOf(Inventory, read, "inventory") : inventoryText(read))
  }).pipe(Command.withDescription(Surface.commands.inventory))

  const replay = Command.make("replay", replayFlags, effect (input) => {
    if (try refusesRoot(input)) return
    const read = allowed(try parts.read(root), input.allowDocker)
    if (try refusesJobs(input, read)) return
    try replayAndPrint(input, read, () => "")
  }).pipe(Command.withDescription(Surface.commands.replay))

  return Command.make(Surface.name, replayFlags, effect (input) => {
    if (try refusesRoot(input)) return
    const read = allowed(try parts.read(root), input.allowDocker)
    if (try refusesJobs(input, read)) return
    // The footer says what the replay did, which the report holds: it ran the newest commit, and the inventory
    // was read from the working tree. A report with `targets` is a replay of the repository's own targets.
    const own = ownWorkspace(read)
    if (own !== undefined) {
      try replayAndPrint(input, read, (report, written) =>
        `\n\n${(report.targets === undefined ? uncommittedFooter : Native.footer)(own, wroteLine(written))}`)
      return
    }
    // A job that installs packages this machine already has is replayed, and `apply`, which writes the same files
    // on every machine, leaves it out. When that is every job, the replay still runs and `apply` has nothing to write.
    // `apply` writes a job on a Linux runner that leaves a program running (`generate`), so it is no reason here.
    const applied = keepingPrograms(read, keptOnRunner)
    const applies = refusal(applied) === undefined
    const installs = notReplayed(applied).some((entry) => entry.reasons.some((reason) => reason.feature === changesMachine))
    const here = applies || !installs ? read : allowed(try replayParts.read(root), input.allowDocker)
    const { files } = try generate(here, input.cache, input.allowDocker)
    const wouldApply = applies
      ? `${Surface.name} apply would write ${files.length} files.`
      : `${Surface.name} apply would write nothing: every job here changes the machine, so it stays in your CI as it is.`
    try replayAndPrint(input, read, (report, written) =>
      report.targets === undefined
        ? `\n\n${wouldApply} ${wroteLine(written)}`
        : `\n\n${Native.footer(undefined, wroteLine(written))}`)
  }).pipe(
    Command.withDescription(Surface.commands[""]),
    Command.withSubcommands([apply, inventory, replay])
  )
}

const reasonsOf = (errors: ReadonlyArray<{ readonly message: string }>): string =>
  errors.map((error) => usageMessage(error.message)).join("; ")

/**
 * Help goes to standard output. A usage error is one line on standard error
 * that points at `--help`, never a page of help.
 */
const presenter = CliOutput.layerPresenter({
  present: (event) =>
    event._tag === "InvalidInvocation"
      ? Console.error(`${Surface.name}: ${reasonsOf(event.errors)}. Run ${Surface.name} --help for the commands and flags.`)
      : CliOutput.defaultPresenter.present(event)
})

/**
 * Runs `smithers-ci` with `args` against the repository at `root`, started
 * from `directory` inside it, and returns its exit code. The only built-in
 * flag is `--help`.
 *
 * @category running
 * @since 0.1.0
 */
export effect function cli<R>(args: ReadonlyArray<string>, root: string, parts: Parts<R>, directory: string = root) {
  const status = try Ref.make<number>(Surface.exitCodes.ok)
  const run = Command.runWith(commandOf(root, directory, parts, status), { version: "0.1.0" })(args)
  provide CliConfig.layer({ builtIns: [GlobalFlag.Help] }), presenter {
    const outcome = run catch effect (error) => {
      if (CliError.isCliError(error)) return Surface.exitCodes.usage
      try Console.error(lineOf(error))
      return exitCodeOf(error)
    }
    return outcome === undefined ? try Ref.get(status) : outcome
  }
}
