/**
 * The host `smithers-ci` provides to itself and to every part on Node.
 *
 * - `NodeHost.layer` from `@smthrs/platform-node`: file system, paths,
 *   processes, jj and HTTP; plus the standard streams and terminal the
 *   command line needs.
 * - Fast mode's services, for the select part: an in-memory ledger for this
 *   run, git history, an in-memory flow engine for the judge's durable steps,
 *   Web Crypto, and the judge `smthrs` binds: Jev with `AI_GATEWAY_API_KEY`,
 *   else the model this machine is signed in to.
 * - How a replay runs in a stranger's checkout: this install's `smthrs`, and
 *   its targets package linked into the checkout.
 * - What a replay is running, one line on standard error as each mode of each
 *   commit starts.
 *
 * @since 0.1.0
 */

import { NodeStdio, NodeTerminal } from "@effect/platform-node"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Evaluator } from "@smthrs/model"
import { NodeHost } from "@smthrs/platform-node"
import type { Failure } from "../contract/Parts.ts"
import { name } from "../contract/Command.ts"
import { Options, Progress } from "../replay/index.ts"
import { Ledger, Repository } from "../select/index.ts"
import { smthrsCommand, targetsDirectory } from "./Install.ts"

/** An environment, read once at the composition root and never printed. */
export type Environment = Readonly<Record<string, string | undefined>>

const node = Layer.mergeAll(NodeHost.layer, NodeStdio.layer, NodeTerminal.layer)

/**
 * The judge `smthrs` binds, over the model transport `smthrs` builds from the
 * same environment. `@smthrs/cli` loads at the first judgment, so a command
 * that asks no judge starts without it.
 */
const judge = (environment: Environment) => {
  const seat = effect {
    const NodeControl = try promise(() => import("@smthrs/cli/NodeControl"))
    const transport = NodeControl.layerRebuildableRequestExecutor(NodeControl.environmentDispatcher(environment))
    return NodeControl.layerSeatEvaluator(environment).pipe(Layer.provide(transport))
  }
  return Layer.succeed(Evaluator.Evaluator, Evaluator.Evaluator.of({
    evaluate: (request) =>
      effect {
        const evaluate = effect {
          const evaluator = try Evaluator.Evaluator
          return try evaluator.evaluate(request)
        }
        return try Effect.provide(evaluate, try seat)
      }
  }))
}

/** How often a failed target runs again before its verdict is `fail`; a pass on a rerun is `flaky`. */
const reruns = 2

const cannot = (message: string): Failure => ({ code: "command-failed", message, part: "cli" })

/**
 * How a replay runs on this machine. `smthrs` starts Smithers build. `targets`
 * is the directory of the `@smthrs/targets` package, linked into each checkout
 * because the generated `PACKAGE.ts` imports it and a stranger's repository
 * does not have it.
 *
 * @category layers
 * @since 0.1.0
 */
export const replayOptions = (smthrs: readonly [string, ...Array<string>], targets: string | undefined) =>
  Layer.effect(Options, effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    return {
      smthrs,
      reruns,
      prepare: effect (checkout: string) => {
        if (targets === undefined) {
          throw cannot("this install of smithers-ci has no @smthrs/targets package to give the checkout")
        }
        const scope = path.join(checkout, "node_modules", "@smthrs")
        const link = path.join(scope, "targets")
        const linked = fs.exists(link) catch () => false
        if (linked) return
        all([fs.makeDirectory(scope, { recursive: true }), fs.symlink(targets, link)]) catch effect (cause) => {
          throw cannot(`could not link @smthrs/targets into ${checkout}: ${cause.message}`)
        }
      }
    }
  })

/**
 * Prints what a replay is running on standard error, which leaves standard
 * output to the report.
 *
 * @category layers
 * @since 0.1.0
 */
export const replayProgress = Layer.succeed(Progress, { say: (line: string) => Console.error(`${name}: ${line}`) })

/**
 * Every service the program and its parts may ask for, with the judge read
 * from `environment`.
 *
 * @category layers
 * @since 0.1.0
 */
export const layer = (environment: Environment) =>
  Layer.provideMerge(
    Layer.mergeAll(
      Ledger.layerMemory(),
      Repository.layerGit,
      FlowEngine.layerMemory,
      WebCrypto.layer,
      judge(environment),
      replayOptions(smthrsCommand(), targetsDirectory()),
      replayProgress
    ),
    node
  )

/**
 * The services {@link layer} provides.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = Layer.Success<ReturnType<typeof layer>>
