/**
 * The host `smithers-ci` provides to itself and to every part on Node.
 *
 * - `NodeHost.layer` from `@smthrs/platform-node`: file system, paths,
 *   processes, jj and HTTP; plus the standard streams and terminal the
 *   command line needs.
 * - Fast mode's services, for the select part: an in-memory ledger for this
 *   run, the model's answers and their count for this run, git history, an in-memory flow engine for the judge's durable steps,
 *   Web Crypto, and the judge `smthrs` binds: Jev with `AI_GATEWAY_API_KEY`,
 *   else the model this machine is signed in to.
 * - How a replay runs in a stranger's checkout: this install's `smthrs`,
 *   which finds the package the generated files import by itself.
 * - What a replay is running, one line on standard error as each mode of each
 *   commit starts, kept with the replay's directory for the program's end.
 *
 * @since 0.1.0
 */

import { NodeStdio, NodeTerminal } from "@effect/platform-node"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Evaluator } from "@smthrs/model"
import { NodeHost } from "@smthrs/platform-node"
import type { Failure } from "../contract/Parts.vibe"
import { environment as documented, name } from "../contract/Command.vibe"
import { Options, Progress, WorkDirectory } from "../replay/index.vibe"
import { Ledger, Repository, Score } from "../select/index.vibe"
import { nodeProgram, smthrsCommand, smthrsWithToken } from "./Install.ts"
import { machine, runtime } from "./Restart.ts"
import { nothingTold, stageOf, type Told } from "./Stage.vibe"

/** An environment, read once at the composition root and never printed. */
export type Environment = Readonly<Record<string, string | undefined>>

const node = Layer.mergeAll(NodeHost.layer, NodeStdio.layer, NodeTerminal.layer)

/** The variables fast mode's model is given: the ones the program reads for it, and what every program gets. */
const forModel: ReadonlySet<string> = new Set([
  ...Object.keys(documented).filter((variable) => variable !== "SMITHERS_CACHE_TOKEN"),
  ...machine,
  ...runtime
])

/**
 * What fast mode's model is given of the variables the program was started
 * with: those it reads to choose and reach the model, in either case of
 * letters, and the short list every program gets. A model that is a program
 * of its own, as Claude Code is on a machine signed in to it, is started with
 * these, so a step that runs beside it finds no other token of the person's
 * there. The cache's token is not one of them.
 *
 * @category environment
 * @since 0.1.0
 */
export const modelEnvironment = (environment: Environment): Environment =>
  Object.fromEntries(Object.entries(environment).filter(([variable]) => forModel.has(variable.toUpperCase())))

/**
 * The judge `smthrs` binds, over the model transport `smthrs` builds from the
 * same environment. `@smthrs/cli` loads at the first judgment, so a command
 * that asks no judge starts without it. The judge and its transport are built
 * then, once, and every later judgment asks the same one: a transport built
 * again for each question would open its connections again for each.
 *
 * `load` gives the module that holds the judge, by default `@smthrs/cli`'s.
 *
 * @category layers
 * @since 0.1.0
 */
export const judge = (
  environment: Environment,
  load: () => Promise<typeof import("@smthrs/cli/NodeControl")> = () => import("@smthrs/cli/NodeControl")
) =>
  Layer.effect(Evaluator.Evaluator, effect {
    // The judge lives as long as this layer does, whichever judgment built it.
    const scope = try Effect.scope
    const seat = try Effect.cached(effect {
      const NodeControl = try promise(load)
      const transport = NodeControl.layerRebuildableRequestExecutor(NodeControl.environmentDispatcher(environment))
      return try Layer.buildWithScope(NodeControl.layerSeatEvaluator(environment).pipe(Layer.provide(transport)), scope)
    })
    return Evaluator.Evaluator.of({
      evaluate: (request) =>
        effect {
          const evaluate = effect {
            const evaluator = try Evaluator.Evaluator
            return try evaluator.evaluate(request)
          }
          return try Effect.provide(evaluate, try seat)
        }
    })
  })

/**
 * How often a failed target runs again before its verdict is `fail`, when the command line does not say; a pass on a
 * rerun is `flaky`.
 */
const reruns = 1

const noNode: Failure = {
  code: "unsupported",
  message: "Replaying commits needs Node.js 22.19 or newer, and none is on the path. Install Node.js and run this again.",
  part: "cli"
}

/**
 * How a replay runs on this machine. `smthrs` starts Smithers build, which
 * finds the package the generated files import by itself, so nothing is put
 * into a checkout for it: a step that installs would find it under
 * `node_modules`, and remove it. `hasNode` says whether `smthrs` has a Node
 * to run on. `environment` holds the variables the program was started with,
 * which it keeps out of its own process. `withToken` starts `smthrs` with the
 * token of a shared cache, read from a pipe.
 *
 * @category layers
 * @since 0.1.0
 */
export const replayOptions = (
  smthrs: readonly [string, ...Array<string>],
  hasNode: boolean = true,
  environment: Environment | undefined = undefined,
  withToken: readonly [string, ...Array<string>] | undefined = undefined
) =>
  Layer.succeed(Options, {
    smthrs,
    reruns,
    environment,
    smthrsWithToken: withToken,
    prepare: effect (_checkout: string) => {
      if (!hasNode) throw noNode
    }
  })

/**
 * Prints what a replay is running on standard error, which leaves standard
 * output to the report, and keeps in `told` the stage each line begins and
 * the directory the replay says it keeps its copies in: what the program
 * says, and removes, when a replay stops before it has an answer.
 *
 * @category layers
 * @since 0.1.0
 */
export const replayProgress = (told: Ref.Ref<Told>) =>
  Layer.mergeAll(
    Layer.succeed(Progress, {
      say: effect (line: string) => {
        const stage = stageOf(line)
        if (stage !== undefined) try Ref.update(told, (was) => ({ ...was, stage }))
        try Console.error(`${name}: ${line}`)
      }
    }),
    Layer.succeed(WorkDirectory, {
      at: (directory: string) => Ref.update(told, (was) => ({ ...was, directories: [...was.directories, directory] }))
    })
  )

/**
 * Every service the program and its parts may ask for, with the judge read
 * from `environment`. `told` is where a replay's stage and directory are
 * kept for whoever runs the program.
 *
 * @category layers
 * @since 0.1.0
 */
export const layer = (environment: Environment, told: Ref.Ref<Told> = Ref.makeUnsafe(nothingTold)) => {
  const runtime = nodeProgram(environment["PATH"])
  return Layer.provideMerge(
    Layer.mergeAll(
      Ledger.layerMemory(),
      Score.layerAsked,
      Score.layerKept,
      Repository.layerGit,
      FlowEngine.layerMemory,
      WebCrypto.layer,
      judge(modelEnvironment(environment)),
      replayOptions(
        smthrsCommand(undefined, runtime),
        runtime !== undefined,
        environment,
        smthrsWithToken(undefined, runtime)
      ),
      replayProgress(told)
    ),
    node
  )
}

/**
 * The services {@link layer} provides.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = Layer.Success<ReturnType<typeof layer>>
