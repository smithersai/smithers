/**
 * Reads Turborepo's task graph from `turbo.json`, to know what
 * `turbo run <task> --filter=<package>` runs and reads.
 *
 * Only declared evidence is used, and only to widen: `dependsOn` says which
 * tasks of which packages one task runs first, and `globalDependencies`,
 * `$TURBO_ROOT$` inputs and inputs that leave the package name more files to
 * read. An `inputs` list never narrows what a package step reads.
 *
 * @since 0.1.0
 */

import { parse, type ParseError } from "jsonc-parser"
import type { Package, Workspace } from "./Workspace.vibe"
import { globMagic, join } from "./Workspace.vibe"

/**
 * One task definition, reduced to what the splitter reads.
 *
 * @category models
 * @since 0.1.0
 */
export interface Task {
  readonly dependsOn: ReadonlyArray<string>
  readonly inputs: ReadonlyArray<string>
  /** True when a package's list starts with `$TURBO_EXTENDS$`, so the root's entries stay. */
  readonly extendsDependsOn: boolean
  readonly companions: ReadonlyArray<string>
  readonly extendsCompanions: boolean
  readonly extendsInputs: boolean
}

/**
 * The root configuration and each package's own, keyed by package name.
 *
 * @category models
 * @since 0.1.0
 */
export interface Config {
  readonly tasks: ReadonlyMap<string, Task>
  readonly globalDependencies: ReadonlyArray<string>
  readonly packages: ReadonlyMap<string, ReadonlyMap<string, Task>>
}

/**
 * What running tasks for one package through Turborepo reaches: the packages
 * whose scripts run, each script that runs, extra globs to read, and whether
 * a task of the root package runs.
 *
 * @category models
 * @since 0.1.0
 */
export interface Walk {
  readonly packages: ReadonlyArray<Package>
  readonly scripts: ReadonlyArray<readonly [owner: Package, script: string]>
  readonly globs: ReadonlyArray<string>
  readonly root: boolean
}

const extendsMarker = "$TURBO_EXTENDS$"
const rootMarker = "$TURBO_ROOT$/"

const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value)

const strings = (value: unknown): ReadonlyArray<string> =>
  Array.isArray(value) ? (value as ReadonlyArray<unknown>).filter((item) => typeof item === "string") : []

const readTasks = (config: Readonly<Record<string, unknown>>): ReadonlyMap<string, Task> | undefined => {
  const tasks = config["tasks"] ?? config["pipeline"]
  if (!isRecord(tasks)) return undefined
  return new Map(
    Object.entries(tasks).map(([name, raw]) => {
      const task = isRecord(raw) ? raw : {}
      const dependsOn = strings(task["dependsOn"])
      const inputs = strings(task["inputs"])
      const companions = strings(task["with"])
      return [name, {
        dependsOn: dependsOn.filter((entry) => entry !== extendsMarker),
        companions: companions.filter((entry) => entry !== extendsMarker),
        extendsCompanions: task["with"] === undefined || companions.includes(extendsMarker),
        inputs: inputs.filter((entry) => entry !== extendsMarker),
        extendsDependsOn: task["dependsOn"] === undefined || dependsOn.includes(extendsMarker),
        extendsInputs: task["inputs"] === undefined || inputs.includes(extendsMarker)
      }]
    })
  )
}

const readJson = (text: string): Record<string, unknown> | undefined => {
  const errors: Array<ParseError> = []
  const config: unknown = parse(text, errors, { allowTrailingComma: true })
  return errors.length === 0 && isRecord(config) ? config : undefined
}

/**
 * Reads the root `turbo.json` and each package's own. `undefined` when one
 * of them does not parse or the root has no tasks: the task graph is then
 * unknown.
 *
 * @category reading
 * @since 0.1.0
 */
export const readConfig = (
  root: string,
  packages: ReadonlyArray<readonly [name: string, text: string]>
): Config | undefined => {
  const config = readJson(root)
  const tasks = config === undefined ? undefined : readTasks(config)
  if (config === undefined || tasks === undefined) return undefined
  const own = new Map<string, ReadonlyMap<string, Task>>()
  for (const [name, text] of packages) {
    const parsed = readJson(text)
    if (parsed === undefined) return undefined
    // A package's file may hold no tasks, only tags or boundaries.
    own.set(name, readTasks(parsed) ?? new Map())
  }
  return {
    tasks,
    // Only a leading `!` in the original spelling denotes an exclusion. A positive pattern
    // keeps its glob syntax for the planner, which widens if the contract cannot express it.
    globalDependencies: strings(config["globalDependencies"]).flatMap((glob) => {
      if (glob.startsWith("!")) return []
      const plain = glob.replace(/^\.\//, "")
      if (globMagic.test(plain)) return [plain]
      if (plain === "" || plain.startsWith("/")) return []
      const path = join("", plain)
      // A nonempty spelling that resolves to the root needs the planner's whole-tree fallback.
      return path === undefined ? [] : [path || plain]
    }),
    packages: own
  }
}

// The definition Turborepo uses for one package's task: the package's own
// file, then the root's `package#task`, then the root's `task`.
const definitionOf = (config: Config, owner: string, task: string): Task | undefined => {
  const root = config.tasks.get(`${owner}#${task}`) ?? config.tasks.get(task)
  const own = config.packages.get(owner)?.get(task)
  if (own === undefined) return root
  return {
    dependsOn: [...(own.extendsDependsOn ? root?.dependsOn ?? [] : []), ...own.dependsOn],
    inputs: [...(own.extendsInputs ? root?.inputs ?? [] : []), ...own.inputs],
    companions: [...(own.extendsCompanions ? root?.companions ?? [] : []), ...own.companions],
    extendsCompanions: false,
    extendsDependsOn: false,
    extendsInputs: false
  }
}

/**
 * True when some package, or the root, defines the task: `turbo run` refuses
 * a task nothing defines.
 *
 * @category accessors
 * @since 0.1.0
 */
export const defines = (config: Config, task: string, owner?: string): boolean =>
  owner !== undefined ? definitionOf(config, owner, task) !== undefined :
  [...config.tasks.keys()].some((key) => key === task || key.endsWith(`#${task}`)) ||
  [...config.packages.values()].some((own) => own.has(task))

/**
 * True when the root package has a task of this name, which `turbo run`
 * then runs with the packages' tasks.
 *
 * @category accessors
 * @since 0.1.0
 */
export const rootRuns = (config: Config, task: string): boolean => config.tasks.has(`//#${task}`)

/**
 * Follows `dependsOn` from the given tasks of one package: `task` stays in
 * the package, `^task` goes to each package it declares, and `package#task`
 * names its package. A task whose package has no script of that name runs
 * nothing, and its own `dependsOn` is still followed.
 *
 * @category closure
 * @since 0.1.0
 */
export const walk = (
  config: Config,
  workspace: Workspace,
  start: Package,
  tasks: ReadonlyArray<string>
): Walk => {
  const byName = new Map(workspace.packages.map((candidate) => [candidate.name, candidate]))
  const seen = new Set<string>()
  const scripts: Array<readonly [Package, string]> = []
  const globs = new Set<string>()
  let root = false
  const pending: Array<readonly [Package, string]> = tasks.map((task) => [start, task])
  while (pending.length > 0) {
    const [owner, task] = pending.pop() as readonly [Package, string]
    // The package and the task, each whole: `a#x` with `y` and `a` with `x#y` are two tasks, not one.
    const key = JSON.stringify([owner.name, task])
    if (seen.has(key)) continue
    seen.add(key)
    const definition = definitionOf(config, owner.name, task)
    if (definition === undefined) continue
    const runs = Object.hasOwn(owner.scripts, task)
    if (runs) scripts.push([owner, task])
    // Only a task that runs reads its inputs.
    for (const input of runs ? definition.inputs : []) {
      if (input.startsWith("!")) continue
      const rooted = input.startsWith(rootMarker)
      const relative = rooted ? input.slice(rootMarker.length) : input
      const segments = relative.split("/")
      const parent = segments.lastIndexOf("..")
      if (!rooted && parent < 0) continue
      // Keep glob syntax before traversal for the planner to reject. Joining could erase a wildcard.
      const glob = parent >= 0 && globMagic.test(segments.slice(0, parent).join("/"))
        ? relative
        : join(rooted ? "" : owner.directory, relative)
      if (glob !== undefined && glob !== "") globs.add(glob)
    }
    for (const entry of [...definition.dependsOn, ...definition.companions]) {
      const split = entry.indexOf("#")
      if (entry.startsWith("^")) {
        for (const name of owner.dependencies) pending.push([byName.get(name) as Package, entry.slice(1)])
      } else if (split < 0) {
        pending.push([owner, entry])
      } else if (entry.startsWith("//#")) {
        root = true
      } else {
        const named = byName.get(entry.slice(0, split))
        if (named !== undefined) pending.push([named, entry.slice(split + 1)])
      }
    }
  }
  return {
    packages: [...new Set(scripts.map(([owner]) => owner))],
    scripts,
    globs: [...globs].sort(),
    root
  }
}
