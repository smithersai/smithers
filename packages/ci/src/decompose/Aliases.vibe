/**
 * Mask TypeScript path mappings only when every destination resolves to the
 * nominal workspace package. Bundler expressions and ambiguous mappings
 * remain visible to the dependency scanner.
 *
 * @since 0.1.0
 */

import { join } from "./Workspace.vibe"
import { findNodeAtLocation, type Node, type ParseError, parseTree } from "jsonc-parser"

const typescriptConfig = /(?:^|\/)[jt]sconfig(?:\.[^/]*)?\.json$/

// The package an alias key names: the key itself, or the key without a
// trailing `/*` or subpath.
const packageOf = (key: string): string => {
  const parts = key.split("/")
  return key.startsWith("@") ? parts.slice(0, 2).join("/") : parts[0] as string
}

const blank = (text: string, spans: ReadonlyArray<readonly [start: number, end: number]>): string => {
  let out = text
  for (const [start, end] of spans) {
    out = `${out.slice(0, start)}${out.slice(start, end).replace(/[^\n]/g, " ")}${out.slice(end)}`
  }
  return out
}

// The `compilerOptions.paths` entries of a tsconfig that are keyed by a package's name.
const tsconfigAliases = (
  file: string, text: string, directories: ReadonlyMap<string, string>
): ReadonlyArray<readonly [number, number]> => {
  const errors: Array<ParseError> = []
  const tree = parseTree(text, errors, { allowTrailingComma: true })
  if (tree === undefined || errors.length > 0 || findNodeAtLocation(tree, ["extends"]) !== undefined) return []
  const paths = findNodeAtLocation(tree, ["compilerOptions", "paths"])
  const base = findNodeAtLocation(tree, ["compilerOptions", "baseUrl"])
  if (paths?.type !== "object" || (base !== undefined && base.type !== "string")) return []
  const parent = file.split("/").slice(0, -1).join("/")
  const baseUrl = (base?.value ?? ".") as string
  const directory = baseUrl.startsWith("/") ? undefined : join(parent, baseUrl)
  if (directory === undefined) return []
  return (paths.children as ReadonlyArray<Node>).flatMap((property) => {
    const [key, values] = property.children as ReadonlyArray<Node>
    const name = packageOf(key!.value as string)
    const nominal = directories.get(name)
    if (nominal === undefined || values!.type !== "array") return []
    const destinations = values!.children as ReadonlyArray<Node>
    const same = destinations.length > 0 && destinations.every((node) => {
      if (node.type !== "string") return false
      const value = node.value as string
      if (value.startsWith("/") || value.includes("\\") || value.replace(/\/\*$/, "").includes("*")) return false
      const path = join(directory, value)
      return path !== undefined && [...directories.values()].filter((dir) => path === dir || path.startsWith(dir + "/"))
        .sort((a, b) => b.length - a.length)[0] === nominal
    })
    return same ? [[property.offset, property.offset + property.length] as const] : []
  })
}

/**
 * A file's text with its alias definitions for workspace packages replaced
 * by spaces. Text that holds none is returned as it was.
 *
 * @category scanning
 * @since 0.1.0
 */
export const withoutAliases = (file: string, text: string, directories: ReadonlyMap<string, string>): string => {
  return typescriptConfig.test(file) ? blank(text, tsconfigAliases(file, text, directories)) : text
}
