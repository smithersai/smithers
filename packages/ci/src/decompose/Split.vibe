/**
 * The decompose part: reads the repository at a root and returns its CI with
 * coarse steps replaced by steps that name what they read.
 *
 * It reads files and asks git which files exist. It never runs the
 * package manager. A caller may supply a Zig build discovery strategy.
 *
 * @since 0.1.0
 */

import type { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { type Ci, type Job, type Step, withSteps } from "../contract/Inventory.vibe"
import type { Decompose, Failure } from "../contract/Parts.vibe"
import { withoutAliases } from "./Aliases.vibe"
import { type Facts, followed, keepCommand, preceded, prepare, understand, type Understood } from "./Plan.vibe"
import * as Script from "./Script.vibe"
import { readConfig } from "./Turbo.vibe"
import * as Zig from "./Zig.ts"
import {
  assemble,
  isRootLockfile,
  lazyGraph,
  managerOf,
  manifestMentions,
  type Mentions,
  type Package,
  packageDirectories,
  type Reach,
  readObject,
  readPatterns,
  scanner,
  type Workspace
} from "./Workspace.vibe"
import { runGit } from "../inventory/HostGit.vibe"

/** File types that hold no path or package name a program follows. */
const unscanned =
  /\.(?:png|jpe?g|gif|webp|avif|ico|icns|bmp|tiff?|svg|pdf|zip|gz|tgz|bz2|xz|7z|tar|jar|wasm|node|so|dylib|dll|exe|bin|dat|db|sqlite|ttf|otf|woff2?|eot|mp[34]|wav|ogg|webm|mov|avi|flac|onnx|gguf|safetensors|lockb?|snap|map|md|txt|log|csv|tsv)$/i

/** A package's manifest. */
const manifest = /(?:^|\/)package\.json$/

/** The largest file that can inform static reach. */
const readLimit = 1024 * 1024
const lockfileHead = 64 * 1024

interface Tree {
  readonly fs: FileSystem.FileSystem
  readonly path: Path.Path
  readonly root: string
  readonly files: ReadonlySet<string>
  readonly opaque: boolean
}

/** Read each listing once, draining both pipes before collecting its status. */
effect function git(root: string, args: ReadonlyArray<string>): string!Failure!ChildProcessSpawner {
  const result = runGit(root, root, args) catch effect (error) => {
    throw { part: "decompose", code: "command-failed", message: error.message } satisfies Failure
  }
  if (result.code !== 0) throw {
    part: "decompose",
    code: result.diagnostic.includes("not a git repository") ? "not-a-repository" : "command-failed",
    message: `git ls-files exited ${result.code}: ${result.diagnostic.trim().slice(-512)}`
  } satisfies Failure
  return result.text
}

/** A file's text, or `undefined` when it is missing or cannot be read. */
effect function text(tree: Tree, file: string): (string | undefined)!! {
  const full = tree.path.join(tree.root, file)
  const info = tree.fs.lstat(full) catch () => undefined
  if (info?.type !== "File") return undefined
  const resolved = tree.fs.realPath(full) catch () => undefined
  if (resolved !== full) return undefined
  if (isRootLockfile(tree.path.basename(file))) {
    const head = tree.fs.stream(full, { bytesToRead: lockfileHead })
    const content = Stream.mkString(Stream.decodeText(head)) catch () => undefined
    // A Berry lockfile may place its metadata after a long comment. A truncated, unidentified
    // Yarn header cannot establish classic Yarn's script semantics.
    if (tree.path.basename(file) === "yarn.lock" && info.size > lockfileHead &&
      !/^# yarn lockfile v1\r?$|__metadata:/m.test(content ?? "")) return undefined
    return content
  }
  return try readText(tree, full, info.size)
}

/** Bound the actual read too, in case the file grows after the stat. */
effect function readText(tree: Tree, full: string, size: FileSystem.File.Info["size"]): (string | undefined)!! {
  if (size > readLimit) return undefined
  let bytes = 0
  const counted = Stream.tap(tree.fs.stream(full, { bytesToRead: readLimit + 1 }), (chunk) => sync(() => {
    bytes += chunk.length
  }))
  const content = Stream.mkString(Stream.decodeText(counted)) catch () => undefined
  return bytes > readLimit ? undefined : content
}

/** Reads the workspace: its patterns, then each package's manifest. */
effect function readWorkspace(tree: Tree): (Workspace | undefined)!Failure!ChildProcessSpawner {
  const manifest = readObject((try text(tree, "package.json")) ?? "")
  if (manifest === undefined) return undefined
  const pnpm = tree.files.has("pnpm-workspace.yaml")
  const manager = managerOf(manifest, tree.files)
  const declared = readPatterns(
    manifest,
    pnpm ? (try text(tree, "pnpm-workspace.yaml")) ?? "" : undefined,
    tree.files.has(".npmrc") ? (try text(tree, ".npmrc")) ?? null : ""
  )
  const npmPatterns = !pnpm && manager === "npm"
  const directories = declared === undefined ? undefined : packageDirectories(declared.patterns, tree.files, npmPatterns)
  if (declared === undefined || directories === undefined || tree.opaque) return undefined
  // An ignored manifest still participates in package manager workspace discovery.
  const ignored = try git(tree.root, ["ls-files", "--others", "--ignored", "--exclude-standard", "-z", "--", ":(glob)**/package.json", ":(exclude,glob)**/node_modules/**"])
  const all = new Set([...tree.files, ...ignored.split("\0")])
  if (packageDirectories(declared.patterns, all, npmPatterns)?.length !== directories.length) return undefined
  const manifests: Array<readonly [string, string]> = []
  for (const directory of directories) {
    manifests.push([directory, (try text(tree, `${directory}/package.json`)) ?? ""])
  }
  const workspace = assemble(manager, manifest, declared.orchestrated, manifests)
  if (workspace === undefined) return undefined
  // One graph can serve another package manager only if both see the same packages.
  const rootPatterns = pnpm ? readPatterns(manifest, undefined)?.patterns : declared.patterns
  const same = (npm: boolean): boolean => {
    if (!pnpm && npm === npmPatterns) return true
    const found = rootPatterns === undefined ? [] : packageDirectories(rootPatterns, all, npm)
    return JSON.stringify(found) === JSON.stringify(directories)
  }
  return { ...workspace, pnpmMissing: !pnpm, npmMismatch: !same(true), otherManifestMismatch: !same(false) }
}

/** Reads `turbo.json` at the root and in each package that has one. */
effect function readTurbo(tree: Tree, workspace: Workspace) {
  const file = ["turbo.json", "turbo.jsonc"].find((name) => tree.files.has(name))
  if (file === undefined) return undefined
  const own: Array<readonly [string, string]> = []
  for (const owner of workspace.packages) {
    const name = ["turbo.json", "turbo.jsonc"].find((candidate) => tree.files.has(`${owner.directory}/${candidate}`))
    if (name !== undefined) own.push([owner.name, (try text(tree, `${owner.directory}/${name}`)) ?? ""])
  }
  return readConfig((try text(tree, file)) ?? "", own)
}

/**
 * Builds a graph that reads files when first reached. A verified symbolic
 * link to a repository file mentions that file, even for an unscanned extension.
 */
effect function readFacts(tree: Tree, workspace: Workspace): Facts<Reach!!>!! {
  const scan = scanner(workspace)
  const names = new Map(workspace.packages.map((owner) => [owner.name, owner.directory]))
  const none: Mentions = { names: [], relative: [], rooted: [] }
  const readFile = effect (file: string): (Mentions | undefined)!! => {
    const full = tree.path.join(tree.root, file)
    const info = tree.fs.lstat(full) catch () => undefined
    if (info === undefined) return undefined
    const actual = tree.fs.realPath(full) catch () => undefined
    if (actual !== full) {
      if (info.type !== "SymbolicLink" || actual === undefined) return undefined
      const relative = tree.path.relative(tree.root, actual)
      if (!tree.files.has(relative)) return undefined
      const link = tree.fs.readLink(full) catch () => undefined
      if (link === undefined || tree.path.resolve(tree.path.dirname(full), link) !== actual) return undefined
      return { ...none, rooted: [relative] }
    }
    if (info.type !== "File") return undefined
    // The root glob already covers lockfile changes. Inventory entries in a
    // regular root lockfile do not describe what a task imports.
    if (isRootLockfile(file) || unscanned.test(file)) return none
    const content = try readText(tree, full, info.size)
    if (content === undefined) return undefined
    if (content.slice(0, 8000).includes("\0")) return none
    const read = withoutAliases(file, content, names)
    return manifest.test(file) ? manifestMentions(scan, read) : scan(read, false)
  }
  return {
    workspace,
    graph: lazyGraph(workspace, tree.files, readFile),
    turbo: try readTurbo(tree, workspace)
  }
}

effect function replaced(
  step: Step,
  understood: Understood | undefined,
  facts: Facts<Reach!!> | undefined,
  groups: ReadonlyMap<string, ReadonlyArray<string>>,
  relied: boolean
): ReadonlyArray<Step>!! {
  if (/^__limit=/m.test(step.runner ?? "")) return [step]
  if (understood !== undefined && understood.zig.length > 0) {
    // A step a later step relies on keeps its command and its place: where Zig writes is what that step may read.
    if (relied) return [step]
    // A Zig step names no inputs: its tests write where they start, so it runs in the open and is observed.
    return Zig.split(step, groups) ?? [step]
  }
  // Zig with a flag, another of its commands, or beside a program this reader does not know stays as written. One
  // build whose flags only change the report is still split.
  const builds = understood === undefined && !relied ? Zig.split(step, groups) : undefined
  if (builds !== undefined) return builds
  if (understood === undefined) return [step]
  const planned = prepare(step, understood, facts)
  if (planned === undefined) return [step]
  const reaches = new Map<Package | string | undefined, Reach>()
  for (const start of planned.starts) reaches.set(start, try facts!.graph.reachOf(start))
  const decision = planned.finish((start) => reaches.get(start)!)
  if (decision.kind === "scope") return [{ ...step, inputs: decision.inputs, from: step.id }]
  return decision.parts.map((part) => ({
    ...step,
    id: `${step.id}:${part.name}`,
    command: part.command,
    ...(step.name === undefined ? {} : { name: `${step.name} (${part.name})` }),
    inputs: part.inputs,
    from: step.id
  }))
}

/**
 * A step that runs one package script made of several commands: one step per command, in order, or the step with
 * why it stays whole. Any other step is returned as it is. `files` holds the text of each file `Script.filesOf`
 * names that the repository has, or `null` for one that cannot be read. `leads` is true for the first step of a job
 * that has more.
 */
const chained = (step: Step, files: ReadonlyMap<string, string | null>, leads: boolean): ReadonlyArray<Step> => {
  const decision = Script.decide(step, (path) => files.get(path), leads)
  if (decision.kind === "none") return [step]
  if (decision.kind === "whole") return [{ ...step, whole: decision.why }]
  return decision.links.map((link) => ({
    ...step,
    id: `${step.id}:${link.name}`,
    command: link.command,
    ...(step.name === undefined ? {} : { name: `${step.name} (${link.name})` }),
    from: step.id,
    inOrder: true
  }))
}

/** Reads the files that say how each step's package script runs. A file that cannot be read is `null`. */
effect function readScriptFiles(tree: Tree, steps: ReadonlyArray<Step>): ReadonlyMap<string, string | null>!! {
  const found = new Map<string, string | null>()
  for (const file of new Set(steps.flatMap((step) => Script.filesOf(step)))) {
    if (tree.files.has(file)) found.set(file, (try text(tree, file)) ?? null)
  }
  return found
}

/**
 * What the decompose part is made with.
 *
 * - `zigGroups`: the named steps each Zig build step only groups. With it, a
 *   step that is nothing but `zig build <step>` becomes one step per named
 *   step. Without it, or when it fails, the step keeps its command.
 * - `turboWrappers`: files, from the repository root, that the repository's
 *   owner says pass their arguments to `turbo`. A step that runs one is
 *   split as a `turbo` step is, and reads the file.
 *
 * @category models
 * @since 0.1.0
 */
export interface Options<R = never> {
  readonly zigGroups?:
    | ((root: string, steps: ReadonlyArray<string>) => ReadonlyArray<ReadonlyArray<string>>!Failure!R)
    | undefined
  readonly turboWrappers?: ReadonlyArray<string> | undefined
}

/**
 * Makes the decompose part.
 *
 * @category parts
 * @since 0.1.0
 */
export const splitWith = <R = never>(
  options: Options<R> = {}
): Decompose<R | FileSystem.FileSystem | Path.Path | ChildProcessSpawner> =>
  effect function (root: string, inventory: Ci) {
    const steps = inventory.jobs.flatMap((job) => job.steps)
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const staged = try git(root, ["ls-files", "-z", "--stage"])
    const untracked = try git(root, ["ls-files", "-z", "--others", "--exclude-standard"])
    const files = new Set(untracked.split("\0").filter(Boolean))
    let opaque = [...files].some((file) => file.endsWith("/"))
    for (const entry of staged.split("\0").filter(Boolean)) {
      if (entry.startsWith("160000 ")) opaque = true
      files.add(entry.slice(entry.indexOf("\t") + 1))
    }
    const canonical = try Effect.mapError(fs.realPath(root), (error): Failure => ({ part: "decompose", code: "command-failed", message: error.message }))
    const tree: Tree = { fs, path, root: canonical, files, opaque }
    const workspace = try readWorkspace(tree)
    const relied = followed(inventory.jobs)
    const after = preceded(inventory.jobs)
    const understood = new Map(steps.map((step) => {
      const known = understand(step, workspace, options.turboWrappers)
      // A step after another may read what that one wrote, which no input names: it stays as it was. A step that
      // runs a Zig build is still read: it gains no inputs, only where Zig keeps its caches.
      const read = after.has(step) && known !== undefined && known.zig.length === 0 ? undefined : known
      // A step a later step relies on always runs: it keeps its command.
      return [step, read !== undefined && relied.has(step) ? keepCommand(read) : read]
    }))
    const found = [...understood.values()].filter((entry) => entry !== undefined)
    const facts = workspace !== undefined && found.some((entry) => entry.runs.length > 0)
      ? try readFacts(tree, workspace)
      : undefined
    // Only a step that is nothing but one build can be split by the named steps its build step groups.
    const builds = [...new Set(steps.flatMap((step) => {
      // The named steps are read from the root's build, so only a step that starts there is asked about.
      const sole = /^__limit=/m.test(step.runner ?? "") || relied.has(step) || !Zig.atRoot(step) ? undefined : Zig.soleBuild(step.command)
      return sole === undefined ? [] : [sole]
    }))].sort()
    const grouped = options.zigGroups === undefined || builds.length === 0
      ? []
      : options.zigGroups(root, builds) catch effect (failure) => {
        try Effect.logDebug("Zig group discovery failed; keeping the original steps", { code: failure.code, builds })
        return [] as ReadonlyArray<ReadonlyArray<string>>
      }
    const groups = new Map(builds.map((name, index) => [name, grouped[index] ?? []]))
    const scripts = try readScriptFiles(tree, steps)
    // The same jobs with their steps replaced are still the repository's CI: `withSteps` keeps every job and its needs.
    const replacements = new Map<Job, ReadonlyArray<Step>>()
    for (const job of inventory.jobs) {
      const steps: Array<ReadonlyArray<Step>> = []
      for (const step of job.steps) {
        const made = try replaced(step, understood.get(step), facts, groups, relied.has(step))
        // A step nothing else changed may run a script that is a chain of scripts.
        steps.push(made.length === 1 && made[0] === step
          ? chained(step, scripts, job.steps.length > 1 && job.steps[0] === step)
          : made)
      }
      replacements.set(job, steps.flat())
    }
    return withSteps(inventory, (job) => replacements.get(job)!)
  }
