/**
 * The decompose part: reads the repository at a root and returns its CI with
 * coarse steps replaced by steps that name what they read.
 *
 * It reads files and asks git which files exist. It never runs the
 * repository's code or its package manager.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import type { Closure } from "../contract/Closure.ts"
import { type Ci, type Step, withSteps } from "../contract/Inventory.ts"
import type { CloseEntries, Decompose, Failure } from "../contract/Parts.ts"
import { withoutAliases } from "./Aliases.ts"
import { decide, type Facts, followed, keepCommand, preceded, understand, type Understood } from "./Plan.ts"
import { readConfig } from "./Turbo.ts"
import * as Zig from "./Zig.ts"
import {
  assemble,
  graph,
  managerOf,
  manifestMentions,
  type Mentions,
  packageDirectories,
  readObject,
  readPatterns,
  scanner,
  type Workspace
} from "./Workspace.ts"

/** File types that hold no path or package name a program follows. */
const unscanned =
  /\.(?:png|jpe?g|gif|webp|avif|ico|icns|bmp|tiff?|svg|pdf|zip|gz|tgz|bz2|xz|7z|tar|jar|wasm|node|so|dylib|dll|exe|bin|dat|db|sqlite|ttf|otf|woff2?|eot|mp[34]|wav|ogg|webm|mov|avi|flac|onnx|gguf|safetensors|lockb?|snap|map|md|txt|log|csv|tsv)$/i

/** A package's manifest. */
const manifest = /(?:^|\/)package\.json$/

/** How many files are read at once. */
const readers = 32

interface Tree {
  readonly fs: FileSystem.FileSystem
  readonly path: Path.Path
  readonly root: string
  readonly files: ReadonlySet<string>
}

const notARepository = (root: string): Failure => ({
  code: "not-a-repository",
  message: `${root} is not a git repository`,
  part: "decompose"
})

/** Runs git in the repository and gives what it prints. A git that cannot start, or refuses, fails. */
effect function git(root: string, args: ReadonlyArray<string>): string!Failure!ChildProcessSpawner {
  const spawner = try ChildProcessSpawner
  const command = ChildProcess.make("git", ["-C", root, ...args])
  const code = spawner.exitCode(command) catch () => undefined
  if (code === undefined || Number(code) !== 0) throw notARepository(root)
  return spawner.string(command) catch () => ""
}

/** A file's text, or `undefined` when it is missing or cannot be read. */
effect function text(tree: Tree, file: string): (string | undefined)!! {
  return tree.fs.readFileString(tree.path.join(tree.root, file)) catch () => undefined
}

/** Reads the workspace: its patterns, then each package's manifest. */
effect function readWorkspace(tree: Tree): (Workspace | undefined)!! {
  const manifest = readObject((try text(tree, "package.json")) ?? "")
  if (manifest === undefined) return undefined
  const declared = readPatterns(
    manifest,
    tree.files.has("pnpm-workspace.yaml") ? (try text(tree, "pnpm-workspace.yaml")) ?? "" : undefined,
    tree.files.has(".npmrc") ? (try text(tree, ".npmrc")) ?? null : ""
  )
  const directories = declared === undefined ? undefined : packageDirectories(declared.patterns, tree.files)
  if (declared === undefined || directories === undefined) return undefined
  const manifests: Array<readonly [string, string]> = []
  for (const directory of directories) {
    manifests.push([directory, (try text(tree, `${directory}/package.json`)) ?? ""])
  }
  return assemble(managerOf(manifest, tree.files), manifest, declared.orchestrated, manifests)
}

/** Reads `turbo.json` at the root and in each package that has one. */
effect function readTurbo(tree: Tree, workspace: Workspace) {
  const file = ["turbo.json", "turbo.jsonc"].find((name) => tree.files.has(name))
  if (file === undefined) return undefined
  const own: Array<readonly [string, string]> = []
  for (const owner of workspace.packages) {
    const name = ["turbo.json", "turbo.jsonc"].find((candidate) => tree.files.has(`${owner.directory}/${candidate}`))
    if (name !== undefined) own.push([owner.name, (try text(tree, `${owner.directory}/${name}`)) ?? ""])
  }
  return readConfig((try text(tree, file)) ?? "", own)
}

/** The tracked symbolic links, which git lists with mode 120000. */
effect function links(tree: Tree): ReadonlySet<string>!Failure!ChildProcessSpawner {
  const staged = try git(tree.root, ["ls-files", "-s", "-z"])
  return new Set(
    staged.split("\0").filter((entry) => entry.startsWith("120000 ")).map((entry) => entry.slice(entry.indexOf("\t") + 1))
  )
}

/**
 * Reads what every file in a package mentions, and builds the reach graph.
 * A symbolic link mentions the path it points to.
 */
effect function readFacts(tree: Tree, workspace: Workspace): Facts!Failure!ChildProcessSpawner {
  const scan = scanner(workspace)
  const names = new Set(workspace.packages.map((owner) => owner.name))
  const linked = try links(tree)
  const found = new Map<string, Mentions>()
  const none: Mentions = { names: [], relative: [], rooted: [] }
  const owned = [...tree.files].filter((file) =>
    !unscanned.test(file) && workspace.packages.some((owner) => file.startsWith(`${owner.directory}/`))
  )
  for concurrent(readers) (const file of owned) {
    if (linked.has(file)) {
      const target = tree.fs.readLink(tree.path.join(tree.root, file)) catch () => ""
      found.set(file, { ...none, relative: target.startsWith("/") || target === "" ? [] : [`./${target}`] })
    } else {
      const content = try text(tree, file)
      // A zero byte near the start marks a binary file, as it does for git.
      if (content !== undefined && !content.slice(0, 8000).includes("\0")) {
        const read = withoutAliases(file, content, names)
        found.set(file, manifest.test(file) ? manifestMentions(scan, read) : scan(read, false))
      }
    }
  }
  return {
    workspace,
    graph: graph(workspace, tree.files, (file) => found.get(file) ?? none),
    turbo: try readTurbo(tree, workspace)
  }
}

/** What the Zig strategy said of the build steps a CI names. */
interface Built {
  readonly closures: ReadonlyMap<string, Closure>
  readonly groups: ReadonlyMap<string, ReadonlyArray<string>>
}

const replaced = (
  step: Step,
  understood: Understood | undefined,
  facts: Facts | undefined,
  zig: Built,
  relied: boolean
): ReadonlyArray<Step> => {
  // A step a later step relies on keeps its command and its place: where Zig writes is what that step may read.
  const builds = understood !== undefined && understood.zig.length > 0 && !relied
  const onlyBuilds = builds && understood.runs.length === 0
  const parts = onlyBuilds ? Zig.split(step, zig.groups, zig.closures) : undefined
  if (parts !== undefined) return parts
  const decision = understood === undefined ? { kind: "whole" as const } : decide(step, understood, facts, zig.closures)
  if (decision.kind === "whole") return [step]
  if (decision.kind === "scope") {
    const scoped = { ...step, inputs: decision.inputs, from: step.id }
    // A closure is all a Zig build reads, whatever ran before it; a script run's inputs are not.
    return [builds ? Zig.dress(scoped, onlyBuilds) : scoped]
  }
  return decision.parts.map((part) => ({
    ...step,
    id: `${step.id}:${part.name}`,
    command: part.command,
    ...(step.name === undefined ? {} : { name: `${step.name} (${part.name})` }),
    inputs: part.inputs,
    from: step.id
  }))
}

/**
 * What the decompose part is made with.
 *
 * - `zig`: the Zig closure strategy. Without it, or when it fails, a step
 *   that runs `zig build` stays whole.
 * - `zigGroups`: the named steps each Zig build step only groups. With it, a
 *   step that is nothing but `zig build <step>` becomes one step per named
 *   step. Without it, or when it fails, the step keeps its command.
 * - `turboWrappers`: files, from the repository root, that the repository's
 *   owner says pass their arguments to `turbo`. A step that runs one is
 *   split as a `turbo` step is, and reads the file.
 *
 * @category models
 * @since 0.1.0
 */
export interface Options<R = never> {
  readonly zig?: CloseEntries<R> | undefined
  readonly zigGroups?:
    | ((root: string, steps: ReadonlyArray<string>) => ReadonlyArray<ReadonlyArray<string>>!Failure!R)
    | undefined
  readonly turboWrappers?: ReadonlyArray<string> | undefined
}

/**
 * Makes the decompose part.
 *
 * @category parts
 * @since 0.1.0
 */
export const splitWith = <R = never>(
  options: Options<R> = {}
): Decompose<R | FileSystem.FileSystem | Path.Path | ChildProcessSpawner> =>
  effect function (root: string, inventory: Ci) {
    const steps = inventory.jobs.flatMap((job) => job.steps)
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const listed = try git(root, ["ls-files", "-z", "--cached", "--others", "--exclude-standard"])
    const tree: Tree = { fs, path, root, files: new Set(listed.split("\0").filter((file) => file !== "")) }
    const workspace = try readWorkspace(tree)
    const relied = followed(inventory.jobs)
    const after = preceded(inventory.jobs)
    const understood = new Map(steps.map((step) => {
      const known = understand(step, workspace, options.turboWrappers)
      // A step after another may read what that one wrote, which no input names: it stays as it was. A step that
      // only runs Zig builds is the exception: the compiler reports every file such a build reads.
      const read = after.has(step) && known !== undefined && known.runs.length > 0 ? undefined : known
      // A step a later step relies on always runs: it keeps its command.
      return [step, read !== undefined && relied.has(step) ? keepCommand(read) : read]
    }))
    const found = [...understood.values()].filter((entry) => entry !== undefined)
    const facts = workspace !== undefined && found.some((entry) => entry.runs.length > 0)
      ? try readFacts(tree, workspace)
      : undefined
    const builds = [...new Set(found.flatMap((entry) => entry.zig))].sort()
    const grouped = options.zig === undefined || options.zigGroups === undefined || builds.length === 0
      ? []
      : options.zigGroups(root, builds) catch (): ReadonlyArray<ReadonlyArray<string>> => []
    const groups = new Map(builds.map((name, index) => [name, grouped[index] ?? []]))
    // A build step and each named step it groups are closed in one call.
    const entries = [...new Set([...builds, ...grouped.flat()])].sort()
    const closures = options.zig === undefined || entries.length === 0
      ? []
      : options.zig(root, entries) catch (): ReadonlyArray<Closure> => []
    const closed = new Map(entries.flatMap((name) => {
      const closure = closures.find((candidate) => candidate.entries.includes(name))
      return closure === undefined ? [] : [[name, closure] as const]
    }))
    const built: Built = { closures: closed, groups }
    // The same jobs with their steps replaced are still the repository's CI: `withSteps` keeps every job and its needs.
    return withSteps(inventory, (job) =>
      job.steps.flatMap((step) => replaced(step, understood.get(step), facts, built, relied.has(step))))
  }
