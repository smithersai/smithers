/**
 * A JavaScript workspace as the splitter sees it: its packages, what each
 * declares, and what each one's files reach.
 *
 * Everything here is computed from text already read. Nothing runs the
 * repository's code or asks a package manager.
 *
 * @since 0.1.0
 */

import { parse as parseYaml } from "yaml"

/**
 * A package manager that reads workspaces.
 *
 * @category models
 * @since 0.1.0
 */
export type Manager = "pnpm" | "bun" | "npm" | "yarn"

/**
 * One workspace package. `dependencies` are the workspace packages it
 * declares, by name, from every dependency field.
 *
 * @category models
 * @since 0.1.0
 */
export interface Package {
  readonly name: string
  readonly directory: string
  readonly scripts: Readonly<Record<string, string>>
  readonly dependencies: ReadonlyArray<string>
}

/**
 * The packages of a repository and the root manifest's scripts. `orchestrated`
 * is true when the package manager's own settings change which packages a run
 * selects or the order tasks run in, in a way the splitter does not
 * reproduce.
 *
 * @category models
 * @since 0.1.0
 */
export interface Workspace {
  readonly manager: Manager
  readonly rootName: string | undefined
  readonly rootScripts: Readonly<Record<string, string>>
  readonly packages: ReadonlyArray<Package>
  readonly orchestrated: boolean
  readonly pnpmMissing?: boolean
  readonly npmMismatch?: boolean
  readonly otherManifestMismatch?: boolean
}

/**
 * What one file's text mentions: workspace packages by name, relative paths,
 * and paths written from the repository root.
 *
 * @category models
 * @since 0.1.0
 */
export interface Mentions {
  readonly names: ReadonlyArray<string>
  readonly relative: ReadonlyArray<string>
  readonly rooted: ReadonlyArray<string>
}

/**
 * What a package's task reads inside packages: whole package directories,
 * and single files of other packages.
 *
 * @category models
 * @since 0.1.0
 */
export interface Reach {
  readonly packages: ReadonlySet<string>
  readonly files: ReadonlySet<string>
}

const isRecord = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value)

const strings = (value: ReadonlyArray<unknown>): ReadonlyArray<string> =>
  value.filter((item) => typeof item === "string")

/**
 * A JSON object, or `undefined` for anything else.
 *
 * @category reading
 * @since 0.1.0
 */
export const readObject = (text: string): Record<string, unknown> | undefined => {
  try {
    const value: unknown = JSON.parse(text)
    return isRecord(value) ? value : undefined
  } catch {
    return undefined
  }
}

const lockfiles: ReadonlyArray<readonly [file: string, manager: Manager]> = [
  ["bun.lock", "bun"],
  ["bun.lockb", "bun"],
  ["pnpm-lock.yaml", "pnpm"],
  ["yarn.lock", "yarn"],
  ["package-lock.json", "npm"],
  ["npm-shrinkwrap.json", "npm"]
]

/** Identifies package-manager inventories by their exact repository-root paths. */
export const isRootLockfile = (file: string): boolean => lockfiles.some(([name]) => file === name)

const managers: ReadonlySet<string> = new Set(["pnpm", "bun", "npm", "yarn"])

/**
 * The package manager of a repository: the `packageManager` field names it,
 * then the lockfile at the root, then npm.
 *
 * @category reading
 * @since 0.1.0
 */
export const managerOf = (manifest: Readonly<Record<string, unknown>>, files: ReadonlySet<string>): Manager => {
  const field = typeof manifest["packageManager"] === "string" ? manifest["packageManager"].split("@")[0] as string : ""
  if (managers.has(field)) return field as Manager
  return lockfiles.find(([file]) => files.has(file))?.[1] ?? "npm"
}

// A star can consume whole Unicode code points. A UTF-16 search cannot split a surrogate pair.
const boundary = (name: string, index: number): boolean =>
  !/[\uD800-\uDBFF][\uDC00-\uDFFF]/.test(name.slice(Math.max(0, index - 1), index + 1))

/** Matches literal name characters and stars. */
export const matchesName = (pattern: string, name: string): boolean => {
  const first = pattern.indexOf("*")
  if (first === -1) return name === pattern
  const last = pattern.lastIndexOf("*")
  const suffix = pattern.slice(last + 1)
  const end = name.length - suffix.length
  if (first > end || !name.startsWith(pattern.slice(0, first)) || !name.endsWith(suffix) ||
    !boundary(name, first) || !boundary(name, end)) return false
  let at = first
  for (const literal of pattern.slice(first + 1, last).split("*")) {
    if (literal === "") continue
    let next = name.indexOf(literal, at)
    while (next !== -1 && next + literal.length <= end) {
      if (boundary(name, next) && boundary(name, next + literal.length)) break
      next = name.indexOf(literal, next + 1)
    }
    if (next === -1 || next + literal.length > end) return false
    at = next + literal.length
  }
  return true
}

const matchDirectory = (
  segments: ReadonlyArray<string>,
  directory: string,
  spend: (comparisons: number) => boolean
): boolean | undefined => {
  const parts = directory.split("/")
  const first = segments.indexOf("**")
  const prefix = first === -1 ? segments : segments.slice(0, first)
  if (first === -1 && prefix.length !== parts.length) return false
  const last = segments.lastIndexOf("**")
  const suffix = first === -1 ? [] : segments.slice(last + 1)
  const end = parts.length - suffix.length
  const matchesAt = (pattern: ReadonlyArray<string>, at: number): boolean =>
    pattern.every((segment, index) => matchesName(segment, parts[at + index]!))
  if (prefix.length > end || !matchesAt(prefix, 0) || !matchesAt(suffix, end)) return false
  if (first === last) return true
  const subject = `/${directory}/`
  // Each offset points to the slash immediately before a component.
  const offsets = [0]
  for (const part of parts) offsets.push(offsets[offsets.length - 1]! + part.length + 1)
  let at = prefix.length
  let chunk: Array<string> = []
  for (const segment of segments.slice(first + 1, last + 1)) {
    if (segment !== "**") {
      chunk.push(segment)
      continue
    }
    if (chunk.length === 0) continue
    if (chunk.every((segment) => !/[*/]/.test(segment))) {
      const literal = `/${chunk.join("/")}/`
      const next = subject.indexOf(literal, offsets[at])
      if (next === -1 || next + literal.length - 1 > offsets[end]!) return false
      while (offsets[at]! < next) at += 1
    } else {
      while (at + chunk.length <= end) {
        if (!spend(chunk.length)) return undefined
        if (matchesAt(chunk, at)) break
        at += 1
      }
      if (at + chunk.length > end) return false
    }
    at += chunk.length
    chunk = []
  }
  return true
}

/** Matches directory components with globstars between components. */
export const matchesDirectory = (segments: ReadonlyArray<string>, directory: string): boolean =>
  matchDirectory(segments, directory, () => true) === true

type DirectoryMatcher = (segments: ReadonlyArray<string>, directory: string) => boolean | undefined
type DirectoryTest = (directory: string) => boolean | undefined

/**
 * Matches directories for one selection. A mixed chunk can compare its full
 * length at each offset between globstars. Share a comparison budget across
 * all candidates and patterns, returning `undefined` if it runs out.
 */
export const boundedDirectoryMatcher = (): DirectoryMatcher => {
  let remaining = 65_536
  const spend = (comparisons: number): boolean => {
    remaining -= comparisons
    return remaining >= 0
  }
  return (segments, directory) => matchDirectory(segments, directory, spend)
}

const patternTest = (pattern: string, match: DirectoryMatcher, npm: boolean): DirectoryTest | undefined => {
  if (/[{}[\]?\\]/.test(pattern)) return undefined
  const segments = pattern.split("/").filter((segment) => segment !== "" && segment !== ".")
  if (segments.includes("..")) return undefined
  const hiddenSegments = segments.flatMap((segment, index) => segment.startsWith(".") ? [index] : [])
  return (directory) => {
    if (!npm || !/(?:^|\/)\./.test(directory)) return match(segments, directory)
    const parts = directory.split("/")
    const hiddenParts = parts.flatMap((part, index) => part.startsWith(".") ? [index] : [])
    if (hiddenParts.length !== hiddenSegments.length) return false
    let patternStart = 0
    let pathStart = 0
    for (let index = 0; index <= hiddenParts.length; index++) {
      const patternEnd = hiddenSegments[index] ?? segments.length
      const pathEnd = hiddenParts[index] ?? parts.length
      const chunk = segments.slice(patternStart, patternEnd)
      const matched = pathStart === pathEnd
        ? chunk.every((segment) => segment === "**")
        : match(chunk, parts.slice(pathStart, pathEnd).join("/"))
      if (matched !== true) return matched
      if (index < hiddenParts.length && !matchesName(segments[patternEnd]!, parts[pathEnd]!)) return false
      patternStart = patternEnd + 1
      pathStart = pathEnd + 1
    }
    return true
  }
}

const matchesAny = (tests: ReadonlyArray<DirectoryTest>, directory: string): boolean | undefined => {
  for (const test of tests) {
    const matched = test(directory)
    if (matched !== false) return matched
  }
  return false
}

// Settings in `.npmrc` that change which packages a run selects.
const selecting = /^\s*(?:include-workspace-root|workspaces?|recursive|filter(?:-prod)?)\s*=/m

/**
 * The workspace patterns: `pnpm-workspace.yaml`'s `packages` when the file
 * exists, else the root manifest's `workspaces`. `undefined` when the
 * repository declares no workspace or the file does not parse.
 *
 * `orchestrated` is true when `pnpm-workspace.yaml` configures `tasks` or
 * `includeWorkspaceRoot`, or the root `.npmrc` sets which packages a run
 * selects. `npmrc` is that file's text: empty when there is none, and
 * `null` when it exists and cannot be read, which counts as setting it.
 *
 * @category reading
 * @since 0.1.0
 */
export const readPatterns = (
  manifest: Readonly<Record<string, unknown>>,
  pnpmWorkspace: string | undefined,
  npmrc: string | null = ""
): { readonly patterns: ReadonlyArray<string>; readonly orchestrated: boolean } | undefined => {
  const selects = npmrc === null || selecting.test(npmrc)
  if (pnpmWorkspace !== undefined) {
    try {
      const parsed: unknown = parseYaml(pnpmWorkspace)
      if (!isRecord(parsed) || !Array.isArray(parsed["packages"])) return undefined
      return {
        patterns: strings(parsed["packages"]),
        orchestrated: selects || parsed["tasks"] !== undefined || parsed["includeWorkspaceRoot"] === true
      }
    } catch {
      return undefined
    }
  }
  const workspaces = manifest["workspaces"]
  const listed = isRecord(workspaces) ? workspaces["packages"] : workspaces
  return Array.isArray(listed) ? { patterns: strings(listed), orchestrated: selects } : undefined
}

/**
 * The directories that are workspace packages: those holding a
 * `package.json` that a pattern includes and none excludes. `undefined` when
 * a pattern cannot be read or the mixed-globstar comparison budget is
 * exhausted. The caller keeps the original command in either case.
 *
 * @category reading
 * @since 0.1.0
 */
export const packageDirectories = (
  patterns: ReadonlyArray<string>,
  files: ReadonlySet<string>,
  npm = true
): ReadonlyArray<string> | undefined => {
  const match = boundedDirectoryMatcher()
  const include: Array<DirectoryTest> = []
  const exclude: Array<DirectoryTest> = []
  for (const pattern of patterns) {
    const test = patternTest(pattern.startsWith("!") ? pattern.slice(1) : pattern, match, npm)
    if (test === undefined) return undefined
    ;(pattern.startsWith("!") ? exclude : include).push(test)
  }
  const found: Array<string> = []
  for (const file of files) {
    if (!file.endsWith("/package.json") || file.split("/").includes("node_modules")) continue
    const directory = file.slice(0, -"/package.json".length)
    const included = matchesAny(include, directory)
    if (included === undefined) return undefined
    if (!included) continue
    const excluded = matchesAny(exclude, directory)
    if (excluded === undefined) return undefined
    if (!excluded) found.push(directory)
  }
  return found.sort()
}

const dependencyFields = ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"] as const

/**
 * Builds the workspace from the root manifest and each package's manifest
 * text. `undefined` when a package's manifest is not a JSON object, has no
 * name, or shares its name: a package manager then selects packages in a way
 * this reader cannot follow.
 *
 * @category reading
 * @since 0.1.0
 */
export const assemble = (
  manager: Manager,
  root: Readonly<Record<string, unknown>>,
  orchestrated: boolean,
  manifests: ReadonlyArray<readonly [directory: string, text: string]>
): Workspace | undefined => {
  const read: Array<readonly [string, string, Record<string, unknown>]> = []
  for (const [directory, text] of manifests) {
    const manifest = readObject(text)
    const name = manifest?.["name"]
    if (manifest === undefined || typeof name !== "string" || name === "") return undefined
    read.push([directory, name, manifest])
  }
  const names = new Set(read.map(([, name]) => name))
  if (names.size !== read.length) return undefined
  const scriptsOf = (manifest: Readonly<Record<string, unknown>>): Record<string, string> => {
    const scripts = manifest["scripts"]
    return Object.fromEntries(
      Object.entries(isRecord(scripts) ? scripts : {}).filter((entry): entry is [string, string] =>
        typeof entry[1] === "string"
      )
    )
  }
  return {
    manager,
    rootName: typeof root["name"] === "string" ? root["name"] : undefined,
    rootScripts: scriptsOf(root),
    orchestrated,
    packages: read.map(([directory, name, manifest]) => ({
      name,
      directory,
      scripts: scriptsOf(manifest),
      dependencies: [
        ...new Set(dependencyFields.flatMap((field) => {
          const declared = manifest[field]
          return isRecord(declared) ? Object.keys(declared).filter((dependency) => names.has(dependency)) : []
        }))
      ].sort()
    }))
  }
}

// The characters a path or a package name is written with.
const pathCharacter = new Uint8Array(128)
for (const character of "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_@.~/-") {
  pathCharacter[character.charCodeAt(0)] = 1
}

// Every run of path characters that holds a slash, with where it starts.
// Found from each slash outward, so the cost is one pass over the text.
const slashedRuns = (text: string): ReadonlyArray<readonly [run: string, start: number]> => {
  const runs: Array<readonly [string, number]> = []
  for (let slash = text.indexOf("/"); slash >= 0;) {
    let start = slash
    while (start > 0 && pathCharacter[text.charCodeAt(start - 1)] === 1) start -= 1
    let end = slash + 1
    while (end < text.length && pathCharacter[text.charCodeAt(end)] === 1) end += 1
    runs.push([text.slice(start, end), start])
    slash = text.indexOf("/", end)
  }
  return runs
}

const dotsOnly = /^(?:\.{0,2}\/)*\.{0,2}$/
const quotes = new Set(["\"", "'", "`"])

/**
 * Makes the reader of one file's mentions for a workspace.
 *
 * - A scoped package name counts wherever it appears. An unscoped name is an
 *   ordinary word, so it counts only inside quotes, after `node_modules/`,
 *   or anywhere in text read as `bare`, such as a script.
 * - A relative path is a run of path characters that starts with `./` or
 *   `../` and names something: `../..` alone names only a directory above,
 *   and what is read from there is named by other text.
 * - A rooted path is a run of path characters that starts with the first
 *   directory of some package's path, such as `packages/core/src/a.ts`.
 *
 * @category scanning
 * @since 0.1.0
 */
export const scanner = (workspace: Workspace): (text: string, bare: boolean) => Mentions => {
  const names = new Set(workspace.packages.map((candidate) => candidate.name))
  const tops = new Set(workspace.packages.map((candidate) => candidate.directory.split("/")[0] as string))
  const unscopedNames = [...names].filter((name) => !name.includes("/")).map((name) =>
    name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
  )
  const unscoped = new RegExp(`(?<![A-Za-z0-9_@.~/-])(?:${unscopedNames.join("|")})(?![A-Za-z0-9_@.~/-])`, "g")
  return (text, bare) => {
    const found = new Set<string>()
    const relative = new Set<string>()
    const rooted = new Set<string>()
    for (const [run, start] of slashedRuns(text)) {
      const modules = (`/${run}`).lastIndexOf("/node_modules/")
      if (modules < 0 && (run.startsWith("./") || run.startsWith("../"))) {
        if (!dotsOnly.test(run)) relative.add(run)
        continue
      }
      const specifier = modules < 0 ? run : run.slice(modules + "node_modules/".length)
      const parts = specifier.split("/")
      const scoped = specifier.startsWith("@")
      const name = scoped ? `${parts[0]}/${(parts[1] ?? "").replace(/(?:@.*|\.+)$/, "")}` : parts[0] as string
      if (names.has(name) && (scoped || bare || modules >= 0 || quotes.has(text[start - 1] ?? ""))) {
        found.add(name)
      }
      if (tops.has(parts[0] as string) && modules < 0) rooted.add(run)
    }
    if (unscopedNames.length > 0) {
      for (const match of text.matchAll(unscoped)) {
        if (bare || quotes.has(text[match.index - 1] ?? "")) found.add(match[0])
      }
    }
    return { names: [...found].sort(), relative: [...relative].sort(), rooted: [...rooted].sort() }
  }
}

/**
 * What a `package.json` mentions. Its scripts name packages bare, as in
 * `pnpm --filter ui build`, so there an unscoped name counts anywhere. In
 * the rest of the file a name counts as it does in any text: a script's own
 * name, such as `build:website`, names no package.
 *
 * @category scanning
 * @since 0.1.0
 */
export const manifestMentions = (scan: (text: string, bare: boolean) => Mentions, text: string): Mentions => {
  const scripts = readObject(text)?.["scripts"]
  const bodies = Object.values(isRecord(scripts) ? scripts : {}).filter((body) => typeof body === "string").join("\n")
  const parts = [scan(bodies, true), scan(text, false)]
  const union = (pick: (mentions: Mentions) => ReadonlyArray<string>): ReadonlyArray<string> =>
    [...new Set(parts.flatMap(pick))].sort()
  return {
    names: union((mentions) => mentions.names),
    relative: union((mentions) => mentions.relative),
    rooted: union((mentions) => mentions.rooted)
  }
}

const extensions = ["", ".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs", ".json"]
const swaps: ReadonlyArray<readonly [from: RegExp, to: ReadonlyArray<string>]> = [
  [/\.js$/, [".ts", ".tsx"]],
  [/\.jsx$/, [".tsx"]],
  [/\.mjs$/, [".mts"]],
  [/\.cjs$/, [".cts"]]
]

/**
 * Joins a relative path to a directory, both from the repository root.
 * `undefined` when the result leaves the repository.
 *
 * @category paths
 * @since 0.1.0
 */
export const join = (directory: string, relative: string): string | undefined => {
  const parts = directory === "" ? [] : directory.split("/")
  for (const segment of relative.split("/")) {
    if (segment === "" || segment === ".") continue
    if (segment !== "..") parts.push(segment)
    else if (parts.pop() === undefined) return undefined
  }
  return parts.join("/")
}

/**
 * The file a path written in source names: itself, or with an extension or
 * `index` a JavaScript resolver would try.
 *
 * @category paths
 * @since 0.1.0
 */
export const resolveFile = (path: string, files: ReadonlySet<string>): string | undefined => {
  const candidates = [
    ...extensions.map((extension) => `${path}${extension}`),
    ...swaps.flatMap(([from, to]) => from.test(path) ? to.map((extension) => path.replace(from, extension)) : []),
    ...extensions.slice(1).map((extension) => `${path}/index${extension}`)
  ]
  return candidates.find((candidate) => files.has(candidate))
}

// The directory of a file inside a package, which always has one.
const directoryOf = (file: string): string => file.slice(0, Math.max(0, file.lastIndexOf("/")))

/**
 * Answers what a package's task can read inside other packages. Built once
 * for a workspace by {@link graph}.
 *
 * @category models
 * @since 0.1.0
 */
export interface Graph<A = Reach> {
  /** The deepest package whose directory holds a path. */
  readonly ownerOf: (path: string) => Package | undefined
  /** The package with a name. */
  readonly named: (name: string) => Package | undefined
  /** Everything a package or file reaches. With no start, read the shared inputs at the repository root. */
  readonly reachOf: (start?: Package | string) => A
  /** Globs for every file outside all packages. */
  readonly outside: ReadonlyArray<string>
}

interface Edges {
  readonly packages: ReadonlyArray<Package>
  readonly files: ReadonlyArray<string>
  readonly incomplete: boolean
}

type FileMentions = Mentions & { readonly incomplete?: boolean }
type Walk<A> = Generator<string, A, FileMentions | undefined>
type Start = Package | string | undefined

/**
 * Builds the reach graph of a workspace.
 *
 * A package reaches, to a fixed point:
 *
 * - every workspace package it declares or its files mention by name, whole;
 * - every path in its files that names something in another package. One
 *   that names a file adds that file, and then what that file mentions; one
 *   that names anything else adds that package whole.
 *
 * `files` are the repository's files, and `mentioned` gives one file's
 * mentions. A relative path is read from the file's directory and the package's directory, where a
 * program runs. A rooted path is read from the repository root.
 *
 * @category closure
 * @since 0.1.0
 */
const makeGraph = <A>(
  workspace: Workspace,
  files: ReadonlySet<string>,
  read: (walk: () => Walk<Reach>) => A
): Graph<A> => {
  const byName = new Map(workspace.packages.map((candidate) => [candidate.name, candidate]))
  const byDirectory = new Map(workspace.packages.map((candidate) => [candidate.directory, candidate]))

  const ownerOf = (path: string): Package | undefined => {
    for (let end = path.length; end > 0; end = path.lastIndexOf("/", end - 1)) {
      const owner = byDirectory.get(path.slice(0, end))
      if (owner !== undefined) return owner
    }
    return undefined
  }

  const owned = new Map<string, Array<string>>(workspace.packages.map((candidate) => [candidate.name, []]))
  for (const file of files) {
    const owner = ownerOf(file)
    if (owner !== undefined) (owned.get(owner.name) as Array<string>).push(file)
  }

  const mentions = new Map<string, FileMentions | undefined>()
  // What one file adds. `whole` is true when the file's own package is
  // already reached whole, so paths that stay inside it add nothing.
  function* edgesOfFile(file: string, owner: Package | undefined, whole: boolean): Walk<Edges> {
    if (!mentions.has(file)) mentions.set(file, yield file)
    const found = mentions.get(file)
    if (found === undefined) return { packages: [], files: [], incomplete: true }
    const packages = found.names.map((name) => byName.get(name) as Package)
    const single: Array<string> = []
    const targets = found.rooted.map((path) => join("", path))
    for (const path of found.relative) {
      const beside = join(directoryOf(file), path)
      targets.push(beside)
      targets.push(join(owner?.directory ?? "", path))
    }
    for (const target of targets) {
      const targetOwner = target === undefined ? undefined : ownerOf(target)
      if (target === undefined || (whole && targetOwner === owner)) continue
      const resolved = resolveFile(target, files)
      if (resolved !== undefined && ownerOf(resolved) === targetOwner) single.push(resolved)
      // A path that names no file may name anything in that package.
      else if (targetOwner !== undefined) packages.push(targetOwner)
    }
    return { packages, files: single, incomplete: found.incomplete === true }
  }

  const packageEdges = new Map<string, Edges>()
  function* edgesOfPackage(start: Package): Walk<Edges> {
    const known = packageEdges.get(start.name)
    if (known !== undefined) return known
    const parts: Array<Edges> = []
    for (const file of owned.get(start.name)!) parts.push(yield* edgesOfFile(file, start, true))
    const edges: Edges = {
      packages: [
        ...new Set([
          ...start.dependencies.map((name) => byName.get(name) as Package),
          ...parts.flatMap((part) => part.packages)
        ])
      ],
      files: [...new Set(parts.flatMap((part) => part.files))],
      incomplete: parts.some((part) => part.incomplete)
    }
    packageEdges.set(start.name, edges)
    return edges
  }

  const fileEdges = new Map<string, Edges>()
  function* edgesOfSingle(file: string): Walk<Edges> {
    const known = fileEdges.get(file)
    if (known !== undefined) return known
    const edges = yield* edgesOfFile(file, ownerOf(file), false)
    fileEdges.set(file, edges)
    return edges
  }

  const reaches = new Map<Start, Reach>()
  function* walk(start: Start): Walk<Reach> {
    const known = reaches.get(start)
    if (known !== undefined) return known
    const packages = new Set<Package>()
    const single = new Set<string>()
    const pending = start === undefined ? [...files].filter((file) => !file.includes("/")) : [start]
    let incomplete = false
    while (pending.length > 0) {
      const next = pending.pop() as Package | string
      if (typeof next === "string" ? single.has(next) : packages.has(next)) continue
      const edges = typeof next === "string" ? yield* edgesOfSingle(next) : yield* edgesOfPackage(next)
      if (typeof next === "string") single.add(next)
      else packages.add(next)
      for (const nextPackage of edges.packages) pending.push(nextPackage)
      for (const nextFile of edges.files) pending.push(nextFile)
      incomplete ||= edges.incomplete
    }
    const reached = [...single].filter((file) => {
      const owner = ownerOf(file)
      // The outside globs already name all root inputs and other files outside packages.
      return owner === undefined ? start !== undefined : !packages.has(owner)
    })
    const reach = {
      packages: new Set([...packages].map((reached) => reached.directory)),
      files: new Set(incomplete ? [...reached, "**"] : reached)
    }
    reaches.set(start, reach)
    return reach
  }

  return { ownerOf, named: (name) => byName.get(name), reachOf: (start) => read(() => walk(start)), outside: outsideGlobs(workspace, files) }
}

/** Builds a graph from file facts already in memory. */
export const graph = (
  workspace: Workspace,
  files: ReadonlySet<string>,
  mentioned: (file: string) => Mentions,
  unknown: ReadonlySet<string> = new Set()
): Graph => makeGraph(workspace, files, (makeWalk) => {
  const walk = makeWalk()
  let next = walk.next()
  while (!next.done) {
    const found = mentioned(next.value)
    next = walk.next(unknown.has(next.value) ? { ...found, incomplete: true } : found)
  }
  return next.value
})

/** Builds a graph that reads a file only the first time a query reaches it. */
export const lazyGraph = (
  workspace: Workspace,
  files: ReadonlySet<string>,
  readFile: (file: string) => (Mentions | undefined)!!
): Graph<Reach!!> => makeGraph(workspace, files, (makeWalk) => effect {
  const walk = makeWalk()
  let next = walk.next()
  while (!next.done) next = walk.next(try readFile(next.value))
  return next.value
})

/**
 * The directories that hold a package somewhere below them, the repository
 * root (`""`) included.
 *
 * @category paths
 * @since 0.1.0
 */
export const spineOf = (workspace: Workspace): ReadonlySet<string> => {
  const spine = new Set<string>([""])
  const owned = new Set(workspace.packages.map((candidate) => candidate.directory))
  for (const directory of owned) {
    const parts = directory.split("/")
    for (let length = 1; length < parts.length; length += 1) {
      const above = parts.slice(0, length).join("/")
      if (!owned.has(above)) spine.add(above)
    }
  }
  return spine
}

/** Tests whether a literal input path would be interpreted as glob syntax.
 *
 * @category paths
 * @since 0.1.0
 */
export const globMagic = /[*?[\]{}\\]|[@+!]\(|^[!#]/

/**
 * Globs for every file outside all packages: each file directly in a
 * directory above a package, and each other directory there, whole. Every
 * package step reads these, as it reads the lockfile and root configuration.
 *
 * @category paths
 * @since 0.1.0
 */
export const outsideGlobs = (workspace: Workspace, files: ReadonlySet<string>): ReadonlyArray<string> => {
  const spine = spineOf(workspace)
  const owned = new Set(workspace.packages.map((candidate) => candidate.directory))
  const globs = new Set<string>()
  for (const directory of spine) globs.add(directory === "" ? "*" : `${directory}/*`)
  for (const file of files) {
    const parts = file.split("/")
    for (let length = 1; length < parts.length; length += 1) {
      const directory = parts.slice(0, length).join("/")
      if (owned.has(directory)) break
      if (!spine.has(directory)) {
        globs.add(`${directory}/**`)
        break
      }
    }
  }
  if ([...globs].some((glob) => globMagic.test(glob.replace(/\/?\*+$/, "")))) return ["**"]
  return [...globs].sort()
}
