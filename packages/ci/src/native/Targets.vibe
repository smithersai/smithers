/**
 * Which targets a replay runs on a repository that already builds with
 * Smithers build: the patterns its CI gives `smthrs`.
 *
 * @since 0.1.0
 */

import { ciJobs, type Inventory, type Job, type NotReplayed, withVariant } from "../contract/Inventory.vibe"

/**
 * The pattern for every target of a workspace. It is replayed when the
 * repository's CI names no pattern.
 *
 * @category constants
 * @since 0.1.0
 */
export const everything = "//..."

/**
 * The `Unsupported.feature` of a CI job no step of which runs a Smithers
 * build target. Its commands are not replayed.
 *
 * @category constants
 * @since 0.1.0
 */
export const notTargets = "not-smithers-build"

/**
 * The `Unsupported.feature` of a CI job whose targets were not all asked for.
 *
 * @category constants
 * @since 0.1.0
 */
export const notSelected = "not-selected"

/**
 * The patterns a replay runs, where they came from, and the CI jobs they do
 * not cover. `request` is what the caller named, `ci` what the repository's
 * CI runs, and `default` is {@link everything}.
 *
 * @category models
 * @since 0.1.0
 */
export interface Chosen {
  readonly patterns: ReadonlyArray<string>
  readonly from: "request" | "ci" | "default"
  readonly left: ReadonlyArray<NotReplayed>
}

/** The names Smithers build's command-line program is installed under. */
const programs: ReadonlyArray<string> = ["smthrs", "smithers-build"]

/** The verbs that run targets. `smthrs ci` runs what each of the others selects. */
const verbs: ReadonlyArray<string> = ["ci", "test", "lint", "build"]

/** The shells whose `-c` argument is a script. */
const shells: ReadonlyArray<string> = ["bash", "sh", "zsh", "dash"]

/**
 * Words that may stand before the program a command runs: package manager
 * launchers, command wrappers and the shell's own keywords.
 */
const prefixes: ReadonlyArray<string> = [
  "pnpm",
  "npm",
  "npx",
  "bunx",
  "bun",
  "yarn",
  "exec",
  "x",
  "dlx",
  "run",
  "--",
  "env",
  "time",
  "command",
  "nice",
  "if",
  "then",
  "elif",
  "else",
  "do",
  "while",
  "until",
  "!",
  "{"
]

/** A variable set for one command, as in `CI=1 smthrs ci //...`. */
const assignment = /^[A-Za-z_][A-Za-z0-9_]*=/

/** The characters that end a command or its arguments: separators, grouping and redirections. */
const operators = ";&|\n()<>"

/**
 * The commands of a shell script, each as its words, unquoted as a shell
 * does it: quoted and bare pieces that touch are one word, a backslash keeps
 * the next character, and a backslash before a line end joins two lines. A
 * `#` that starts a word starts a comment. An operator ends a command.
 */
const commandsOf = (script: string): ReadonlyArray<ReadonlyArray<string>> => {
  const commands: Array<Array<string>> = [[]]
  const documents: Array<{ end: string; stripTabs: boolean }> = []
  let text: string | undefined = undefined
  const close = (): void => {
    if (text !== undefined) (commands.at(-1) as Array<string>).push(text)
    text = undefined
  }
  for (let at = 0; at < script.length; at++) {
    const char = script.charAt(at)
    if (char === "'") {
      const end = script.indexOf("'", at + 1)
      const stop = end === -1 ? script.length : end
      text = (text ?? "") + script.slice(at + 1, stop)
      at = stop
    } else if (char === "\"") {
      text = text ?? ""
      for (at += 1; at < script.length && script.charAt(at) !== "\""; at++) {
        // Inside double quotes a backslash keeps a quote, a backslash, a dollar or a backtick.
        if (script.charAt(at) === "\\" && /["\\$`]/.test(script.charAt(at + 1))) at += 1
        text += script.charAt(at)
      }
    } else if (char === "\\") {
      at += 1
      if (script.charAt(at) !== "\n") text = (text ?? "") + script.charAt(at)
    } else if (char === "#" && text === undefined) {
      const end = script.indexOf("\n", at)
      at = (end === -1 ? script.length : end) - 1
    } else if (char === "<" && script.startsWith("<<<", at)) {
      close()
      at += 2
    } else if (char === "<" && script.startsWith("<<", at)) {
      close()
      const marker = /^<<(-?)[ \t]*((?:[a-zA-Z0-9_./-]+|'[^'\n]*'|"[^"\n]*"|\\[^\n])+)/.exec(script.slice(at))
      if (marker === null) break
      const end = (marker[2] as string).replace(/'([^']*)'|"([^"]*)"|\\(.)/g, (_match, single, double, escaped) => single ?? double ?? escaped)
      documents.push({ end, stripTabs: marker[1] === "-" })
      at += marker[0].length - 1
    } else if (operators.includes(char)) {
      close()
      commands.push([])
      if (char === "\n") {
        for (const document of documents.splice(0)) {
          while (at < script.length) {
            const start = at + 1
            const newline = script.indexOf("\n", start)
            at = newline === -1 ? script.length : newline
            const line = script.slice(start, at)
            if ((document.stripTabs ? line.replace(/^\t+/, "") : line) === document.end) break
          }
        }
      }
    } else if (char === " " || char === "\t") {
      close()
    } else {
      text = (text ?? "") + char
    }
  }
  close()
  return commands
}

const nameOf = (word: string | undefined): string => (word ?? "").replace(/^.*\//, "")

/** A label or a pattern as written, with nothing left for the shell or the CI host to fill in. */
const isPattern = (word: string): boolean => word.startsWith("//") && !word.includes("$")

/** The patterns one command gives Smithers build, or the patterns of the script it hands a shell. */
const invocationsOf = (words: ReadonlyArray<string>): ReadonlyArray<ReadonlyArray<string>> => {
  const start = words.findIndex((word) => !assignment.test(word) && !prefixes.includes(word))
  const rest = start === -1 ? [] : words.slice(start)
  if (shells.includes(nameOf(rest[0]))) {
    const flag = rest.findIndex((word) => /^-[A-Za-z]*c$/.test(word))
    return flag === -1 ? [] : commandsOf(rest[flag + 1] ?? "").flatMap(invocationsOf)
  }
  if (!programs.includes(nameOf(rest[0]))) return []
  // Options, each with or without a value, may stand between the program and its verb.
  const verb = rest.findIndex((word, index) =>
    index > 0 && (verbs.includes(word) || !(word.startsWith("-") || (rest[index - 1] as string).startsWith("-")))
  )
  return verb === -1 || !verbs.includes(rest[verb] as string) ? [] : [rest.slice(verb)]
}

/**
 * The target patterns a shell script gives Smithers build: every argument
 * that starts with `//` after `smthrs ci`, `test`, `lint` or `build`, where
 * `smthrs` is the program a command runs, alone or through a package manager,
 * and in the script a command hands a shell with `-c`. A pattern a variable
 * holds is not one, and neither is anything in a comment or in the arguments
 * of another program.
 *
 * @category accessors
 * @since 0.1.0
 */
export const patternsIn = (script: string): ReadonlyArray<string> => commandsOf(script).flatMap(invocationsOf).flatMap((call) => call.slice(1).filter(isPattern))

const callsOf = (job: Job): ReadonlyArray<ReadonlyArray<string>> => {
  const variants: ReadonlyArray<Readonly<Record<string, string>>> = job.matrix.length === 0 ? [{}] : job.matrix
  return variants.flatMap((variant) => job.steps.flatMap((step) => commandsOf(withVariant(step, variant).command).flatMap(invocationsOf)))
}

const unique = (values: ReadonlyArray<string>): ReadonlyArray<string> => [...new Set(values)]

/** Selectors that the checkout's planner must expand using the original verb and flags. */
export const plansFor = (inventory: Inventory): ReadonlyArray<ReadonlyArray<string>> | string => {
  const plans: Array<ReadonlyArray<string>> = []
  let custom = false
  for (const job of ciJobs(inventory)) {
    for (const call of callsOf(job)) {
      const args = [call[0] as string]
      for (let i = 1; i < call.length; i++) {
        const word = call[i] as string
        if (isPattern(word) || word === "--include-exclusive") args.push(word)
        else if (word === "--ui" || word === "--jobs") i++
        else if (word !== "--verbose") return `cannot reproduce the target selection in ${job.id}: use --targets to name its targets`
      }
      custom ||= args[0] !== "ci" || args.includes("--include-exclusive")
      plans.push(args)
    }
  }
  return custom ? plans : []
}

const patternsOf = (job: Job): ReadonlyArray<string> => callsOf(job).flatMap((call) => {
  const patterns = call.slice(1).filter(isPattern)
  return patterns.length === 0 && !call.some((word) => word.includes("$")) ? [everything] : patterns
})

/**
 * Whether every target `pattern` selects is selected by `asked`: the same
 * pattern, `//...`, `//a/...` for anything in or under `//a`, or `//a:*` for a
 * target of `//a`.
 *
 * @category accessors
 * @since 0.1.0
 */
export const covers = (asked: string, pattern: string): boolean => {
  if (asked === pattern || asked === everything) return true
  if (asked.endsWith("/...")) {
    const base = asked.slice(0, -"/...".length)
    return pattern.startsWith(`${base}:`) || pattern.startsWith(`${base}/`)
  }
  return asked.endsWith(":*") && pattern.startsWith(asked.slice(0, -1))
}

/**
 * The patterns to replay for an inventory: `requested` when given, else
 * every pattern a job that runs on a change gives Smithers build, else
 * {@link everything}. `left` lists each such job with a step that the
 * patterns do not cover: one that runs no target, or one with a pattern that
 * no requested pattern {@link covers}.
 *
 * @category accessors
 * @since 0.1.0
 */
export const chosenFor = (inventory: Inventory, requested?: ReadonlyArray<string>): Chosen => {
  const jobs = ciJobs(inventory).filter((job) => job.steps.length > 0).map((job) => ({
    job,
    patterns: unique(patternsOf(job))
  }))
  const fromCi = unique(jobs.flatMap((entry) => entry.patterns))
  const asked = requested !== undefined && requested.length > 0
  const patterns = asked ? unique(requested) : fromCi.length > 0 ? fromCi : [everything]
  const left = jobs.flatMap((entry): ReadonlyArray<NotReplayed> => {
    const file = entry.job.file
    if (entry.patterns.length === 0) {
      return [{
        job: entry.job.id,
        reasons: [{ feature: notTargets, detail: `${file}: no step runs Smithers build targets` }]
      }]
    }
    const missing = entry.patterns.filter((pattern) => !patterns.some((asked) => covers(asked, pattern)))
    if (missing.length === 0) return []
    const detail = `${file}: ${missing.length} of its ${entry.patterns.length} patterns are not among those asked for`
    return [{ job: entry.job.id, reasons: [{ feature: notSelected, detail }] }]
  })
  return { patterns, from: asked ? "request" : fromCi.length > 0 ? "ci" : "default", left }
}
