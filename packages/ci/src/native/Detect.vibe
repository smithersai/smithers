/**
 * Finds a repository's own Smithers build files on disk.
 *
 * @since 0.1.0
 */

import { applyRefuses } from "../contract/Command.vibe"
import { isGenerated } from "./Workspace.vibe"

/**
 * A file's text. `undefined` when it does not exist, which includes a file
 * standing where its directory would be, and empty when it exists and cannot
 * be read.
 */
effect function textOf(file: string) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  return fs.readFileString(file) catch effect (error) => {
    if (error.reason._tag === "NotFound") return undefined
    const directory = fs.stat(path.dirname(file)) catch () => undefined
    return directory === undefined || directory.type === "Directory" ? "" : undefined
  }
}

/**
 * The workspace file of the repository at `root` that its owner wrote, or
 * `undefined`. A workspace `smithers-ci` generated is not one, and a file
 * that cannot be read is.
 *
 * @category accessors
 * @since 0.1.0
 */
export effect function workspace(root: string) {
  const path = try Path.Path
  for (const file of applyRefuses) {
    const text = try textOf(path.join(root, file))
    if (text !== undefined && !isGenerated(text)) return file
  }
  return undefined
}
