/**
 * The replay of a repository that already builds with Smithers build: its
 * own targets, cold against cached, at each past commit.
 *
 * Nothing is generated. The baseline is one `smthrs ci --no-cache` run in a
 * checkout with no cache, normal mode the same run in a checkout that keeps
 * its cache between commits, and both read their verdicts from the run
 * record `smthrs` writes.
 *
 * @since 0.1.0
 */

import * as ChildProcess from "effect/process/ChildProcess"
import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { applyRefuses } from "../contract/Command.ts"
import type { Failure, ReplayParts, ReplayRequest, RunReplay } from "../contract/Parts.ts"
import type { ReplayCommit, ReplayReport } from "../contract/ReplayReport.ts"
import { type Mode, RunRecord, type TargetResult } from "../contract/RunRecord.ts"
import { defaultSettings, type Row } from "../contract/Selection.ts"
import { type Confined, confine, held, reading, type Way } from "../replay/Confine.vibe"
import { noPushUrl, searchPath, stepEnvironment } from "../replay/Environment.ts"
import { probe } from "../replay/Jail.ts"
import { nothingPassed, printedLimit } from "../replay/Failures.ts"
import { printsNotes, readsListener } from "../replay/Reads.ts"
import { type Execute, Options, Progress, settle } from "../replay/Replay.vibe"
import {
  choose,
  failure,
  flakyOf,
  mismatchesOf,
  planOfPrinted,
  predictedSafe,
  PrintedPlan,
  recordOf,
  reportOf,
  selectionOf,
  totalsOf,
  withoutCredentials
} from "../replay/Summary.ts"
import {
  commandFailed,
  type Installed,
  installDirectories,
  installLabel,
  managerFor,
  noSmthrs,
  smthrsBin
} from "./Install.ts"
import { linesOf, noRecord, noRecordLabel, ranAgain, ranAgainLines, withReasons } from "./Results.ts"
import { chosenFor } from "./Targets.ts"
import { isGenerated } from "./Workspace.ts"

/** Why `--targets` cannot be honoured on a repository that has no targets of its own. */
const noWorkspace =
  "--targets names Smithers build patterns, and this repository has no Smithers workspace of its own (.smithers/WORKSPACE.ts or WORKSPACE.ts)"

/** The cache directory, kept between commits in normal and fast mode. */
const cacheDirectory = ".flows"
const outputLimit = 4000

/**
 * The host services this replay uses.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = ChildProcessSpawner | FileSystem.FileSystem | Path.Path

interface Output {
  readonly exitCode: number
  readonly text: string
}

/**
 * Runs a command to its end, with end of file on its standard input, and keeps the last `limit` characters of what
 * it printed. `env` is added to this process's environment, or is the whole environment when `whole` is set, as it
 * is for what a past commit brings: its install scripts and its own `smthrs`.
 */
effect function exec(
  command: string,
  args: ReadonlyArray<string>,
  cwd: string,
  env: Readonly<Record<string, string | undefined>>,
  limit: number,
  stream: "all" | "stdout" = "all",
  whole = false,
  heard: (chunk: string) => void!! = () => Effect.void
) {
  const spawner = try ChildProcessSpawner
  return scoped(effect {
    const handle = try spawner.spawn(
      ChildProcess.make(command, [...args], { cwd, env: { ...env }, extendEnv: !whole, stdin: "ignore" })
    )
    const kept = try Ref.make("")
    const reader = fork ((stream === "all" ? handle.all : handle.stdout)
      |> Stream.decodeText(%)
      |> Stream.runForEach(%, effect (chunk: string) => {
        try Ref.update(kept, (text) => (text + chunk).slice(-limit))
        try heard(chunk)
      }))
    const exitCode = try handle.exitCode
    // A process a target left running keeps the pipe open, so only complete output is waited for without a limit.
    if (limit === Number.POSITIVE_INFINITY) try Fiber.join(reader)
    else try timeoutOption(Fiber.await(reader), "1 second")
    return { exitCode: Number(exitCode), text: try Ref.get(kept) } satisfies Output
  }) catch effect (cause) => {
    throw failure("command-failed", `could not run ${command}: ${cause.message}`)
  }
}

/**
 * Runs git. With `place`, `cwd` is a copy a past commit's commands may have written, hooks and configuration
 * included, so git runs there as they do: in the jail, with their environment.
 */
effect function git(cwd: string, args: ReadonlyArray<string>, place: Confined | undefined = undefined) {
  const [command, ...rest] = place === undefined ? ["git", ...args] : held(place, [cwd], ["git", ...args])
  const output = place === undefined
    ? try exec(command, rest, cwd, {}, Number.POSITIVE_INFINITY)
    : try exec(command, rest, cwd, stepEnvironment({}, place), Number.POSITIVE_INFINITY, "all", true)
  if (output.exitCode !== 0) {
    throw failure("command-failed", `git ${args[0]} failed: ${output.text.slice(-outputLimit)}`)
  }
  return output.text
}

const lines = (text: string): ReadonlyArray<string> => text.split("\n").filter((line) => line !== "")

/**
 * The workspace file the repository at `root` holds at `HEAD` and its owner
 * wrote, or `undefined`: there is none, `smithers-ci` generated it, or `root`
 * is not a repository.
 *
 * @category accessors
 * @since 0.1.0
 */
export effect function committedWorkspace(root: string) {
  for (const file of applyRefuses) {
    const shown = exec("git", ["show", `HEAD:${file}`], root, {}, Number.POSITIVE_INFINITY, "stdout")
      catch (): Output => ({ exitCode: 1, text: "" })
    if (shown.exitCode === 0 && !isGenerated(shown.text)) return file
  }
  return undefined
}

/**
 * Installs a checkout's dependencies with the package manager each lockfile
 * names, in the workspace file's directory and at the root, and finds the
 * `smthrs` they bring. It never fails: a checkout that cannot be installed is
 * a failed commit, not a failed replay. An install runs the scripts of the
 * commit's dependencies, so it runs as a step does: in `place`.
 *
 * @category internals
 * @since 0.1.0
 */
export effect function install(checkout: string, workspaceFile: string, place: Confined): Installed!!Host {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directories = installDirectories(workspaceFile)
  for (const directory of directories) {
    const names = fs.readDirectory(path.join(checkout, directory)) catch (): ReadonlyArray<string> => []
    const manager = names.includes("package.json") ? managerFor(names) : undefined
    if (manager === undefined) continue
    const [command, ...args] = held(place, [checkout], manager.command)
    const ran = exec(command, args, path.join(checkout, directory), stepEnvironment({}, place), outputLimit, "all", true)
      catch (): Output => ({ exitCode: 127, text: "" })
    if (ran.exitCode !== 0) return { ok: false, reason: commandFailed(manager.command, directory, ran.exitCode) }
  }
  for (const directory of directories) {
    const smthrs = path.join(checkout, directory, smthrsBin)
    const present = fs.exists(smthrs) catch () => false
    if (present) return { ok: true, smthrs }
  }
  return { ok: false, reason: noSmthrs(directories) }
}

/** The one result of a commit whose install failed. */
const notInstalled = (reason: string): TargetResult => ({
  label: installLabel,
  status: "failed",
  key: "",
  durationMs: 0,
  error: reason
})

interface Measured {
  readonly results: ReadonlyArray<TargetResult>
  readonly wallMs: number
  readonly state: Installed
}

/**
 * Replays the last `request.commits` commits of a repository whose own
 * workspace file is `workspaceFile`.
 *
 * Commits run oldest first in three copies: the baseline's has no untracked
 * file when a commit starts, and the normal and fast ones only their cache.
 * Each is then installed, and its own `smthrs` runs the patterns. Wall time
 * covers the checkout, the install and the first pass, the same in every
 * mode; the reruns that label flaky targets, and the cleaning of a copy after
 * its run, are not counted.
 *
 * The copy's install and its `smthrs` get what a target gets of the
 * environment and no credential, so no run reads or writes a shared cache
 * the workspace declares. Both get a home and a temporary directory the
 * replay made and a `git` that refuses to push, and, where the machine can
 * hold one, a file-system jail: they can write the copy, that home and that
 * directory, and cannot read the person's credentials. The baseline, normal
 * mode and fast mode each have a home and a temporary directory of their own,
 * empty at the start and kept until the replay ends, so each fills the caches
 * its tools keep for their user itself. `request.cache` names one for normal
 * and fast mode. The baseline's first pass reads no cache at all.
 *
 * A commit that cannot be installed, or that `smthrs ci` cannot plan, is one
 * failed result in every mode. When no target passes in the baseline of any
 * commit, the replay fails `unsupported` with the newest commit's first
 * failure: the build does not run on this machine.
 *
 * @category parts
 * @since 0.1.0
 */
export const own = <R>(
  request: ReplayRequest,
  parts: ReplayParts<R>,
  workspaceFile: string
): ReplayReport!Failure!(R | Host) =>
  scoped(effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const options = try Options
    const progress = try Progress
    effect function orFail<A, E extends { readonly message: string }, S>(work: A!E!S, what: string) {
      return work catch effect (cause) => {
        throw failure("command-failed", `${what}: ${cause.message}`)
      }
    }
    const work = try orFail(fs.makeTempDirectoryScoped({ prefix: "smithers-ci-own-" }), "could not make a directory")
    const source = path.join(work, "source")
    const root = path.resolve(request.root)
    // Each mode has a home of its own: none finds a cache another mode filled.
    const places = try orFail(
      confine(work, options.confine ?? probe, progress.say, searchPath()),
      "could not make the homes of the runs"
    )
    // Where `smthrs` writes its run records: the one place it can write that an install cannot.
    const records = path.join(work, "records")
    try orFail(fs.makeDirectory(records), "could not make a directory")
    const origin = exec("git", ["remote", "get-url", "origin"], root, {}, outputLimit, "stdout")
      catch (): Output => ({ exitCode: 1, text: "" })
    try git(work, ["clone", "--quiet", "--no-checkout", root, source])
    const history = lines(try git(source, ["rev-list", "--first-parent", `--max-count=${request.commits}`, "HEAD"]))
    const commits = [...history].reverse()

    /**
     * A copy of the repository for one mode. It is named as the repository is and fetches from its remote, so what
     * reads the copy names the repository, not the copy. It can push nowhere.
     */
    effect function copyOf(way: Way) {
      const copy = path.join(work, way, path.basename(root))
      const noPush = ["--config", `remote.origin.pushurl=${noPushUrl}`]
      try git(work, ["clone", "--quiet", "--shared", "--no-checkout", ...noPush, source, copy])
      if (origin.exitCode === 0) try git(copy, ["remote", "set-url", "origin", withoutCredentials(origin.text)])
      // Every copy starts with a whole tree, so the first timed checkout is the same work in each mode.
      try git(copy, ["checkout", "--quiet", "--force", "--detach", "HEAD"], places[way])
      return copy
    }

    /** Removes every untracked and ignored file from `copy` but what `kept` names. */
    const clean = (copy: string, kept: ReadonlyArray<string>, place: Confined) =>
      git(copy, ["clean", "-ffdxq", ...kept.flatMap((name) => ["-e", name])], place)

    /** Puts `copy` at `commit` with nothing untracked but what `kept` names, and installs it. */
    effect function ready(copy: string, commit: string, kept: ReadonlyArray<string>, place: Confined) {
      try git(copy, ["checkout", "--quiet", "--force", "--detach", commit], place)
      try clean(copy, kept, place)
      return try install(copy, workspaceFile, place)
    }

    const normalCopy = try copyOf("normal")
    const spawner = try ChildProcessSpawner
    /**
     * Runs a part on the normal copy, which installs and targets write: every `git` the part starts there runs as
     * they do, in the jail, so a command one of them left in the copy's `.git/config` never runs outside it.
     */
    effect function onNormalCopy<A, E, S>(part: A!E!S) {
      provide ChildProcessSpawner = reading(spawner, places.normal, normalCopy) {
        return try part
      }
    }
    const inventory = try onNormalCopy(parts.read(normalCopy))
    const chosen = chosenFor(inventory, request.targets)
    try progress.say(`replaying the repository's own targets (${workspaceFile}): ${chosen.patterns.join(" ")}`)
    const baselineCopy = try copyOf("baseline")
    const fastCopy = request.modes.includes("fast") ? try copyOf("fast") : undefined

    const reads = readsListener()
    /** Says once in a replay that this machine cannot record what a step reads, when `smthrs` reports that. */
    const heard = effect (chunk: string) => {
      const sentence = reads(chunk)
      if (sentence !== undefined) try progress.say(sentence)
    }

    let runs = 0
    const jobs = request.jobs === undefined ? [] : ["--jobs", String(request.jobs)]

    /**
     * Where the shared cache `--cache` names is, for normal and fast mode. No run gets a credential: the copy's
     * `smthrs` is given what a target gets of the environment, so a shared cache the workspace declares is off in
     * every mode, and the baseline neither reads one nor stores into one.
     */
    const cacheEnv = request.cache === undefined ? {} : { SMITHERS_CACHE_URL: request.cache }

    /**
     * Runs the copy's own `smthrs` on targets, or on the patterns, and reads the run record it writes. Only the
     * baseline's first pass, the one that is timed, reads no cache: its reruns reuse what that pass built, as the
     * reruns of the other modes do.
     */
    const smthrs = (
      copy: string,
      cached: boolean,
      state: Installed,
      place: Confined
    ): Execute<Host> => (targets) => effect {
      if (!state.ok) return [notInstalled(state.reason)]
      const selected = (targets ?? chosen.patterns).filter((label) => label !== installLabel && label !== noRecordLabel)
      if (selected.length === 0) return []
      runs += 1
      const file = path.join(records, `run-${runs}.json`)
      const [command, ...args] = held(place, [copy, records], [
        state.smthrs,
        "ci",
        ...selected,
        "--workspace",
        copy,
        "--cache-dir",
        cacheDirectory,
        ...(cached || targets !== undefined ? [] : ["--no-cache"]),
        "--results-file",
        file,
        "--ui",
        "plain",
        ...jobs
      ])
      // The cache's address is the one thing the copy's own `smthrs` gets beyond what a target gets.
      const environment = { ...stepEnvironment({}, place), ...printsNotes, ...(cached ? cacheEnv : {}) }
      const output = try exec(command, args, copy, environment, printedLimit, "all", true, heard)
      // A run with no record is a commit `smthrs` could not plan: a failed commit, not a failed replay.
      const text = fs.readFileString(file) catch () => undefined
      if (text === undefined) return [noRecord(output.text)]
      const record = Schema.decodeUnknownEffect(Schema.fromJsonString(RunRecord))(text) catch () => undefined
      return record === undefined ? [noRecord(output.text)] : withReasons(record.results, output.text)
    }

    /** The plan of the patterns in the normal copy, which fast mode's rows are measured against. */
    effect function planOf(smthrs: string) {
      const plan = ["ci", ...chosen.patterns, "--plan", "--format", "json", "--workspace", normalCopy]
      const [command, ...args] = held(places.normal, [normalCopy], [smthrs, ...plan])
      const environment = { ...stepEnvironment({}, places.normal), ...cacheEnv }
      const planned = try exec(command, args, normalCopy, environment, Number.POSITIVE_INFINITY, "stdout", true)
      const printed = Schema.decodeUnknownEffect(Schema.fromJsonString(PrintedPlan))(planned.text) catch effect () => {
        throw failure("command-failed", `smthrs ci --plan printed no plan: ${planned.text.slice(-outputLimit)}`)
      }
      return planOfPrinted(printed)
    }

    /** One mode of one commit: the checkout, the install and the first pass are timed, the reruns are not. */
    effect function measure(
      at: string,
      copy: string,
      commit: string,
      cached: boolean,
      targets: ReadonlyArray<string> | undefined,
      place: Confined
    ) {
      try progress.say(at)
      const start = try Clock.currentTimeMillis
      const state = try ready(copy, commit, cached ? [cacheDirectory] : [], place)
      const execute = smthrs(copy, cached, state, place)
      const first = try execute(targets)
      const wallMs = (try Clock.currentTimeMillis) - start
      const results = try settle(execute, first, options.reruns, first.length)
      for (const line of linesOf(at, results, wallMs)) try progress.say(line)
      return { results, wallMs, state } satisfies Measured
    }

    const replayed: Array<ReplayCommit> = []
    const baselines: Array<RunRecord> = []
    /** The key each target last passed with in normal mode, by label. */
    const passedWith = new Map<string, string>()
    const allRows: Array<Row> = []
    const selected = new Map<string, ReadonlyArray<string>>()
    let flaky = 0

    for (const commit of commits) {
      const changed = lines(try git(source, ["show", "--format=", "--name-only", "--diff-merges=first-parent", commit]))
      const at = `${replayed.length + 1}/${commits.length} ${commit.slice(0, 7)}`
      const base = try measure(`${at} baseline`, baselineCopy, commit, false, undefined, places.baseline)
      // Each copy is cleaned after its run, untimed, so the next commit's timed setup starts from the same clean
      // tree in every mode.
      try clean(baselineCopy, [], places.baseline)
      const baseRecord = recordOf(base.results, commit, base.wallMs)
      baselines.push(baseRecord)
      const normal = try measure(`${at} normal`, normalCopy, commit, true, undefined, places.normal)
      for (const line of ranAgainLines(`${at} normal`, ranAgain(passedWith, normal.results))) try progress.say(line)
      for (const result of normal.results) {
        if (result.status === "ran" || result.status === "hit") passedWith.set(result.label, result.key)
        else passedWith.delete(result.label)
      }
      const normalRecord = recordOf(normal.results, commit, normal.wallMs, "normal")
      let fastPart: Pick<ReplayCommit, "fast"> = {}
      let fastMismatches: ReturnType<typeof mismatchesOf> = []
      flaky += flakyOf([baseRecord, normalRecord])
      if (fastCopy === undefined) try clean(normalCopy, [cacheDirectory], places.normal)
      else {
        const plan = normal.state.ok ? try planOf(normal.state.smthrs) : undefined
        const rows = plan === undefined ? [] : try onNormalCopy(parts.rows(normalCopy, normalRecord, plan))
        try clean(normalCopy, [cacheDirectory], places.normal)
        const scores = try parts.score(rows)
        const choice = choose(scores, request.settings ?? defaultSettings)
        // Only a target the patterns select can be named to `smthrs ci`; what it depends on runs with it.
        const named = plan === undefined ? undefined : new Set(plan.roots)
        const labels = normal.results.map((result) => result.label).filter((label) =>
          (named === undefined || named.has(label)) && !choice.skipped.has(label)
        )
        const fast = try measure(`${at} fast`, fastCopy, commit, true, labels, places.fast)
        try clean(fastCopy, [cacheDirectory], places.fast)
        const byLabel = new Map(fast.results.map((result) => [result.label, result]))
        const merged = normal.results.map((result) => byLabel.get(result.label) ?? predictedSafe(result.label))
        const fastRecord = recordOf(merged, commit, fast.wallMs, "fast" satisfies Mode)
        fastPart = { fast: totalsOf(fastRecord) }
        fastMismatches = mismatchesOf("fast", baseRecord, fastRecord)
        flaky += flakyOf([fastRecord])
        allRows.push(...rows)
        selected.set(commit, choice.selected)
      }
      replayed.push({
        commit,
        changedFiles: changed.length,
        baseline: totalsOf(baseRecord),
        normal: totalsOf(normalRecord),
        mismatches: [...mismatchesOf("normal", baseRecord, normalRecord), ...fastMismatches],
        ...fastPart
      })
    }
    // One commit where nothing passes is a failed commit. When nothing passes at any, the build does not run here.
    const nothing = nothingPassed(baselines)
    if (nothing !== undefined) throw failure("unsupported", nothing)
    const report = reportOf(inventory, replayed, {
      selection: fastCopy === undefined ? undefined : selectionOf(allRows, selected),
      left: chosen.left,
      flaky
    })
    return { ...report, targets: chosen.patterns }
  })

/**
 * The replay part for any repository: one whose `HEAD` holds a workspace file
 * its owner wrote has its own targets replayed, and every other repository
 * goes to `generic`, the replay that generates targets. `request.targets`
 * names patterns of a repository's own workspace, so a repository without
 * one is refused when it is given. A workspace file that is in the working
 * tree and in no commit does not count: a replay runs commits.
 *
 * @category parts
 * @since 0.1.0
 */
export const run = <R>(generic: RunReplay<R>) =>
  (request: ReplayRequest, parts: ReplayParts<R>): ReplayReport!Failure!(R | Host) => effect {
    const file = try committedWorkspace(request.root)
    if (file !== undefined) return try own(request, parts, file)
    if (request.targets !== undefined) throw failure("unsupported", noWorkspace)
    return try generic(request, parts)
  }
