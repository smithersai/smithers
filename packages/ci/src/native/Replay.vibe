/**
 * The replay of a repository that already builds with Smithers build: its
 * own targets, cold against cached, at each past commit.
 *
 * Nothing is generated. The baseline is one `smthrs ci --no-cache` run in a
 * checkout with no cache, normal mode the same run in a checkout that keeps
 * its cache between commits, and both read their verdicts from the run
 * record `smthrs` writes.
 *
 * @since 0.1.0
 */

import { ChildProcessSpawner } from "effect/process/ChildProcessSpawner"
import { applyRefuses } from "../contract/Command.ts"
import { failsHere, needsLeftOut, type NotReplayed, stepTimeoutHours } from "../contract/Inventory.ts"
import type { Failure, ReplayParts, ReplayRequest, RunReplay } from "../contract/Parts.ts"
import type { FirstRun, NotReplayedCommit, ReplayCommit, ReplayReport } from "../contract/ReplayReport.ts"
import { RunRecord, type TargetResult } from "../contract/RunRecord.ts"
import { defaultSettings, type Row } from "../contract/Selection.ts"
import { type Confined, confine, held, reading, type Way } from "../replay/Confine.vibe"
import { addTo, type Count, type CpuBucket, uncounted, usedBy } from "../replay/Cpu.ts"
import { cpuWatch } from "../replay/CpuWatch.vibe"
import { gitConfig, pushesGoNowhere, searchPath, stepEnvironment } from "../replay/Environment.ts"
import { probeWith } from "../replay/Jail.ts"
import {
  failuresOf,
  type LastFailures,
  noJobPassed,
  noProgress,
  nothingPassed,
  printedLimit,
  remember,
  type RerunTally,
  stoppedResults
} from "../replay/Failures.ts"
import {
  cacheDirectory,
  checkoutAt,
  cleanCopy,
  cloneCopy,
  exec,
  git,
  lines,
  orFail,
  originOf,
  type Output,
  outputLimit,
  pastLimit,
  runStep,
  stdoutOf
} from "../replay/Process.vibe"
import { printsNotes, readsListener } from "../replay/Reads.ts"
import { type Execute, Options, Progress, scoresOrReason, settle } from "../replay/Replay.vibe"
import { defaultStall, defaultStallMinutes, type StallLimit, tableFor, watchFor } from "../replay/Stall.vibe"
import {
  choose,
  exitAndError,
  failedAt,
  failedTwice,
  failure,
  fastRunOf,
  finishedReport,
  flakyOf,
  mismatchesOf,
  noCiBefore,
  noCommitBefore,
  planOfPrinted,
  PrintedPlan,
  ranAgainAt,
  recordOf,
  rootsWithout,
  tooFewLeft,
  totalsOf
} from "../replay/Summary.ts"
import {
  commandFailed,
  commandStopped,
  type Installed,
  installDirectories,
  installLabel,
  managerFor,
  noSmthrs,
  smthrsBin
} from "./Install.ts"
import { linesOf, noRecord, noRecordLabel, ranAgain, ranAgainLines, withReasons } from "./Results.ts"
import { chosenFor } from "./Targets.ts"
import { isGenerated } from "./Workspace.ts"

/** Why `--targets` cannot be honoured on a repository that has no targets of its own. */
const noWorkspace =
  "--targets names Smithers build patterns, and this repository has no Smithers workspace of its own (.smithers/WORKSPACE.ts or WORKSPACE.ts)"

/**
 * The host services this replay uses.
 *
 * @category models
 * @since 0.1.0
 */
export type Host = ChildProcessSpawner | FileSystem.FileSystem | Path.Path

/**
 * The workspace file the repository at `root` holds at `commit` and its owner
 * wrote, or `undefined`: there is none, `smithers-ci` generated it, or `root`
 * is not a repository.
 *
 * @category accessors
 * @since 0.1.0
 */
export effect function committedWorkspace(root: string, commit = "HEAD") {
  for (const file of applyRefuses) {
    const shown = exec("git", ["show", `${commit}:${file}`], root, {}, Number.POSITIVE_INFINITY, stdoutOf)
      catch (): Output => ({ exitCode: 1, text: "" })
    if (shown.exitCode === 0 && !isGenerated(shown.text)) return file
  }
  return undefined
}

/**
 * Installs a checkout's dependencies with the package manager each lockfile
 * names, in the workspace file's directory and at the root, and finds the
 * `smthrs` they bring. It never fails: a checkout that cannot be installed is
 * a failed commit, not a failed replay. An install runs the scripts of the
 * commit's dependencies, so it runs as a step does: in `place`, and stopped
 * at a step's time limit. `count` is told each install's process.
 *
 * @category internals
 * @since 0.1.0
 */
export effect function install(
  checkout: string,
  workspaceFile: string,
  place: Confined,
  limit: Duration.Input = Duration.hours(stepTimeoutHours),
  stall: StallLimit = defaultStall(),
  count: Count = uncounted
): Installed!!Host {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directories = installDirectories(workspaceFile)
  for (const directory of directories) {
    const names = fs.readDirectory(path.join(checkout, directory)) catch (): ReadonlyArray<string> => []
    const manager = names.includes("package.json") ? managerFor(names) : undefined
    if (manager === undefined) continue
    const [command, ...args] = held(place, [checkout], manager.command)
    const environment = stepEnvironment(place.daemon, place)
    const ran = runStep(command, args, path.join(checkout, directory), environment, limit, stall, count)
      catch () => ({ timedOut: false, stalled: false, exitCode: 127 })
    if (ran.stalled) return { ok: false, reason: commandStopped(manager.command, directory, noProgress(stall.minutes)) }
    if (ran.timedOut) return { ok: false, reason: commandStopped(manager.command, directory, pastLimit(limit)) }
    if (ran.exitCode !== 0) return { ok: false, reason: commandFailed(manager.command, directory, ran.exitCode) }
  }
  for (const directory of directories) {
    const smthrs = path.join(checkout, directory, smthrsBin)
    const present = fs.exists(smthrs) catch () => false
    if (present) return { ok: true, smthrs }
  }
  return { ok: false, reason: noSmthrs(directories) }
}

/** The one result of a commit whose install failed. */
const notInstalled = (reason: string): TargetResult => ({
  label: installLabel,
  status: "failed",
  key: "",
  durationMs: 0,
  error: reason
})

interface Measured {
  readonly results: ReadonlyArray<TargetResult>
  readonly wallMs: number
  readonly state: Installed
  /** The CPU time the install and the first pass used, when their processes could be read. */
  readonly cpuMs: number | undefined
}

/** What one commit's own CI and tree give its run: the patterns to replay and the workspace file to install for. */
interface CommitCi {
  readonly patterns: ReadonlyArray<string>
  readonly workspaceFile: string
}

/**
 * Replays the last `request.commits` commits of a repository whose own
 * workspace file is `workspaceFile`.
 *
 * Each commit runs its own CI: the patterns are those its own CI names, and it
 * is installed for the workspace file it holds, or for `workspaceFile` when it
 * holds none. `request.targets` names the patterns of every commit instead. An
 * older commit whose CI cannot be read is left out of the times and listed.
 *
 * Commits run oldest first in three copies: the baseline's has no untracked
 * file when a commit starts, and the normal and fast ones only their cache.
 * Each is then installed, and its own `smthrs` runs the patterns. Wall time
 * covers the checkout, the install and the first pass, the same in every
 * mode; the reruns that label flaky targets, and the cleaning of a copy after
 * its run, are not counted. The CPU time of what is timed is in the report
 * beside it (`RunTotals.cpuMs`), read from the processes while they run. A
 * failed target runs again `request.reruns` times,
 * or as often as the host sets, and not at all when it failed the same way in
 * the same way's run of the commit before, or in the first run.
 *
 * The copy's install and its `smthrs` get what a target gets of the
 * environment and no credential, so no run reads or writes a shared cache
 * the workspace declares. Both get a home and a temporary directory the
 * replay made and a `git` that refuses to push, and, where the machine can
 * hold one, a file-system jail: they can write the copy, that home and that
 * directory, and cannot read the person's credentials. The baseline, normal
 * mode and fast mode each have a home and a temporary directory of their own,
 * empty at the start and kept until the replay ends, so each fills the caches
 * its tools keep for their user itself. `request.cache` names one for normal
 * and fast mode. The baseline's first pass reads no cache at all.
 *
 * A commit that cannot be installed, or that `smthrs ci` cannot plan, is one
 * failed result in every mode. When no target passes in the baseline of any
 * commit, the replay fails `unsupported` with the newest commit's first
 * failure: the build does not run on this machine.
 *
 * When the model fast mode needs stops answering, the baseline and normal mode
 * still run for every commit, fast mode runs for no further commit, and the
 * report holds no fast-mode number and says why (`fastNotMeasured`).
 *
 * With `request.warm`, every way first runs once at the parent of the oldest
 * commit, in its own copy and home, and fills what it keeps from one commit
 * to the next: the caches its tools keep in its home, and for a mode its
 * cache. That run is in no time but `ReplayReport.firstRun`. When the oldest
 * commit has no commit before it, or the CI of that commit cannot be read,
 * the first counted commit starts with an empty cache and the report says
 * why (`ReplayReport.cold`).
 *
 * With `request.trial` the baseline's first run finds the targets that cannot
 * pass on this machine: the warm run at the parent, or, when there is none, a
 * run at the oldest commit in a copy and a home of its own. A target that
 * fails it runs once more, at the newest commit. One that fails again, and
 * every target that waits on it, is left out at every commit and listed with
 * its exit code and the first line of its error. When none passes, or half or
 * more of the targets are left out, the replay fails `unsupported`. A first run at a commit that
 * cannot be installed or planned says nothing of the targets, so they run
 * once at the newest commit instead.
 *
 * @category parts
 * @since 0.1.0
 */
export const own = <R>(
  request: ReplayRequest,
  parts: ReplayParts<R>,
  workspaceFile: string
): ReplayReport!Failure!(R | Host) =>
  scoped(effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const options = try Options
    const progress = try Progress
    const stepLimit = options.stepTimeout ?? Duration.hours(stepTimeoutHours)
    const stall: StallLimit = {
      minutes: request.stallMinutes ?? defaultStallMinutes,
      table: options.processes ?? tableFor()
    }
    // The CPU time of an install or a run is read from its processes while it runs: none of it reaches this program.
    const cpu = try cpuWatch(stall.table, options.cpuTick)
    // The run whose processes are counted now: a way's install and first pass of a commit, or none.
    let counted: CpuBucket | undefined = undefined
    const count: Count = (pid) => {
      const bucket = counted
      if (bucket === undefined) return uncounted(pid)
      const ended = cpu.track(pid)
      return () => addTo(bucket, ended())
    }
    const work = try orFail(fs.makeTempDirectoryScoped({ prefix: "smithers-ci-own-" }), "could not make a directory")
    const source = path.join(work, "source")
    const root = path.resolve(request.root)
    // Each mode has a home of its own: none finds a cache another mode filled. The files this program runs from
    // stay in sight where the person's home is hidden.
    const places = try orFail(
      confine(
        work,
        options.confine ?? probeWith,
        progress.say,
        [...options.smthrs, ...searchPath()],
        request.allowDocker === true,
        options.environment,
        root
      ),
      "could not make the homes of the runs"
    )
    // A target of the repository's own gets its way's home and none of the variables that refuse a push.
    for (const place of Object.values(places)) {
      try orFail(
        fs.writeFileString(path.join(place.home, ".gitconfig"), gitConfig + pushesGoNowhere),
        "could not make the homes of the runs"
      )
    }
    // Where `smthrs` writes its run records: the one place it can write that an install cannot.
    const records = path.join(work, "records")
    try orFail(fs.makeDirectory(records), "could not make a directory")
    try git(work, ["clone", "--quiet", "--no-checkout", root, source])
    const origin = try originOf(root)
    const history = lines(try git(source, ["rev-list", "--first-parent", `--max-count=${request.commits}`, "HEAD"]))
    const commits = [...history].reverse()

    /**
     * A copy of the repository for one mode. It is named as the repository is and fetches from its remote, so what
     * reads the copy names the repository, not the copy. It can push nowhere.
     */
    effect function copyOf(way: Way) {
      const copy = path.join(work, way, path.basename(root))
      try cloneCopy(work, source, copy, origin)
      // Every copy starts with a whole tree, so the first timed checkout is the same work in each mode.
      try git(copy, ["checkout", "--quiet", "--force", "--detach", "HEAD"], places[way])
      return copy
    }

    /** Puts `copy` at `commit` with nothing untracked but what `kept` names, and installs it for `file`. */
    effect function ready(
      copy: string,
      commit: string,
      kept: ReadonlyArray<string>,
      place: Confined,
      file: string
    ) {
      try checkoutAt(copy, commit, place, kept)
      return try install(copy, file, place, stepLimit, stall, count)
    }

    const normalCopy = try copyOf("normal")
    const spawner = try ChildProcessSpawner
    /**
     * Runs a part on the normal copy, which installs and targets write: every `git` the part starts there runs as
     * they do, in the jail, so a command one of them left in the copy's `.git/config` never runs outside it.
     */
    effect function onNormalCopy<A, E, S>(part: A!E!S) {
      provide ChildProcessSpawner = reading(spawner, places.normal, normalCopy) {
        return try part
      }
    }
    const inventory = try onNormalCopy(parts.read(normalCopy))
    const chosen = chosenFor(inventory, request.targets)
    try progress.say(`replaying the repository's own targets (${workspaceFile}): ${chosen.patterns.join(" ")}`)
    const baselineCopy = try copyOf("baseline")
    const fastCopy = request.modes.includes("fast") ? try copyOf("fast") : undefined

    /**
     * What an older commit's own CI and tree give its run. A commit whose CI cannot be read is not a failed replay:
     * the reason is kept and the commit is listed. Patterns the request names need no CI.
     */
    effect function ciAt(commit: string) {
      const file = (try committedWorkspace(source, commit)) ?? workspaceFile
      if (chosen.from === "request") return { patterns: chosen.patterns, workspaceFile: file } satisfies CommitCi
      try checkoutAt(normalCopy, commit, places.normal)
      const read = onNormalCopy(parts.read(normalCopy)) catch effect (cause) => {
        if (cause.code !== "unsupported" && cause.code !== "invalid-document") throw cause
        return { reason: cause.message }
      }
      if ("reason" in read) return read
      return { patterns: chosenFor(read).patterns, workspaceFile: file } satisfies CommitCi
    }

    const reads = readsListener()
    /** Says once in a replay that this machine cannot record what a step reads, when `smthrs` reports that. */
    const heard = effect (chunk: string) => {
      const sentence = reads(chunk)
      if (sentence !== undefined) try progress.say(sentence)
    }

    let runs = 0
    const jobs = request.jobs === undefined ? [] : ["--jobs", String(request.jobs)]

    /**
     * Where the shared cache `--cache` names is, for normal and fast mode. No run gets a credential: the copy's
     * `smthrs` is given what a target gets of the environment, so a shared cache the workspace declares is off in
     * every mode, and the baseline neither reads one nor stores into one.
     */
    const cacheEnv = request.cache === undefined ? {} : { SMITHERS_CACHE_URL: request.cache }

    /**
     * Runs the copy's own `smthrs` on targets, or on the patterns, and reads the run record it writes. Only the
     * baseline's first pass, the one that is timed, reads no cache: its reruns reuse what that pass built, as the
     * reruns of the other modes do.
     */
    const smthrs = (
      copy: string,
      cached: boolean,
      state: Installed,
      place: Confined,
      patterns: ReadonlyArray<string>
    ): Execute<Host> => (targets) => effect {
      if (!state.ok) return [notInstalled(state.reason)]
      const selected = (targets ?? patterns).filter((label) => label !== installLabel && label !== noRecordLabel)
      if (selected.length === 0) return []
      runs += 1
      const file = path.join(records, `run-${runs}.json`)
      const [command, ...args] = held(place, [copy, records], [
        state.smthrs,
        "ci",
        ...selected,
        "--workspace",
        copy,
        "--cache-dir",
        cacheDirectory,
        ...(cached || targets !== undefined ? [] : ["--no-cache"]),
        "--results-file",
        file,
        "--ui",
        "plain",
        ...jobs
      ])
      // The cache's address is the one thing the copy's own `smthrs` gets beyond what a target gets.
      const environment = { ...stepEnvironment(place.daemon, place), ...printsNotes, ...(cached ? cacheEnv : {}) }
      const watch = try watchFor(stall.minutes, stall.table)
      const output = try exec(command, args, copy, environment, printedLimit, undefined, true, heard, watch, undefined, count)
      const record = effect {
        const text = try fs.readFileString(file)
        return try Schema.decodeUnknownEffect(Schema.fromJsonString(RunRecord))(text)
      } catch () => undefined
      const recorded = record === undefined ? undefined : withReasons(record.results, output.text)
      if (try Ref.get(watch.stalled)) {
        return stoppedResults(recorded, selected, watch.limitMs, noProgress(stall.minutes))
      }
      // A run with no record is a commit `smthrs` could not plan: a failed commit, not a failed replay.
      return recorded ?? [noRecord(output.text)]
    }

    /** The plan of the patterns in a copy; fast mode's rows are measured against the normal copy's. */
    effect function planOf(
      smthrs: string,
      patterns: ReadonlyArray<string>,
      copy: string = normalCopy,
      place: Confined = places.normal
    ) {
      const plan = ["ci", ...patterns, "--plan", "--format", "json", "--workspace", copy]
      const [command, ...args] = held(place, [copy], [smthrs, ...plan])
      const environment = { ...stepEnvironment(place.daemon, place), ...cacheEnv }
      const planned = try exec(command, args, copy, environment, Number.POSITIVE_INFINITY, stdoutOf, true)
      const printed = Schema.decodeUnknownEffect(Schema.fromJsonString(PrintedPlan))(planned.text) catch effect () => {
        throw failure("command-failed", `smthrs ci --plan printed no plan: ${planned.text.slice(-outputLimit)}`)
      }
      return planOfPrinted(printed)
    }

    // What the first run left out: it failed there and again at the newest commit, or waits on what did.
    const leftHere = new Set<string>()
    const left: Array<NotReplayed> = [...chosen.left]
    let covered: { readonly replayed: number; readonly total: number } | undefined = undefined
    const head = commits.at(-1) as string
    const oldest = commits[0] as string
    const newestCi = { patterns: chosen.patterns, workspaceFile } satisfies CommitCi
    // How often a failed target runs again: what the person asked for, else what the host sets.
    const reruns = request.reruns ?? options.reruns
    // How often a target that fails the first run runs again before it is left out.
    const again = Math.min(1, reruns)
    const tally: RerunTally = { count: 0, ms: 0 }
    // What each way's targets failed with in its run before: the same failure again is not run again.
    const last: Record<"baseline" | "normal" | "fast", LastFailures> = {
      baseline: new Map(),
      normal: new Map(),
      fast: new Map()
    }

    // The copy of the run that only judges, made when it is first needed, and what it is installed for.
    let judging: { readonly copy: string; readonly at: string; readonly state: Installed } | undefined = undefined
    /** That copy at `commit`, installed for `ci`: a home and a copy no counted run reads. */
    effect function judgingAt(commit: string, ci: CommitCi) {
      if (judging?.at === commit) return judging
      const copy = judging?.copy ?? try copyOf("trial")
      const made = { copy, at: commit, state: try ready(copy, commit, [], places.trial, ci.workspaceFile) }
      judging = made
      return made
    }

    /** Runs targets, or the newest commit's patterns, at the newest commit in the copy that only judges. */
    const atNewest: Execute<Host> = (targets) => effect {
      const { copy, state } = try judgingAt(head, newestCi)
      return try smthrs(copy, false, state, places.trial, newestCi.patterns)(targets)
    }

    /**
     * Leaves out what cannot pass on this machine, from the first run's results at `at`. A target that failed runs
     * once more, at the newest commit: a commit that was broken and fixed since so leaves nothing out, and neither
     * does one flaky failure. One that fails again is left out at every commit, with every target that waits on it.
     */
    effect function judge(at: string, ran: ReadonlyArray<TargetResult>) {
      // A commit that could not be installed or planned has no target results to judge.
      const unplanned = at !== head && ran.some((result) => result.label === installLabel || result.label === noRecordLabel)
      const first = unplanned ? try atNewest(undefined) : ran
      const judged = unplanned ? head : at
      // A target that fails this way again at the first counted commit is broken, not flaky.
      remember(last.baseline, first)
      const results = try settle(atNewest, first, again, first.length, new Map(), tally)
      const failures = failuresOf(results)
      const passed = results.filter((result) => result.status === "ran" || result.status === "hit")
      if (passed.length === 0 && failures[0] !== undefined) {
        throw failure("unsupported", noJobPassed(judged, failures[0], ranAgainAt(again, judged, head)))
      }
      const twice = failedTwice(results)
      const taken: Array<NotReplayed> = []
      for (const failed of failures) {
        const where = twice.has(failed.step) ? [judged, head] : [judged]
        // The target is the step: its reason is its exit code and the first line of its error.
        const { reason } = failedAt({ job: failed.step, reason: exitAndError(failed) }, where)
        try progress.say(`fails here: ${failed.step}: ${reason}`)
        leftHere.add(failed.step)
        taken.push({ job: failed.step, reasons: [{ feature: failsHere, detail: reason }] })
      }
      for (const result of results.filter((entry) => entry.status === "skipped")) {
        leftHere.add(result.label)
        taken.push({
          job: result.label,
          reasons: [{ feature: needsLeftOut, detail: `${result.label} needs a target that fails here, which is not replayed` }]
        })
      }
      // A speedup over less than half of the targets is not this build's: the replay says what it left out, and stops.
      const few = tooFewLeft(results.length, taken, "target")
      if (few !== undefined) throw failure("unsupported", few)
      left.push(...taken)
      covered = { replayed: passed.length, total: results.length }
    }

    /**
     * What the first pass runs in a copy when the first run left targets out: the commit's patterns'
     * targets without those and what waits on them. A commit that cannot be planned runs its patterns and fails as
     * it would.
     */
    effect function firstPass(copy: string, state: Installed, place: Confined, patterns: ReadonlyArray<string>) {
      if (leftHere.size === 0 || !state.ok) return patterns
      const plan = planOf(state.smthrs, patterns, copy, place) catch () => undefined
      return plan === undefined ? patterns : rootsWithout(plan, leftHere)
    }

    /**
     * One way of one commit: the checkout, the install and the first pass are timed, the reruns are not. A target
     * that fails as it did in the way's run before is not run again.
     */
    effect function measure(
      at: string,
      copy: string,
      commit: string,
      cached: boolean,
      targets: ReadonlyArray<string> | undefined,
      way: "baseline" | "normal" | "fast",
      ci: CommitCi,
      times: number = reruns
    ) {
      const place = places[way]
      try progress.say(at)
      // What is timed is also what is counted: the install and the first pass.
      const used: CpuBucket = { ms: 0, seen: false }
      counted = used
      const timed = effect {
        const start = try Clock.currentTimeMillis
        const state = try ready(copy, commit, cached ? [cacheDirectory] : [], place, ci.workspaceFile)
        // Finding what to leave out is the replay's own work, so it is not timed.
        const planning = try Clock.currentTimeMillis
        const patterns = targets === undefined ? try firstPass(copy, state, place, ci.patterns) : ci.patterns
        const planned = (try Clock.currentTimeMillis) - planning
        const execute = smthrs(copy, cached, state, place, patterns)
        const first = try execute(targets)
        return { state, execute, first, wallMs: (try Clock.currentTimeMillis) - start - planned }
      }
      const { state, execute, first, wallMs } = try ensuring(timed, sync(() => {
        counted = undefined
      }))
      const results = try settle(execute, first, times, first.length, last[way], tally)
      remember(last[way], results)
      for (const line of linesOf(at, results, wallMs)) try progress.say(line)
      return { results, wallMs, state, cpuMs: usedBy(used) } satisfies Measured
    }

    /**
     * The run of every way at `at`, the commit before the oldest replayed one, which fills what each keeps from one
     * commit to the next. With `request.trial` the baseline's is also the run that finds what passes here, and the
     * modes run what it left. A failure in it is not the replay's: the cache holds what passed.
     */
    effect function warmed(at: string, ci: CommitCi) {
      const named = `first run ${at.slice(0, 7)}`
      const base = try measure(`${named} baseline`, baselineCopy, at, false, undefined, "baseline", ci, 0)
      try cleanCopy(baselineCopy, [], places.baseline)
      if (request.trial === true) try judge(at, base.results)
      const normal = try measure(`${named} normal`, normalCopy, at, true, undefined, "normal", ci, 0)
      try cleanCopy(normalCopy, [cacheDirectory], places.normal)
      if (fastCopy === undefined) return { commit: at, baselineMs: base.wallMs, normalMs: normal.wallMs } satisfies FirstRun
      const fast = try measure(`${named} fast`, fastCopy, at, true, undefined, "fast", ci, 0)
      try cleanCopy(fastCopy, [cacheDirectory], places.fast)
      return { commit: at, baselineMs: base.wallMs, normalMs: normal.wallMs, fastMs: fast.wallMs } satisfies FirstRun
    }

    /**
     * Finds what passes here when no way runs before the first counted commit: the patterns run once at the oldest
     * commit whose CI can be read, in a copy and a home of their own. Gives the time it took.
     */
    effect function trial() {
      const start = try Clock.currentTimeMillis
      let at = head
      let ci: CommitCi = newestCi
      for (const commit of commits.slice(0, -1)) {
        const found = try ciAt(commit)
        if ("reason" in found) continue
        at = commit
        ci = found
        break
      }
      try progress.say(`checking which targets pass on this machine at ${at.slice(0, 7)}`)
      const { copy, state } = try judgingAt(at, ci)
      try judge(at, try smthrs(copy, false, state, places.trial, ci.patterns)(undefined))
      return (try Clock.currentTimeMillis) - start
    }

    /** The first run of every way, or why there is none though one was asked for. */
    effect function start() {
      if (request.warm !== true) return {}
      const parent = try exec("git", ["rev-parse", "--verify", "--quiet", `${oldest}^`], source, {}, outputLimit, stdoutOf)
      if (parent.exitCode !== 0) return { cold: noCommitBefore(oldest) }
      const before = parent.text.trim()
      const ci = try ciAt(before)
      if ("reason" in ci) return { cold: noCiBefore(oldest) }
      return { firstRun: try warmed(before, ci) }
    }

    const started: { readonly firstRun?: FirstRun; readonly cold?: string } = try start()
    const trialMs = started.firstRun === undefined && request.trial === true ? try trial() : undefined

    const replayed: Array<ReplayCommit> = []
    const commitsLeft: Array<NotReplayedCommit> = []
    const baselines: Array<RunRecord> = []
    /** The key each target last passed with in normal mode, by label. */
    const passedWith = new Map<string, string>()
    const allRows: Array<Row> = []
    const selected = new Map<string, ReadonlyArray<string>>()
    let flaky = 0
    let fastFlaky = 0
    let fastNotMeasured: string | undefined = undefined

    for (const [index, commit] of commits.entries()) {
      const at = `${index + 1}/${commits.length} ${commit.slice(0, 7)}`
      const ci = index === commits.length - 1 ? newestCi : try ciAt(commit)
      if ("reason" in ci) {
        try progress.say(`${at} not replayed`)
        commitsLeft.push({ commit, reason: ci.reason })
        continue
      }
      const changed = lines(try git(source, ["show", "--format=", "--name-only", "--diff-merges=first-parent", commit]))
      const base = try measure(`${at} baseline`, baselineCopy, commit, false, undefined, "baseline", ci)
      // Each copy is cleaned after its run, untimed, so the next commit's timed setup starts from the same clean
      // tree in every mode.
      try cleanCopy(baselineCopy, [], places.baseline)
      const baseRecord = recordOf(base.results, commit, base.wallMs)
      baselines.push(baseRecord)
      const normal = try measure(`${at} normal`, normalCopy, commit, true, undefined, "normal", ci)
      for (const line of ranAgainLines(`${at} normal`, ranAgain(passedWith, normal.results))) try progress.say(line)
      for (const result of normal.results) {
        if (result.status === "ran" || result.status === "hit") passedWith.set(result.label, result.key)
        else passedWith.delete(result.label)
      }
      const normalRecord = recordOf(normal.results, commit, normal.wallMs, "normal")
      let fastPart: Pick<ReplayCommit, "fast"> = {}
      let fastMismatches: ReturnType<typeof mismatchesOf> = []
      flaky += flakyOf([baseRecord, normalRecord])
      if (fastCopy === undefined || fastNotMeasured !== undefined) {
        try cleanCopy(normalCopy, [cacheDirectory], places.normal)
      } else {
        // A commit with no install or no plan has nothing to predict: fast mode reports the same failure.
        const planner = normal.state.ok && !normal.results.some((result) => result.label === noRecordLabel)
          ? normal.state.smthrs
          : undefined
        const plan = planner === undefined ? undefined : try planOf(planner, ci.patterns)
        const rows = plan === undefined ? [] : try onNormalCopy(parts.rows(normalCopy, normalRecord, plan))
        try cleanCopy(normalCopy, [cacheDirectory], places.normal)
        const scores = plan === undefined ? [] : try scoresOrReason(parts.score, rows)
        if (typeof scores === "string") {
          fastNotMeasured = scores
          try progress.say(`${at} fast not measured`)
        } else {
          const choice = choose(scores, request.settings ?? defaultSettings)
          // Only a target the patterns select can be named to `smthrs ci`; what it depends on runs with it.
          const named = plan === undefined ? undefined : new Set(plan.roots)
          const labels = named === undefined
            ? undefined
            : normal.results.map((result) => result.label).filter((label) =>
              named.has(label) && !choice.skipped.has(label)
            )
          const fast = try measure(`${at} fast`, fastCopy, commit, true, labels, "fast", ci)
          try cleanCopy(fastCopy, [cacheDirectory], places.fast)
          const run = fastRunOf(
            normal.results,
            fast.results,
            commit,
            fast.wallMs,
            baseRecord,
            undefined,
            undefined,
            undefined,
            fast.cpuMs
          )
          fastPart = run.part
          fastMismatches = run.mismatches
          fastFlaky += run.flaky
          allRows.push(...rows)
          selected.set(commit, choice.selected)
        }
      }
      replayed.push({
        commit,
        changedFiles: changed.length,
        baseline: totalsOf(baseRecord, undefined, base.cpuMs),
        normal: totalsOf(normalRecord, undefined, normal.cpuMs),
        mismatches: [...mismatchesOf("normal", baseRecord, normalRecord), ...fastMismatches],
        ...fastPart
      })
    }
    // One commit where nothing passes is a failed commit. When nothing passes at any, the build does not run here.
    const nothing = nothingPassed(baselines)
    if (nothing !== undefined) throw failure("unsupported", nothing)
    const report = finishedReport(inventory, replayed, {
      fastAsked: fastCopy !== undefined,
      rows: allRows,
      selected,
      left,
      flaky,
      fastFlaky,
      commitsLeft,
      fastNotMeasured,
      jobs: covered,
      trialMs,
      reruns: tally,
      firstRun: started.firstRun,
      cold: started.cold
    })
    return { ...report, targets: chosen.patterns }
  })

/**
 * The replay part for any repository: one whose `HEAD` holds a workspace file
 * its owner wrote has its own targets replayed, and every other repository
 * goes to `generic`, the replay that generates targets. `request.targets`
 * names patterns of a repository's own workspace, so a repository without
 * one is refused when it is given. A workspace file that is in the working
 * tree and in no commit does not count: a replay runs commits.
 *
 * @category parts
 * @since 0.1.0
 */
export const run = <R>(generic: RunReplay<R>) =>
  (request: ReplayRequest, parts: ReplayParts<R>): ReplayReport!Failure!(R | Host) => effect {
    const file = try committedWorkspace(request.root)
    if (file !== undefined) return try own(request, parts, file)
    if (request.targets !== undefined) throw failure("unsupported", noWorkspace)
    return try generic(request, parts)
  }
