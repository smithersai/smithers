/**
 * The replay report as `smithers-ci` prints it: numbers and a bar chart, no
 * sentences. A mismatch is the first line whenever there is one, and every
 * mismatch is listed; nothing about a wrong verdict is summarised away. A
 * report where normal mode's result differs from the CI's has no speedup,
 * and a line says so and what to do. Each
 * commit has a line that says whether the CI passed or failed there, in the
 * baseline and in each mode; a commit whose own CI could not be replayed is
 * listed with the reason. A CI
 * job that was not replayed is counted beside the commits and listed with its
 * reasons, and so is what the inventory could not read, so the speedup is
 * never read as covering them. A tool this machine has at another version
 * than a job asks for is listed with both versions. Flaky verdicts are
 * counted beside the mismatches. A line names what recorded the files the
 * steps read, and why when it is not smthrs-observe on a machine it is built
 * for. On a repository that
 * already builds with Smithers build, the patterns replayed stand above the
 * speedup. When fast mode was asked for and could not be measured, a line says
 * so and why. The speedup covers the commits whose baseline passed and says so
 * when that is not all of them, and every step that failed is listed with its
 * exit code and the first line of its error output. The run of each way
 * before the first counted commit has one line with its times, or a line
 * that says why that commit started with an empty cache. When normal mode
 * took longer than the CI and starting Smithers CI is more than a twentieth
 * of the CI's time for a commit, a line gives both times and says only reuse
 * is faster there, or, when no commit was, that there is nothing to gain. When failed steps
 * ran again, a line says how many and how long that took. Every step
 * normal mode ran and did not reuse is listed with the build's reason and
 * the number of commits it ran at: a file it read that changed, or what keeps its result
 * from ever being used again. A line gives the
 * CPU time each way's steps used, when this machine's processes could be read.
 * When fast mode was measured, its test recall, change recall and selection
 * rate each have a line with the count behind it, a line says how many
 * questions the model answered and how long that took, and every target it
 * skipped is listed with its commit and why it was safe to skip, where the features say.
 *
 * Labels, reasons and commit ids come from the repository being replayed, so control
 * characters in them are replaced before they reach a terminal.
 *
 * @since 0.1.0
 */

import type { RenderReport } from "../contract/Parts.vibe"
import type { ReplayCommit, RunTotals } from "../contract/ReplayReport.vibe"
import {
  appliedTime,
  askedFor,
  bar,
  coldStart,
  commitsLeftOut,
  count,
  coverage,
  cpuTime,
  diskHeld,
  duration,
  failedSteps,
  failureText,
  fastNotMeasured,
  firstLine,
  firstRunTime,
  flaky,
  jobsCount,
  jobsLeftOut,
  leftEmpty,
  leftOut,
  mismatches,
  modelCost,
  modelTime,
  normalDiffers,
  noSpeedup,
  noSpeedupMismatch,
  notReused,
  notReusedText,
  ownTargets,
  ratio,
  reasons,
  recordedBy,
  rerunTime,
  selectionRows,
  shortCommit,
  skipGroups,
  skippedHeading,
  skippedLabels,
  speedup,
  speedupCommits,
  startCost,
  stoppedEarly,
  times,
  toolVersion,
  trialTime,
  unread,
  unreadText,
  verdict
} from "./Format.vibe"

const width = 24

const paragraph = (lines: ReadonlyArray<string>): string => lines.join("\n")

const clean = (value: string): string => value.replace(/\p{Cc}/gu, "\uFFFD")

const way = (totals: RunTotals | undefined): string =>
  totals === undefined ? "" : `${verdict(totals.ok)} ${duration(totals.wallMs)}`

/** One line for each commit under a heading line: its changed files, and whether each way passed, with its time. */
const commitLines = (commits: ReadonlyArray<ReplayCommit>): ReadonlyArray<string> => {
  const withFast = commits.some((commit) => commit.fast !== undefined)
  const rows = [
    ["commit", "files", "baseline", "normal", ...(withFast ? ["fast"] : [])],
    ...commits.map((commit) => [
      clean(shortCommit(commit.commit)),
      String(commit.changedFiles),
      way(commit.baseline),
      way(commit.normal),
      ...(withFast ? [way(commit.fast)] : [])
    ])
  ]
  const widths = rows[0]!.map((_, column) => Math.max(...rows.map((row) => row[column]!.length)))
  return rows.map((row) =>
    row.map((cell, column) => column === 1 ? cell.padStart(widths[column]!) : cell.padEnd(widths[column]!)).join("  ")
      .trimEnd()
  )
}

/**
 * Renders a replay report for a terminal.
 *
 * @example
 * ```
 * 6.0× faster
 *
 * baseline  ████████████████████████  43m 40s
 * normal    ████                       7m 20s   6.0×
 * fast      █▍                         2m 30s  17.5×
 *
 * 2 commits · 0 mismatches
 *
 * commit   files  baseline      normal       fast
 * 3f2a1c9      3  pass 22m 00s  pass 4m 00s  pass 1m 30s
 * 8d1e0b2      1  fail 21m 40s  fail 3m 20s  fail 1m 00s
 * ```
 *
 * @category renderers
 * @since 0.1.0
 */
export const text: RenderReport = (report) => {
  const listed = report.commits.flatMap((commit) => commit.mismatches.map((mismatch) => ({ ...mismatch, commit })))
  const found = Math.max(report.mismatches, listed.length)
  const sections: Array<Array<string>> = []
  if (found > 0) sections.push([`✗ ${mismatches(found)}`])
  if (report.fastNotMeasured !== undefined) sections.push([clean(fastNotMeasured(report.fastNotMeasured))])
  if (report.stopped !== undefined) sections.push([clean(stoppedEarly(report.stopped))])
  if (report.commits.length === 0) return [...sections, [count(0, "commit")]].map(paragraph).join("\n\n")
  const modes = [
    { name: "baseline", ms: report.baselineWallMs, ratio: undefined },
    { name: "normal", ms: report.normalWallMs, ratio: report.speedup },
    ...(report.fastWallMs === undefined ?
      [] :
      [{ name: "fast", ms: report.fastWallMs, ratio: ratio(report.baselineWallMs, report.fastWallMs) }])
  ]
  const max = Math.max(...modes.map((mode) => mode.ms))
  const timeWidth = Math.max(...modes.map((mode) => duration(mode.ms).length))
  const ratioWidth = Math.max(...modes.map((mode) => (mode.ratio === undefined ? "" : times(mode.ratio)).length))
  if (report.targets !== undefined) sections.push([clean(ownTargets(report.targets))])
  if (speedupCommits(report) === 0) {
    sections.push([normalDiffers(report) ? noSpeedupMismatch : noSpeedup])
  } else {
    sections.push([`${speedup(report.speedup)} ${coverage(report)}`.trimEnd()])
    sections.push(modes.map((mode) =>
      [
        mode.name.padEnd(8),
        bar(mode.ms, max, width).padEnd(width),
        duration(mode.ms).padStart(timeWidth),
        ...(mode.ratio === undefined ? [] : [times(mode.ratio).padStart(ratioWidth)])
      ].join("  ")
    ))
  }
  const left = report.notReplayed ?? []
  const notRead = report.notRead ?? []
  const commitsLeft = report.notReplayedCommits ?? []
  sections.push([
    `${count(report.commits.length, "commit")}${jobsCount(report)} · ${mismatches(found)}${flaky(report.flaky ?? 0)}${
      commitsLeftOut(commitsLeft.length)
    }${leftOut(jobsLeftOut(report))}${unread(notRead.length)}`
  ])
  const asked = askedFor(report)
  if (asked !== undefined) sections.push([clean(asked)])
  if (report.recorder !== undefined) sections.push([clean(recordedBy(report.recorder))])
  const cpu = cpuTime(report)
  if (cpu !== undefined) sections.push([cpu])
  if (report.trialMs !== undefined) sections.push([trialTime(report.trialMs)])
  if (report.appliedMs !== undefined) sections.push([appliedTime(report.appliedMs)])
  if (report.firstRun !== undefined) sections.push([firstRunTime(report.firstRun)])
  if (report.startCost !== undefined) sections.push([startCost(report.startCost, report.commits)])
  if (report.cold !== undefined) sections.push([clean(coldStart(report.cold))])
  if (report.reruns !== undefined) sections.push([rerunTime(report.reruns)])
  if (report.diskHeldBytes !== undefined) sections.push([diskHeld(report.diskHeldBytes)])
  if (report.selection !== undefined) {
    const rows = selectionRows(report.selection)
    const nameWidth = Math.max(...rows.map((row) => row.name.length))
    const shareWidth = Math.max(...rows.map((row) => row.share.length))
    const cost = modelCost(report)
    sections.push([
      "fast mode",
      ...rows.map((row) => `${row.name.padEnd(nameWidth)}  ${row.share.padStart(shareWidth)}  ${row.counts}`),
      ...(report.model === undefined ? [] : [modelTime(report.model)]),
      ...(cost === undefined ? [] : [cost])
    ])
  }
  sections.push([...commitLines(report.commits)])
  const failed = report.commits.flatMap((commit) => failedSteps(commit).map((entry) => ({ ...entry, commit })))
  if (failed.length > 0) {
    sections.push([
      "failed steps",
      ...failed.flatMap(({ commit, failure, ways }) => [
        [clean(shortCommit(commit.commit)), ways.join(", "), clean(failure.step), clean(failureText(failure))].join(
          "  "
        ),
        // What to do about it, on a line of its own under the step.
        ...(failure.fix === undefined ? [] : [`  ${clean(firstLine(failure.fix))}`])
      ])
    ])
  }
  const again = notReused(report)
  if (again.length > 0) {
    sections.push([
      "steps not reused",
      ...again.map((entry) => clean(notReusedText(entry, report.commits.length)))
    ])
  }
  const skips = skipGroups(report.commits)
  if (skips.length > 0) {
    sections.push([
      skippedHeading,
      ...skips.map((group) =>
        [
          clean(shortCommit(group.commit)),
          count(group.labels.length, "step"),
          clean(group.reason),
          clean(skippedLabels(group.labels))
        ].filter((cell) => cell !== "").join("  ")
      )
    ])
  }
  if (commitsLeft.length > 0) {
    sections.push([
      "commits not replayed",
      ...commitsLeft.map((entry) => `${clean(shortCommit(entry.commit))}  ${clean(firstLine(entry.reason))}`.trimEnd())
    ])
  }
  if (listed.length > 0) {
    // A mismatch over a file Smithers CI wrote says so on its own line, under the mismatch.
    sections.push(listed.flatMap((mismatch) => [
      [
        clean(shortCommit(mismatch.commit.commit)),
        mismatch.mode.padEnd(6),
        clean(mismatch.label),
        `${mismatch.baseline} → ${mismatch.got}`
      ].join("  "),
      ...(mismatch.cause === undefined ? [] : [`  ${clean(firstLine(mismatch.cause))}`])
    ]))
  }
  if (left.length > 0) {
    const jobWidth = Math.max(...left.map((entry) => clean(entry.job).length))
    sections.push(left.map((entry) => `${clean(entry.job).padEnd(jobWidth)}  ${clean(reasons(entry))}`.trimEnd()))
  }
  if (notRead.length > 0) {
    sections.push(["not read", ...notRead.map((entry) => clean(unreadText(entry)).trimEnd())])
  }
  const tools = report.toolVersions ?? []
  if (tools.length > 0) {
    const jobWidth = Math.max(...tools.map((entry) => clean(entry.job).length))
    sections.push([
      "tool versions",
      ...tools.map((entry) => `${clean(entry.job).padEnd(jobWidth)}  ${clean(toolVersion(entry))}`)
    ])
  }
  const runner = report.runnerSteps ?? []
  if (runner.length > 0) {
    const jobWidth = Math.max(...runner.map((entry) => clean(entry.job).length))
    sections.push([
      "not run here: your runner runs them, in the workflow apply writes",
      ...runner.map((entry) => `${clean(entry.job).padEnd(jobWidth)}  ${clean(entry.action)}: ${clean(entry.why)}`)
    ])
  }
  const unkept = report.stepsLeftOut ?? []
  if (unkept.length > 0) {
    const jobWidth = Math.max(...unkept.map((entry) => clean(entry.job).length))
    sections.push([
      "left out of the workflow apply writes: its job was replayed without it",
      ...unkept.map((entry) => `${clean(entry.job).padEnd(jobWidth)}  ${clean(entry.action)} ${clean(entry.why)}`)
    ])
  }
  const empty = report.withheld ?? []
  if (empty.length > 0) sections.push([clean(leftEmpty(empty))])
  return sections.map(paragraph).join("\n\n")
}
