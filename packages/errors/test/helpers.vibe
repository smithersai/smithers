import { assert } from "@effect/vitest"

/** The expected failure a program fails with; a success or a defect fails the test. */
export effect function failureOf<E>(program: unknown!E): E!! {
  return match (try exit(program)) {
    when Exit.Failure(let cause): try sync(() => Option.getOrThrow(Cause.findErrorOption(cause)));
    default: try sync(() => assert.fail("expected the program to fail"));
  }
}
