import { describe, expect, it } from "@effect/vitest"
import type { SmithersErrorCode } from "../src/ErrorCode.ts"
import { hasSmithersErrorShape, isSmithersError, SmithersError } from "../src/SmithersError.vibe"
import { failureOf } from "./helpers.vibe"

// An adapter's subclass, tagged with its own name. It is written as
// @smthrs/integrations' IntegrationError is: an error declaration cannot
// extend a class (VIP-13), so the subclass sets its tag and its name itself.
class AdapterError extends SmithersError {
  declare readonly _tag: "AdapterError"

  constructor(code: SmithersErrorCode, summary: string) {
    super(code, summary)
    this._tag = "AdapterError"
  }
}
AdapterError.prototype.name = "AdapterError"

// A subclass with a field and its own constructor, as @smthrs/integrations'
// IntegrationError is.
class IntegrationError extends SmithersError {
  declare readonly _tag: "IntegrationError"
  readonly reason: string

  constructor(reason: string, options?: { readonly cause?: unknown }) {
    super("INTEGRATION_ERROR", "poll failed", { reason }, { cause: options?.cause })
    this._tag = "IntegrationError"
    this.reason = reason
  }
}
IntegrationError.prototype.name = "IntegrationError"

effect function raise<E>(error: E): never!E {
  throw error
}

// Routing by tag is the behavior under test, so these use Effect.catchTag
// rather than a catch that matches by class. A SmithersError may be a
// subclass, so its tag type is string and catching "SmithersError" leaves
// SmithersError in the failure type.
effect function recover(error: SmithersError | AdapterError): string!SmithersError {
  return try (raise(error)
    // @vibelang-diagnostics-next-line EK4835:off — tag routing is the behavior under test.
    |> Effect.catchTag(%, "AdapterError", effect (caught) => `adapter:${caught.summary}`)
    // @vibelang-diagnostics-next-line EK4835:off — tag routing is the behavior under test.
    |> Effect.catchTag(%, "SmithersError", effect (caught) => `base:${caught.code}`))
}

describe("tagged failures", () => {
  it.effect("routes a base instance and a subclass to their own catchTag handler", effect () => {
    expect(try recover(new SmithersError("INVALID_INPUT", "x"))).toBe("base:INVALID_INPUT")
    expect(try recover(new AdapterError("INTEGRATION_ERROR", "adapter failed"))).toBe("adapter:adapter failed")
  })

  it.effect("matches a subclass by class in a catch", effect () => {
    const caught = raise(new AdapterError("INTEGRATION_ERROR", "adapter failed")) catch (error) => match (error) {
      when AdapterError: error.summary;
      // A hand-written class pattern covers no finite case (EK4701).
      default: "unmatched";
    }
    expect(caught).toBe("adapter failed")
  })

  it.effect("fails the surrounding effect with the instance when thrown", effect () => {
    expect(try failureOf(raise(new AdapterError("INTEGRATION_ERROR", "adapter failed")))).toBeInstanceOf(AdapterError)
  })

  it("tags each subclass with its own name, which it reports and its stack starts with", () => {
    const error = new AdapterError("UNSUPPORTED", "x")
    expect(error._tag).toBe("AdapterError")
    expect(error.name).toBe("AdapterError")
    expect(Object.hasOwn(error, "name")).toBe(false)
    expect(error.stack?.startsWith("AdapterError: ")).toBe(true)
  })

  it("keeps the tag enumerable and in JSON, as Data.TaggedError does", () => {
    const error = new AdapterError("UNSUPPORTED", "x")
    expect(Object.keys(error)).toEqual(["code", "summary", "docsUrl", "_tag"])
    expect(JSON.stringify(error)).toBe(JSON.stringify({
      code: "UNSUPPORTED",
      summary: "x",
      docsUrl: error.docsUrl,
      _tag: "AdapterError"
    }))
  })

  it("lets a subclass always spell the optional cause key", () => {
    const withoutCause = new IntegrationError("poll-failed")
    expect(Object.hasOwn(withoutCause, "cause")).toBe(false)

    const cause = new Error("root")
    const withCause = new IntegrationError("poll-failed", { cause })
    expect(Object.hasOwn(withCause, "cause")).toBe(true)
    expect(withCause.cause).toBe(cause)
  })

  it("matches a subclass's own instances only, so a base instance is not a subclass", () => {
    const base = new SmithersError("INTEGRATION_ERROR", "x")
    expect(base is SmithersError).toBe(true)
    expect(base is AdapterError).toBe(false)
    expect(base is IntegrationError).toBe(false)
    expect(new AdapterError("UNSUPPORTED", "x") is IntegrationError).toBe(false)
    const routed = match (base) {
      when AdapterError: "adapter";
      when IntegrationError: "integration";
      default: "base";
    }
    expect(routed).toBe("base")
  })

  it("matches a base instance from another copy of the package by its tag", () => {
    const copy = { _tag: "SmithersError", code: "INTEGRATION_ERROR" }
    expect(copy is SmithersError).toBe(true)
    expect({ _tag: "AdapterError" } is AdapterError).toBe(false)
  })

  it("keeps the subclass prototype, so instanceof, is, and the refinements accept it", () => {
    const error = new IntegrationError("poll-failed")
    expect(error).toBeInstanceOf(IntegrationError)
    expect(error is SmithersError).toBe(true)
    expect(isSmithersError(error)).toBe(true)
    expect(hasSmithersErrorShape(error)).toBe(true)
    expect(error.reason).toBe("poll-failed")
    expect(error.details).toEqual({ reason: "poll-failed" })
    expect(isSmithersError(new Error("plain"))).toBe(false)
  })
})
