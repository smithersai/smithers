/**
 * The error class the integration adapters raise.
 *
 * `SmithersError` carries a machine-readable {@link SmithersErrorCode}, a
 * human summary, caller-supplied `details`, and a documentation URL appended
 * to the message. It stores context verbatim and does not redact it.
 * Integration adapters must remove credentials before constructing it.
 * Adapters subclass it, as `@smthrs/integrations`' `IntegrationError` does, to
 * add their own typed fields and their own Effect tag; callers classify with
 * the tag or the code rather than by matching message text.
 *
 * @since 1.0.0
 */

// The one generated-code helper this source still writes; see the class's
// comment for why and for the VibeLang gap it records.
import { $schemaErrorMatcher } from "vibelang-runtime"

import { ERROR_REFERENCE_URL, type SmithersErrorCode } from "./ErrorCode.ts"

/**
 * Construction options for a {@link SmithersError}.
 *
 * @category models
 * @since 1.0.0
 */
export interface SmithersErrorOptions {
  /**
   * Stored verbatim and not redacted. A cause of `undefined` is treated as no
   * cause, so the instance has no own `cause` property and a log or
   * `util.inspect` output has no `[cause]` line. A subclass may therefore
   * always include the key. Redact provider text such as a bot token in a URL
   * or an API key in a message before attaching it.
   */
  readonly cause?: unknown
  /** Set `false` to leave the documentation URL out of the message. */
  readonly includeDocsUrl?: boolean
}

/**
 * A Smithers integration failure, and an Effect tagged error.
 *
 * A subclass tags itself with its own name: `Effect.catchTag("SmithersError")`
 * catches a base instance, an adapter's `IntegrationError` subclass is caught
 * by `"IntegrationError"`, and `is SmithersError` matches them all. The tag is
 * also the name the error reports. `is SmithersError` also matches an
 * instance from another copy of this package by its `"SmithersError"` tag; a
 * subclass matches its own instances only.
 *
 * It is a class over the prelude's `TaggedError`, not an `error` declaration,
 * because a declaration takes no constructor, no `_tag` field and no subclass
 * (VibeLang VIP-13: EK1301, EK2117).
 *
 * @category errors
 * @since 1.0.0
 */
export class SmithersError extends TaggedError("SmithersError" as string)<{
    /** The Effect tag: `"SmithersError"`, or a subclass's own name. */
    readonly _tag: string;
    /** The summary with the documentation URL appended, unless left out. */
    readonly message: string;
    /** The machine-readable classification. */
    readonly code: SmithersErrorCode;
    /** The message without the appended documentation URL. */
    readonly summary: string;
    /** Where the code is documented. */
    readonly docsUrl: string;
    /**
     * Caller-supplied context. The top-level record is copied and frozen at
     * construction, so adding, removing, or replacing a top-level key on the
     * caller's object afterwards cannot change it. Nested values are shared by
     * reference and are not deep-frozen, so a caller must not mutate an attached
     * nested record. Callers must redact credentials. Absent as an own property
     * when the caller supplies none.
     */
    readonly details?: Readonly<Record<string, unknown>>;
}> {
  // An own matcher keeps `is SmithersError` matching an instance from another
  // copy of this package by its tag, as an `error` declaration's does; pattern
  // dispatch reads no inherited matcher, so the prelude's on `TaggedError`'s
  // class does not reach this one. VibeLang has no source form for that yet,
  // so this calls the generated-code helper (smithersai/smithers#4472).
  static { $schemaErrorMatcher(this, "SmithersError") }

  /**
   * Constructs a tagged integration failure with a frozen shallow context copy.
   *
   * @param code - A code from the closed error catalog.
   * @param summary - Human-readable text; trailing documentation suffixes are removed.
   * @param details - Context already redacted by the caller; nested values remain shared.
   * @param options - The documentation switch and the verbatim cause.
   * @since 1.0.0
   */
  constructor(
    code: SmithersErrorCode,
    summary: string,
    details?: Record<string, unknown>,
    options: SmithersErrorOptions = {}
  ) {
    const docsUrl = ERROR_REFERENCE_URL
    const suffix = ` See ${docsUrl}`
    // Only whitespace after a suffix copy is dropped. Whitespace the summary
    // itself ends with is kept, so rewrapping `message` restores it unchanged.
    let summaryWithoutDocsUrl = summary
    for (;;) {
      const candidate = summaryWithoutDocsUrl.trimEnd()
      if (!candidate.endsWith(suffix)) break
      summaryWithoutDocsUrl = candidate.slice(0, -suffix.length)
    }
    const message = options.includeDocsUrl === false || summaryWithoutDocsUrl.trim() === ""
      ? summaryWithoutDocsUrl
      : `${summaryWithoutDocsUrl}${suffix}`
    // `Data.Error` passes `message` to `Error`, which installs it as a hidden
    // own property, and copies the other fields onto the instance in order.
    // `cause` is installed below instead, because `Data.Error` drops a falsy
    // cause from `ErrorOptions`.
    super({
      message,
      code,
      summary: summaryWithoutDocsUrl,
      docsUrl,
      ...(details !== undefined ? { details: Object.freeze({ ...details }) } : {})
    })
    const cause = options.cause
    if (cause !== undefined) {
      Object.defineProperty(this, "cause", { value: cause, enumerable: false, writable: true, configurable: true })
    }
  }


  /**
   * Returns enumerable own fields without adding the message, stack, or cause.
   * Nested context values remain shared and are not redacted.
   *
   * @returns A new record containing the enumerable own fields.
   * @since 1.0.0
   */
  override toJSON(): Record<string, unknown> {
    return Object.fromEntries(Object.entries(this))
  }
}

// `Data.Error` inspects as its JSON. Removing the hook restores Node's `Error`
// formatting: the stack, the enumerable fields, and a `[cause]` entry.
Object.defineProperty(SmithersError.prototype, Symbol.for("nodejs.util.inspect.custom"), {
  value: undefined,
  enumerable: false,
  writable: true,
  configurable: true
})

/**
 * Whether `value` is a {@link SmithersError}.
 *
 * This refinement uses `instanceof` only. It does not detect an instance
 * produced by a duplicate copy of this package.
 *
 * @param value - Any value to classify using this module's constructor identity.
 * @returns Whether the value is an instance of this class or one of its subclasses.
 * @category refinements
 * @since 1.0.0
 */
export const isSmithersError = (value: unknown): value is SmithersError => value instanceof SmithersError

// The structural refinement catches what a caller's getter throws, which is
// JavaScript's catch, so it lives in a TypeScript module (D282).
export { hasSmithersErrorShape } from "./ErrorShape.ts"
