{
	// ADOPTION BRIDGE, not the deploy configuration. The Worker is deployed
	// with Alchemy (alchemy.run.ts -> src/Worker.ts, props from
	// src/workerIdentity.ts); this file records the Worker exactly as Wrangler
	// last deployed it, and src/workerIdentity.test.ts holds it to
	// WORKER_IDENTITY so scripts/adopt-durable-objects.ts can compare the live
	// script to both. Nothing runs `wrangler deploy` against it any more; keep
	// it in step with src/workerIdentity.ts (the test fails otherwise) and read
	// DEPLOY.md "The adopting deploy" before changing a binding or a class.
	"name": "smithers-mvp-web",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	// Wave 7: this Worker IS the canary. The custom domain was repointed from
	// the POC worker `smithers-ui-canary` (rollback: redeploy that worker from a
	// `smithersai/ui` checkout — `bun x wrangler deploy` — and the domain
	// re-attaches; its last POC version was bd819f28-8c25-4443-b3b2-13d1e18cd09d).
	// The app under the apex (wave "smithers.sh is the product"): this Worker
	// serves the whole smithers.sh Astro build (landing, docs, the prerendered
	// app page, /_astro chunks), so one zone route claims every apex path. A
	// zone route wins over a custom domain on the same hostname, so the old
	// assets-only Worker smithers-site-v1 keeps the apex custom domain as the
	// fallback until it is retired (DEPLOY.md "Cutover log"). Splitting the apex
	// by prefix served page HTML from one build and its /_astro chunks from the
	// other (404). Rollback: restore the three narrow routes (smithers.sh/smithersai/*,
	// /api/*, /assets/*) and deploy; the canary custom domain is untouched either way.
	"routes": [
		{ "pattern": "canary.smithers.sh", "custom_domain": true },
		{ "pattern": "smithers.sh/*", "zone_id": "8ebd98d2f0dc7d8db2e61f31ebc19c14" }
	],
	// The assets are the smithers.sh Astro build in the sibling `apps/site`
	// package: the landing page, the docs, and the product app prerendered at
	// /<owner>/<name>/index.html as a React island. `pnpm run build` there must
	// run before `wrangler dev` or `wrangler deploy` here (scripts/deploy.ts
	// does), because an unbuilt `../site/dist` is an empty site. This directory
	// is the second deliberate identity change on record (DEPLOY.md); the
	// previous value was `../ui/dist` with `single-page-application` handling.
	"assets": {
		"directory": "../site/dist",
		"binding": "ASSETS",
		// The build carries a 404 page, and the app document is the Worker's to
		// serve (src/index.ts), so no path falls back to a SPA shell.
		"not_found_handling": "404-page",
		// `/smithersai/*` runs the Worker first so a catalog repository page serves
		// the app document with its isolation headers and any other path under
		// that owner redirects to the site; `/w/*` so a reload inside the app
		// (/w/<workspace>/b/<branch>/f/<frame>) serves the app document instead of
		// the 404 page (src/index.ts, routedRepoPage and isFramePath).
		// src/workerIdentity.test.ts holds this list to the prefixes the code routes.
		//
		// Every COMING_SOON_REPOS owner runs the Worker first too, in the owner's
		// GitHub case and in lowercase (wrangler matches these patterns
		// case-sensitively: live, /SmithersAI/Smithers is the 404 page while
		// /smithersai/Smithers is the app). With the 2026-08-01 compatibility
		// date a browser navigation to a path the build has no file for is
		// answered by the assets layer's 404 page before the Worker runs, so
		// without these entries /effect-ts/effect and /Effect-TS/Effect are the
		// 404 page and only the canonical /Effect-TS/effect/ is the coming-soon
		// page (src/appDocument.ts, COMING_SOON_WORKER_FIRST).
		"run_worker_first": [
			"/api/*", "/v1/*", "/workflows/*", "/smithersai/*", "/w/*",
			"/Effect-TS/*", "/effect-ts/*",
			"/wevm/*",
			"/bombshell-dev/*",
			"/jj-vcs/*",
			"/modelcontextprotocol/*",
			"/GitoxideLabs/*", "/gitoxidelabs/*",
			"/TanStack/*", "/tanstack/*",
			"/xyflow/*",
			"/blackboardsh/*",
			"/withastro/*"
		]
	},
	// Server-side turn kill (B-3): cancellation state per runId lives in this
	// Durable Object; the cancel route flips it and the streaming turn handler
	// observes it between NDJSON chunks (cross-request AbortController use is
	// forbidden by workerd).
	"durable_objects": {
		"bindings": [
			{ "name": "TURN_CANCELS", "class_name": "TurnCancelRegistry" },
			// Wave 11: per-user gateway session records (relay tokens, server-side only), keyed by login.
			{ "name": "GATEWAY_SESSIONS", "class_name": "GatewaySessionRegistry" },
			// A per-login ceiling on turns: an abuse guard on a seam that is
			// comped by design, so a runaway client or a lifted session cookie
			// cannot spend the alpha budget unobserved (src/turnLimit.ts).
			{ "name": "TURN_LIMITS", "class_name": "TurnRateLimiter" },
			// The bounded client-error log, read back at GET /api/admin/errors.
			// Without it a browser crash lives only in a wrangler tail nobody
			// is watching (src/clientErrorLog.ts).
			{ "name": "CLIENT_ERRORS", "class_name": "ClientErrorLog" },
			// The command recommender's log: one row per recommendation (tail
			// digest, the ordered answer, the command the user ran next), a ring
			// of the newest 5000, read back at GET /api/admin/recommend/log for
			// scoring (src/recommend.ts). Needs the CEREBRAS_API_KEY secret below.
			{ "name": "RECOMMEND_LOG", "class_name": "RecommendLog" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TurnCancelRegistry"] },
		{ "tag": "v2", "new_sqlite_classes": ["GatewaySessionRegistry"] },
		{ "tag": "v3", "new_sqlite_classes": ["TurnRateLimiter", "ClientErrorLog"] },
		{ "tag": "v4", "new_sqlite_classes": ["RecommendLog"] }
	],
	"vars": {
		// Wave 7 canary upstreams. identity lives on workers.dev until will
		// proxies its stale Vercel CNAME; billing is on its public hostname.
		"IDENTITY_UPSTREAM_URL": "https://smithers-cloud-identity.willcory10.workers.dev",
		"BILLING_UPSTREAM_URL": "https://billing.smithers.sh",
		// Wave 11: Smithers Cloud API — the per-user gateway provision route
		// (POST /api/repos/{owner}/{repo}/gateway) lives here; the Cloud token comes
		// from the identity worker's /api/identity/cloud-token door (wave-11b).
		"SMITHERS_CLOUD_API_BASE_URL": "https://api.jjhub.tech",
		// Canary chat (same source as prod chat, own metering queue pair): the
		// metering token pair could not be completed on prod chat without
		// touching its config, which wave 7 is not authorized to do.
		"SMITHERS_CHAT_URL": "https://smithers-cloud-chat-canary.willcory10.workers.dev/chat",
		"SMITHERS_CHAT_ORIGIN": "https://canary.smithers.sh"
		// Optional knobs, both unset on canary (the defaults are the alpha's):
		//   UPSTREAM_TIMEOUT_MS        — how long any one upstream gets to answer, in ms
		//                                (default 20000). Bounds the wait for HEADERS only, so a
		//                                streaming answer is never cut off. Raise it behind a slow
		//                                sibling rather than letting a route hang.
		//   BILLING_CHECKOUT_ENABLED   — "1" opens POST /api/billing/checkout and /portal. Unset is
		//                                the closed-alpha state: every balance is comped, so both
		//                                answer an honest refusal instead of reaching Stripe.
		// Backend seams. The three upstream URLs above are SET on canary; the
		// rest are Cloudflare secrets (`wrangler secret put`), not vars, and an
		// unset one makes its route answer an honest 501:
		//   SMITHERS_CHAT_AUTH_TOKEN — the deployment bearer the chat upstream authenticates turns with
		//                              (workers/chat accepts only authorization: Bearer; unset = the forward
		//                              can only ever come back the upstream's honest 401)
		//   IDENTITY_UPSTREAM_URL    — the identity worker (GitHub OAuth + allowlist); proxies /api/auth/*, /api/identity/*.
		//                              Setting it also ARMS the turn gate: /api/agent/turn and its cancel then
		//                              require a validated, allowlisted session (they spend the model credential
		//                              and meter real dollars, and the same-origin guard does not stop a curl).
		//   IDENTITY_SERVICE_TOKEN   — service token for the product Worker → /api/identity/validate call
		//   BILLING_UPSTREAM_URL     — the billing worker; proxies /api/billing/* with the validated login as context
		//   BILLING_PRODUCT_SERVICE_TOKEN — billing's PRODUCT_SERVICE_TOKEN (the wave-5 bridge key): a validated
		//                              session's billing reads authenticate AS THE USER (x-smithers-service-token +
		//                              x-user-login); the deployment bearer below is only the signed-out/native fallback
		//   BILLING_AUTH_TOKEN       — the Smithers Cloud user bearer billing authenticates the account with
		//                              (billing reads no x-user-* claim; unset = the seam answers 501, never a doomed forward)
		//   CHAT_PRODUCT_SERVICE_TOKEN — the chat worker's PRODUCT_SERVICE_TOKEN: a session-gated turn vouches
		//                              the validated login so the turn's comped charge lands on the user's OWN account
		//   ANONYMOUS_TURN_SALT      (secret) salts the per-address buckets under the anonymous turn ceiling
		//                              (PUBLIC-REPOSITORIES.md "Anonymous turns"); unset = unsalted hashes, still no raw address
		//   CEREBRAS_API_KEY         (secret) the Cerebras key POST /api/recommend spends on command suggestions
		//                              (src/recommend.ts); unset = the route answers an honest 503 and the client
		//                              keeps its rule-based pills. CEREBRAS_MODEL (var, optional) overrides the
		//                              default gpt-oss-120b.
		//   SMITHERS_GITHUB_APP_ID   (secret, SET) the numeric id of the GitHub App smitherspreviewrelease
		//                              (4163546, owned by the smithersai org). With the private key below,
		//                              GET /api/public/repos authenticates its api.github.com stats reads as
		//                              that App's installation (src/githubApp.ts) instead of as a person's
		//                              token: no PAT to mint, rotate, or leak.
		//   SMITHERS_GITHUB_APP_PRIVATE_KEY (secret, SET) the App's PEM private key, stored exactly as GitHub
		//                              issues it (PKCS#1, "BEGIN RSA PRIVATE KEY"); a PKCS#8 key works too.
		//                              The Worker signs a 9-minute RS256 JWT with it, exchanges that for an
		//                              installation token, and caches the token for 55 minutes. Unimportable
		//                              or uninstalled = one warning line and an anonymous read, never a throw.
		//   GITHUB_TOKEN             (secret, optional) a GitHub token GET /api/public/repos sends as a bearer on
		//                              its api.github.com stats reads (src/publicRepos.ts). It OVERRIDES the
		//                              GitHub App above when both are set. Either credential raises GitHub's
		//                              ceiling from 60 to 5000 requests an hour; the token needs no scopes,
		//                              since every catalog repository is public. Neither = unauthenticated reads.
		// The identity and billing workers both gate on the browser Origin, so their
		// ALLOWED_ORIGINS must list this Worker's own origin — it is what the proxy sends.
		// The legacy GATEWAY_UPSTREAM_URL / GATEWAY_AUTH_TOKEN / GATEWAY_SESSION_USER_*
		// static proxy was removed in 1.0. Raw /rpc, /projections, /sync and /health
		// return 410. Product clients use the session-validated /api/workflow/*
		// relay and GATEWAY_SESSIONS binding above. Remove leftover legacy secrets.
		//   IDENTITY_ADMIN_TOKEN     — identity's ADMIN_SERVICE_TOKEN, spent by POST /api/admin/allowlist and GET /api/admin/requests
		//   BILLING_ADMIN_TOKEN      — billing's ADMIN_SERVICE_TOKEN, spent by POST /api/admin/grant
		// Every /api/admin/* route first validates the session as admin:true through identity;
		// anyone else gets the canonical unknown-route 404, byte-identical (never 403).
	}
}
