// Fill the <...> ids from the create step. Name must match smithers-cutover-rehearsal-[a-z0-9]{1,24}.
{
  "name": "smithers-cutover-rehearsal-r1",
  "main": "scratch.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./assets", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "TURN_CANCELS", "class_name": "TurnCancelRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TurnCancelRegistry"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "smithers-cutover-rehearsal-r1", "database_id": "<D1_ID>" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "smithers-cutover-rehearsal-r1" }],
  "kv_namespaces": [{ "binding": "KV", "id": "<KV_ID>" }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "smithers-cutover-rehearsal-r1" }],
    "consumers": [{ "queue": "smithers-cutover-rehearsal-r1", "max_retries": 2, "dead_letter_queue": "smithers-cutover-rehearsal-r1-dlq" }]
  },
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "97001", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "MODE": "rehearsal" }
}
