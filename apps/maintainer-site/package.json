{
  "name": "@smthrs/maintainer-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A local site for maintainers: Will's decision queue, every e2e flow GIF and a linked knowledge base of the repository's docs.",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "test": "node --test markdown.test.mjs test/serve.test.mjs test/outline.test.mjs test/revision.test.mjs",
    "test:queue": "node test/queue.e2e.mjs",
    "test:code": "node test/code-tools.e2e.mjs",
    "screenshots": "node screenshots.mjs"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
