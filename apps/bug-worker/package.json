{
  "name": "@smthrs/bug-worker",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker behind bug.smithers.sh that receives smithers bug reports and stores them in KV",
  "type": "module",
  "scripts": {
    "test": "bun test tests",
    "typecheck": "vibelang -p tsconfig.json --noEmit",
    "plan": "alchemy deploy --dry-run --stage prod",
    "deploy": "node ../../.smithers/flows/rollout/refuse-unqualified.mjs",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "zod": "4.6.7",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-6a665783b5e4.tgz"
  },
  "devDependencies": {
    "@smthrs/control": "workspace:*",
    "@types/node": "26.4.1",
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "alchemy": "2.0.0-beta.84",
    "bun-types": "^1.4.0",
    "effect": "4.1.1",
    "typescript": "~5.9.3",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-9e7138cd99aa.tgz"
  }
}
