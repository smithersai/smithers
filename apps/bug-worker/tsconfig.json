{
  "compilerOptions": {
    "moduleSuffixes": ["",".d.vibe"],
    "rewriteRelativeImportExtensions": true,
    "allowArbitraryExtensions": true,
    // DOM as well as ESNext: the contract test reaches @smthrs/control, whose
    // WebCrypto sources are typed against DOM, as the module that owns them
    // declares.
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": ["src/**/*", "tests/**/*", "alchemy.run.ts", "alchemy.run.vibe"],
  "vibelang": { "declarationImportStyle": ".ts" }
}
