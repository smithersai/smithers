---
import { getCollection } from 'astro:content'
import '../styles/site.css'
const { title, description, headings = [] } = Astro.props
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
const href = (id: string) => id === 'readme' ? '/' : `/${id}/`
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title} · Smithers TUI</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header><a class="brand" href="/"><span class="mark">s_</span> smithers <span class="badge">TUI</span></a><nav aria-label="Links"><a href="https://github.com/smithersai/smithers/tree/main/apps/tui">Source ↗</a></nav></header>
<div class="shell">
<aside class="sidebar"><div class="nav-label">DOCUMENTATION</div><nav aria-label="Documentation">{pages.map(page => <a href={href(page.id)} aria-current={Astro.url.pathname === href(page.id) ? 'page' : undefined}>{page.data.title}</a>)}</nav></aside>
<main id="content"><div class="eyebrow">SMITHERS / TERMINAL AGENT</div><h1>{title}</h1><article><slot/></article></main>
<aside class="on-page"><div class="nav-label">ON THIS PAGE</div>{headings.filter((h: { depth: number }) => h.depth === 2).map((h: { slug: string; text: string }) => <a href={`#${h.slug}`}>{h.text}</a>)}</aside>
</div>

</body>
</html>
