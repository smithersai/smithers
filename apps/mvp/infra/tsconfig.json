{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "allowArbitraryExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Alchemy follows ChatApi into the generated-view presentation components.
    "jsx": "react-jsx",
    // DOM next to workers-types: the Smithers packages these files compile from source are typed against DOM's
    // globals (`globalThis.crypto`, `TextDecoder` options), which workerd provides and workers-types declares narrower.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // alchemy.run.ts and infra/ run in Node when Alchemy plans and deploys.
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    ".",
    "../alchemy.run.ts",
    "../ops/database",
    "../ops/auth/**/*.ts"
  ]
}
