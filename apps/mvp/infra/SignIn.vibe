// What ChatApi needs for sign-in that the stack makes (docs/features/sign-in.md#configuration): SESSION_SECRET. The
// GitHub App's client id and secret come from the deploying environment, which ChatApi's Config reads.
import * as Alchemy from "alchemy"
import * as Output from "alchemy/Output"
import { Config, Context, Effect, Redacted } from "effect"

/**
 * Sign-in's compatibility secret: generated once by Alchemy (32 random bytes, hexadecimal) and kept, encrypted with
 * `ALCHEMY_PASSWORD`, in the stack's state. It supplies the legacy signing and sealing fallbacks. When used for either,
 * its durable fingerprint prevents replacement during publication.
 */
export const SessionSecret = Alchemy.Random("SessionSecret")

/** SESSION_SECRET for the Worker being declared. alchemy.run.ts provides it while it declares ChatApi. */
export service Secret: { readonly value: Output.Output<Redacted.Redacted<string>> } { static readonly key = "@smthrs/mvp/infra/SignIn/Secret" }

/** The configured key map or a map over the unchanged generated legacy secret. */
export const configuredSecrets = effect (legacy: Output.Output<Redacted.Redacted<string>>) => {
  const configured = try Config.option(Config.Redacted("SESSION_SECRETS"))
  return Option.isSome(configured) ? try Effect.orDie(Effect.try({ try: () => Output.literal(configured.value), catch: (e) => e }))
    : try Effect.orDie(Effect.try({ try: () => Output.map(legacy, value => Redacted.make(JSON.stringify({ legacy: Redacted.value(value) }))), catch: (e) => e }))
}

/** Resolve sealing once so the publication gate and Worker binding use exactly the same secret. */
export const configuredSealSecret = effect (legacy: Output.Output<Redacted.Redacted<string>>) => {
  const configured = try Config.option(Config.Redacted("SESSION_SEAL_SECRET"))
  return Option.isSome(configured) ? try Effect.orDie(Effect.try({ try: () => Output.literal(configured.value), catch: (e) => e })) : legacy
}

/** The stack provides the gate-dependent key map before ChatApi can be published. */
export service SigningSecrets: {
  readonly value: Output.Output<Redacted.Redacted<string>>
  readonly seal: Output.Output<Redacted.Redacted<string>>
} { static readonly key = "@smthrs/mvp/infra/SignIn/SigningSecrets" }

/** Bind legacy compatibility, the gated map and the pinned sealing secret without exposing their values. */
export const bind = effect {
  const secret = try Effect.serviceOption(Secret)
  const signing = try Effect.serviceOption(SigningSecrets)
  if (Option.isNone(secret)) return
  void try try Effect.orDie(Effect.try({ try: () => Output.named(secret.value.value, "SESSION_SECRET").asEffect(), catch: (e) => e }))
  const map = Option.isSome(signing) ? signing.value.value : try configuredSecrets(secret.value.value)
  void try try Effect.orDie(Effect.try({ try: () => Output.named(map, "SESSION_SECRETS").asEffect(), catch: (e) => e }))
  const seal = Option.isSome(signing) ? signing.value.seal : try configuredSealSecret(secret.value.value)
  void try try Effect.orDie(Effect.try({ try: () => Output.named(seal, "SESSION_SEAL_SECRET").asEffect(), catch: (e) => e }))
}
