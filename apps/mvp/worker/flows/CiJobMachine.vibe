import { pinnedCheckoutStage } from "../../src/features/runs/checkoutStage.ts"
import { Uuid, WebCrypto } from "@smthrs/crypto"
import { Action, Interpreter } from "@smthrs/flow"
import { CiJob, type SandboxTools } from "@smthrs/sandbox"
import { Effect, Layer, Metric } from "effect"
import { checkoutForgeLogFields, checkoutForgeSpanAttributes } from "../branch/Checkout.ts"
import { Machines } from "../branch/Machines.vibe"
import { machineOf } from "./CiJobIdentity.ts"

// A CI job's machine (docs/features/ci.md#jobs): `@smthrs/sandbox`'s `ci/job` runs on one throwaway branch machine per
// `job:<run>:<job>`, a `SandboxObject` of `kind: "job"` from the branch sandbox's image (Node, pnpm, Go, Python, git),
// whose box reaches the package registries and nothing else (worker/branch/RegistryEgress.ts). Its checkout is the one commit, fetched
// by its id from GitHub (worker/branch/Checkout.ts), so a fork's pull request head needs no branch. Its commands run as
// the `ci` user, never a person's. Records carry ids and outcomes, never a command or its output.

/** Whom a job's commands run as in its box: a CI job has no person. */
export const CI_OWNER = "ci"

/** The namespace of a job's tool call ids: the version 5 UUID of `<run>:<job>:<call>`. */
export const CI_JOB_NAMESPACE = "6f3c0d1e-5b7a-4c8e-9a2d-1e4f6b8c0a35"

export { machineOf }

/** A job's tool calls on its machine, by `call` (`checkout`, `step`, `release`) and `outcome`. */
export const calls = Metric.counter("smithers_ci_job_calls", {
  description: "CI jobs' calls on their machines, by call and outcome",
  incremental: true,
})

/**
 * Stops every process the job's user still has, but this command's own shell and its ancestors: a step's server or
 * watcher left in the background would keep the machine awake (worker/branch/Machine.ts `PROBE`). POSIX sh over /proc:
 * the image has no procps.
 */
export const STOP_LEFTOVERS = [
  `keep=" $$ "; p=$$`,
  `while [ "$p" -gt 1 ] 2>/dev/null; do p=$(cut -d' ' -f4 /proc/$p/stat 2>/dev/null); [ -n "$p" ] || break; keep="$keep$p "; done`,
  `me=$(id -u)`,
  `for d in /proc/[0-9]*; do q=\${d#/proc/}; [ "$q" = 1 ] && continue; case "$keep" in *" $q "*) continue ;; esac; [ "$(stat -c %u "$d" 2>/dev/null)" = "$me" ] && kill -KILL "$q" 2>/dev/null; done`,
  `true`,
].join("\n")

/** The exit code a step records when its machine lost it: it started and never reported an end. */
export const LOST_EXIT_CODE = -1

type ToolError = Effect.Error<ReturnType<Machines["Service"]["tool"]>>

/** Whether `error` means the machine couldn't start or answer, which the step retries. */
const unavailable = (error: ToolError): error is Extract<ToolError, { _tag: "@smthrs/mvp/branch/SandboxUnavailable" | "@smthrs/mvp/branch/SandboxStartTimedOut" }> =>
  error._tag === "@smthrs/mvp/branch/SandboxUnavailable" || error._tag === "@smthrs/mvp/branch/SandboxStartTimedOut"

const counted = (call: string, outcome: string, target: CiJob.Target, job: CiJob.JobRef) =>
  Effect.andThen(
    Metric.update(Metric.withAttributes(calls, { call, outcome }), 1),
    Effect.logInfo("ci.job.call").pipe(
      Effect.annotateLogs({ run: target.run, repo: target.repo, job: job.name, call, outcome }),
    ),
  )

/** `CiJob.Machine` over the host's `Machines`. */
export const layer = Layer.effect(
  CiJob.Machine,
  effect {
    const machines = try Machines
    const tool = effect (target: CiJob.Target, job: CiJob.JobRef, name: string, call: SandboxTools.Call) => {
      const callId = try (Uuid.v5(CI_JOB_NAMESPACE, `${target.run}:${job.name}:${name}`)
        .pipe(Effect.provide(WebCrypto.layer), Effect.orDie))
      const machine = try Effect.sync(() => machineOf(target, job))
      return try machines.tool(machine, CI_OWNER, callId, call)
    }
    return CiJob.Machine.of({
      // The machine's wake fetched exactly the commit; this reads it back, so a job never runs on another.
      checkout: (target, job) =>
        tool(target, job, "checkout", {
          tool: "run",
          command: `test "$(git rev-parse HEAD)" = ${target.sha}`,
          timeoutSeconds: 60,
        }).pipe(
          (checkout) => effect {
            const ran = checkout catch effect (error) => {
              if (unavailable(error)) throw new CiJob.MachineUnavailable()
              if (error._tag === "@smthrs/mvp/branch/CheckoutFailed") {
                throw new CiJob.CheckoutRefused({
                  checkoutFailure: error.checkoutFailure ?? "other",
                  exitCode: error.exitCode ?? null,
                  ...(error.checkoutTransportCause === undefined ? {} : { checkoutTransportCause: error.checkoutTransportCause }),
                  ...(error.checkoutTransportCause === "http_status" && error.checkoutHttpStatus !== undefined
                    ? { checkoutHttpStatus: error.checkoutHttpStatus }
                    : {}),
                  ...(error.checkoutForge === undefined ? {} : { checkoutForge: error.checkoutForge }),
                })
              }
              throw new CiJob.CheckoutRefused({
                checkoutFailure: error._tag === "@smthrs/sandbox/SandboxTools/ToolLost" ? "tool_lost" : error.reason,
                exitCode: null,
              })
            }
            const result = ran.result as typeof SandboxTools.RunResult.Type
            if (result.timedOut) throw new CiJob.CheckoutRefused({ checkoutFailure: "timed_out", exitCode: null })
            if (result.exitCode !== 0) throw new CiJob.CheckoutRefused({ checkoutFailure: "verify", exitCode: result.exitCode })
            return true
          },
          Effect.tap(() => counted("checkout", "exact", target, job)),
          Effect.tapErrorTag("@smthrs/sandbox/CiJob/CheckoutRefused", effect (refusal) => {
            const stage = try sync(() => pinnedCheckoutStage(refusal.checkoutFailure, refusal.exitCode))
            const httpStatus = refusal.checkoutTransportCause === "http_status" ? refusal.checkoutHttpStatus : undefined
            const forgeLogs = refusal.checkoutForge === undefined ? {} : try sync(() => checkoutForgeLogFields(refusal.checkoutForge!))
            const forgeSpans = refusal.checkoutForge === undefined ? {} : try sync(() => checkoutForgeSpanAttributes(refusal.checkoutForge!))
            try counted("checkout", "refused", target, job).pipe(
              Effect.annotateLogs({
                checkoutFailure: refusal.checkoutFailure,
                exitCode: refusal.exitCode,
                ...(stage === undefined ? {} : { checkoutStage: stage }),
                ...(refusal.checkoutTransportCause === undefined ? {} : { checkoutTransportCause: refusal.checkoutTransportCause }),
                ...(httpStatus === undefined ? {} : { checkoutHttpStatus: httpStatus }),
                ...forgeLogs,
              }),
              Effect.andThen(Effect.annotateCurrentSpan({
                "ci.checkout.failure": refusal.checkoutFailure,
                ...(stage === undefined ? {} : { "ci.checkout.stage": stage }),
                ...(refusal.exitCode === null ? {} : { "ci.checkout.exit_code": refusal.exitCode }),
                ...(refusal.checkoutTransportCause === undefined ? {} : { "ci.checkout.transport_cause": refusal.checkoutTransportCause }),
                ...(httpStatus === undefined ? {} : { "ci.checkout.http_status": httpStatus }),
                ...forgeSpans,
              })),
            )
          }),
          Effect.withSpan("ci.job.checkout"),
        ),
      run: (target, job, index, step) =>
        tool(target, job, `step:${index}`, {
          tool: "run",
          command: step.run,
          timeoutSeconds: step.timeoutSeconds ?? CiJob.limits.defaultTimeoutSeconds,
        }).pipe(
          Effect.map((ran) => {
            const result = ran.result as typeof SandboxTools.RunResult.Type
            return { exitCode: result.exitCode, timedOut: result.timedOut,
              ...(result.stdout === "" && result.stderr === "" && !result.truncated ? {} : {
                output: { stdout: result.stdout, stderr: result.stderr, truncated: result.truncated },
              }),
            }
          }),
          // A command the machine lost or refused isn't run again: it runs at most once per call.
          (run) => effect {
            return run catch effect (error) => {
              if (unavailable(error)) throw new CiJob.MachineUnavailable()
              return { exitCode: LOST_EXIT_CODE, timedOut: false }
            }
          },
          Effect.tap((ran) => counted("step", ran.exitCode === 0 && !ran.timedOut ? "passed" : "failed", target, job)),
        ),
      // Done with the job: whatever its steps left running is stopped, and its machine sleeps now rather than idling
      // until its keep-alive gives up. Best effort.
      release: (target, job) =>
        tool(target, job, "release", { tool: "run", command: STOP_LEFTOVERS, timeoutSeconds: 30 }).pipe(
          Effect.flatMap(effect (ran) => {
            const machine = try Effect.sync(() => machineOf(target, job))
            return try machines.sleepIfIdle(machine.branchId, ran.generation, 0, machine.machine)
          }),
          Effect.tap((outcome) => counted("release", outcome, target, job)),
          Effect.ignore,
        ),
    })
  },
)

/** Registers `ci/job`, and `ci/graph` which runs many as children, over the host's `machines`. */
export const registration = <E, R>(machines: Layer.Layer<Machines, E, R>) =>
  Layer.merge(Interpreter.layerWithImplementations(CiJob.CiJob, CiJob.layer), Interpreter.layer(CiJob.Graph)).pipe(
    Layer.provideMerge(Action.layerImplementations),
    Layer.provide(layer),
    Layer.provide(machines),
  )
