import { DurableClock, DurableDeferred, FlowRuntime, WaitFor } from "@smthrs/flow"
import { Clock, Effect } from "effect"

/** One terminal GitHub fact, addressed within each TODO run, including before it parks. */
export const pullClosed = (number: number) => WaitFor.deferred(`todo/pull/${number}`)

/** Observe a prior terminal signal without parking, including after inspection already restacked the PR. */
export const readPullClosed = effect (number: number) => {
  const engine = try FlowRuntime.FlowRuntime
  return try engine.deferredResult(pullClosed(number))
}

export const awaitPullClosed = effect (number: number) => {
  const instance = try FlowRuntime.FlowInstance
  const deferred = pullClosed(number)
  const token = try sync(() => DurableDeferred.tokenFromExecutionId(deferred, {
    flow: instance.flow, executionId: instance.executionId,
  }))
  // An engine-owned clock is only a missed-delivery fallback. A stable absolute-hour identity replays within
  // the hour; a fallback drive reads GitHub again before parking on the next hour, without failing an attempt.
  const hour = 60 * 60_000
  const now = try Clock.currentTimeMillis
  const bucket = Math.floor(now / hour)
  const engine = try FlowRuntime.FlowRuntime
  const clock = try sync(() => DurableClock.make({
    name: `todo/pull/${number}/fallback/${bucket}`,
    duration: (bucket + 1) * hour - now,
  }))
  try engine.scheduleClock(instance.flow, { executionId: instance.executionId, clock })
  try annotateLogs(logInfo("todo.wait"), { prNumber: number })
  try FlowRuntime.annotateWaiting({ reason: "event", token })
  try DurableDeferred.await(deferred)
}
