import { CodeStorage } from "@smthrs/effect-code-storage"
import { Action, Flow, Interpreter, RetryPolicy } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { Clock, Config, Duration, Effect, Layer, Metric, Schema } from "effect"
import type { SqlClient } from "effect/sql"
import { CAPACITY_REASONS, FAILURES } from "../../src/features/repo/contract.ts"
import { codeOf } from "../ErrorCode.vibe"
import * as RepoMetrics from "../RepoMetrics.ts"
import * as Repos from "../Repos.ts"
import type { RepoUpstream } from "../RepoUpstream.vibe"

// `repo/Clone { id, owner, name, cloneId, requestedAt }` (decision 0006 §1, docs/features/repo.md#the-clone): mirrors
// a public GitHub repository into Code Storage and records it in `repositories`. `cloneId` is the attempt's own id: it
// names the execution (`repo-clone:<id>:<cloneId>`), and only the attempt with that id may write the row.
//
//   repo/Inspect ─ admitted ─▶ repo/Import ─▶ repo/Pull ─▶ repo/AwaitSync ─▶ repo/Index ─▶ repo/Settle
//                └ refused or failed ────────────────────────────────────────────────────▶ repo/Settle
//
// The row's `stage` follows it, and with it the feed of the person who asked (worker/CloneFeed.ts): `requested` when
// RepoApi takes it, `fetching` once admitted, `indexing` once Code Storage has the head commit, then ready or failed.
// Index reads the file list at the head into the shared cache, so the first visit's tree is already there, and asks
// whether the Smithers GitHub App is installed on the repository: a ready copy without it is reclaimable.
//
// It runs remotely because it needs the Code Storage organization key (decision 0011 §2), on the per-execution Durable
// Object (worker/ExecutionHost.ts), and on the Node host in the tests. Nothing here names a host: the host injects
// Postgres, Code Storage and GitHub through `registration`. Retries and waits belong to the engine: each step's retry
// policy, which honors Code Storage's `Retry-After`. Every step is sealed, so a resumed run never repeats one that
// finished; each outside effect is idempotent anyway (create by name, a pull already running, a fenced settle).

/** Code Storage, GitHub or Postgres couldn't answer. The step's retry policy tries again, after `retryAfterMillis`. */
export class CloneUnavailable extends Schema.TaggedError<CloneUnavailable>()("@smthrs/mvp/repo/CloneUnavailable", {
  retryAfterMillis: Schema.optional(Schema.Number),
}) {}

/**
 * The clone was refused outright, such as a name that exists in Code Storage with another upstream, or its attempt lost
 * the repository's row before admission. Not retried.
 */
export class CloneRefused extends Schema.TaggedError<CloneRefused>()("@smthrs/mvp/repo/CloneRefused", {}) {}

/** Code Storage's first sync is still running. Retried until the clone's deadline. */
export class SyncPending extends Schema.TaggedError<SyncPending>()("@smthrs/mvp/repo/SyncPending", {
  retryAfterMillis: Schema.optional(Schema.Number),
}) {}

/** Inspect, Import and Pull: 1 s doubling to 30 s, for at most 2 minutes. */
export const STEP_RETRY = RetryPolicy.make({
  initialMs: 1_000,
  factor: 2,
  maxMs: 30_000,
  expirationMs: 2 * 60_000,
  nonRetryable: ["@smthrs/mvp/repo/CloneRefused"],
})

/** AwaitSync: 2 s doubling to 30 s, until the step itself answers that the deadline passed; an hour at most. */
export const SYNC_RETRY = RetryPolicy.make({
  initialMs: 2_000,
  factor: 2,
  maxMs: 30_000,
  expirationMs: 60 * 60_000,
  nonRetryable: ["@smthrs/mvp/repo/CloneRefused"],
})

/** Settle: 1 s doubling to a minute, for at most 30 minutes, while Postgres is unreachable. */
export const SETTLE_RETRY = RetryPolicy.make({ initialMs: 1_000, factor: 2, maxMs: 60_000, expirationMs: 30 * 60_000 })

/** The attempt's own id, a UUID drawn when the attempt was created (`repositories.clone_id`). */
const CloneId = Schema.String.check(Schema.isUUID())

/** The clone a run is for: the repository, the attempt that owns its row, and when it was asked for (epoch ms). */
const CloneRequest = {
  id: Schema.String,
  owner: Schema.String,
  name: Schema.String,
  cloneId: CloneId,
  requestedAt: Schema.Number,
}

/**
 * What Inspect decided: `admitted` with the default branch and size; `capacity` with the budget that refused it (and
 * the size, and when GitHub gives the size again); or `failed` with why.
 */
export const Inspection = Schema.Struct({
  outcome: Schema.Literals(["admitted", "capacity", "failed"]),
  defaultBranch: Schema.NullOr(Schema.String),
  storedBytes: Schema.NullOr(Schema.Number),
  capacity: Schema.NullOr(Schema.Literals(CAPACITY_REASONS)),
  retryAt: Schema.NullOr(Schema.Number),
  failure: Schema.NullOr(Schema.Literals(FAILURES)),
})
export type Inspection = typeof Inspection.Type

/** The default branch's head commit, once synced. */
export const Head = Schema.Struct({
  sha: Schema.String,
  message: Schema.String,
  author: Schema.String,
  at: Schema.String,
})

/** How the sync went after admission: `ready` with the head, or why not; `skipped` when nothing was imported. */
export const Synced = Schema.Struct({
  status: Schema.Literals(["ready", "timed_out", "unavailable", "skipped"]),
  head: Schema.NullOr(Head),
})
export type Synced = typeof Synced.Type

const failed = (failure: (typeof FAILURES)[number]): Inspection => ({
  outcome: "failed",
  defaultBranch: null,
  storedBytes: null,
  capacity: null,
  retryAt: null,
  failure,
})

/** Inspect's answer when GitHub or Postgres stayed unreachable past its retries. */
export const INSPECTION_UNAVAILABLE = failed("unavailable")
const SKIPPED: Synced = { status: "skipped", head: null }
const UNAVAILABLE: Synced = { status: "unavailable", head: null }

/** Reads the repository's HEAD and size from GitHub, then runs admission (docs/features/repo.md#admission). */
export const Inspect = Action.make("repo/Inspect", {
  payload: CloneRequest,
  success: Inspection,
  error: Schema.Union([CloneUnavailable, CloneRefused]),
  retryPolicy: STEP_RETRY,
})

const importPayload = {
  id: Schema.String,
  owner: Schema.String,
  name: Schema.String,
  defaultBranch: Schema.NullOr(Schema.String),
}

/** Creates the Code Storage repository mirroring GitHub's, by name: one that exists already is fine. */
export const Import = Action.make("repo/Import", {
  payload: importPayload,
  success: Schema.Struct({ created: Schema.Boolean }),
  error: Schema.Union([CloneUnavailable, CloneRefused]),
  retryPolicy: STEP_RETRY,
})

/** Starts Code Storage's sync from GitHub: one already running is fine. */
export const Pull = Action.make("repo/Pull", {
  payload: { id: Schema.String },
  success: Schema.Struct({}),
  error: Schema.Union([CloneUnavailable, CloneRefused]),
  retryPolicy: STEP_RETRY,
})

/**
 * Waits until Code Storage has the default branch and answers `ready` with its head commit, or `timed_out` once the
 * clone's deadline has passed since its request.
 */
export const AwaitSync = Action.make("repo/AwaitSync", {
  payload: { id: Schema.String, defaultBranch: Schema.NullOr(Schema.String), requestedAt: Schema.Number },
  success: Synced,
  error: Schema.Union([SyncPending, CloneUnavailable, CloneRefused]),
  retryPolicy: SYNC_RETRY,
})

/**
 * What Index found: how many files the head commit has (`null` when its list couldn't be read), and whether the Smithers
 * GitHub App is installed on the repository (`null` when unknown).
 */
export const Indexed = Schema.Struct({ files: Schema.NullOr(Schema.Number), installed: Schema.NullOr(Schema.Boolean) })
export type Indexed = typeof Indexed.Type

/** Index's answer when nothing was synced, or it couldn't run: no files read, and no App known. */
export const NOT_INDEXED: Indexed = { files: null, installed: null }

/**
 * Once the head commit is in: moves the row to stage `indexing`, reads the file list at the head into the shared cache
 * (best effort), and asks whether the App is installed. A sync that isn't ready, or an attempt that no longer owns its
 * row, answers `NOT_INDEXED` and changes nothing.
 */
export const Index = Action.make("repo/Index", {
  payload: { id: Schema.String, owner: Schema.String, name: Schema.String, cloneId: CloneId, synced: Synced },
  success: Indexed,
  error: CloneUnavailable,
  retryPolicy: STEP_RETRY,
})

/** Writes how the clone ended, only while this attempt owns a `cloning` row. */
export const Settle = Action.make("repo/Settle", {
  payload: { id: Schema.String, cloneId: CloneId, inspection: Inspection, synced: Synced, indexed: Indexed },
  success: Schema.Struct({ status: Schema.Literals(["ready", "failed", "capacity"]), settled: Schema.Boolean }),
  error: CloneUnavailable,
  retryPolicy: SETTLE_RETRY,
})

/** `repo/Clone`: clones a public GitHub repository into Code Storage. */
export const Clone = Flow.make("repo/Clone", {
  description: "Clone a public GitHub repository into Code Storage and record it in repositories.",
  capabilities: ["db:write:repositories"],
  modelInvocable: false,
  payload: CloneRequest,
  success: Settle.successSchema,
  error: CloneUnavailable,
  body: Node.capture(
    {
      inspect: Inspect.name,
      import: Import.name,
      pull: Pull.name,
      await: AwaitSync.name,
      index: Index.name,
      settle: Settle.name,
    },
    (request) =>
      Inspect.call(request).pipe(
        Node.catch({
          onFailure: Node.capture({ inspection: "unavailable" }, () => Node.succeed(INSPECTION_UNAVAILABLE)),
        }),
        Node.branch({
          if: Node.capture({ admitted: "admitted" }, (inspection: Inspection) => inspection.outcome === "admitted"),
          then: Node.capture({ synced: "ready" }, (inspection) =>
            Import.call({
              id: request.id,
              owner: request.owner,
              name: request.name,
              defaultBranch: inspection.defaultBranch,
            }).pipe(
              Node.andThen(Pull.call({ id: request.id })),
              Node.andThen(
                AwaitSync.call({
                  id: request.id,
                  defaultBranch: inspection.defaultBranch,
                  requestedAt: request.requestedAt,
                }),
              ),
              Node.catch({ onFailure: Node.capture({ synced: "unavailable" }, () => Node.succeed(UNAVAILABLE)) }),
              Node.bindPlanned(Node.capture({ index: Index.name, settle: Settle.name }, (synced) =>
                Index.call({
                  id: request.id,
                  owner: request.owner,
                  name: request.name,
                  cloneId: request.cloneId,
                  synced,
                }).pipe(
                  Node.catch({ onFailure: Node.capture({ indexed: "none" }, () => Node.succeed(NOT_INDEXED)) }),
                  Node.bindPlanned(Node.capture({ settle: Settle.name }, (indexed) =>
                    Settle.call({ id: request.id, cloneId: request.cloneId, inspection, synced, indexed }))),
                ))),
            )),
          else: Node.capture({ synced: "skipped" }, (inspection) =>
            Settle.call({
              id: request.id,
              cloneId: request.cloneId,
              inspection,
              synced: SKIPPED,
              indexed: NOT_INDEXED,
            })),
        }),
      ),
  ),
})

/** What the clone needs from its host. */
export interface Services<E = unknown, R = never> {
  /** Postgres with the app's tables (not the engine's schema). */
  readonly database: Layer.Layer<SqlClient.SqlClient, E, R>
  readonly codeStorage: CodeStorage.Client
  readonly upstream: RepoUpstream["Service"]
  readonly budgets: Repos.Budgets
  /** How long after the request the sync may take (`REPO_CLONE_DEADLINE`, default 10 minutes). */
  readonly deadline: Duration.Duration
  /**
   * Reads `owner/name`'s file list at `sha` into the shared cache, as RepoApi's tree read does, and answers how many
   * files it has.
   */
  readonly index: (owner: string, name: string, sha: string) => number!CloneUnavailable!R
  /** Whether the Smithers GitHub App is installed on `owner/name`: `false` for a deployment without the App. */
  readonly installed: (owner: string, name: string) => boolean!CloneUnavailable
}

/** Reads `REPO_CLONE_DEADLINE`. */
export const deadline = Config.Duration("REPO_CLONE_DEADLINE").pipe(Config.withDefault(Duration.minutes(10)))

/** A Code Storage failure as a step reports it: transient ones retried after its wait, the rest refused. */
const fromCodeStorage = (error: CodeStorage.CodeStorageError) =>
  CodeStorage.isTransient(error)
    ? new CloneUnavailable(error.retryAfterMillis === undefined ? {} : { retryAfterMillis: error.retryAfterMillis })
    : new CloneRefused()

/** Code Storage's codes while a new mirror's first sync hasn't produced the branch yet. */
const NOT_YET = new Set(["sync_in_progress", "not_found", "repository_not_found", "ref_not_found", "branch_not_found"])

/** The steps' implementations over `services`, each recording what it did. */
export const steps = <E, R>(services: Services<E, R>) => {
  const { codeStorage, upstream, database, budgets } = services
  const record = (step: string, fields: Record<string, string | number | boolean>) =>
    Effect.logInfo("repo.clone.step") |> Effect.annotateLogs({ step, ...fields })(%)

  const inspect = (request: typeof Inspect.payloadSchema.Type) =>
    (effect {
      const head = try (upstream.head(request.owner, request.name) |> Effect.result(%))
      if (head._tag === "Failure") {
        const code = head.failure.code
        if (code === "not_found" || code === "empty") return failed(code)
        throw new CloneUnavailable()
      }
      const branch = head.success.branch
      if (branch === undefined) return failed("unavailable")
      const size = upstream.size(request.owner, request.name) catch effect (error) => {
        throw new CloneUnavailable(
          error.retryAfterMillis === undefined ? {} : { retryAfterMillis: error.retryAfterMillis },
        )
      }
      if ("missing" in size) return failed("not_found")
      const admission = try (Repos.admit({ id: request.id, cloneId: request.cloneId }, size, budgets)
        |> Effect.provide(%, database)
        // A stale attempt imports nothing: Try again's attempt owns the row.
        |> Effect.mapError(%, (error) =>
          error instanceof Repos.AdmissionLost ? new CloneRefused() : new CloneUnavailable()))
      return admission.admitted
        ? {
          outcome: "admitted",
          defaultBranch: branch,
          storedBytes: admission.storedBytes,
          capacity: null,
          retryAt: null,
          failure: null,
        } satisfies Inspection
        : {
          outcome: "capacity",
          defaultBranch: branch,
          storedBytes: admission.storedBytes,
          capacity: admission.reason,
          retryAt: admission.retryAt,
          failure: null,
        } satisfies Inspection
    })
    |> Effect.tap(%, (inspection) =>
      record("inspect", {
        id: request.id,
        cloneId: request.cloneId,
        outcome: inspection.outcome,
        reason: inspection.capacity ?? inspection.failure ?? "none",
      }))
    |> withSpan(%, "repo.clone.inspect", { attributes: { "smithers.repo.id": request.id } })

  const importRepo = (payload: typeof Import.payloadSchema.Type) =>
    (effect {
      if (payload.defaultBranch === null) throw new CloneRefused()
      const created = codeStorage.createRepo({
        name: payload.id,
        defaultBranch: payload.defaultBranch,
        github: { owner: payload.owner, name: payload.name },
      }) catch effect (error) => {
        throw fromCodeStorage(error)
      }
      try record("import", { id: payload.id, created: created.created })
      return { created: created.created }
    }) |> withSpan(%, "repo.clone.import", { attributes: { "smithers.repo.id": payload.id } })

  const pull = (payload: { readonly id: string }) =>
    codeStorage.pullUpstream(payload.id)
    |> Effect.catchIf(%, (error) => error.code === "sync_in_progress", () => Effect.void)
    |> Effect.mapError(%, (error) => fromCodeStorage(error))
    |> Effect.tap(%, () => record("pull", { id: payload.id }))
    |> Effect.as(%, {})
    |> withSpan(%, "repo.clone.pull", { attributes: { "smithers.repo.id": payload.id } })

  const awaitSync = (payload: typeof AwaitSync.payloadSchema.Type) =>
    (effect {
      if (payload.defaultBranch === null) throw new CloneRefused()
      const listed = try (codeStorage.listCommits(payload.id, { ref: payload.defaultBranch, limit: 1 })
        |> Effect.result(%))
      const commit = listed._tag === "Success" ? listed.success.commits[0] : undefined
      if (commit !== undefined) {
        try record("await_sync", { id: payload.id, outcome: "ready" })
        const head = { sha: commit.sha, message: commit.message, author: commit.authorName, at: commit.date }
        return { status: "ready", head } satisfies Synced
      }
      if (listed._tag === "Failure" && !NOT_YET.has(listed.failure.code)) {
        throw fromCodeStorage(listed.failure)
      }
      const elapsed = (try Clock.currentTimeMillis) - payload.requestedAt
      if (elapsed >= Duration.toMillis(services.deadline)) {
        try record("await_sync", { id: payload.id, outcome: "timed_out" })
        return { status: "timed_out", head: null } satisfies Synced
      }
      const wait = listed._tag === "Failure" ? listed.failure.retryAfterMillis : undefined
      throw new SyncPending(wait === undefined ? {} : { retryAfterMillis: wait })
    }) |> withSpan(%, "repo.clone.await_sync", { attributes: { "smithers.repo.id": payload.id } })

  const index = (payload: typeof Index.payloadSchema.Type) =>
    (effect {
      const head = payload.synced.head
      if (payload.synced.status !== "ready" || head === null) return NOT_INDEXED
      const owned = (Repos.indexing({ id: payload.id, cloneId: payload.cloneId })
        |> Effect.provide(%, database)) catch effect () => {
          throw new CloneUnavailable()
        }
      if (!owned) return NOT_INDEXED
      // Best effort: a list that can't be read now is read by the first visit instead.
      const files = services.index(payload.owner, payload.name, head.sha) catch () => null
      // Optional metadata must not hold a ready clone through the step's retry policy. Unknown is never reclaimable.
      const installed = services.installed(payload.owner, payload.name) catch () => null
      try record("index", { id: payload.id, files: files ?? -1, installed: installed ?? "unknown" })
      return { files, installed } satisfies Indexed
    }) |> withSpan(%, "repo.clone.index", { attributes: { "smithers.repo.id": payload.id } })

  const settle = (payload: typeof Settle.payloadSchema.Type) =>
    (effect {
      const outcome = outcomeOf(payload.inspection, payload.synced, payload.indexed)
      const written = (Repos.settle({ id: payload.id, cloneId: payload.cloneId }, outcome, budgets)
        |> Effect.provide(%, database)
        |> Effect.tapError(%, (error) =>
          Effect.logWarning("repo.clone.settle")
          |> Effect.annotateLogs({ id: payload.id, cloneId: payload.cloneId, errorCode: codeOf(error) })(%))) catch effect () => {
            throw new CloneUnavailable()
          }
      const reason = outcome.status === "failed"
        ? outcome.failure
        : outcome.status === "capacity"
        ? outcome.capacity
        : "none"
      if (written.settled) {
        try Metric.update(Metric.withAttributes(RepoMetrics.clones, { outcome: outcome.status, reason }), 1)
        if (outcome.status === "capacity") {
          try Metric.update(Metric.withAttributes(RepoMetrics.capacity, { reason }), 1)
        }
      }
      if (written.spend !== null) try RepoMetrics.recordSpend(written.spend)
      try (Effect.logWithLevel(outcome.status === "failed" ? "Warn" : "Info")("repo.clone.settle")
        |> Effect.annotateLogs({
          id: payload.id,
          cloneId: payload.cloneId,
          status: outcome.status,
          reason,
          settled: written.settled,
        })(%))
      return { status: outcome.status, settled: written.settled }
    }) |> withSpan(%, "repo.clone.settle", { attributes: { "smithers.repo.id": payload.id } })

  return { inspect, importRepo, pull, awaitSync, index, settle }
}

/** How a clone ended, from what Inspect decided, how the sync went, and what Index found. */
export const outcomeOf = (inspection: Inspection, synced: Synced, indexed: Indexed = NOT_INDEXED): Repos.Outcome => {
  if (inspection.outcome === "capacity") {
    return {
      status: "capacity",
      capacity: inspection.capacity!,
      storedBytes: inspection.storedBytes,
      retryAt: inspection.retryAt,
    }
  }
  if (inspection.outcome === "failed") return { status: "failed", failure: inspection.failure! }
  if (synced.status === "ready") {
    return {
      status: "ready",
      defaultBranch: inspection.defaultBranch!,
      head: synced.head!,
      reclaimable: indexed.installed === false,
    }
  }
  return { status: "failed", failure: synced.status === "timed_out" ? "timed_out" : "unavailable" }
}

/** Registers `repo/Clone` with its steps over `services`. */
export const registration = <E, R>(services: Services<E, R>) => {
  const implementation = steps(services)
  return Interpreter.layerWithImplementations(
    Clone,
    Layer.mergeAll(
      Inspect.toLayer(implementation.inspect),
      Import.toLayer(implementation.importRepo),
      Pull.toLayer(implementation.pull),
      AwaitSync.toLayer(implementation.awaitSync),
      Index.toLayer(implementation.index),
      Settle.toLayer(implementation.settle),
    ),
  ).pipe(Layer.provideMerge(Action.layerImplementations))
}
