import { Budget } from "@smthrs/agent"
import { HarnessError, Sandbox } from "@smthrs/harness"
import { Evaluator, ModelError } from "@smthrs/model"

const isBudgetTag = Schema.is(Budget.BudgetExceeded.fields._tag)
const isBudgetScope = Schema.is(Budget.BudgetExceeded.fields.scope)

/** Persisted SDK tags and closed code schemas only; never a cause's message or arbitrary tag. */
const harnessCauseCodeOf = (cause: unknown): string => {
  if (typeof cause !== "object" || cause === null || !("_tag" in cause)) return "none"
  if (
    cause._tag === "flows/model/EvaluatorError" && "code" in cause
    && Schema.is(Evaluator.EvaluatorErrorCode)(cause.code)
  ) return `evaluator_${cause.code}`
  if (
    cause._tag === "flows/harness/SandboxError" && "code" in cause
    && Schema.is(Sandbox.SandboxErrorCode)(cause.code)
  ) return `sandbox_${cause.code}`
  return cause._tag === "/harness/CellTurn/RepeatedFailure" ? "repeated_failure" : "none"
}

/** A finite agent budget scope, including the budget a skipped call inherits after journal serialization. */
const budgetScopeOf = (error: unknown): string => {
  if (typeof error !== "object" || error === null) return "none"
  const candidate = "_tag" in error && error._tag === Budget.skippedTag && "budget" in error ? error.budget : error
  return typeof candidate === "object" && candidate !== null && "_tag" in candidate
      && isBudgetTag(candidate._tag) && "scope" in candidate && isBudgetScope(candidate.scope)
    ? candidate.scope
    : "none"
}

/** Stable nested codes only. Provider and harness messages can contain repository or request text. */
export const agentFailureCodes = (error: unknown): {
  readonly harnessCode: string
  readonly modelCode: string
  readonly budgetScope: string
  readonly causeCode: string
} => {
  const budgetScope = budgetScopeOf(error)
  if (
    typeof error !== "object" || error === null || !("_tag" in error)
    || error._tag !== "/harness/HarnessError" || !("code" in error)
    || !Schema.is(HarnessError.HarnessErrorCode)(error.code)
  ) {
    return { harnessCode: "none", modelCode: "none", budgetScope, causeCode: "none" }
  }
  const cause = "cause" in error ? error.cause : undefined
  const modelCode = typeof cause === "object" && cause !== null && "_tag" in cause
      && cause._tag === "flows/model/ModelError" && "code" in cause
      && Schema.is(ModelError.ModelErrorCode)(cause.code)
    ? cause.code
    : "none"
  return { harnessCode: error.code, modelCode, budgetScope: budgetScopeOf(cause), causeCode: harnessCauseCodeOf(cause) }
}
