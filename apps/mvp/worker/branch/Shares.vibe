import { ShapeProxy } from "@smthrs/effect-electric"
import { Cause, Clock, Effect, type Layer, Metric, Option, Schema } from "effect"
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import { SqlClient } from "effect/sql"
import {
  isLogin,
  MAX_SHARE_BODY_BYTES,
  MAX_SHARES,
  REPOSITORY_GRANTEE,
  SHARE_ACCESSES,
  SHARES_TABLE,
  type ShareAccess,
} from "../../src/features/branch/contract.ts"
import { LOCAL_ELECTRIC_URL } from "../../src/features/chat/contract.ts"
import { type Actor, refusesPersonOnly, type Role, Sessions } from "../Actor.vibe"
import { readBounded } from "../Body.vibe"
import { codeOf } from "../ErrorCode.ts"
import * as Repos from "../Repos.vibe"
import * as ShapeAccess from "../ShapeAccess.vibe"
import { branchAccess, canView, type Policy, policyOf, underPolicy } from "./Access.vibe"
import { Directory } from "./People.vibe"
import { Rooms } from "./Rooms.vibe"
import { enforceRooms } from "./Texts.vibe"
import { type Revoked, TerminalSockets } from "./Sandboxes.vibe"

// Sharing a branch, Google Docs style (decision 0013 §2 and §4, docs/features/branch-workspace.md#sharing):
//
// - `POST /api/branches/<id>/shares`: the write path of the client flow `branch/share`, its owner's, but for anyone
//   removing their own access. `{ login, access }` shares the branch with a person by their GitHub login, to view or
//   edit; `{ grantee, access }` changes a grant: a person's id, or `repository`, anyone in the repository with the
//   link; `access: null` removes it.
// - `GET /api/shapes/shares?branch=<id>`: the branch's permission list, for its owner. Anyone else gets no rows.
//
// A change applies to the sessions already open before it answers: everyone on the branch's machine and in its room
// is held to the new list, so a person whose access went is detached at once and one whose access changed reconnects
// with the new one; the terminals of a person who lost the branch end. Doing it again changes nothing, so the flow's
// step sends it again until it answers. No log line, span or metric carries a login.

/** `POST /api/branches/<id>/shares` requests, by `change` (`person`, `access`, `remove`, `link`) and `outcome`. */
export const changes = Metric.counter("smithers_branch_shares", {
  description: "POST /api/branches/<id>/shares requests, by change and outcome",
  incremental: true,
})

/** `GET /api/shapes/shares` requests, by `status` and `live`. */
export const shapes = Metric.counter("smithers_branch_share_shape_requests", {
  description: "GET /api/shapes/shares requests, by status and live",
  incremental: true,
})

/** Terminals ended because their owner lost the branch. */
export const revocations = Metric.counter("smithers_branch_terminal_revocations", {
  description: "Terminals ended because their owner lost the branch",
  incremental: true,
})

const Access = Schema.Literals(SHARE_ACCESSES)
const Change = Schema.Union([
  Schema.Struct({ login: Schema.String.check(Schema.makeFilter(isLogin)), access: Access }),
  Schema.Struct({
    grantee: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(100)),
    access: Schema.NullOr(Access),
  }),
])
type Change = typeof Change.Type
const decodeChange = Schema.decodeUnknownEffect(Schema.fromJsonString(Change))
const isUuid = Schema.is(Schema.String.check(Schema.isUUID()))

/** What a shape filters on for someone who doesn't own the branch: no branch's id, so it holds no rows. */
const NO_BRANCH = "00000000-0000-0000-0000-000000000000"

const noStore = { "cache-control": "no-store" }
const refusal = (status: number, code: string) => HttpServerResponse.jsonUnsafe({ code }, { status, headers: noStore })

type Fields = Record<string, string | number | boolean>

/** The kind of change a body is, for the records. */
const kindOf = (change: Change) =>
  "login" in change
    ? "person"
    : change.grantee === REPOSITORY_GRANTEE
    ? "link"
    : change.access === null
    ? "remove"
    : "access"

/** A refusal the change itself decided, inside its transaction. */
schema error Refused {
  status: number
  code: string
}

/**
 * Writes `change` to branch `branchId`'s permission list for its owner `owner`, `person` the person a login named:
 * the transaction it wrote in, or `null` when the list already said so.
 */
const write = effect (branchId: string, repoId: string, owner: Actor, change: Change, person: { readonly id: string; readonly login: string } | undefined) => {
  const sql = try SqlClient.SqlClient
  const writeGrant = effect {
    // One change of a branch's list at a time, so the cap holds under concurrent shares.
    try sql`SELECT id FROM branches WHERE id = ${branchId} FOR UPDATE`
    const txid = map(
      sql<{ readonly txid: string }>`SELECT pg_current_xact_id()::xid::text AS txid`,
      ([row]) => Number(row!.txid),
    )
    if (person !== undefined) {
      if (person.id === owner.subject.id) throw new Refused({ status: 400, code: "invalid" })
      const [{ count }] = try sql<{ readonly count: number }>`
        SELECT count(*)::int AS count FROM branch_shares
        WHERE branch_id = ${branchId} AND grantee <> ${REPOSITORY_GRANTEE} AND grantee <> ${person.id}`
      if (count >= MAX_SHARES) throw new Refused({ status: 409, code: "too_many" })
      const written = try sql`
        INSERT INTO branch_shares (branch_id, grantee, login, access, shared_by)
        VALUES (${branchId}, ${person.id}, ${person.login}, ${change.access}, ${owner.subject.id})
        ON CONFLICT (branch_id, grantee) DO UPDATE
          SET access = EXCLUDED.access, login = EXCLUDED.login, updated_at = now()
          WHERE branch_shares.access <> EXCLUDED.access OR branch_shares.login <> EXCLUDED.login
        RETURNING grantee`
      return written.length === 0 ? null : try txid
    }
    const { grantee, access } = change as Extract<Change, { readonly grantee: string }>
    if (access === null) {
      const removed = try sql`
        DELETE FROM branch_shares WHERE branch_id = ${branchId} AND grantee = ${grantee} RETURNING grantee`
      return removed.length === 0 ? null : try txid
    }
    if (grantee === REPOSITORY_GRANTEE) {
      const written = try sql`
        INSERT INTO branch_shares (branch_id, grantee, access, shared_by)
        VALUES (${branchId}, ${REPOSITORY_GRANTEE}, ${access}, ${owner.subject.id})
        ON CONFLICT (branch_id, grantee) DO UPDATE SET access = EXCLUDED.access, updated_at = now()
          WHERE branch_shares.access <> EXCLUDED.access
        RETURNING grantee`
      return written.length === 0 ? null : try txid
    }
    const [existing] = try sql<{ readonly access: ShareAccess }>`
      SELECT access FROM branch_shares WHERE branch_id = ${branchId} AND grantee = ${grantee}`
    if (existing === undefined) throw new Refused({ status: 404, code: "not_found" })
    if (existing.access === access) return null
    try sql`
      UPDATE branch_shares SET access = ${access}, updated_at = now()
      WHERE branch_id = ${branchId} AND grantee = ${grantee}`
    return try txid
  }
  // Ref discovery changes with sharing. Publish the new grants and their cache revision in one transaction.
  return try sql.withTransaction(tap(writeGrant, (written) => written === null ? Effect.void : Repos.refsChanged(repoId)))
}

/** The live terminals on branch `branchId` whose owners may no longer view it under `policy`. */
const revokedUnder = effect (branchId: string, policy: Policy) => {
  const sql = try SqlClient.SqlClient
  const live = try sql<{ readonly terminalId: string; readonly ownerId: string; readonly ownerRole: Role }>`
    SELECT id AS "terminalId", owner_id AS "ownerId", owner_role AS "ownerRole" FROM terminal_sessions
    WHERE branch_id = ${branchId} AND status IN ('opening', 'open')`
  return live
    .filter((row) => !canView(underPolicy(policy, row.ownerId, row.ownerRole)))
    .map(({ terminalId, ownerId }): Revoked => ({ terminalId, ownerId }))
}

/** Ends `revoked` terminals that are still live, `revoked`: answers how many it ended. */
const endRevoked = effect (revoked: ReadonlyArray<Revoked>) => {
  if (revoked.length === 0) return 0
  const sql = try SqlClient.SqlClient
  const ended = try sql`
    UPDATE terminal_sessions SET status = 'ended', ended_reason = 'revoked', ended_at = now(), updated_at = now()
    WHERE id IN ${sql.in(revoked.map((terminal) => terminal.terminalId))} AND status IN ('opening', 'open')
    RETURNING id`
  return ended.length
}

/**
 * Reads Electric's connection and returns the sharing routes over `database`, which opens a Postgres client for each
 * request's scope. They read who is asking from `Sessions`, people by login from `Directory`, and hold the sessions
 * already open to a change through `TerminalSockets` and `Rooms`.
 */
export const make = effect <E, R>(database: Layer.Layer<SqlClient.SqlClient, E, R>) => {
  const connection = try ShapeProxy.config({ url: LOCAL_ELECTRIC_URL })

  /** `POST /api/branches/<branchId>/shares`. */
  const change = (branchId: string) =>
    withSpan(effect {
      const request = try HttpServerRequest.HttpServerRequest
      const startedAt = try Clock.currentTimeMillis
      const fields: Fields = {}
      const response = try catchCause(effect {
        if (request.method !== "POST") return HttpServerResponse.empty({ status: 405, headers: { allow: "POST" } })
        const actor = try (try Sessions).resolve
        if (Option.isNone(actor)) return refuse(fields, 401, "authentication")
        // Sharing is the owner's own act; the agent never grants access (decision 0017 slice 0).
        if (try refusesPersonOnly(actor.value, "branch/share")) return refuse(fields, 403, "person_only")
        const body = try readBounded(request, MAX_SHARE_BODY_BYTES).pipe(result)
        if (body._tag === "Failure") return refuse(fields, body.failure.reason === "too_large" ? 413 : 400, "invalid")
        const decoded = try decodeChange(body.success).pipe(option)
        if (Option.isNone(decoded)) return refuse(fields, 400, "invalid")
        fields.change = kindOf(decoded.value)
        if (!isUuid(branchId)) return refuse(fields, 404, "not_found")
        const id = branchId.toLowerCase()
        fields.branchId = id
        const branch = try branchAccess(actor, id).pipe(Effect.provide(database))
        if (branch === undefined) return refuse(fields, 404, "not_found")
        // The owner changes anyone's access; anyone else may only remove their own (decision 0013, decision 8).
        const leaving = "grantee" in decoded.value && decoded.value.grantee === actor.value.subject.id &&
          decoded.value.access === null
        if (branch.access !== "owner" && !leaving) return refuse(fields, 403, "forbidden")
        const person = "login" in decoded.value
          ? try (try Directory).find(decoded.value.login)
          : Option.none()
        if ("login" in decoded.value && Option.isNone(person)) return refuse(fields, 404, "no_person")
        const written = try write(id, branch.repoId, actor.value, decoded.value, Option.getOrUndefined(person)).pipe(
          Effect.provide(database),
          result,
        )
        if (written._tag === "Failure") {
          if (written.failure instanceof Refused) return refuse(fields, written.failure.status, written.failure.code)
          throw written.failure
        }
        // Everyone already on the branch is held to the list as it now stands, before the answer.
        const policy = try policyOf(id).pipe(Effect.provide(database))
        const revoked = try revokedUnder(id, policy).pipe(Effect.provide(database))
        try (try TerminalSockets).enforce(id, policy, revoked)
        try (try Rooms).enforce(id, policy)
        try enforceRooms(id, policy).pipe(Effect.provide(database))
        const ended = try endRevoked(revoked).pipe(Effect.provide(database))
        if (ended > 0) try Metric.update(revocations, ended)
        fields.outcome = written.success === null ? "unchanged" : "changed"
        fields.revoked = ended
        return HttpServerResponse.jsonUnsafe({ txid: written.success }, { headers: noStore })
      }, (cause) =>
        sync(() => {
          fields.errorCode = codeOf(Cause.squash(cause))
          return refuse(fields, 503, "unavailable")
        }))
      fields.status = response.status
      fields.durationMs = (try Clock.currentTimeMillis) - startedAt
      const outcome = String(fields.outcome ?? fields.code ?? "method")
      try Metric.update(
        Metric.withAttributes(changes, { change: String(fields.change ?? "none"), outcome }),
        1,
      )
      try annotateCurrentSpan({ "http.response.status_code": response.status, outcome })
      try logWithLevel(response.status >= 500 ? "Error" : response.status >= 400 ? "Warn" : "Info")(
        "branch.share",
      ).pipe(annotateLogs({ ...fields, outcome }))
      return response
    }, "branch.share", { kind: "server" })

  /** `GET /api/shapes/shares?branch=<id>`: the owner's; sessions unreadable, 503 (worker/ShapeAccess.ts). */
  const shape = ShapeProxy.make({
    ...connection,
    shape: effect {
      const request = try HttpServerRequest.HttpServerRequest
      const named = new URL(request.url, "http://localhost").searchParams.get("branch")
      const actor = try ShapeAccess.actor
      const found = named !== null && isUuid(named)
        ? try branchAccess(actor, named.toLowerCase()).pipe(
          Effect.provide(database),
          mapError(() => ShapeAccess.unavailable),
        )
        : undefined
      const branch = found?.access === "owner" ? found.branchId : NO_BRANCH
      return { table: SHARES_TABLE, where: "branch_id = $1", params: { "1": branch } }
    },
    name: "branch.shares.shape",
    metric: shapes,
  })

  return { change, shape }
}

/** A refusal with its code in the records. */
const refuse = (fields: Fields, status: number, code: string) => {
  fields.code = code
  return refusal(status, code)
}

/** What the routes need from their host beyond Postgres. */
export type Requirements = Sessions | Directory | TerminalSockets | Rooms | HttpServerRequest.HttpServerRequest
