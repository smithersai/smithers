import * as GitHubConfig from "../github/Config.ts"
import * as RepoConfig from "../RepoConfig.vibe"
import { CREATION_ROUTE } from "../../src/features/branch/creation.ts"
import * as Creation from "./Creation.vibe"
import { Effect, type Layer } from "effect"
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import type { SqlClient } from "effect/sql"
import { BRANCHES_ROUTE, PUBLICATIONS_SHAPE_ROUTE, SHARES_SHAPE_ROUTE } from "../../src/features/branch/contract.ts"
import { commandMaxSeconds } from "../../src/features/sandbox/config.ts"
import { TERMINALS_ROUTE, TERMINALS_SHAPE_ROUTE } from "../../src/features/terminal/contract.ts"
import * as Branches from "./Branches.vibe"
import * as ConversationApi from "./ConversationApi.vibe"
import * as Presence from "./Presence.vibe"
import * as Publications from "./Publications.vibe"
import * as SandboxCalls from "./SandboxCalls.vibe"
import * as Shares from "./Shares.vibe"
import * as Terminals from "./Terminals.vibe"
import * as Texts from "./Texts.vibe"

// The branch workspace's routes (decision 0013, docs/features/branch-workspace.md): tracking a branch, sharing it, its
// publication on GitHub (docs/features/branch-publish.md), a person's own list of conversations and archiving one
// (docs/features/conversations.md), its room, its terminals, its sandbox tools (docs/features/sandbox-tools.md) and
// the texts people edit together on it (docs/features/coedit.md).
// ChatApi hands them every request `handles` names; the conversation's own routes stay chat's.

/** Whether a path is one of the branch workspace's routes. */
export const handles = (path: string): boolean =>
  path === BRANCHES_ROUTE || path.startsWith(`${BRANCHES_ROUTE}/`) || path === SHARES_SHAPE_ROUTE ||
  path === PUBLICATIONS_SHAPE_ROUTE ||
  path === TERMINALS_ROUTE || path === TERMINALS_SHAPE_ROUTE || path.startsWith(`${TERMINALS_ROUTE}/`) ||
  SandboxCalls.handles(path) || Texts.handles(path) || ConversationApi.handles(path)

/** `/api/branches/<id>/<what>`: the branch's id and what of it, or `undefined` for any other path under the route. */
const branchPath = (path: string) => {
  const match = /^\/api\/branches\/([^/]+)\/(shares|room)$/.exec(path)
  return match === null ? undefined : { branchId: match[1]!, what: match[2] as "shares" | "room" }
}

/**
 * The routes over `database`, which opens a Postgres client for each request's scope. Reads `SANDBOX_COMMAND_MAX_SECONDS`
 * once, for the sandbox calls' commands. Captures the GitHub App and Code Storage client before building handlers.
 */
export const make = effect <E, R>(database: Layer.Layer<SqlClient.SqlClient, E, R>) => {
  const app = try GitHubConfig.configured
  const client = try RepoConfig.codeStorage
  const conversations = try ConversationApi.make(database)
  const terminals = try Terminals.make(database)
  const shares = try Shares.make(database)
  const publications = try Publications.make(database)
  const room = try sync(() => Presence.make(database))
  const commandSeconds = try commandMaxSeconds
  const sandboxCalls = try sync(() => SandboxCalls.make(database, commandSeconds))
  const texts = try Texts.make(database)
  const fetch = effect {
    const request = try HttpServerRequest.HttpServerRequest
    const path = request.url.split("?")[0]!
    if (try sync(() => ConversationApi.handles(path))) return try conversations.fetch
    if (path === CREATION_ROUTE) return try Creation.route(client, database)
    if (path === BRANCHES_ROUTE) return try Branches.make(database, app)
    if (try sync(() => SandboxCalls.handles(path))) return try sandboxCalls.fetch
    if (try sync(() => Texts.handles(path))) return try texts.fetch
    if (path === SHARES_SHAPE_ROUTE) return try shares.shape
    if (path === PUBLICATIONS_SHAPE_ROUTE) return try publications
    if (path === TERMINALS_ROUTE) return try terminals.open
    if (path === TERMINALS_SHAPE_ROUTE) return try terminals.shape
    if (path.startsWith(`${TERMINALS_ROUTE}/`)) return try terminals.connect(path.slice(TERMINALS_ROUTE.length + 1))
    const branch = branchPath(path)
    if (branch?.what === "shares") return try shares.change(branch.branchId)
    if (branch?.what === "room") return try room(branch.branchId)
    return HttpServerResponse.empty({ status: 404 })
  }
  return { fetch }
}
