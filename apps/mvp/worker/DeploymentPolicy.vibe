/**
 * Deployment-wide authorization policy.
 *
 * Deployment admins hold deployment authority: the global fleet, host nodes and provider accounts. They are the
 * GitHub logins `DEPLOYMENT_ADMIN_LOGINS` names. An unset, blank or unreadable value names nobody, so a fresh
 * installation grants deployment authority to no account.
 *
 * Deployment authority is separate from a repository role. A person's role on a repository is GitHub's own answer for
 * that repository, never more and never less: being a deployment admin grants no repository role, and GitHub's admins
 * and maintainers keep theirs.
 */

import type { Actor } from "./Actor.vibe"

/** Nobody: the deployment admins of an installation that names none. */
export const DEFAULT_ADMINS: ReadonlySet<string> = new Set()

export function parseAdminLogins(raw: string): ReadonlySet<string> {
  return new Set(
    raw
      .split(",")
      .map((entry) => entry.trim().toLowerCase())
      .filter((entry) => entry.length > 0)
  )
}

export effect function configuredAdmins() {
  const raw = try Config.withDefault(Config.String("DEPLOYMENT_ADMIN_LOGINS"), "")
  return parseAdminLogins(raw)
}

export function isDeploymentAdmin(
  login: string | undefined,
  admins: ReadonlySet<string> = DEFAULT_ADMINS
): boolean {
  return login !== undefined && login.trim().length > 0 && admins.has(login.trim().toLowerCase())
}

/**
 * Whether `actor` is a deployment admin acting in person. A delegated credential (a run, flow, sandbox or agent acting
 * for the person, `act` set) never carries deployment authority, whatever its person holds.
 */
export function holdsDeploymentAuthority(
  actor: Actor,
  admins: ReadonlySet<string> = DEFAULT_ADMINS
): boolean {
  return actor.act === undefined && isDeploymentAdmin(actor.login, admins)
}

export schema error DeploymentAdminRequired {
  readonly code: "forbidden"
  readonly message: string
}

export effect function requireDeploymentAdmin(
  actor: Actor,
  admins: ReadonlySet<string> = DEFAULT_ADMINS
): string!DeploymentAdminRequired {
  if (!holdsDeploymentAuthority(actor, admins) || actor.login === undefined) {
    throw new DeploymentAdminRequired({
      code: "forbidden",
      message: "Deployment admin access is restricted to a deployment admin signed in as a person.",
    })
  }
  return actor.login
}
