import { Action, Flow, Interpreter, RetryPolicy } from "@smthrs/flow"
import { GitHub } from "@smthrs/integrations"
import { Node } from "@smthrs/plan"
import { CiJob } from "@smthrs/sandbox"
import { Cause, Config, Effect, Layer, Metric, Option, Schema } from "effect"
import { HttpClient } from "effect/http"
import { SqlClient } from "effect/sql"
import { codeOf } from "../ErrorCode.vibe"
import { withToken } from "../github/Calls.vibe"
import { repositoryOf } from "../github/Config.vibe"
import type { GitHubTokens } from "../github/Tokens.ts"
import * as RepoRuns from "../RepoRuns.ts"
import * as RepoFlow from "./RepoFlow.vibe"
import * as Triggers from "./Triggers.vibe"

// GitHub's events start a repository's flows (docs/features/ci.md#triggers): the webhook route starts one
// `triggers/Dispatch` per push or pull request delivery (`triggers/dispatch:<delivery>`), and it starts each active flow whose
// trigger matches as `repo/Run` under `<flow>:<delivery>`.
//
//   triggers/Match   the default branch's `.smithers/factory.json` as the App: its trigger rows that match the event,
//                    each kept only if its flow's flow.ts is on the default branch (active: merged by a person)
//   triggers/Start   `repo/Run` for each, at the event's commit, without secrets for a fork's pull request or a
//                    pull request from someone below Member
//
// Triggers come from the default branch, never the pushed commit or a pull request's head, so a change can't add a
// trigger to itself. A delivery GitHub sends again starts the same executions, which changes nothing.

/** One push or pull request delivery, as the webhook names it. */
export const DispatchRequest = Schema.Struct({
  delivery: Schema.String.check(Schema.isPattern(/^[A-Za-z0-9-]{1,128}$/)),
  repo: CiJob.Target.fields.repo,
  defaultBranch: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(255)),
  event: Schema.Literals(["push", "pull_request"]),
  /** The ref the commit is at: `refs/heads/<branch>`, `refs/tags/<tag>`, or `refs/pull/<n>/head`. */
  ref: CiJob.Target.fields.ref,
  /** Push: the branch pushed to, or null for a tag; pull request: its base branch. */
  branch: Schema.NullOr(Schema.String),
  tag: Schema.NullOr(Schema.String),
  /** Pull request: its action. */
  action: Schema.NullOr(Schema.String),
  sha: CiJob.Target.fields.sha,
  /** Whether the runs may have the repository's secrets: not a fork's pull request, nor one from below Member. */
  trusted: Schema.Boolean,
})
export type DispatchRequest = typeof DispatchRequest.Type

/**
 * `REPO_FLOWS`: whether GitHub's pushes and pull requests start repositories' flows. Off unless set to `true`: each run
 * starts machines only for repositories in `REPO_FLOWS_REPOSITORIES`.
 */
export const enabled = Config.Boolean("REPO_FLOWS").pipe(Config.withDefault(false))

/** Comma-separated owner/name allowlist; unset or blank allows no repositories. */
export const repositories = Config.String("REPO_FLOWS_REPOSITORIES").pipe(
  Config.withDefault(""),
  Config.map((value) =>
    new Set(
      value.split(",").map((name) => name.trim().toLowerCase()).filter((name) =>
        /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(name)
      ),
    )
  ),
)

/** The association GitHub gives a pull request's author who is Member or above: their head may have secrets. */
export const TRUSTED_ASSOCIATIONS: ReadonlyArray<string> = ["OWNER", "MEMBER", "COLLABORATOR"]

schema Repository { full_name: string; default_branch: string }
schema PushEvent {
  ref: string
  after: string
  deleted?: boolean
  repository: Repository
}
const PullRequestEvent = Schema.Struct({
  action: Schema.String,
  pull_request: Schema.Struct({
    number: Schema.Int,
    author_association: Schema.optional(Schema.String),
    head: Schema.Struct({ sha: Schema.String, repo: Schema.NullOr(Schema.Struct({ full_name: Schema.String })) }),
    base: Schema.Struct({ ref: Schema.String }),
  }),
  repository: Repository,
})
const decodePush = Schema.decodeUnknownOption(PushEvent)
const decodePullRequest = Schema.decodeUnknownOption(PullRequestEvent)
const decodeRequest = Schema.decodeUnknownOption(DispatchRequest)

/**
 * The dispatch a delivery of `event` asks for: a push (not a deleted ref) or a pull request, of any repository the App
 * is installed on; `None` for any other delivery. It names the event; the commit's files are read from GitHub.
 */
export const requestOf = (event: string, delivery: string, payload: unknown): Option.Option<DispatchRequest> => {
  if (event === "push") {
    return Option.flatMap(decodePush(payload), (push) =>
      push.deleted === true ? Option.none() : decodeRequest({
        delivery,
        repo: push.repository.full_name,
        defaultBranch: push.repository.default_branch,
        event: "push",
        ref: push.ref,
        branch: push.ref.startsWith("refs/heads/") ? push.ref.slice("refs/heads/".length) : null,
        tag: push.ref.startsWith("refs/tags/") ? push.ref.slice("refs/tags/".length) : null,
        action: null,
        sha: push.after,
        // Pushing needs write access to the repository.
        trusted: true,
      }))
  }
  if (event === "pull_request") {
    return Option.flatMap(decodePullRequest(payload), (pull) =>
      decodeRequest({
        delivery,
        repo: pull.repository.full_name,
        defaultBranch: pull.repository.default_branch,
        event: "pull_request",
        ref: `refs/pull/${pull.pull_request.number}/head`,
        branch: pull.pull_request.base.ref,
        tag: null,
        action: pull.action,
        sha: pull.pull_request.head.sha,
        trusted: pull.pull_request.head.repo?.full_name === pull.repository.full_name
          && TRUSTED_ASSOCIATIONS.includes(pull.pull_request.author_association ?? ""),
      }))
  }
  return Option.none()
}

/**
 * A dispatch's execution id: one per delivery. Its slash keeps it apart from every run's `<flow>:<delivery>`, since a
 * flow's name has none (a flow may be named `triggers`).
 */
export const dispatchExecutionId = (delivery: string): string => `triggers/dispatch:${delivery}`

/** A repository flow's run's execution id: one per flow and delivery. */
export const runExecutionId = (flow: string, delivery: string): string => `${flow}:${delivery}`

/** GitHub, Postgres or the engine couldn't answer: retried. */
export class DispatchUnavailable extends Schema.TaggedError<DispatchUnavailable>()(
  "@smthrs/mvp/ci/DispatchUnavailable",
  {},
) {}

/** 1 s doubling to a minute, for at most 30 minutes. */
export const RETRY = RetryPolicy.make({ initialMs: 1_000, factor: 2, maxMs: 60_000, expirationMs: 30 * 60_000 })

/** What `triggers/Match` found: the flows to start, and why there are none when there are none. */
export schema Matched {
  flows: ReadonlyArray<string>
  outcome: "matched" | "none" | "no_manifest" | "unreadable" | "not_allowed"
}

export const Match = Action.make("triggers/Match", {
  payload: { request: DispatchRequest },
  success: Matched,
  error: DispatchUnavailable,
  retryPolicy: RETRY,
})

export const Start = Action.make("triggers/Start", {
  payload: { request: DispatchRequest, flows: Schema.Array(Schema.String) },
  success: Schema.Array(Schema.String),
  error: DispatchUnavailable,
  retryPolicy: RETRY,
})

/** `triggers/Dispatch`: one delivery's matching flows, started. */
export const Dispatch = Flow.make("triggers/Dispatch", {
  description: "Start each of a repository's active flows whose trigger on its default branch matches a GitHub push "
    + "or pull request.",
  modelInvocable: false,
  payload: DispatchRequest,
  success: Schema.Array(Schema.String),
  error: DispatchUnavailable,
  body: Node.capture(
    { match: Match.name, start: Start.name },
    (request: DispatchRequest) =>
      Match.call({ request }).pipe(
        Node.bindPlanned(Node.capture(
          { start: Start.name, request },
          function(this: { readonly request: DispatchRequest }, matched) {
            return Start.call({ request: this.request, flows: matched.flows })
          },
        )),
      ),
  ),
})

/** Deliveries dispatched, by `event` and `outcome` (`matched`, `none`, `no_manifest`, `unreadable`, `not_allowed`). */
export const dispatches = Metric.counter("smithers_ci_dispatches", {
  description:
    "GitHub push and pull request deliveries matched against repository flows' triggers, by event and outcome",
  incremental: true,
})

/** Repository flow runs started by triggers, by `outcome` (`started`, `not_started`). */
export const starts = Metric.counter("smithers_ci_starts", {
  description: "Repository flow runs triggers started, by outcome",
  incremental: true,
})

/** What dispatching needs: Postgres (the App's installations), GitHub as the App, and where a run starts. */
export interface Services<E, R> {
  readonly repositories: ReadonlySet<string>
  readonly database: Layer.Layer<SqlClient.SqlClient, E, R>
  readonly tokens: GitHubTokens
  readonly http: HttpClient.HttpClient
  readonly apiBaseUrl: string
  /** Records a start on its own execution; the same start again changes nothing. */
  readonly start: (flow: Flow.Any, options: { readonly executionId: string; readonly payload: unknown }) => void!unknown
}

/** The steps over `services`. */
export const steps = <E, R>(services: Services<E, R>) => {
  const match = ({ request }: typeof Match.payloadSchema.Type) =>
    (effect {
      if (!services.repositories.has(request.repo.toLowerCase())) {
        return { flows: [], outcome: "not_allowed" } satisfies Matched
      }
      const repository = repositoryOf(request.repo)
      const token = try (services.tokens.forInstallation(repository, "contents") |> Effect.result(%))
      if (token._tag === "Failure") {
        if (token.failure.reason === "unavailable" || token.failure.reason === "refreshing") {
          throw new DispatchUnavailable()
        }
        return { flows: [], outcome: "unreadable" } satisfies Matched
      }
      // Read as the App at the default branch: what a person merged, never the event's commit.
      const read = (path: string) =>
        GitHub.Contents.getText(repository.owner, repository.name, path, { ref: request.defaultBranch })
        |> withToken(token.success, services.apiBaseUrl)(%)
        |> Effect.provideService(%, HttpClient.HttpClient, services.http)
        |> Effect.map(%, Option.map((file) => file.text))
        // A file no retry will read is read as absent: an unreadable manifest starts nothing, an unreadable flow isn't
        // active, and the rest still start.
        |> Effect.catch(%, (error) =>
          RepoFlow.isUnreadable(error) ? Effect.succeed(Option.none<string>()) : Effect.fail(new DispatchUnavailable()))
      const manifest = try read(Triggers.MANIFEST_PATH)
      if (Option.isNone(manifest)) {
        return { flows: [], outcome: "no_manifest" } satisfies Matched
      }
      const wanted = Triggers.flowsFor(Triggers.triggersOf(manifest.value), request)
      const active: Array<string> = []
      for (const flow of wanted) {
        if (Option.isSome(try read(RepoFlow.flowPath(flow)))) {
          active.push(flow)
        }
      }
      return { flows: active, outcome: active.length > 0 ? "matched" : "none" } satisfies Matched
    })
    |> Effect.provide(%, services.database)
    |> Effect.mapError(%, () =>
      new DispatchUnavailable())
    |> Effect.tap(%, (matched) =>
      Effect.andThen(
        Metric.update(Metric.withAttributes(dispatches, { event: request.event, outcome: matched.outcome }), 1),
        Effect.logInfo("ci.dispatch") |> Effect.annotateLogs({
          delivery: request.delivery,
          repo: request.repo,
          event: request.event,
          sha: request.sha,
          outcome: matched.outcome,
          flows: matched.flows.join(","),
        })(%),
      ))
    |> withSpan(%, "ci.dispatch.match", { attributes: { "smithers.ci.delivery": request.delivery } })

  const start = ({ flows, request }: typeof Start.payloadSchema.Type) =>
    (effect {
      if (!services.repositories.has(request.repo.toLowerCase())) {
        try Metric.update(Metric.withAttributes(starts, { outcome: "not_allowed" }), 1)
        try (Effect.logInfo("ci.start") |> Effect.annotateLogs({ repo: request.repo, outcome: "not_allowed" })(%))
        return []
      }
      return try Effect.forEach(flows, (flow) => {
        const executionId = runExecutionId(flow, request.delivery)
        const payload: RepoFlow.RunRequest = {
          run: executionId,
          repo: request.repo,
          flow,
          sha: request.sha,
          ref: request.ref,
          event: request.event,
          secrets: request.trusted,
        }
        const record = (outcome: "started" | "not_started", errorCode?: string) =>
          Effect.andThen(
            Metric.update(Metric.withAttributes(starts, { outcome }), 1),
            Effect.logWithLevel(outcome === "started" ? "Info" : "Warn")("ci.start") |> Effect.annotateLogs({
              delivery: request.delivery,
              repo: request.repo,
              flow,
              executionId,
              outcome,
              ...(errorCode === undefined ? {} : { errorCode }),
            })(%),
          )
        return Effect.flatMap(SqlClient.SqlClient, (sql) =>
          sql.withTransaction(
            RepoRuns.record({
              execution: executionId,
              repoId: `github/${request.repo.toLowerCase()}`,
              flow,
              sha: request.sha,
              ref: request.ref,
              event: request.event,
              launchedBy: "github",
            })
              |> Effect.andThen(%, services.start(RepoFlow.Run, { executionId, payload })),
          ))
          |> Effect.provide(%, services.database)
          |> Effect.tap(%, () => record("started"))
          |> Effect.catchCause(%, (cause) =>
            record("not_started", codeOf(Cause.squash(cause)))
            |> Effect.andThen(%, Effect.fail(new DispatchUnavailable())))
          |> Effect.as(%, executionId)
      })
    }) |> Effect.mapError(%, () => new DispatchUnavailable())
    |> withSpan(%, "ci.dispatch.start", { attributes: { "smithers.ci.delivery": request.delivery } })

  return { match, start }
}

/** Registers `triggers/Dispatch` over `services`. */
export const registration = <E, R>(services: Services<E, R>) => {
  const implementation = steps(services)
  return Interpreter.layerWithImplementations(
    Dispatch,
    Layer.mergeAll(Match.toLayer(implementation.match), Start.toLayer(implementation.start)),
  ).pipe(Layer.provideMerge(Action.layerImplementations))
}
