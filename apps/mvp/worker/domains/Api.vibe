import { ShapeProxy } from "@smthrs/effect-electric"
import { Cause, Clock, Effect, type Layer, Metric, Option, Schema } from "effect"
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import type { SqlClient } from "effect/sql"
import { LOCAL_ELECTRIC_URL } from "../../src/features/chat/contract.ts"
import {
  DOMAINS_SHAPE_COLUMNS,
  DOMAIN_RESOLVE_ROUTE,
  DOMAINS_SHAPE_ROUTE,
  DOMAINS_TABLE,
  isUnder,
  MAX_DOMAIN_BODY_BYTES,
  normalizeHostname,
  parseDomainRoute,
  type Refusal,
  writeExecutionId,
} from "../../src/features/domains/contract.ts"
import { repoId } from "../../src/features/repo/contract.ts"
import { type Actor, refusesPersonOnly, Sessions } from "../Actor.vibe"
import { readBounded } from "../Body.vibe"
import { codeOf } from "../ErrorCode.ts"
import * as Flows from "../Flows.vibe"
import * as ShapeAccess from "../ShapeAccess.vibe"
import * as WriteAuthority from "../WriteAuthority.vibe"
import * as DomainFlows from "./DomainFlows.vibe"
import { DomainProvider } from "./Provider.vibe"
import * as Store from "./Store.vibe"
import { randomExecutionKey } from "./ExecutionKey.ts"

// The custom-domain routes (decision 0039, docs/features/domains.md#routes). Every one is a Maintainer's or an Admin's,
// acting in person, on the repository sign-in reads roles on (`GITHUB_REPOSITORY`, since a session carries one role):
//
// - `POST /api/repos/<owner>/<name>/domains { hostname }`: adds a domain, or refreshes one the repository holds, by
//   starting `domain/Verify`. A hostname another repository holds is `taken`; the deployment's own zone is `reserved`.
// - `DELETE /api/repos/<owner>/<name>/domains/<hostname>`: removes one through `domain/Remove`.
// - `GET /api/shapes/domains?repo=<repo id>`: the repository's domains, to a Maintainer or Admin in person; anyone else
//   gets a shape with no rows, so a visitor never learns a domain is being set up.

/** Domain route requests, by `op` (`add`, `remove`) and `outcome`. */
export const requests = Metric.counter("smithers_domain_requests", {
  description: "Requests to the custom-domain routes, by op and outcome",
  incremental: true,
})

/** `GET /api/shapes/domains` requests, by `status` and `live`. */
export const shapes = Metric.counter("smithers_domain_shape_requests", {
  description: "GET /api/shapes/domains requests, by status and live",
  incremental: true,
})

/** `GET /api/domains/resolve` requests, by `outcome` (`found`, `not_found`, `invalid`, `method`, `unavailable`). */
export const resolves = Metric.counter("smithers_domain_resolves", {
  description: "GET /api/domains/resolve requests, by outcome",
  incremental: true,
})

/** Whether a path is one of the domain routes. */
export const handles = (path: string): boolean => path === DOMAINS_SHAPE_ROUTE || path === DOMAIN_RESOLVE_ROUTE || parseDomainRoute(path) !== undefined

/** Whether `actor` may see and change domains: a Maintainer or Admin acting in person (0007 `repo:domain-write`). */
export const mayManage = (actor: Actor): boolean =>
  actor.act === undefined && (actor.role === "maintainer" || actor.role === "admin")

const AddBody = Schema.Struct({ hostname: Schema.String })
const decodeAdd = Schema.decodeUnknownEffect(Schema.fromJsonString(AddBody))

/** What a shape filters on for someone who may not read domains: no repository, so it holds no rows. */
const NO_REPO = ""

const noStore = { "cache-control": "no-store" }

type Fields = Record<string, string | number | boolean>

/**
 * The domain routes for `repository`, the one sign-in reads roles on: any other repository's are `not_found`. They read
 * who holds a hostname through `database`, the provider from `DomainProvider`, who is asking from `Sessions`, and start
 * the flows through `Flows.FlowStarter`.
 */
export const make = <E, R>(repository: { readonly id: string }, database: Layer.Layer<SqlClient.SqlClient, E, R>) =>
  effect {
    const connection = try ShapeProxy.config({ url: LOCAL_ELECTRIC_URL })

    /** `GET /api/shapes/domains?repo=<repo id>`. */
    const shape = ShapeProxy.make({
      ...connection,
      shape: effect {
        const request = try HttpServerRequest.HttpServerRequest
        const named = new URL(request.url, "http://localhost").searchParams.get("repo") ?? NO_REPO
        const actor = try ShapeAccess.actor
        const repo = Option.isSome(actor) && mayManage(actor.value) && named.toLowerCase() === repository.id
          ? repository.id
          : NO_REPO
        return { table: DOMAINS_TABLE, where: "repo_id = $1", params: { "1": repo }, columns: [...DOMAINS_SHAPE_COLUMNS] }
      },
      name: "domain.shape",
      metric: shapes,
    })

    /** `POST` and `DELETE`. */
    const write = effect {
      const request = try HttpServerRequest.HttpServerRequest
      const startedAt = try Clock.currentTimeMillis
      const route = (try Effect.sync(() => parseDomainRoute(request.url.split("?")[0]!)))!
      const op = request.method === "DELETE" ? "remove" : "add"
      const fields: Fields = { op }
      const refuse = (status: number, code: Refusal) => {
        fields.code = code
        return HttpServerResponse.jsonUnsafe({ code }, { status, headers: noStore })
      }
      const response = try Effect.catchCause(effect {
        const allowed = route.hostname === undefined ? "POST" : "DELETE"
        if (request.method !== allowed) return HttpServerResponse.empty({ status: 405, headers: { allow: allowed } })
        const sessions = try Sessions
        const actor = try sessions.resolve
        if (Option.isNone(actor)) return refuse(401, "authentication")
        // A domain points the world at the repository: anyone acting for the person is refused (decision 0017).
        if (try refusesPersonOnly(actor.value, op === "add" ? "domain/add" : "domain/remove")) {
          return refuse(403, "person_only")
        }
        if (!mayManage(actor.value)) return refuse(403, "forbidden")
        // Only a Maintainer learns whether custom domains are configured.
        const provider = try DomainProvider
        if (Option.isNone(provider)) return refuse(503, "off")
        const repo = try Effect.sync(() => repoId(route.owner, route.name))
        if (repo !== repository.id) return refuse(404, "not_found")
        fields.repoId = repo
        const starter = try Flows.FlowStarter
        const key = try randomExecutionKey
        const executionId = try Effect.sync(() => writeExecutionId(op, key))
        if (route.hostname !== undefined) {
          const rawHostname = route.hostname
          const hostname = try Effect.sync(() => normalizeHostname(rawHostname))
          if (hostname === undefined) return refuse(400, "invalid_hostname")
          const row = try Store.read(hostname).pipe(Effect.provide(database))
          const pollId = Option.isSome(row) && row.value.repoId === repo ? row.value.pollId : null
          const authority = try Effect.sync(() => WriteAuthority.protectedOf(actor.value))
          const started = try starter.start(DomainFlows.Remove, {
            executionId,
            // The flow asks again before it touches the provider or the row (DomainFlows.vibe).
            payload: { authority, repoId: repo, hostname, actorId: actor.value.subject.id, pollId },
          }).pipe(Effect.result)
          if (started._tag === "Failure") return refuse(503, "unavailable")
          fields.outcome = "removing"
          return HttpServerResponse.jsonUnsafe({ hostname }, { status: 202, headers: noStore })
        }
        const body = try readBounded(request, MAX_DOMAIN_BODY_BYTES).pipe(Effect.result)
        if (body._tag === "Failure") {
          return body.failure.reason === "too_large" ? refuse(413, "too_large") : refuse(400, "invalid")
        }
        const decoded = try decodeAdd(body.success).pipe(Effect.option)
        if (Option.isNone(decoded)) return refuse(400, "invalid")
        const hostname = try Effect.sync(() => normalizeHostname(decoded.value.hostname))
        if (hostname === undefined) return refuse(400, "invalid_hostname")
        const ownHost = new URL(request.originalUrl, "http://localhost").hostname
        if ((try Effect.sync(() => isUnder(hostname, provider.value.zone))) || hostname === ownHost) return refuse(400, "reserved")
        const holder = try Store.holder(hostname).pipe(Effect.provide(database))
        if (Option.isSome(holder) && holder.value !== repo) return refuse(409, "taken")
        const authority = try Effect.sync(() => WriteAuthority.protectedOf(actor.value))
        const started = try starter.start(DomainFlows.Verify, {
          executionId,
          payload: {
            authority,
            repoId: repo,
            hostname,
            actorId: actor.value.subject.id,
            pollId: executionId,
            refresh: Option.isSome(holder),
          },
        }).pipe(Effect.result)
        if (started._tag === "Failure") return refuse(503, "unavailable")
        fields.outcome = Option.isSome(holder) ? "refreshing" : "adding"
        return HttpServerResponse.jsonUnsafe({ hostname }, { status: 202, headers: noStore })
      }, (cause) =>
        Effect.sync(() => {
          fields.errorCode = codeOf(Cause.squash(cause))
          return refuse(503, "unavailable")
        })
      )
      fields.status = response.status
      fields.durationMs = (try Clock.currentTimeMillis) - startedAt
      const outcome = String(fields.outcome ?? fields.code ?? "refused")
      try Metric.update(Metric.withAttributes(requests, { op, outcome }), 1)
      try Effect.annotateCurrentSpan({ "http.response.status_code": response.status, outcome })
      try Effect.logWithLevel(response.status >= 500 ? "Error" : response.status >= 400 ? "Warn" : "Info")(
        "domain.request",
      ).pipe(Effect.annotateLogs({ ...fields, outcome }))
      return response
    }.pipe(Effect.withSpan("domain.request", { kind: "server" }))

    /**
     * `GET /api/domains/resolve?host=<hostname>`: resolves an active custom domain to its repository path. Every answer
     * is one `domain.resolve` span, log line and `smithers_domain_resolves` count by outcome. They carry the repository
     * of a hit and codes, never the hostname asked for: a pending domain is its Maintainer's until it is published.
     */
    const resolve = effect {
      const request = try HttpServerRequest.HttpServerRequest
      const startedAt = try Clock.currentTimeMillis
      const fields: Fields = {}
      const refuse = (status: number, outcome: "method" | "invalid" | "unavailable" | "not_found") => {
        fields.outcome = outcome
        return HttpServerResponse.empty({ status, headers: noStore })
      }
      const response = try effect {
        if (request.method !== "GET") return refuse(405, "method")
        const raw = new URL(request.url, "http://localhost").searchParams.get("host")
        const hostname = raw === null ? undefined : try Effect.sync(() => normalizeHostname(raw))
        if (hostname === undefined) return refuse(400, "invalid")
        const row = try Store.read(hostname).pipe(
          Effect.provide(database),
          Effect.map((found) => ({ ok: true as const, found })),
          Effect.catchCause((cause) =>
            Effect.sync(() => {
              fields.errorCode = codeOf(Cause.squash(cause))
              return { ok: false as const }
            })
          ),
        )
        if (!row.ok) return refuse(503, "unavailable")
        if (
          Option.isNone(row.found) || row.found.value.state !== "active" || !row.found.value.repoId.startsWith("github/")
        ) return refuse(404, "not_found")
        fields.outcome = "found"
        fields.repoId = row.found.value.repoId
        return HttpServerResponse.jsonUnsafe(
          { path: `/${row.found.value.repoId.slice("github/".length)}` },
          { status: 200, headers: { "cache-control": "public, max-age=60" } },
        )
      }
      const outcome = String(fields.outcome)
      fields.status = response.status
      fields.durationMs = (try Clock.currentTimeMillis) - startedAt
      try Metric.update(Metric.withAttributes(resolves, { outcome }), 1)
      try Effect.annotateCurrentSpan({ "http.response.status_code": response.status, outcome })
      // A miss or a malformed host is the caller's ordinary answer; only a database failure is the route's fault.
      try Effect.logWithLevel(response.status >= 500 ? "Error" : "Info")("domain.resolve").pipe(
        Effect.annotateLogs(fields),
      )
      return response
    }.pipe(Effect.withSpan("domain.resolve", { kind: "server" }))

    const fetch = effect {
      const request = try HttpServerRequest.HttpServerRequest
      const path = request.url.split("?")[0]
      if (path === DOMAINS_SHAPE_ROUTE) return try shape
      if (path === DOMAIN_RESOLVE_ROUTE) return try resolve
      return try write
    }

    return { fetch }
  }
