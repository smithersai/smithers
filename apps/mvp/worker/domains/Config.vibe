import type { HttpClient } from "effect/http"
import * as Cloudflare from "./Cloudflare.ts"
import * as Dns from "./Dns.ts"
import { DomainProvider, type Provider } from "./Provider.vibe"

// The deployment's domain provider, from its environment (decision 0039 §3, docs/features/domains.md#configuration):
//
// | DOMAINS_PROVIDER | Needs                                              | Optional                                  |
// |------------------|----------------------------------------------------|-------------------------------------------|
// | `cloudflare`     | DOMAINS_ZONE, DOMAINS_ZONE_ID, DOMAINS_API_TOKEN    | DOMAINS_CNAME_TARGET (`domains.<zone>`)    |
// | `dns`            | DOMAINS_ZONE (`localhost` under `alchemy dev`)       | DOMAINS_CNAME_TARGET, DOMAINS_DOH_URL       |
// | unset            | off; `dns` under `alchemy dev`                      |                                           |
//
// A provider missing what it needs is off, logged as `domains.off` with the reason. The token is a Worker secret,
// read by name and never logged.

/** The zone the `dns` provider reserves under `alchemy dev` when DOMAINS_ZONE is unset. */
export const DEV_ZONE = "localhost"

const off = (reason: string) =>
  Effect.as(Effect.logWarning("domains.off") |> Effect.annotateLogs({ reason })(%), Option.none<Provider>())

/** The provider `DOMAINS_PROVIDER` names, over the `HttpClient` in context; with `dev`, `dns` when it names none. */
export const provider = (
  options: { readonly dev?: boolean } = {},
): Option.Option<Provider>!Config.ConfigError!HttpClient.HttpClient =>
  effect {
    const name = try Config.option(Config.Literals(["cloudflare", "dns"], "DOMAINS_PROVIDER"))
    const chosen = Option.isSome(name) ? name.value : options.dev === true ? "dns" : undefined
    if (chosen === undefined) return Option.none<Provider>()
    const zone = try Config.option(Config.NonEmptyString("DOMAINS_ZONE"))
    const zoneName = Option.isSome(zone) ? zone.value : chosen === "dns" && options.dev === true ? DEV_ZONE : undefined
    if (zoneName === undefined) return try off("no_zone")
    const target = try Config.NonEmptyString("DOMAINS_CNAME_TARGET").pipe(Config.withDefault(`domains.${zoneName}`))
    if (chosen === "dns") {
      const dohUrl = try Config.option(Config.NonEmptyString("DOMAINS_DOH_URL"))
      return Option.some<Provider>(
        try Dns.make({ zone: zoneName, target, ...(Option.isSome(dohUrl) ? { dohUrl: dohUrl.value } : {}) }),
      )
    }
    const zoneId = try Config.option(Config.NonEmptyString("DOMAINS_ZONE_ID"))
    const token = try Config.option(Config.Redacted("DOMAINS_API_TOKEN"))
    if (Option.isNone(zoneId)) return try off("no_zone_id")
    if (Option.isNone(token)) return try off("no_token")
    return Option.some<Provider>(
      try Cloudflare.make({ zoneId: zoneId.value, zone: zoneName, target, token: token.value }),
    )
  }

/** `provider` as the `DomainProvider` layer. */
export const layer = (
  options: { readonly dev?: boolean } = {},
): Layer.Layer<DomainProvider, Config.ConfigError, HttpClient.HttpClient> =>
  Layer.effect(DomainProvider, provider(options))
