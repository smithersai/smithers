{
  // NodeServeAndAttach.test.ts runs in Node and imports @smthrs/cli's Node source, so it typechecks with Node's
  // types rather than worker/tsconfig.json's workers-types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["NodeServeAndAttach.test.ts"]
}
