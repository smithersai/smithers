import { digestSync } from "@smthrs/crypto"
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import { Sessions } from "../Actor.ts"
import * as Artifacts from "../branch/Artifacts.vibe"
import { repositoryOf } from "../github/Config.vibe"
import type { RepoRoles } from "../github/RepoRoles.ts"
import type { Admitted } from "../RepoRuns.ts"
import * as Visibility from "./ArtifactVisibility.ts"

const route = /^\/api\/repos\/([^/]+)\/([^/]+)\/artifacts\/([^/]+)\/([^/]+)$/
export const handles = (path: string): boolean => route.test(path)

const missing = HttpServerResponse.jsonUnsafe(Visibility.NOT_FOUND.body, {
  status: Visibility.NOT_FOUND.status,
  headers: { "cache-control": "private, no-store" },
})
const reads = Metric.counter("smithers_repo_artifact_reads", { incremental: true })

/** Read a run's stored bytes after authorizing its repository and verifying the run's recorded association. */
export const read = <R, E2, R2, R3>(
  roles: RepoRoles<R>,
  policy: Visibility.Policy,
  runOf: (id: string) => (Admitted | null)!E2!R2,
  get: (key: string) => Option.Option<Artifacts.Stored>!Artifacts.StoreFailed!R3,
) => withSpan(effect {
  const response = try catchCause(effect {
    const request = try HttpServerRequest.HttpServerRequest
    const location = try Effect.try(() => {
      const url = new URL(request.url, "https://artifacts.internal")
      const matched = route.exec(url.pathname)
      if (request.method !== "GET" || matched === null) return undefined
      const fullName = Visibility.canonicalRepositoryId(`${matched[1]}/${matched[2]}`)
      const name = matched[4]!
      if (fullName === undefined || !Artifacts.NAME.test(name)) return undefined
      const execution = decodeURIComponent(matched[3]!)
      if (!/^[A-Za-z0-9_-][A-Za-z0-9_:-]{0,255}$/.test(execution)) return undefined
      return { fullName, name, execution }
    })
    if (location === undefined) return missing
    const { fullName, name, execution } = location
    const repository = { fullName, private: true }
    const sessions = try Sessions
    const actor = Option.getOrUndefined(try sessions.resolve)
    if (actor === undefined) return missing
    const { target, ops } = try Effect.try(() => ({
      target: repositoryOf(fullName),
      ops: Visibility.isOpsRepository(repository, policy),
    }))
    const role = ops ? null : (try roles.resolve(actor, target)).role
    const canRead = try Effect.try(() => Visibility.canRead(
      actor,
      { repository, path: name, title: name, size: 0, owner: "ci" },
      policy,
      { repoId: fullName, role },
    ))
    if (!canRead) return missing
    const run = try runOf(execution)
    if (run?.repoId !== target.id || run.execution !== execution) return missing
    const key = try Effect.try(() => Artifacts.keyOf(digestSync(`run:${execution}`).slice(0, 40), name))
    const artifact = try get(key)
    if (Option.isNone(artifact)) return missing
    return HttpServerResponse.raw(artifact.value.body, {
      contentType: "application/octet-stream",
      contentLength: artifact.value.bytes,
      headers: { "cache-control": "private, no-store", "x-content-type-options": "nosniff" },
    })
  }, () => succeed(missing))
  try Metric.update(Metric.withAttributes(reads, { status: String(response.status) }), 1)
  return response
}, "artifact.read")
