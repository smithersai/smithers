import * as Cloudflare from "@alchemy.run/cloudflare"
import { SqlClient } from "effect/sql"
import * as Database from "../db/Database.ts"
import { type Actor, canAsk } from "./Actor.ts"
import { branchAccess, BranchRoles, canEdit, canView } from "./branch/Access.vibe"
import * as Conversations from "./branch/Conversations.vibe"
import { scopeAccess } from "./branch/Texts.vibe"
import * as GitHubConfig from "./github/Config.vibe"
import * as RepoRoles from "./github/RepoRoles.vibe"
import * as SessionStore from "./SessionStore.ts"
import { type Admission, type Checked, configuredRoleFreshMs, LEASE_MS, roleFresh } from "./SocketAccess.ts"
import { mayRead } from "./stack/Access.vibe"

// The rules a socket host renews a lease by (worker/SocketAccess.ts): the same ones its route admitted it with.
// `checker` builds them inside a Durable Object, over the Hyperdrive config ChatApi binds and the deployment's own
// GitHub settings, as ChatApi builds its `RepoRoles`, which read through the renewal's one Postgres client.

/**
 * `admission`'s verdict now, by the rules its route admitted it with: its session, and the alias it came through, live
 * and theirs, its role confirmed by GitHub within `roleFreshMs` (a failed check confirms nothing), then the basis.
 * `roles` is the `RepoRoles` the route asked. Anything that fails is `unverified`.
 */
export const verdict = <R>(roles: RepoRoles.RepoRoles<R>, admission: Admission, roleFreshMs: number) =>
  effect {
    const now = try Clock.currentTimeMillis
    // A kept lease's window starts when this check started, on this Worker's clock, and runs `LEASE_MS`, never past
    // what the database said was left of the session then (decision 0151 rule 9).
    let until = now + LEASE_MS
    let expiresAt: number | null = null
    let serverExpiresAt: number | undefined
    let capped = false
    let role = admission.role
    if (admission.session !== null) {
      const live = try SessionStore.authority(admission.session, admission.alias, admission.cookieKey ?? "legacy")
      if (Option.isNone(live) || live.value.personId !== admission.principal) return "session" as const
      // A role GitHub hasn't confirmed lately renews nothing; the page's reconnect through the route starts its check.
      // Both times are the database's: a Worker clock skewed from it neither stretches nor cuts the freshness.
      if (!(try sync(() => roleFresh(live.value.roleVerifiedAt, live.value.serverNow, roleFreshMs)))) return "unverified" as const
      role = live.value.role
      const left = live.value.expiresAt - live.value.serverNow
      serverExpiresAt = live.value.expiresAt
      expiresAt = now + left
      until = now + Math.min(LEASE_MS, left)
      capped = left <= LEASE_MS
    }
    const actor: Actor = {
      subject: { kind: "person", id: admission.principal },
      role,
      ...(admission.session === null ? {} : { session: admission.session }),
      ...(admission.alias === null ? {} : { alias: admission.alias }),
      ...(admission.cookieKey === undefined ? {} : { cookieKey: admission.cookieKey })
    }
    const basis = admission.basis
    switch (basis.kind) {
      case "run": {
        // As the route: a refusal that says the deployment can't act there is no; GitHub or Postgres down is unknown.
        const repository = try sync(() => GitHubConfig.repositoryOf(basis.repoId.replace(/^github\//, "")))
        const resolved = map(roles.resolve(actor, repository), (resolved) => Option.some(resolved.role))
          catch (error) =>
            RepoRoles.REFUSALS[error.code] === 503 || error.code === "rate_limited"
              ? Option.none<null>()
              : Option.some(null)
        if (Option.isNone(resolved)) return "unverified" as const
        return (try sync(() => mayRead(Option.some({ ...actor, role: resolved.value }))))
          ? ({ verdict: "keep", until, capped, expiresAt, serverExpiresAt } as const)
          : "revoked" as const
      }
      case "branch":
      case "terminal": {
        const branch = try branchAccess(Option.some(actor), basis.branchId)
        if (branch === undefined || !(try sync(() => canView(branch.access)))) return "revoked" as const
        if (basis.kind === "branch") {
          return branch.access === admission.access
            ? ({ verdict: "keep", until, capped, expiresAt, serverExpiresAt } as const)
            : "changed" as const
        }
        if (!(try sync(() => canAsk(actor)))) return "revoked" as const
        return ((try sync(() => canEdit(branch.access))) ? "write" : "read") === admission.access
          ? ({ verdict: "keep", until, capped, expiresAt, serverExpiresAt } as const)
          : "changed" as const
      }
      case "text": {
        const scoped = try scopeAccess(Option.some(actor), { run: basis.run })
        if (scoped === undefined || !(try sync(() => canView(scoped.access)))) return "revoked" as const
        return scoped.access === admission.access
          ? ({ verdict: "keep", until, capped, expiresAt, serverExpiresAt } as const)
          : "changed" as const
      }
    }
  } |> catchCause(%, () => succeed<Checked>("unverified")) |> withSpan(%, "socket.verdict")

/** Local development's roles, as ChatApi's `RepoRoles` takes them (worker/ChatApiProgram.ts). */
export interface Options {
  /** Whether local development's people sign in without the App (`ProgramOptions.fallback`). */
  readonly local?: boolean
  readonly localRoles?: RepoRoles.LocalRoles
}

/**
 * Inside a Durable Object: `check`, an admission's verdict now, and `within`, which runs one renewal with one Postgres
 * client, the one `RepoRoles` reads through too.
 */
export const checker = effect <E, R>(
  connection: Cloudflare.Hyperdrive.Connection!E!R,
  options: Options = {}
) => {
  const hyperdrive = try Cloudflare.Hyperdrive.Connect(connection)
  const database = Database.layer(hyperdrive.connectionString)
  const repository = try orDie(GitHubConfig.repository)
  const app = try orDie(GitHubConfig.configured)
  const allowed = try orDie(RepoRoles.allowed)
  const home = try orDie(Conversations.configuredHomeRepositoryNames)
  const roleFreshMs = try orDie(configuredRoleFreshMs)
  const signingKeyIds = try orDie(SessionStore.configuredKeyIds)
  // `RepoRoles` reads through the client `within` opened for the renewal, not one of its own per read.
  const roles = try RepoRoles.make(Layer.effect(SqlClient.SqlClient, SqlClient.SqlClient), {
    repository,
    app,
    allowed,
    local: options.local === true && Option.isNone(app),
    ...(options.localRoles === undefined ? {} : { localRoles: options.localRoles })
  })
  const branchRoles = BranchRoles.layer(roles)
  return {
    check: (admission: Admission) =>
      verdict(roles, admission, roleFreshMs).pipe(
        Effect.provide(branchRoles),
        provideService(Conversations.homeRepositoryNames, home),
        provideService(SessionStore.SigningKeyIds, signingKeyIds),
        catchCause(() => succeed<Checked>("unverified"))
      ),
    within: <A, R2>(renewal: A!never!R2) =>
      renewal.pipe(Effect.provide(database)) as (A!unknown!Exclude<R2, SqlClient.SqlClient>)
  }
}
