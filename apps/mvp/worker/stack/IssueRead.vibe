import { GitHub } from "@smthrs/integrations"
import { Effect, Function as Fn, Option } from "effect"
import { FetchHttpClient, HttpClient } from "effect/http"
import type { SqlClient } from "effect/sql"
import { withToken } from "../github/Calls.ts"
import type { GitHubApp, Repository } from "../github/Config.vibe"
import { readIssue } from "../github/Project.vibe"
import * as Tokens from "../github/Tokens.vibe"

// One issue read from GitHub into the projection, for `attach`'s live check (decision 0153): GitHub's answer, under the
// projection's newer-than guard, so an issue a missed webhook hid as deleted is tombstoned before the writer decides.
// Read as the App, with a token narrowed to the repository and `issues: read`.
export const make = effect (app: GitHubApp, http: Option.Option<HttpClient.HttpClient> = Option.none()) => {
  const appAuth = GitHub.AppAuth.make({ appId: app.appId, privateKey: app.privateKey, apiBaseUrl: app.apiBaseUrl })
  return (repository: Repository, number: number): void!unknown!SqlClient.SqlClient =>
    withSpan(
      effect {
        const read = effect {
          // Installation tokens only: no session's token to refresh.
          const auth = try appAuth
          const tokens = try sync(() => Tokens.make({
            app: auth,
            keys: Option.none(),
            refresh: Fn.constant<void!!>(Effect.void),
          }))
          const token = try tokens.forInstallation(repository, "read")
          try (readIssue(repository, number).pipe(withToken(token, app.apiBaseUrl)))
        }
        if (Option.isSome(http)) {
          provide HttpClient.HttpClient = http.value {
            try read
          }
        } else {
          provide FetchHttpClient.layer {
            try read
          }
        }
      },
      "stack.issue.read",
    )
}
