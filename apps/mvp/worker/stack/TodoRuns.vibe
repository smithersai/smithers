import { EngineStore } from "@smthrs/flows"
import { SqlClient } from "effect/sql"
import { Cause, Effect, Layer, Metric, Option, Predicate, Schema } from "effect"
import { todoExecutionId } from "../../src/features/pulls/contract.ts"
import { codeOf } from "../ErrorCode.ts"
import type { FlowStarter, StartConflict, StartUnavailable } from "../Flows.ts"
import * as Todo from "../flows/Todo.vibe"
import * as TodoBaseClosed from "../flows/TodoBaseClosed.vibe"
import * as TodoDrop from "../flows/TodoDrop.vibe"
import * as TodoSession from "../flows/TodoSession.ts"
import * as Fleet from "../runners/Fleet.vibe"
import * as Stack from "./Stack.vibe"

const startOrConflict = effect (started: void!(StartConflict | StartUnavailable)) => {
  started catch effect (error) => {
    if (error._tag === "@smthrs/mvp/flows/StartConflict") return
    throw new Stack.RunsUnavailable({ errorCode: error.errorCode })
  }
}

/** The production adapter from persisted stack receipts to remote executions. */
export const make = (
  starter: FlowStarter["Service"],
  cancel: (executionId: string) => void!unknown,
  stopped?: (attemptId: string) => boolean!Stack.RunsUnavailable,
): Stack.TodoRuns["Service"] => Stack.TodoRuns.of({
  ...(stopped === undefined ? {} : { isStopped: stopped }),
  start: effect (attempt) => {
    const executionId = try sync(() => todoExecutionId(attempt.attemptId))
    try startOrConflict(starter.start(Todo.Todo, { executionId, payload: attempt }))
  },
  // The pull request's cleanup and the descendants' invalidation are started even when the cancel fails: each is its
  // own durable execution and reads the TODO's state, not the run's, so a run whose object couldn't take the cancel
  // (production 2026-10-31: `cloudflare.execution.cancel` failed with a JournalError for T112) no longer leaves its
  // pull request open. Any failure still answers 503, and the outbox's resend makes each of them again; an interrupt
  // propagates as it is.
  stop: effect (attempt) => {
    const executionId = try sync(() => todoExecutionId(attempt.attemptId))
    const results = try all([
      catchCause(cancel(executionId), effect (cause) => {
        if (Cause.hasInterrupts(cause)) return try interrupt
        const errorCode = try sync(() => codeOf(Cause.squash(cause)))
        throw new Stack.RunsUnavailable({ errorCode })
      }),
      startOrConflict(starter.start(TodoBaseClosed.Invalidate, {
        executionId: `todo-base-closed:${attempt.attemptId}`,
        payload: { ...attempt, baseClosed: true },
      })),
      startOrConflict(starter.start(TodoDrop.Drop, {
        executionId: `todo-drop:${attempt.attemptId}`,
        payload: { attemptId: attempt.attemptId, todoId: attempt.todoId },
      })),
    ], { mode: "result" })
    const failed = results.find((result) => result._tag === "Failure")
    if (failed !== undefined) throw failed.failure
  },
})

/** Whether this attempt still belongs to a live TODO. */
export const mayStart = effect (attempt: Stack.AttemptStart) => {
  const todo = try Stack.attemptTodo(attempt)
  return Option.isSome(todo) && todo.value.attempt === attempt.ordinal
    && (todo.value.state === "working" || todo.value.state === "in_review")
}

/** Recheck delayed TODO admission; other remote flows have their own admission policy. */
export const canStart = effect (intent: { readonly flow: string; readonly payload: unknown }) => {
  if (intent.flow !== Todo.Todo._tag) return true
  return try orDie(effect {
    const attempt = try Schema.decodeUnknownEffect(Todo.TodoRequest)(intent.payload)
    return try mayStart(attempt)
  })
}

/** A cancellation request alone is insufficient: only the engine's terminal receipt permits retry. */
export const isStopped =
  <R>(
    database: Layer.Layer<SqlClient.SqlClient, never, R>,
  ) =>
  effect (attemptId: string): boolean!Stack.RunsUnavailable!R => {
    const inspection = Layer.provide(EngineStore.RunInspection.layerWith({ flows: [Todo.Todo] }), database)
    const inspect = effect {
      provide inspection {
        const reads = try EngineStore.RunInspection.RunInspection
        const executionId = try sync(() => todoExecutionId(attemptId))
        const receipt = try reads.inspect(executionId, { limit: 1 })
        return receipt.run.status === "cancelled"
      }
    }
    return inspect catch effect (error) => {
      if (Predicate.isTagged(error, "@smthrs/engine-store/RunNotFound")) return false
      const errorCode = try sync(() => codeOf(error))
      throw new Stack.RunsUnavailable({ errorCode })
    }
  }

/** TODOs settled by their run's host after the run ended in a defect, by `outcome` (`applied`, `repeated`, `stale`). */
export const crashes = Metric.counter("smithers_todo_crashes", {
  description: "TODOs failed `crashed` by the host that settled their run, by outcome",
  incremental: true,
})

const todoPrefix = todoExecutionId("")

/**
 * Settles the TODO of `todo` run `executionId` once the engine in `engine` holds the run `failed`: the run ended in a
 * defect (or its Settle or Fail step gave up), so no step reported the TODO's end and it would stay Working. Its
 * attempt fails `crashed`, through the writer as any run's report, and the answer is the TODOs that start now; the
 * same report again answers the same starts. A TODO the run already settled, a later attempt's, or a dropped one is a
 * stale report, which changes nothing; any other run is not a TODO's. The run page says what it died of (`flow.run.defect`, its `transitioned` decision).
 */
export const settleCrashed = <E, R, AE = never, AR = never>(
  executionId: string,
  engine: Layer.Layer<SqlClient.SqlClient, E, R>,
  raise?: (alert: Fleet.Alert) => void!AE!AR,
) =>
  withSpan(
    effect {
      if (!executionId.startsWith(todoPrefix)) return []
      const status = try effect {
        provide engine {
          const sql = try SqlClient.SqlClient
          const rows = try sql<
            { readonly status: string }
          >`SELECT status FROM flows_runs WHERE run_id = ${executionId}`
          return rows[0]?.status
        }
      }
      if (status !== "failed") return []
      const sql = try SqlClient.SqlClient
      const [attempt] = try sql<Stack.RunAttempt>`
      SELECT id::text AS "attemptId", todo_id::text AS "todoId", repo_id AS "repoId", ordinal
      FROM todo_attempts WHERE id::text = ${executionId.slice(todoPrefix.length)}`
      if (attempt === undefined) return []
      const reported = try Stack.report(
        attempt,
        { kind: "finished", state: "failed", failure: "crashed" },
        { runs: true },
      )
      // An external agent still at work stops with its run: no step waits on its job now, and a settled run offers no Stop.
      // Its fleet row says why first, because the stop would read Stopping and no probe is left to correct it.
      try Fleet.crashed(attempt.attemptId)
      try TodoSession.stop(attempt.attemptId)
      // Run failed or lost: `todo/Fail` raises this for a run that ended itself (docs/features/fleet.md#alerts).
      if (reported.outcome !== "stale" && raise !== undefined) {
        const alertId = try sync(() => Fleet.alertId.failed(attempt.attemptId))
        const alert: Fleet.Alert = {
          alertId,
          kind: "failed",
          repoId: attempt.repoId,
          subject: attempt.attemptId,
        }
        try Fleet.raiseAll(attempt.attemptId, [alert], raise, () => Effect.void)
      }
      try Metric.update(Metric.withAttributes(crashes, { outcome: reported.outcome }), 1)
      const log = reported.outcome === "applied" ? logWarning : logInfo
      try annotateLogs(log("todo.crashed"), {
        runId: executionId,
        attemptId: attempt.attemptId,
        todoId: attempt.todoId,
        outcome: reported.outcome,
      })
      return reported.starts
    },
    "todo.crashed",
    { attributes: { "smithers.execution.id": executionId } },
  )
