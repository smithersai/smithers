import { SqlClient } from "effect/sql"
import type { BackfillBatch, BackfillCommand } from "./MessagesShard.ts"
import { backfillCommands, isAsked, MessagesShardBridge, type Noted } from "./MessagesShardBridge.ts"
import { MAX_BACKFILL_BATCH_BYTES } from "./MessagesShardRoutes.ts"
import * as MessagesShardSource from "./MessagesShardSource.ts"

// A conversation's history in Postgres, replayed once into its messages shard (decision 0170, slice 5b). The bridge
// writes into a shard only what ChatApi stored since it started (slices 4c and 5a), so a conversation asked before
// then has a shard that holds nothing of its history, or only its latest writes. A shard's head is therefore no proof
// of anything: the object keeps its own mark (MessagesShard.ts `backfill`), set once every command of the history
// was taken.
//
// `ensure` runs before a page's Pull, Snapshot or Submit is forwarded (MessagesShardRoutes.ts `dispatch` `before`),
// and says whether the shard holds the history now. A shard that does not is answered `503`, retryable: no reader is
// served part of the history as all of it, and no writer takes a place ahead of the history still to come. A shard
// already marked costs one call to its object and asks Postgres nothing.
//
// Any other is read from Postgres after the object's cursor, the place of the last question it holds whole, at most
// `HISTORY_PAGE` exchanges at a time, every answer of every question and every note on their messages. The commands
// are the bridge's own, under the keys it writes live (`question:<id>`, `answer:<id>`, `noted:<id>:<version>` and the
// rest: MessagesShardBridge.ts `backfillCommands`), sent in batches of at most `BATCH_COMMANDS`, one call to the
// object each (MessagesShard.ts `backfill.batch`). The object raises its cursor with each batch it took whole and sets
// the mark with the last, so one request sends at most `MAX_BATCHES` batches, well inside a Worker's subrequests, and
// the next resumes after the cursor. A command the bridge already sent, or a batch that already ran, is answered
// `Duplicate` from its key's receipt, so two requests that both find the shard unmarked journal each message once. A
// key of the backfill's own would post every bridged message twice.
//
// A write Postgres commits after the history was read is no gap: Postgres keeps it owed to the shard from its commit
// (db/migrations/0139_messages_shard_pending.ts), and the drain before the read sends it
// (MessagesShardSource.ts `drain`).
//
// The mark is never set over a command the shard did not take. A batch the object refused a command of stops there,
// and the history is retried from the cursor on the next request, which is answered `503` until the row is repaired.
// The log line carries the conversation's id, counts, fixed codes and the id of the message refused, never a
// message's text, its author or who asked.

/** Backfills, by `outcome`: `backfilled`, `empty`, `incomplete`, `rejected`, `unreadable` or `unreachable`. */
export const backfills = Metric.counter("smithers_messages_shard_backfill", {
  description: "Conversations whose history in Postgres was replayed into their messages shard, by outcome",
  incremental: true,
})

/**
 * What became of one backfill: the history replayed and marked (`backfilled`); nothing left to replay, marked
 * (`empty`); more history left than one request sends, its progress kept (`incomplete`); a command the shard did not
 * take (`rejected`); Postgres not read (`unreadable`); the object not reached (`unreachable`).
 */
export type BackfillOutcome = "backfilled" | "empty" | "incomplete" | "rejected" | "unreadable" | "unreachable"

/** The most commands one batch carries: one call to the object. */
export const BATCH_COMMANDS = 200

/** The most batches one request sends: what is left is sent by the next, after the cursor. */
export const MAX_BATCHES = 24

/** The most exchanges one request reads from Postgres. */
export const HISTORY_PAGE = 1024

/** What a batch's commands may hold, leaving room for the rest of the batch (`MAX_BACKFILL_BATCH_BYTES`). */
const BATCH_BYTES = MAX_BACKFILL_BATCH_BYTES - 1024

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/

const encoder = new TextEncoder()

/** Counts and logs one backfill. Every field is the conversation's id, a fixed code, a count or a message's id. */
effect function report(conversationId: string, outcome: BackfillOutcome, counts: Readonly<Record<string, number | string>>) {
  try Metric.update(Metric.withAttributes(backfills, { outcome }), 1)
  const line = outcome === "backfilled" || outcome === "empty"
    ? logInfo("messages_shard.backfill")
    : logWarning("messages_shard.backfill")
  try annotateLogs(line, { conversationId, outcome, ...counts })
}

/** One question's commands, every answer of it with the notes on their messages, and its place in Postgres. */
interface Group {
  readonly questionId: string
  readonly position: number
  readonly commands: Array<BackfillCommand>
}

/**
 * What Postgres holds of the conversation after `cursor`, as commands, by question in Postgres's order: at most
 * `HISTORY_PAGE` exchanges. `whole` says the history ends there; when it does not, the last question read is left
 * for the next request, which reads all of its answers.
 */
effect function read(conversationId: string, cursor: number) {
  const exchanges = try MessagesShardSource.history(conversationId, cursor, HISTORY_PAGE)
  const ids = new Set(exchanges.flatMap((exchange) =>
    isAsked(exchange) ? [exchange.questionId, exchange.answerId] : [exchange.questionId]))
  const rows = try MessagesShardSource.notes(conversationId, [...ids])
  const notes = new Map(rows.map((row) => [row.id, MessagesShardSource.notedOf(conversationId, row)]))
  const groups: Array<Group> = []
  for (const exchange of exchanges) {
    const last = groups.at(-1)
    const first = last?.questionId !== exchange.questionId
    // A question's note is sent with its first exchange; an answer's with its own.
    const noted: Array<Noted> = []
    const asked = first ? notes.get(exchange.questionId) : undefined
    const answered = isAsked(exchange) ? notes.get(exchange.answerId) : undefined
    if (asked !== undefined) noted.push(asked)
    if (answered !== undefined) noted.push(answered)
    const commands = backfillCommands(exchange, noted)
    if (first) groups.push({ questionId: exchange.questionId, position: exchange.question.position, commands: [...commands] })
    else last!.commands.push(...commands)
  }
  const whole = exchanges.length < HISTORY_PAGE
  return { groups: whole ? groups : groups.slice(0, -1), whole, exchanges: exchanges.length, notes: rows.length }
}

/**
 * The batches `groups` are sent in, after `cursor`: at most `BATCH_COMMANDS` commands and `BATCH_BYTES` each, in
 * order. Each names as its cursor the place of the last question whose commands are all in it or before it, and the
 * last says whether the history ends there (`whole`).
 */
const batchesOf = (groups: ReadonlyArray<Group>, cursor: number, whole: boolean): ReadonlyArray<BackfillBatch> => {
  const batches: Array<BackfillBatch> = []
  let commands: Array<BackfillCommand> = []
  let bytes = 0
  let reached = cursor
  for (const group of groups) {
    for (const command of group.commands) {
      const size = encoder.encode(JSON.stringify(command)).length + 1
      if (commands.length >= BATCH_COMMANDS || (commands.length > 0 && bytes + size > BATCH_BYTES)) {
        batches.push({ cursor: reached, done: false, commands })
        commands = []
        bytes = 0
      }
      commands.push(command)
      bytes += size
    }
    reached = group.position
  }
  batches.push({ cursor: reached, done: whole, commands })
  return batches
}

/**
 * Replays conversation `conversationId`'s history from Postgres, read through `database`, into its shard, unless the
 * shard holds it already, and says whether it does now. `database` is built only once the shard says it does not.
 */
effect function backfill<E, R>(
  bridge: MessagesShardBridge["Service"],
  database: Layer.Layer<SqlClient.SqlClient, E, R>,
  conversationId: string,
  budget: number,
) {
  const state = bridge.backfillState(conversationId) catch () => undefined
  if (state === undefined) {
    try report(conversationId, "unreachable", {})
    return false
  }
  if (state.checked) return true
  // Whatever went wrong reading is kept out of the log: a driver's error can quote a row.
  const held = try catchCause(Effect.provide(read(conversationId, state.cursor), database), () => succeed(undefined))
  if (held === undefined) {
    try report(conversationId, "unreadable", { cursor: state.cursor })
    return false
  }
  const batches = batchesOf(held.groups, state.cursor, held.whole)
  const counts = { exchanges: held.exchanges, notes: held.notes, cursor: state.cursor }
  let sent = 0
  let commands = 0
  for (const batch of batches) {
    if (sent === budget) {
      try report(conversationId, "incomplete", { ...counts, batches: sent, commands, reason: "budget" })
      return false
    }
    const result = bridge.backfillBatch(conversationId, batch) catch () => undefined
    sent++
    if (result === undefined) {
      try report(conversationId, "unreachable", { ...counts, batches: sent, commands })
      return false
    }
    if (result.rejected !== undefined) {
      try report(conversationId, "rejected", {
        ...counts,
        batches: sent,
        commands: commands + result.rejected.index,
        messageId: result.rejected.messageId,
        code: result.rejected.code,
      })
      return false
    }
    commands += batch.commands.length
  }
  if (!held.whole) {
    try report(conversationId, "incomplete", { ...counts, batches: sent, commands, reason: "budget" })
    return false
  }
  try report(conversationId, commands === 0 ? "empty" : "backfilled", { ...counts, batches: sent, commands })
  return true
}

/**
 * Makes sure conversation `conversationId`'s shard holds its history from Postgres, read through `database`, where a
 * bridge is provided, and says whether it does: a deployment with none asks nothing, and has nothing to hold. At most
 * `budget` batches are sent (`MAX_BATCHES`). What ChatApi runs before a page's Pull, Snapshot or Submit is forwarded
 * (worker/ChatApiProgram.ts). Never fails.
 */
export effect function ensureIn<E, R>(
  database: Layer.Layer<SqlClient.SqlClient, E, R>,
  conversationId: string,
  budget: number = MAX_BATCHES,
) {
  const service = try serviceOption(MessagesShardBridge)
  const conversation = conversationId.toLowerCase()
  // A shard is named from a conversation's UUID and nothing else (MessagesShard.ts `shardOf`).
  if (Option.isNone(service) || !UUID.test(conversation)) return true
  return try withSpan(backfill(service.value, database, conversation, budget), "messages_shard.backfill")
}

/** `ensureIn`, reading through the database the caller already holds. Never fails. */
export effect function ensure(conversationId: string) {
  const sql = try SqlClient.SqlClient
  return try ensureIn(Layer.succeed(SqlClient.SqlClient, sql), conversationId)
}
