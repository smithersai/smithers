import { SqlClient } from "effect/sql"
import { memberOrAbove, type Actor } from "./Actor.vibe"
import * as RepoRoles from "./github/RepoRoles.vibe"
import { authority, freshDeploymentRole, roleFresh, RoleFreshMs } from "./SessionStore.vibe"
import { mayRead } from "./stack/Access.vibe"

/** Inside a run start or stop transaction: lock the authority's rows, then judge them by Postgres' current clock. */
export const stillAdmitted = (actor: Actor, resolved: RepoRoles.Resolved) => effect {
  const sql = try SqlClient.SqlClient
  if (actor.session !== undefined) {
    // Role observations serialize on the person; sign-out and alias revocation serialize on their session rows.
    const [person] = try sql`SELECT 1 FROM people WHERE id::text = ${actor.subject.id} FOR SHARE`
    if (person === undefined) return "authentication" as const
    const [session] = try sql`
      SELECT 1 FROM sessions WHERE id::text = ${actor.session} AND person_id::text = ${actor.subject.id} FOR SHARE`
    if (session === undefined) return "authentication" as const
    if (actor.alias !== undefined) {
      const [alias] = try sql`
        SELECT 1 FROM host_sessions WHERE id::text = ${actor.alias} AND parent_id::text = ${actor.session} FOR SHARE`
      if (alias === undefined) return "authentication" as const
    }
  }
  // Preserve the precise role receipt that admitted the request. This locks it and checks its freshness after waiting.
  if (Option.isSome(resolved.held) && !(try RepoRoles.holds(resolved.held.value))) return "forbidden" as const
  let role = resolved.role
  if (actor.session !== undefined) {
    // All authority locks are now held. A locking SELECT could have waited past the session's sliding expiry, its
    // or its alias's absolute deadline, or a reauthentication that restamped the row with another key.
    const found = try authority(actor.session, actor.alias ?? null, actor.cookieKey)
    if (Option.isNone(found)) return "authentication" as const
    // On the deployment's repository the newest session role receipt decides, including an ended session's demotion.
    if (Option.isNone(resolved.held)) {
      role = found.value.role
      // A demotion refuses outright; a grant needs a confirmation as fresh as the one that admitted the request.
      const fresh = roleFresh(found.value.roleVerifiedAt, found.value.serverNow, try RoleFreshMs)
      if (!fresh && mayRead(Option.some({ ...actor, role }))) return "unavailable" as const
    }
  }
  return mayRead(Option.some({ ...actor, role })) ? undefined : "forbidden" as const
}

/** Recheck the MCP grant under the admission transaction after GitHub and the workflow description have answered. */
export const stillAdmittedMcp = (actor: Actor, repoId: string, deploymentRole: boolean) => effect {
  if (actor.act?.kind !== "agent" || !actor.act.id.startsWith("mcp:")) return "authentication" as const
  const tokenId = actor.act.id.slice(4)
  const sql = try SqlClient.SqlClient
  const [locked] = try sql`SELECT p.id FROM people p JOIN mcp_tokens t ON t.person_id = p.id
    WHERE p.id::text = ${actor.subject.id} AND t.id::text = ${tokenId} FOR SHARE OF p, t`
  if (locked === undefined) return "authentication" as const
  const [grant] = try sql`SELECT 1 FROM mcp_tokens WHERE id::text = ${tokenId}
    AND revoked_at IS NULL AND expires_at > clock_timestamp()
    AND 'mcp:write' = ANY(scopes) AND (repo_scope IS NULL OR lower(repo_scope) = ${repoId})`
  if (grant === undefined) return "authentication" as const
  if (deploymentRole) {
    const result = try Effect.result(freshDeploymentRole(actor.subject.id))
    if (result._tag === "Failure") return "unavailable" as const
    if (!memberOrAbove(result.success)) return "forbidden" as const
  }
  return undefined
}
