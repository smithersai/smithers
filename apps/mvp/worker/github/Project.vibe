import { GitHub } from "@smthrs/integrations"
import { statusOf } from "./Calls.ts"
import type { Repository } from "./Config.vibe"
import * as Store from "./Store.vibe"

// Re-reading one issue from GitHub into the projection (decision 0012 §2): a webhook only names its subject, and a write
// reads back what it made, so both come here. GitHub is the truth, so the row is what GitHub answers now, under the
// newer-than guard; an issue GitHub answers 404 or 410 for is tombstoned with its comments. Reading (GitHub) and writing
// (Postgres) are separate, so a write settles its row and its projection in one transaction without holding it open
// across a call to GitHub.

/** The most pages of comments one re-read walks; a longer conversation is left to Reconcile, and nothing is tombstoned. */
export const COMMENT_PAGES = 10

/** What GitHub answered for one issue: the issue and its comments when it has it, read at `fetchedAt` (epoch ms). */
export type Fetched =
  | {
    readonly kind: "found"
    readonly issue: GitHub.Issues.Issue
    readonly comments: ReadonlyArray<GitHub.Issues.IssueComment>
    /** Whether `comments` is every comment, so a missing one was deleted. */
    readonly complete: boolean
    readonly fetchedAt: number
  }
  | { readonly kind: "gone"; readonly fetchedAt: number }

/** What a projection did: the issue's row and how many rows changed, or that GitHub no longer has it. */
export type Projected =
  | { readonly outcome: "applied"; readonly changed: number }
  | { readonly outcome: "tombstoned"; readonly changed: number }

/** Reads issue `number` of `repository` and its comments with the GitHub client in context. Writes nothing. */
export const fetchIssue = effect (repository: Repository, number: number) => {
  const fetchedAt = try Clock.currentTimeMillis
  const issue = try result(GitHub.Issues.getIssue(repository.owner, repository.name, number))
  if (issue._tag === "Failure") {
    const status = statusOf(issue.failure)
    if (status === 404 || status === 410) return { kind: "gone", fetchedAt } satisfies Fetched
    throw issue.failure
  }
  const comments = try GitHub.Issues.listComments(repository.owner, repository.name, number, {
    maxPages: COMMENT_PAGES,
  })
  return {
    kind: "found",
    issue: issue.success,
    comments: comments.items,
    complete: !comments.truncated,
    fetchedAt,
  } satisfies Fetched
}

/** Writes what `fetchIssue` read, under the newer-than guard, through the `SqlClient` in context. */
export const project = effect (repository: Repository, number: number, fetched: Fetched) => {
  if (fetched.kind === "gone") {
    const tombstoned = try Store.tombstoneIssue(repository.id, number, fetched.fetchedAt)
    return { outcome: "tombstoned", changed: tombstoned ? 1 : 0 } satisfies Projected
  }
  let changed = (try Store.upsertIssue(repository.id, fetched.issue, fetched.fetchedAt)) ? 1 : 0
  for (const comment of fetched.comments) {
    if (try Store.upsertComment(repository.id, number, comment, fetched.fetchedAt)) changed += 1
  }
  if (fetched.complete) {
    changed += try Store.tombstoneCommentsExcept(
      repository.id,
      number,
      fetched.comments.map((comment) => comment.id),
      fetched.fetchedAt,
    )
  }
  return { outcome: "applied", changed } satisfies Projected
}

/** Reads issue `number` and projects it: `fetchIssue`, then `project`. */
export const readIssue = effect (repository: Repository, number: number) => {
  const fetched = try fetchIssue(repository, number)
  return try project(repository, number, fetched)
}
