import { GitHub } from "@smthrs/integrations"
import type { HttpClient } from "effect/http"
import { codeOf } from "../ErrorCode.ts"
import * as GitHubConfig from "./Config.vibe"
import * as Metrics from "./Metrics.vibe"

// What GitHub REST reads of public repositories go out as (docs/features/repo.md#configuration): the clone's size call
// (worker/RepoUpstream.ts) and a repository's About (worker/RepoAbout.ts). GitHub allows an unauthenticated caller 60
// calls an hour per IP address, and a Worker shares Cloudflare's addresses with every other Worker, so in production
// those reads were refused within minutes (2026-10-21). In order:
//
// - `GITHUB_TOKEN`, when set and not blank: a bot's token, as before.
// - the GitHub App, when this deployment has one: an installation token for the deployment's own repository
//   (`GITHUB_REPOSITORY`) with `metadata: read` only. It reads any public repository at the installation's limit, 5,000
//   calls an hour or more, and holds nothing beyond that one repository's metadata. It is minted on first use and kept
//   until 5 minutes before it expires.
// - neither: anonymous.
//
// A Worker request never waits on another request's work: workerd cancels a request that awaits another's permit or
// I/O as hung (decision 0104; the GitHub shapes' signed-out reads, 2026-10-25). So the isolate keeps only the minted
// token and its expiry, a plain value, and a read that finds none, or one about to expire, mints its own. Concurrent
// first reads on a cold isolate may each mint; the last one minted is kept.
//
// Each mint counts `github_token_mints{kind="read"}` by outcome and logs `github.read_token`. An App token that can't be
// minted now leaves that read anonymous (outcome `anonymous`, with GitHub's code); the next read mints again.

/** The token one read goes out with, or none: anonymous. */
export type ReadToken = Option.Option<Redacted.Redacted<string>>!!

/** How long before its expiry a held installation token is replaced. */
export const REFRESH_BEFORE_MS = 5 * 60 * 1000

/** Always `token`: a configured token, or none. */
export const fixed = (token: Option.Option<Redacted.Redacted<string>>): ReadToken => succeed(token)

/**
 * The App's installation token for `repository`, minted with `metadata: read` and narrowed to that repository, held in
 * this isolate until `REFRESH_BEFORE_MS` before it expires. Only the token is shared: a read that finds none fresh
 * mints in its own request, never waiting on another's.
 */
export const fromApp = effect (app: GitHub.AppAuth.AppAuth, repository: { readonly owner: string; readonly name: string }) => {
  const held = try Ref.make(Option.none<GitHub.AppAuth.InstallationToken>())
  const counted = (outcome: "minted" | "anonymous") =>
    Metric.update(Metric.withAttributes(Metrics.tokenMints, { kind: "read", outcome }), 1)
  const mint = effect {
    const startedAt = try Clock.currentTimeMillis
    const installation = try app.installation(repository.owner, repository.name)
    const minted = try app.installationToken({
      installationId: installation.id,
      repositories: [repository.name],
      permissions: { metadata: "read" },
    })
    try Ref.set(held, Option.some(minted))
    try counted("minted")
    try annotateLogs(logInfo("github.read_token"), {
      outcome: "minted",
      durationMs: (try Clock.currentTimeMillis) - startedAt,
    })
    return Option.some(minted.token)
  }
  const mintWithFallback = withSpan(effect {
    return mint catch effect (error) => {
      try counted("anonymous")
      try annotateLogs(logWarning("github.read_token"), { outcome: "anonymous", errorCode: codeOf(error) })
      return Option.none<Redacted.Redacted<string>>()
    }
  }, "github.read_token")
  const token: ReadToken = effect {
    const current = try Ref.get(held)
    const now = try Clock.currentTimeMillis
    if (Option.isSome(current) && current.value.expiresAt - now > REFRESH_BEFORE_MS) return Option.some(current.value.token)
    return try mintWithFallback
  }
  return token
}

/** What the deployment's read token comes from: `GITHUB_TOKEN`, else the GitHub App, else neither (anonymous). */
export interface Settings {
  readonly token: Option.Option<Redacted.Redacted<string>>
  readonly app: Option.Option<GitHubConfig.GitHubApp>
}

/**
 * Reads `Settings` from the deployment's configuration: `GITHUB_TOKEN` when set and not blank, else the App's
 * (`GITHUB_APP_ID`, `GITHUB_APP_PRIVATE_KEY`, `GITHUB_REPOSITORY`, `GITHUB_API_URL`). A host reads them while it
 * builds; `fromSettings` reads no configuration.
 */
export const settings = effect {
  const token = Option.filter(
    try Config.option(Config.Redacted("GITHUB_TOKEN")),
    (value) => Redacted.value(value).trim() !== "",
  )
  if (Option.isSome(token)) return { token, app: Option.none() }
  // An App configuration that doesn't read (a malformed `GITHUB_API_URL`) fails where the git loop reads it; here it
  // leaves reads anonymous.
  const app = GitHubConfig.configured catch () => Option.none<GitHubConfig.GitHubApp>()
  return { token, app }
} satisfies Settings!Config.ConfigError

/**
 * The deployment's read token from `settings`: the configured token, else the App's over the `HttpClient` in context,
 * else none. A key that doesn't import is none too; `github.config` logs it where the git loop starts.
 */
export const fromSettings = (effect (settings: Settings) => {
  if (Option.isSome(settings.token)) return fixed(settings.token)
  if (Option.isNone(settings.app)) return fixed(Option.none())
  const { appId, privateKey, apiBaseUrl, repository } = settings.app.value
  const app = try option(GitHub.AppAuth.make({ appId, privateKey, apiBaseUrl }))
  if (Option.isNone(app)) return fixed(Option.none())
  return try fromApp(app.value, repository)
}) satisfies (settings: Settings) => ReadToken!!HttpClient.HttpClient

/** The deployment's read token from its configuration (`settings`, then `fromSettings`). */
export const fromConfig = effect {
  const configured = try settings
  return try fromSettings(configured)
} satisfies ReadToken!Config.ConfigError!HttpClient.HttpClient
