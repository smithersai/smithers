import { CauseReceipt, Core, type Principal } from "@smthrs/app-core"
import {
  canonicalHash,
  decidePlan,
  emptyPlanTree,
  evolvePlan,
  PlanCommand,
  PlanEvent,
  PlanTree
} from "@smthrs/app-state"
import { DoSqliteShard, type ObjectDatabase } from "@smthrs/platform-cloudflare"
import { ShardClient, ShardProtocol } from "@smthrs/sync"
import { Effect, Schema } from "effect"
import {
  applyPlanDelivery,
  decodeCauseReceiptJson,
  decodePlanEventJson,
  decodePlanTreeRecordedEvent,
  decodePlanTreeSnapshotState,
  isPersonOnlyPlanCommand,
  PLAN_READ_TAG,
  PLAN_REVIEW_TAG,
  PLAN_UPDATE_TAG,
  PlanIdempotencyKey
} from "../../src/features/workbench/planContract.ts"
import { withTransactionSync } from "../chat/MessagesShard.ts"

export const update = PLAN_UPDATE_TAG
export const review = PLAN_REVIEW_TAG
export const read = PLAN_READ_TAG

export const readCapability = (shard: ShardProtocol.ShardId) => "plan:read:" + shard
export const writeCapability = (shard: ShardProtocol.ShardId) => "plan:write:" + shard

const decodeCommand = Schema.decodeUnknownOption(PlanCommand)
const decodeIdempotencyKey = Schema.decodeUnknownOption(PlanIdempotencyKey)
const decodePlanEventSync = Schema.decodeUnknownSync(PlanEvent)

export const apply = applyPlanDelivery

type PendingCommit =
  | { readonly _tag: "Duplicate"; readonly run: Core.Requested }
  | { readonly _tag: "Fresh"; readonly idempotency: { readonly key: string; readonly requestHash: string } | null }

interface PendingIdempotencyWrite {
  readonly key: string
  readonly requestHash: string
  readonly event: PlanEvent
  readonly cause: CauseReceipt.CauseReceipt
}

export const make = effect (
  storage: ObjectDatabase.Storage,
  shard: ShardProtocol.ShardId,
  credentials: Principal.Credentials
) => {
  // `(headSeq, tree, receipts)` is what SQLite has committed. This shard owns `storage` exclusively (never nested
  // inside an enclosing transaction), so staging in `beforeCommit` and publishing synchronously once
  // `storage.transactionSync` returns keeps in-memory state strictly equal to SQLite with no cross-request lock
  // (decision 0104).
  const exec = <A extends Record<string, ArrayBuffer | string | number | null>>(
    sql: string,
    ...bindings: ReadonlyArray<ArrayBuffer | string | number | null>
  ): Array<A> => storage.sql.exec<A>(sql, ...bindings).toArray()

  try sync(() => {
    exec(
      "CREATE TABLE IF NOT EXISTS plan_idempotency (" +
        "idempotency_key TEXT PRIMARY KEY, " +
        "request_hash TEXT NOT NULL, " +
        "journal_seq INTEGER NOT NULL, " +
        "output_json TEXT NOT NULL, " +
        "cause_json TEXT NOT NULL" +
      ")"
    )
  })

  let tree = emptyPlanTree
  let receipts: Array<CauseReceipt.CauseReceipt> = []
  let headSeq = 0
  let pendingCommit: PendingCommit | null = null
  let pendingIdempotencyWrite: PendingIdempotencyWrite | null = null
  const staged: Array<{ readonly tree: PlanTree; readonly causes: ReadonlyArray<CauseReceipt.CauseReceipt>; readonly seq: number }> = []
  const trackedStorage = try sync(() => withTransactionSync(storage, <T>(closure: () => T): T => {
    staged.length = 0
    try {
      const value = storage.transactionSync(closure)
      const committed = staged.pop()
      if (committed !== undefined) {
        tree = committed.tree
        receipts.push(...committed.causes)
        headSeq = committed.seq
      }
      return value
    } finally {
      staged.length = 0
      pendingIdempotencyWrite = null
    }
  }))
  const { shard: journal } = try DoSqliteShard.make(trackedStorage, {
    shard,
    beforeCommit: (entry) => {
      const nextTree = applyPlanDelivery(tree, { _tag: "Entries", entries: [entry], through: { shard, epoch: entry.epoch, seq: entry.seq } })
      const causes = entry.events.map((event) => decodePlanTreeRecordedEvent(event).cause)
      if (pendingIdempotencyWrite !== null) {
        exec(
          "INSERT INTO plan_idempotency (idempotency_key, request_hash, journal_seq, output_json, cause_json) VALUES (?, ?, ?, ?, ?)",
          pendingIdempotencyWrite.key,
          pendingIdempotencyWrite.requestHash,
          entry.seq,
          JSON.stringify(pendingIdempotencyWrite.event),
          JSON.stringify(pendingIdempotencyWrite.cause)
        )
      }
      staged.push({ tree: nextTree, causes, seq: entry.seq })
    }
  })
  const reader = try ShardClient.make({
    shard,
    node: "authority",
    transport: journal,
    store: try sync(() => ShardClient.memoryStore()),
    apply: (delivery) => Effect.sync(() => {
      tree = applyPlanDelivery(tree, delivery)
      headSeq = delivery._tag === "Reset" ? delivery.snapshot.position.seq : delivery.through.seq
      if (delivery._tag === "Reset") {
        receipts = delivery.snapshot.state === null ? [] : [...decodePlanTreeSnapshotState(delivery.snapshot.state).receipts]
      } else {
        for (const entry of delivery.entries) {
          for (const event of entry.events) receipts.push(decodePlanTreeRecordedEvent(event).cause)
        }
      }
    })
  })
  // Rebuild the reducer from the durable snapshot and tail before admitting requests.
  const head = try reader.pull
  const payload = {
    type: "object",
    properties: {
      command: { type: "object", properties: {}, additionalProperties: true },
      idempotencyKey: { type: "string", minLength: 1, maxLength: 200 }
    },
    required: ["command"],
    additionalProperties: false
  } as const
  const flow = (tag: typeof update | typeof review): Core.Flow => ({
    tag,
    title: tag === review ? "Review plan" : "Update plan",
    payload,
    capabilities: [writeCapability(shard)],
    ...(tag === review ? { personOnly: "Only the person can finish a plan node." } : {}),
    run: (input, tx) => {
      pendingCommit = null
      const command = decodeCommand(input["command"])
      if (command._tag === "None") return new Core.Failed("invalid_command", "Invalid plan command.")
      const value = command.value
      const finishing = isPersonOnlyPlanCommand(value)
      if (finishing !== (tag === review)) return new Core.Failed("wrong_operation", "Use the matching plan operation.")
      const rawKey = input["idempotencyKey"]
      let scopedKey: string | undefined
      let requestHash: string | undefined
      if (rawKey !== undefined) {
        const parsedKey = decodeIdempotencyKey(rawKey)
        if (parsedKey._tag === "None") {
          return new Core.Failed("invalid_idempotency_key", "Invalid idempotency key.")
        }
        scopedKey = `${tag}:${tx.subject}:${tx.act ?? "person"}:${parsedKey.value}`
        requestHash = canonicalHash({ shard, tag, command: value })
        const prior = exec<{
          readonly request_hash: string
          readonly journal_seq: number
          readonly output_json: string
          readonly cause_json: string
        }>(
          "SELECT request_hash, journal_seq, output_json, cause_json FROM plan_idempotency WHERE idempotency_key = ?",
          scopedKey
        )[0]
        if (prior !== undefined) {
          if (prior.request_hash !== requestHash) {
            return new Core.Failed(
              "idempotency_conflict",
              "Idempotency key was already used for a different plan command."
            )
          }
          const savedOutput = decodePlanEventJson(prior.output_json)
          const savedCause = decodeCauseReceiptJson(prior.cause_json)
          pendingCommit = {
            _tag: "Duplicate",
            run: {
              runId: savedCause.runId,
              outputRef: savedCause.outputRef,
              journalSeq: prior.journal_seq,
              output: savedOutput,
              cause: savedCause
            }
          }
          return savedOutput
        }
      }
      const result = decidePlan(tree, value)
      if (result._tag === "Refused") return new Core.Failed("invalid_command", JSON.stringify(result))
      const nodeId = "id" in value ? value.id : value.nodeId
      tx.causedBy({ page: shard, blockId: nodeId, rev: String(tree.revision) })
      const event = result.events[0]
      if (event === undefined || result.events.length !== 1) {
        return new Core.Failed("invalid_event_count", "The plan must produce one event.")
      }
      tx.put("plan", "tree", evolvePlan(tree, event))
      pendingCommit = {
        _tag: "Fresh",
        idempotency: scopedKey === undefined || requestHash === undefined ? null : { key: scopedKey, requestHash }
      }
      return event
    }
  })
  const stream = Schema.decodeUnknownSync(ShardProtocol.StreamId)(shard)
  const engine = try Core.make({
    credentials,
    initialJournalSeq: head.seq,
    causeCapabilities: [readCapability(shard)],
    initialRows: [{ collection: "plan", key: "tree", row: tree }],
    initialReceipts: receipts.map((receipt) => ({ receipt })),
    flows: [flow(update), flow(review)],
    projections: [{ name: read, title: "Plan tree", collection: "plan", capabilities: [readCapability(shard)] }],
    commit: (output, atSequence) => effect {
      const intent = pendingCommit
      pendingCommit = null
      if (intent !== null && intent._tag === "Duplicate") {
        return { _tag: "Duplicate" as const, run: intent.run }
      }
      const event = decodePlanEventSync(output)
      const current = try journal.head
      const requested = atSequence(current.seq + 1)
      const idempotency = intent?.idempotency ?? null
      const commandKey: ShardProtocol.CommandKey = idempotency === null
        ? ["plan", requested.runId]
        : ["plan-idem", idempotency.key]
      pendingIdempotencyWrite = idempotency === null
        ? null
        : { key: idempotency.key, requestHash: idempotency.requestHash, event, cause: requested.cause }
      const commit = try journal.submit({
        version: 2,
        shard,
        epoch: current.epoch,
        command: {
          key: commandKey,
          stream,
          payload: { event, cause: requested.cause }
        }
      }).pipe(Effect.orDie)
      if (commit._tag !== "Accepted") return try Effect.die(new Error("Plan journal refused its own commit"))
      return { _tag: "Committed" as const, run: requested }
    }
  })
  return {
    shard,
    engine,
    canRead: (evidence: Principal.McpEvidence) => Effect.map(
      credentials.mint(evidence),
      (principal) => credentials.authority(principal)?.capabilities.includes(readCapability(shard)) === true
    ),
    journal: { pull: journal.pull, snapshot: journal.snapshot },
    state: Effect.sync(() => ({ tree, hash: canonicalHash(tree) })),
    compact: Effect.suspend(() => journal.compact(headSeq, { tree, receipts: [...receipts] }))
  }
}

export type LivePlanTree = Effect.Success<ReturnType<typeof make>>
