import type { ImmutableCache } from "@smthrs/artifacts"
import { digestSync } from "@smthrs/crypto"
import { Docs } from "@smthrs/views"
import { Clock, Duration, Effect, Layer, Option, Redacted, Schema, Stream } from "effect"
import { HttpClient, HttpClientRequest } from "effect/http"
import { SqlClient } from "effect/sql"
import { MAX_LISTED, SEARCH_LIMIT } from "../../src/features/docs/contract.ts"
import { agentAttribution, writeExecutionId } from "../../src/features/issues/contract.ts"
import { repoId, textOf } from "../../src/features/repo/contract.ts"
import { TreeListing as RepoTreeListing } from "../../src/features/repo/schema.ts"
import type { DocsSource } from "../docs/Source.vibe"
import type { FlowStarter } from "../Flows.ts"
import * as IssueList from "../github/IssueList.vibe"
import type * as ReadToken from "../github/ReadToken.vibe"
import * as Store from "../github/Store.ts"
import * as WorkLinks from "../github/WorkLinks.vibe"
import { Write } from "../github/Write.vibe"
import type * as RepoReads from "../RepoReads.ts"
import { McpToolError } from "./Contract.vibe"
import {
  makeLiveToolDeps,
  MAX_FILE_PREVIEW_BYTES,
  MAX_ISSUE_COMMENTS,
  type FileContent,
  type IssueDetail,
  type IssuePage,
  type IssueQuery,
  type IssueSummary,
  type McpToolDeps,
  type PullDetail,
  type PullFilesListing,
  type PullSummary,
  type RefListing,
  type TreeListing,
  type WriteReceipt,
} from "./Tools.vibe"

const decoder = new TextDecoder("utf-8", { fatal: false })
const decodeTree = Schema.decodeUnknownEffect(Schema.fromJsonString(RepoTreeListing))
const SHA_RE = /^[0-9a-f]{40}$/i
const GITHUB_API = "https://api.github.com"
const GITHUB_TIMEOUT = Duration.seconds(8)
const MAX_FALLBACK_TREE_PATHS = 5_000

const mapReadError = (error: RepoReads.ReadRefused): McpToolError => {
  switch (error.code) {
    case "not_found":
    case "not_imported":
    case "not_synced":
      return new McpToolError({ code: "not_found", message: `Repository content not found (${error.code})` })
    case "too_large":
      return new McpToolError({ code: "invalid_params", message: "File exceeds maximum preview size" })
    case "rate_limited":
    case "capacity":
      return new McpToolError({ code: "rate_limited", message: "Repository read capacity exceeded" })
    default:
      return new McpToolError({ code: "unavailable", message: "Repository storage is temporarily unavailable" })
  }
}

const mapSqlError = (what: string) => () =>
  new McpToolError({ code: "unavailable", message: `Database error while executing ${what}` })

/**
 * Strips the trailing `Smithers for @<login> (agent)` footer `Tools.ts` adds before handing `body` to `github/Write`,
 * which appends `agentAttribution(login)` itself for `via: "agent"` writes, so GitHub receives one clean footer.
 */
const stripDuplicateFooter = (body: string, login: string): string => {
  const footer = `${agentAttribution(login)} (agent)`
  if (body === footer) return ""
  const suffix = `\n\n${footer}`
  return body.endsWith(suffix) ? body.slice(0, -suffix.length) : body
}

const encodePathSegments = (filePath: string): string =>
  filePath.split("/").map((segment) => encodeURIComponent(segment)).join("/")

const mapGitHubStatus = (status: number, what: string): McpToolError => {
  if (status === 404 || status === 410) return new McpToolError({ code: "not_found", message: `${what} not found` })
  if (status === 403 || status === 429) {
    return new McpToolError({ code: "rate_limited", message: "Upstream GitHub read rate limit exceeded" })
  }
  return new McpToolError({ code: "unavailable", message: `Upstream GitHub read failed for ${what}` })
}

interface PublicGitHubReader {
  readonly listRefs: (owner: string, name: string) => Effect.Effect<RefListing, McpToolError>
  readonly readTree: (owner: string, name: string, ref?: string) => Effect.Effect<TreeListing, McpToolError>
  readonly readFile: (owner: string, name: string, path: string, ref?: string) => Effect.Effect<FileContent, McpToolError>
  readonly listIssues: (owner: string, name: string, query: IssueQuery) => Effect.Effect<IssuePage, McpToolError>
  readonly getIssue: (owner: string, name: string, number: number) => Effect.Effect<IssueDetail, McpToolError>
  readonly listPulls: (owner: string, name: string, state: "open" | "closed" | "all") => Effect.Effect<ReadonlyArray<PullSummary>, McpToolError>
  readonly getPull: (owner: string, name: string, number: number) => Effect.Effect<PullDetail & { readonly headSha?: string | undefined }, McpToolError>
  readonly getPullFiles: (owner: string, name: string, number: number) => Effect.Effect<PullFilesListing, McpToolError>
}

/**
 * Read-only GitHub fallback for public repositories that have not been cloned into Code Storage or synced into
 * Postgres yet. Uses the deployment read token (`worker/github/ReadToken.ts`, `metadata: read` on the deployment's
 * own repo only, 5,000+ req/hr) when provided so Cloudflare Workers never exhaust GitHub's 60 req/hr shared-IP
 * anonymous quota, while private repos still fail closed with 404.
 */
const makePublicGitHubReader = (
  client: HttpClient.HttpClient,
  baseUrl = GITHUB_API,
  readToken?: ReadToken.ReadToken,
): PublicGitHubReader => {
  const base = baseUrl.replace(/\/+$/, "")

  const sendGitHub = (pathAndQuery: string, accept: string, what: string, authToken?: string) => {
    const baseReq = HttpClientRequest.get(`${base}${pathAndQuery}`).pipe(
      HttpClientRequest.setHeader("user-agent", "smithers-mcp"),
      HttpClientRequest.setHeader("accept", accept),
    )
    const request = authToken === undefined
      ? baseReq
      : HttpClientRequest.setHeader(baseReq, "authorization", `Bearer ${authToken}`)
    return client.execute(request).pipe(
      Effect.timeout(GITHUB_TIMEOUT),
      Effect.mapError(() => new McpToolError({ code: "unavailable", message: `GitHub request timed out for ${what}` })),
    )
  }

  const executeGitHub = (pathAndQuery: string, accept: string, what: string) =>
    effect {
      const tokenOpt = readToken === undefined ? Option.none<Redacted.Redacted<string>>() : try readToken
      const authToken = Option.isSome(tokenOpt) ? Redacted.value(tokenOpt.value) : undefined
      const first = try sendGitHub(pathAndQuery, accept, what, authToken)
      if (authToken !== undefined && first.status === 403 && first.headers["x-ratelimit-remaining"] !== "0") {
        return try sendGitHub(pathAndQuery, accept, what)
      }
      return first
    }

  const getPage = (pathAndQuery: string, what: string) =>
    effect {
      const response = try executeGitHub(pathAndQuery, "application/vnd.github+json", what)
      if (response.status < 200 || response.status >= 300) {
        return try mapGitHubStatus(response.status, what)
      }
      const data: unknown = try response.json.pipe(
        Effect.mapError(() => new McpToolError({ code: "unavailable", message: `Malformed GitHub JSON for ${what}` })),
      )
      return { data, hasNext: /;\s*rel="next"/i.test(response.headers["link"] ?? "") }
    }

  const getJson = (path: string, what: string) => Effect.map(getPage(path, what), page => page.data)

  const getRawBytes = (pathAndQuery: string, what: string): Effect.Effect<Uint8Array, McpToolError> =>
    effect {
      const response = try executeGitHub(pathAndQuery, "application/vnd.github.raw+json", what)
      if (response.status < 200 || response.status >= 300) {
        return try mapGitHubStatus(response.status, what)
      }
      const len = Number(response.headers["content-length"])
      if (Number.isFinite(len) && len > MAX_FILE_PREVIEW_BYTES * 4) {
        throw new McpToolError({ code: "invalid_params", message: "File exceeds maximum preview size" })
      }
      const chunks: Uint8Array[] = []
      let size = 0
      try response.stream.pipe(
        Stream.mapError(() => new McpToolError({ code: "unavailable", message: `Could not read GitHub body for ${what}` })),
        Stream.runForEach(chunk => {
          size += chunk.byteLength
          if (size > MAX_FILE_PREVIEW_BYTES * 4) {
            return Effect.fail(new McpToolError({ code: "invalid_params", message: "File exceeds maximum preview size" }))
          }
          chunks.push(chunk)
          return Effect.void
        }),
      )
      const bytes = new Uint8Array(size)
      let offset = 0
      for (const chunk of chunks) {
        bytes.set(chunk, offset)
        offset += chunk.byteLength
      }
      return bytes
    }

  const repoPath = (owner: string, name: string) =>
    `/repos/${encodeURIComponent(owner)}/${encodeURIComponent(name)}`

  const defaultBranchOf = (owner: string, name: string) =>
    effect {
      const data = try getJson(repoPath(owner, name), `${owner}/${name}`)
      const branch = (data as { readonly default_branch?: unknown } | null)?.default_branch
      if (typeof branch !== "string" || branch === "") {
        throw new McpToolError({ code: "unavailable", message: "Missing default branch" })
      }
      return branch
    }

  const listRefs = (owner: string, name: string): Effect.Effect<RefListing, McpToolError> =>
    effect {
      const rp = repoPath(owner, name)
      const defaultBranch = try defaultBranchOf(owner, name)
      const [headRef, branchesRaw, tagsRaw] = try Effect.all([
        getJson(`${rp}/git/ref/heads/${encodePathSegments(defaultBranch)}`, "default branch"),
        getJson(`${rp}/branches?per_page=100`, "branches"),
        getJson(`${rp}/tags?per_page=100`, "tags"),
      ])
      const head = (headRef as { object?: { sha?: unknown } } | null)?.object?.sha
      if (typeof head !== "string" || !SHA_RE.test(head) || !Array.isArray(branchesRaw) || !Array.isArray(tagsRaw)) {
        throw new McpToolError({ code: "unavailable", message: "Malformed GitHub refs" })
      }
      const names = (refs: readonly { readonly name?: unknown }[]) =>
        refs.map(entry => entry?.name).filter((name): name is string => typeof name === "string")
      const branches = names(branchesRaw)
      const tags = names(tagsRaw)
      return { defaultBranch, head, branches, tags }
    }

  const readTree = (owner: string, name: string, ref?: string): Effect.Effect<TreeListing, McpToolError> =>
    effect {
      const targetRef = ref ?? (try defaultBranchOf(owner, name))
      const data = try getJson(
        `${repoPath(owner, name)}/git/trees/${encodePathSegments(targetRef)}?recursive=1`,
        `tree at ${targetRef}`,
      )
      const rec = data as {
        readonly sha?: unknown
        readonly truncated?: unknown
        readonly tree?: ReadonlyArray<{ readonly path?: unknown; readonly type?: unknown }>
      }
      const entries = Array.isArray(rec.tree) ? rec.tree : []
      const paths = entries
        .filter((e) => e.type === "blob" && typeof e.path === "string")
        .map((e) => e.path as string)
      return {
        ref: typeof rec.sha === "string" ? rec.sha : targetRef,
        paths: paths.slice(0, MAX_FALLBACK_TREE_PATHS),
        truncated: rec.truncated === true || paths.length > MAX_FALLBACK_TREE_PATHS,
      }
    }

  const readFile = (owner: string, name: string, filePath: string, ref?: string): Effect.Effect<FileContent, McpToolError> =>
    effect {
      const targetRef = ref ?? (try defaultBranchOf(owner, name))
      const bytes = try getRawBytes(
        `${repoPath(owner, name)}/contents/${encodePathSegments(filePath)}?ref=${encodeURIComponent(targetRef)}`,
        filePath,
      )
      const content = try sync(() => textOf(bytes))
      if (content === undefined) return { path: filePath, ref: targetRef, content: "\u0000" }
      return { path: filePath, ref: targetRef, content }
    }

  const listIssues = (owner: string, name: string, query: IssueQuery): Effect.Effect<IssuePage, McpToolError> =>
    effect {
      const fingerprint = try Effect.try(() => digestSync(JSON.stringify([repoId(owner, name), query.state, query.q]))).pipe(Effect.orDie)
      const cursor = (page: number, offset: number) => `gh_${fingerprint}_${page}_${offset}`
      let page = 1
      let offset = 0
      if (query.cursor !== undefined) {
        const match = /^gh_([a-f0-9]{64})_([1-9]\d{0,8})_(\d{1,2})$/.exec(query.cursor)
        if (match === null || match[1] !== fingerprint) {
          throw new McpToolError({ code: "invalid_params", message: "Invalid pagination cursor" })
        }
        page = Number(match[2])
        offset = Number(match[3])
      }
      const qLower = query.q.toLowerCase()
      const qNum = /^#?(\d{1,10})$/.exec(query.q)?.[1]
      const issues: IssueSummary[] = []
      // Bound upstream work on sparse searches. A continuation always identifies the next unread position.
      for (let scanned = 0; scanned < 10; scanned++, page++, offset = 0) {
        const { data, hasNext } = try getPage(
          `${repoPath(owner, name)}/issues?state=${query.state}&sort=created&direction=asc&per_page=100&page=${page}`, "issues",
        )
        if (!Array.isArray(data)) throw new McpToolError({ code: "unavailable", message: "Malformed GitHub issue page" })
        for (let index = offset; index < data.length; index++) {
          const item = data[index] as Record<string, unknown> | null
          if (item === null || typeof item !== "object" || "pull_request" in item) continue
          const number = Number(item["number"])
          const title = typeof item["title"] === "string" ? item["title"] : ""
          if (!title.toLowerCase().includes(qLower) && number !== Number(qNum)) continue
          if (issues.length === query.limit) return { issues, nextCursor: cursor(page, index) }
          const user = item["user"] as { readonly login?: unknown } | null | undefined
          issues.push({
            number, title, state: typeof item["state"] === "string" ? item["state"] : "open",
            author: typeof user?.login === "string" ? user.login : null,
            comments: Number(item["comments"] ?? 0),
            updatedAt: typeof item["updated_at"] === "string" ? item["updated_at"] : "",
          })
        }
        if (!hasNext) return { issues, nextCursor: null }
      }
      return { issues, nextCursor: cursor(page, 0) }
    }

  const getIssue = (owner: string, name: string, number: number): Effect.Effect<IssueDetail, McpToolError> =>
    effect {
      const rp = repoPath(owner, name)
      const raw = try getJson(`${rp}/issues/${number}`, `issue #${number}`)
      const item = raw as Record<string, unknown>
      if ("pull_request" in item) {
        throw new McpToolError({ code: "not_found", message: `Issue #${number} not found` })
      }
      const { data: commentsRaw, hasNext } = try getPage(`${rp}/issues/${number}/comments?per_page=${MAX_ISSUE_COMMENTS}`, `comments on #${number}`)
      const user = item["user"] as { readonly login?: unknown } | null | undefined
      const rawLabels = Array.isArray(item["labels"]) ? item["labels"] : []
      const labels = rawLabels
        .map((l) => (typeof l === "string" ? l : typeof (l as { readonly name?: unknown })?.name === "string" ? (l as { readonly name: string }).name : null))
        .filter((l): l is string => l !== null)
      if (!Array.isArray(commentsRaw)) throw new McpToolError({ code: "unavailable", message: "Malformed GitHub comments" })
      const comments = commentsRaw.slice(0, MAX_ISSUE_COMMENTS).map((c) => {
        const rec = c as Record<string, unknown>
        const author = rec["user"] as { readonly login?: unknown } | null | undefined
        return {
          author: typeof author?.login === "string" ? author.login : null,
          body: typeof rec["body"] === "string" ? rec["body"] : "",
          createdAt: typeof rec["created_at"] === "string" ? rec["created_at"] : "",
        }
      })
      return {
        number: Number(item["number"] ?? number),
        title: typeof item["title"] === "string" ? item["title"] : "",
        state: typeof item["state"] === "string" ? item["state"] : "open",
        author: typeof user?.login === "string" ? user.login : null,
        body: typeof item["body"] === "string" ? item["body"] : "",
        labels,
        createdAt: typeof item["created_at"] === "string" ? item["created_at"] : "",
        updatedAt: typeof item["updated_at"] === "string" ? item["updated_at"] : "",
        comments,
        commentsTruncated: hasNext || commentsRaw.length > MAX_ISSUE_COMMENTS,
      }
    }

  const listPulls = (
    owner: string,
    name: string,
    state: "open" | "closed" | "all",
  ): Effect.Effect<ReadonlyArray<PullSummary>, McpToolError> =>
    effect {
      const raw = try getJson(
        `${repoPath(owner, name)}/pulls?state=${encodeURIComponent(state)}&per_page=50`,
        "pull requests",
      )
      const list = Array.isArray(raw) ? raw : []
      return list.map((entry) => {
        const p = entry as Record<string, unknown>
        const user = p["user"] as { readonly login?: unknown } | null | undefined
        const head = p["head"] as { readonly ref?: unknown } | null | undefined
        const base = p["base"] as { readonly ref?: unknown } | null | undefined
        return {
          number: Number(p["number"] ?? 0),
          title: typeof p["title"] === "string" ? p["title"] : "",
          state: typeof p["state"] === "string" ? p["state"] : "open",
          author: typeof user?.login === "string" ? user.login : null,
          head: typeof head?.ref === "string" ? head.ref : "",
          base: typeof base?.ref === "string" ? base.ref : "",
          draft: p["draft"] === true,
          updatedAt: typeof p["updated_at"] === "string" ? p["updated_at"] : "",
        }
      })
    }

  const getPull = (owner: string, name: string, number: number): Effect.Effect<PullDetail & { readonly headSha?: string | undefined }, McpToolError> =>
    effect {
      const rp = repoPath(owner, name)
      const raw = try getJson(`${rp}/pulls/${number}`, `pull request #${number}`)
      const p = raw as Record<string, unknown>
      const user = p["user"] as { readonly login?: unknown } | null | undefined
      const head = p["head"] as { readonly ref?: unknown; readonly sha?: unknown } | null | undefined
      const base = p["base"] as { readonly ref?: unknown } | null | undefined
      // Pull request checks are Smithers flow runs, never GitHub Actions (ruling GH-1, github.no-actions).
      // An unindexed public GitHub repository has no Smithers runs yet, so `checks` stays empty here.
      const reviewsRaw = try getJson(`${rp}/pulls/${number}/reviews?per_page=100`, `reviews on #${number}`)
      if (!Array.isArray(reviewsRaw)) throw new McpToolError({ code: "unavailable", message: "Malformed GitHub reviews" })
      const reviews = reviewsRaw.map((entry) => {
        const r = entry as Record<string, unknown>
        const author = r["user"] as { readonly login?: unknown } | null | undefined
        return {
          author: typeof author?.login === "string" ? author.login : null,
          state: typeof r["state"] === "string" ? r["state"] : "",
          body: typeof r["body"] === "string" ? r["body"] : "",
        }
      })
      const checks: PullDetail["checks"] = []
      return {
        number: Number(p["number"] ?? number),
        title: typeof p["title"] === "string" ? p["title"] : "",
        state: typeof p["state"] === "string" ? p["state"] : "open",
        author: typeof user?.login === "string" ? user.login : null,
        head: typeof head?.ref === "string" ? head.ref : "",
        base: typeof base?.ref === "string" ? base.ref : "",
        draft: p["draft"] === true,
        updatedAt: typeof p["updated_at"] === "string" ? p["updated_at"] : "",
        body: typeof p["body"] === "string" ? p["body"] : "",
        reviews,
        checks,
        headSha: typeof head?.sha === "string" ? head.sha : undefined,
      }
    }

  const getPullFiles = (owner: string, name: string, number: number): Effect.Effect<PullFilesListing, McpToolError> =>
    effect {
      const rp = repoPath(owner, name)
      const raw = try getJson(`${rp}/pulls/${number}/files?per_page=100`, `files for pull request #${number}`)
      const list = Array.isArray(raw) ? raw : []
      const files = list.map((entry) => {
        const f = entry as Record<string, unknown>
        const prev = typeof f["previous_filename"] === "string" ? f["previous_filename"] : undefined
        return {
          filename: typeof f["filename"] === "string" ? f["filename"] : "",
          status: typeof f["status"] === "string" ? f["status"] : "modified",
          additions: Number(f["additions"] ?? 0),
          deletions: Number(f["deletions"] ?? 0),
          changes: Number(f["changes"] ?? 0),
          ...(prev === undefined ? {} : { previousFilename: prev }),
          patch: typeof f["patch"] === "string" ? f["patch"] : null,
        }
      })
      return { files, truncated: list.length >= 100 }
    }

  return { listRefs, readTree, readFile, listIssues, getIssue, listPulls, getPull, getPullFiles }
}

export interface LiveDepsOptions<R = never> {
  readonly database: Layer.Layer<SqlClient.SqlClient, unknown, R>
  readonly reads: Option.Option<ReturnType<typeof RepoReads.make<unknown, R>>>
  readonly repoCache: Layer.Layer<ImmutableCache.ImmutableCache>
  readonly starter: FlowStarter["Service"]
  /** Optional HTTP client for public GitHub fallback when a repo is not yet cloned/synced. */
  readonly githubFallbackClient?: HttpClient.HttpClient
  readonly githubApiBaseUrl?: string
  /** Optional deployment read token (`worker/github/ReadToken.ts`) to avoid GitHub's 60 req/hr shared-IP limit. */
  readonly githubReadToken?: ReadToken.ReadToken
  /** Optional repository docs source (`worker/docs/Source.ts`) for `docs_list` and `docs_read`. */
  readonly docsSource?: DocsSource["Service"]
}

/**
 * Binds `McpToolDeps` to ChatApi's live services: `RepoReads` (Code Storage + edge cache), Postgres projections
 * (`items`, `comments`, `pulls`, `reviews`, `runs`, `todos`), durable `github/Write` admission, `WorkLinks.write`,
 * and an unauthenticated read-only GitHub fallback for public repos not yet cloned/synced.
 */
export const makeLiveDeps = <R = never>(options: LiveDepsOptions<R>): Effect.Effect<McpToolDeps, never, R> =>
  effect {
    const context = try Effect.context<R>()
    const database = options.database.pipe(Layer.provide(Layer.succeedContext(context)))
    const { reads, repoCache, starter } = options
    const withCtx = <A, E>(eff: Effect.Effect<A, E, R>): Effect.Effect<A, E> => eff.pipe(Effect.provide(context))
    const fallbackClient = options.githubFallbackClient ?? Option.getOrUndefined(try Effect.serviceOption(HttpClient.HttpClient))
    const publicGitHub = fallbackClient === undefined
      ? undefined
      : makePublicGitHubReader(fallbackClient, options.githubApiBaseUrl, options.githubReadToken)

    const hasSyncedIssues = (owner: string, name: string): Effect.Effect<boolean, McpToolError> =>
      effect {
        const sql = try SqlClient.SqlClient
        const rows = try sql<{ readonly ok: number }>`
          SELECT 1 AS ok FROM github_sync WHERE repo_id = ${try sync(() => repoId(owner, name))} LIMIT 1`
        return rows.length > 0
      }.pipe(Effect.provide(database), Effect.mapError(mapSqlError("github_sync")))

    type Mirror = ReturnType<typeof RepoReads.make<unknown, R>>
    const mirrored = <A>(local: (mirror: Mirror) => Effect.Effect<A, RepoReads.ReadRefused | McpToolError>,
      upstream: (reader: PublicGitHubReader) => Effect.Effect<A, McpToolError>) => {
      if (Option.isNone(reads)) return publicGitHub === undefined
        ? Effect.fail(new McpToolError({ code: "unavailable", message: "Code storage is not configured" }))
        : upstream(publicGitHub)
      return local(reads.value).pipe(Effect.catchTag("ReadRefused", error =>
        error.code === "not_imported" && publicGitHub !== undefined ? upstream(publicGitHub) : Effect.fail(mapReadError(error))))
    }

    const resolveSha = (mirror: Mirror, owner: string, name: string, ref?: string) =>
      effect {
        if (ref !== undefined && SHA_RE.test(ref)) return ref.toLowerCase()
        const listing = try withCtx(mirror.refs(owner, name).pipe(Effect.provide(repoCache)))
        if (ref === undefined || ref === listing.defaultBranch) return listing.head
        const branch = listing.branches.find((b) => b.name === ref)
        if (branch !== undefined) return branch.sha
        const tag = listing.tags.find((t) => t.name === ref)
        if (tag !== undefined) return tag.sha
        throw new McpToolError({ code: "not_found", message: `Unknown ref ${ref}` })
      }

    const admitWrite = (
      owner: string,
      name: string,
      writeId: string,
      personId: string,
      payload: { readonly op: "issue/create"; readonly title: string; readonly body: string } | { readonly op: "issue/comment"; readonly number: number; readonly body: string },
    ): Effect.Effect<WriteReceipt, McpToolError> =>
      effect {
        const id = try sync(() => repoId(owner, name))
        const via = "agent" as const
        const payloadHash = try Effect.try(() => digestSync(JSON.stringify({ via, ...payload }))).pipe(Effect.orDie)
        const inserted = try Store.insertWrite({
          id: writeId,
          repoId: id,
          actorId: personId,
          sessionId: null,
          via,
          payload,
          payloadHash,
        }).pipe(Effect.provide(database), Effect.mapError(mapSqlError(payload.op)))

        if (inserted.kind === "stale") {
          throw new McpToolError({ code: "forbidden", message: "Repository permission no longer holds" })
        }
        if (inserted.kind === "taken" || (inserted.kind === "existing" && inserted.payloadHash !== payloadHash)) {
          throw new McpToolError({ code: "conflict", message: "Idempotency key already used for a different write" })
        }
        if (inserted.kind === "inserted" || inserted.status === "pending") {
          try starter.start(Write, {
            executionId: try sync(() => writeExecutionId(writeId)),
            payload: { writeId },
          }).pipe(
            Effect.mapError(() => new McpToolError({ code: "unavailable", message: "Could not start durable GitHub write" })),
          )
        }
        return {
          writeId,
          status: inserted.kind === "inserted" ? "pending" : inserted.status,
        }
      }

    return try sync(() => makeLiveToolDeps({
      readTree: (owner, name, ref) => mirrored(mirror => effect {
        const sha = try resolveSha(mirror, owner, name, ref)
        const bytes = try withCtx(mirror.tree(owner, name, sha).pipe(Effect.provide(repoCache)))
        const parsed = try decodeTree(decoder.decode(bytes)).pipe(
          Effect.mapError(() => new McpToolError({ code: "unavailable", message: "Malformed tree listing" })),
        )
        return { ref: sha, paths: parsed.paths, truncated: parsed.truncated }
      }, reader => reader.readTree(owner, name, ref)),

      readFile: (owner, name, path, ref) => mirrored(mirror => effect {
        const sha = try resolveSha(mirror, owner, name, ref)
        const entry = try withCtx(mirror.blob(owner, name, sha, path).pipe(Effect.provide(repoCache)))
        return { path, ref: sha, content: (try sync(() => textOf(entry.bytes))) ?? "\u0000" }
      }, reader => reader.readFile(owner, name, path, ref)),

      listRefs: (owner, name) => mirrored<RefListing>(mirror => effect {
        const listing = try withCtx(mirror.refs(owner, name).pipe(Effect.provide(repoCache)))
        return {
          defaultBranch: listing.defaultBranch, head: listing.head,
          branches: listing.branches.map(b => b.name), tags: listing.tags.map(t => t.name),
        }
      }, reader => reader.listRefs(owner, name)),

      listIssues: (owner, name, query) =>
        effect {
          if (query.cursor?.startsWith("gh_") && publicGitHub !== undefined) return try publicGitHub.listIssues(owner, name, query)
          const encodedCursor = query.cursor
          const cursor = encodedCursor === undefined ? undefined : try sync(() => IssueList.decodeCursor(encodedCursor))
          if (query.cursor !== undefined && cursor === undefined) {
            throw new McpToolError({ code: "invalid_params", message: "Invalid pagination cursor" })
          }
          const found = try IssueList.page(try sync(() => repoId(owner, name)), {
            state: query.state,
            q: query.q,
            limit: query.limit,
            cursor,
            work: undefined,
          }).pipe(Effect.provide(database), Effect.mapError(mapSqlError("issues_list")))
          if (found.issues.length === 0 && query.cursor === undefined && publicGitHub !== undefined) {
            if (!(try hasSyncedIssues(owner, name))) {
              return try publicGitHub.listIssues(owner, name, query)
            }
          }
          return {
            issues: found.issues.map((issue) => ({
              number: issue.number,
              title: issue.title,
              state: issue.state,
              author: issue.author.login,
              comments: issue.comments,
              updatedAt: issue.updated_at,
              triage: issue.triage,
              work: issue.work.status,
            })),
            nextCursor: found.next ?? null,
          }
        },

      getIssue: (owner, name, number) =>
        effect {
          const sql = try SqlClient.SqlClient
          const id = try sync(() => repoId(owner, name))
          const [item] = try sql<{
            readonly id: string
            readonly number: number
            readonly title: string
            readonly state: string
            readonly author_login: string | null
            readonly body: string
            readonly triage: string
            readonly commitment: string | null
            readonly created_at: string
            readonly updated_at: string
          }>`
            SELECT id, number, title, state, author_login, body, triage, commitment,
              to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS created_at,
              to_char(updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS updated_at
            FROM items
            WHERE repo_id = ${id} AND number = ${number} AND kind = 'issue' AND deleted_at IS NULL`
          if (item === undefined) {
            if (publicGitHub !== undefined && !(try hasSyncedIssues(owner, name))) {
              return try publicGitHub.getIssue(owner, name, number)
            }
            throw new McpToolError({ code: "not_found", message: `Issue #${number} not found` })
          }
          const comments = try sql<{
            readonly author_login: string | null
            readonly body: string
            readonly created_at: string
          }>`
            SELECT author_login, body,
              to_char(created_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS created_at
            FROM comments
            WHERE repo_id = ${id} AND item_id = ${item.id} AND deleted_at IS NULL
            ORDER BY created_at ASC, id ASC
            LIMIT ${MAX_ISSUE_COMMENTS + 1}`
          const labels: Array<string> = []
          if (item.triage === "accepted") labels.push("smithers:accepted")
          else if (item.triage === "not_accepted") labels.push("smithers:not-accepted")
          if (item.commitment !== null) labels.push(`smithers:${item.commitment}`)
          return {
            number: item.number,
            title: item.title,
            state: item.state,
            author: item.author_login,
            body: item.body,
            labels,
            createdAt: item.created_at,
            updatedAt: item.updated_at,
            comments: comments.map((c) => ({ author: c.author_login, body: c.body, createdAt: c.created_at })),
          }
        }.pipe(
          Effect.provide(database),
          Effect.mapError((error) => (error instanceof McpToolError ? error : mapSqlError("issue_get")())),
        ),

      listPulls: (owner, name, state = "open") =>
        effect {
          const sql = try SqlClient.SqlClient
          const id = try sync(() => repoId(owner, name))
          const rows = try sql<{
            readonly number: number
            readonly title: string
            readonly state: string
            readonly author_login: string | null
            readonly head_ref: string
            readonly base_ref: string
            readonly draft: boolean
            readonly updated_at: string
          }>`
            SELECT i.number, i.title, i.state, i.author_login, p.head_ref, p.base_ref, p.draft,
              to_char(i.updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS updated_at
            FROM pulls p
            JOIN items i ON i.id = p.item_id
            WHERE p.repo_id = ${id} AND i.deleted_at IS NULL
              ${state === "all" ? sql`` : sql`AND i.state = ${state}`}
            ORDER BY i.updated_at DESC, i.number DESC
            LIMIT 50`
          if (rows.length === 0 && publicGitHub !== undefined && !(try hasSyncedIssues(owner, name))) {
            return try publicGitHub.listPulls(owner, name, state)
          }
          return rows.map((row) => ({
            number: row.number,
            title: row.title,
            state: row.state,
            author: row.author_login,
            head: row.head_ref,
            base: row.base_ref,
            draft: row.draft,
            updatedAt: row.updated_at,
          }))
        }.pipe(
          Effect.provide(database),
          Effect.mapError((error) => (error instanceof McpToolError ? error : mapSqlError("pulls_list")())),
        ),

      getPull: (owner, name, number) =>
        effect {
          const sql = try SqlClient.SqlClient
          const id = try sync(() => repoId(owner, name))
          const [pull] = try sql<{
            readonly item_id: string
            readonly number: number
            readonly title: string
            readonly state: string
            readonly author_login: string | null
            readonly body: string
            readonly head_ref: string
            readonly head_sha: string
            readonly base_ref: string
            readonly draft: boolean
            readonly updated_at: string
          }>`
            SELECT p.item_id, i.number, i.title, i.state, i.author_login, i.body,
              p.head_ref, p.head_sha, p.base_ref, p.draft,
              to_char(i.updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS updated_at
            FROM pulls p
            JOIN items i ON i.id = p.item_id
            WHERE p.repo_id = ${id} AND p.number = ${number} AND i.deleted_at IS NULL`
          const checksForSha = (headSha: string | undefined) =>
            headSha === undefined
              ? Effect.succeed([] as PullDetail["checks"])
              : sql<{ readonly flow: string; readonly status: string }>`
                  SELECT flow, status
                  FROM runs
                  WHERE repo_id = ${id} AND sha = ${headSha}
                  ORDER BY created_at DESC
                  LIMIT 50`.pipe(
                  Effect.map((rows) =>
                    rows.map((r) => ({
                      name: r.flow,
                      status: r.status,
                      conclusion: r.status === "completed" ? "success" : r.status === "failed" ? "failure" : null,
                    })),
                  ),
                )
          if (pull === undefined) {
            if (publicGitHub !== undefined && !(try hasSyncedIssues(owner, name))) {
              const { headSha, ...detail } = try publicGitHub.getPull(owner, name, number)
              return { ...detail, checks: try checksForSha(headSha) }
            }
            throw new McpToolError({ code: "not_found", message: `Pull request #${number} not found` })
          }
          const reviews = try sql<{
            readonly author_login: string | null
            readonly state: string
            readonly body: string
          }>`
            SELECT author_login, state, body
            FROM reviews
            WHERE repo_id = ${id} AND item_id = ${pull.item_id}
            ORDER BY submitted_at ASC NULLS LAST, id ASC
            LIMIT 100`
          const checks = try checksForSha(pull.head_sha)
          return {
            number: pull.number,
            title: pull.title,
            state: pull.state,
            author: pull.author_login,
            head: pull.head_ref,
            base: pull.base_ref,
            draft: pull.draft,
            updatedAt: pull.updated_at,
            body: pull.body,
            reviews: reviews.map((r) => ({ author: r.author_login, state: r.state, body: r.body })),
            checks,
          }
        }.pipe(
          Effect.provide(database),
          Effect.mapError((error) => (error instanceof McpToolError ? error : mapSqlError("pull_get")())),
        ),

      getPullFiles: (owner, name, number) =>
        publicGitHub === undefined
          ? Effect.fail(new McpToolError({ code: "unavailable", message: "GitHub client is not configured" }))
          : publicGitHub.getPullFiles(owner, name, number),

      listDocs: (owner, name, q) =>
        effect {
          if (options.docsSource === undefined) {
            throw new McpToolError({ code: "unavailable", message: "Documentation source is not configured" })
          }
          const read = try options.docsSource.index(owner, name)
          if (read._tag === "Refused") {
            if (read.code === "no_docs" || read.code === "not_found" || read.code === "page_not_found") {
              throw new McpToolError({ code: "not_found", message: `No documentation index for ${owner}/${name}` })
            }
            throw new McpToolError({ code: "unavailable", message: `Documentation index unavailable (${read.code})` })
          }
          const query = q.trim()
          const matched = query === "" ? read.index.pages.slice(0, MAX_LISTED) : try sync(() => Docs.search(read.index, query, SEARCH_LIMIT))
          const truncated = query === "" ? read.index.pages.length > MAX_LISTED : false
          return {
            title: read.index.title,
            source: read.source,
            pages: matched.map((page) => ({
              title: page.title,
              path: page.path,
              ...(page.description === undefined ? {} : { description: page.description }),
              ...(page.section === undefined ? {} : { section: page.section }),
            })),
            truncated,
          }
        },

      readDoc: (owner, name, docPath) =>
        effect {
          if (options.docsSource === undefined) {
            throw new McpToolError({ code: "unavailable", message: "Documentation source is not configured" })
          }
          const read = try options.docsSource.page(owner, name, docPath)
          if (read._tag === "Refused") {
            if (read.code === "page_not_found" || read.code === "no_docs" || read.code === "not_found") {
              throw new McpToolError({ code: "not_found", message: `Documentation page ${docPath} not found` })
            }
            throw new McpToolError({ code: "unavailable", message: `Documentation page unavailable (${read.code})` })
          }
          return {
            title: read.page.title,
            path: read.page.path,
            url: read.page.url,
            content: read.text,
          }
        },

      createIssue: (params) =>
        admitWrite(params.owner, params.name, params.writeId, params.personId, {
          op: "issue/create",
          title: params.title,
          body: stripDuplicateFooter(params.body, params.login),
        }),

      commentIssue: (params) =>
        admitWrite(params.owner, params.name, params.writeId, params.personId, {
          op: "issue/comment",
          number: params.number,
          body: stripDuplicateFooter(params.body, params.login),
        }),

      listTodos: (owner, name) =>
        effect {
          const sql = try SqlClient.SqlClient
          const rows = try sql<{
            readonly id: string
            readonly title: string
            readonly state: string
            readonly position: number | null
            readonly number: number
          }>`
            SELECT id::text, title, state, position, number
            FROM todos
            WHERE repo_id = ${try sync(() => repoId(owner, name))}
            ORDER BY position ASC NULLS LAST, number DESC
            LIMIT 100`
          return rows.map((row) => ({
            id: row.id,
            title: row.title,
            state: row.state,
            position: row.position ?? row.number,
            lane: null,
          }))
        }.pipe(Effect.provide(database), Effect.mapError(mapSqlError("todo_list"))),

      postWorkLink: (params) =>
        effect {
          const now = try Clock.currentTimeMillis
          const written = try WorkLinks.write(
            try sync(() => repoId(params.owner, params.name)),
            params.number,
            {
              links: [
                {
                  kind: params.kind,
                  ref: params.ref,
                  state: params.status,
                  ...(params.url === undefined ? {} : { url: params.url }),
                  ...(params.summary === undefined ? {} : { label: params.summary }),
                },
              ],
            },
            params.source,
            now,
          ).pipe(Effect.provide(database), Effect.mapError(mapSqlError("work_link_post")))
          return { recorded: Option.isSome(written) && written.value.changed > 0 }
        },
    }))
  }
