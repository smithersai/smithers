/**
 * First-class Smithers Cloud MCP tools for full agent dogfooding:
 * - Shared Cloud Object Store: `artifact_list`, `artifact_get`, `artifact_put`
 * - Stacked Changesets: `changeset_stack_list`, `changeset_create`
 * - Project Wiki: `wiki_list`, `wiki_read`, `wiki_write`
 * - Mythical History: `mythical_history_list`, `mythical_history_record`
 * - Lighthouse / Uphill Backpressure Audit Reports: `audit_report_list`, `audit_report_get`, `audit_report_publish`
 * - One-Time Sandbox & Agent Auth: `auth_one_time_mint`
 *
 * Security invariants:
 * - Every call resolves live repository access through `McpAuthService` (never frozen token roles).
 * - Execution trust is ALWAYS computed server-side from live role / sandbox attestation, never from tool args.
 * - Untrusted contributors are encouraged to publish untrusted audit reports, artifacts, changesets, and wiki
 *   proposals, while being strictly refused from poisoning `cache`, canonical `mythical`, or trusted merge gates.
 * - Ops repos (`Smithers-Ops`) are fenced to deployment admins acting in person (never exposed through MCP agents).
 * - Person-only acts (`pull/merge`, `todo/commit`, `todo/drop`, `secrets/write`) remain strictly blocked.
 */

import { Uphill } from "@smthrs/rpc"
import { SqlClient } from "effect/sql"
import type { Visibility as FeedVisibility } from "../../src/features/feeds/contract.ts"
import { isRepository, repoId } from "../../src/features/repo/contract.ts"
import {
  isTrustedExecution,
  MAX_OBJECT_MCP_BYTES,
  OBJECT_NAMESPACES,
  ONE_TIME_AUTH_PURPOSES,
  type MythicalCommitNote,
  type ObjectNamespace,
  type OneTimeAuthPurpose,
} from "../../src/features/trust/contract.ts"
import * as DeploymentPolicy from "../DeploymentPolicy.vibe"
import { codeOf } from "../ErrorCode.ts"
import * as UphillIndex from "../feeds/UphillIndex.vibe"
import * as CloudObjectStore from "../object-store/CloudObjectStore.vibe"
import { safeJsonStringify } from "../object-store/ObjectBytes.ts"
import * as RepoStateStore from "../object-store/RepoStateStore.vibe"
import * as Visibility from "../ops/ArtifactVisibility.ts"
import { auditReportTrust, classifyExecutionTrust, isObjectNamespace } from "../trust/ExecutionTrust.vibe"
import {
  McpAuthService,
  type McpContentBlock,
  type McpPrincipal,
  type McpToolContext,
  type McpToolDescriptor,
  McpToolError,
} from "./Contract.vibe"
import * as OneTimeAuth from "./OneTimeAuth.vibe"

export interface CloudFactoryToolResult {
  readonly content: ReadonlyArray<McpContentBlock>
  readonly isError?: boolean
}

export interface CreatePullParams {
  readonly owner: string
  readonly name: string
  readonly title: string
  readonly body: string
  readonly head: string
  readonly base: string
  readonly draft: boolean
  readonly login: string
}

export interface CreatePullReceipt {
  readonly number: number
  readonly url: string
  readonly state: string
  readonly draft: boolean
}

export interface CloudFactoryDeps {
  readonly database: Layer.Layer<SqlClient.SqlClient, unknown>
  readonly policy: Visibility.Policy
  readonly r2?: CloudObjectStore.R2ByteBacking | undefined
  readonly origin?: string | undefined
  readonly createPull?: ((params: CreatePullParams) => CreatePullReceipt!McpToolError) | undefined
}

export const CLOUD_FACTORY_TOOL_NAMES = [
  "artifact_list",
  "artifact_get",
  "artifact_put",
  "changeset_stack_list",
  "changeset_create",
  "wiki_list",
  "wiki_read",
  "wiki_write",
  "mythical_history_list",
  "mythical_history_record",
  "audit_report_list",
  "audit_report_get",
  "audit_report_publish",
  "auth_one_time_mint",
  "pull_create",
] as const

export type CloudFactoryToolName = (typeof CLOUD_FACTORY_TOOL_NAMES)[number]

export function isCloudFactoryTool(name: string): name is CloudFactoryToolName {
  return (CLOUD_FACTORY_TOOL_NAMES as ReadonlyArray<string>).includes(name)
}

const repoProps = {
  owner: { type: "string", description: "Repository owner. Omit to use this endpoint repository." },
  repo: { type: "string", description: "Repository name. Omit to use this endpoint repository." },
  repository: { type: "string", description: "`owner/name`, instead of `owner` and `repo`." },
}

