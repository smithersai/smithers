/**
 * Postgres persistence for deployment-wide fleet telemetry (`host_nodes`,
 * `observed_sessions`, `provider_accounts`) backed by ElectricSQL replication.
 *
 * Defense in depth (OBS-5): every free-form text a reporter sends is scrubbed before storage, provider grant telemetry
 * is reduced to an allowlist of fields, transcript entries are bounded and scrubbed, and every list is bounded, so
 * credentials or tokens never enter Postgres or Electric shapes. Each report commits whole or not at all.
 */

import { SqlClient } from "effect/sql"
import {
  ACCOUNT_PROVIDERS,
  ACCOUNT_STATUSES,
  HOST_KINDS,
  SESSION_HARNESSES,
  SESSION_STATUSES,
  TRANSCRIPT_ROLES,
  type TranscriptEntry,
  type TranscriptRole,
} from "../../src/features/fleet/globalContract.ts"

const SECRET_PATTERN =
  /(gh[pousr]_[A-Za-z0-9_]+|github_pat_[A-Za-z0-9_]+|sk-ant-[A-Za-z0-9_-]+|sk-[A-Za-z0-9_-]{16,}|sma_[0-9a-f]{32,}|xox[baprs]-[A-Za-z0-9-]+|AKIA[0-9A-Z]{16}|Bearer\s+[A-Za-z0-9._-]{12,}|(?:TOKEN|SECRET|PASSWORD|API_KEY)\s*=\s*\S+)/gi

/** Scrubs accidental credential patterns and bounds text length. */
export function scrubText(value: string | null | undefined, maxLen: number): string | null {
  if (value === undefined || value === null) return null
  const cleaned = value.replace(SECRET_PATTERN, "[redacted]").replace(/[\r\n\t]+/g, " ").trim()
  return cleaned.length === 0 ? null : cleaned.slice(0, maxLen)
}

/** A required display text, scrubbed: `fallback` when nothing is left of it. */
function scrubRequired(value: string, maxLen: number, fallback: string): string {
  return scrubText(value, maxLen) ?? fallback.slice(0, maxLen)
}

/** Free-form tags (a host's labels, an account's pools), each scrubbed, without repeats. */
function scrubTags(values: ReadonlyArray<string> | undefined): Array<string> {
  const kept = new Set<string>()
  for (const value of values ?? []) {
    const tag = scrubText(value, MAX_TAG_LENGTH)
    if (tag !== null) kept.add(tag)
  }
  return [...kept]
}

/** The most sessions one report carries, and the most accounts. A larger report is refused whole. */
export const MAX_SESSIONS_PER_REPORT = 500
export const MAX_ACCOUNTS_PER_REPORT = 200
/** The most labels a host carries, and pools an account. */
export const MAX_TAGS = 32
const MAX_TAG_LENGTH = 64
/** The most entries an account's `grants` list keeps. */
export const MAX_GRANTS = 32
/** The most transcript entries stored per observed session. */
export const MAX_TRANSCRIPT_ENTRIES = 24
const MAX_TRANSCRIPT_TEXT_LENGTH = 360
const MAX_TRANSCRIPT_LABEL_LENGTH = 80

/**
 * Scrubs and bounds a session's transcript entries (OBS-5): keeps at most the last 24 entries,
 * validates the role allowlist, scrubs `text` (max 360 chars) and `label` (max 80 chars) through
 * `scrubText`, and normalizes timestamps so credentials or raw dumps never enter Postgres or Electric.
 */
export function scrubTranscript(raw: unknown): ReadonlyArray<TranscriptEntry> | null {
  let list: unknown = raw
  if (typeof list === "string") {
    try {
      list = JSON.parse(list)
    } catch {
      return null
    }
  }
  if (!Array.isArray(list)) return null
  const kept: Array<TranscriptEntry> = []
  for (const item of list) {
    if (typeof item !== "object" || item === null || Array.isArray(item)) continue
    const obj = item as Record<string, unknown>
    const rawRole = obj["role"]
    if (typeof rawRole !== "string" || !(TRANSCRIPT_ROLES as ReadonlyArray<string>).includes(rawRole)) continue
    const rawText = obj["text"]
    if (typeof rawText !== "string") continue
    const text = scrubText(rawText, MAX_TRANSCRIPT_TEXT_LENGTH)
    if (text === null) continue
    const rawLabel = obj["label"]
    const label = typeof rawLabel === "string" ? scrubText(rawLabel, MAX_TRANSCRIPT_LABEL_LENGTH) : null
    const rawTs = obj["ts"]
    const ts = typeof rawTs === "string" && rawTs.length <= 64 && !Number.isNaN(Date.parse(rawTs))
      ? new Date(Date.parse(rawTs)).toISOString()
      : null
    kept.push({
      ts,
      role: rawRole as TranscriptRole,
      label,
      text,
    })
  }
  if (kept.length === 0) return null
  return kept.slice(-MAX_TRANSCRIPT_ENTRIES)
}

/**
 * The fields a provider's grant telemetry may carry (R1-Astra-D4-011). Everything else a reporter sends, at any depth,
 * is dropped before it is stored and again before a stored row is read, so a token, an email or a prompt in a
 * provider's raw answer never reaches Postgres, the overview or a device.
 */
const GRANT_NUMBERS = ["pct", "limit", "used", "remaining"] as const
const GRANT_TEXTS = ["name", "kind", "resetsAt"] as const

const quantity = (value: unknown): number | undefined =>
  typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : undefined

function projectGrant(raw: unknown): Record<string, string | number> | string | null {
  if (typeof raw === "string") return scrubText(raw, MAX_TAG_LENGTH)
  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) return null
  const entry: Record<string, string | number> = {}
  for (const key of GRANT_NUMBERS) {
    const value = quantity(Object.hasOwn(raw, key) ? (raw as Record<string, unknown>)[key] : undefined)
    if (value !== undefined) entry[key] = value
  }
  for (const key of GRANT_TEXTS) {
    const value = Object.hasOwn(raw, key) ? (raw as Record<string, unknown>)[key] : undefined
    const text = typeof value === "string" ? scrubText(value, MAX_TAG_LENGTH) : null
    if (text !== null) entry[key] = text
  }
  return Object.keys(entry).length === 0 ? null : entry
}

/** A reported or stored `grantsJson`, reduced to its approved fields: `null` when none is left. */
export function projectGrants(raw: unknown): Record<string, unknown> | null {
  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) return null
  const source = raw as Record<string, unknown>
  const kept: Record<string, unknown> = {}
  const policy = Object.hasOwn(source, "policy") && typeof source["policy"] === "string"
    ? scrubText(source["policy"], MAX_TAG_LENGTH)
    : null
  if (policy !== null) kept["policy"] = policy
  const credits = quantity(Object.hasOwn(source, "resetCreditsAvailable") ? source["resetCreditsAvailable"] : undefined)
  if (credits !== undefined) kept["resetCreditsAvailable"] = credits
  if (Object.hasOwn(source, "grants") && Array.isArray(source["grants"])) {
    const grants = source["grants"].slice(0, MAX_GRANTS).map(projectGrant).filter((grant) => grant !== null)
    if (grants.length > 0) kept["grants"] = grants
  }
  return Object.keys(kept).length === 0 ? null : kept
}

/** A timestamp a report carries: refused with the report unless a date reads from it. */
const Timestamp = Schema.String.check(
  Schema.isMaxLength(64),
  Schema.makeFilter((value: string) => !Number.isNaN(Date.parse(value))),
)

/** The timestamp as Postgres stores it, so no row of an admitted report fails its cast. */
const instant = (value: string | null | undefined): string | null =>
  value === undefined || value === null ? null : new Date(Date.parse(value)).toISOString()

export const HostHeartbeatInput = Schema.Struct({
  nodeId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
  name: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
  kind: Schema.Literals(HOST_KINDS),
  labels: Schema.optional(Schema.Array(Schema.String.check(Schema.isMaxLength(MAX_TAG_LENGTH))).check(Schema.isMaxLength(MAX_TAGS))),
  online: Schema.optional(Schema.Boolean),
  held: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(120)))),
  load1: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  cpuCores: Schema.optional(Schema.NullOr(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)))),
  memUsedGb: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  memTotalGb: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  diskFreeGb: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  diskTotalGb: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  activeSessions: Schema.optional(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
  runnerCapacity: Schema.optional(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
  version: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(64)))),
})
export type HostHeartbeatInput = typeof HostHeartbeatInput.Type

export const ObservedSessionInput = Schema.Struct({
  sessionKey: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256)),
  managed: Schema.optional(Schema.Boolean),
  harness: Schema.Literals(SESSION_HARNESSES),
  model: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(120)))),
  accountLabel: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(64)))),
  repo: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(160)))),
  project: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(200)))),
  lane: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(120)))),
  title: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(320)))),
  summary: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(480)))),
  cwd: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(512)))),
  transcriptJson: Schema.optional(Schema.NullOr(Schema.Array(Schema.Unknown).check(Schema.isMaxLength(64)))),
  status: Schema.Literals(SESSION_STATUSES),
  pid: Schema.optional(Schema.NullOr(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)))),
  cpuSeconds: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  tokensUsed: Schema.optional(Schema.NullOr(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0)))),
  startedAt: Schema.optional(Schema.NullOr(Timestamp)),
  lastActivityAt: Schema.optional(Schema.NullOr(Timestamp)),
  endedAt: Schema.optional(Schema.NullOr(Timestamp)),
})
export type ObservedSessionInput = typeof ObservedSessionInput.Type

export const SessionsReportInput = Schema.Struct({
  nodeId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
  replaceActive: Schema.optional(Schema.Boolean),
  sessions: Schema.Array(ObservedSessionInput).check(Schema.isMaxLength(MAX_SESSIONS_PER_REPORT)),
})
export type SessionsReportInput = typeof SessionsReportInput.Type

export const ProviderAccountInput = Schema.Struct({
  accountKey: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
  provider: Schema.Literals(ACCOUNT_PROVIDERS),
  label: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(64)),
  plan: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(64)))),
  status: Schema.Literals(ACCOUNT_STATUSES),
  fiveHourPct: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 200 })))),
  weeklyPct: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 200 })))),
  scopedPct: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isBetween({ minimum: 0, maximum: 200 })))),
  resetsAt: Schema.optional(Schema.NullOr(Timestamp)),
  // Any object decodes; only its approved fields are kept (`projectGrants`).
  grantsJson: Schema.optional(Schema.NullOr(Schema.Record(Schema.String, Schema.Unknown))),
  creditsBalance: Schema.optional(Schema.NullOr(Schema.Number.check(Schema.isGreaterThanOrEqualTo(0)))),
  activeSessions: Schema.optional(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
  pools: Schema.optional(Schema.Array(Schema.String.check(Schema.isMaxLength(MAX_TAG_LENGTH))).check(Schema.isMaxLength(MAX_TAGS))),
  coolReason: Schema.optional(Schema.NullOr(Schema.String.check(Schema.isMaxLength(120)))),
  coolUntil: Schema.optional(Schema.NullOr(Timestamp)),
  checkedAt: Schema.optional(Schema.NullOr(Timestamp)),
})
export type ProviderAccountInput = typeof ProviderAccountInput.Type

export const AccountsReportInput = Schema.Struct({
  sourceNode: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(128)),
  accounts: Schema.Array(ProviderAccountInput).check(Schema.isMaxLength(MAX_ACCOUNTS_PER_REPORT)),
})
export type AccountsReportInput = typeof AccountsReportInput.Type

export effect function upsertHostNode(input: HostHeartbeatInput) {
  const sql = try SqlClient.SqlClient
  const name = scrubRequired(input.name, 128, input.nodeId)
  const labels = scrubTags(input.labels)
  const held = scrubText(input.held, 120)
  const version = scrubText(input.version, 64)
  try sql`
    INSERT INTO host_nodes (
      node_id, name, kind, labels, online, held,
      load1, cpu_cores, mem_used_gb, mem_total_gb,
      disk_free_gb, disk_total_gb, active_sessions, runner_capacity,
      version, seen_at, updated_at
    ) VALUES (
      ${input.nodeId}, ${name}, ${input.kind}, ${labels}, ${input.online ?? true}, ${held},
      ${input.load1 ?? null}, ${input.cpuCores ?? null}, ${input.memUsedGb ?? null}, ${input.memTotalGb ?? null},
      ${input.diskFreeGb ?? null}, ${input.diskTotalGb ?? null}, ${input.activeSessions ?? 0}, ${input.runnerCapacity ?? 0},
      ${version}, now(), now()
    )
    ON CONFLICT (node_id) DO UPDATE SET
      name = EXCLUDED.name,
      kind = EXCLUDED.kind,
      labels = EXCLUDED.labels,
      online = EXCLUDED.online,
      held = EXCLUDED.held,
      load1 = EXCLUDED.load1,
      cpu_cores = EXCLUDED.cpu_cores,
      mem_used_gb = EXCLUDED.mem_used_gb,
      mem_total_gb = EXCLUDED.mem_total_gb,
      disk_free_gb = EXCLUDED.disk_free_gb,
      disk_total_gb = EXCLUDED.disk_total_gb,
      active_sessions = EXCLUDED.active_sessions,
      runner_capacity = EXCLUDED.runner_capacity,
      version = EXCLUDED.version,
      seen_at = now(),
      updated_at = now()
  `
  return { nodeId: input.nodeId, ok: true }
}

/**
 * A host's report of its sessions, committed whole or not at all (R1-Astra-D4-014): its rows, the sessions it ends and
 * the host's count are one transaction, and reports for one host run one after another. A session key named twice
 * counts once, as its last entry. The count is read from the host's rows after the report, so a report of one changed
 * session leaves the host's other active sessions counted.
 */
export effect function reportSessions(input: SessionsReportInput) {
  const sql = try SqlClient.SqlClient
  const byKey = new Map<string, ObservedSessionInput>()
  for (const s of input.sessions) byKey.set(s.sessionKey, s)
  const seenKeys = [...byKey.keys()]
  const active = try sql.withTransaction(effect {
    try sql`SELECT pg_advisory_xact_lock(hashtextextended(${`fleet-sessions:${input.nodeId}`}, 0))`
    for (const s of byKey.values()) {
      const title = scrubText(s.title, 160)
      const lane = scrubText(s.lane, 120)
      const repo = scrubText(s.repo, 160)
      const project = scrubText(s.project, 160)
      const summary = scrubText(s.summary, 320)
      const cwd = scrubText(s.cwd, 260)
      const model = scrubText(s.model, 120)
      const accountLabel = scrubText(s.accountLabel, 64)
      const transcript = scrubTranscript(s.transcriptJson)
      const transcriptText = transcript === null ? null : JSON.stringify(transcript)
      try sql`
        INSERT INTO observed_sessions (
          session_key, node_id, managed, harness, model, account_label,
          repo, project, lane, title, summary, cwd, transcript_json,
          status, pid, cpu_seconds, tokens_used,
          started_at, last_activity_at, ended_at, updated_at
        ) VALUES (
          ${s.sessionKey}, ${input.nodeId}, ${s.managed ?? false}, ${s.harness}, ${model}, ${accountLabel},
          ${repo}, ${project}, ${lane}, ${title}, ${summary}, ${cwd}, ${transcriptText}::jsonb,
          ${s.status}, ${s.pid ?? null}, ${s.cpuSeconds ?? null}, ${s.tokensUsed ?? null},
          ${instant(s.startedAt)}::timestamptz, ${instant(s.lastActivityAt)}::timestamptz, ${instant(s.endedAt)}::timestamptz, now()
        )
        ON CONFLICT (session_key) DO UPDATE SET
          node_id = EXCLUDED.node_id,
          managed = EXCLUDED.managed,
          harness = EXCLUDED.harness,
          model = EXCLUDED.model,
          account_label = EXCLUDED.account_label,
          repo = EXCLUDED.repo,
          project = EXCLUDED.project,
          lane = EXCLUDED.lane,
          title = EXCLUDED.title,
          summary = EXCLUDED.summary,
          cwd = EXCLUDED.cwd,
          transcript_json = EXCLUDED.transcript_json,
          status = EXCLUDED.status,
          pid = EXCLUDED.pid,
          cpu_seconds = EXCLUDED.cpu_seconds,
          tokens_used = EXCLUDED.tokens_used,
          started_at = COALESCE(EXCLUDED.started_at, observed_sessions.started_at),
          last_activity_at = COALESCE(EXCLUDED.last_activity_at, observed_sessions.last_activity_at),
          ended_at = EXCLUDED.ended_at,
          updated_at = now()
      `
    }
    if (input.replaceActive === true) {
      if (seenKeys.length === 0) {
        try sql`
          UPDATE observed_sessions
          SET status = 'ended', ended_at = COALESCE(ended_at, now()), updated_at = now()
          WHERE node_id = ${input.nodeId} AND status <> 'ended'
        `
      } else {
        try sql`
          UPDATE observed_sessions
          SET status = 'ended', ended_at = COALESCE(ended_at, now()), updated_at = now()
          WHERE node_id = ${input.nodeId} AND status <> 'ended' AND NOT (session_key = ANY(${seenKeys}))
        `
      }
    }
    const counted = try sql<{ active: number }>`
      SELECT count(*)::int AS active FROM observed_sessions
      WHERE node_id = ${input.nodeId} AND status <> 'ended'
    `
    const activeCount = counted[0]?.active ?? 0
    try sql`
      UPDATE host_nodes
      SET active_sessions = ${activeCount}, seen_at = now(), updated_at = now()
      WHERE node_id = ${input.nodeId}
    `
    return activeCount
  })
  return { nodeId: input.nodeId, reported: seenKeys.length, active }
}

/**
 * A node's report of provider accounts, committed whole or not at all. An account keeps its newest observation
 * (R1-Astra-D4-015): a report older than the stored one (`checkedAt`) changes nothing, and of two observations made
 * at the same instant the one from the node whose name sorts last stands, so the outcome never depends on arrival
 * order. `applied` counts the accounts this report changed.
 */
export effect function reportAccounts(input: AccountsReportInput) {
  const sql = try SqlClient.SqlClient
  const applied = try sql.withTransaction(effect {
    let changed = 0
    for (const acct of input.accounts) {
      const label = scrubRequired(acct.label, 64, acct.accountKey)
      const plan = scrubText(acct.plan, 64)
      const pools = scrubTags(acct.pools)
      const coolReason = scrubText(acct.coolReason, 120)
      const grants = projectGrants(acct.grantsJson)
      const grantsText = grants === null ? null : JSON.stringify(grants)
      const written = try sql`
        INSERT INTO provider_accounts (
          account_key, provider, label, plan, status,
          five_hour_pct, weekly_pct, scoped_pct, resets_at,
          grants_json, credits_balance, active_sessions, pools,
          cool_reason, cool_until, source_node, checked_at, updated_at
        ) VALUES (
          ${acct.accountKey}, ${acct.provider}, ${label}, ${plan}, ${acct.status},
          ${acct.fiveHourPct ?? null}, ${acct.weeklyPct ?? null}, ${acct.scopedPct ?? null},
          ${instant(acct.resetsAt)}::timestamptz,
          ${grantsText}::jsonb, ${acct.creditsBalance ?? null}, ${acct.activeSessions ?? 0}, ${pools},
          ${coolReason}, ${instant(acct.coolUntil)}::timestamptz, ${input.sourceNode},
          COALESCE(${instant(acct.checkedAt)}::timestamptz, now()), now()
        )
        ON CONFLICT (account_key) DO UPDATE SET
          provider = EXCLUDED.provider,
          label = EXCLUDED.label,
          plan = EXCLUDED.plan,
          status = EXCLUDED.status,
          five_hour_pct = EXCLUDED.five_hour_pct,
          weekly_pct = EXCLUDED.weekly_pct,
          scoped_pct = EXCLUDED.scoped_pct,
          resets_at = EXCLUDED.resets_at,
          grants_json = EXCLUDED.grants_json,
          credits_balance = EXCLUDED.credits_balance,
          active_sessions = EXCLUDED.active_sessions,
          pools = EXCLUDED.pools,
          cool_reason = EXCLUDED.cool_reason,
          cool_until = EXCLUDED.cool_until,
          source_node = EXCLUDED.source_node,
          checked_at = EXCLUDED.checked_at,
          updated_at = now()
        WHERE EXCLUDED.checked_at > provider_accounts.checked_at
          OR (EXCLUDED.checked_at = provider_accounts.checked_at
            AND EXCLUDED.source_node >= COALESCE(provider_accounts.source_node, ''))
        RETURNING account_key
      `
      changed += written.length
    }
    return changed
  })
  return { sourceNode: input.sourceNode, reported: input.accounts.length, applied }
}

export effect function readOverview(includeEnded: boolean = false) {
  const sql = try SqlClient.SqlClient
  const nodes = try sql`
    SELECT node_id AS "nodeId", name, kind, labels, online, held,
      load1, cpu_cores AS "cpuCores", mem_used_gb AS "memUsedGb", mem_total_gb AS "memTotalGb",
      disk_free_gb AS "diskFreeGb", disk_total_gb AS "diskTotalGb",
      active_sessions AS "activeSessions", runner_capacity AS "runnerCapacity",
      version, seen_at AS "seenAt"
    FROM host_nodes
    ORDER BY name ASC
  `
  const sessions = includeEnded
    ? try sql`
      SELECT session_key AS "sessionKey", node_id AS "nodeId", managed, harness, model,
        account_label AS "accountLabel", repo, project, lane, title, summary, cwd,
        transcript_json AS "transcriptJson", status, pid,
        cpu_seconds AS "cpuSeconds", tokens_used::double precision AS "tokensUsed",
        started_at AS "startedAt", last_activity_at AS "lastActivityAt", ended_at AS "endedAt"
      FROM observed_sessions
      ORDER BY updated_at DESC
      LIMIT 300
    `
    : try sql`
      SELECT session_key AS "sessionKey", node_id AS "nodeId", managed, harness, model,
        account_label AS "accountLabel", repo, project, lane, title, summary, cwd,
        transcript_json AS "transcriptJson", status, pid,
        cpu_seconds AS "cpuSeconds", tokens_used::double precision AS "tokensUsed",
        started_at AS "startedAt", last_activity_at AS "lastActivityAt", ended_at AS "endedAt"
      FROM observed_sessions
      WHERE status <> 'ended'
      ORDER BY updated_at DESC
      LIMIT 300
    `
  const projectedSessions = sessions.map((row: Record<string, unknown>) => ({
    ...row,
    transcriptJson: scrubTranscript(row["transcriptJson"]),
  }))
  const accounts = try sql`
    SELECT account_key AS "accountKey", provider, label, plan, status,
      five_hour_pct AS "fiveHourPct", weekly_pct AS "weeklyPct", scoped_pct AS "scopedPct",
      resets_at AS "resetsAt", grants_json AS "grantsJson", credits_balance AS "creditsBalance",
      active_sessions AS "activeSessions", pools, cool_reason AS "coolReason",
      cool_until AS "coolUntil", source_node AS "sourceNode", checked_at AS "checkedAt"
    FROM provider_accounts
    ORDER BY provider ASC, label ASC
  `
  // A row stored before the allowlist is read through it too.
  const projectedAccounts = accounts.map((row: Record<string, unknown>) => ({ ...row, grantsJson: projectGrants(row["grantsJson"]) }))
  const sandboxes = try sql`
    SELECT id::text AS id, branch_id AS "branchId", generation, kind, instance,
      started_at AS "startedAt", seen_at AS "seenAt", ended_at AS "endedAt"
    FROM sandbox_generations
    WHERE ended_at IS NULL
    ORDER BY seen_at DESC
    LIMIT 60
  `
  const cfSessions = sandboxes.map((row: Record<string, unknown>) => {
    const branchId = typeof row["branchId"] === "string" ? row["branchId"] : ""
    const repo = branchId.length > 0 ? branchId.split("#")[0] ?? null : null
    const kind = typeof row["kind"] === "string" ? row["kind"] : "branch"
    const gen = String(row["generation"] ?? "?")
    return {
      sessionKey: `cloudflare-branch-sandbox:cf-sandbox:${String(row["id"] ?? "")}`,
      nodeId: "cloudflare-branch-sandbox",
      managed: true,
      harness: "cf-sandbox",
      model: null,
      accountLabel: null,
      repo,
      project: scrubText(repo, 160),
      lane: typeof row["kind"] === "string" ? row["kind"] : null,
      title: scrubText(`BranchSandbox ${branchId} (gen ${gen})`, 160),
      summary: scrubText(`BranchSandbox ${kind} ${branchId} (gen ${gen})`, 320),
      cwd: null,
      transcriptJson: null,
      status: "working",
      pid: null,
      cpuSeconds: null,
      tokensUsed: null,
      startedAt: row["startedAt"] ?? null,
      lastActivityAt: row["seenAt"] ?? null,
      endedAt: row["endedAt"] ?? null,
    }
  })
  const hasCfSandboxNode = nodes.some(
    (n: Record<string, unknown>) => n["nodeId"] === "cloudflare-branch-sandbox"
  )
  const allNodes = cfSessions.length > 0 && !hasCfSandboxNode
    ? [
      ...nodes,
      {
        nodeId: "cloudflare-branch-sandbox",
        name: "Cloudflare BranchSandbox",
        kind: "cloudflare",
        labels: ["cloudflare", "serverless", "branch-sandbox"],
        online: true,
        held: null,
        load1: null,
        cpuCores: null,
        memUsedGb: null,
        memTotalGb: null,
        diskFreeGb: null,
        diskTotalGb: null,
        activeSessions: cfSessions.length,
        runnerCapacity: 64,
        version: "durable-object",
        seenAt: new Date().toISOString(),
      },
    ]
    : nodes
  return { nodes: allNodes, sessions: [...projectedSessions, ...cfSessions], accounts: projectedAccounts }
}
