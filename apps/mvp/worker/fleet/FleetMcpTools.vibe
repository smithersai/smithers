/**
 * BYOA MCP-over-HTTP fleet tools (`fleet_heartbeat`, `fleet_sessions_report`,
 * `fleet_accounts_report`, `fleet_overview`).
 */

import type { SqlClient } from "effect/sql"
import * as DeploymentPolicy from "../DeploymentPolicy.vibe"
import {
  type McpContentBlock,
  type McpPrincipal,
  type McpToolContext,
  type McpToolDescriptor,
  McpToolError,
} from "../mcp/Contract.ts"
import * as FleetStore from "./FleetStore.vibe"

export interface FleetToolResult {
  readonly content: ReadonlyArray<McpContentBlock>
  readonly isError?: boolean
}

export const FLEET_TOOL_NAMES = [
  "fleet_heartbeat",
  "fleet_sessions_report",
  "fleet_accounts_report",
  "fleet_overview",
] as const

export type FleetToolName = (typeof FLEET_TOOL_NAMES)[number]

export function isFleetTool(name: string): name is FleetToolName {
  return (FLEET_TOOL_NAMES as ReadonlyArray<string>).includes(name)
}

export const FLEET_TOOL_DESCRIPTORS: ReadonlyArray<McpToolDescriptor> = [
  {
    name: "fleet_heartbeat",
    description: "Register or update a Smithers host node heartbeat.",
    inputSchema: {
      type: "object",
      additionalProperties: false,
      required: ["nodeId", "name", "kind"],
      properties: {
        nodeId: { type: "string" },
        name: { type: "string" },
        kind: { type: "string" },
        labels: { type: "array", items: { type: "string" } },
        online: { type: "boolean" },
        held: { type: ["string", "null"] },
        load1: { type: ["number", "null"] },
        cpuCores: { type: ["integer", "null"] },
        memUsedGb: { type: ["number", "null"] },
        memTotalGb: { type: ["number", "null"] },
        diskFreeGb: { type: ["number", "null"] },
        diskTotalGb: { type: ["number", "null"] },
        activeSessions: { type: "integer" },
        runnerCapacity: { type: "integer" },
        version: { type: ["string", "null"] },
      },
    },
  },
  {
    name: "fleet_sessions_report",
    description: "Report observed or managed agent sessions (with canonical project, summary, cwd, and scrubbed transcript entries) running on a host node.",
    inputSchema: {
      type: "object",
      additionalProperties: false,
      required: ["nodeId", "sessions"],
      properties: {
        nodeId: { type: "string" },
        replaceActive: { type: "boolean" },
        sessions: { type: "array", items: { type: "object" } },
      },
    },
  },
  {
    name: "fleet_accounts_report",
    description: "Report redacted provider account usage, quotas, cooldowns, and grants.",
    inputSchema: {
      type: "object",
      additionalProperties: false,
      required: ["sourceNode", "accounts"],
      properties: {
        sourceNode: { type: "string" },
        accounts: { type: "array", items: { type: "object" } },
      },
    },
  },
  {
    name: "fleet_overview",
    description: "Read deployment-wide hosts, active sessions across all machines, and monitored provider accounts.",
    inputSchema: {
      type: "object",
      additionalProperties: false,
      properties: {
        includeEnded: { type: "boolean" },
      },
    },
  },
]

schema OverviewArgs {
  includeEnded?: boolean
}

function jsonResult(value: unknown): FleetToolResult {
  return {
    content: [{
      type: "text",
      text: JSON.stringify(value, (_key, item) => (typeof item === "bigint" ? Number(item) : item)),
    }],
  }
}

/** The scope a fleet tool needs: the overview reads, every report writes. */
function scopeOf(name: string): "mcp:read" | "mcp:write" {
  return name === "fleet_overview" ? "mcp:read" : "mcp:write"
}

/**
 * Why `principal` may not use a fleet tool needing `scope`, or `null` when it may. The one deployment-scope check, for
 * discovery and for every call: fleet tools read and write every host, session and provider account of the
 * deployment, so a token a person pinned to one repository (`repoScope`) never reaches them, whatever its person or
 * its scopes.
 */
export function fleetRefusal(
  principal: Option.Option<McpPrincipal>,
  scope: "mcp:read" | "mcp:write",
  admins: ReadonlySet<string>
): McpToolError | null {
  if (Option.isNone(principal)) {
    return new McpToolError({ code: "authentication", message: "Authentication required for fleet MCP tools." })
  }
  const p = principal.value
  if (p.repoScope !== null) {
    return new McpToolError({
      code: "forbidden",
      message: "Fleet tools are deployment-wide. A token limited to one repository cannot use them.",
    })
  }
  if (!DeploymentPolicy.isDeploymentAdmin(p.login, admins)) {
    return new McpToolError({ code: "forbidden", message: "Fleet tools are restricted to a deployment admin." })
  }
  if (!p.scopes.includes(scope)) {
    return new McpToolError({ code: "forbidden", message: `Token lacks required scope ${scope}.` })
  }
  return null
}

export function visibleDescriptors(
  principal: Option.Option<McpPrincipal>,
  admins: ReadonlySet<string> = DeploymentPolicy.DEFAULT_ADMINS
): ReadonlyArray<McpToolDescriptor> {
  return FLEET_TOOL_DESCRIPTORS.filter((d) => fleetRefusal(principal, scopeOf(d.name), admins) === null)
}

effect function requireFleetAccess(
  ctx: McpToolContext,
  scope: "mcp:read" | "mcp:write",
  admins: ReadonlySet<string>
): McpPrincipal!McpToolError {
  const refusal = fleetRefusal(ctx.principal, scope, admins)
  if (refusal !== null || Option.isNone(ctx.principal)) {
    throw refusal ?? new McpToolError({ code: "authentication", message: "Authentication required for fleet MCP tools." })
  }
  return ctx.principal.value
}

effect function decodeOrFail<A>(schema: Schema.Decoder<A>, raw: unknown): A!McpToolError {
  return Schema.decodeUnknownEffect(schema)(raw) catch effect () => {
    throw new McpToolError({ code: "invalid_params", message: "Invalid fleet tool arguments." })
  }
}

export effect function callFleetTool<E>(
  name: FleetToolName,
  rawArgs: unknown,
  ctx: McpToolContext,
  database: Layer.Layer<SqlClient.SqlClient, E>,
  admins: ReadonlySet<string> = DeploymentPolicy.DEFAULT_ADMINS
): FleetToolResult!McpToolError {
  const runDb = <A>(prog: A!unknown!SqlClient.SqlClient) =>
    Effect.provide(prog, database).pipe(
      Effect.mapError(() => new McpToolError({ code: "unavailable", message: "Fleet database unavailable." }))
    )

  if (name === "fleet_heartbeat") {
    try requireFleetAccess(ctx, "mcp:write", admins)
    const args = try decodeOrFail(FleetStore.HostHeartbeatInput, rawArgs)
    return jsonResult(try runDb(FleetStore.upsertHostNode(args)))
  }
  if (name === "fleet_sessions_report") {
    try requireFleetAccess(ctx, "mcp:write", admins)
    const args = try decodeOrFail(FleetStore.SessionsReportInput, rawArgs)
    return jsonResult(try runDb(FleetStore.reportSessions(args)))
  }
  if (name === "fleet_accounts_report") {
    try requireFleetAccess(ctx, "mcp:write", admins)
    const args = try decodeOrFail(FleetStore.AccountsReportInput, rawArgs)
    return jsonResult(try runDb(FleetStore.reportAccounts(args)))
  }
  try requireFleetAccess(ctx, "mcp:read", admins)
  const args = try decodeOrFail(OverviewArgs, rawArgs ?? {})
  return jsonResult(try runDb(FleetStore.readOverview(args.includeEnded === true)))
}
