@@ -0,0 +1,47 @@
+/**
+ * The QuickJS build on Cloudflare's workerd, for a Worker or Durable Object
+ * that runs an agent's cells.
+ *
+ * workerd refuses to compile WebAssembly from bytes ("Wasm code generation
+ * disallowed by embedder"), so the single-file build Node and browsers use
+ * can't load there. It instantiates only a module its toolchain compiled: a
+ * Cloudflare bundler (Alchemy's rolldown plugin, wrangler) uploads an import
+ * whose specifier ends in `.wasm` as a CompiledWasm module and hands the
+ * Worker its `WebAssembly.Module`. `#quickjs.wasm` is that specifier, mapped
+ * by this package's `imports` to the separate-file build's `.wasm`, so an app
+ * depends on no QuickJS package itself.
+ *
+ * The import is dynamic and runs only when {@link layer} is built, inside the
+ * Worker: a deploy tool that imports the Worker's module graph in Node (such
+ * as `alchemy dev`) never evaluates it. This module is a subpath of its own,
+ * kept out of the root entry, so a browser or Node bundle never meets the
+ * `.wasm` import.
+ *
+ * ```ts
+ * import { QuickJSSandbox } from "@smthrs/harness"
+ * import * as QuickJSWorkerd from "@smthrs/harness/QuickJSWorkerd"
+ *
+ * const sandbox = QuickJSSandbox.layerWithVariant.pipe(Layer.provide(QuickJSWorkerd.variant))
+ * ```
+ *
+ * @since 1.0.0-rc.17
+ */
+import { Layer } from "effect";
+import * as QuickJSVariant from "./QuickJSVariant.ts";
+import * as Sandbox from "./Sandbox.ts";
+/**
+ * The separate-file build over the compiled module `load` gives. A load that
+ * fails is the sandbox failing to build, `SandboxError` with code
+ * `runtime_failed`, and is tried again the next time the layer is built.
+ *
+ * @category layers
+ * @since 1.0.0-rc.17
+ */
+export declare const variantFrom: (load: () => Promise<{ readonly default: WebAssembly.Module; }>) => Layer.Layer<QuickJSVariant.Variant, Sandbox.SandboxError>;
+/**
+ * The build on workerd: the `.wasm` module the Worker's bundle carries.
+ *
+ * @category layers
+ * @since 1.0.0-rc.17
+ */
+export declare const variant: Layer.Layer<QuickJSVariant.Variant, Sandbox.SandboxError>;


