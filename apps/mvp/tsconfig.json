{
  "vibe": { "sidecarDir": ".vibe/declarations" },
  "compilerOptions": {
    "customConditions": ["vibelang-source"],
    "rootDirs": [".",".vibe/declarations"],
    "rewriteRelativeImportExtensions": true,
    "allowArbitraryExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "plugins",
    "dev",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "vite.config.vibe",
    "playwright.config.vibe"
  ]
}
