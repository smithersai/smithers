{
  "name": "@smthrs/mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" NODE_EXTRA_CA_CERTS=\"${NODE_EXTRA_CA_CERTS:-$PWD/node_modules/.dev-https/cert.pem}\" alchemy dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node db/migrate.ts",
    "build": "vite build",
    "plan": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy plan --stage prod",
    "deploy": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy deploy --stage prod",
    "destroy": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy destroy --stage prod",
    "typecheck": "vibelang -p tsconfig.json && vibelang -p worker/tsconfig.json && vibelang -p infra/tsconfig.json && vibelang -p evals/tsconfig.json",
    "e2e": "playwright test",
    "e2e:prod": "node e2e/prod.mjs",
    "e2e:gifs": "node e2e/gifs.mjs",
    "e2e:gifs:check": "node e2e/check-gifs.mjs",
    "bench": "node bench/run.ts",
    "bench:startup": "node bench/startup.ts",
    "bench:first-load": "node bench/first-load.ts",
    "eval": "vitest run --config evals/vitest.config.ts",
    "eval:memory": "vitest run --config vitest.memory.config.ts",
    "test": "vitest run",
    "lint": "eslint --config eslint.config.js . --max-warnings=0",
    "test:worker-io-lint": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 eslint.worker-inflight.test.mjs",
    "test:failure-lint": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 eslint.frontend-failures.test.mjs",
    "test:mobile:visitors": "playwright test mobile.spec.ts --project=deployment --no-deps --grep 'signed out.*(curated-home|branch|doc-page|docs|home):'"
  },
  "imports": {
    "#quickjs.wasm": "@jitl/quickjs-wasmfile-release-sync/wasm"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.5",
    "@electric-sql/client": "1.5.28",
    "@fontsource/inter": "5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@journeyapps/wa-sqlite": "1.7.2",
    "@smthrs/agent": "workspace:*",
    "@smthrs/artifacts": "workspace:*",
    "@smthrs/control": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "@smthrs/database": "workspace:*",
    "@smthrs/effect-code-storage": "workspace:*",
    "@smthrs/effect-electric": "workspace:*",
    "@smthrs/effect-tanstack-db": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/flows": "workspace:*",
    "@smthrs/gateway": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/integrations": "workspace:*",
    "@smthrs/journal": "workspace:*",
    "@smthrs/memory": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/model-host": "workspace:*",
    "@smthrs/notifications": "workspace:*",
    "@smthrs/observability": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/platform-browser": "workspace:*",
    "@smthrs/platform-cloudflare": "workspace:*",
    "@smthrs/plugin": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/repo-view": "workspace:*",
    "@smthrs/rpc": "workspace:*",
    "@smthrs/sandbox": "workspace:*",
    "@smthrs/secrets": "workspace:*",
    "@smthrs/std": "workspace:*",
    "@smthrs/sync": "workspace:*",
    "@smthrs/terminal-frame": "workspace:*",
    "@smthrs/ui": "workspace:*",
    "@smthrs/views": "workspace:*",
    "@tanstack/browser-db-sqlite-persistence": "0.2.36",
    "@tanstack/db": "0.15.1",
    "@tanstack/electric-db-collection": "0.6.2",
    "@tanstack/offline-transactions": "1.1.3",
    "@tanstack/react-db": "0.5.11",
    "@tanstack/react-router": "1.170.45",
    "effect": "4.0.5",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/platform-node": "4.0.5",
    "@playwright/test": "1.62.1",
    "@smthrs/cli": "workspace:*",
    "@smthrs/evals": "workspace:*",
    "@smthrs/platform-node": "workspace:*",
    "@smthrs/scorers": "workspace:*",
    "@types/node": "26.4.1",
