    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.83",
    "esbuild": "0.28.2",
    "happy-dom": "20.13.2",
    "miniflare": "5.20261019.0-beta",
    "typescript": "^5.9.3",
    "vibelang": "0.0.8",
    "vibelang-unplugin": "0.0.8",
    "vibelang-vite": "0.0.8",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.2"
  }
}
