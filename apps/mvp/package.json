{
  "name": "@smthrs/mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node infra/sandbox/pack-cli.mjs --if-missing && NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" NODE_EXTRA_CA_CERTS=\"${NODE_EXTRA_CA_CERTS:-$PWD/node_modules/.dev-https/cert.pem}\" alchemy dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node db/migrate.ts",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--import=vibelang/register\" vite --configLoader native build",
    "plan": "node infra/sandbox/pack-cli.mjs && NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy plan --stage prod",
    "deploy": "node infra/sandbox/pack-cli.mjs && NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy deploy --stage prod",
    "destroy": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy destroy --stage prod",
    "typecheck": "vibelang -p tsconfig.json && vibelang -p worker/tsconfig.json && vibelang -p infra/tsconfig.json && vibelang -p evals/tsconfig.json",
    "e2e": "playwright test",
    "e2e:prod": "node e2e/prod.mjs",
    "e2e:gifs": "node e2e/gifs.mjs",
    "e2e:gifs:check": "node e2e/check-gifs.mjs",
    "bench": "node bench/run.ts",
    "bench:startup": "node bench/startup.ts",
    "bench:first-load": "node bench/first-load.ts",
    "eval": "vitest run --config evals/vitest.config.ts",
    "eval:memory": "vitest run --config vitest.memory.config.ts",
    "test": "bash db/test.sh",
    "test:stack": "bash db/test-stack.test.sh",
    "lint": "eslint --config eslint.config.js . --max-warnings=0",
    "test:worker-io-lint": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 eslint.worker-inflight.test.mjs eslint.worker-prelude.test.mjs",
    "test:failure-lint": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 eslint.frontend-failures.test.mjs",
    "test:mobile:visitors": "playwright test mobile.spec.ts --project=deployment --no-deps --grep 'signed out.*(curated-home|branch|doc-page|docs|home):'",
    "test:production-runner": "node --import=vibelang/register --test e2e/resource-locks.test.mjs"
  },
