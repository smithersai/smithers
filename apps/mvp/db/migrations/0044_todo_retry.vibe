export default effect {
  const sql = try SqlClient.SqlClient
  // Retrying replaces the current projection, but published descendants still reference the old attempt's branch.
  try sql`ALTER TABLE todo_attempts ADD COLUMN branch text CHECK (char_length(branch) <= 255)`
  try sql`ALTER TABLE todo_attempts ADD COLUMN pr_number integer CHECK (pr_number > 0)`
  try sql`ALTER TABLE stack_ops DROP CONSTRAINT stack_ops_op_check`
  try sql`ALTER TABLE stack_ops ADD CHECK (op IN ('commit', 'drop', 'move', 'amend', 'retry'))`
  try sql`ALTER TABLE stack_ops DROP CONSTRAINT stack_ops_outcome_check`
  try sql`ALTER TABLE stack_ops ADD CHECK (outcome IN ('committed', 'dropped', 'retried', 'stack_full', 'merged', 'not_found', 'not_retryable'))`
}
