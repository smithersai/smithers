/** Hold a scoped provider for the eval program, rather than for one request. */
export const openProviderResource = async <A, E>(resource: A!E!Scope.Scope) => {
  const scope = runSync(Scope.make())
  const close = () => runPromise(Scope.close(scope, Exit.void))
  try {
    const value = await runPromise(Scope.provide(scope)(resource))
    return { value, close }
  } catch (error) {
    await close()
    throw error
  }
}

/** Observe dispatch while polling the answer's questions. False means the trial timed out. */
export const waitForDispatch = async <A, E, E2>(
  dispatch: A!E,
  poll: void!E2,
  withinMs: number,
  interval: Duration.Input = "250 millis",
): Promise<boolean> => {
  let finished = false
  // Store the exit immediately: the promise cannot reject while a poll is pending, or after a timeout.
  const run = runPromise(Effect.exit(dispatch)).then((exit) => {
    finished = true
    return exit
  })
  const deadline = Date.now() + withinMs
  while (!finished) {
    if (Date.now() > deadline) return false
    await runPromise(poll)
    await runPromise(sleep(interval))
  }
  const exit = await run
  if (Exit.isFailure(exit)) await runPromise(failCause(exit.cause))
  return true
}
