# The app's pages refuse to be framed, its own frames included (src/pwa.ts PAGE_HEADERS,
# docs/features/web-pages.md#security). Cloudflare serves these with every static asset and the single-page fallback.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Content-hashed Vite build outputs never change at a given URL: cache at the CDN edge and browser for 1 year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-maskable-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/social-card.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
