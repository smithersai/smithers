import type { Outbox } from "@smthrs/effect-tanstack-db"

/** A sending row restored from storage is durable; a live optimistic row must await its actual receipt. */
export const sendingAdmitted = (outbox: Outbox.Service, name: string, id: string) => effect {
  const write = try outbox.admission(name, id)
  if (Option.isNone(write)) return true
  return as(write.value.admitted, true) catch effect (refused) => {
    try logWarning("outbox.admission.refused").pipe(
      annotateLogs({ name, reason: refused.reason, errorCode: "not_admitted" }),
    )
    try ignore(write.value.settled)
    return false
  }
}
