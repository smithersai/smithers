import { Bind, type Contribution, Host, JsonSchema, Load } from "@smthrs/plugin"
import { Collection, LiveQuery } from "@smthrs/effect-tanstack-db"
import { WebCrypto } from "effect/crypto/WebCrypto"
import { codeOf } from "../errorCode"
import { issueUrl } from "../features/bugs/github"
import { BugsStore } from "../features/bugs/store.vibe"
import { isFeedName, isIndexName, parseFeedRepo } from "../features/feeds/contract"
import { itemsOf } from "../features/feeds/items.vibe"
import { FeedItem } from "../features/feeds/schema"
import { FeedsStore } from "../features/feeds/store.vibe"
import type { Available, GlobalFleetShape } from "../features/fleet/globalContract"
import { FleetStore, type GlobalAccess } from "../features/fleet/store.vibe"
import { AuthStore } from "../features/auth/store.vibe"
import { repoId } from "../features/repo/contract"
import { RepoStore } from "../features/repo/store.vibe"
import type { Gated } from "../features/repo/gate"
import { repoVisibility } from "../features/repo/visibility"
import { StatusStore } from "../features/status/store"
import { FlowDispatch } from "../flows/dispatch.vibe"
import { codeOfFailure } from "../flows/history"
import type { FlowName } from "../flows/registry.vibe"
import { BUILTIN, type BuiltIn } from "./builtin"
import { hostFacts } from "./facts"
import { Draft, draftKey, fresh, SHOWN, Shown, ViewState } from "./schema"
import { type Button, personOnly, textFields } from "./strip"

// The plugin host (decision 0017, docs/features/plugins.md): loads the built-in plugins' manifests through the public
// loader, `@smthrs/plugin`'s `Load`, and serves each plugin the one public contract, `PluginHost`, scoped to that
// plugin: it reads only the queries its contributions declare, selects only rows of them, and dispatches only events
// its views declare. An event whose flow is person-only (`run/answer`) is never dispatched for plugin code: the host's
// action strip draws it, and the person's press or key sends it with their own door. First-party plugins get nothing
// else; a plugin needing more makes the public contract grow.

type View = Contribution.View

/** Plugins loaded at boot, by `outcome` (`active`, `refused`), `tier` and refusal `reason`. */
export const loads = Metric.counter("smithers_plugin_loads", {
  description: "Plugins the host loaded at boot, by outcome, tier and refusal reason",
  incremental: true,
})

/** Contributions the active plugins brought, by `point`. */
export const contributionCount = Metric.counter("smithers_plugin_contributions", {
  description: "Contributions active plugins brought, by point",
  incremental: true,
})

/** Presses of the host's action strip, by `plugin`, `event`, `door` (`button`, `key`) and `outcome`. */
export const presses = Metric.counter("smithers_plugin_presses", {
  description: "Presses of the host's action strip, by plugin, event, door and outcome",
  incremental: true,
})

/** A live list of rows, as `PluginHost.query` answers: the current rows, and a way to hear they changed. */
/** `live`, answering no rows while repository `id` may not show, and telling its listeners when that changes. */
// One gated view per live query, so two reads of one query answer the same object, as the queries do. It holds no
// decision: `current` reads the rule each time, so a session or role change shows in the next read.
const gatedViews = new WeakMap<object, Host.Live<unknown>>()
const EMPTY_ROWS: ReadonlyArray<never> = Object.freeze([])
export const gateLive = <R>(plugins: { readonly visible: (id: string) => boolean; readonly onVisibility: (listener: () => void) => () => void }, id: string, live: Host.Live<R>): Host.Live<R> => {
  const known = gatedViews.get(live)
  if (known !== undefined) return known as Host.Live<R>
  const gated: Host.Live<R> = {
    current: () => plugins.visible(id) ? live.current() : EMPTY_ROWS,
    subscribe: (listener) => {
      const rows = live.subscribe(listener)
      const visibility = plugins.onVisibility(listener)
      return () => { rows(); visibility() }
    },
  }
  gatedViews.set(live, gated as Host.Live<unknown>)
  return gated
}

/**
 * A deployment-wide fleet query as a plugin reads it: `current` asks the store's gate each time, so rows a 401 or 403
 * put in doubt are gone from the next read, while the session check is still out (Astra-D4-003). `availability` says
 * whether no rows means none (`ready`) or not known (`loading`, `unavailable`).
 */
export const globalLive = <R>(access: GlobalAccess, shape: GlobalFleetShape, live: Host.Live<R>): Host.Live<R> & Available => ({
  current: () => access.visible(shape) ? live.current() : EMPTY_ROWS,
  subscribe: (listener) => {
    const rows = live.subscribe(listener)
    const gate = access.subscribe(shape, listener)
    return () => { rows(); gate() }
  },
  availability: () => access.availability(shape),
})

export const liveOf = <R>(rows: Stream.Stream<ReadonlyArray<R>>, initial: ReadonlyArray<R> = []) =>
  effect {
    let current: ReadonlyArray<R> = initial
    const listeners = new Set<() => void>()
    try (
      rows
        |> Stream.runForEach(%, (next) =>
          sync(() => {
            current = next
            for (const listener of listeners) listener()
          }))
        |> forkScoped(%, { startImmediately: true })
    )
    return {
      current: () => current,
      subscribe: (listener: () => void) => {
        listeners.add(listener)
        return () => void listeners.delete(listener)
      },
    } satisfies Host.Live<R>
  }

/**
 * `query` as a plugin reads it: `current` reads the gated live query itself, so a change that hides rows (a refusal,
 * through the data gate) hides them from the next read in the same change. Its rows stream only tells listeners. A
 * snapshot that stream kept (`liveOf`) still held a refused repository's question right after the refusal (Astra on
 * 0c7b9f01).
 */
export const liveQueryOf = <R extends object>(query: Gated<R>) =>
  effect {
    try sync(() => query.tanstack.startSyncImmediate())
    let current: ReadonlyArray<R> = EMPTY_ROWS
    // TanStack allocates toArray on each read. Keep an unchanged React snapshot stable, but read the gate now:
    // a cached stream value could still expose rows synchronously after permission was refused.
    const snapshot = () => {
      const rows = query.tanstack.toArray
      if (rows.length !== current.length || rows.some((row, index) => row !== current[index])) {
        current = rows.length === 0 ? EMPTY_ROWS : Object.freeze(rows)
      }
      return current
    }
    const listeners = new Set<() => void>()
    try (
      query.rows
        |> Stream.runForEach(%, () => sync(() => { for (const listener of listeners) listener() }))
        |> forkScoped(%, { startImmediately: true })
    )
    return {
      current: snapshot,
      subscribe: (listener: () => void) => {
        listeners.add(listener)
        return () => void listeners.delete(listener)
      },
    } satisfies Host.Live<R>
  }
/** Every view's strip state, as a live query. */
const stripsQuery = (views: Collection.Collection<ViewState, string>) =>
  LiveQuery.make((q) => q.from({ view: views.tanstack }))

/** Every note the strips hold, as a live query. */
const draftsQuery = (drafts: Collection.Collection<Draft, string>) =>
  LiveQuery.make((q) => q.from({ draft: drafts.tanstack }))

/** A core query a plugin may read: its rows and the field each row is keyed by. */
interface CoreQuery {
  readonly key: string
  readonly live: Host.Live<Readonly<Record<string, unknown>>>
  /** The same rows as a TanStack DB live query, for the host's own components. */
  readonly rows: StatusStore["Service"]["waits"]["tanstack"]
}

/**
 * The core queries a plugin asks with `params`: a repository's feed index, one of its documents, and the items of one
 * of its index documents.
 */
const FEED_INDEX = "core/feeds"
const FEED_DOCUMENT = "core/feed"
const FEED_ITEMS = "core/feed-items"

/** The fleet's core queries (docs/features/fleet.md#queries): a repository's agent runs and its runner machines. */
const AGENT_RUNS = "core/agent-runs"
const MACHINES = "core/machines"
const FLEET_NODES = "core/fleet-nodes"
const FLEET_SESSIONS = "core/fleet-sessions"
const FLEET_ACCOUNTS = "core/fleet-accounts"

/** Where `core/feed-items` keeps a document's items: `<repo>:<document>`. */
const itemsKey = (repo: string, document: string) => `${repo}:${document}`

/** `params` in a stable order, to tell whether two selections asked a query the same way. */
const paramsKey = (params: Host.QueryParams | null) =>
  JSON.stringify(Object.entries(params ?? {}).sort(([a], [b]) => a.localeCompare(b)))

/** A local event the keymap delivered to a view. */
interface Delivered {
  readonly view: string
  readonly name: string
  readonly fields: unknown
}

export class Plugins extends Context.Service<
  Plugins,
  {
    readonly contributions: Contribution.Contributions
    readonly refused: ReadonlyArray<Contribution.Refusal>
    readonly facts: Load.HostFacts
    readonly built: ReadonlyMap<string, BuiltIn>
    readonly core: ReadonlyMap<string, CoreQuery>
    /** `core/feeds` of each repository asked for so far, by its `owner/name` lowercased, for the strip to read. */
    readonly opened: Map<string, CoreQuery>
    /** `core/feed-items` of each document asked for so far, by `<repo>:<document>`, opened once, for the strip to read. */
    readonly items: Map<string, CoreQuery!!>
    /** The same, once open: what the strip reads. */
    readonly itemsOpen: Map<string, CoreQuery>
    /** Every repository's feeds, which `core/feeds` and `core/feed` read. */
    readonly feeds: FeedsStore["Service"]
    /** Where the host's own repository rows show: the app's required data gate (repo/gate.ts). */
    readonly repos: RepoStore["Service"]
    /** Every repository's agent runs and machines, which `core/agent-runs` and `core/machines` read. */
    readonly fleet: FleetStore["Service"]
    /** `core/agent-runs` and `core/machines` of each repository asked for so far, by `<query>:<repo>`, opened once. */
    readonly fleetOpen: Map<string, Host.Live<Readonly<Record<string, unknown>>>!!>
    readonly visible: (id: string) => boolean
    readonly onVisibility: (listener: () => void) => () => void
    readonly shown: Collection.Collection<Shown, string>
    readonly views: Collection.Collection<ViewState, string>
    /** The strip's notes, by view and item, kept on the device. */
    readonly drafts: Collection.Collection<Draft, string>
    /** Every view's strip state, live, for the strip's component. */
    readonly strips: Effect.Success<ReturnType<typeof stripsQuery>>
    /** Every note, live, for the strip's text box. */
    readonly notes: Effect.Success<ReturnType<typeof draftsQuery>>
    readonly delivered: PubSub.PubSub<Delivered>
    /** Where the background work an action starts runs. */
    readonly scope: Scope.Scope
  }
>()("@smthrs/mvp/plugins/Plugins") {
  /** Loads `builtins` (the app's list by default) and keeps the host's state while the scope lives. */
  static readonly layer = (builtins: ReadonlyArray<BuiltIn> = BUILTIN) =>
    Layer.effect(
      Plugins,
      effect {
        const scope = try Effect.scope
        const facts = try sync(() => hostFacts())
        const loaded = try Load.load(facts, builtins.map(({ manifest }) => ({ tier: "built-in" as const, manifest })))
        try record(loaded)
        const built = new Map(
          builtins.flatMap((entry) => {
            const id = (entry.manifest as { readonly id?: unknown }).id
            return typeof id === "string" && loaded.contributions.plugins.some((plugin) => plugin.id === id)
              ? [[id, entry] as const]
              : []
          }),
        )
        const status = try StatusStore
        const bugs = try BugsStore
        const feeds = try FeedsStore
        const fleet = try FleetStore
        const auth = try Effect.serviceOption(AuthStore)
        const repos = try RepoStore
        const visible = (id: string) => {
          if (Option.isNone(auth)) return true
          const session = auth.value.sessionState.tanstack.toArray[0]
          if (session === undefined) return true
          return repoVisibility(session, repos.rolesState.tanstack.toArray.find((row) => row.id === id)) === "show"
        }
        const onVisibility = (listener: () => void) => {
          const stops: Array<() => void> = []
          if (Option.isSome(auth)) {
            const sessions = auth.value.sessionState.tanstack.subscribeChanges(listener)
            stops.push(() => sessions.unsubscribe())
          }
          const roles = repos.rolesState.tanstack.subscribeChanges(listener)
          stops.push(() => roles.unsubscribe())
          return () => { for (const stop of stops) stop() }
        }
        const core = new Map<string, CoreQuery>([
          // The status store's waits come through the data gate (src/features/status/queries.ts `shownRunsQuery`): a wait
          // of a conversation whose repository may not show is in neither the plugin's rows nor the strip's.
          ["core/waits", {
            key: "runId",
            live: (try liveQueryOf(status.waits as unknown as Gated<Readonly<Record<string, unknown>>>)) as CoreQuery["live"],
            rows: status.waits.tanstack,
          }],
          // The bug reports the viewer may see, newest first, each with GitHub's prefilled form for it
          // (docs/features/bugs.md). No strip acts on a report, so the strip never reads its rows.
          ["core/bug-reports", {
            key: "id",
            live: (try liveOf(
              Stream.map(bugs.newest.rows, (rows) => rows.map((row) => ({ ...row, github: issueUrl(row) }))),
            )) as CoreQuery["live"],
            rows: bugs.newest.tanstack as unknown as CoreQuery["rows"],
          }],
        ])
        const shown = try Collection.local<Shown, string>({
          id: "plugin-shown",
          schema: Shown,
          getKey: (row) => row.id,
          initialData: [{ id: SHOWN, view: null }],
        })
        const views = try Collection.local<ViewState, string>({
          id: "plugin-views",
          schema: ViewState,
          getKey: (row) => row.id,
        })
        const drafts = try Collection.persisted<Draft, string>({
          id: "plugin-drafts",
          schema: Draft,
          getKey: (row) => row.id,
          schemaVersion: 1,
        })
        const strips = try stripsQuery(views)
        const notes = try draftsQuery(drafts)
        const delivered = try PubSub.unbounded<Delivered>()
        // A view's selection of a wait that no longer shows (answered, or of a repository the person may no longer see,
        // through the data gate) is cleared once no press on it is on its way: the strip never keeps an item the
        // person can't see. A plugin selects the next one it shows (`select`).
        const clearHidden = orDie(effect {
          const shownWaits = new Set((try status.waits.toArray).map((row) => row.runId))
          for (const view of try views.toArray) {
            if (view.query !== "core/waits" || view.item === null || view.sending || shownWaits.has(view.item)) continue
            try views.update(view.id, (draft) => {
              draft.item = null
              draft.failed = false
            })
          }
        })
        try (
          Stream.merge(Stream.map(status.waits.rows, () => undefined), Stream.map(views.changes(), () => undefined))
            |> Stream.runForEach(%, () => clearHidden)
            |> forkIn(%, scope, { startImmediately: true })
        )
        return Plugins.of({
          contributions: loaded.contributions,
          refused: loaded.refused,
          facts,
          built,
          core,
          opened: new Map(),
          items: new Map(),
          itemsOpen: new Map(),
          feeds,
          repos,
          fleet,
          fleetOpen: new Map(),
          /** Whether repository `id` may show now, read from the session and its role row (`repoVisibility`). */
          visible,
          /** Calls `listener` on each session or role change: a gated query's rows are read again. */
          onVisibility,
          shown,
          views,
          drafts,
          strips,
          notes,
          delivered,
          scope,
        })
      },
    )
}


/** One `plugin.load` record per plugin: a span, a log line and a count, with its id and outcome, never its text. */
effect function record(loaded: Load.Loaded) {
  for (const plugin of loaded.contributions.plugins) {
    const fields = { plugin: plugin.id, version: plugin.version, tier: plugin.tier, outcome: "active" }
    try Metric.update(Metric.withAttributes(loads, { outcome: "active", tier: plugin.tier, reason: "none" }), 1)
    try (logInfo("plugin.load") |> annotateLogs(%, fields) |> withSpan(%, "plugin.load", { attributes: fields }))
  }
  for (const refusal of loaded.refused) {
    const fields = { plugin: refusal.plugin ?? "unknown", outcome: "refused", reason: refusal.reason }
    try Metric.update(Metric.withAttributes(loads, { outcome: "refused", tier: "built-in", reason: refusal.reason }), 1)
    try (
      logError("plugin.refused")
        |> annotateLogs(%, { ...fields, path: refusal.path ?? "" })
        |> withSpan(%, "plugin.load", { attributes: fields })
    )
  }
  const points = { views: loaded.contributions.views, slots: loaded.contributions.slots, commands: loaded.contributions.commands, keybindings: loaded.contributions.keybindings }
  for (const [point, entries] of Object.entries(points)) {
    if (entries.length > 0) try Metric.update(Metric.withAttributes(contributionCount, { point }), entries.length)
  }
}

/** The view declared with `id`, if any. */
export const viewById = (contributions: Contribution.Contributions, id: string): View | undefined =>
  contributions.views.find((view) => view.id === id)

/**
 * The view `plugin` declares at `path` in `scope`, if any: an `app` view shows at `/app/<plugin>/<path>`, a `repository`
 * view at `/<owner>/<repo>/-/<plugin>/<path>`.
 */
export const viewAt = (
  contributions: Contribution.Contributions,
  plugin: string,
  path: string,
  scope: View["scope"] = "app",
): View | undefined => contributions.views.find((view) => view.plugin === plugin && view.scope === scope && view.path === path)

/**
 * Where a view shows; a `repository` view shows on `repository` and has no path without one.
 */
export const pathOf = (view: View, repository?: Host.Repository): string | undefined => Host.pathOf(view, repository)

/** Every query `plugin`'s contributions declare in `reads`. */
const readsOf = (contributions: Contribution.Contributions, plugin: string): ReadonlySet<string> =>
  new Set(
    [...contributions.views, ...contributions.slots].filter((entry) => entry.plugin === plugin).flatMap((entry) => entry.reads ?? []),
  )

/** View `id`'s strip state, made fresh when it has none, changed by `change`. */
const touch = (id: string, change: (row: ViewState) => Partial<ViewState>) =>
  orDie(effect {
    const { views } = try Plugins
    const current = try views.get(id)
    if (Option.isNone(current)) {
      const base = try sync(() => fresh(id))
      try views.insert({ ...base, ...change(base) })
      return
    }
    try views.update(id, (draft) => void Object.assign(draft, change(current.value)))
  })

/**
 * Core query `name` as the strip reads it: a fixed one, or one a plugin asked with `params` (`core/feeds`); `undefined`
 * for any other, `core/feed` included, whose rows a view only shows.
 */
export const readable = (
  plugins: Plugins["Service"],
  name: string,
  params: Host.QueryParams | null,
): CoreQuery | undefined => {
  const fixed = plugins.core.get(name)
  if (fixed !== undefined) return fixed
  const repo = parseFeedRepo(params?.repo ?? "") ?? ""
  if (name === FEED_INDEX) return plugins.opened.get(repo)
  return name === FEED_ITEMS ? plugins.itemsOpen.get(itemsKey(repo, params?.name ?? "")) : undefined
}

/** How long a plugin's first read of an index or a fleet query waits for its first sync before it answers what the tab has. */
export const INDEX_FIRST_SYNC = "30 seconds"

/**
 * Repository `repo`'s index, opened once and kept while the host lives. It answers once its first sync arrived (or
 * `INDEX_FIRST_SYNC` passed), with those rows: an index still loading is never an empty one, which a plugin would
 * draw as "No feed yet" and the factory's tab as no tab at all (Will's Factory tab on smithers.sh, 2026-10-31).
 */
effect function indexOf(plugins: Plugins["Service"], repo: string) {
  const known = plugins.opened.get(repo)
  if (known !== undefined) return known
  const index = try plugins.feeds.index(repo)
  // expected: a shape that fails or takes longer answers what the tab has, and its rows follow as they arrive
  try (index.byName.preload |> timeout(%, INDEX_FIRST_SYNC) |> ignore(%))
  const synced = try index.byName.toArray
  const again = plugins.opened.get(repo)
  if (again !== undefined) return again
  const query: CoreQuery = {
    key: "id",
    live: (try (liveOf(index.byName.rows, synced) |> Scope.provide(%, plugins.scope))) as CoreQuery["live"],
    rows: index.byName.tanstack as unknown as CoreQuery["rows"],
  }
  plugins.opened.set(repo, query)
  return query
}

/**
 * The items of index document `document` of `repo` (`itemsOf`), kept in a collection on the tab, never the device, so
 * the strip reads them as it reads any core query: in document order, each change of the document applied as
 * inserts, updates and deletes by key. Opened once per document, while the host lives.
 */
const openItems = (plugins: Plugins["Service"], repo: string, document: string) =>
  effect {
    const index = try plugins.feeds.index(repo)
    const collection = try Collection.local<FeedItem, string>({
      id: `plugin-feed-items:${itemsKey(repo, document)}`,
      schema: FeedItem,
      getKey: (row) => row.key,
    })
    // The host shows a document's items only through the data gate (repo/gate.ts).
    const shown = try plugins.repos.gate(collection)
    const ordered = try LiveQuery.make((q) => q.from({ item: shown.tanstack }).orderBy(({ item }) => item.index, "asc"))
    // What `collection` holds, kept beside it: the host reads its rows only through the gate.
    let current = new Map<string, FeedItem>()
    const apply = (next: ReadonlyArray<FeedItem>) =>
      orDie(effect {
        const kept = new Set(next.map((row) => row.key))
        const gone = [...current.keys()].filter((key) => !kept.has(key))
        if (gone.length > 0) try collection.delete(gone)
        const added = next.filter((row) => !current.has(row.key))
        if (added.length > 0) try collection.insert(added)
        for (const row of next) {
          const before = current.get(row.key)
          if (before !== undefined && seen(before) !== seen(row)) {
            try collection.update(row.key, (draft) => void Object.assign(draft, row))
          }
        }
        current = new Map(next.map((row) => [row.key, row]))
      })
    try (
      index.byName.rows
        |> Stream.map(%, (rows) => rows.find((row) => row.name === document)?.body)
        |> Stream.mapEffect(%, (body) => itemsOf(repo, document, body))
        |> Stream.runForEach(%, apply)
        |> forkScoped(%, { startImmediately: true })
    )
    const query: CoreQuery = {
      key: "key",
      live: (try liveOf(ordered.rows)) as CoreQuery["live"],
      rows: ordered.tanstack as unknown as CoreQuery["rows"],
    }
    plugins.itemsOpen.set(itemsKey(repo, document), query)
    return query
  } |> Scope.provide(%, plugins.scope) |> orDie(%)

/**
 * Query `name` for a plugin, asked with `params`: a fixed core query's rows; `core/feeds`, the index of the repository
 * `params.repo` names (`owner/name`), opened once and kept for the strip; `core/feed`, its document `params.name`, synced
 * only while the view listens. Fails with what is wrong: `query` for one the host doesn't serve, else the parameter it
 * needs that is missing or malformed.
 */
export effect function queryOf(name: string, params: Host.QueryParams | undefined) {
  const plugins = try Plugins
  const fixed = plugins.core.get(name)
  if (fixed !== undefined) return fixed.live
  if (name === FLEET_NODES || name === FLEET_SESSIONS || name === FLEET_ACCOUNTS) {
    const key = `global:${name}`
    const existing = plugins.fleetOpen.get(key)
    if (existing !== undefined) return try existing
    const open = try cached(
      effect {
        const query =
          name === FLEET_NODES
            ? try plugins.fleet.globalNodes
            : name === FLEET_SESSIONS
            ? try plugins.fleet.globalSessions
            : try plugins.fleet.globalAccounts
        const shape: GlobalFleetShape = name === FLEET_NODES ? "nodes" : name === FLEET_SESSIONS ? "sessions" : "accounts"
        const live = try liveOf(query.rows as unknown as Stream.Stream<ReadonlyArray<Readonly<Record<string, unknown>>>>)
        return globalLive(plugins.fleet.global, shape, live)
      } |> Scope.provide(%, plugins.scope) |> orDie(%),
    )
    plugins.fleetOpen.set(key, open)
    return try open
  }
  const fleetQuery = name === AGENT_RUNS || name === MACHINES
  if (name !== FEED_INDEX && name !== FEED_DOCUMENT && name !== FEED_ITEMS && !fleetQuery) {
    throw "query" as const
  }
  const { repo: asked = "", name: document = "" } = params ?? {}
  const repo = parseFeedRepo(asked)
  if (repo === undefined) throw "repo" as const
  // A repository's rows reach a plugin only while the repository may show (`repoVisibility`), read at each read.
  const [owner = "", repoName = ""] = repo.split("/")
  const gated = (live: Host.Live<Readonly<Record<string, unknown>>>) => gateLive(plugins, repoId(owner, repoName), live)
  if (fleetQuery) {
    // One live list per repository and query, opened on the first ask and kept for the host's life: a shape each.
    const key = `${name}:${repo}`
    const opening = plugins.fleetOpen.get(key) ?? (try cached(
      effect {
        const query = name === AGENT_RUNS ? try plugins.fleet.runs(repo) : try plugins.fleet.machines(repo)
        // As indexOf: rows still loading are never no rows, which the fleet would draw as "No agent runs" and
        // "runners 0/0" for as long as the first sync takes (6 s and more on smithers.sh, 2026-11-01).
        // expected: a shape that fails or takes longer answers what the tab has, and its rows follow as they arrive
        try (query.preload |> timeout(%, INDEX_FIRST_SYNC) |> ignore(%))
        const rows = query.rows as Stream.Stream<ReadonlyArray<Readonly<Record<string, unknown>>>>
        const synced = (try query.toArray) as ReadonlyArray<Readonly<Record<string, unknown>>>
        return (try liveOf(rows, synced)) as CoreQuery["live"]
      } |> Scope.provide(%, plugins.scope),
    ))
    plugins.fleetOpen.set(key, opening)
    return gated(try opening)
  }
  if (name === FEED_INDEX) return gated((try indexOf(plugins, repo)).live)
  if (!isFeedName(document)) throw "name" as const
  if (name === FEED_DOCUMENT) return gated(plugins.feeds.document(repo, document) as unknown as CoreQuery["live"])
  // Items come from an index document only: the strip reads them while the view is gone, and only the index stays.
  if (!(try sync(() => isIndexName(document)))) throw "name" as const
  const key = itemsKey(repo, document)
  // Asked twice at once, a document's items open once: the first ask keeps the opening for every later one.
  const opening = plugins.items.get(key) ?? (try cached(openItems(plugins, repo, document)))
  plugins.items.set(key, opening)
  return gated((try opening).live)
}

/** View `id`'s strip state now. */
export effect function stateOf(id: string) {
  const { views } = try Plugins
  return Option.getOrElse(try views.get(id), () => fresh(id))
}

/** The row view `id` selected, as its query has it now, if it is still there. */
export effect function selectedOf(id: string) {
  const plugins = try Plugins
  const state = try stateOf(id)
  const query = state.query === null ? undefined : readable(plugins, state.query, state.params)
  return try sync(() => query?.live.current().find((row) => row[query.key] === state.item))
}

/** The plugin view shown now, if any. */
export const shownView = effect {
  const { shown, contributions } = try Plugins
  const row = try shown.get(SHOWN)
  const id = Option.getOrUndefined(row)?.view ?? null
  return id === null ? undefined : viewById(contributions, id)
}

/** Shows view `id`: the route that draws it calls this. */
export const show = (id: string) =>
  orDie(effect {
    const { shown } = try Plugins
    try shown.update(SHOWN, (row) => void (row.view = id))
  })

/**
 * Hides view `id` if it is still the one shown: its route calls this on leaving. A route's `onLeave` runs after the
 * next route opened (router-core `runRouteLifecycle`), so a plugin route that opened next has already shown its own view.
 */
export const hide = (id: string) =>
  orDie(effect {
    const { shown } = try Plugins
    try shown.update(SHOWN, (row) => {
      if (row.view === id) row.view = null
    })
  })

/** The note view `id` holds for `item`. */
effect function draftOf(id: string, item: string) {
  const { drafts } = try Plugins
  return match (try drafts.get(try sync(() => draftKey(id, item)))) {
    when { _tag: "Some", let value }: value.text;
    default: "";
  }
}

/** Keeps the text box's note for the item view `id` selected; with nothing selected there is no note to keep. */
export const setDraft = (id: string, text: string) =>
  orDie(effect {
    const { drafts } = try Plugins
    const { item } = try stateOf(id)
    if (item === null) return
    const key = try sync(() => draftKey(id, item))
    if (Option.isSome(try drafts.get(key))) try drafts.update(key, (row) => void (row.text = text))
    else try drafts.insert({ id: key, text })
  })

/** A row as the person saw it: its own fields, without TanStack DB's virtual `$` ones, in a stable order. */
const seen = (row: Readonly<Record<string, unknown>>) =>
  JSON.stringify(Object.keys(row).filter((key) => !key.startsWith("$")).sort().map((key) => [key, row[key]]))


/**
 * The person pressed `button` on view `id`'s strip, by pointer (`button`) or key (`key`): runs its event's flow for the
 * selected item with the button's fields and the draft in every text field, in the background. The strip shows
 * Sending until the run settles; a second press meanwhile does nothing, so two presses record one answer. A run that
 * fails shows as failed, keeping the draft, until the next press. A run that succeeds drops the draft it sent; a note
 * typed while it was on its way never went, so it stays.
 */
export effect function press(
  id: string,
  button: Button,
  door: "button" | "key",
  drawn?: Readonly<Record<string, unknown>>,
) {
  const plugins = try Plugins
  const view = viewById(plugins.contributions, id)
  const event = view?.events.find((candidate) => candidate.name === button.event)
  const item = try selectedOf(id)
  const state = try stateOf(id)
  if (view === undefined || event === undefined || !("flow" in event) || !event.personOnly) return
  if (item === undefined || state.item === null || state.sending) return
  const key = state.item
  // A button acts on the item it was drawn for: if that item moved on (answered elsewhere, a new version), nothing runs.
  if (drawn !== undefined && seen(drawn) !== seen(item)) {
    return try andThen(
      Metric.update(Metric.withAttributes(presses, { plugin: view.plugin, event: event.name, door, outcome: "stale" }), 1),
      logInfo("plugin.press") |> annotateLogs(%, { plugin: view.plugin, view: id, event: event.name, door, outcome: "stale" }),
    )
  }
  const fields: Record<string, unknown> = { ...button.fields }
  const note = try draftOf(id, key)
  for (const field of try sync(() => textFields(event))) fields[field] = note
  // A press whose flow didn't run or failed is a failure, Warn by its code; every other outcome is Info.
  const outcome = (value: string, failure?: unknown) =>
    andThen(
      Metric.update(Metric.withAttributes(presses, { plugin: view.plugin, event: event.name, door, outcome: value }), 1),
      (value === "failed" ? logWarning : logInfo)("plugin.press") |> annotateLogs(%, {
        feature: "plugins",
        plugin: view.plugin,
        view: id,
        event: event.name,
        door,
        outcome: value,
        ...(value === "failed" ? { errorCode: codeOf(failure) } : {}),
      }),
    )
  const payload = try sync(() => Bind.bind(event.args, { item, event: fields }))
  if (Option.isSome(misfit(event.payload, fields)) || Result.isFailure(payload)) {
    try touch(id, () => ({ failed: true }))
    return try outcome("invalid")
  }
  try touch(id, () => ({ sending: true, failed: false }))
  const flows = try FlowDispatch
  try (
    flows.dispatch(event.flow as FlowName, payload.success as never, { door })
      // A flow that ran and failed is a failure like one that didn't run: either is named by its code.
      |> flatMap(%, (dispatched) => dispatched._tag === "Done" ? Effect.void : fail(dispatched.error))
      |> exit(%)
      |> flatMap(%, (exit) =>
        Exit.isSuccess(exit)
          ? andThen(
            andThen(touch(id, () => ({ sending: false })), dropDraft(id, key, note)),
            outcome("done"),
          )
          : andThen(touch(id, () => ({ sending: false, failed: true })), outcome("failed", Cause.squash(exit.cause))))
      |> forkIn(%, plugins.scope)
  )
}

/** Drops view `id`'s note for `item`, once its answer went, if it is still the note that went (`sent`): a newer one stays. */
effect function dropDraft(id: string, item: string, sent: string) {
  const { drafts } = try Plugins
  if ((try draftOf(id, item)) !== sent) return
  try ignore(drafts.delete(try sync(() => draftKey(id, item))))
}

/** Delivers a local event to the view that declares it: `j` and `k`. */
export effect function deliver(view: string, name: string, fields: unknown) {
  const { delivered } = try Plugins
  try PubSub.publish(delivered, { view, name, fields })
}
/** Why `fields` don't fit an event's payload, if they don't: none when it declares no payload. */
const misfit = (payload: JsonSchema.Resolved | undefined, fields: unknown) =>
  payload === undefined ? Option.none<string>() : JsonSchema.validate(payload, fields)

/** A declared failure's stable code: its `code` when it carries one (a refusal's), else its kind. */
const failureCode = (error: unknown): string =>
  typeof error === "object" && error !== null && "code" in error && typeof error.code === "string"
    ? error.code
    : codeOfFailure(error) ?? "failed"

/**
 * How a plugin's dispatched run ended, as `Dispatched.settled` answers it: `Done`, or `Failed` with its stable code:
 * the flow's declared failure's (`BugRefused`'s `authentication`), dispatch's refusal or reason, or `interrupted`.
 * Never a message.
 */
export const settledOf = (
  exit: Exit.Exit<
    { readonly _tag: "Done" } | { readonly _tag: "Failed"; readonly error: unknown },
    { readonly reason: string; readonly refusal?: string | undefined }
  >,
): Host.Settled => {
  if (Exit.isSuccess(exit)) {
    return exit.value._tag === "Done" ? { _tag: "Done" } : { _tag: "Failed", code: failureCode(exit.value.error) }
  }
  const error = Cause.findErrorOption(exit.cause)
  if (Option.isSome(error)) return { _tag: "Failed", code: error.value.refusal ?? error.value.reason }
  return { _tag: "Failed", code: Cause.hasInterruptsOnly(exit.cause) ? "interrupted" : "defect" }
}


/** Refuses a request plugin `plugin` made of its host: logged once by the reason, never the detail, then failed. */
const refuse = (plugin: string, reason: Host.PluginRefused["reason"], detail: string) =>
  logWarning("plugin.request")
    |> annotateLogs(%, { feature: "plugins", plugin, outcome: "refused", reason })
    |> andThen(%, fail(new Host.PluginRefused({ plugin, reason, detail })))

/**
 * `PluginHost` for `plugin`, over this host: the one contract its tab reads and acts through (decision 0017, "The host
 * contract"). Every request is checked against what the plugin's own manifest declares.
 */
export effect function hostFor(plugin: string) {
  const plugins = try Plugins
  const context = try Effect.context<Plugins | FlowDispatch>()
  const provideHost = <A, E>(program: A!E!(Plugins | FlowDispatch)) => Effect.provide(program, context)
  const reads = readsOf(plugins.contributions, plugin)
  /** The event `name` of the plugin's own view `id`. */
  const eventOf = (ref: Host.EventRef) => {
    const view = viewById(plugins.contributions, ref.view)
    const event = view?.plugin === plugin ? view.events.find((candidate) => candidate.name === ref.name) : undefined
    return event === undefined ? refuse(plugin, "undeclared_event", ref.name) : succeed({ view: view!, event })
  }
  return {
    query: <R>(name: string, params?: Host.QueryParams) =>
      effect {
        if (!reads.has(name)) return try refuse(plugin, "undeclared_query", name)
        // A declared query is one the host serves (`Load` checks `reads` against its facts): only a parameter fails.
        const live = try (
          provideHost(queryOf(name, params)) |> Effect.catch(%, (param) => refuse(plugin, "invalid_fields", `${name} needs ${param}`))
        )
        return live as unknown as Host.Live<R>
      },
    select: (item: Host.ItemRef) =>
      effect {
        // Every view of this plugin that reads the item's query acts on it: the strip under it shows its actions.
        const targets = plugins.contributions.views.filter((view) => view.plugin === plugin && (view.reads ?? []).includes(item.query))
        const params = item.params ?? null
        const query = readable(plugins, item.query, params)
        if (targets.length === 0 || query === undefined) return try refuse(plugin, "not_in_reads", item.query)
        if (!(try sync(() => query.live.current().some((row) => row[query.key] === item.key)))) return try refuse(plugin, "not_in_reads", "no such row")
        for (const view of targets) {
          try provideHost(touch(view.id, (row) =>
            row.item === item.key && row.query === item.query && paramsKey(row.params) === paramsKey(params)
              ? {}
              : { query: item.query, params, item: item.key, failed: false }
          ))
        }
      },
    propose: (ref: Host.EventRef, fields: unknown) =>
      effect {
        const { event } = try eventOf(ref)
        if (!("flow" in event) || !event.personOnly) {
          return try refuse(plugin, "undeclared_event", "only the strip's events are proposed")
        }
        const invalid = misfit(event.payload, fields)
        if (Option.isSome(invalid)) return try refuse(plugin, "invalid_fields", invalid.value)
        const text = (try sync(() => textFields(event))).map((field) => (fields as Record<string, unknown>)[field]).find((value) => typeof value === "string")
        if (typeof text === "string") try provideHost(setDraft(ref.view, text))
      },
    dispatch: (ref: Host.EventRef, fields: unknown) =>
      effect {
        const { view, event } = try eventOf(ref)
        if (!("flow" in event)) return try refuse(plugin, "undeclared_event", "a local event stays in its view")
        if (personOnly(event)) return try refuse(plugin, "person_only", event.flow)
        const invalid = misfit(event.payload, fields)
        if (Option.isSome(invalid)) return try refuse(plugin, "invalid_fields", invalid.value)
        const item = try provideHost(selectedOf(view.id))
        const payload = try sync(() => Bind.bind(event.args, { item, event: fields }))
        if (Result.isFailure(payload)) return try refuse(plugin, "invalid_fields", payload.failure)
        const runId = try sync(() => WebCrypto.defaultValue().randomUUID())
        const flows = try provideHost(FlowDispatch)
        // The view hears how its run ended, failed or interrupted included, so it never says Sending for good.
        const settled = try Deferred.make<Host.Settled>()
        try (
          flows.dispatch(event.flow as FlowName, payload.success as never, { door: "view", executionId: runId })
            |> onExit(%, (exit) => Deferred.succeed(settled, settledOf(exit)))
            |> ignore(%)
            |> forkIn(%, plugins.scope)
        )
        return { runId, settled: Deferred.await(settled) }
      },
    open: (id: string, repository?: Host.Repository) =>
      effect {
        const view = viewById(plugins.contributions, id)
        const to = view?.plugin === plugin ? pathOf(view, repository) : undefined
        if (to === undefined) return
        const flows = try provideHost(FlowDispatch)
        try (flows.dispatch("app/navigate", { to }, { door: "view" }) |> ignore(%) |> forkIn(%, plugins.scope))
      },
    events: (id: string) =>
      viewById(plugins.contributions, id)?.plugin === plugin
        ? Stream.fromPubSub(plugins.delivered)
          |> Stream.filter(%, (event) => event.view === id)
          |> Stream.map(%, ({ name, fields }) => ({ name, fields }))
        : Stream.empty,
  } satisfies Host.PluginHost
}
