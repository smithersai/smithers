import { Clock, Duration, Effect, Fiber, FiberHandle, Option } from "effect"
import { put } from "../repo/actions.vibe"
import { type DocsRefused, DocsClient } from "./api.vibe"
import { type LoadKind, recordLoad } from "./records.vibe"
import { CURRENT, type CurrentRow, pageKeyOf, repoKeyOf, searchKeyOf } from "./rows"
import { DocsStore } from "./store.vibe"
import { repoId } from "../repo/contract"
import { RepoStore } from "../repo/store.vibe"

// What the Docs tab does (docs/features/docs.md#the-docs-tab). A route opens a repository's docs: its index, and the
// page it names; the searchbox searches as the person types. Each is one read of ChatApi's docs routes, kept in this
// tab's rows and read once: a refused one is read again on the next open. Loads run in the store's scope, so leaving
// a page lets them finish into the rows; a search typed over another interrupts it, and only the search the box holds
// shows, so an answer that comes late never replaces a newer one.

/** How long a route's warm waits for the docs before it shows the page anyway. */
export const WARM_WITHIN = Duration.seconds(1)

/** Changes the current row. */
const setCurrent = (fields: Partial<Omit<CurrentRow, "id">>) =>
  Effect.flatMap(DocsStore, ({ current }) => Effect.orDie(current.update(CURRENT, (row) => void Object.assign(row, fields))))

/** Why ChatApi didn't answer, as the rows and records say it: its code, else `unavailable`. */
const codeOf = (failure: DocsRefused): string => failure.code ?? "unavailable"

/**
 * Reads one thing into `rows` under `key` unless this tab has it or is reading it: a `loading` row first, then what
 * `read` answers, recorded as `kind`. A read interrupted before it answered leaves no row, so the next one reads again.
 */
const load = <A, Row extends { readonly key: string; readonly state: string }>(
  kind: LoadKind,
  rows: (store: DocsStore["Service"]) => import("@smthrs/effect-tanstack-db").Collection.Collection<Row, string>,
  key: string,
  loading: Row,
  read: Effect.Effect<A, DocsRefused, DocsClient>,
  done: (answer: A) => { readonly row: Row; readonly results?: number },
  refused: (code: string) => Row,
) =>
  (effect {
    const collection = rows(try DocsStore)
    const kept = try collection.get(key)
    if (Option.isSome(kept) && kept.value.state !== "refused") return
    // Whose repository: every key starts `owner/name`. One that refused this person reads nothing more, and a read
    // already on its way when it did writes nothing after.
    const repos = Option.getOrUndefined(try Effect.serviceOption(RepoStore))
    const id = `github/${key.split(/[:?]/, 1)[0]}`
    if ((try sync(() => repos?.isRefused(id))) === true) return
    const fence = (try sync(() => repos?.fenceOf(id))) ?? 0
    const fenced = (write: Effect.Effect<void>) => repos === undefined ? write : repos.fenced(id, fence, write)
    try put(collection, key, loading)
    const startedAt = try Clock.currentTimeMillis
    const result = try Effect.result(read)
    const durationMs = (try Clock.currentTimeMillis) - startedAt
    if (result._tag === "Failure") {
      const code = codeOf(result.failure)
      try fenced(put(collection, key, refused(code)))
      return try recordLoad(kind, code, durationMs, { status: result.failure.status })
    }
    const answered = done(result.success)
    try fenced(put(collection, key, answered.row))
    try recordLoad(kind, "ok", durationMs, { results: answered.results })
  }).pipe(
    Effect.onInterrupt(() =>
      Effect.flatMap(DocsStore, (store) => Effect.ignore(rows(store).delete(key)))
    ),
    Effect.withSpan("docs.tab"),
  )

/** `owner/name`'s docs index. */
const loadIndex = (owner: string, name: string) =>
  effect {
    const client = try DocsClient
    const id = repoId(owner, name)
    const key = try sync(() => repoKeyOf(owner, name))
    return try load(
      "index",
      (store) => store.indexes,
      key,
      { key, repoId: id, state: "loading" as const, title: "", summary: null, pages: [], code: null },
      client.search(owner, name, ""),
      (listing) => ({
        row: { key, repoId: id, state: "ready" as const, title: listing.title, summary: listing.summary ?? null, pages: listing.pages, code: null },
        results: listing.pages.length,
      }),
      (code) => ({ key, repoId: id, state: "refused" as const, title: "", summary: null, pages: [], code }),
    )
  }

/** One page of `owner/name`'s docs. */
const loadPage = (owner: string, name: string, path: string) =>
  effect {
    const client = try DocsClient
    const id = repoId(owner, name)
    const key = try sync(() => pageKeyOf(repoKeyOf(owner, name), path))
    return try load(
      "page",
      (store) => store.pages,
      key,
      { key, repoId: id, state: "loading" as const, title: "", url: "", text: "", code: null },
      client.page(owner, name, path),
      (page) => ({ row: { key, repoId: id, state: "text" as const, title: page.title, url: page.url, text: page.text, code: null } }),
      (code) => ({ key, repoId: id, state: "refused" as const, title: "", url: "", text: "", code }),
    )
  }

/** A search of `owner/name`'s docs for `query`'s words. */
const loadSearch = (owner: string, name: string, query: string) =>
  effect {
    const client = try DocsClient
    const id = repoId(owner, name)
    const key = try sync(() => searchKeyOf(repoKeyOf(owner, name), query))
    return try load(
      "search",
      (store) => store.searches,
      key,
      { key, repoId: id, state: "loading" as const, pages: [], code: null },
      client.search(owner, name, query.trim()),
      (listing) => ({ row: { key, repoId: id, state: "ready" as const, pages: listing.pages, code: null }, results: listing.pages.length }),
      (code) => ({ key, repoId: id, state: "refused" as const, pages: [], code }),
    )
  }

/** Starts the reads `owner/name`'s docs page needs in the store's scope: its index, and the page at `path`. */
const start = (owner: string, name: string, path: string | undefined) =>
  effect {
    const { scope } = try DocsStore
    const index = fork.in(scope) loadIndex(owner, name)
    const page = path === undefined ? undefined : fork.in(scope) loadPage(owner, name, path)
    return page === undefined ? [index] : [index, page]
  }

/**
 * A docs route, before it shows: reads `owner/name`'s index, and the page at `path`, into this tab without showing
 * them. Ends once read, or after {@link WARM_WITHIN}; the reads go on.
 */
export const warm = (owner: string, name: string, path?: string) =>
  effect {
    const fibers = try start(owner, name, path)
    try Effect.timeoutOption(Fiber.joinAll(fibers), WARM_WITHIN)
  }

/**
 * A docs route, once warm: shows `owner/name`'s docs, at the page at `path` or its index, and reads what this tab
 * lacks. The searchbox keeps its words within one repository's docs and empties for another's.
 */
export const open = (owner: string, name: string, path?: string) =>
  effect {
    const store = try DocsStore
    const repoKey = try sync(() => repoKeyOf(owner, name))
    const was = Option.getOrThrow(try store.current.get(CURRENT))
    const same = was.repoKey === repoKey
    if (!same) try FiberHandle.clear(store.searcher)
    try setCurrent({
      owner,
      name,
      repoKey,
      path: path ?? null,
      pageKey: path === undefined ? null : try sync(() => pageKeyOf(repoKey, path)),
      query: same ? was.query : "",
      searchKey: same ? was.searchKey : null,
    })
    try start(owner, name, path)
  }

/**
 * The searchbox: holds `query` and searches the routed repository's docs for its words, interrupting the search
 * before; with no words, the index shows again.
 */
export const search = (query: string) =>
  effect {
    const store = try DocsStore
    const current = Option.getOrThrow(try store.current.get(CURRENT))
    const words = query.trim() !== ""
    const searchKey = words ? try sync(() => searchKeyOf(current.repoKey, query)) : null
    try setCurrent({ query, searchKey })
    // The same words with other spaces: the search on its way is this one.
    if (searchKey === current.searchKey) return
    if (!words) return try FiberHandle.clear(store.searcher)
    try FiberHandle.run(store.searcher, loadSearch(current.owner, current.name, query))
  }
