import { WebCrypto as WebCryptoReference } from "effect/crypto/WebCrypto"
import { Interpreter } from "@smthrs/flow"
import { Effect, Layer } from "effect"
import { isRepository } from "../repo/contract"
import { ViewsClient } from "../views/api"
import { isAgentCall, viewConversation } from "../views/conversation"
import { DocsClient, type DocsRefused } from "./api.vibe"
import { AGENT_TEXT_BYTES, DEFAULT_SHOWN } from "./contract"
import {
  DocsForbidden,
  DocsSearchRefused,
  type DocsShown,
  DocsUnavailable,
  FindPages,
  type FoundPages,
  PlanSearch,
  type PlannedSearch,
  SearchDocs,
  ShowPages,
  type ShownPage,
} from "./flows"
import { recordSearch, type SearchOutcome, withSearchSpan } from "./metrics.vibe"
import { cutText } from "./text"

// What `app/docs/search`'s steps run on (docs/features/docs.md#the-flow): ChatApi's docs routes (`DocsClient`) and its
// views route (`ViewsClient`). Each step runs in a span `docs.search`; each search is counted and logged once it
// settles, or each time a step fails, by who asked (src/features/docs/metrics.vibe).

/** Who asked, for the records: the agent's call is a child of its answer's run. */
const doorOf = Effect.map(isAgentCall, (agent) => (agent ? "agent" as const : "person" as const))

/** Records a failed step and fails with its error. */
const failed = <E extends DocsSearchRefused | DocsForbidden | DocsUnavailable>(outcome: SearchOutcome, error: E) =>
  effect {
    try recordSearch({
      door: try doorOf,
      outcome,
      ...(error instanceof DocsSearchRefused ? { reason: error.reason } : {}),
    })
    throw error
  }

/** What a docs site that didn't answer as docs says when it may answer next time. */
const PASSING: ReadonlyArray<string | undefined> = ["unreachable", "timeout", "busy"]

/**
 * Whether the docs site answered, but not with the docs: an error status, not text, too large, or a redirect it won't
 * follow. Trying again changes nothing; only no answer, none in time, or a busy site (429 or 5xx) may pass.
 */
const unreadable = (refused: DocsRefused) =>
  refused.code === "docs_unreachable" && !PASSING.includes(refused.reason)

/** What a refusal of the docs routes means to a step: the repository's (a refusal) or a passing one (unavailable). */
const docsFailure = (refused: DocsRefused) =>
  refused.status === 404 && (refused.code === "no_docs" || refused.code === "not_found")
    ? failed("refused", new DocsSearchRefused({ reason: refused.code }))
    : refused.status === 400
    ? failed("refused", new DocsSearchRefused({ reason: "invalid" }))
    : unreadable(refused)
    ? failed("refused", new DocsSearchRefused({ reason: "unreadable" }))
    : failed("unavailable", new DocsUnavailable())

/** `app/docs/plan`: the repository `owner/name` GitHub could have, and a fresh id for each view to show. */
export const plan = (asked: {
  readonly repository: string
  readonly query: string
  readonly pages?: number | undefined
  readonly conversationId?: string | undefined
}) =>
  (effect {
    const [owner, name, ...rest] = asked.repository.trim().split("/")
    if (owner === undefined || name === undefined || rest.length > 0 || !(try sync(() => isRepository(owner, name)))) {
      return try failed("refused", new DocsSearchRefused({ reason: "invalid" }))
    }
    return {
      owner,
      name,
      query: asked.query,
      viewIds: Array.from({ length: asked.pages ?? DEFAULT_SHOWN }, () => WebCryptoReference.defaultValue().randomUUID()),
      ...(asked.conversationId === undefined ? {} : { conversationId: asked.conversationId.toLowerCase() }),
    } satisfies PlannedSearch
  }).pipe(withSearchSpan)

/** `app/docs/find`: the best pages of the repository's docs for the query, at most one per view the plan picked. */
export const find = (search: PlannedSearch) =>
  (effect {
    const found = try Effect.result((try DocsClient).search(search.owner, search.name, search.query))
    if (found._tag === "Failure") return try docsFailure(found.failure)
    try Effect.annotateCurrentSpan({ "smithers.docs.results": found.success.pages.length })
    return found.success.pages.slice(0, search.viewIds.length)
  }).pipe(withSearchSpan)

/**
 * `app/docs/show`: for each found page, ChatApi reads it and adds a `docs` view under the id the plan picked, so a
 * retried or resumed step adds the same views. A page the index no longer lists, or the site doesn't serve, is left out.
 * It answers the shown pages
 * and at most `AGENT_TEXT_BYTES` of each one's Markdown, for the agent to answer from.
 */
export const show = ({ search, found }: FoundPages) =>
  (effect {
    const docs = try DocsClient
    const views = try ViewsClient
    const conversation = try viewConversation(search.conversationId)
    const shown: Array<ShownPage> = []
    const texts: Array<string> = []
    for (const [index, listed] of found.entries()) {
      const read = try Effect.result(docs.page(search.owner, search.name, listed.path))
      if (read._tag === "Failure") {
        // A page the index no longer lists, or the site no longer serves, isn't shown.
        if (read.failure.code === "page_not_found" || unreadable(read.failure)) continue
        return try docsFailure(read.failure)
      }
      const page = read.success
      const viewId = search.viewIds[index]!
      const added = try Effect.result(views.add({
        id: viewId,
        template: "docs",
        props: { url: page.url, title: page.title, repository: `${search.owner}/${search.name}`, path: page.path },
        ...conversation,
      }))
      if (added._tag === "Failure") {
        const status = added.failure.status
        return try (status === 401 || status === 403
          ? failed("forbidden", new DocsForbidden())
          : status === 400
          ? failed("refused", new DocsSearchRefused({ reason: "invalid" }))
          : failed("unavailable", new DocsUnavailable()))
      }
      shown.push({ title: page.title, path: page.path, url: page.url, viewId })
      const text = try sync(() => cutText(page.text, AGENT_TEXT_BYTES).text)
      texts.push(`# ${page.title}\n\n${text}`)
    }
    try recordSearch({
      door: try doorOf,
      outcome: shown.length > 0 ? "shown" : "none",
      results: found.length,
      shown: shown.length,
    })
    return {
      pages: shown,
      ...(texts.length === 0 ? {} : { text: texts.join("\n\n---\n\n") }),
    } satisfies DocsShown
  }).pipe(withSearchSpan)

/** Registers `app/docs/search` with its steps, over the host's `DocsClient` and `ViewsClient`. */
export const registration = Interpreter.layerWithImplementations(
  SearchDocs,
  Layer.mergeAll(PlanSearch.toLayer(plan), FindPages.toLayer(find), ShowPages.toLayer(show)),
)
