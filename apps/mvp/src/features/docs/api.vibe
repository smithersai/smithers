import { Context, type Duration, Effect, Layer, Option, Schema } from "effect"
import { HttpClient, HttpClientRequest } from "effect/http"
import { docsPageRoute, docsRoute, type DocsRefusal } from "./contract"
import { DocsListing, DocsPage, DocsRefusalBody } from "./schema"

// ChatApi's docs routes as the browser and `app/docs/search`'s steps call them (worker/docs/Api.ts), through Effect's
// HttpClient, with one deadline over each whole exchange.

/**
 * ChatApi didn't answer with docs: no network or no whole answer in time (no `status`), or a refusal (`status`, with
 * its `code` and, for a docs site that didn't answer, its `reason`, when its body had them).
 */
export error DocsRefused {
  status?: number
  code?: DocsRefusal
  reason?: string
}

/** How long one request to the docs routes may take: the docs site's own deadline is 8 s. */
export const DOCS_WITHIN = "20 seconds"

const decodeRefusal = Schema.decodeUnknownOption(Schema.fromJsonString(DocsRefusalBody))

const get = <A, I>(url: string, schema: Schema.Codec<A, I>, within: Duration.Input) =>
  effect {
    const client = try HttpClient.HttpClient
    const response = try client.execute(HttpClientRequest.get(url)).pipe(Effect.mapError(() => new DocsRefused({})))
    try Effect.annotateCurrentSpan({ "http.response.status_code": response.status })
    if (response.status !== 200) {
      const text = response.text catch () => ""
      const body = decodeRefusal(text)
      throw new DocsRefused({
        status: response.status,
        ...Option.match(body, { onNone: () => ({}), onSome: (refusal) => refusal }),
      })
    }
    return try response.json.pipe(
      Effect.flatMap(Schema.decodeUnknownEffect(schema)),
      Effect.mapError(() => new DocsRefused({ status: response.status })),
    )
  }.pipe(
    // Interrupting the request aborts its fetch, so a stalled body stops too.
    Effect.timeoutOrElse({ duration: within, orElse: effect () => { throw new DocsRefused({}) } }),
  )

/**
 * A repository's docs through ChatApi on `origin`: `search` its index (every page, in order, for an empty query) and
 * read one `page` of it. A test of a ChatApi that fails provides a faulty one; every other test uses the real one.
 */
export class DocsClient extends Context.Service<
  DocsClient,
  {
    readonly search: (owner: string, name: string, query: string) => Effect.Effect<DocsListing, DocsRefused>
    readonly page: (owner: string, name: string, path: string) => Effect.Effect<DocsPage, DocsRefused>
  }
>()("@smthrs/mvp/docs/DocsClient") {
  /** The real client: ChatApi at `origin`, with `within` for each whole request (`DOCS_WITHIN` unless set). */
  static readonly layer = (options: { readonly origin: string; readonly within?: Duration.Input }) =>
    Layer.effect(
      DocsClient,
      effect {
        const client = try HttpClient.HttpClient
        const within = options.within ?? DOCS_WITHIN
        return DocsClient.of({
          search: Effect.fn("docs.search.get")(effect (owner, name, query) => {
            const route = try sync(() => docsRoute(owner, name, query))
            return try get(`${options.origin}${route}`, DocsListing, within).pipe(
              Effect.provideService(HttpClient.HttpClient, client),
            )
          }),
          page: Effect.fn("docs.page.get")(effect (owner, name, path) => {
            const route = try sync(() => docsPageRoute(owner, name, path))
            return try get(`${options.origin}${route}`, DocsPage, within).pipe(
              Effect.provideService(HttpClient.HttpClient, client),
            )
          }),
        })
      },
    )
}
