import { FlowDispatch } from "../../flows/dispatch.vibe"
import { timeOf } from "../attention/entries"
import { dropped } from "./metrics"
import { SEARCH } from "./schema"
import { ConversationsStore } from "./store"

// What a person does with their list (docs/features/conversations.md#the-list): search it, switch to the archived
// conversations and back, and Archive or Restore one. Archive and Restore show on this device straight away, kept on
// the device until the synced row shows them, and run on as `conversation/archive` (door `button`), one run per press.
// An act that can't land (the engine refused it, or ChatApi did, or it went unsent for a day) leaves the device too,
// so the row shows as it is and the person can act again.

/** The run of this device's act on `conversationId` at `at`: the same act always names the same run. */
export const archiveRun = (conversationId: string, at: number) => `conversation-archive:${conversationId}:${at}`

/**
 * Runs `conversation/archive` for the act this device holds on `conversationId` at `at`, or joins its run when it has one
 * already: the engine starts each run once, and the act's run is named by the act. Waits in the store's scope for the
 * run to end; when it can't land, the act leaves the device, unless a later act replaced it, and a log line
 * `conversations.dropped` and a count of `dropped` say so.
 */
effect function send(conversationId: string, archived: boolean, at: number) {
  const { pending, scope } = try ConversationsStore
  const drop = (reason: string) =>
    orDie(effect {
      const now = try pending.get(conversationId)
      if (Option.isNone(now) || now.value.at !== at) return
      try pending.delete(conversationId)
      try Metric.update(Metric.withAttributes(dropped, { reason }), 1)
      try (logWarning("conversations.dropped") |> annotateLogs(%, { conversationId, archived, reason, feature: "conversations" }))
    })
  const flows = try FlowDispatch
  try (
    flows.dispatch(
      "conversation/archive",
      { conversationId, archived, at },
      { door: "button", executionId: archiveRun(conversationId, at) },
    )
      |> flatMap(%, (done) => (done._tag === "Done" ? Effect.void : fail(done.error)))
      |> Effect.catch(%, (error) => drop(error._tag))
      |> forkIn(%, scope)
  )
}

/**
 * Archives conversation `conversationId` for this person, or, with `archived` false, brings it back: at once on this
 * device, then on all of theirs through ChatApi. A later act on the same conversation replaces this one; each act is
 * later than the last this device did or saw for it.
 */
export const archive = (conversationId: string, archived: boolean) =>
  effect {
    const { mine, pending } = try ConversationsStore
    const held = try pending.get(conversationId)
    const row = try mine.get(conversationId)
    // Later than anything this device has seen for it: a second press in the same millisecond, or a clock behind the
    // server's, still wins.
    const at = Math.max(
      try Clock.currentTimeMillis,
      match (held) {
        when { _tag: "Some", let value }: value.at + 1;
        default: 0;
      },
      try sync(() => Option.match(row, { onNone: () => 0, onSome: (synced) => timeOf(synced.changedAt) + 1 })),
    )
    if (Option.isSome(held)) {
      try pending.update(conversationId, (draft) => {
        draft.archived = archived
        draft.at = at
      })
    } else try pending.insert({ conversationId, archived, at })
    try send(conversationId, archived, at)
  }
    // A local collection refuses only a row its own schema rejects, which these never are: a bug, not a state.
    |> orDie(%)
    |> withSpan(%, "conversations.archive")

/**
 * Follows every act this device still holds, as a page opening does after a reload: each joins its run, or starts it if
 * the tab closed before it could, so an act that can't land still leaves the device.
 */
export const resume = orDie(effect {
  const { pending } = try ConversationsStore
  // Once the device has restored them; a device store that can't be read has none to follow.
  try ignore(pending.restored)
  for (const act of try pending.toArray) try send(act.conversationId, act.archived, act.at)
})

/**
 * When opening branch `branch` of `owner/repo` happens: now, or, if the device saw a later act on its conversation (a
 * clock behind the server's, or an archive pressed this millisecond), just after it, so the open wins over it.
 */
export effect function openAt(owner: string, repo: string, branch: string) {
  const { mine, pending } = try ConversationsStore
  const row = (try mine.toArray).find((mineRow) =>
    mineRow.owner.toLowerCase() === owner.toLowerCase() && mineRow.repo.toLowerCase() === repo.toLowerCase() &&
    mineRow.branch === branch
  )
  const act = row === undefined ? Option.none() : try pending.get(row.conversationId)
  return Math.max(
    try Clock.currentTimeMillis,
    row === undefined ? 0 : (try sync(() => timeOf(row.changedAt))) + 1,
    match (act) {
      when { _tag: "Some", let value }: value.at + 1;
      default: 0;
    },
  )
}

/** Searches the list for `text`: every word, in a conversation's repository or branch name. */
export const search = (text: string) =>
  flatMap(ConversationsStore, ({ search }) => orDie(search.update(SEARCH, (draft) => void (draft.text = text))))

/** Shows the archived conversations instead (`true`), or those that aren't. */
export const showArchived = (archived: boolean) =>
  flatMap(ConversationsStore, ({ search }) => orDie(search.update(SEARCH, (draft) => void (draft.archived = archived))))
