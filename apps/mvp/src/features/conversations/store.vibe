import type { ElectricCollection } from "@smthrs/effect-electric"
import { Collection, LiveQuery } from "@smthrs/effect-tanstack-db"
import { ConversationOwners } from "./owners"
import type { Source } from "../repo/gate"
import { observeShape } from "../issues/shapeSync.vibe"
import { listUpdates, shapeTransitions } from "./metrics"
import { landed, listOf } from "./list"
import { Listed, Mine, Pending, SEARCH, Search } from "./schema"

// Your conversations on this tab (decision 0013 decision 2, docs/features/conversations.md#the-browser): the person's
// `conversation_people` rows, synced by Electric and kept on the device, so the list shows offline and every device of
// theirs agrees; the archives and restores this device did that haven't synced back yet, kept on the device too; the
// list's search; and the rows the list shows, worked out from all three (`listOf`) by a follower that also forgets the
// acts the rows show.

/** Where the rows sync from: ChatApi's origin, the site's own. */
export interface ConversationsConfig {
  readonly origin: string
}

/** The list this tab shows, the latest opened first. */
export const listQuery = (list: Source<Listed>) =>
  LiveQuery.make((q) =>
    // Electric's UTC timestamps omit the fraction at whole seconds. Locale collation puts '+' after '.', reversing
    // a whole second and a later fraction; code-point order preserves their chronological order.
    q.from({ row: list.tanstack }).orderBy(({ row }) => row.openedAt, { direction: "desc", stringSort: "lexical" })
      .orderBy(({ row }) => row.conversationId)
  )

/** The list's search on this tab. */
export const searchQuery = (search: Collection.Collection<Search, string>) =>
  LiveQuery.make((q) => q.from({ search: search.tanstack }).findOne())

export class ConversationsStore extends Context.Service<
  ConversationsStore,
  {
    readonly mine: ElectricCollection.ElectricCollection<Mine>
    readonly pending: Collection.Collection<Pending, string>
    readonly search: Collection.Collection<Search, string>
    /** The list worked out from the rows: the store's own. What shows reads `listState`, through the data gate. */
    readonly list: Collection.Collection<Listed, string>
    /** The list, only the conversations whose repository may show, or the person's home (owners.ts `ofShown`). */
    readonly listState: Effect.Success<ReturnType<typeof listQuery>>
    readonly searchState: Effect.Success<ReturnType<typeof searchQuery>>
    /** Where the background work an action starts runs. */
    readonly scope: Scope.Scope
  }
>()("@smthrs/mvp/conversations/ConversationsStore") {
  /** The store, its follower running until the scope closes. */
  static readonly layer = (_config: ConversationsConfig) =>
    Layer.effect(
      ConversationsStore,
      effect {
        const scope = try Effect.scope
        // The rows sync once, below every store that attributes a conversation's rows by them (owners.ts).
        const owners = try ConversationOwners
        const { mine } = owners
        try forkIn(observeShape(mine.sync, "conversations.shape.sync", shapeTransitions), scope, { startImmediately: true })
        const pending = try Collection.persisted<Pending, string>({
          id: "conversation-pending",
          schema: Pending,
          getKey: (row) => row.conversationId,
          schemaVersion: 1,
        })
        // Expose the store only after local pending acts are restored. An empty pre-restore snapshot must not look
        // settled to a consumer while the resume fiber is still waiting for the device's rows.
        try ignore(pending.restored)
        const search = try Collection.local<Search, string>({
          id: "conversation-search",
          schema: Search,
          getKey: (row) => row.id,
          initialData: [{ id: SEARCH, text: "", archived: false, loaded: false }],
        })
        const list = try Collection.local<Listed, string>({
          id: "conversation-list",
          schema: Listed,
          getKey: (row) => row.conversationId,
        })

        // The list: worked out again whenever a row, an act or the search changes.
        let projection: string | undefined
        // Local collections refuse only rows their own schema rejects, which `listOf` never makes: a bug, not a state.
        const work = orDie(effect {
          const rows = try mine.toArray
          const acts = try pending.toArray
          // The search always holds its one row.
          const showing = (try search.toArray)[0]!
          const next = try sync(() => listOf(rows, acts, showing))
          const keep = new Set(next.map((row) => row.conversationId))
          const before = new Map((try list.toArray).map((row) => [row.conversationId, row]))
          const gone = [...before.keys()].filter((id) => !keep.has(id))
          if (gone.length > 0) try list.delete(gone)
          for (const row of next) {
            const old = before.get(row.conversationId)
            if (old === undefined) try list.insert(row)
            else if ((Object.keys(row) as ReadonlyArray<keyof Listed>).some((field) => old[field] !== row[field])) {
              try list.update(row.conversationId, (draft) => void Object.assign(draft, row))
            }
          }
          // Counts distinguish a pending shape, missing personal rows and a filtered list without recording content.
          const fields = {
            syncedRows: rows.length,
            pendingRows: acts.length,
            listedRows: next.length,
            archived: showing.archived,
            loaded: showing.loaded,
          }
          const snapshot = JSON.stringify(fields)
          if (snapshot !== projection) {
            projection = snapshot
            try withSpan(effect {
              try Metric.update(Metric.withAttributes(listUpdates, { archived: String(showing.archived), loaded: String(showing.loaded) }), 1)
              try annotateCurrentSpan(fields)
              try (logInfo("conversations.list") |> annotateLogs(%, fields))
            }, "conversations.list")
          }
          const done = try sync(() => landed(rows, acts))
          if (done.length > 0) try pending.delete([...done])
        })
        try (
          Stream.mergeAll(
            [
              Stream.map(mine.changes({ initial: true }), () => undefined),
              Stream.map(pending.changes({ initial: true }), () => undefined),
              Stream.map(search.changes({ initial: true }), () => undefined),
            ],
            { concurrency: "unbounded" },
          )
            |> Stream.runForEach(%, () => work)
            |> forkIn(%, scope, { startImmediately: true })
        )

        // Loaded: the device's rows restored and the first sync answered, or failed: the list says it is empty only then.
        try forkIn(effect {
          try ignore(mine.restored)
          try ignore(mine.preload)
          try orDie(search.update(SEARCH, (draft) => void (draft.loaded = true)))
        }, scope, { startImmediately: true })

        return ConversationsStore.of({
          mine,
          pending,
          search,
          list,
          // A refused or hidden repository's conversations leave the list, names included (ruling #4); `mine` and `list`
          // stay whole for reconciling the acts this device did.
          listState: try listQuery((try owners.ofShown(list, "conversationId")) as unknown as Source<Listed>),
          searchState: try searchQuery(search),
          scope,
        })
      },
    )
}
