import * as Creation from "../branch/creationSteps.vibe"
import { Uuid } from "@smthrs/crypto"
import { FlowRuntime, Interpreter } from "@smthrs/flow"
import { requesterOf } from "../../flows/requests.vibe"
import { BranchClient } from "../branch/api.vibe"
import { CONVERSATION_NAMESPACE } from "../branch/contract"
import { BranchTrackRefused } from "../branch/flows"
import { trackFailure } from "../branch/steps.vibe"
import { GoTo, goTo } from "../navigation/flows.vibe"
import { parts } from "../repo/flows.vibe"
import { ArchiveNotTaken, ConversationsClient } from "./api"
import { branchPath, newBranchName } from "./contract"
import {
  type ArchiveFailure,
  ArchiveRefused,
  ArchiveRequest,
  ArchiveStamp,
  ArchiveUnsent,
  ConversationArchive,
  ConversationNew,
  NewRequest,
  NewStamp,
} from "./flows"
import { archives, news } from "./metrics"
import type { Made } from "./schema"

// Your conversations' steps (docs/features/conversations.md#flows): one ChatApi request each. A person's press in the
// list, `/new` in the composer and the agent's call run them on this device's engine. No log line carries a branch's
// name, a repository or anything asked.

/** What ChatApi's refusal means to the flow: a 4xx other than 408 or 429 is final; anything else is tried again. */
export const failureOf = (refused: ArchiveNotTaken): ArchiveFailure =>
  refused.status !== undefined && refused.status >= 400 && refused.status < 500 && refused.status !== 408 &&
    refused.status !== 429
    ? new ArchiveRefused({ status: refused.status })
    : new ArchiveUnsent()

/**
 * Which conversation an act names: the one in the payload, or, for the agent's call, the one its answer is in (its run's
 * requester, `requesterOf`). A person's call that names none names nothing.
 */
const targetOf = (conversationId: string | undefined) =>
  map(FlowRuntime.FlowInstance, ({ executionId }) => {
    if (conversationId !== undefined) return { conversationId: conversationId.toLowerCase() }
    const requester = requesterOf(executionId)
    return requester !== executionId && isUuid(requester) ? { answerId: requester.toLowerCase() } : undefined
  })

const isUuid = (id: string) => /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)

/**
 * `conversation/archive/request`: one `POST /api/conversations/archive`, at the act's `at`. Recorded as a log
 * line `conversation.archive` and a count of `archives` by `archived` and outcome: `sent`, `refused` or `unsent`. A
 * person's call naming no conversation is refused 400 without a request.
 */
export const requestArchive = (
  request: { readonly conversationId?: string | undefined; readonly archived: boolean; readonly at: number },
) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const target = try targetOf(request.conversationId)
    const answer = target === undefined
      ? Result.fail(new ArchiveNotTaken({ status: 400 }))
      : try result((try ConversationsClient).archive({ ...target, archived: request.archived, at: request.at }))
    const failure = answer._tag === "Failure" ? failureOf(answer.failure) : undefined
    const outcome = failure === undefined
      ? "sent"
      : failure._tag === "@smthrs/mvp/conversations/ArchiveRefused"
      ? "refused"
      : "unsent"
    try Metric.update(Metric.withAttributes(archives, { archived: String(request.archived), outcome }), 1)
    try annotateCurrentSpan({ outcome })
    try (
      logWithLevel(failure === undefined ? "Info" : "Warn")("conversation.archive") |> annotateLogs(%, {
        ...(target ?? {}),
        archived: request.archived,
        outcome,
        ...(answer._tag === "Failure" && answer.failure.status !== undefined ? { status: answer.failure.status } : {}),
        durationMs: (try Clock.currentTimeMillis) - startedAt,
        feature: "conversations",
      })
    )
    if (failure !== undefined) throw failure
    return { archived: request.archived }
  } |> withSpan(%, "conversation.archive")

/** `owner/name` of a repository id, `github/<owner>/<name>`. */
const repoOf = (repoId: string) => repoId.split("/").slice(1).join("/")

/**
 * `conversation/new/request`: one `POST /api/branches { create: true, request }` for `branch`, or, without one, a name
 * drawn from the run. `request` is the run's own id, so a step tried again gets the branch it made, and a name someone
 * already has, tracked or not, is refused `exists`: never an existing conversation as a fresh one. Answers the branch with the path of
 * its page: in `repo` as the person named it, else in the repository ChatApi made it in. Recorded as a log line
 * `conversation.new` and a count of `news` by outcome: `made`, the refusal's reason, or `unavailable`.
 */
export const requestNew = (
  request: { readonly repo?: string | undefined; readonly branch?: string | undefined; readonly at: number },
) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const { executionId } = try FlowRuntime.FlowInstance
    // The run's own request: a branch the app tracks answers only to the run that made it.
    const requestId = try (Uuid.v5(CONVERSATION_NAMESPACE, executionId) |> orDie(%))
    const branch = request.branch ?? (try sync(() => newBranchName(requestId)))
    const repository = request.repo === undefined ? {} : (([owner, name]) => ({ owner, name }))(parts(request.repo))
    const answer = try result(
      Creation.run({ ...repository, ref: branch, request: requestId, openedAt: request.at }),
    )
    const failure = answer._tag === "Failure" ? answer.failure : undefined
    const outcome = failure === undefined
      ? "made"
      : failure._tag === "@smthrs/mvp/branch/BranchTrackRefused"
      ? (failure as BranchTrackRefused).reason
      : "unavailable"
    try Metric.update(Metric.withAttributes(news, { outcome }), 1)
    try annotateCurrentSpan({ outcome })
    try (
      logWithLevel(failure === undefined ? "Info" : "Warn")("conversation.new") |> annotateLogs(%, {
        outcome,
        ...(answer._tag === "Success" ? { conversationId: answer.success.conversationId } : {}),
        durationMs: (try Clock.currentTimeMillis) - startedAt,
        feature: "conversations",
      })
    )
    if (answer._tag === "Failure") throw failure!
    const made = answer.success
    return { ...made, path: try sync(() => branchPath(request.repo ?? repoOf(made.repoId), made.name)) } satisfies Made
  } |> withSpan(%, "conversation.new")

/** `at`, or the clock's now: the time an act was taken. */
export const stamp = <P extends object>(payload: P & { readonly at?: number | undefined }) =>
  map(Clock.currentTimeMillis, (now) => ({ ...payload, at: payload.at ?? now }))

/** Registers `conversation/archive` and `conversation/new` with their steps. */
export const registration = Layer.merge(
  Interpreter.layerWithImplementations(
    ConversationArchive,
    Layer.merge(ArchiveStamp.toLayer(stamp), ArchiveRequest.toLayer(requestArchive)),
  ),
  Interpreter.layerWithImplementations(
    ConversationNew,
    Layer.mergeAll(NewStamp.toLayer(stamp), NewRequest.toLayer(requestNew), GoTo.toLayer(goTo)),
  ),
)

/** Your conversations' flows, asking ChatApi on `origin`. Needs the host's `HttpClient` and navigation's `Tabs`. */
export const registrationAt = (origin: string) =>
  Layer.merge(registration, Creation.registration(origin))
    |> Layer.provide(%, ConversationsClient.layer({ origin }))
    |> Layer.provide(%, BranchClient.layer({ origin }))
