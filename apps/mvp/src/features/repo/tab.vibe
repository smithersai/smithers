import { Clipboard } from "../../clipboard"
import { answerAskingTab } from "../../flows/askingTab"
import { clipboardChannel } from "./contract"
import { CopyCall } from "./schema"

// The tab's side of `repo/copy` (docs/features/repo.md#copy): every tab listens on the engine's clipboard channel, and
// only the tab that started a call's request answers it (src/flows/askingTab.ts), writing the text through the host's
// clipboard. Every other tab, and every other device, leaves its clipboard alone.

/**
 * Answers the clipboard channel of engine `name` for this tab's requests until its scope closes: writes the call's
 * text, if it has one, to the host's clipboard, and answers whether the clipboard took it.
 */
export const tabClipboard = (host: { readonly name: string }) =>
  Layer.effectDiscard(
    effect {
      const clipboard = try Clipboard
      try answerAskingTab({
        channel: clipboardChannel(host.name),
        input: CopyCall,
        answer: ({ text }) =>
          text === undefined
            ? Effect.succeed({ copied: false })
            : clipboard.write(text).pipe(Effect.as({ copied: true }), Effect.orElseSucceed(() => ({ copied: false }))),
      })
    },
  )
