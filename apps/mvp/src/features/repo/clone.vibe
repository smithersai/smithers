import { Interpreter } from "@smthrs/flow"
import { RepoClient, type RepoRefused } from "./api"
import {
  type CloneFailure,
  LaunchClone,
  parts,
  RepoCloneRefused,
  RepoCloneRequest,
  RepoCloneUnavailable,
  RequestClone,
} from "./flows"
import { clones } from "./metrics"

// `repo/clone`'s steps (docs/features/repo.md#flows): asks RepoApi for the clone, `POST /api/repos` through `RepoClient`,
// which RepoApi admits (sign-in, the Member role, the repository cap, the budgets), persists and answers at once; then
// launches it, `POST /api/repos/launch`, which starts the durable remote `repo/Clone` for that attempt. No route starts
// that flow by its name (docs/features/remote-flows.md#no-remote-door). A person's Clone,
// Try again and `/clone`, and the agent's call, all run this one step on this device's engine.

/** What RepoApi's refusal means to the flow, and the outcome it counts as. */
export const cloneFailure = (refused: RepoRefused): CloneFailure =>
  refused.status === 401
    ? new RepoCloneRefused({ reason: "sign_in" })
    : refused.status === 403
    ? new RepoCloneRefused({ reason: "forbidden" })
    : refused.status === 429
    ? new RepoCloneRefused({ reason: "limit" })
    : refused.status === 400
    ? new RepoCloneRefused({ reason: "invalid" })
    : refused.status === 503 && refused.code === "not_configured"
    ? new RepoCloneRefused({ reason: "not_configured" })
    : new RepoCloneUnavailable()

/**
 * What `repo/clone/request` does: one `POST /api/repos` for `repo`. Records it as a span `repo.clone`, a log line with
 * the outcome and RepoApi's status, and a count of `clones` by outcome: `started` (202), `existing` (200), the
 * refusal's reason, or `unavailable`.
 */
export const requestClone = ({ repo }: { readonly repo: string }) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const [owner, name] = parts(repo)
    const answer = try Effect.result((try RepoClient).clone(owner, name))
    /** The request's records; RepoApi's `status` for a refusal, none when nothing answered. */
    const record = (outcome: string, refused?: { readonly status?: number | undefined }) =>
      effect {
        const status = refused?.status
        try Metric.update(Metric.withAttributes(clones, { outcome }), 1)
        try Effect.annotateCurrentSpan({ outcome })
        try Effect.logWithLevel(refused === undefined ? "Info" : "Warn")("repo.clone").pipe(
          Effect.annotateLogs({
            outcome,
            ...(status === undefined ? {} : { status }),
            durationMs: (try Clock.currentTimeMillis) - startedAt,
            feature: "repo",
          }),
        )
      }
    if (answer._tag === "Success") {
      try record(answer.success.txid === null ? "existing" : "started")
      return answer.success
    }
    const failure = cloneFailure(answer.failure)
    try record(failure._tag === "@smthrs/mvp/repo/RepoCloneRefused" ? failure.reason : "unavailable", answer.failure)
    throw failure
  }.pipe(Effect.withSpan("repo.clone"))

/**
 * What `repo/clone/launch` does: one `POST /api/repos/launch` for the attempt `cloneId`, which starts its remote
 * `repo/Clone`. A failure the step's retry policy takes (RepoApi or its Durable Object unreachable) is tried again by
 * the engine; a refusal is final. Records a `repo.clone.launch` line with the outcome: `launched`, `settled`, the
 * refusal's reason, or `unavailable`.
 */
export const launchClone = ({ repo, cloneId }: { readonly repo: string; readonly cloneId: string }) =>
  effect {
    const [owner, name] = parts(repo)
    const answer = try Effect.result((try RepoClient).launch(owner, name, cloneId))
    if (answer._tag === "Success") {
      try Effect.logInfo("repo.clone.launch").pipe(
        Effect.annotateLogs({ outcome: answer.success.launched ? "launched" : "settled", feature: "repo" }),
      )
      return answer.success
    }
    const failure = cloneFailure(answer.failure)
    try Effect.logWarning("repo.clone.launch").pipe(
      Effect.annotateLogs({
        outcome: failure._tag === "@smthrs/mvp/repo/RepoCloneRefused" ? failure.reason : "unavailable",
        ...(answer.failure.status === undefined ? {} : { status: answer.failure.status }),
        feature: "repo",
      }),
    )
    throw failure
  }.pipe(Effect.withSpan("repo.clone.launch"))

/** Registers `repo/clone` with its steps, asking through the host's `RepoClient`. */
export const registration = Interpreter.layerWithImplementations(
  RepoCloneRequest,
  Layer.merge(RequestClone.toLayer(requestClone), LaunchClone.toLayer(launchClone)),
)
