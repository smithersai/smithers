import { formatRelativeTime, type ChatTimelineEntry, type TimelineMarker } from "@smthrs/ui"
import { postgresTime } from "../chat/view"
import { isGenericSummary, revisionOf, safeTimelineText } from "./identity"
import { exchangeUnits, phaseUnits, parseMark } from "./marks"

export interface RailMessage {
  readonly id: string
  readonly questionId?: string | null
  readonly role: string
  readonly status: string
  readonly text: string
  readonly createdAt?: string
  readonly inputTokens?: number | null
  readonly outputTokens?: number | null
  /** An answer's recorded summary and the content identity it summarizes; "" or none while it has none. */
  readonly summary?: string | null
  readonly summaryRevision?: string | null
  /** The phase and the arc that start at this message, as stored ("" or none on most). */
  readonly phase?: string | null
  readonly arc?: string | null
}
export interface RailStatus {
  readonly id: string
  readonly state: string
  readonly flow?: string | null
}
export interface RailDraft {
  readonly id: string
  readonly answerId: string | null
  readonly title: string
  readonly createdAt: number
}
export interface RailTodo {
  readonly id: string
  readonly title: string
  readonly number: number
  readonly state: string
  readonly prNumber: number | null
  readonly step: string | null
  readonly failure: string | null
  readonly updatedAt: string
}

/** Distinct, bounded placeholders while each message waits for its own model summary. */
const pendingLabel = (message: RailMessage, index: number, state: ChatTimelineEntry["state"]): string => {
  const name = `${message.role === "user" ? "Question" : "Answer"} ${index + 1}`
  const outcome = state === "failed"
    ? (message.status === "unsent" ? "not sent" : "failed")
    : state === "waiting"
    ? "needs you"
    : state === "queued"
    ? "queued"
    : state === "working"
    ? "answering"
    : undefined
  return outcome ? `${name} · ${outcome}` : `${name}…`
}

const displayTime = (value: string | undefined): string | undefined => {
  const ms = postgresTime(value ?? "")
  return ms === undefined ? undefined : formatRelativeTime(ms)
}

export const railEntries = (
  messages: readonly RailMessage[],
  statuses: readonly RailStatus[],
  _drafts: readonly RailDraft[] = [],
  _todos: readonly RailTodo[] = [],
): ChatTimelineEntry[] => [
  ...messages.filter(message => message.role === "user" || message.role === "assistant").map(
    (message, index): ChatTimelineEntry => {
      const status = statuses.find(status => status.id === message.id)
      const state = status?.state === "needs_you"
        ? "waiting"
        : status?.state === "waiting"
        ? "queued"
        : message.status === "streaming"
        ? "working"
        : message.status === "failed" || message.status === "unsent"
        ? "failed"
        : message.status === "queued"
        ? "queued"
        : "done"
      const summary = message.status === "done" && message.summary && message.summaryRevision === revisionOf(message)
        ? message.summary.trim()
        : undefined
      const ownSummary = summary && !isGenericSummary(summary) ? safeTimelineText(summary) : undefined
      return {
        id: message.status === "unsent" ? `unsent:${message.id}` : message.id,
        actor: message.role === "user" ? "Person" : "Smithers",
        time: displayTime(message.createdAt),
        tokens:
          message.inputTokens != null && message.outputTokens != null && message.inputTokens + message.outputTokens > 0
            ? message.inputTokens + message.outputTokens
            : undefined,
        kind: message.role === "user" ? "ask" : "answer",
        state,
        length: message.text.length,
        summary: ownSummary,
        label: ownSummary ?? pendingLabel(message, index, state),
      }
    },
  ),
]

/** The phases or arcs stored on `messages`, as the rail's level 1 or level 2 takes them. */
export const railMarkers = (messages: readonly RailMessage[], field: "phase" | "arc"): TimelineMarker[] => {
  const exchanges = exchangeUnits(messages)
  const answers = new Map(
    messages.filter(message => message.role === "assistant").map(message => [message.questionId, message.id]),
  )
  const phaseEnds = new Map<string, string>()
  for (const [index, unit] of exchanges.entries()) {
    if (Option.isNone(unit.mark)) continue
    const covered = unit.mark.value.covered
    const last = exchanges[index + covered - 1]
    const end = last === undefined ? undefined : answers.get(last.id)
    if (end !== undefined) phaseEnds.set(unit.id, end)
  }
  const units = field === "phase" ? exchanges : phaseUnits(messages)
  return units.flatMap((unit, index) => {
    const mark = field === "phase" ? unit.mark : parseMark(messages.find(message => message.id === unit.id)?.arc)
    if (Option.isNone(mark)) return []
    const { title, summary, closed, covered } = mark.value
    const last = units[index + covered - 1]
    const end = field === "phase" ? phaseEnds.get(unit.id) : last === undefined ? undefined : phaseEnds.get(last.id)
    if (end === undefined) return []
    return [{
      id: `${field}:${unit.id}`,
      start: unit.id,
      end,
      title: safeTimelineText(title),
      summary: safeTimelineText(summary),
      closed,
    }]
  })
}
