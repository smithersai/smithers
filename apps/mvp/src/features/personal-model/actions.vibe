import { Duration, Effect, Exit, Option, Redacted } from "effect"
import { recordUnhandled } from "../../boundary.vibe"
import { FlowDispatch } from "../../flows/dispatch.vibe"
import { PersonalModelClient } from "./api.vibe"
import { checkSave, type ConnectionPut, type Refusal } from "./contract"
import { record } from "./metrics"
import { testDraftProblem } from "./testDraft"
import { ADD, type AddView, FORM, type Form, LINK, type LinkRow, type Sent, TEST } from "./schema"
import { PersonalModelStore } from "./store.vibe"
import {
  defaultsFrom,
  latestLink,
  latestUpdate,
  listOf,
  onItsWay,
  type SaveForm,
  withActive,
  withAdded,
  withMoved,
  without,
} from "./view"

// What a person does in the Your model section (docs/features/personal-model.md#the-settings-section), as Effects that
// finish synchronously. Every press saves the whole list, so moving or switching one needs no key. Save sends any key at
// once, in the person's own session, straight to ChatApi
// (`PersonalModelClient`), never through the device's outbox or a browser flow, either of which would keep it on the
// device; each key is `Redacted` from the moment it reaches the action and lives only in the one request. Remove and
// Test dispatch `model/remove` and `model/test` (door `button`), the flows the agent calls too. Link asks ChatApi for a
// Codex device code; the connection arrives in the rows (store.vibe's follower), or the code expires.
//
// ChatApi's 202 means a write's flow started, not that it landed: the form clears its keys at once and says Saving
// until the rows show the write (store.vibe's follower), or that it hasn't shown up after `confirmWithin`. No whole answer
// is an unknown outcome, never a failure: the rows may still show it landed.

/**
 * A write's follow-up, for the store's scope: it writes only the form's row, which `begin` made and nothing deletes,
 * so a refusal is a bug. It dies, and since no caller awaits the fork, it is logged as `app.unhandled`.
 */
const followUp = <A, E, R>(write: A!E!R) => recordUnhandled(orDie(write), "personal-model", "fork")

/** The person's connections' rows, as the device has them, in their order. */
const current = effect {
  const { saved } = try PersonalModelStore
  return try saved.toArray
}

/** Forgets the last test, which said how the model before this write answered. */
const forgetTest = effect {
  const { tests } = try PersonalModelStore
  try ignore(tests.delete(TEST))
}

/**
 * Marks a write `sending`, remembering the rows' latest `updatedAt` now (`before`). Answers the form's row, or none
 * while its last write is on its way.
 */
const begin = effect (op: Form["op"], sent: Sent | null, adding = false) => {
  const store = try PersonalModelStore
  const held = try store.form.get(FORM)
  if (Option.isSome(held) && try sync(() => onItsWay(held.value))) return Option.none<Form>()
  const rows = try current
  const write: Form = {
    id: FORM,
    op,
    state: "sending",
    failure: null,
    before: try sync(() => latestUpdate(rows)),
    sent,
    saved: Option.isSome(held) ? held.value.saved : 0,
    adding,
    quiet: false,
  }
  if (Option.isSome(held)) try store.form.update(FORM, (draft) => void Object.assign(draft, write))
  else try store.form.insert(write)
  try forgetTest
  return Option.some(write)
}

/** The write was refused: the section says why, and it may be sent again. */
const refuse = effect (failure: Refusal) => {
  const { form } = try PersonalModelStore
  try form.update(FORM, (draft) => {
    draft.state = "failed"
    draft.failure = failure
  })
}

/**
 * ChatApi took the write: the form counts it (`saved`), which clears its keys, and waits for the rows, saying so after
 * `confirmWithin`.
 */
const confirm = effect (write: Form) => {
  const store = try PersonalModelStore
  const op = write.op === "remove" ? "delete" : "put"
  const saved = write.saved + 1
  try store.form.update(FORM, (draft) => {
    draft.state = "confirming"
    draft.saved = saved
  })
  if (write.adding) try store.add.update(ADD, (draft) => void (draft.view = "closed"))
  if (op === "put") try record(op, "started")
  try sleep(store.confirmWithin)
  const now = try store.form.get(FORM)
  // Landed meanwhile (`done`), or a later write took the form.
  if (Option.isNone(now) || now.value.state !== "confirming" || now.value.saved !== saved) return
  try store.form.update(FORM, (draft) => void (draft.state = "late"))
  try record(op, "late")
}

/**
 * Sends `form`, the whole list, for a press of Save (`adding`: the Add dialog's, which closes once ChatApi takes it). A
 * connection it leaves out is removed. It names the rows the device has as the list it edited (`known`), so ChatApi
 * refuses it, `stale`, when a connection was saved or removed elsewhere and hasn't reached this device yet. A key left
 * empty keeps the one saved on that connection, at the same base URL, so a saved key never goes to another host without
 * the person typing it again. What the server would refuse is refused here, unsent, with the server's own code
 * (`checkSave`). Answers whether the save was sent: not while the last write is on its way, nor when the section
 * refused it.
 */
const send = (form: SaveForm, adding: boolean) => {
  const connections = form.connections.map(({ key, ...connection }) => ({
    ...connection,
    key: key === undefined || key === "" ? undefined : Redacted.make(key),
  }))
  return orDie(effect {
    const store = try PersonalModelStore
    const saved = try current
    const checked = try sync(() =>
      checkSave({
        connections: connections.map(({ key, ...connection }) => ({
          ...connection,
          key: key === undefined ? undefined : Redacted.value(key),
        })),
      }, saved, undefined, defaultsFrom(saved))
    )
    const sent: Sent | null = typeof checked === "string"
      ? null
      : { connections: checked.connections.map(({ key: _key, id, ...connection }) => ({ ...connection, id: id ?? null })) }
    const begun = try begin("save", sent, adding)
    if (Option.isNone(begun)) return false
    if (typeof checked === "string") {
      try refuse(checked)
      try record("put", "refused", { code: checked })
      return false
    }
    // The list as the form says it, each key `Redacted`: ChatApi normalizes it, and fills in what a kind leaves out.
    const put = (try PersonalModelClient).put({ connections, known: saved.map((row) => row.id) })
    fork.in(store.scope) followUp(Effect.matchEffect(put, {
      onSuccess: () => confirm(begun.value),
      onFailure: (refused) =>
        effect {
          if (refused.code === undefined) {
            try store.form.update(FORM, (draft) => void (draft.state = "unknown"))
            try record("put", "unknown", refused.status === undefined ? {} : { status: refused.status })
          } else {
            try refuse(refused.code)
            try record("put", "refused", { code: refused.code, status: refused.status! })
          }
        },
    }))
    return true
  })
}

/** Save: sets the person's connections to `form`'s, in its order. */
export const save = (form: SaveForm) => send(form, false)

/** The saved list changed by `edit`, sent whole. */
const edited = effect (edit: (list: ReadonlyArray<ConnectionPut>) => ReadonlyArray<ConnectionPut>) => {
  const rows = try current
  return try send({ connections: try sync(() => edit(listOf(rows))) }, false)
}

/** Add: the saved list and `connection`, last; the dialog closes once ChatApi takes it. */
export const add = effect (connection: ConnectionPut) => {
  const rows = try current
  return try send({ connections: try sync(() => withAdded(listOf(rows), connection)) }, true)
}

/** A row's Active: routing reads it or not. */
export const setActive = (id: string, active: boolean) => edited((list) => withActive(list, id, active))

/** A row's Move up or Move down. */
export const move = (id: string, by: -1 | 1) => edited((list) => withMoved(list, id, by))

/** Shows Add's menu, a kind's form, or neither, with no earlier write's words beside it. */
export const showAdd = (view: AddView) =>
  orDie(effect {
    const store = try PersonalModelStore
    try store.add.update(ADD, (draft) => void (draft.view = view))
    if (Option.isSome(try store.form.get(FORM))) try store.form.update(FORM, (draft) => void (draft.quiet = true))
  })

/**
 * Link: asks ChatApi for a Codex device code, which the section shows until the connection arrives in the rows or the
 * code expires. Answers whether it was sent: not while the last link is on its way.
 */
export const link = orDie(effect {
  const store = try PersonalModelStore
  const client = try PersonalModelClient
  const held = try store.link.get(LINK)
  if (Option.isSome(held) && (held.value.state === "starting" || held.value.state === "waiting")) return false
  const attempt = Option.isSome(held) ? held.value.attempt + 1 : 1
  const rows = try current
  const starting: LinkRow = {
    id: LINK,
    state: "starting",
    userCode: null,
    verificationUrl: null,
    failure: null,
    before: try sync(() => latestLink(rows)),
    attempt,
  }
  if (Option.isSome(held)) try store.link.update(LINK, (draft) => void Object.assign(draft, starting))
  else try store.link.insert(starting)
  fork.in(store.scope) followUp(Effect.matchEffect(client.link, {
    onSuccess: ({ userCode, verificationUrl, expiresInSeconds }) =>
      effect {
        try store.link.update(LINK, (draft) => void Object.assign(draft, { state: "waiting", userCode, verificationUrl }))
        try record("link", "started")
        try sleep(Duration.seconds(expiresInSeconds))
        // Unless it landed meanwhile (`done`), or a later link took the row.
        const lapsed = Option.exists(try store.link.get(LINK), (now) => now.state === "waiting" && now.attempt === attempt)
        if (!lapsed) return
        try store.link.update(LINK, (draft) => void Object.assign(draft, { state: "expired", userCode: null, verificationUrl: null }))
        try record("link", "expired")
      },
    onFailure: (refused) =>
      effect {
        try store.link.update(LINK, (draft) => void Object.assign(draft, { state: "failed", failure: refused.code ?? "unavailable" }))
        try record("link", refused.code === undefined ? "unknown" : "refused", {
          ...(refused.status === undefined ? {} : { status: refused.status }),
          ...(refused.code === undefined ? {} : { code: refused.code }),
        })
      },
  }))
  return true
})

/**
 * Remove: dispatches `model/remove`, door `button`. It returns at once; the section waits until the rows are gone, or
 * says why it didn't go. Answers whether it was sent: not while the last write is on its way.
 */
export const removeAll = orDie(effect {
  const store = try PersonalModelStore
  const flows = try FlowDispatch
  const begun = try begin("remove", null)
  if (Option.isNone(begun)) return false
  const dispatched = flows.dispatch("model/remove", {}, { door: "button" })
  fork.in(store.scope) followUp(effect {
    const exit = try Effect.exit(dispatched)
    if (Exit.isSuccess(exit) && exit.value._tag === "Done") return try confirm(begun.value)
    const refused = Exit.isSuccess(exit) && exit.value._tag === "Failed" &&
        exit.value.error._tag === "@smthrs/mvp/personal-model/ModelRefused"
      ? exit.value.error.code
      : undefined
    return try refuse(refused ?? "unavailable")
  })
  return true
})

/** A row's Remove: the list without it, or, for the last one, which no list can leave out, Remove. */
export const remove = effect (id: string) =>
  (try current).length <= 1 ? try removeAll : try edited((list) => without(list, id))

/**
 * Test: dispatches `model/test` of `connection` (none: every active one), door `button`. It returns at once; the
 * section shows the result, or why there was none, once the flow ends. A supplied list, the one on screen, is checked
 * synchronously and must match the saved one; only a refusal code survives that check. Answers whether it was sent:
 * not while a test or a write is on its way.
 */
export const test = (connection?: string, draft?: SaveForm) => orDie(effect {
  const store = try PersonalModelStore
  const flows = try FlowDispatch
  const held = try store.tests.get(TEST)
  const write = try store.form.get(FORM)
  const tested = connection ?? null
  /** That connection's last failure, as a result now knows it. */
  const failedAt = effect {
    return (try current).find((row) => row.id === connection)?.failedAt ?? null
  }
  if (Option.isSome(held) && held.value.state === "testing" || Option.isSome(write) && try sync(() => onItsWay(write.value))) {
    return false
  }
  if (draft !== undefined) {
    const rows = try current
    const failure = try sync(() => testDraftProblem(draft, rows))
    if (failure !== undefined) {
      // Replace an old result without storing the draft, especially its keys.
      if (Option.isSome(write)) try store.form.update(FORM, (row) => void (row.quiet = true))
      const refused = { id: TEST, connection: tested, state: "failed" as const, result: null, failure, failedAt: try failedAt }
      if (Option.isSome(held)) try store.tests.update(TEST, (row) => void Object.assign(row, refused))
      else try store.tests.insert(refused)
      try record("test", "refused", { code: failure })
      return false
    }
  }
  // The test takes the status line from the last write's outcome. The form keeps its count, which keys its fields.
  if (Option.isSome(write)) try store.form.update(FORM, (draft) => void (draft.quiet = true))
  const testing = { id: TEST, connection: tested, state: "testing" as const, result: null, failure: null, failedAt: null }
  if (Option.isSome(held)) try store.tests.update(TEST, (draft) => void Object.assign(draft, testing))
  else try store.tests.insert(testing)
  const dispatched = flows.dispatch("model/test", connection === undefined ? {} : { connection }, { door: "button" })
  // expected: a save meanwhile can delete the test row (forgetTest), and its answer is then about the model before
  fork.in(store.scope) ignore(effect {
    const exit = try Effect.exit(dispatched)
    const now = try store.tests.get(TEST)
    // A write since forgot this test: its answer is about the model before.
    if (Option.isNone(now) || now.value.state !== "testing") return
    const at = try failedAt
    if (Exit.isSuccess(exit) && exit.value._tag === "Done") {
      const result = exit.value.value
      return try store.tests.update(TEST, (draft) => void Object.assign(draft, { state: "done", result, failedAt: at }))
    }
    const refused = Exit.isSuccess(exit) && exit.value._tag === "Failed" &&
        exit.value.error._tag === "@smthrs/mvp/personal-model/ModelRefused"
      ? exit.value.error.code
      : undefined
    try store.tests.update(TEST, (draft) =>
      void Object.assign(draft, { state: "failed", failure: refused ?? "unavailable", failedAt: at }))
  })
  return true
})
