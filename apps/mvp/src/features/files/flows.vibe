import { Action, Flow, FlowRuntime, Interpreter } from "@smthrs/flow"
import { Node, Placement } from "@smthrs/plan"
import { Clock, Context, type Duration, Layer, Metric, Option, Schema } from "effect"
import { asker } from "../../flows/askingTab"
import type { Door } from "../../flows/dispatch.vibe"
import { requesterOf } from "../../flows/requests.vibe"
import { FILES_WITHIN, filesChannel, type Outcome } from "./contract"
import { fileTabs } from "./metrics"
import { Closed, FilePath, type FilesCall, FilesReply, Lines, Opened } from "./schema"

// `file/open { path, lines? }` and `file/close { path }` (docs/features/files.md): a file of the repository the person
// is viewing, opened as a tab with its lines highlighted, and its tab closed. The person's tab strip and the agent's
// cell run these two declarations. Each one step runs in the leader tab's engine worker, so it asks over the engine's
// files channel for the tab that started the request (src/flows/askingTab.ts): the tab whose strip dispatched it, or,
// for the agent's call, the tab whose composer asked. Only that tab changes. A tab that is gone settles the step.

/** The tab that asked shows no repository at a branch, tag or commit, so there is no file to open or close. */
export class NotInRepository extends Schema.TaggedError<NotInRepository>()(
  "@smthrs/mvp/files/NotInRepository",
  {},
) {}

/** A tab's answer to a step: the door it started the request through, and what it did. */
export interface Reply {
  readonly door: Door
  readonly reply: FilesReply
}

/** The tabs of this browser as the steps reach them: only the tab that started a request answers for it. */
export class FileTabsTabs extends Context.Service<
  FileTabsTabs,
  {
    /** Asks the tab that started `requester` to do `call`; none when no tab answered within the wait. */
    readonly ask: (requester: string, call: FilesCall) => Option.Option<Reply>!!
  }
>()("@smthrs/mvp/files/FileTabsTabs") {
  /** Over the files channel of engine `name` (`TabChannel`), waiting `within` (`FILES_WITHIN` unless set). */
  static readonly layerChannel = (options: { readonly name: string; readonly within?: Duration.Input }) =>
    Layer.effect(
      FileTabsTabs,
      effect {
        const ask = try asker<FilesCall, typeof FilesReply>({
          channel: try sync(() => filesChannel(options.name)),
          output: FilesReply,
          within: options.within ?? FILES_WITHIN,
        })
        return FileTabsTabs.of({
          ask: (requester, call) =>
            map(ask(requester, call), Option.map(({ door, output }) => ({ door, reply: output }))),
        })
      },
    )
}

/** `file/open`'s step: ask the tab that asked to open the file. */
export const OpenStep = Action.make("file/open/go", {
  payload: { path: FilePath, lines: Schema.optional(Lines) },
  success: Opened,
  error: NotInRepository,
})

/** `file/close`'s step: ask the tab that asked to close the file's tab. */
export const CloseStep = Action.make("file/close/go", {
  payload: { path: FilePath },
  success: Closed,
  error: NotInRepository,
})

/** `file/open`: opens a file of the repository the person is viewing as a tab, its lines highlighted. */
export const OpenFile = Flow.make("file/open", {
  description: "Show the person a file of the repository and branch their tab is viewing: it opens as a tab beside " +
    "the files already open, with lines highlighted. You need not know which repository: the tab does. path is the " +
    "file from the repository's root (src/app.ts); " +
    "lines is \"12\" for line 12 or \"10-20\" for lines 10 to 20. Use it whenever you show or point at code. Answers " +
    "{ repository, ref, path, lines, opened }; opened is false when the tab that asked has closed. Fails " +
    "NotInRepository when the tab shows no repository: then open the file's page with app/navigate.",
  modelInvocable: true,
  payload: { path: FilePath, lines: Schema.optional(Lines) },
  success: Opened,
  error: NotInRepository,
  body: Node.capture({ step: OpenStep.name }, (payload) => OpenStep.call(payload)),
}).annotate(Flow.Placement, Placement.client())

/** `file/close`: closes a file's tab in the repository the person is viewing. */
export const CloseFile = Flow.make("file/close", {
  description: "Close the tab of a file of the repository and branch the person's tab is viewing. path is the file " +
    "from the repository's root. When it is the file on screen, the tab beside it shows instead. Answers { closed }; " +
    "closed is false when the file had no tab. Fails NotInRepository when the tab shows no repository.",
  modelInvocable: true,
  payload: { path: FilePath },
  success: Closed,
  error: NotInRepository,
  body: Node.capture({ step: CloseStep.name }, (payload) => CloseStep.call(payload)),
}).annotate(Flow.Placement, Placement.client())

/** `path` from the repository's root: no leading or trailing `/`. */
export const normalPath = (path: string): string => path.replace(/^\/+|\/+$/g, "")

/**
 * Asks the tab that started the run to do `call`, and records it as a span `files.tab`, a log line and a count of
 * `fileTabs` by op, door and outcome, never the path. A tab showing no repository fails `NotInRepository`.
 */
const ask = (call: FilesCall) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const { executionId } = try FlowRuntime.FlowInstance
    const requester = try sync(() => requesterOf(executionId))
    const answered = try (try FileTabsTabs).ask(requester, call)
    // The agent's call belongs to the answer its tab asked for; a tab's own dispatch names its door in its reply.
    const door: Door | "unknown" = executionId !== requester
      ? "agent"
      : (Option.isNone(answered) ? "unknown" : answered.value.door)
    const reply = Option.getOrUndefined(Option.map(answered, ({ reply }) => reply))
    const outcome: Outcome = reply === undefined
      ? "gone"
      : reply.repository === null
      ? "no_repository"
      : !reply.done
      ? "absent"
      : call.op === "open"
      ? "opened"
      : "closed"
    try Metric.update(Metric.withAttributes(fileTabs, { op: call.op, door, outcome }), 1)
    try annotateCurrentSpan({
      "smithers.files.op": call.op,
      "smithers.files.door": door,
      "smithers.files.outcome": outcome,
    })
    const durationMs = (try Clock.currentTimeMillis) - startedAt
    try (
      logWithLevel(outcome === "no_repository" ? "Warn" : "Info")("files.tab")
        |> annotateLogs(%, { op: call.op, door, outcome, executionId, durationMs })
    )
    if (outcome === "no_repository") throw new NotInRepository()
    return reply
  } |> withSpan(%, "files.tab")

/** What `file/open/go` does: asks the tab that asked to open `path` at `lines`, and answers where it opened it. */
export const openFile = ({ path, lines }: { readonly path: string; readonly lines?: string | undefined }) =>
  map(
    ask({ op: "open", path: normalPath(path), ...(lines === undefined ? {} : { lines }) }),
    (reply) => ({
      repository: reply?.repository ?? "",
      ref: reply?.ref ?? "",
      path: normalPath(path),
      lines: lines ?? null,
      opened: reply?.done ?? false,
    }),
  )

/** What `file/close/go` does: asks the tab that asked to close `path`'s tab, and answers whether it had one. */
export const closeFile = ({ path }: { readonly path: string }) =>
  map(ask({ op: "close", path: normalPath(path) }), (reply) => ({ closed: reply?.done ?? false }))

/** Registers `file/open` and `file/close` with their steps, reaching the tabs through the host's `FileTabsTabs`. */
export const registration = Layer.mergeAll(
  Interpreter.layerWithImplementations(OpenFile, OpenStep.toLayer(openFile)),
  Interpreter.layerWithImplementations(CloseFile, CloseStep.toLayer(closeFile)),
)
