import { answerAskingTab } from "../../flows/askingTab"
import { answer } from "./actions"
import { filesChannel } from "./contract"
import { FilesCall } from "./schema"

// The tab's side of `file/open` and `file/close` (docs/features/files.md): every tab listens on the engine's files
// channel, and only the tab that started a call's request answers it (src/flows/askingTab.ts), opening or closing the
// file in the repository it shows. Every other tab, and every other device, stays where it is.

/** Answers the files channel of engine `name` for this tab's requests until its scope closes. */
export const tabFiles = (host: { readonly name: string }) =>
  Layer.effectDiscard(answerAskingTab({ channel: filesChannel(host.name), input: FilesCall, answer }))
