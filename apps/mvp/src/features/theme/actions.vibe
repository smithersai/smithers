import { FlowDispatch } from "../../flows/dispatch"
import { ThemeStore } from "./store"

// What a person does with the theme. The button never writes the theme itself: it dispatches `app/theme/set`, the
// flow the agent calls, with the mode other than the one the page shows, so both doors run one declaration.

/** Switches to the other mode: reads the mode the page shows, then sets the opposite one through `app/theme/set`. */
export const toggleTheme = effect {
  const current = try (try ThemeStore).current
  return try (try FlowDispatch).dispatch(
    "app/theme/set",
    { mode: current === "dark" ? "light" : "dark" },
    { door: "button" },
  )
}
