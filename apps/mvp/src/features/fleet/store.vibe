import { ElectricCollection, ShapeSource } from "@smthrs/effect-electric"
import { LiveQuery } from "@smthrs/effect-tanstack-db"
import { Cache, Context, Effect, Latch, Layer, Option, Scope, Stream } from "effect"
import { AuthStore, SESSION } from "../auth/store"
import { repoId } from "../repo/contract"
import type { Source } from "../repo/gate"
import { RepoStore } from "../repo/store"
import { repoVisibility } from "../repo/visibility"
import { AGENT_RUNS_SHAPE_ROUTE, MACHINES_SHAPE_ROUTE } from "./contract"
import { FLEET_ACCOUNTS_SHAPE_ROUTE, FLEET_NODES_SHAPE_ROUTE, FLEET_SESSIONS_SHAPE_ROUTE, type FleetAvailability, type GlobalFleetShape } from "./globalContract"
import { HostNode, ObservedSession, ProviderAccount } from "./globalSchema"
import { AgentRun, Machine } from "./schema"

// The fleet on this tab (decision 0143, docs/features/fleet.md#the-browser): Electric's `agent_runs` and `runners` of
// each repository something asked for, never kept on the device. A repository's runs sync once something asks for
// them, for as long as the store lives, one collection per repository and shape: one shape each, however many runs.
// The shape decides what the viewer may see: runs for a Member and up (the account label for a Maintainer), machines
// for a Maintainer and up; a refused shape holds no rows.

/** Where the fleet syncs from: ChatApi's origin, the site's own. */
export interface FleetConfig {
  readonly origin: string
}

/** A repository's runs, newest first, read through the data gate (repo/gate.ts). */
const runsQuery = (collection: Source<AgentRun>) =>
  LiveQuery.make((q) => q.from({ run: collection.tanstack }).orderBy(({ run }) => run.queuedAt, "desc"))

/** A repository's machines, by name, read through the data gate (repo/gate.ts). */
const machinesQuery = (collection: Source<Machine>) =>
  LiveQuery.make((q) => q.from({ machine: collection.tanstack }).orderBy(({ machine }) => machine.name, "asc"))

/** One repository's runs or machines, as a live query. */
export type Runs = Effect.Success<ReturnType<typeof runsQuery>>
export type Machines = Effect.Success<ReturnType<typeof machinesQuery>>
const globalNodesQuery = (collection: ElectricCollection.ElectricCollection<HostNode>) =>
  LiveQuery.make((q) => q.from({ node: collection.tanstack }).orderBy(({ node }) => node.name, "asc"))
const globalSessionsQuery = (collection: ElectricCollection.ElectricCollection<ObservedSession>) =>
  LiveQuery.make((q) => q.from({ s: collection.tanstack }).orderBy(({ s }) => s.sessionKey, "asc"))
const globalAccountsQuery = (collection: ElectricCollection.ElectricCollection<ProviderAccount>) =>
  LiveQuery.make((q) => q.from({ a: collection.tanstack }).orderBy(({ a }) => a.accountKey, "asc"))
export type GlobalNodes = Effect.Success<ReturnType<typeof globalNodesQuery>>
export type GlobalSessions = Effect.Success<ReturnType<typeof globalSessionsQuery>>
export type GlobalAccounts = Effect.Success<ReturnType<typeof globalAccountsQuery>>

/**
 * A deployment-wide shape's gate, read synchronously at each read: `visible` is whether its rows may show now,
 * `availability` whether they are still syncing a first snapshot (`loading`), withheld (`unavailable`) or delivered
 * (`ready`), and `subscribe` hears each change of either.
 */
export interface GlobalAccess {
  readonly visible: (shape: GlobalFleetShape) => boolean
  readonly availability: (shape: GlobalFleetShape) => FleetAvailability
  readonly subscribe: (shape: GlobalFleetShape, listener: () => void) => () => void
}

/** One deployment-wide shape's authority and readiness on this tab. */
interface GlobalGate {
  /** True from an answer that put the reader's authority in doubt until a later request is answered 2xx. */
  rejected: boolean
  /** Counts each doubt: an answer to a request sent before the latest one reopens nothing. */
  generation: number
  /** The login whose session the rows were read under, once a session said who. */
  owner: string | null | undefined
  /** Whether a whole first snapshot arrived since the rows were last dropped. */
  synced: boolean
  readonly listeners: Set<() => void>
}
const gateOf = (): GlobalGate => ({ rejected: false, generation: 0, owner: undefined, synced: false, listeners: new Set() })

/** Electric's text for a timestamp, a big integer and a numeric, as the rows hold them. */
const parser = {
  timestamptz: (value: string) => new Date(value).toISOString(),
  int8: (value: string) => Number(value),
  numeric: (value: string) => Number(value),
}

/** A shape of `repo` (`owner/name`). */
const shapeOf = (origin: string, route: string, repo: string) => ({
  url: `${origin}${route}?repo=${encodeURIComponent(repo)}`,
  columnMapper: ElectricCollection.snakeCamelMapper(),
  parser,
})

/**
 * A shape of the fleet, whose rows are memory only. A 403 drops them and sends no more requests: Members are refused
 * machines, so this is the shape's refusal and says nothing of the repository's other shapes. A 401 stops the shape and
 * asks the session, whose confirmed end drops them (decision 0110, 2026-11-03). A session check that confirms someone, or
 * a role read whose answer grants something new on the repository, starts it again. Restarts need a session that
 * isn't signed out or unverified, since authority may have come back.
 */
const refusable = <A extends object>(
  scope: Scope.Scope,
  auth: Option.Option<AuthStore["Service"]>,
  repos: RepoStore["Service"],
  id: string,
  make: Effect.Effect<ElectricCollection.ElectricCollection<A>, never, Scope.Scope>,
) =>
  effect {
    const source = try ShapeSource.ShapeSource
    const running = try Latch.make(true)
    // Sync starts on a read, after the collection is assigned.
    let collection!: ElectricCollection.ElectricCollection<A>
    const stop = Effect.andThen(running.close, Effect.suspend(() => collection.evict))
    collection = try make.pipe(Effect.provideService(ShapeSource.ShapeSource, {
      cacheNamespace: source.cacheNamespace,
      request: (url, init) => Effect.andThen(running.await, Effect.tap(source.request(url, init), (response) => {
        if (response.status === 401) return Effect.andThen(running.close, Option.isSome(auth) ? auth.value.askCheck : Effect.void)
        // In the store's scope: evicting aborts the request this runs in.
        return response.status === 403 ? Effect.forkIn(stop, scope, { startImmediately: true }) : Effect.void
      })),
    }))
    // Only while the repository may show (`repoVisibility`): a failed verification or a refusal starts nothing.
    const again = effect {
      if (Option.isSome(auth)) {
        const session = try auth.value.session.get(SESSION)
        const row = Option.getOrUndefined(try repos.roles.get(id))
        if (Option.isSome(session) && (try sync(() => repoVisibility(session.value, row))) !== "show") return
      }
      try running.open
      try collection.reconnect
    }
    if (Option.isSome(auth)) {
      try auth.value.sessionState.rows.pipe(
        // Signed out: the rows go. What shows while the session can't be verified is the plugin host's gate (`gateLive`).
        Stream.runForEach((sessions) => sessions[0]?.status === "signed_out" ? stop : Effect.void),
        Effect.forkIn(scope, { startImmediately: true }),
      )
      try auth.value.confirmations.pipe(
        Stream.mapEffect(() => Effect.map(auth.value.session.get(SESSION), (row) => Option.isSome(row) && row.value.status === "signed_in")),
        Stream.filter((signedIn) => signedIn),
        Stream.runForEach(() => again),
        Effect.forkIn(scope, { startImmediately: true }),
      )
    }
    try repos.rolesState.rows.pipe(
      Stream.map((rows) => rows.find((row) => row.id === id)),
      // Each answer that grants something, by what it grants: Member to Maintainer starts machines again.
      Stream.map((row) => row === undefined || row.refused !== undefined || row.failure !== undefined
        ? undefined
        : `${row.role}|${row.own}|${row.workspaceRole ?? ""}|${row.readable ?? ""}|${row.public ?? ""}`),
      Stream.changes,
      Stream.filter((granted) => granted !== undefined),
      Stream.runForEach(() => again),
      Effect.forkIn(scope, { startImmediately: true }),
    )
    return { collection, stop }
  }

export class FleetStore extends Context.Service<
  FleetStore,
  {
    /** Repository `repo`'s (`owner/name`, lowercased) runs, newest first, opened once and synced while the store lives. */
    readonly runs: (repo: string) => Effect.Effect<Runs>
    /** Repository `repo`'s machines, by name, opened once and synced while the store lives. */
    readonly machines: (repo: string) => Effect.Effect<Machines>
    /** Deployment-wide host nodes synced over ElectricSQL (Admin only). */
    readonly globalNodes: Effect.Effect<GlobalNodes>
    /** Deployment-wide observed & managed agent sessions synced over ElectricSQL (Admin only). */
    readonly globalSessions: Effect.Effect<GlobalSessions>
    /** Deployment-wide provider accounts synced over ElectricSQL (Admin only). */
    readonly globalAccounts: Effect.Effect<GlobalAccounts>
    /** Whether each deployment-wide shape's rows may show now, and whether its first snapshot arrived. */
    readonly global: GlobalAccess
  }
>()("@smthrs/mvp/fleet/FleetStore") {
  /** The store; its shapes closed when the scope closes. Needs the tab's `ShapeSource`. */
  static readonly layer = (config: FleetConfig) =>
    Layer.effect(
      FleetStore,
      effect {
        const scope = try Effect.scope
        const auth = try Effect.serviceOption(AuthStore)
        const repos = try RepoStore
        // Each shape opened, by repository id: a repository's refusal stops it and drops its rows until authority returns.
        const stops = new Map<string, Array<Effect.Effect<void>>>()
        const registered = <A extends object>(repo: string, make: Effect.Effect<ElectricCollection.ElectricCollection<A>, never, Scope.Scope>) =>
          effect {
            const [owner, name] = repo.split("/") as [string, string]
            const id = repoId(owner, name)
            const { collection, stop } = try refusable(scope, auth, repos, id, make)
            stops.set(id, [...(stops.get(id) ?? []), stop])
            if (try sync(() => repos.isRefused(id))) try stop
            return collection
          }
        try repos.registerCache(["agent-runs", "machines"], (id) =>
          Effect.suspend(() => Effect.all(stops.get(id) ?? [], { discard: true })))
        // What shows of a repository's rows: only through the data gate (repo/gate.ts), so a refusal or a session a
        // reached server couldn't verify drops them in the change that hides the repository, before any eviction.
        const shown = <A extends object & { readonly repoId: string }>(collection: ElectricCollection.ElectricCollection<A>) =>
          repos.gate(collection)
        // Opening a repository twice at once opens it once: each cache runs one lookup per repository and keeps it.
        const runs = try Cache.make({
          lookup: (repo: string) =>
            effect {
              const collection = try registered(repo, ElectricCollection.make<AgentRun>({
                id: `agent-runs:${repo}`,
                schema: AgentRun,
                getKey: (row) => row.key,
                syncMode: "eager",
                shape: shapeOf(config.origin, AGENT_RUNS_SHAPE_ROUTE, repo),
              }))
              return try runsQuery(try shown(collection))
            }.pipe(Scope.provide(scope), Effect.orDie),
          capacity: Number.MAX_SAFE_INTEGER,
        })
        const machines = try Cache.make({
          lookup: (repo: string) =>
            effect {
              const collection = try registered(repo, ElectricCollection.make<Machine>({
                id: `machines:${repo}`,
                schema: Machine,
                getKey: (row) => row.id,
                syncMode: "eager",
                shape: shapeOf(config.origin, MACHINES_SHAPE_ROUTE, repo),
              }))
              return try machinesQuery(try shown(collection))
            }.pipe(Scope.provide(scope), Effect.orDie),
          capacity: Number.MAX_SAFE_INTEGER,
        })
        // Deployment-wide authority, per shape (Astra-D4-003): what a shape synced shows only while nothing put its
        // reader's authority in doubt. A 401, a 403, a stopped shape, a session that ended or that a reached server
        // couldn't verify, and another person signing in each hide the rows in the same change, read at each read.
        // Only a later 2xx answer to a request sent after that reopens them, and another person's rows start empty.
        const gates: Record<GlobalFleetShape, GlobalGate> = { nodes: gateOf(), sessions: gateOf(), accounts: gateOf() }
        const sessionNow = () => Option.isSome(auth) ? auth.value.sessionState.tanstack.toArray[0] : undefined
        const visible = (shape: GlobalFleetShape) => {
          const gate = gates[shape]
          if (gate.rejected) return false
          const session = sessionNow()
          if (session === undefined) return true
          if (session.status === "signed_out" || session.unverifiable === true) return false
          return gate.owner === undefined || session.status !== "signed_in" || session.login === gate.owner
        }
        const global: GlobalAccess = {
          visible,
          availability: (shape) => !visible(shape) ? "unavailable" : gates[shape].synced ? "ready" : "loading",
          subscribe: (shape, listener) => {
            const gate = gates[shape]
            gate.listeners.add(listener)
            const sessions = Option.isSome(auth) ? auth.value.sessionState.tanstack.subscribeChanges(listener) : undefined
            return () => {
              gate.listeners.delete(listener)
              sessions?.unsubscribe()
            }
          },
        }
        const adminShape = <A extends Record<string, unknown>>(
          shape: GlobalFleetShape,
          id: string,
          schema: Parameters<typeof ElectricCollection.make<A>>[0]["schema"],
          getKey: (row: A) => string,
          route: string,
        ) =>
          effect {
            const gate = gates[shape]
            const tell = () => { for (const listener of gate.listeners) listener() }
            /** Hides the rows now: every answer to a request already sent is void. */
            const reject = Effect.sync(() => {
              gate.rejected = true
              gate.generation += 1
              tell()
            })
            const running = try Latch.make(true)
            // Shape requests and session followers start after the collection is assigned.
            let collection!: ElectricCollection.ElectricCollection<A>
            /** Whether the last 2xx answer said the shape is caught up: the batch it carried completes a snapshot. */
            let caughtUp = false
            const stop = Effect.suspend(() =>
              Effect.andThen(
                Effect.andThen(reject, Effect.sync(() => { gate.synced = false; caughtUp = false })),
                Effect.andThen(running.close, collection.evict),
              )
            ).pipe(Effect.orDie)
            const start = Effect.suspend(() =>
              Effect.andThen(running.open, collection.reconnect)
            )
            const source = try ShapeSource.ShapeSource
            collection = try ElectricCollection.make<A>({
              id,
              schema,
              getKey,
              syncMode: "eager",
              shape: {
                url: `${config.origin}${route}`,
                columnMapper: try sync(() => ElectricCollection.snakeCamelMapper()),
                parser,
              },
            }).pipe(
              Effect.provideService(ShapeSource.ShapeSource, {
                cacheNamespace: source.cacheNamespace,
                request: (url, init) =>
                  Effect.andThen(
                    running.await,
                    Effect.suspend(() => {
                      const sent = gate.generation
                      return Effect.tap(source.request(url, init), (response) => {
                        if (response.status === 401) {
                          return Effect.andThen(reject, Effect.andThen(running.close, Option.isSome(auth) ? auth.value.askCheck : Effect.void))
                        }
                        if (response.status === 403) return Effect.andThen(reject, Effect.forkIn(stop, scope, { startImmediately: true }))
                        if (!response.ok || sent !== gate.generation) return Effect.void
                        return Effect.sync(() => {
                          caughtUp = response.headers.has("electric-up-to-date")
                          if (!gate.rejected) return
                          gate.rejected = false
                          tell()
                        })
                      })
                    }),
                  ),
              })
            )
            const synced = collection
            try synced.sync.pipe(
              Stream.runForEach((event) => {
                // A shape Electric gave up on delivers nothing more: its rows are no evidence of the fleet now.
                if (event._tag === "Stopped") return gate.rejected ? Effect.void : reject
                if (event._tag !== "Succeeded" || !caughtUp || gate.synced) return Effect.void
                const sent = gate.generation
                // The first whole snapshot, an empty one included: only now are no rows "no hosts" (Astra-D4-031).
                return Effect.andThen(synced.currentApplied, Effect.sync(() => {
                  if (sent !== gate.generation || gate.synced) return
                  gate.synced = true
                  tell()
                }))
              }),
              Effect.forkIn(scope, { startImmediately: true }),
            )
            if (Option.isSome(auth)) {
              try auth.value.sessionState.rows.pipe(
                Stream.runForEach((sessions) => Effect.suspend(() => {
                  const session = sessions[0]
                  if (session?.status === "signed_out") {
                    gate.owner = undefined
                    return stop
                  }
                  if (session?.status !== "signed_in") return Effect.void
                  if (gate.owner === undefined || gate.owner === session.login) {
                    gate.owner = session.login
                    return Effect.void
                  }
                  // Another person on this tab: the rows the last one read go before anything is asked for them.
                  gate.owner = session.login
                  return Effect.andThen(stop, start)
                })),
                Effect.forkIn(scope, { startImmediately: true }),
              )
              try auth.value.confirmations.pipe(
                Stream.mapEffect(() =>
                  Effect.map(auth.value.session.get(SESSION), (row) => Option.isSome(row) && row.value.status === "signed_in")
                ),
                Stream.filter((signedIn) => signedIn),
                Stream.runForEach(() => start),
                Effect.forkIn(scope, { startImmediately: true }),
              )
            }
            return collection
          }
        const nodesCache = try Cache.make({
          lookup: (_key: string) =>
            effect {
              const c = try adminShape<HostNode>("nodes", "fleet-global-nodes", HostNode, (r) => r.nodeId, FLEET_NODES_SHAPE_ROUTE)
              return try globalNodesQuery(c)
            }.pipe(Scope.provide(scope), Effect.orDie),
          capacity: 1,
        })
        const sessionsCache = try Cache.make({
          lookup: (_key: string) =>
            effect {
              const c = try adminShape<ObservedSession>("sessions", "fleet-global-sessions", ObservedSession, (r) => r.sessionKey, FLEET_SESSIONS_SHAPE_ROUTE)
              return try globalSessionsQuery(c)
            }.pipe(Scope.provide(scope), Effect.orDie),
          capacity: 1,
        })
        const accountsCache = try Cache.make({
          lookup: (_key: string) =>
            effect {
              const c = try adminShape<ProviderAccount>("accounts", "fleet-global-accounts", ProviderAccount, (r) => r.accountKey, FLEET_ACCOUNTS_SHAPE_ROUTE)
              return try globalAccountsQuery(c)
            }.pipe(Scope.provide(scope), Effect.orDie),
          capacity: 1,
        })
        return FleetStore.of({
          runs: (repo) => Cache.get(runs, repo),
          machines: (repo) => Cache.get(machines, repo),
          globalNodes: Cache.get(nodesCache, "all"),
          globalSessions: Cache.get(sessionsCache, "all"),
          globalAccounts: Cache.get(accountsCache, "all"),
          global,
        })
      },
    )
}
