import { Uuid } from "@smthrs/crypto"
import { FlowRuntime, Interpreter } from "@smthrs/flow"
import { HttpClient } from "effect/http"
import { asker } from "../../flows/askingTab"
import type { Door } from "../../flows/dispatch"
import { requesterOf } from "../../flows/requests"
import { repoId } from "../repo/contract"
import { readTodoStatus } from "./api"
import {
  DRAFT_ID_NAMESPACE,
  OP_ID_NAMESPACE,
  QUEUE_WITHIN,
  type StackVia,
  stackPath,
  titleOf,
  todosChannel,
} from "./contract"
import {
  type ChangeRequested,
  type Drafted,
  KeepDraft,
  KeepIssueDraft,
  QueueCommit,
  QueueDrop,
  QueueAttach,
  TodoAttach,
  QueueRetry,
  ReadTodoStatus,
  TodoRetry,
  TodoCommit,
  TodoDraft,
  TodoDrop,
  TodoIssue,
  TodoInspect,
  TodoStepRefused,
} from "./flows"
import { drafts, queued, statusReads } from "#vibelang/emitted/src/features/todos/metrics"
import { Kept, type QueuedOp, type TodosCall } from "./schema"

// The TODO flows' steps (docs/features/todos.md#flows). A step runs in the leader tab's engine worker, which has no
// collections or outbox of its own, so it asks over the engine's todos channel for the tab that started the request
// (src/flows/askingTab.ts) to keep the draft or queue the change: the tab whose button or slash command dispatched it,
// or, for the agent's call, the tab whose composer asked. Ids derive from the run: a draft's and a change's are version 5
// UUIDs of the execution id, so a step run again names the same draft or change, and the tab keeps it once. A tab that
// doesn't answer within the wait is gone, and the retry policy asks again. Nothing records a title or a prompt.

/**
 * What the tab answered: the door it started the request through, whether it kept the draft or change, and, for a
 * draft from an issue, whether the device lacks that issue.
 */
export interface Reply {
  readonly door: Door
  readonly kept: boolean
  readonly missing?: boolean
}

/** The tabs of this browser, as a step reaches them: only the tab that started a request answers. */
export class TabTodos extends Context.Service<
  TabTodos,
  {
    /** Asks the tab that started `requester` to act on `call`; none when no tab answered within the wait. */
    readonly ask: (call: { readonly requester: string; readonly call: TodosCall }) => Option.Option<Reply>!!
  }
>()("@smthrs/mvp/todos/TabTodos") {
  /** Over the todos channel of engine `name` (`TabChannel`), waiting `within` (`QUEUE_WITHIN` unless set). */
  static readonly layerChannel = (options: { readonly name: string; readonly within?: Duration.Input }) =>
    Layer.effect(
      TabTodos,
      effect {
        const ask = try asker<TodosCall, typeof Kept>({
          channel: todosChannel(options.name),
          output: Kept,
          within: options.within ?? QUEUE_WITHIN,
        })
        return TabTodos.of({
          ask: ({ requester, call }) =>
            ask(requester, call).pipe(
              Effect.map(
                Option.map(({ door, output }) => ({ door, kept: output.kept, missing: output.issue === "missing" })),
              ),
            ),
        })
      },
    )
}

/** How a step ended: its tab kept it, or why not. */
export type StepOutcome = "kept" | "not_kept" | "issue_not_found" | "tab_gone" | "agent"

/** The run the step belongs to, and who it acts for: the agent's call is an execution that isn't its own requester. */
const runOf = Effect.map(FlowRuntime.FlowInstance, ({ executionId }) => {
  const requester = requesterOf(executionId)
  const via: StackVia = executionId !== requester ? "agent" : "person"
  return { executionId, requester, via }
})

/** Asks the asking tab, and answers how it went and through which door. */
const askTab = (requester: string, via: StackVia, call: TodosCall) =>
  effect {
    const reply = try (try TabTodos).ask({ requester, call })
    // The agent's call belongs to the answer its tab asked for; a tab's own dispatch names its door in its reply.
    const door: Door | "unknown" = via === "agent"
      ? "agent"
      : Option.match(reply, { onNone: () => "unknown" as const, onSome: (answered) => answered.door })
    const outcome: StepOutcome = Option.isNone(reply)
      ? "tab_gone"
      : reply.value.kept
      ? "kept"
      : reply.value.missing === true
      ? "issue_not_found"
      : "not_kept"
    return { door, outcome }
  }

/**
 * What `todo/draft/keep` and `todo/issue/keep` do: derive the draft's id from the run, ask the tab that started it to
 * keep the draft on its device, and answer `drafted` with the stack's page. The agent's draft remembers the answer it
 * belongs to, so its card shows there. A draft from an issue names it, and the tab fills a title or prompt left out
 * from the issue (src/features/todos/tab.ts). Records a span `todos.draft`, a log line and a count of `drafts` by door
 * and outcome. A tab gone, one that couldn't keep it, or one whose device lacks the issue fails `TodoStepRefused`.
 */
export const keepDraft = (payload: {
  readonly repo: string
  readonly prompt?: string | undefined
  readonly title?: string | undefined
  readonly acceptance?: ReadonlyArray<string> | undefined
  readonly issue?: number | undefined
}) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const { executionId, requester, via } = try runOf
    const draftId = try Uuid.v5(DRAFT_ID_NAMESPACE, executionId).pipe(Effect.orDie)
    const [owner, name] = payload.repo.split("/") as [string, string]
    const { door, outcome } = try askTab(requester, via, {
      kind: "draft",
      draft: {
        id: draftId,
        repo: payload.repo,
        repoId: repoId(owner, name),
        title: payload.title?.trim() ?? (payload.prompt === undefined ? "" : titleOf(payload.prompt)),
        prompt: payload.prompt ?? "",
        acceptance: payload.acceptance ?? [],
        answerId: via === "agent" ? requester : null,
        createdAt: startedAt,
        ...(payload.issue === undefined ? {} : { issue: payload.issue }),
      },
    })
    try Metric.update(Metric.withAttributes(drafts, { door, outcome }), 1)
    try Effect.annotateCurrentSpan({ draftId, via, door, outcome, fromIssue: payload.issue !== undefined })
    try Effect.logWithLevel(outcome === "kept" ? "Info" : "Warn")("todos.draft").pipe(
      Effect.annotateLogs({
        draftId,
        via,
        door,
        outcome,
        fromIssue: payload.issue !== undefined,
        durationMs: (try Clock.currentTimeMillis) - startedAt,
        feature: "todos",
      }),
    )
    if (outcome !== "kept") throw new TodoStepRefused({ reason: outcome })
    return { draftId, status: "drafted", path: stackPath(owner, name) } satisfies Drafted
  }.pipe(Effect.withSpan("todos.draft"))

/** A change's fields by operation, as the step reads them from its payload. */
type Fields =
  | {
    readonly op: "commit"
    readonly repo: string
    readonly title: string
    readonly prompt: string
    readonly acceptance?: ReadonlyArray<string> | undefined
    readonly issue?: number | undefined
  }
  | { readonly op: "drop" | "retry"; readonly repo: string; readonly number: number }
  | { readonly op: "attach"; readonly repo: string; readonly number: number; readonly issue: number }

/**
 * What the commit, drop and retry queue steps do: derive the change's op id from the run, ask the tab that started it
 * to queue the change in the device's outbox, and answer `requested`. A commit's op id is its TODO's id. Only a person's
 * own door commits or drops: an agent may retry, but is otherwise refused before any tab is asked, whatever its catalog
 * offered (decision 0016 §3). Records a span `todos.queue`, a log line and a count of `queued` by operation, door and
 * outcome, never the text. The agent's call, a tab gone, or an outbox that wouldn't take it, fails `TodoStepRefused`.
 */
export const queueChange = (fields: Fields) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const { executionId, requester, via } = try runOf
    const opId = try Uuid.v5(OP_ID_NAMESPACE, executionId).pipe(Effect.orDie)
    const op: QueuedOp = fields.op === "commit"
      ? {
        id: opId,
        repo: fields.repo,
        op: "commit",
        title: fields.title.trim(),
        prompt: fields.prompt,
        acceptance: fields.acceptance ?? [],
        number: 0,
        ...(fields.issue === undefined ? {} : { issue: fields.issue }),
      }
      : fields.op === "attach"
      ? {
        id: opId,
        repo: fields.repo,
        op: "attach",
        title: "",
        prompt: "",
        acceptance: [],
        number: fields.number,
        issue: fields.issue,
      }
      : { id: opId, repo: fields.repo, op: fields.op, title: "", prompt: "", acceptance: [], number: fields.number }
    const { door, outcome } = via === "agent" && fields.op !== "retry"
      ? { door: "agent" as const, outcome: "agent" as const }
      : try askTab(requester, via, { kind: "queue", op })
    try Metric.update(Metric.withAttributes(queued, { op: fields.op, door, outcome }), 1)
    try Effect.annotateCurrentSpan({ opId, op: fields.op, via, door, outcome })
    try Effect.logWithLevel(outcome === "kept" ? "Info" : "Warn")("todos.queue").pipe(
      Effect.annotateLogs({
        opId,
        op: fields.op,
        via,
        door,
        outcome,
        durationMs: (try Clock.currentTimeMillis) - startedAt,
        feature: "todos",
      }),
    )
    if (outcome !== "kept") throw new TodoStepRefused({ reason: outcome })
    return { opId, status: "requested" } satisfies ChangeRequested
  }.pipe(Effect.withSpan("todos.queue"))

/**
 * Registers `todo/draft`, `todo/issue`, `todo/commit` and `todo/drop` with their steps, asking through the host's
 * `TabTodos`.
 */
export const registration = Layer.mergeAll(
  Interpreter.layerWithImplementations(TodoDraft, KeepDraft.toLayer(keepDraft)),
  Interpreter.layerWithImplementations(TodoIssue, KeepIssueDraft.toLayer(keepDraft)),
  Interpreter.layerWithImplementations(
    TodoCommit,
    QueueCommit.toLayer((payload) => queueChange({ op: "commit", ...payload })),
  ),
  Interpreter.layerWithImplementations(
    TodoRetry,
    QueueRetry.toLayer((payload) => queueChange({ op: "retry", ...payload })),
  ),
  Interpreter.layerWithImplementations(
    TodoDrop,
    QueueDrop.toLayer((payload) => queueChange({ op: "drop", ...payload })),
  ),
  Interpreter.layerWithImplementations(
    TodoAttach,
    QueueAttach.toLayer((payload) => queueChange({ op: "attach", ...payload })),
  ),
)

/** An agent status read uses the shared stack, never absence from this device's run list. */
export const inspectStatus = (origin: string, payload: { readonly repo: string; readonly number: number }) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const [owner, name] = payload.repo.split("/") as [string, string]
    const result = try Effect.result(readTodoStatus(origin, owner, name, payload.number, "10 seconds"))
    const outcome = result._tag === "Success" ? result.success.kind : result.failure.reason
    try Metric.update(Metric.withAttributes(statusReads, { outcome }), 1)
    try Effect.annotateCurrentSpan({ outcome })
    try Effect.logWithLevel(result._tag === "Success" ? "Info" : "Warn")("todos.inspect").pipe(
      Effect.annotateLogs({ outcome, durationMs: (try Clock.currentTimeMillis) - startedAt, feature: "todos" }),
    )
    if (result._tag === "Failure") return try result.failure
    return result.success
  }.pipe(Effect.withSpan("todos.inspect"))

/** Model-readable TODO status on the device's durable engine. */
export const registrationAt = (origin: string) =>
  Layer.mergeAll(
    registration,
    // Keep the host's authenticated transport when the engine supplies its step context.
    Layer.unwrap(
      Effect.map(
        HttpClient.HttpClient,
        (client) =>
          Interpreter.layerWithImplementations(
            TodoInspect,
            ReadTodoStatus.toLayer((payload) =>
              inspectStatus(origin, payload).pipe(Effect.provideService(HttpClient.HttpClient, client))
            ),
          ),
      ),
    ),
  )
