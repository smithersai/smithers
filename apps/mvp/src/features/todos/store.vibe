import { observeInitialApplied } from "../../shapeApplied"
import { admissionReceipt } from "../../writeAdmission"
import { ElectricCollection, ShapeSource } from "@smthrs/effect-electric"
import { Collection, LiveQuery, Persistence } from "@smthrs/effect-tanstack-db"
import { Cache, Exit } from "effect"
import { AuthStore } from "../auth/store"
import { RepoStore } from "../repo/store"
import type { Gated } from "../repo/gate"
import { evictOnRefusal, repositoryShapeSource, wipeAuthority } from "../issues/source"
import { stackAccess } from "./source"
import { ChatStore } from "../chat/store"
import { repoId } from "../repo/contract"
import { sendingAdmitted } from "../../outboxAdmission"
import { TODO_REQUESTS_SHAPE_ROUTE, TODOS_SHAPE_ROUTE } from "./contract"
import {
  Access,
  Draft,
  type QueuedOp,
  type Requested,
  requestKey,
  type Sending,
  StackView,
  Todo,
  TodoRequest,
  VIEW,
} from "./schema"
import { deliveredOf } from "./view"
import { keep, StackWrites, TODO_OP } from "./writes"
import { admissions } from "#vibelang/emitted/src/features/todos/metrics"

/** Electric's mapper between snake_case columns and camelCase fields, shared by this module's shapes. */
const snakeCamel = ElectricCollection.snakeCamelMapper()

// TODOs on this tab (decision 0016 §1, docs/features/todos.md#the-browser): each repository's TODOs and their prompts
// in Postgres, synced by Electric while a page shows that repository's stack and kept on the device; this device's own
// changes (src/features/todos/writes.ts); its private drafts, kept on the device; and what the route shows. Once a
// repository's stack opens, a follower drops each requested change whose result Electric delivered, and the shape's
// answers say whether this person may read it.

/** Where the TODOs sync from: ChatApi's origin. A failed request waits `SyncPolicy.defaultPolicy`. */
export interface TodosConfig {
  readonly origin: string
}

/** A row's key: its id. */
const byId = (row: { readonly id: string }): string => row.id

/** A live query of every row of `collection`. */
const rowsOf = <A extends object>(collection: { readonly tanstack: Collection.Collection<A, any>["tanstack"] }) =>
  LiveQuery.make((q) => q.from({ row: collection.tanstack }))

/** Every row of a collection of `A`, live. */
export type Rows<A extends object> = Effect.Success<ReturnType<typeof rowsOf<A>>>

/**
 * One repository's stack on this tab: its synced TODOs and their prompts, live, through the data gate (repo/gate.ts):
 * none while the repository may not show.
 */
export interface RepoStack {
  readonly todos: Gated<Todo>
  readonly requests: Gated<TodoRequest>
  /**
   * Its TODOs as stored, whatever the gate shows: what another store's follower settles a commit by (attention's feed,
   * whose own entries go through the gate). Never shown.
   */
  readonly stored: ReadonlyArray<Todo>!!
}

/**
 * The TODOs' state for one tab:
 * - `stackOf(repoId)`: a repository's TODOs and prompts, synced once a page opened them, for as long as the store lives;
 * - `opened(repoId)`: the same, if a page opened them, else none;
 * - `sending`, `requested`: this device's own changes (`StackWrites`);
 * - `drafts`: private drafts, kept on the device; `view`: what this tab's route shows; `access`: per repository;
 * - live queries of those for frontends, and `empty`, the rows of a stack not opened;
 * - `keepDraft` and `queue`: what a TODO step's tab does; `scope`, where a press's dispatch runs.
 */
export class TodosStore extends Context.Service<
  TodosStore,
  {
    readonly stackOf: (repoId: string) => RepoStack!Collection.LoadFailed
    readonly opened: (repoId: string) => RepoStack | undefined
    /** The stacks this tab has opened; their stored TODOs remain results after recovery cleanup. */
    readonly openedStacks: () => ReadonlyArray<RepoStack>
    readonly empty: RepoStack
    readonly sending: Collection.Collection<Sending, string>
    readonly requested: Collection.Collection<Requested, string>
    readonly drafts: Collection.Collection<Draft, string>
    readonly view: Collection.Collection<StackView, string>
    readonly access: Collection.Collection<Access, string>
    /** What shows of the drafts and of this device's own changes, through the data gate (repo/gate.ts). */
    readonly draftsQuery: Gated<Draft>
    readonly sendingQuery: Gated<Sending>
    readonly requestedQuery: Gated<Requested>
    readonly viewQuery: Effect.Success<ReturnType<typeof viewOf>>
    readonly accessQuery: Rows<Access>
    readonly keepDraft: (draft: Draft) => { readonly kept: boolean }!!
    readonly queue: (op: QueuedOp) => { readonly kept: boolean }!!
    readonly scope: Scope.Scope
    /** Once after any change to an opened stack's synced TODOs, its first rows included: what a commit's result reads on. */
    readonly todosChanged: Stream.Stream<void>
  }
>()("@smthrs/mvp/todos/TodosStore") {
  /** The store; its collections cleaned up and its shapes closed when the scope closes. Needs chat's store's outbox. */
  static readonly layer = (config: TodosConfig) => Layer.effect(TodosStore, make(config))
}

/** The one view row. */
const viewOf = (view: Collection.Collection<StackView, string>) =>
  LiveQuery.make((q) => q.from({ view: view.tanstack }).findOne())

const make = effect function(config: TodosConfig) {
  const scope = try Effect.scope
  const changedTodos = try PubSub.unbounded<void>()
  const auth = try AuthStore
  const repos = try RepoStore
  const persistence = try Persistence.Persistence
  // Stack shapes open later; retain the source supplied when this store was built.
  const source = try ShapeSource.ShapeSource
  const chat = try ChatStore
  const { sending, requested } = try StackWrites
  const drafts = try Collection.persisted<Draft, string>({
    id: "todo-drafts",
    schema: Draft,
    getKey: byId,
    schemaVersion: 1,
  })
  const view = try Collection.local<StackView, string>({
    id: "todo-view",
    schema: StackView,
    getKey: byId,
    initialData: [{ id: VIEW, owner: "", name: "", repoId: "", number: null, committing: [] }],
  })
  const access = try Collection.local<Access, string>({ id: "todo-access", schema: Access, getKey: byId })
  // The store's own follower reads every requested change; what shows reads `requestedQuery`, through the data gate.
  const requestedRows = try rowsOf(requested)
  const requestedQuery = try repos.gate(requested)

  // A stack nobody opened: no rows, never a request.
  const nothing = try Collection.local<Todo, string>({ id: "todo-none", schema: Todo, getKey: byId })
  const noRequests = try Collection.local<TodoRequest, string>({
    id: "todo-requests-none",
    schema: TodoRequest,
    getKey: requestKey,
  })
  const empty: RepoStack = {
    todos: try repos.gate(nothing),
    requests: try repos.gate(noRequests),
    stored: nothing.toArray,
  }

  // Each shape is ChatApi's proxy of one table for one repository, kept on the device.
  const shape = (route: string, id: string) => ({
    url: `${config.origin}${route}?repo=${encodeURIComponent(id.slice("github/".length))}`,
    columnMapper: snakeCamel,
  })
  // Stacks a TODO shape refused (a 403), by repository id, with how many role answers the tab had then: the next answer
  // decides again.
  const stackRefused = try SubscriptionRef.make<ReadonlyMap<string, number>>(new Map())
  // The stacks opened so far, by repository id, for frontends to read at once; each opens once (`opening`).
  const stacks = new Map<string, RepoStack>()
  const shapesOf = new Map<string, ReadonlyArray<{ readonly evict: void!! }>>()
  const open = (id: string) =>
    effect {
      try repos.refusalsKnown
      // A stack needs Member: its 403 can be a tier refusal of someone who still reads the repository (a Member made a
      // Guest), so it never marks the repository. It refuses this stack until a role read answers again, which the next route asks for (`markStale`).
      const authority = Stream.zipLatest(
        Stream.zipLatest(auth.sessionState.rows, repos.rolesState.rows),
        Stream.zipLatest(SubscriptionRef.changes(stackRefused), repos.answerChanges),
      ).pipe(
        Stream.map(([[sessions, roles], [refusedUnder]]) =>
          refusedUnder.get(id) === repos.answersOf(id) ? "forbidden" as const : stackAccess(sessions[0]!, roles, id)
        ),
        Stream.changes,
      )
      const tierSource: ShapeSource.Source = {
        cacheNamespace: source.cacheNamespace,
        request: (url, init) => Effect.tap(source.request(url, init), (response) => {
          if (response.status === 401) return auth.askCheck
          if (response.status !== 403) return Effect.void
          return effect {
            try SubscriptionRef.update(stackRefused, (held) => new Map(held).set(id, repos.answersOf(id)))
            try repos.markStale(id)
          }.pipe(Effect.uninterruptible)
        }),
      }
      const guarded = repositoryShapeSource(tierSource, authority)
      const todos = try ElectricCollection.make<Todo>({
        id: `todos:${id}`,
        schema: Todo,
        getKey: byId,
        shape: shape(TODOS_SHAPE_ROUTE, id),
        syncMode: "eager",
        // 4: a failure may be `base_closed` (stacked TODOs); 5: `after` and `waiting` (decision 0135); 6: a failure may
        // be `stopped` (a person stopped its external agent).
        persist: { schemaVersion: 6 },
      }).pipe(Effect.provideService(ShapeSource.ShapeSource, guarded))
      try observeInitialApplied(todos, "todos", id.slice("github/".length)).pipe(
        Effect.forkIn(scope, { startImmediately: true }),
      )
      const requests = try ElectricCollection.make<TodoRequest>({
        id: `todo-requests:${id}`,
        schema: TodoRequest,
        getKey: requestKey,
        shape: shape(TODO_REQUESTS_SHAPE_ROUTE, id),
        syncMode: "eager",
        persist: { schemaVersion: 1 },
      }).pipe(Effect.provideService(ShapeSource.ShapeSource, guarded))
      // Tracking writes the visibility row; a throw there was a defect of this open.
      try Effect.orDie(Effect.try({ try: () => repos.track(id), catch: (e) => e }))
      const stack: RepoStack = {
        todos: try repos.gate(todos),
        requests: try repos.gate(requests),
        stored: todos.toArray,
      }
      // The store's own followers read every synced row, shown or not: a result that arrived settles its change.
      const allTodos = try rowsOf(todos)
      // A refusal drops the repository's TODOs and prompts from the device. What this device queued stays in `sending`
      // and `requested` (`StackWrites`): the route answers it, and it reads Not sent with Discard.
      shapesOf.set(id, [todos, requests])
      try evictOnRefusal(wipeAuthority(auth, authority), [todos, requests]).pipe(
        Effect.forkIn(scope, { startImmediately: true }),
      )
      try allTodos.rows.pipe(
        Stream.runForEach(() => PubSub.publish(changedTodos, undefined)),
        Effect.forkIn(scope, { startImmediately: true }),
      )
      // A requested change whose result arrived goes. Access follows the device session and repository role.
      try Stream.zipLatest(allTodos.rows, requestedRows.rows).pipe(
        Stream.runForEach(([rows, mine]) =>
          Effect.forEach(deliveredOf(id, rows, mine), (opId) => Effect.ignore(requested.delete(opId)), {
            discard: true,
          })
        ),
        Effect.forkIn(scope, { startImmediately: true }),
      )
      // Unknown until the session and repository role answer.
      try Effect.ignore(access.insert({ id, status: "unknown" }))
      try authority.pipe(
        // Each time authority allows it, as an eviction restarts the shape from nothing.
        Stream.switchMap((status) =>
          status === "allowed"
            ? Stream.concat(
              Stream.make("syncing" as const),
              Stream.fromEffect(Effect.as(todos.currentApplied, "allowed" as const)),
            )
            : Stream.make(status)
        ),
        Stream.runForEach((status) =>
          Effect.ignore(access.update(id, (row) => {
            row.status = status
          }))
        ),
        Effect.forkIn(scope, { startImmediately: true }),
      )
      stacks.set(id, stack)
      return stack
    }.pipe(
      Scope.provide(scope),
      Effect.provideService(Persistence.Persistence, persistence),
      Effect.provideService(ShapeSource.ShapeSource, source),
    )
  // Opening a stack twice at once opens it once: the cache runs one lookup per repository and keeps it.
  const opening = try Cache.makeWith(open, {
    capacity: Number.MAX_SAFE_INTEGER,
    timeToLive: (exit) => Exit.isFailure(exit) ? 0 : Infinity,
  })
  const stackOf = (id: string) => Cache.get(opening, id)
  try repos.registerCache(
    ["todos", "todo-requests"],
    (id) =>
      Effect.andThen(
        stackOf(id),
        Effect.suspend(() => Effect.forEach(shapesOf.get(id) ?? [], (shape) => shape.evict, { discard: true })),
      ),
  )

  /** Keeps `draft` on the device once: a draft the device has already is kept. Answers whether the device has it. */
  const keepDraft = (draft: Draft) =>
    effect {
      if (Option.isSome(try drafts.get(draft.id))) return { kept: true }
      const inserted = try drafts.insert(draft).pipe(Effect.result)
      return { kept: inserted._tag === "Success" }
    }

  /**
   * Puts `op` in the device's outbox once: a change it holds or the route took already is queued. This tab takes the
   * outbox's lead first, as a tab a person presses in does (decision 0002 §1), so the outbox admits it here. Answers
   * whether the outbox stored it.
   */
  const queue = (op: QueuedOp) =>
    effect {
      const flow = op.op === "retry" ? "todo/Retry" : `todo/${op.op}`
      const held = try requested.get(op.id)
      if (Option.isSome(try sending.get(op.id))) return { kept: try sendingAdmitted(chat.outbox, TODO_OP, op.id) }
      if (Option.isSome(held) && (held.value.status === "requested" || held.value.reason !== null)) {
        return { kept: true }
      }
      const [owner, name] = op.repo.split("/") as [string, string]
      const row: Sending = { ...op, repoId: repoId(owner, name), queuedAt: try Clock.currentTimeMillis, v: 3 }
      const recovery = try Effect.result(
        admissionReceipt(keep(requested, row, "not_sent", null, null), op.id, flow, "recovery"),
      )
      if (recovery._tag === "Failure") {
        try recordAdmission(op, "storage_failed")
        return { kept: false }
      }
      try admissionReceipt(chat.lead, op.id, flow, "leader")
      const admitted = try chat.outbox
        .transact(TODO_OP, { idempotencyKey: op.id, joinExisting: true }, Effect.asVoid(sending.insert(row)))
        .pipe(
          Effect.flatMap((taken) =>
            admissionReceipt(taken.admitted, op.id, flow, "storage").pipe(
              Effect.catch((error) => Effect.andThen(Effect.ignore(taken.settled), Effect.fail(error))),
            )
          ),
          Effect.result,
        )
      const pending = try requested.get(op.id)
      if (
        admitted._tag === "Success" && Option.isSome(pending) && pending.value.status === "not_sent"
        && pending.value.reason === null
      ) {
        const removed = try requested.delete(op.id).pipe(Effect.orDie)
        try Effect.ignore(removed.persisted)
      }
      try recordAdmission(op, admitted._tag === "Success" ? "queued" : "not_admitted")
      return { kept: admitted._tag === "Success" }
    }

  return TodosStore.of({
    todosChanged: Stream.fromPubSub(changedTodos),
    stackOf,
    opened: (id) => stacks.get(id),
    openedStacks: () => [...stacks.values()],
    empty,
    sending,
    requested,
    drafts,
    view,
    access,
    draftsQuery: try repos.gate(drafts),
    sendingQuery: try repos.gate(sending),
    requestedQuery,
    viewQuery: try viewOf(view),
    accessQuery: try rowsOf(access),
    keepDraft,
    queue,
    scope,
  })
}

const recordAdmission = (op: QueuedOp, outcome: "queued" | "not_admitted" | "storage_failed") => effect {
  try Metric.update(Metric.withAttributes(admissions, { op: op.op, outcome }), 1)
  try Effect.logInfo("todos.write.admission").pipe(Effect.annotateLogs({ opId: op.id, op: op.op, outcome }))
}
