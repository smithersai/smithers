import { clearWriteComposer } from "../../admissionSource.vibe"
import { keep } from "./writes.vibe"
import { admissionReceipt, beginAdmission, executionOf, finishAdmission, finishRetainedAdmission, whileAdmitting, forgetAdmission, forgetDraftAdmissions, identifyAdmission } from "../../writeAdmission"
import { Uuid, WebCrypto } from "@smthrs/crypto"
import type { Collection } from "@smthrs/effect-tanstack-db"
import { WebCrypto as WebCryptoReference } from "effect/crypto/WebCrypto"
import { FlowDispatch } from "../../flows/dispatch.vibe"
import { startOperation } from "../commands/admission.vibe"
import { followRun } from "../../resumeAdmissions"
import { repoId } from "../repo/contract"
import { isPrompt, isTitle, OP_ID_NAMESPACE, type StackBase, stackPath } from "./contract"
import { StackClient } from "./api.vibe"
import { pendingActions } from "./metrics"
import { type Draft, type QueuedOp, type Requested, VIEW } from "./schema"
import { TodosStore } from "./store.vibe"

// TODO writes await local durable admission (decision 0016 §3, docs/features/todos.md). Commit
// and Drop are the flows `todo/commit` and `todo/drop`, dispatched with door `button` in the store's scope: the press
// returns at once, and a committed draft goes once its change is queued. Sending runs in the outbox, never in an action.

/**
 * What a stack route calls on a link's hover or focus (the router's intent preload): starts syncing `owner/name`'s
 * stack without showing it, so the page the click opens has its rows.
 */
export const warm = effect (owner: string, name: string): void!Collection.LoadFailed!TodosStore => {
  const store = try TodosStore
  try store.stackOf(repoId(owner, name))
}

/** What a stack route calls on a navigation: shows `owner/name`'s stack, and, with `number`, that TODO; and syncs the stack. */
export const open = (owner: string, name: string, number?: number) =>
  orDie(effect {
    const store = try TodosStore
    const id = repoId(owner, name)
    try store.view.update(VIEW, (row) => {
      row.owner = owner
      row.name = name
      row.repoId = id
      row.number = number ?? null
    })
    try store.stackOf(id)
  })

/** New TODO on `owner/name`'s stack: an empty private draft. Answers its id. */
export const newDraft = (owner: string, name: string) =>
  orDie(effect {
    const { drafts } = try TodosStore
    const id = try sync(() => WebCryptoReference.defaultValue().randomUUID())
    try drafts.insert({
      id,
      repo: `${owner}/${name}`,
      repoId: repoId(owner, name),
      title: "",
      prompt: "",
      acceptance: [],
      answerId: null,
      createdAt: try Clock.currentTimeMillis,
    })
    return id
  })

/** Changes draft `id`'s text; a draft the device no longer has stays gone. */
const changeDraft = (id: string, change: Partial<Pick<Draft, "title" | "prompt" | "issue" | "after">>) =>
  orDie(effect {
    const { drafts } = try TodosStore
    if (Option.isNone(try drafts.get(id))) return
    try drafts.update(id, (draft) => void Object.assign(draft, change))
  })

export const setTitle = (id: string, title: string) => changeDraft(id, { title })
/** The issue draft `id` hangs under (decision 0153): Commit waits until one is chosen. */
export const setIssue = (id: string, issue: number) => changeDraft(id, { issue })
export const setPrompt = (id: string, prompt: string) => changeDraft(id, { prompt })
/** Which open TODO draft `id` stacks after: `undefined` uses repo default, `null` starts independent, or a TODO id. */
export const setAfter = (id: string, after: number | null | undefined) =>
  changeDraft(id, { after })

/** Updates a repository stack's settings (lanes, maxOpen, base) through the stack route (Admin-only). */
export const configureStack = effect (
  owner: string,
  name: string,
  settings: { readonly lanes: number; readonly maxOpen: number; readonly base: StackBase },
) => {
  const { view } = try TodosStore
  const client = try StackClient
  try orDie(view.update(VIEW, (row) => {
    row.settingsOutcome = { status: "saving" }
  }))
  const outcome = try client.change(
    owner,
    name,
    { opId: try sync(() => WebCryptoReference.defaultValue().randomUUID()), op: "configure", lanes: settings.lanes, maxOpen: settings.maxOpen, base: settings.base },
  ).pipe(
    Effect.as({ status: "saved" as const }),
    catchTag("ChangeNotTaken", (error) => {
      const code = error.code ?? "unavailable"
      return logWarning("todos.configure").pipe(
        annotateLogs({ feature: "todos", code }),
        Effect.as({ status: "failed" as const, code }),
      )
    }),
  )
  try orDie(view.update(VIEW, (row) => {
    row.settingsOutcome = outcome
  }))
  return outcome
}

/** Changes this tab's issue choice for one orphan TODO; clearing or an invalid number removes the choice. */
export const setAttachmentIssue = (todoId: string, issue: number | undefined, repoId?: string) =>
  orDie(effect {
    const { attachmentIssues } = try TodosStore
    const held = try attachmentIssues.get(todoId)
    if (issue === undefined || !Number.isInteger(issue) || issue <= 0) {
      if (Option.isSome(held)) try attachmentIssues.delete(todoId)
    } else if (Option.isSome(held)) {
      try attachmentIssues.update(todoId, (row) => {
        row.issue = issue
        if (repoId !== undefined) row.repoId = repoId
      })
    } else {
      try attachmentIssues.insert(repoId === undefined ? { id: todoId, issue } : { id: todoId, issue, repoId })
    }
  })

/** Marks draft `id`'s Commit on its way from this tab, or no longer. */
const setCommitting = effect (id: string, committing: boolean) => {
  const { view } = try TodosStore
  return try orDie(view.update(VIEW, (row) => {
    row.committing = committing ? [...row.committing, id] : row.committing.filter((other) => other !== id)
  }))
}

/** Stable for an unchanged draft snapshot; its content never enters the flow's recorded identity. */
const commitIdentity = (draft: Draft) => ({ namespace: OP_ID_NAMESPACE, value: JSON.stringify([draft.id, draft.repo, draft.title.trim(), draft.prompt, draft.acceptance, draft.issue ?? null, draft.after === undefined ? "default" : draft.after]) })
const commitExecutionId = (draft: Draft) => Uuid.v5(OP_ID_NAMESPACE, commitIdentity(draft).value).pipe(Effect.provide(WebCrypto.layer), orDie)

/** Commit retains its draft until the device durably admits its snapshot. */
export const commit = effect (id: string) => {
  const store = try TodosStore
  const found = try store.drafts.get(id)
  const view = Option.getOrThrow(try store.view.get(VIEW))
  if (Option.isNone(found) || view.committing.includes(id)) return undefined
  const draft = found.value
  if (!isTitle(draft.title) || !isPrompt(draft.prompt)) return undefined
  const flows = try FlowDispatch
  try setCommitting(id, true)
  const payload = { repo: draft.repo, title: draft.title.trim(), prompt: draft.prompt,
    ...(draft.acceptance.length === 0 ? {} : { acceptance: draft.acceptance }),
    ...(draft.issue === undefined ? {} : { issue: draft.issue }),
    ...(draft.after === undefined ? {} : { after: draft.after }) }
  // Input retention must precede any asynchronous progress/toast persistence as well as outbox admission.
  const admission = try beginAdmission("todo/commit", payload, commitIdentity(draft), id)
  if (Option.isNone(admission)) { try setCommitting(id, false); return undefined }
  const executionId = try executionOf(admission.value)
  const opId = try Uuid.v5(OP_ID_NAMESPACE, executionId).pipe(Effect.provide(WebCrypto.layer), orDie)
  try identifyAdmission(admission.value, executionId, opId)
  const { kept } = try store.queue({ ...payload, id: opId, op: "commit", number: 0, acceptance: draft.acceptance })
  let cleaned = true
  if (kept) {
    const source = try store.drafts.get(id)
    if (Option.isSome(source) && commitIdentity(source.value).value === commitIdentity(draft).value) {
      cleaned = (admissionReceipt(
        store.drafts.delete(id) |> flatMap(%, (removed) => removed.persisted),
        admission.value.commandId, "todo/commit", "source",
      ) |> Effect.as(%, true)) catch () => false
    }
    try flows.dispatch("todo/commit", payload, { door: "button", executionId }).pipe(ignore, forkIn(store.scope, { startImmediately: true }))
  }
  try finishAdmission(admission.value, kept, cleaned)
  try setCommitting(id, false)
  const [owner, name] = draft.repo.split("/") as [string, string]
  return try sync(() => stackPath(owner, name))
}

/** Records Edit or Discard on a change, or Discard on a draft. */
const record = (action: "edit" | "discard" | "discard_draft", fields: Record<string, string>) =>
  andThen(
    Metric.update(Metric.withAttributes(pendingActions, { action }), 1),
    logInfo("todos.pending").pipe(annotateLogs({ ...fields, action, feature: "todos" })),
  )

/** Discard on draft `id`: it goes. */
export const discardDraft = effect (id: string) => {
  const { drafts } = try TodosStore
  if (Option.isNone(try drafts.get(id)) || !(try forgetDraftAdmissions(id))) return
  try ignore(drafts.delete(id))
  try record("discard_draft", { draftId: id })
}

/**
 * Make TODO on issue `number` of `owner/name` (`todo/issue`), from its row, its page or its key: the press returns the
 * stack's page at once, where the draft shows once the step kept it, its title and prompt the issue's.
 */
export const fromIssue = effect (owner: string, name: string, number: number) => {
  const store = try TodosStore
  const payload = { repo: `${owner}/${name}`, issue: number }
  // Staged first, so a reload starts the same run again; a second press before the run settled joins it (decision
  // 0124). The engine recording the run admits it. A tab that can't stage it keeps it in memory: it is always kept.
  const intent = Option.getOrThrow(try beginAdmission("todo/issue", payload, undefined, `todo/issue:${payload.repo}#${number}`, undefined, "button"))
  const executionId = try executionOf(intent)
  try identifyAdmission(intent, executionId)
  try forkIn(effect {
    const { started, run } = try startOperation("todo/issue", payload, { executionId, door: "button", scope: store.scope })
    try finishAdmission(intent, started === "admitted", true, started === "unconfirmed")
    if (started === "admitted") try followRun({ ...intent, executionId }, run, store.scope)
  }, store.scope, { startImmediately: true })
  return try sync(() => stackPath(owner, name))
}

/** The flow each change to a numbered TODO runs. */
const flowOfChange = { drop: "todo/drop", retry: "todo/Retry", attach: "todo/attach" } as const

/**
 * Drop, Retry or Attach on TODO `number` of `owner/name` (`todo/drop`, `todo/Retry`, `todo/attach` with its `issue`):
 * the press returns at once, and the TODO shows Requested.
 */
const admitChange = effect (op: "drop" | "retry" | "attach", owner: string, name: string, number: number, issue?: number) => {
  const store = try TodosStore
  const flows = try FlowDispatch
  const payload = { repo: `${owner}/${name}`, number, ...(issue === undefined ? {} : { issue }) }
  const refused = Option.getOrThrow(try store.view.get(VIEW)).admissionFailures?.find(row => row.repo === payload.repo && row.op === op && row.number === number && row.issue === issue)
  if (refused !== undefined) return try retryChange(refused.id)
  const admission = try beginAdmission(flowOfChange[op], payload)
  if (Option.isNone(admission)) {
    const row: Requested = { ...payload, id: try sync(() => WebCryptoReference.defaultValue().randomUUID()), repoId: repoId(owner, name), op, title: "", prompt: "", acceptance: [], queuedAt: try Clock.currentTimeMillis, status: "not_sent", reason: null, taken: null }
    try store.view.update(VIEW, view => { view.admissionFailures = [...view.admissionFailures ?? [], { ...row, acceptance: [...row.acceptance] }] }).pipe(orDie)
    // Refusal is visible synchronously. Persist its same-identity recovery row once when that store is usable.
    const persistRefusal = effect {
      try admissionReceipt(keep(store.requested, { ...row, v: 4 }, "not_sent", null, null), row.id, flowOfChange[op], "refusal")
      try clearFailure(row.id)
    }
    try forkIn(whileAdmitting(row.id, ignore(persistRefusal)), store.scope, { startImmediately: true })
    return
  }
  const executionId = try executionOf(admission.value)
  const id = try Uuid.v5(OP_ID_NAMESPACE, executionId).pipe(Effect.provide(WebCrypto.layer), orDie)
  try identifyAdmission(admission.value, executionId, id)
  const row: QueuedOp = { ...payload, id, op, title: "", prompt: "", acceptance: [] }
  const { kept } = try store.queue(row)
  try finishAdmission(admission.value, kept)
  if (kept) try flows.dispatch(flowOfChange[op], payload, { door: "button", executionId }).pipe(
    ignore, forkIn(store.scope, { startImmediately: true }),
  )
}

export const drop = (owner: string, name: string, number: number) => admitChange("drop", owner, name, number)

/** Attach to issue on TODO `number`, whose issue is none or deleted (decision 0153): a person's press. */
export const attach = (owner: string, name: string, number: number, issue: number) =>
  admitChange("attach", owner, name, number, issue)

const recoveryRow = effect (id: string) => {
  const store = try TodosStore
  const held = try store.requested.get(id)
  if (Option.isSome(held)) return held
  const view = try store.view.get(VIEW)
  return Option.fromUndefinedOr(Option.getOrThrow(view).admissionFailures?.find(row => row.id === id))
}
const clearFailure = (id: string) => orDie(effect {
  const store = try TodosStore
  return try store.view.update(VIEW, view => {
    view.admissionFailures = (view.admissionFailures ?? []).filter(row => row.id !== id)
  })
})

/**
 * Keeps commit `change`'s text as a draft on the device, one draft per change: an Edit again, after a reload or a refused
 * removal of the change, finds the draft an earlier Edit kept rather than making another. Answers whether the device
 * kept it, and whether this Edit made it.
 */
const restoreDraft = effect (change: Requested) => {
  const { drafts } = try TodosStore
  const id = try Uuid.v5(OP_ID_NAMESPACE, `edit:${change.id}`).pipe(Effect.provide(WebCrypto.layer), orDie)
  if (Option.isSome(try drafts.get(id))) return { id, kept: true, made: false }
  const kept = (drafts.insert({
    id,
    repo: change.repo,
    repoId: change.repoId,
    title: change.title,
    prompt: change.prompt,
    acceptance: change.acceptance,
    answerId: null,
    createdAt: try Clock.currentTimeMillis,
    ...(change.issue === undefined ? {} : { issue: change.issue }),
    ...(change.after === undefined ? {} : { after: change.after }),
  }) |> flatMap(%, (inserted) => inserted.persisted) |> Effect.as(%, true)) catch () => false
  return { id, kept, made: true }
}

/**
 * Edit or Discard on a change that wasn't sent: Edit puts a commit's text back in a new draft first. The change goes
 * from the device. Answers the stack's page, or nothing for a change the device doesn't have.
 */
const handle = effect (opId: string, action: "edit" | "discard") => {
  const { requested, drafts } = try TodosStore
  const found = try recoveryRow(opId)
  if (Option.isNone(found)) return undefined
  const change = found.value
  // Edit keeps the commit's text in a draft on the device before the change goes: while the device refuses the draft,
  // the change stays Not sent with its text.
  const restored = action === "edit" && change.op === "commit" ? try restoreDraft(change) : undefined
  if (restored?.kept === false) {
    try logWarning("todos.pending").pipe(annotateLogs({ opId, op: change.op, action, outcome: "not_kept", feature: "todos" }))
    return undefined
  }
  if (!(try forgetAdmission(OP_ID_NAMESPACE, change.id))) {
    // An admission of the change is running in this tab: it decides, so this Edit leaves no draft of its own.
    if (restored?.made === true) try ignore(drafts.delete(restored.id))
    return undefined
  }
  if (Option.isSome(try requested.get(opId))) try ignore(requested.delete(opId))
  try clearFailure(opId)
  try record(action, { opId, op: change.op })
  const [owner, name] = change.repo.split("/") as [string, string]
  return try sync(() => stackPath(owner, name))
}

/** Edit on a commit that wasn't sent: its text goes back to a draft. Answers the stack's page. */
export const edit = (opId: string) => handle(opId, "edit")

/** Discard on a change that wasn't sent: it goes. */
export const discard = (opId: string) => asVoid(handle(opId, "discard"))

/** Retries local admission using the retained identity, without inventing another TODO. */
export const retryChange = (id: string) => whileAdmitting(id, effect {
  const store = try TodosStore
  const row = try recoveryRow(id)
  if (Option.isNone(row) || row.value.status !== "not_sent" || row.value.reason !== null) return
  const { kept } = try store.queue(row.value)
  let cleaned = true
  if (kept && row.value.op === "commit") for (const draft of try store.drafts.toArray) {
    const opId = try Uuid.v5(OP_ID_NAMESPACE, try commitExecutionId(draft)).pipe(Effect.provide(WebCrypto.layer), orDie)
    if (opId === id) {
      const removed = (store.drafts.delete(draft.id) |> flatMap(%, (deleted) => deleted.persisted) |> Effect.as(%, true)) catch () => false
      cleaned = removed && cleaned
    }
  }
  if (kept) try clearFailure(id)
  if (kept) cleaned = (try clearWriteComposer(id)) && cleaned
  try finishRetainedAdmission(id, kept, cleaned)
})

/** Retry returns once the durable launch is requested; the outbox sends in the background. */
export const retry = (owner: string, name: string, number: number) => admitChange("retry", owner, name, number)
