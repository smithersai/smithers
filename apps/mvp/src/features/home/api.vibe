import { Context, type Duration, Effect, Layer, Schema } from "effect"
import { HttpClient, HttpClientRequest } from "effect/http"
import { homeRoute } from "./contract"
import { HomeAnswer } from "./schema"

// `GET /api/repos/<owner>/<name>/home` as the browser calls it (worker/home/Api.ts), through Effect's HttpClient, with
// one deadline over the whole exchange.

/** ChatApi didn't answer as the contract says: no network or no whole answer in time (no `status`), or another status. */
export error HomeRefused {
  status?: number
}

/** Who the asker is on `owner/name`, and Smithers' curated home for it. */
export const getHome = Effect.fn("home.answer.get")(effect (
  origin: string,
  repository: { readonly owner: string; readonly name: string },
  within: Duration.Input,
) => {
  const client = try HttpClient.HttpClient
  return try (effect {
    const url = try sync(() => `${origin}${homeRoute(repository.owner, repository.name)}`)
    const response = try client.execute(HttpClientRequest.get(url))
      .pipe(Effect.mapError(() => new HomeRefused({})))
    try Effect.annotateCurrentSpan({ "http.response.status_code": response.status })
    if (response.status !== 200) throw new HomeRefused({ status: response.status })
    return try response.json.pipe(
      Effect.flatMap(Schema.decodeUnknownEffect(HomeAnswer)),
      Effect.mapError(() => new HomeRefused({ status: response.status })),
    )
  }.pipe(Effect.timeoutOrElse({ duration: within, orElse: () => Effect.fail(new HomeRefused({})) })))
})

/**
 * The home's client, as a service: the one way the browser asks who the person is on a repository and for its curated
 * home. A test of a ChatApi that fails provides a faulty one; every other test uses the real one.
 */
export class HomeClient extends Context.Service<
  HomeClient,
  { readonly answer: (owner: string, name: string) => HomeAnswer!HomeRefused }
>()("@smthrs/mvp/home/HomeClient") {
  /** The real client: ChatApi at `origin`, with `within` for each whole request. */
  static readonly layer = (options: { readonly origin: string; readonly within: Duration.Input }) =>
    Layer.effect(
      HomeClient,
      Effect.map(HttpClient.HttpClient, (client) =>
        HomeClient.of({
          answer: (owner, name) =>
            getHome(options.origin, { owner, name }, options.within).pipe(
              Effect.provideService(HttpClient.HttpClient, client),
            ),
        })),
    )
}
