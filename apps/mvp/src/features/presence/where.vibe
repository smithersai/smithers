import { PresenceProtocol } from "@smthrs/sync"
import { MAX_WHERE_PATH } from "./contract"
import { Where } from "./schema"

// A person's place as their room state carries it: JSON of `Where`, which the room relays and never reads
// (`PresenceProtocol`'s state, at most `maxStateBytes`). A place that can't be read is no place.

const decode = Schema.decodeUnknownOption(Schema.fromJsonString(Where))
const encoder = new TextEncoder()

/** Whether `state` fits the room's limit in UTF-8. */
const fits = (state: string) => encoder.encode(state).byteLength <= PresenceProtocol.maxStateBytes

/**
 * `where` as a room state. A code path is cut to `MAX_WHERE_PATH` characters, and further while its state would be over
 * the room's limit, as a path of wide characters can be.
 */
export const encodeWhere = (where: Where): string => {
  if (where.view === "terminal") return JSON.stringify(where)
  let path = where.path.slice(0, MAX_WHERE_PATH)
  while (!fits(JSON.stringify({ view: where.view, path }))) path = path.slice(0, -16)
  return JSON.stringify({ view: where.view, path })
}

/** The place a room state names, or `null`. */
export const decodeWhere = (state: string | null): Where | null =>
  state === null ? null : Option.getOrNull(decode(state))
