import { Collection, LiveQuery } from "@smthrs/effect-tanstack-db"
import type { PresenceSocket } from "@smthrs/sync"
import { Participant, ROOM, Room, type Where } from "./schema"

// Presence on this tab (decision 0013 §4, docs/features/branch-workspace.md#presence): everyone in the room of the
// branch the page shows, as the room last said, this tab's place in the room, and the one socket it holds there.

/** Where the room is: ChatApi's origin, the site's own. */
export interface PresenceConfig {
  readonly origin: string
}

/** Everyone in the room, in the room's order. */
export const participantsQuery = (participants: Collection.Collection<Participant, string>) =>
  LiveQuery.make((q) => q.from({ participant: participants.tanstack }).orderBy(({ participant }) => participant.order))

/** This tab's place in its room. */
export const roomQuery = (room: Collection.Collection<Room, string>) =>
  LiveQuery.make((q) => q.from({ room: room.tanstack }).findOne())

/** Presence's state for one tab. */
export class PresenceStore extends Context.Service<
  PresenceStore,
  {
    readonly origin: string
    readonly participants: Collection.Collection<Participant, string>
    readonly participantsState: Effect.Success<ReturnType<typeof participantsQuery>>
    readonly room: Collection.Collection<Room, string>
    readonly roomState: Effect.Success<ReturnType<typeof roomQuery>>
    /** The room's socket, while this tab holds one: only the latest join keeps it. */
    readonly attached: FiberHandle.FiberHandle<void, never>
    readonly connection: Ref.Ref<PresenceSocket.Connection | undefined>
    /** Where this person is on the page, sent to the room whenever it changes and on every reconnect. */
    readonly where: Ref.Ref<Where | null>
    readonly scope: Scope.Scope
  }
>()("@smthrs/mvp/presence/PresenceStore") {
  /** The store; its collections cleaned up and its socket closed when the scope closes. */
  static readonly layer = (config: PresenceConfig) =>
    Layer.effect(
      PresenceStore,
      effect {
        const participants = try Collection.local<Participant, string>({
          id: "presence-participants",
          schema: Participant,
          getKey: (row) => row.id,
        })
        const room = try Collection.local<Room, string>({
          id: "presence-room",
          schema: Room,
          getKey: (row) => row.id,
          initialData: [{ id: ROOM, branchId: null, status: "idle" }],
        })
        return PresenceStore.of({
          origin: config.origin,
          participants,
          participantsState: try participantsQuery(participants),
          room,
          roomState: try roomQuery(room),
          attached: try FiberHandle.make<void, never>(),
          connection: try Ref.make<PresenceSocket.Connection | undefined>(undefined),
          where: try Ref.make<Where | null>(null),
          scope: try Effect.scope,
        })
      },
    )
}
