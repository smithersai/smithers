import { AuthStore } from "../auth/store.vibe"

/** A route waits for sign-in's first answer before starting a member-only flow. */
export const identityReady = effect {
  const auth = try serviceOption(AuthStore)
  if (Option.isSome(auth)) {
    try auth.value.sessionState.rows.pipe(
      Stream.filter((rows) => rows.some((row) => row.status !== "loading")),
      Stream.runHead,
      asVoid,
    )
  }
}
