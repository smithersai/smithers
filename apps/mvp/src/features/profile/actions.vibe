import { put } from "../repo/actions.vibe"
import { ProfileClient, type ProfileRefused } from "./api.vibe"
import {
  isProfileOwner,
  PROFILE_NOT_FOUND,
  PROFILE_RATE_LIMITED,
  PROFILE_UNAVAILABLE,
  profileKey,
  type ProfileFilter,
  type ProfileSort,
  type ProfileTab,
} from "./contract"
import { profileLoadMs, profileOpens } from "./metrics"
import type { ProfileRow } from "./schema"
import { ProfileStore } from "./store.vibe"

/** How long a tab reuses a ready profile before re-fetching on a new navigation. */
export const TAB_FRESH_MS = 60_000

/** Maximum time `warm` waits before letting navigation continue with the skeleton/loading state. */
export const WARM_WAIT = Duration.millis(900)

export interface ProfileSearch {
  readonly tab: ProfileTab
  readonly search: string
  readonly sort: ProfileSort
  readonly filter: ProfileFilter
}

const refusalMessage = (error: ProfileRefused): string => {
  if (error.status === 404 || error.code === "not_found") return PROFILE_NOT_FOUND
  if (error.code === "rate_limited") return PROFILE_RATE_LIMITED
  return PROFILE_UNAVAILABLE
}

const upsert = (entries: ProfileStore["Service"]["entries"], row: ProfileRow) =>
  ignore(put<ProfileRow>(entries, row.key, row))

/** Fetches `owner` into `ProfileStore.entries` if not fresh (or when `force` is true). */
export const load = (owner: string, force = false): (string | undefined)!!(ProfileStore | ProfileClient) =>
  withSpan(effect {
    const store = try ProfileStore
    const client = try ProfileClient
    const key = profileKey(owner)
    const now = try Clock.currentTimeMillis
    const existing = store.entries.tanstack.get(key)

    if (!isProfileOwner(owner)) {
      try upsert(store.entries, {
        key,
        state: "missing",
        profile: null,
        message: PROFILE_NOT_FOUND,
        fetchedAt: now,
      })
      return undefined
    }

    if (!force && existing !== undefined) {
      if (existing.state === "ready" && now - existing.fetchedAt < TAB_FRESH_MS) return existing.profile?.login
      if (existing.state === "loading") return undefined
    }

    // Preserve a previously loaded profile while revalidating; only set loading when no ready data exists.
    if (existing === undefined || existing.state !== "ready") {
      try upsert(store.entries, {
        key,
        state: "loading",
        profile: null,
        message: null,
        fetchedAt: now,
      })
    }

    const startedAt = try Clock.currentTimeMillis
    const settled = try result(client.get(owner))
    const durationMs = (try Clock.currentTimeMillis) - startedAt
    const settledAt = try Clock.currentTimeMillis

    if (settled._tag === "Success") {
      try upsert(store.entries, {
        key,
        state: "ready",
        profile: settled.success,
        message: null,
        fetchedAt: settledAt,
      })
      try Metric.update(Metric.withAttributes(profileLoadMs, { outcome: "ready" }), durationMs)
      try annotateLogs(logInfo("profile.load"), { outcome: "ready", durationMs })
      return settled.success.login
    }

    const error = settled.failure
    const missing = error.status === 404 || error.code === "not_found"
    const outcome = missing ? "missing" : error.code === "rate_limited" ? "rate_limited" : "failed"
    try upsert(store.entries, {
      key,
      state: missing ? "missing" : "failed",
      profile: null,
      message: refusalMessage(error),
      fetchedAt: settledAt,
    })
    try Metric.update(Metric.withAttributes(profileLoadMs, { outcome }), durationMs)
    try annotateLogs(logWarning("profile.load"), {
      outcome,
      durationMs,
      ...(error.status === undefined ? {} : { status: error.status }),
      ...(error.code === undefined ? {} : { errorCode: error.code }),
    })
    return undefined
  }, "profile.load")

/** Warms `owner`'s profile on link hover/focus or before route open, bounded by `WARM_WAIT`. */
export const warm = (owner: string): void!!(ProfileStore | ProfileClient) =>
  timeoutOrElse(asVoid(load(owner, false)), { duration: WARM_WAIT, orElse: () => Effect.void })

/** Opens `owner`'s profile route with its URL-synced view state and loads if not fresh. */
export const open = (owner: string, search: ProfileSearch): void!!(ProfileStore | ProfileClient) =>
  withSpan(effect {
    const store = try ProfileStore
    const key = profileKey(owner)
    const previous = store.view.tanstack.get("view")
    const changedOwner = previous?.key !== key
    try ignore(store.view.update("view", (row) => {
      row.key = key
      row.owner = owner
      row.tab = search.tab
      row.search = search.search
      row.sort = search.sort
      row.filter = search.filter
    }))

    if (changedOwner) {
      try Metric.update(Metric.withAttributes(profileOpens, { tab: search.tab }), 1)
      try annotateLogs(logInfo("profile.open"), { tab: search.tab })
    }

    const existing = store.entries.tanstack.get(key)
    const now = try Clock.currentTimeMillis
    const fresh = existing?.state === "ready" && now - existing.fetchedAt < TAB_FRESH_MS
    if (!fresh && existing?.state !== "loading") {
      try FiberHandle.run(store.loader, asVoid(load(owner, false)))
    }
  }, "profile.open")

/** Retries a failed profile read for `owner`. */
export const retry = (owner: string): void!!(ProfileStore | ProfileClient) =>
  effect {
    const store = try ProfileStore
    try FiberHandle.run(store.loader, asVoid(load(owner, true)))
  }

/** Returns GitHub's canonical casing for `owner` if already loaded in this tab. */
export const knownLogin = (owner: string): (string | undefined)!!ProfileStore =>
  effect {
    const store = try ProfileStore
    const row = store.entries.tanstack.get(profileKey(owner))
    return row?.state === "ready" ? row.profile?.login : undefined
  }
