import { type Flow, FlowRuntime } from "@smthrs/flow"

// A run started from inside a step as a run of its own (docs/features/runs.md#acts): a retry, a draft's next round.
// Without the step's `FlowInstance` in its context, the engine records no parent for it, so it outlives the step's run
// (`discard`) and lists among the person's own runs. The same execution id again is a no-op, so a step run again after
// a crash starts nothing new. A start the engine refuses (a payload its schema won't encode, an id another flow holds)
// is a defect: the step's own input made it, so running the step again can't mend it.

/** Starts `flow` with `payload` as the root run `executionId`, without waiting for it. */
export const startRoot = (flow: Flow.Any, executionId: string, payload: unknown): void!! =>
  (Effect.flatMap(
    FlowRuntime.FlowRuntime,
    (runtime) => runtime.execute(flow as never, { executionId, payload: payload as never, discard: true }),
  )
    |> Effect.updateContext(%, Context.omit(FlowRuntime.FlowInstance))
    |> Effect.asVoid(%)
    |> Effect.orDie(%)) as void!!
