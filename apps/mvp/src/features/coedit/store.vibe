import { Uuid, WebCrypto } from "@smthrs/crypto"
import { ElectricCollection } from "@smthrs/effect-electric"
import { Collection, LiveQuery, Persistence } from "@smthrs/effect-tanstack-db"
import { type PresenceProtocol, PresenceSocket, SharedText } from "@smthrs/sync"
import { Context, Effect, Exit, Layer, Metric, Option, Ref, Scope, Semaphore, Stream } from "effect"
import { Base64 } from "effect/encoding"
import * as Socket from "effect/socket/Socket"
import { ConversationOwners } from "../conversations/owners"
import { scopeOf, scopeParams, TEXT_NAMESPACE, textName, type TextOf, textRoomRoute, TEXTS_SHAPE_ROUTE, type TextScope } from "./contract"
import { opens } from "./metrics"
import { savedMarkOf, savedOf } from "./saved"
import { type Collaborator, type Selection, Shared, TextUpdate } from "./schema"
import { TextWrites } from "./writes.vibe"

// The texts this tab has open (decision 0013 §4, docs/features/coedit.md#the-browser). Each is one `SharedText`
// replica, fed by the text's Electric shape (what ChatApi stored) and by the outbox's rows (what this device typed and
// hasn't sent yet), so a reload or a dropped connection loses nothing. While a text is shown, this tab is in its room:
// it says where its own caret is, and hears everyone else's. A row of `coedit-texts` is what a frontend reads of it.
//
// A branch's prompt holds what everyone typed, and a file of its working copy what the branch holds, so the row of
// either carries it only while the branch's conversation may show (`ConversationOwners.shown`, the gate its messages
// show through). The row of a text whose conversation is hidden holds no text, selection or caret, from the turn the
// conversation is hidden: a read ChatApi refused hides the prompt and the open file with the transcript, before the
// session is read again, and they return when the conversation does. A hidden file's row is `loading`, so no editor
// is mounted on it: nothing of the file is drawn, and nothing typed into an emptied editor replaces what it holds.

/** Where texts sync from: ChatApi's origin, for the text routes, the shapes and the rooms. */
export interface CoeditConfig {
  readonly origin: string
}

/** Everyone in a text's room as it last said, and which connection is this tab's. */
interface Roster {
  readonly self: string | undefined
  readonly participants: ReadonlyArray<PresenceProtocol.Participant>
}

/** This tab's selection in a text, as anchors that follow the text through everyone's edits. */
interface Mine {
  readonly anchor: Uint8Array
  readonly head: Uint8Array
}

/** A shown text's room: the scope that closes its socket, and the connection. */
interface Room {
  readonly scope: Scope.Closeable
  readonly connection: PresenceSocket.Connection
}

/** One open text: its replica, its synced updates, and, while it is shown, its room. */
export interface Live {
  readonly id: string
  readonly of: TextOf
  readonly scope: TextScope
  readonly replica: SharedText.SharedText
  readonly updates: ElectricCollection.ElectricCollection<TextUpdate>
  readonly mine: Ref.Ref<Mine | undefined>
  readonly roster: Ref.Ref<Roster>
  /** The room, while the text is shown. */
  readonly room: Ref.Ref<Room | undefined>
  /** Updates this tab made that the outbox didn't take (another tab led it): they go with the next one. */
  readonly unsent: Ref.Ref<ReadonlyArray<Uint8Array>>
  /** Updates the outbox took and is still storing. */
  readonly admitting: Ref.Ref<number>
}

/** Every open text, as frontends read it. */
export const textsQuery = (texts: Collection.Collection<Shared, string>) =>
  LiveQuery.make((q) => q.from({ text: texts.tanstack }))

/** A text's id: the version 5 UUID of what it is, the same on every device. */
export const textIdOf = effect (of: TextOf) => {
  const name = try Effect.sync(() => textName(of))
  return try Uuid.v5(TEXT_NAMESPACE, name).pipe(Effect.provide(WebCrypto.layer), Effect.orDie)
}

/** The key a text's row carries: the conversation, `<conversation>/<path>` for a file, or `<run>/<version>`. */
export const keyOf = (of: TextOf) =>
  of.kind === "prompt" ? of.conversation : of.kind === "file" ? `${of.conversation}/${of.path}` : `${of.run}/${of.version}`

export { SAVED_MARK, savedMarkOf, savedNameOf } from "./saved"

/** Whether `text` is what the `saved` mark `mark` says a Save wrote. */
const isSaved = (mark: string | undefined, text: string): boolean =>
  mark !== undefined && mark.startsWith(`${text.length}:`) && mark === savedMarkOf(text)

/** A cursor as a room state: the anchors, as base64. */
export const encodeCursor = (mine: Mine): string =>
  JSON.stringify({ a: Base64.encode(mine.anchor), h: Base64.encode(mine.head) })

/** A room state's anchors, or `undefined` for a state that isn't a cursor. */
export const decodeCursor = (state: string | null): Mine | undefined => {
  if (state === null) return undefined
  try {
    const { a, h } = JSON.parse(state) as { readonly a?: unknown; readonly h?: unknown }
    if (typeof a !== "string" || typeof h !== "string") return undefined
    const anchor = Base64.decode(a)
    const head = Base64.decode(h)
    return anchor._tag === "Success" && head._tag === "Success" ? { anchor: anchor.success, head: head.success } : undefined
    // expected: a room state that is not JSON is no cursor
  } catch {
    return undefined
  }
}

/** Co-editing's state for one tab. */
export class CoeditStore extends Context.Service<
  CoeditStore,
  {
    readonly texts: Collection.Collection<Shared, string>
    readonly textsState: Effect.Success<ReturnType<typeof textsQuery>>
    /** Opens `of`, unless it is open: its replica and updates are kept for as long as the store lives. */
    readonly open: (of: TextOf) => Effect.Effect<Live>
    /** An open text, by id. */
    readonly live: (textId: string) => Live | undefined
    /** Joins an open text's room, unless this tab is in it. */
    readonly show: (live: Live) => Effect.Effect<void>
    /** Leaves an open text's room: nobody sees this tab's caret there, and it sees nobody's. */
    readonly hide: (live: Live) => Effect.Effect<void>
    /** Brings an open text's row up to date: its text, this person's selection and everyone else's carets. */
    readonly refresh: (live: Live) => Effect.Effect<void>
    /**
     * Whether `live`'s row may carry its text now: always for a run's answer box, which is the person's own; a
     * branch's prompt or file only while the branch's conversation may show.
     */
    readonly readable: (live: Live) => boolean
    /**
     * Calls `listener` with each open prompt whose conversation was hidden (`readable` false), in the turn it is and
     * after its row was emptied, or may show again (`readable` true), before its row is brought up to date; until the
     * scope closes.
     */
    readonly onReadable: (listener: (live: Live, readable: boolean) => void) => Effect.Effect<void, never, Scope.Scope>
    /** Where background work an action starts runs. */
    readonly scope: Scope.Scope
  }
>()("@smthrs/mvp/coedit/CoeditStore") {
  /** The store over the outbox's text writes; its texts and rooms close with its scope. */
  static readonly layer = (config: CoeditConfig) => Layer.effect(CoeditStore, make(config))
}

const make = effect (config: CoeditConfig) => {
  const scope = try Effect.scope
  const persistence = try Persistence.Persistence
  const { sending } = try TextWrites
  const texts = try Collection.local<Shared, string>({ id: "coedit-texts", schema: Shared, getKey: (row) => row.id })
  const lives = new Map<string, Live>()
  // The conversations that may show now, as the owners' gate says in the turn it changes.
  const owners = (try ConversationOwners).shown
  const shown = new Set<string>()
  const readable = (live: Live) => live.of.kind === "answer" || shown.has(live.of.conversation)
  // The files whose content has arrived and whose row does not say `ready`: their conversation is hidden.
  const veiled = new Set<string>()
  const listeners = new Set<(live: Live, readable: boolean) => void>()
  const runFork = Effect.runForkWith(try Effect.context<never>())
  // One open at a time, so two asks for one text open it once.
  const opening = try Semaphore.make(1)
  const roomOrigin = config.origin.replace(/^http/, "ws")
  // The page's own WebSocket, unless a test gives another.
  const sockets = Option.match(try Effect.serviceOption(Socket.WebSocketConstructor), {
    onNone: () => Socket.layerWebSocketConstructorGlobal,
    onSome: (construct) => Layer.succeed(Socket.WebSocketConstructor, construct),
  })

  /** Where `cursor` is in `live`'s text now, or none before the text it points into has arrived. */
  const placeOf = (live: Live, cursor: Mine) =>
    effect {
      const anchor = try live.replica.resolve(cursor.anchor)
      const head = try live.replica.resolve(cursor.head)
      return anchor === undefined || head === undefined ? Option.none<Selection>() : Option.some({ anchor, head })
    }

  /** Makes `live`'s row carry `next`, when it does not. */
  const write = (live: Live, next: Pick<Shared, "text" | "saved" | "selection" | "collaborators">) => {
    const row = texts.tanstack.get(live.id)!
    const same = row.text === next.text && row.saved === next.saved && JSON.stringify(row.selection) === JSON.stringify(next.selection) &&
      JSON.stringify(row.collaborators) === JSON.stringify(next.collaborators)
    if (!same) texts.tanstack.update(live.id, (draft) => void Object.assign(draft, next))
  }

  const refresh = (live: Live) =>
    effect {
      const text = try live.replica.text
      const mine = try Ref.get(live.mine)
      const selection = mine === undefined ? null : Option.getOrNull(try placeOf(live, mine))
      const { self, participants } = try Ref.get(live.roster)
      const collaborators: Array<Collaborator> = []
      for (const participant of participants) {
        const cursor = participant.id === self ? undefined : decodeCursor(participant.state)
        const at = cursor === undefined ? Option.none<Selection>() : try placeOf(live, cursor)
        if (Option.isSome(at)) collaborators.push({ id: participant.id, name: participant.name, ...at.value })
      }
      // Whoever saved, every tab reads it from the newest write's mark; a text changed since, by anyone, isn't saved.
      const marks = try live.replica.marks
      const saved = isSaved((try Effect.sync(() => savedOf(marks))).value, text)
      // Decided and written in one turn: a conversation hidden while this read the replica gets none of what it read.
      try Effect.sync(() => {
        if (!readable(live)) return
        write(live, { text, saved, selection, collaborators })
        // A file whose content arrived, or stayed, while its conversation was hidden is ready with the text it now has.
        if (veiled.delete(live.id)) texts.tanstack.update(live.id, (draft) => void (draft.status = "ready"))
      })
    }

  // Each change to which conversations may show, in its turn: a hidden conversation's prompt and files are emptied
  // before anything else runs, and one that may show again is read from its replica.
  try Effect.acquireRelease(
    Effect.sync(() => owners.tanstack.subscribeChanges((changes) => {
      for (const change of changes) {
        const conversation = String(change.key)
        const allowed = change.type !== "delete"
        if (allowed) shown.add(conversation)
        else shown.delete(conversation)
        for (const live of lives.values()) {
          if (live.of.kind === "answer" || live.of.conversation !== conversation) continue
          if (!allowed) {
            write(live, { text: "", saved: false, selection: null, collaborators: [] })
            // A file that was ready is loading again: its editor goes, and comes back with the conversation.
            if (texts.tanstack.get(live.id)!.status === "ready" && live.of.kind === "file") {
              veiled.add(live.id)
              texts.tanstack.update(live.id, (draft) => void (draft.status = "loading"))
            }
          }
          if (live.of.kind === "prompt") for (const listener of listeners) listener(live, allowed)
          if (allowed) runFork(refresh(live).pipe(Effect.forkIn(scope)))
        }
      }
    }, { includeInitialState: true })),
    (subscription) => Effect.sync(() => subscription.unsubscribe()),
  )

  /** Applies one stored or queued update; bytes that aren't one are logged and skipped. */
  const apply = (live: Live, data: string) =>
    effect {
      const bytes = Base64.decode(data)
      const applied = bytes._tag === "Success" ? try Effect.exit(live.replica.apply(bytes.success)) : Exit.void
      if (bytes._tag === "Failure" || Exit.isFailure(applied)) {
        try Effect.logWarning("coedit.apply").pipe(Effect.annotateLogs({ outcome: "invalid", textId: live.id }))
      }
    }

  const open = (of: TextOf) =>
    effect {
      const id = try textIdOf(of)
      const known = lives.get(id)
      if (known !== undefined) return known
      const textScope = try Effect.sync(() => scopeOf(of))
      const query = try Effect.sync(() => new URLSearchParams({ text: id, ...scopeParams(textScope) }).toString())
      const replica = try SharedText.make
      const updates = try ElectricCollection.make<TextUpdate>({
        id: `text-updates:${id}`,
        schema: TextUpdate,
        getKey: (row) => row.id,
        syncMode: "eager",
        persist: { schemaVersion: 1 },
        shape: { url: `${config.origin}${TEXTS_SHAPE_ROUTE}?${query}` },
      })
      const live: Live = {
        id,
        of,
        scope: textScope,
        replica,
        updates,
        mine: try Ref.make<Mine | undefined>(undefined),
        roster: try Ref.make<Roster>({ self: undefined, participants: [] }),
        room: try Ref.make<Room | undefined>(undefined),
        unsent: try Ref.make<ReadonlyArray<Uint8Array>>([]),
        admitting: try Ref.make(0),
      }
      try Effect.orDie(texts.insert({
        id,
        kind: of.kind,
        key: keyOf(of),
        // A file is loading until its first content arrives (actions.ts); a prompt or an answer starts empty.
        status: of.kind === "file" ? "loading" : "ready",
        shown: false,
        stored: true,
        failure: null,
        text: "",
        selection: null,
        collaborators: [],
        saving: false,
        saveFailed: false,
        saved: false,
      }))
      // Known once its row is: whoever finds it open finds its row.
      lives.set(id, live)
      // What ChatApi stored, then what this device typed and the outbox still holds. A file's first content comes only
      // from ChatApi, so every device starts it from the same seed.
      try updates.changes({ initial: true }).pipe(
        Stream.runForEach((changes) =>
          effect {
            for (const change of changes) if (change.type === "insert") try apply(live, change.value.data)
            // A file is ready once its content arrived and its row carries it: with this refresh, or, for a file
            // whose conversation is hidden, with the one that shows it again.
            if (of.kind === "file" && changes.some((change) => change.type === "insert")) veiled.add(id)
            try refresh(live)
          }
        ),
        Effect.forkIn(scope),
      )
      try sending.changes({ initial: true }).pipe(
        Stream.runForEach((changes) =>
          effect {
            const mineToApply = changes.filter((change) =>
              change.type === "insert" && change.value.textId === id && !change.value.seed
            )
            for (const change of mineToApply) try apply(live, change.value.data)
            if (mineToApply.length > 0) try refresh(live)
          }
        ),
        Effect.forkIn(scope),
      )
      try Effect.logInfo("coedit.open").pipe(Effect.annotateLogs({ kind: of.kind, textId: id }))
      try Metric.update(Metric.withAttributes(opens, { kind: of.kind }), 1)
      return live
    }.pipe(
      opening.withPermits(1),
      Effect.provideService(Scope.Scope, scope),
      Effect.provideService(Persistence.Persistence, persistence),
      Effect.annotateLogs({ feature: "coedit" }),
    )

  const show = (live: Live) =>
    effect {
      if ((try Ref.get(live.room)) !== undefined) return
      const roomScope = try Scope.fork(scope)
      const url = try Effect.sync(() => `${roomOrigin}${textRoomRoute(live.id)}?${new URLSearchParams(scopeParams(live.scope)).toString()}`)
      const connection = try PresenceSocket.connect(url).pipe(
        Effect.provide(sockets),
        Effect.provideService(Scope.Scope, roomScope),
      )
      try Ref.set(live.room, { scope: roomScope, connection })
      try Effect.orDie(texts.update(live.id, (draft) => void (draft.shown = true)))
      const mine = try Ref.get(live.mine)
      if (mine !== undefined) try connection.set(encodeCursor(mine))
      try connection.roster.pipe(
        Stream.runForEach((participants) =>
          Effect.andThen(Ref.update(live.roster, (roster) => ({ ...roster, participants })), refresh(live))
        ),
        Effect.forkIn(roomScope),
      )
      try connection.status.pipe(
        Stream.runForEach((status) =>
          status._tag === "Open"
            ? Effect.andThen(Ref.update(live.roster, (roster) => ({ ...roster, self: status.self })), refresh(live))
            : Effect.void
        ),
        Effect.forkIn(roomScope),
      )
    }

  const hide = (live: Live) =>
    effect {
      const room = try Ref.getAndSet(live.room, undefined)
      if (room === undefined) return
      try Scope.close(room.scope, Exit.void)
      try Effect.orDie(texts.update(live.id, (draft) => void (draft.shown = false)))
      try Ref.set(live.roster, { self: undefined, participants: [] })
      try refresh(live)
    }

  return CoeditStore.of({
    texts,
    textsState: try textsQuery(texts),
    open,
    live: (textId) => lives.get(textId),
    show,
    hide,
    refresh,
    readable,
    onReadable: (listener) =>
      Effect.acquireRelease(Effect.sync(() => void listeners.add(listener)), () => Effect.sync(() => void listeners.delete(listener))),
    scope,
  })
}
