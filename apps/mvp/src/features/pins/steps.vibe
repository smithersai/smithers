import { FlowRuntime, Interpreter } from "@smthrs/flow"
import { PinClient } from "#vibelang/emitted/src/features/pins/api"
import { requesterOf } from "../../flows/requests"
import { ChatPin, ChatUnpin, Pinned, PinRefused, PinUnavailable, PinStamp, PinWrite, UnpinWrite } from "./flows"

export const pins = Metric.counter("smithers_message_pins", { incremental: true })
export const stamp = (within: Duration.Input = "15 seconds") => (p: typeof PinStamp.payloadSchema.Type) =>
  effect {
    if (p.at !== undefined) return { ...p, at: p.at }
    const { executionId } = try FlowRuntime.FlowInstance
    const requester = requesterOf(executionId)
    const response = try (try PinClient).post(
      { ...p, ...(requester === executionId ? {} : { answerId: requester }) },
      true,
    ).pipe(Effect.mapError(() => new PinUnavailable()))
    if (
      response.status >= 400 && response.status < 500 && response.status !== 408 && response.status !== 425
      && response.status !== 429
    ) throw new PinRefused({ status: response.status })
    if (response.status !== 200) throw new PinUnavailable()
    return try response.json.pipe(
      Effect.flatMap(Schema.decodeUnknownEffect(PinStamp.successSchema)),
      Effect.mapError(() => new PinUnavailable()),
    )
  }.pipe(Effect.timeoutOrElse({ duration: within, orElse: () => Effect.fail(new PinUnavailable()) }))

/** A request, under one deadline; the flow engine owns retry and resumption. */
export const writePin =
  (unpin: boolean, within: Duration.Input = "15 seconds") =>
  (
    p: {
      readonly conversationId?: string | undefined
      readonly messageId?: string | undefined
      readonly at: number
      readonly awaitAdmission?: boolean | undefined
      readonly questionAnswerId?: string | undefined
    },
  ) =>
    effect {
      const { executionId } = try FlowRuntime.FlowInstance
      const requester = requesterOf(executionId)
      const response = (try PinClient).post({
        ...p,
        ...(requester === executionId ? {} : { answerId: requester }),
        ...(unpin ? { messageId: null } : {}),
      }, false) catch effect (error) => {
        try Effect.logWarning("chat.pin").pipe(
          Effect.annotateLogs({
            outcome: "unavailable",
            errorCode: /^run credential [a-z_0-9]+$/.test(error.reason.description ?? "")
              ? error.reason.description
              : error.reason._tag,
            feature: "pins",
          }),
        )
        throw new PinUnavailable()
      }
      const outcome = response.status === 200 ? "saved" : "refused"
      try Metric.update(Metric.withAttributes(pins, { outcome }), 1)
      try Effect.logInfo("chat.pin").pipe(Effect.annotateLogs({ outcome, status: response.status, feature: "pins" }))
      if (
        response.status >= 400 && response.status < 500 && response.status !== 408 && response.status !== 425
        && response.status !== 429
      ) throw new PinRefused({ status: response.status })
      if (response.status !== 200) throw new PinUnavailable()
      return try response.json.pipe(
        Effect.flatMap(Schema.decodeUnknownEffect(Pinned)),
        Effect.mapError(() => new PinUnavailable()),
      )
    }.pipe(
      Effect.timeoutOrElse({ duration: within, orElse: () => Effect.fail(new PinUnavailable()) }),
      Effect.withSpan("chat.pin.post"),
    )

export const registrationAt = (origin: string) =>
  Layer.mergeAll(
    Interpreter.layerWithImplementations(
      ChatPin,
      Layer.merge(PinStamp.toLayer(stamp()), PinWrite.toLayer(writePin(false))),
    ),
    Interpreter.layerWithImplementations(
      ChatUnpin,
      Layer.merge(PinStamp.toLayer(stamp()), UnpinWrite.toLayer(writePin(true))),
    ),
  ).pipe(Layer.provide(PinClient.layer(origin)))
