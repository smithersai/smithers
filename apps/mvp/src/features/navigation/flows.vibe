import { Action, Flow, FlowRuntime, Interpreter } from "@smthrs/flow"
import { Node, Placement } from "@smthrs/plan"
import { asker } from "../../flows/askingTab"
import type { Door } from "../../flows/dispatch"
import { requesterOf } from "../../flows/requests"
import { NAVIGATE_WITHIN, navigationChannel, type Outcome } from "./contract"
import { navigations } from "./metrics"
import { appPath } from "./paths"
import { Moved, Navigated, Reason, To } from "./schema"

// `app/navigate { to }` (docs/features/flows.md#navigation): takes the tab that asked to a page of the app. A person's
// door and the agent's cell run this one declaration. Its one step runs in the leader tab's engine worker, so it asks
// over the engine's navigation channel for the tab that started the request (`Tabs`, src/flows/askingTab.ts): the tab
// whose door dispatched it, or, for the agent's call, the tab whose composer asked. Only that tab moves, through the
// router. A tab that is gone settles the step without moving any other. Only this app's own paths are taken: an agent
// must never send a person to an outside site (src/features/navigation/paths.ts).

/** `to` is no path of this app: another origin, another scheme, or not a URL. Never the target itself. */
export class NavigationRefused extends Schema.TaggedError<NavigationRefused>()(
  "@smthrs/mvp/navigation/NavigationRefused",
  { reason: Reason },
) {}

/** A tab's answer to the step: the door it started the request through, and whether it moved. */
export interface Reply {
  readonly door: Door
  readonly moved: boolean
}

/** The tabs of this browser as the step reaches them: only the tab that started a request answers for it. */
export class Tabs extends Context.Service<
  Tabs,
  {
    /** The app's origin: a full URL must be on it. */
    readonly origin: string
    /**
     * Asks the tab that started `requester` to go to `path`, or, without one, to stay. Answers with its reply, or none
     * when no tab answered within the wait: the tab that asked is gone.
     */
    readonly ask: (call: { readonly requester: string; readonly path?: string }) => Option.Option<Reply>!!
  }
>()("@smthrs/mvp/navigation/Tabs") {
  /**
   * Over the navigation channel of engine `name` (`TabChannel`), for the app on `origin`, waiting `within`
   * (`NAVIGATE_WITHIN` unless set) for the tab's reply.
   */
  static readonly layerChannel = (options: {
    readonly name: string
    readonly origin: string
    readonly within?: Duration.Input
  }) =>
    Layer.effect(
      Tabs,
      effect {
        const ask = try asker<{ readonly path?: string }, typeof Moved>({
          channel: navigationChannel(options.name),
          output: Moved,
          within: options.within ?? NAVIGATE_WITHIN,
        })
        return Tabs.of({
          origin: options.origin,
          ask: ({ requester, path }) =>
            ask(requester, path === undefined ? {} : { path }).pipe(
              Effect.map(Option.map(({ door, output }) => ({ door, moved: output.moved }))),
            ),
        })
      },
    )
}

/** The step: ask the tab that asked to go. */
export const GoTo = Action.make("app/navigate/go", {
  payload: { to: To },
  success: Navigated,
  error: NavigationRefused,
})

/** `app/navigate`: takes the tab that asked to a page of the app. */
export const Navigate = Flow.make("app/navigate", {
  description: "Open a page of this app in the person's tab. `to` is the app path: /<owner>/<repo> for a "
    + "repository, /<owner>/<repo>/tree/<ref>/<dir> for a directory, /<owner>/<repo>/blob/<ref>/<file> for a file, "
    + "and ?L=12 after a file for line 12 or ?L=10-20 for lines 10 to 20. <ref> is a branch or a commit SHA. A "
    + "github.com URL's path is the same path here. When the person names the page, go straight there: opening a page "
    + "never needs a clone or a read first, since the page offers what it lacks. Only this app's paths: "
    + "another site, javascript: or data: is refused (NavigationRefused). Answers { path, moved }; moved is false "
    + "when the tab that asked has closed.",
  modelInvocable: true,
  payload: { to: To },
  success: Navigated,
  error: NavigationRefused,
  body: Node.capture({ action: GoTo.name }, (payload) => GoTo.call(payload)),
}).annotate(Flow.Placement, Placement.client())

/**
 * What `app/navigate/go` does: `to` as an app path on the host's origin (`appPath`), asked of the tab that started
 * the run (`requesterOf` its execution), which moves only for a path. Records the navigation as a span `web.navigate`,
 * a log line and a count of `navigations` by door and outcome, never the path. A refused target fails
 * `NavigationRefused`; a tab that is gone, or that didn't move, answers `moved: false`.
 */
export const goTo = ({ to }: { readonly to: string }) =>
  effect {
    const startedAt = try Clock.currentTimeMillis
    const { executionId } = try FlowRuntime.FlowInstance
    const tabs = try Tabs
    const target = appPath(to, tabs.origin)
    const requester = requesterOf(executionId)
    const reply = try tabs.ask({ requester, ...(target._tag === "Path" ? { path: target.path } : {}) })
    // The agent's call belongs to the answer its tab asked for; a tab's own dispatch names its door in its reply.
    const door: Door | "unknown" = executionId !== requester
      ? "agent"
      : Option.match(reply, { onNone: () => "unknown" as const, onSome: (answered) => answered.door })
    const outcome: Outcome = target._tag === "Refused"
      ? "refused"
      : Option.isNone(reply)
      ? "gone"
      : reply.value.moved
      ? "navigated"
      : "failed"
    try Metric.update(Metric.withAttributes(navigations, { door, outcome }), 1)
    try Effect.annotateCurrentSpan({ "smithers.navigation.door": door, "smithers.navigation.outcome": outcome })
    const durationMs = (try Clock.currentTimeMillis) - startedAt
    try Effect.logWithLevel(outcome === "refused" ? "Warn" : outcome === "failed" ? "Error" : "Info")("web.navigate")
      .pipe(
        Effect.annotateLogs({
          door,
          outcome,
          executionId,
          durationMs,
          ...(target._tag === "Refused" ? { reason: target.reason } : {}),
        }),
      )
    if (target._tag === "Refused") throw new NavigationRefused({ reason: target.reason })
    return { path: target.path, moved: outcome === "navigated" }
  }.pipe(Effect.withSpan("web.navigate"))

/** Registers `app/navigate` with its step, reaching the tabs through the host's `Tabs`. */
export const registration = Interpreter.layerWithImplementations(Navigate, GoTo.toLayer(goTo))
