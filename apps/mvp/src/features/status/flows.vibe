import { Action, DurableDeferred, Flow, FlowRuntime, HumanTask, Interpreter, RetryPolicy } from "@smthrs/flow"
import { Node, Placement } from "@smthrs/plan"
import { RunsClient } from "./api"
import { ASK_TASK, ASK_WITHIN_MS, MAX_OPTION_LENGTH, MAX_OPTIONS, MAX_PROMPT_LENGTH } from "./contract"
import { RunReporter } from "./reporter"
import { AnswerValue, Decision, NeedKind } from "./schema"

// Needs you, as flows (decision 0015 §3 and §4, docs/features/agent-status.md#flows):
//
//   app/agent/ask { kind, prompt, options? }       the agent's call, a child of its answer's run
//     app/agent/ask/request ─ reports needs_you with the question, and states the human task
//     HumanTask (system/human-task) ─ parks until answered, or ASK_WITHIN_MS
//     app/agent/ask/answer  ─ reports working, and reads the answer back to the agent
//
//   run/answer { runId, version, execution, value }   the person's Answer (toast, card, header)
//     run/answer/record ─ POST /api/runs/<runId>/answer: the first answer settles the question
//     run/deliver/answer ─ HumanTask.answer on this device's engine; a run another device holds isn't here
//
//   run/deliver { execution, value }           this device delivers an answer recorded elsewhere to the run it holds
//
// The question is a durable wait, so closing the tab keeps it and the next tab parks on it again. What the steps do is
// injected by the host (`registration`), so the same flows run in the browser's engine worker and on the Node host.

/** The question, as the agent asks it. */
const NeedFields = {
  kind: NeedKind,
  prompt: Schema.Trim.check(Schema.isBetweenLength(1, MAX_PROMPT_LENGTH)),
  options: Schema.optional(
    Schema.Array(Schema.Trim.check(Schema.isBetweenLength(1, MAX_OPTION_LENGTH))).check(
      Schema.isMaxLength(MAX_OPTIONS),
    ),
  ),
}

/**
 * What `app/agent/ask` answers: whether the person answered in time, and their words or their decision, with their
 * note when they wrote one.
 */
export const AskOutcome = Schema.Struct({
  answered: Schema.Boolean,
  answer: Schema.optional(Schema.String),
  approved: Schema.optional(Schema.Boolean),
  note: Schema.optional(Schema.String),
})
export type AskOutcome = typeof AskOutcome.Type

/**
 * The human task `app/agent/ask` parks on, asked once: an answer in words (`ask`), or for an approval a decision, alone
 * or with a note (`json`: the runs route and `AnswerValue` hold its shape).
 */
export const HumanRequest = Schema.Struct({
  kind: Schema.Literals(["ask", "json"]),
  prompt: Schema.String,
  timeoutMs: Schema.Number,
  maxAttempts: Schema.Number,
})

/** The runs route refused the question (`status`, a 4xx): it can't be shown, so it isn't asked. */
export class QuestionRefused extends Schema.TaggedError<QuestionRefused>()("@smthrs/mvp/status/QuestionRefused", {
  status: Schema.Number,
}) {}

/** The runs route couldn't be reached, or failed: tried again. Its client's span has the HTTP status. */
export class QuestionUnshown extends Schema.TaggedError<QuestionUnshown>()("@smthrs/mvp/status/QuestionUnshown", {}) {}

/** The question was answered, closed or replaced before this answer arrived (`409 not_open`). */
export class AnswerNotOpen extends Schema.TaggedError<AnswerNotOpen>()("@smthrs/mvp/status/AnswerNotOpen", {}) {}

/** The runs route refused the answer (`status`, a 4xx): it can't be recorded. */
export class AnswerRefused extends Schema.TaggedError<AnswerRefused>()("@smthrs/mvp/status/AnswerRefused", {
  status: Schema.Number,
}) {}

/** The runs route couldn't be reached, or failed: tried again. Its client's span has the HTTP status. */
export class AnswerUnrecorded
  extends Schema.TaggedError<AnswerUnrecorded>()("@smthrs/mvp/status/AnswerUnrecorded", {})
{}

/** The run holds the question but hasn't parked on it yet, as while the next tab wakes it: tried again. */
export class NotWaitingYet extends Schema.TaggedError<NotWaitingYet>()("@smthrs/mvp/status/NotWaitingYet", {}) {}

/**
 * Whether a status is a refusal: a 4xx, final, never tried again; but 408 (the request timed out) and 429 (too many
 * requests), which say to try again later.
 */
export const isRefusal = (status: number | undefined): status is number =>
  status !== undefined && status >= 400 && status < 500 && status !== 408 && status !== 429

/** The question is tried for a minute, then the agent hears it wasn't answered; a refusal is final. */
export const QUESTION_RETRY = RetryPolicy.make({
  initialMs: 500,
  factor: 2,
  maxMs: 8_000,
  expirationMs: 60_000,
  nonRetryable: ["@smthrs/mvp/status/QuestionRefused"],
})

/** An answer is tried for ten minutes, the question's own limit; a refusal or a closed question is final. */
export const ANSWER_RETRY = RetryPolicy.make({
  initialMs: 500,
  factor: 2,
  maxMs: 8_000,
  expirationMs: ASK_WITHIN_MS,
  nonRetryable: ["@smthrs/mvp/status/AnswerNotOpen", "@smthrs/mvp/status/AnswerRefused"],
})

/** A delivery waits up to two minutes for a run that is waking to park on its question again. */
export const DELIVER_RETRY = RetryPolicy.make({ initialMs: 250, factor: 2, maxMs: 4_000, expirationMs: 2 * 60_000 })

/** Reports the question on the run's row, then states the human task that waits for its answer. */
export const AskRequest = Action.make("app/agent/ask/request", {
  payload: NeedFields,
  success: HumanRequest,
  error: Schema.Union([QuestionRefused, QuestionUnshown]),
  tier: "sealed",
  retryPolicy: QUESTION_RETRY,
})

/** Reports the run working again, and reads the answer back for the agent: `null` when nobody answered in time. */
export const AskAnswer = Action.make("app/agent/ask/answer", {
  payload: { kind: NeedKind, value: Schema.NullOr(AnswerValue) },
  success: AskOutcome,
  tier: "sealed",
})

const isAnswer = Schema.is(AnswerValue)
const isDecision = Schema.is(Decision)

/** The human task's answer as the agent reads it: the words, or the decision with or without a note; else no answer. */
export const answerOf = (value: unknown): AnswerValue | null => (isAnswer(value) ? value : null)

/** `app/agent/ask`: the agent asks the person who asked it, and waits for the answer. */
export const Ask = Flow.make("app/agent/ask", {
  description:
    "Ask the person a question, or for their approval, and wait for their answer. Use it only when you can't go on "
    + "without their decision. kind \"question\" takes their words or one of options; kind \"approval\" takes Approve "
    + "or Deny. Answers { answered, answer } or { answered, approved, note? }, note when they wrote one; answered is "
    + "false when nobody answered within 10 minutes.",
  modelInvocable: true,
  payload: NeedFields,
  success: AskOutcome,
  body: Node.capture(
    { request: AskRequest.name, answer: AskAnswer.name, task: ASK_TASK },
    ({ kind, prompt, options }) =>
      AskRequest.call({ kind, prompt, options }).pipe(
        Node.bindPlanned(Node.capture({ task: ASK_TASK }, (request) =>
          HumanTask.action.call({
            name: ASK_TASK,
            kind: request.kind,
            prompt: request.prompt,
            timeoutMs: request.timeoutMs,
            maxAttempts: request.maxAttempts,
          }).pipe(Node.map(Node.capture({ answer: "words or yes/no" }, answerOf))))),
        // Unshown, or nobody answered in time: the agent hears it wasn't answered.
        Node.catch({ onFailure: Node.capture({ value: null }, () => Node.succeed<AnswerValue | null>(null)) }),
        Node.bindPlanned(Node.capture({ answer: AskAnswer.name }, (value) => AskAnswer.call({ kind, value }))),
      ),
  ),
}).annotate(Flow.Placement, Placement.client())

/** Records the person's answer on the run's row. */
export const RecordAnswer = Action.make("run/answer/record", {
  payload: { runId: Schema.String, version: Schema.Int, value: AnswerValue },
  success: Schema.Struct({ recorded: Schema.Boolean }),
  error: Schema.Union([AnswerNotOpen, AnswerRefused, AnswerUnrecorded]),
  tier: "sealed",
  retryPolicy: ANSWER_RETRY,
})

/**
 * Gives a recorded answer to the run waiting for it on this device: `delivered` is false when this device holds no such
 * run, or its question already closed.
 */
export const DeliverAnswer = Action.make("run/deliver/answer", {
  payload: { execution: Schema.String, value: AnswerValue },
  success: Schema.Struct({ delivered: Schema.Boolean }),
  error: NotWaitingYet,
  tier: "sealed",
  retryPolicy: DELIVER_RETRY,
})

/** `run/answer`: the person's Answer, from the card, the toast or the header. */
export const AnswerRun = Flow.make("run/answer", {
  description: "Answer the question the agent asked in a run.",
  modelInvocable: false,
  payload: { runId: Schema.String, version: Schema.Int, execution: Schema.String, value: AnswerValue },
  success: Schema.Struct({ delivered: Schema.Boolean }),
  error: Schema.Union([AnswerNotOpen, AnswerRefused, AnswerUnrecorded, NotWaitingYet]),
  body: Node.capture(
    { record: RecordAnswer.name, deliver: DeliverAnswer.name },
    ({ runId, version, execution, value }) =>
      RecordAnswer.call({ runId, version, value }).pipe(Node.andThen(DeliverAnswer.call({ execution, value }))),
  ),
}).annotate(Flow.Placement, Placement.client())

/** `run/deliver`: an answer recorded on another device, delivered to the run this device holds. */
export const Deliver = Flow.make("run/deliver", {
  description: "Deliver a recorded answer to the run waiting for it on this device.",
  modelInvocable: false,
  payload: { execution: Schema.String, value: AnswerValue },
  success: Schema.Struct({ delivered: Schema.Boolean }),
  error: NotWaitingYet,
  body: Node.capture(
    { deliver: DeliverAnswer.name },
    ({ execution, value }) => DeliverAnswer.call({ execution, value }),
  ),
}).annotate(Flow.Placement, Placement.client())

/**
 * Answers given and delivered, by `outcome`: recorded (`recorded`, `not_open`, `refused`, `unrecorded`) and delivered
 * (`delivered`, `not_here`, `closed`).
 */
export const answers = Metric.counter("smithers_agent_status_answers", {
  description: "Answers to the agent's questions, by outcome",
  incremental: true,
})

/** The wait point an `app/agent/ask` execution parks on: the human task's first and only attempt. */
export const tokenOf = (execution: string) =>
  DurableDeferred.tokenFromExecutionId(HumanTask.deferred(ASK_TASK, 1), { flow: Ask, executionId: execution })

/** `app/agent/ask/request`: reports the question, then states the human task. */
const request = (
  need: { readonly kind: NeedKind; readonly prompt: string; readonly options?: ReadonlyArray<string> },
) =>
  effect {
    const instance = try FlowRuntime.FlowInstance
    try (try RunReporter).reportOrFail(instance.executionId, {
      status: "needs_you",
      wait: { execution: instance.executionId, kind: need.kind, prompt: need.prompt, options: need.options ?? [] },
    }).pipe(
      Effect.mapError((error) =>
        isRefusal(error.status)
          ? new QuestionRefused({ status: error.status })
          : new QuestionUnshown()
      ),
    )
    return {
      kind: need.kind === "approval" ? "json" as const : "ask" as const,
      prompt: need.prompt,
      timeoutMs: ASK_WITHIN_MS,
      maxAttempts: 1,
    }
  }

/** `app/agent/ask/answer`: reports the run working again, and reads the answer back. */
const answer = (input: { readonly kind: NeedKind; readonly value: AnswerValue | null }) =>
  effect {
    const instance = try FlowRuntime.FlowInstance
    try (try RunReporter).report(instance.executionId, { status: "working" })
    const { kind, value } = input
    if (kind === "approval") {
      if (typeof value === "boolean") return { answered: true, approved: value }
      if (!isDecision(value)) return { answered: false }
      const note = value.note.trim()
      return note === ""
        ? { answered: true, approved: value.approved }
        : { answered: true, approved: value.approved, note }
    }
    return typeof value === "string" ? { answered: true, answer: value } : { answered: false }
  }

/** `run/answer/record`: records the answer; a question no longer open is final. */
const record = (input: { readonly runId: string; readonly version: number; readonly value: AnswerValue }) =>
  effect {
    try (try RunsClient).answer(input.runId, { version: input.version, value: input.value }).pipe(
      Effect.mapError((error) =>
        error.code === "not_open"
          ? new AnswerNotOpen()
          : isRefusal(error.status)
          ? new AnswerRefused({ status: error.status })
          : new AnswerUnrecorded()
      ),
      Effect.tapError((error) =>
        Effect.andThen(
          Metric.update(Metric.withAttributes(answers, { outcome: outcomeOf(error) }), 1),
          Effect.logWarning("agent.status.answer").pipe(Effect.annotateLogs({ outcome: outcomeOf(error) })),
        )
      ),
    )
    try Metric.update(Metric.withAttributes(answers, { outcome: "recorded" }), 1)
    try Effect.logInfo("agent.status.answer").pipe(Effect.annotateLogs({ outcome: "recorded" }))
    return { recorded: true }
  }

/** How a failed record is counted. */
const outcomeOf = (error: AnswerNotOpen | AnswerRefused | AnswerUnrecorded) =>
  error._tag === "@smthrs/mvp/status/AnswerNotOpen"
    ? "not_open"
    : error._tag === "@smthrs/mvp/status/AnswerRefused"
    ? "refused"
    : "unrecorded"

/**
 * `run/deliver/answer`: gives the answer to the question this device's engine holds, if it does. A run this device never
 * held is not here; one that finished is closed. A run that holds it but hasn't parked on it yet, as while the next tab
 * wakes it, is tried again.
 */
const deliver = (input: { readonly execution: string; readonly value: AnswerValue }) =>
  effect {
    const runtime = try FlowRuntime.FlowRuntime
    const polled = try runtime.poll(Ask, input.execution).pipe(Effect.option)
    // The token is this question's own, and the value is bounded, so an answer it refuses is one the run isn't
    // parked on yet.
    const outcome = Option.isNone(polled)
      ? "not_here"
      : Option.isSome(polled.value) && polled.value.value._tag === "Complete"
      ? "closed"
      : try HumanTask.answer({ token: tokenOf(input.execution), value: input.value }).pipe(
        Effect.as("delivered" as const),
        Effect.mapError(() => new NotWaitingYet()),
      )
    try Metric.update(Metric.withAttributes(answers, { outcome }), 1)
    try Effect.logInfo("agent.status.deliver").pipe(
      Effect.annotateLogs({ outcome, delivered: outcome === "delivered" }),
    )
    return { delivered: outcome === "delivered" }
  }

/**
 * Registers `app/agent/ask` (with the human task it parks on), `run/answer` and `run/deliver`, with their steps. Needs the
 * host's `FlowRuntime` and `Crypto`, and `RunsClient` and `RunReporter`.
 */
export const registration = Layer.mergeAll(
  Interpreter.layerWithImplementations(
    Ask,
    Layer.mergeAll(AskRequest.toLayer(request), AskAnswer.toLayer(answer), HumanTask.layer),
  ),
  Interpreter.layerWithImplementations(
    AnswerRun,
    Layer.mergeAll(RecordAnswer.toLayer(record), DeliverAnswer.toLayer(deliver)),
  ),
  Interpreter.layerWithImplementations(Deliver, DeliverAnswer.toLayer(deliver)),
)
