import { requesterOf } from "../../flows/requests.vibe"
import { RunsClient, type RunsRefused } from "./api.vibe"
import type { Report } from "./schema"

// How a run's steps report its status (decision 0015 §2): from inside a step, to the run's `runs` row through ChatApi.
// The run is the execution's requester (src/flows/requests.ts): `chat/Answer`'s own id, or the answer an agent's call
// belongs to (`<answerId>/chat/Respond@…/call/<frame>.<ordinal>`, src/flows/catalog.ts). A report is part of the durable step that makes it, so a
// step run again after a crash reports again, which the route takes as no change.
//
// `report` never fails: a status that can't land must not fail the answer, and the conversation reads the answer's
// own settled status first (src/features/status/queries.ts). It skips a report this engine already sent for the run,
// so a step that retries while it waits (`chat/LoadTurn`) reports `waiting` once. `reportOrFail` is for the one report
// a step can't go on without: the question, which the person can't answer unless they see it. A run's reports go one
// at a time, in the order its steps make them, so a report still on its way can't land after the one that followed it,
// and a report is skipped only against the last one that landed.

/** Reports the steps sent, by `status` and `outcome` (`sent`, `skipped`, `failed`). */
export const reports = Metric.counter("smithers_agent_status_reports", {
  description: "Status reports a run's steps sent, by status and outcome",
  incremental: true,
})

/** The key that says two reports of a run show the same thing. */
const keyOf = (report: Report): string =>
  report.status === "needs_you" ? `needs_you:${report.wait.execution}` : report.status

export class RunReporter extends Context.Service<
  RunReporter,
  {
    /** Reports the status of the run `executionId` belongs to, and never fails. */
    readonly report: (executionId: string, report: Report) => void!!
    /** Reports it, failing when the route refused it or couldn't be reached. */
    readonly reportOrFail: (executionId: string, report: Report) => void!RunsRefused
  }
>()("@smthrs/mvp/status/RunReporter") {
  /** The reporter over `RunsClient`. */
  static readonly layer = Layer.effect(
    RunReporter,
    effect {
      const client = try RunsClient
      const last = new Map<string, string>()
      // One permit per run, for as long as it reports; a settled run's goes with its last report.
      const turns = new Map<string, Semaphore.Semaphore>()
      const turnOf = (runId: string) => {
        const known = turns.get(runId)
        if (known !== undefined) return known
        const made = Semaphore.makeUnsafe(1)
        turns.set(runId, made)
        return made
      }
      const counted = (status: Report["status"], outcome: "sent" | "skipped" | "failed") =>
        Metric.update(Metric.withAttributes(reports, { status, outcome }), 1)
      effect function send(executionId: string, report: Report) {
        const runId = requesterOf(executionId)
        try Semaphore.withPermits(turnOf(runId), 1)(sendNow(runId, report))
      }
      effect function sendNow(runId: string, report: Report) {
        const key = keyOf(report)
        if (last.get(runId) === key) {
          try counted(report.status, "skipped")
          return
        }
        client.report(runId, report) catch effect (error) => {
          try counted(report.status, "failed")
          try annotateLogs(logWarning("agent.status.report"), {
            runId,
            status: report.status,
            outcome: "failed",
            errorCode: error.code ?? (error.status === undefined ? "unreachable" : String(error.status)),
          })
          throw error
        }
        last.set(runId, key)
        // A settled run reports nothing more.
        if (report.status === "done" || report.status === "failed") {
          last.delete(runId)
          turns.delete(runId)
        }
        try counted(report.status, "sent")
        try annotateLogs(logDebug("agent.status.report"), { runId, status: report.status, outcome: "sent" })
      }
      return RunReporter.of({
        report: (executionId, report) => ignore(send(executionId, report)),
        reportOrFail: send,
      })
    },
  )
}
