import type { WriteFailure } from "./contract"

// The Secrets page's records of each write (docs/features/secrets.md#the-secrets-page): names, a hosts count, outcomes
// and codes; never a value.

/**
 * Secret writes from this tab, by `op` (`put`, `delete`) and `outcome`: `started` (ChatApi took it and its flow
 * started), `refused`, `unknown` (no whole answer), then `landed` once the list shows it, or `late` past the deadline.
 */
export const writes = Metric.counter("smithers_web_secret_writes", {
  description: "Secret writes a person sent from the Secrets page, by op and outcome",
  incremental: true,
})

export type Outcome = "started" | "refused" | "unknown" | "landed" | "late"

/** One write's log line and count. */
export const record = (
  op: "put" | "delete",
  secret: string,
  outcome: Outcome,
  fields: { readonly code?: WriteFailure; readonly hosts?: number } = {},
) =>
  Effect.andThen(
    Metric.update(Metric.withAttributes(writes, { op, outcome }), 1),
    Effect.logWithLevel(outcome === "refused" || outcome === "unknown" || outcome === "late" ? "Warn" : "Info")(
      "secrets.write",
    ) |> Effect.annotateLogs({ op, name: secret, outcome, ...fields })(%),
  )
