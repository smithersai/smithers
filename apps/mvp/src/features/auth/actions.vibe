import { Effect, Metric, Option, Ref } from "effect"
import { codeOf } from "../../errorCode"
import { FlowDispatch } from "../../flows/dispatch.vibe"
import { AuthClient, type AuthUnreachable } from "./api.vibe"
import type { CheckOutcome } from "./contract"
import { DeviceWipe, type WipeFailed } from "./device.vibe"
import { deviceWipes, sessionRefreshes, signInPresses, signOuts } from "./metrics"
import type { Confirmed, Session } from "./schema"
import { AuthStore, SESSION } from "./store.vibe"

// What a person does about signing in, and what the tab does for them. Each action returns once the tab's state
// says so; a request it starts runs in the store's scope and settles the state when ChatApi answers.

const change = (fields: Partial<Omit<Session, "id">>) =>
  effect {
    const { session } = try AuthStore
    try session.update(SESSION, (row) => void Object.assign(row, fields))
  }.pipe(Effect.orDie)

/** A failure's log fields: `outcome` `failed`, its code (src/errorCode.ts), and the HTTP status when ChatApi answered. */
const failed = (failure: AuthUnreachable | WipeFailed) => ({
  outcome: "failed",
  errorCode: codeOf(failure),
  ...(failure._tag === "AuthUnreachable" && failure.status !== undefined ? { status: failure.status } : {}),
})

const current = Effect.flatMap(AuthStore, ({ session }) => Effect.map(session.get(SESSION), Option.getOrThrow))

/**
 * Keeps the session ChatApi confirmed on the device, or, with `null`, forgets it, once the device's own row has loaded:
 * a write before it would race the restore.
 */
const confirm = (row: Omit<Confirmed, "id"> | null) =>
  effect {
    const { confirmed } = try AuthStore
    try Effect.ignore(confirmed.restored)
    const kept = try confirmed.get(SESSION)
    if (row === null) {
      // Stored before it returns: a sign-out wipes the device next, and a delete still in flight would fail against it.
      if (Option.isSome(kept)) try (try confirmed.delete(SESSION)).persisted
      return
    }
    if (Option.isNone(kept)) try confirmed.insert({ id: SESSION, ...row })
    else {
      try confirmed.update(SESSION, (draft) => {
        // An answer that names no home conversation leaves none: an old one is never the person's.
        if (row.homeConversationId === undefined) delete draft.homeConversationId
        Object.assign(draft, row)
      })
    }
  }.pipe(Effect.orDie)

/** Marks the session row `restored` once the device's confirmed session has been read, or couldn't be. */
export const restore = effect {
  const { confirmed } = try AuthStore
  try Effect.ignore(confirmed.restored)
  try change({ restored: true })
}

/**
 * Asks ChatApi who this browser is signed in as, and shows it: `unreachable` when ChatApi couldn't say. Answers how the
 * check ended.
 */
export const load = effect {
  const client = try AuthClient
  const answer = try Effect.result(client.session)
  if (answer._tag === "Failure") {
    // A server that answered and couldn't verify, unlike a network that failed, hides private rows (`repositoryAccess`).
    // Only a session answer clears it: a retry that then fails on the network says nothing about the session, so it
    // keeps the hiding an earlier answer started (Astra on 0c7b9f01).
    const unverifiable = answer.failure.code === "status" || answer.failure.code === "malformed" || answer.failure.code === "credential_stale"
    try change(unverifiable ? { status: "unreachable", unverifiable: true } : { status: "unreachable" })
    try Effect.logWarning("session unreachable").pipe(Effect.annotateLogs(failed(answer.failure)))
    return "unreachable" as CheckOutcome
  }
  const state = answer.success
  try change({ unverifiable: false })
  // Whose data this page opened is the device's owner check's to decide (src/device/identity.ts): a page never shows
  // another person's data under this session, and nothing here deletes it. Expiry keeps the confirmed session.
  try change(
    state.signedIn
      ? {
        status: "signed_in",
        login: state.login,
        role: state.role,
        roleConfirmed: state.roleConfirmed,
        available: true,
        hostedModel: state.hostedModel ?? true,
        install: state.install,
        homeConversationId: state.homeConversationId,
      }
      : { status: "signed_out", login: null, role: null, roleConfirmed: undefined, available: state.available, hostedModel: state.hostedModel, install: undefined, homeConversationId: undefined },
  )
  try (try AuthStore).sessionConfirmed
  if (state.signedIn) {
    try confirm({
      login: state.login,
      role: state.role,
      ...(state.personId === undefined ? {} : { personId: state.personId }),
      ...(state.homeConversationId === undefined ? {} : { homeConversationId: state.homeConversationId }),
    })
  }
  try Effect.logInfo("session loaded").pipe(Effect.annotateLogs({ signedIn: state.signedIn }))
  return (state.signedIn ? state.roleConfirmed === false ? "unconfirmed" : "signed_in" : "signed_out") as CheckOutcome
}.pipe(Effect.annotateLogs({ feature: "auth" }))

/** What started a session check: the app opening, the browser coming back online, a manual retry, or `auth/refresh` asking again. */
export type CheckVia = "startup" | "online" | "retry"

/**
 * A session check started by `via`: counted in `sessionRefreshes` and logged by `via`, then `load`. One runs at a time
 * on a tab, so a check waits for the one already asking ChatApi. Answers how it ended.
 */
export const check = (via: CheckVia) =>
  effect {
    const { checking } = try AuthStore
    return try checking.withPermits(1)(
      Metric.update(Metric.withAttributes(sessionRefreshes, { via }), 1).pipe(
        Effect.andThen(Effect.logInfo("auth.session_refresh").pipe(Effect.annotateLogs({ via }))),
        Effect.andThen(load),
      ),
    )
  }

/**
 * After a check ChatApi couldn't answer: dispatches `auth/refresh` (src/features/auth/flows.ts), whose step asks this
 * tab to check again (`check("retry")`) until ChatApi answers, unless this tab's refresh is already running. Returns at
 * once; the run goes on in the store's scope, and dispatch logs how it ended (`flow.dispatch`).
 */
export const refresh = effect {
  const { refreshing, scope } = try AuthStore
  if (try Ref.getAndSet(refreshing, true)) return
  const flows = try FlowDispatch
  try Effect.logInfo("auth.refresh").pipe(Effect.annotateLogs({ stage: "started" }))
  try flows.dispatch("auth/refresh", {}, { door: "sync" }).pipe(
    Effect.ignore,
    Effect.ensuring(Ref.set(refreshing, false)),
    Effect.forkIn(scope, { startImmediately: true }),
  )
}.pipe(Effect.annotateLogs({ feature: "auth" }))

/** "Sign in with GitHub" pressed: counted. The link it is takes the browser to GitHub. */
export const pressSignIn = Metric.update(signInPresses, 1).pipe(
  Effect.andThen(Effect.logInfo("sign in pressed")),
  Effect.annotateLogs({ feature: "auth" }),
)

/**
 * Wipes this device's synced data and outbox once ChatApi has ended the session (decision 0008 §4.6): what came from
 * the server doesn't outlive the session on a shared device. Counted and logged; the browser's host then reloads, and
 * the page continues as a visitor.
 */
const wipeDevice = effect {
  const wiped = try Effect.result((try DeviceWipe).wipe)
  const outcome = wiped._tag === "Success" ? "wiped" : "failed"
  try Metric.update(Metric.withAttributes(deviceWipes, { outcome }), 1)
  try (wiped._tag === "Success"
    ? Effect.logInfo("device wiped")
    : Effect.logWarning("device wipe failed").pipe(Effect.annotateLogs(failed(wiped.failure))))
}

/** Sends the sign-out and settles the tab's state when ChatApi answers; a sign-out ChatApi took wipes the device. */
const sendSignOut = effect {
  const device = try DeviceWipe
  try effect {
    const client = try AuthClient
    const sent = try Effect.result(client.signOut)
    if (sent._tag === "Failure") {
      try change({ signingOut: false })
      try Metric.update(Metric.withAttributes(signOuts, { outcome: "failed" }), 1)
      return try Effect.logWarning("sign out failed").pipe(Effect.annotateLogs(failed(sent.failure)))
    }
    // The server ended the session. No local state or telemetry failure may bypass durable wipe marking or sealing.
    try effect {
      try change({ status: "signed_out", login: null, role: null, signingOut: false, confirmSignOut: false })
      try confirm(null)
      try Metric.update(Metric.withAttributes(signOuts, { outcome: "signed_out" }), 1)
      try Effect.logInfo("signed out")
    }.pipe(Effect.ensuring(wipeDevice))
  }.pipe(Effect.ensuring(device.finishSignOut))
}.pipe(Effect.annotateLogs({ feature: "auth" }))

/** Sign out pressed: `signingOut` at once, then signed out when ChatApi ends the session. Once at a time. */
export const signOut = effect {
  if ((try current).signingOut) return
  try change({ signingOut: true, confirmSignOut: false })
  try Effect.forkIn(sendSignOut, (try AuthStore).scope, { startImmediately: true })
}


/** Asks confirmation before signing out when unsent outbox writes would be wiped with the device. */
export const promptSignOut = change({ confirmSignOut: true })

/** Cancels the unsent-writes sign-out confirmation. */
export const cancelSignOut = change({ confirmSignOut: false })

/** Sends the Admin hosted-inference toggle and updates the live session row when ChatApi answers. */
const sendHostedModel = (enabled: boolean) =>
  effect {
    const client = try AuthClient
    const sent = try Effect.result(client.setHostedModel(enabled))
    if (sent._tag === "Failure") {
      try change({ hostedModelSaving: false, hostedModelError: true })
      return try Effect.logWarning("hosted model failed").pipe(Effect.annotateLogs(failed(sent.failure)))
    }
    try change({ hostedModel: sent.success.enabled, hostedModelSaving: false, hostedModelError: false })
    try Effect.logInfo("hosted model updated").pipe(Effect.annotateLogs({ enabled: sent.success.enabled }))
  }.pipe(Effect.annotateLogs({ feature: "auth" }))

/** Admin hosted-inference toggle pressed: one update at a time. */
export const setHostedModel = (enabled: boolean) =>
  effect {
    if ((try current).hostedModelSaving) return
    try change({ hostedModelSaving: true, hostedModelError: false })
    try Effect.forkIn(sendHostedModel(enabled), (try AuthStore).scope, { startImmediately: true })
  }
