// What the branch terminal counts in the browser (decision 0013 §7, docs/observability.md#browser). No attribute
// carries an id, and nothing counts a terminal's content: only bytes by direction.

/** `terminal/open` requests, by `outcome`: `opening`, the refusal's reason, or `unavailable`. */
export const opens = Metric.counter("smithers_web_terminal_opens", {
  description: "Terminal open requests from this browser, by outcome",
  incremental: true,
})

/** Milliseconds from Open terminal to the first byte of the shell. */
export const openMs = Metric.histogram("terminal_open_ms", {
  description: "Milliseconds from Open terminal to the shell's first byte",
  boundaries: Metric.exponentialBoundaries({ start: 100, factor: 2, count: 10 }),
})

/** Reconnects of an attached terminal's socket, by the `code` it closed with. */
export const reconnects = Metric.counter("terminal_reconnects", {
  description: "Terminal socket reconnects, by close code",
  incremental: true,
})

/** Bytes through attached terminals, by `direction` (`in` typed, `out` shown). A count, never content. */
export const bytes = Metric.counter("terminal_bytes", {
  description: "Terminal bytes, by direction",
  incremental: true,
})

/** Ended terminals as this browser saw them, by `reason`. */
export const ended = Metric.counter("terminal_ended", {
  description: "Terminals that ended while attached, by reason",
  incremental: true,
})
