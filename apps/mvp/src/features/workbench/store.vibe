import { emptyPlanTree, type PlanNodeState, type PlanTree } from "@smthrs/app-state"
import { Collection, LiveQuery } from "@smthrs/effect-tanstack-db"
import { ShardProtocol } from "@smthrs/sync"
import type { AudienceRole, PlanTreeNodeItem, WaitlistStatus } from "@smthrs/ui"
import { Context, Data, type Duration, Effect, Layer, Metric, Option, Schema, type Scope } from "effect"
import { HttpClient, HttpClientRequest } from "effect/http"
import { runners } from "../../boundary.vibe"
import type { Role } from "../auth/contract"
import { repoId } from "../repo/contract"
import { RepoStore } from "../repo/store.vibe"
import { submitWaitlist as submitWaitlistRequest, waitlistErrorMessage } from "../waitlist/api.vibe"
import { conversationStateKey, restoreConversationSnapshot, saveConversationSnapshot, type ConversationPaneSnapshot, type ConversationPaneStore } from "./conversationState"
import type { WorkbenchLayout } from "./layout"
import {
  applyPlanDeliveryEffect,
  decodePlanTreePullResponse,
  decodePlanTreeSnapshotResponse,
  planPullRoute,
  planShardId,
  planSnapshotRoute,
} from "./planContract"

// Workbench state on this tab: three local-only TanStack DB collections of one row each, kept strictly in memory
// (never persisted on disk). Layout state (pane, size, frame, node, cause, audience, diffScope) stays in the URL
// via TanStack Router. All HTTP calls go through Effect HttpClient.

export { planPullRoute, planShardId, planSnapshotRoute }

export const PLAN_ROW_ID = "plan"
export const WAITLIST_ROW_ID = "waitlist"

export const PLAN_STATUSES = ["idle", "loading", "ready", "empty", "failed"] as const
export type PlanLoadStatus = (typeof PLAN_STATUSES)[number]

/** Browser-side counter of Workbench plan tree loads by outcome (OBS-5 safe: no repo names or node content). */
export const workbenchPlanLoads = Metric.counter("smithers_workbench_plan_loads", {
  description: "Workbench plan tree loads by outcome",
  incremental: true,
})

const MAX_PLAN_PULL_REQUESTS = 64

const PlanAssumptionRow = Schema.Struct({
  id: Schema.String,
  text: Schema.String,
  verified: Schema.Boolean,
})

const PlanTreeItemRow = Schema.Struct({
  id: Schema.String,
  title: Schema.String,
  milestone: Schema.String,
  status: Schema.Literals(["pending", "in_progress", "blocked_on_will", "done", "failed"]),
  depth: Schema.Number,
  sources: Schema.Array(Schema.String),
  assumptions: Schema.Array(PlanAssumptionRow),
})

export const PlanRow = Schema.Struct({
  id: Schema.Literal(PLAN_ROW_ID),
  repoSlug: Schema.String,
  status: Schema.Literals(PLAN_STATUSES),
  nodes: Schema.Array(PlanTreeItemRow),
  totalFrames: Schema.Number,
  error: Schema.NullOr(Schema.String),
})
export type PlanRow = typeof PlanRow.Type

export const WaitlistRow = Schema.Struct({
  id: Schema.Literal(WAITLIST_ROW_ID),
  repoUrl: Schema.String,
  workflowNote: Schema.String,
  status: Schema.Literals(["idle", "submitting", "submitted", "error"]),
  position: Schema.NullOr(Schema.Number),
  errorMessage: Schema.NullOr(Schema.String),
})
export type WaitlistRow = typeof WaitlistRow.Type

/** The plan row before any load, and after its repository is refused. */
const EMPTY_PLAN: PlanRow = { id: PLAN_ROW_ID, repoSlug: "", status: "idle", nodes: [], totalFrames: 1, error: null }

export const WORKBENCH_WITHIN: Duration.Input = "15 seconds"

export class PlanSnapshotFailed extends Data.TaggedError("PlanSnapshotFailed")<{
  readonly status?: number
  readonly code: string
}> {}

export interface FetchedPlan {
  readonly position: ShardProtocol.ShardPosition
  readonly tree: PlanTree | null
}

/** Convert a PlanTree shard snapshot into ordered, depth-annotated items for @smthrs/ui PlanTree. */
export const planNodesFromTree = (tree: PlanTree): ReadonlyArray<PlanTreeNodeItem> => {
  const byParent = new Map<string | null, Array<PlanNodeState>>()
  for (const node of Object.values(tree.nodes)) {
    const parentKey = node.parent !== null && Object.hasOwn(tree.nodes, node.parent) ? node.parent : null
    const bucket = byParent.get(parentKey)
    if (bucket === undefined) {
      byParent.set(parentKey, [node])
    } else {
      bucket.push(node)
    }
  }
  for (const bucket of byParent.values()) {
    bucket.sort((a, b) => (a.order !== b.order ? a.order - b.order : a.id.localeCompare(b.id)))
  }
  const items: Array<PlanTreeNodeItem> = []
  const walk = (parentId: string | null, depth: number) => {
    const children = byParent.get(parentId)
    if (children === undefined) return
    for (const node of children) {
      items.push({
        id: node.id,
        title: node.title,
        milestone: node.milestone,
        status: node.status,
        depth,
        sources: [...node.sources],
        assumptions: node.assumptions.map((assumption, index) => ({
          id: `${node.id}#${index}`,
          text: assumption.text,
          verified: assumption.verified,
        })),
      })
      walk(node.id, depth + 1)
    }
  }
  walk(null, 0)
  return items
}

/** Map a repository role strictly downward to a workbench AudienceRole. */
export const roleToAudience = (role: Role | null | undefined): AudienceRole => {
  if (role === "admin" || role === "maintainer") return "maintainer"
  if (role === "member") return "contributor"
  return "visitor"
}

export class WorkbenchClient extends Context.Service<
  WorkbenchClient,
  {
    readonly fetchPlan: (
      owner: string,
      repo: string,
    ) => Effect.Effect<FetchedPlan, PlanSnapshotFailed>
    readonly joinWaitlist: (input: {
      readonly repoUrl: string
      readonly workflowNote?: string
    }) => Effect.Effect<{ readonly position: number }, string>
  }
>()("@smthrs/mvp/workbench/WorkbenchClient") {
  static readonly layer = (options: { readonly origin: string; readonly within?: Duration.Input }) =>
    Layer.effect(
      WorkbenchClient,
      effect {
        const http = try HttpClient.HttpClient
        const within = options.within ?? WORKBENCH_WITHIN
        return WorkbenchClient.of({
          fetchPlan: (owner, repo) =>
            withSpan(effect {
              const shard = try sync(() => planShardId(owner, repo))
              const snapshotUrl = try sync(() => planSnapshotRoute(options.origin, owner, repo))
              let requestCount = 0
              const getJson = <A>(
                url: string,
                decode: (raw: unknown) => A!Schema.SchemaError,
                allowNotFound: boolean,
              ): Option.Option<A>!PlanSnapshotFailed =>
                effect {
                  requestCount += 1
                  if (requestCount > MAX_PLAN_PULL_REQUESTS) {
                    throw new PlanSnapshotFailed({ code: "unavailable" })
                  }
                  const response = try http.execute(HttpClientRequest.get(url)).pipe(
                    Effect.mapError(() => new PlanSnapshotFailed({ code: "unavailable" })),
                  )
                  if (response.status === 401) {
                    throw new PlanSnapshotFailed({ status: 401, code: "sign_in_required" })
                  }
                  if (response.status === 403) {
                    throw new PlanSnapshotFailed({ status: 403, code: "forbidden" })
                  }
                  if (response.status === 404 && allowNotFound) {
                    return Option.none<A>()
                  }
                  if (response.status !== 200) {
                    throw new PlanSnapshotFailed({ status: response.status, code: "unavailable" })
                  }
                  const raw = try response.json.pipe(
                    Effect.mapError(() => new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })),
                  )
                  const decoded = try decode(raw).pipe(
                    Effect.mapError(() => new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })),
                  )
                  return Option.some(decoded)
                }

              const initialSnapshot = try getJson(snapshotUrl, decodePlanTreeSnapshotResponse, true)
              if (Option.isNone(initialSnapshot)) {
                return { position: { shard, epoch: 0, seq: 0 }, tree: null }
              }
              const snapshot = initialSnapshot.value
              if (snapshot.position.shard !== shard) {
                throw new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })
              }

              let position = snapshot.position
              let tree: PlanTree = snapshot.state === null ? emptyPlanTree : snapshot.state.tree
              let hasState = snapshot.state !== null

              while (true) {
                const pullUrl = try sync(() =>
                  planPullRoute(options.origin, owner, repo, {
                    version: ShardProtocol.protocolVersion,
                    shard,
                    epoch: position.epoch,
                    after: position.seq,
                    limit: 256,
                  }),
                )
                const reply = Option.getOrThrow(try getJson(pullUrl, decodePlanTreePullResponse, false))
                if (reply.shard !== shard) {
                  throw new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })
                }
                if (reply._tag === "Resync") {
                  const refreshed = Option.getOrThrow(try getJson(snapshotUrl, decodePlanTreeSnapshotResponse, false))
                  if (refreshed.position.shard !== shard) {
                    throw new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })
                  }
                  tree = refreshed.state === null ? emptyPlanTree : refreshed.state.tree
                  hasState = refreshed.state !== null
                  position = refreshed.position
                  continue
                }
                const through: ShardProtocol.ShardPosition = { shard, epoch: reply.epoch, seq: reply.through }
                if (reply.entries.length > 0) {
                  tree = try applyPlanDeliveryEffect(tree, { _tag: "Entries", entries: reply.entries, through }).pipe(
                    Effect.mapError(() => new PlanSnapshotFailed({ status: 200, code: "invalid_snapshot" })),
                  )
                  hasState = true
                }
                position = through
                if (reply.done) break
              }
              return { position, tree: hasState ? tree : null }
            }, "workbench.plan.fetch").pipe(
              Effect.timeoutOrElse({
                duration: within,
                orElse: () => Effect.fail(new PlanSnapshotFailed({ code: "timeout" })),
              }),
            ),
          joinWaitlist: (input) =>
            submitWaitlistRequest({ origin: options.origin, ...input }).pipe(
              Effect.provideService(HttpClient.HttpClient, http),
              Effect.map((res) => ({ position: res.position })),
              Effect.mapError((err) => waitlistErrorMessage(err)),
            ),
        })
      },
    )
}

const planQuery = (rows: Collection.Collection<PlanRow, string>) =>
  LiveQuery.make((q) => q.from({ row: rows.tanstack }).findOne())
const waitlistQuery = (rows: Collection.Collection<WaitlistRow, string>) =>
  LiveQuery.make((q) => q.from({ row: rows.tanstack }).findOne())

type Query<F extends (...args: never) => unknown> = Effect.Success<ReturnType<F>>

export class WorkbenchStore extends Context.Service<
  WorkbenchStore,
  {
    readonly plan: Collection.Collection<PlanRow, string>
    readonly planState: Query<typeof planQuery>
    readonly waitlist: Collection.Collection<WaitlistRow, string>
    readonly waitlistState: Query<typeof waitlistQuery>
    readonly nextPlanGeneration: () => number
    readonly isCurrentPlanGeneration: (generation: number) => boolean
    readonly scope: Scope.Scope
  }
>()("@smthrs/mvp/workbench/WorkbenchStore") {
  static readonly layer = Layer.effect(
    WorkbenchStore,
    effect {
      const scope = try Effect.scope
      let planGeneration = 0
      const nextPlanGeneration = () => {
        planGeneration += 1
        return planGeneration
      }
      const isCurrentPlanGeneration = (generation: number) => generation === planGeneration
      const plan = try Collection.local<PlanRow, string>({
        id: "workbench-plan",
        schema: PlanRow,
        getKey: (row) => row.id,
        initialData: [EMPTY_PLAN],
      })
      // A refused repository's plan leaves this tab: the plan row returns to idle when it holds that repository.
      const repos = try Effect.serviceOption(RepoStore)
      if (Option.isSome(repos)) {
        try repos.value.registerCache(["workbench-plan"], (id) =>
          Effect.flatMap(plan.toArray, (rows) =>
            Effect.forEach(
              rows.filter((row) => {
                const [owner, name] = row.repoSlug.split("/")
                return owner !== undefined && name !== undefined && repoId(owner, name) === id
              }),
              (row) =>
                Effect.sync(() => {
                  nextPlanGeneration()
                }).pipe(
                  Effect.andThen(Effect.ignore(plan.update(row.id, (draft) => void Object.assign(draft, EMPTY_PLAN)))),
                ),
              { discard: true },
            )))
      }
      const waitlist = try Collection.local<WaitlistRow, string>({
        id: "workbench-waitlist",
        schema: WaitlistRow,
        getKey: (row) => row.id,
        initialData: [
          {
            id: WAITLIST_ROW_ID,
            repoUrl: "",
            workflowNote: "",
            status: "idle",
            position: null,
            errorMessage: null,
          },
        ],
      })
      return WorkbenchStore.of({
        plan,
        planState: try planQuery(plan),
        waitlist,
        waitlistState: try waitlistQuery(waitlist),
        nextPlanGeneration,
        isCurrentPlanGeneration,
        scope,
      })
    },
  )
}

const setPlan = (change: Partial<Omit<PlanRow, "id">>) =>
  Effect.flatMap(WorkbenchStore, ({ plan }) =>
    Effect.asVoid(Effect.orDie(plan.update(PLAN_ROW_ID, (draft) => void Object.assign(draft, change)))),
  )

const setWaitlist = (change: Partial<Omit<WaitlistRow, "id">>) =>
  Effect.flatMap(WorkbenchStore, ({ waitlist }) =>
    Effect.asVoid(Effect.orDie(waitlist.update(WAITLIST_ROW_ID, (draft) => void Object.assign(draft, change)))),
  )

export const loadPlan = (owner: string, repo: string) =>
  withSpan(effect {
    const store = try WorkbenchStore
    const slug = `${owner}/${repo}`
    const generation = store.nextPlanGeneration()
    const current = store.plan.tanstack.get(PLAN_ROW_ID)
    const switchingRepo = current !== undefined && current.repoSlug.toLowerCase() !== slug.toLowerCase()
    try setPlan({
      repoSlug: slug,
      status: "loading",
      ...(switchingRepo ? { nodes: [], totalFrames: 1 } : {}),
      error: null,
    })
    const client = try WorkbenchClient
    const outcome = try client.fetchPlan(owner, repo).pipe(Effect.result)
    if (!store.isCurrentPlanGeneration(generation)) {
      try Metric.update(Metric.withAttributes(workbenchPlanLoads, { outcome: "stale" }), 1)
      return
    }
    if (outcome._tag === "Failure") {
      const code = outcome.failure.code
      try Metric.update(Metric.withAttributes(workbenchPlanLoads, { outcome: code }), 1)
      try annotateCurrentSpan({ "workbench.plan.outcome": code })
      try annotateLogs(logWarning("workbench.plan.load_failed"), {
        code,
        ...(outcome.failure.status === undefined ? {} : { status: outcome.failure.status }),
      })
      try setPlan({ repoSlug: slug, status: "failed", nodes: [], totalFrames: 1, error: code })
      return
    }
    const { position, tree } = outcome.success
    if (tree === null) {
      try Metric.update(Metric.withAttributes(workbenchPlanLoads, { outcome: "empty" }), 1)
      try annotateCurrentSpan({ "workbench.plan.outcome": "empty", "workbench.plan.seq": position.seq })
      try setPlan({ repoSlug: slug, status: "empty", nodes: [], totalFrames: Math.max(1, position.seq + 1), error: null })
      return
    }
    const nodes = planNodesFromTree(tree).map((node) => ({
      id: node.id,
      title: node.title,
      milestone: node.milestone,
      status: node.status,
      depth: node.depth,
      sources: [...node.sources!],
      assumptions: [...node.assumptions!],
    }))
    const status = nodes.length === 0 ? "empty" : "ready"
    try Metric.update(Metric.withAttributes(workbenchPlanLoads, { outcome: status }), 1)
    try annotateCurrentSpan({
      "workbench.plan.outcome": status,
      "workbench.plan.seq": position.seq,
      "workbench.plan.nodes": nodes.length,
    })
    try setPlan({
      repoSlug: slug,
      status,
      nodes,
      totalFrames: Math.max(1, position.seq + 1),
      error: null,
    })
  }, "workbench.plan.load").pipe(Effect.annotateLogs({ feature: "workbench" }))

export const submitWaitlistDraft = (effect {
  const store = try WorkbenchStore
  const { repoUrl, workflowNote } = try Effect.sync(
    () => store.waitlist.tanstack.get(WAITLIST_ROW_ID)!,
  )
  try setWaitlist({ status: "submitting", errorMessage: null })
  const client = try WorkbenchClient
  const outcome = try client
    .joinWaitlist({
      repoUrl,
      ...(workflowNote.trim().length > 0 ? { workflowNote } : {}),
    })
    .pipe(Effect.result)
  if (outcome._tag === "Failure") {
    try setWaitlist({ status: "error", errorMessage: outcome.failure })
    return
  }
  try setWaitlist({ status: "submitted", position: outcome.success.position, errorMessage: null })
}).pipe(Effect.annotateLogs({ feature: "workbench" }))

type Store = WorkbenchStore["Service"]

export interface WorkbenchQueries {
  readonly plan: Store["planState"]["tanstack"]
  readonly waitlist: Store["waitlistState"]["tanstack"]
}

export interface WorkbenchActions {
  readonly saveConversation: (repoSlug: string, layout: WorkbenchLayout, draft?: string, conversationId?: string | null) => void
  readonly restoreConversation: (repoSlug: string, search: URLSearchParams | string | Record<string, unknown>, maxRole: AudienceRole, conversationId?: string | null) => ConversationPaneSnapshot
  readonly loadPlan: (owner: string, repo: string) => Promise<void>
  readonly setWaitlistRepoUrl: (repoUrl: string) => void
  readonly setWaitlistWorkflowNote: (workflowNote: string) => void
  readonly submitWaitlist: () => Promise<void>
}

export class Workbench extends Context.Service<
  Workbench,
  { readonly queries: WorkbenchQueries; readonly actions: WorkbenchActions }
>()("@smthrs/mvp/workbench/Workbench") {
  static readonly layer = Layer.effect(
    Workbench,
    effect {
      const store = try WorkbenchStore
      const context = try Effect.context<WorkbenchStore | WorkbenchClient>()
      const { runSync: run, runPromise: promise } = runners(context, "workbench")
      let conversationSnapshots: ConversationPaneStore = new Map()
      return Workbench.of({
        queries: {
          plan: store.planState.tanstack,
          waitlist: store.waitlistState.tanstack,
        },
        actions: {
          saveConversation: (repoSlug, layout, draft, conversationId) => {
            const key = conversationStateKey(repoSlug, conversationId)
            const previousDraft = conversationSnapshots.get(key)?.draft ?? ""
            conversationSnapshots = saveConversationSnapshot(conversationSnapshots, {
              conversationKey: key,
              layout,
              draft: draft ?? previousDraft,
            })
          },
          restoreConversation: (repoSlug, search, maxRole, conversationId) =>
            restoreConversationSnapshot({
              store: conversationSnapshots,
              conversationKey: conversationStateKey(repoSlug, conversationId),
              search,
              maxRole,
            }),
          loadPlan: (owner, repo) => promise(loadPlan(owner, repo)),
          setWaitlistRepoUrl: (repoUrl) => run(setWaitlist({ repoUrl, status: "idle" as WaitlistStatus, errorMessage: null })),
          setWaitlistWorkflowNote: (workflowNote) => run(setWaitlist({ workflowNote })),
          submitWaitlist: () => promise(submitWaitlistDraft),
        },
      })
    },
  ).pipe(Layer.provideMerge(WorkbenchStore.layer))

  static readonly live = (options: { readonly origin: string; readonly within?: Duration.Input }) =>
    Workbench.layer.pipe(Layer.provide(WorkbenchClient.layer(options)))
}

export type WorkbenchView = Workbench["Service"]
