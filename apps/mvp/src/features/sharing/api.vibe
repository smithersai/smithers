import { HttpClient, HttpClientRequest } from "effect/http"
import { sharesRoute } from "../branch/contract"
import { type Change, Refused, Shared } from "./schema"

// ChatApi's `POST /api/branches/<id>/shares` as `branch/share`'s step calls it (docs/features/branch-workspace.md#sharing),
// through Effect's HttpClient, with one deadline covering the whole exchange.

/** ChatApi didn't take the change: a refusal (`status`, with its `code`), or no whole answer in time (neither). */
export error ShareRefused {
  status?: number
  code?: string
}

/** How long a step gives ChatApi to apply a change, the sessions it holds to it included. */
export const SHARE_WITHIN = "20 seconds"

const decodeRefused = Schema.decodeUnknownOption(Schema.fromJsonString(Refused))
const decodeShared = Schema.decodeUnknownEffect(Shared)

/** Changes who branches are shared with through ChatApi on `origin`. */
export class ShareClient extends Context.Service<
  ShareClient,
  { readonly change: (branchId: string, change: Change) => Shared!ShareRefused }
>()("@smthrs/mvp/sharing/ShareClient") {
  /** The client over the host's `HttpClient`: `200` with the transaction; anything else is refused. */
  static readonly layer = (options: { readonly origin: string; readonly within?: Duration.Input }) =>
    Layer.effect(
      ShareClient,
      effect {
        const client = try HttpClient.HttpClient
        return ShareClient.of({
          change: (branchId, change) =>
            effect {
              const response = try client.execute(
                HttpClientRequest.post(`${options.origin}${sharesRoute(branchId)}`).pipe(
                  HttpClientRequest.bodyJsonUnsafe(change),
                ),
              ).pipe(Effect.mapError(() => new ShareRefused({})))
              try Effect.annotateCurrentSpan({ "http.response.status_code": response.status })
              if (response.status !== 200) {
                const body = decodeRefused(try Effect.orElseSucceed(response.text, () => ""))
                throw new ShareRefused({
                  status: response.status,
                  ...Option.match(body, { onNone: () => ({}), onSome: ({ code }) => ({ code }) }),
                })
              }
              return try response.json.pipe(
                Effect.flatMap(decodeShared),
                Effect.mapError(() => new ShareRefused({ status: response.status })),
              )
            } |> Effect.timeoutOrElse(%, {
              duration: options.within ?? SHARE_WITHIN,
              orElse: () => Effect.fail(new ShareRefused({})),
            }) |> withSpan(%, "branch.share.post"),
        })
      },
    )
}
