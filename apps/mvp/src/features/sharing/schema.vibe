import { SHARE_ACCESSES } from "../branch/contract"
import { SHARE_ERROR_CODES } from "./contract"

// Sharing's rows (decision 0013 §2, docs/features/branch-workspace.md#sharing): a branch's permission list as Electric
// delivers it to its owner, a change as `branch/share` sends it, and the dialog this tab shows.

/** One row of Postgres `branch_shares` as Electric delivers it: columns in camelCase. */
export const ShareRow = Schema.Struct({
  branchId: Schema.String,
  grantee: Schema.String,
  login: Schema.NullOr(Schema.String),
  access: Schema.Literals(SHARE_ACCESSES),
  sharedBy: Schema.NullOr(Schema.String),
  createdAt: Schema.String,
  updatedAt: Schema.String,
})
export type ShareRow = typeof ShareRow.Type

/**
 * A change to a branch's permission list: share with a person by login, or set a grant (a person's id, or
 * `repository`, the link) to an access, `null` to remove it.
 */
export const Change = Schema.Union([
  Schema.Struct({ login: Schema.String, access: Schema.Literals(SHARE_ACCESSES) }),
  Schema.Struct({ grantee: Schema.String, access: Schema.NullOr(Schema.Literals(SHARE_ACCESSES)) }),
])
export type Change = typeof Change.Type

/** What `POST /api/branches/<id>/shares` answers: the transaction it wrote in, `null` when nothing changed. */
export const Shared = Schema.Struct({ txid: Schema.NullOr(Schema.Number) })
export type Shared = typeof Shared.Type

/** A refusal's body: its code. */
export const Refused = Schema.Struct({ code: Schema.String })

/** The share dialog on this tab: open or not, on which branch, what the last change said, and what is in flight. */
export const DIALOG = "dialog"
export const Dialog = Schema.Struct({
  id: Schema.Literal(DIALOG),
  open: Schema.Boolean,
  branchId: Schema.NullOr(Schema.String),
  error: Schema.NullOr(Schema.Literals(SHARE_ERROR_CODES)),
  pending: Schema.Array(Schema.String),
})
export type Dialog = typeof Dialog.Type
