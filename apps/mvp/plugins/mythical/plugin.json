{
  "apiVersion": 1,
  "id": "mythical",
  "version": "0.1.0",
  "title": "Mythical History",
  "description": "Clean linear narrative history of the repository with epics, atomic commits, git-note evidence, and tree-equality verification against main.",
  "requires": { "api": "^1.0.0" },
  "capabilities": [],
  "uses": ["app/navigate"],
  "contributes": {
    "views": [{
      "id": "mythical/history",
      "title": "History",
      "scope": "repository",
      "path": "",
      "sizes": ["full"],
      "minimum": "anyone",
      "reads": ["core/feeds"],
      "render": { "kind": "component", "export": "Mythical" },
      "events": [
        { "name": "next", "local": true },
        { "name": "previous", "local": true }
      ]
    }],
    "slots": [{
      "slot": "repo.tabs",
      "id": "mythical/tab",
      "order": 18,
      "minimum": "anyone",
      "reads": ["core/feeds"],
      "render": { "kind": "component", "export": "RepoTab" }
    }],
    "commands": [{
      "id": "mythical/open",
      "flow": "app/navigate",
      "args": { "to": "/{repo}/-/mythical" },
      "title": "Mythical history",
      "minimum": "anyone",
      "slash": { "name": "history" },
      "palette": true
    }],
    "keybindings": [
      { "key": "j", "event": "next", "when": "view == mythical/history && !focus.input" },
      { "key": "k", "event": "previous", "when": "view == mythical/history && !focus.input" }
    ]
  }
}
