{
  "apiVersion": 1,
  "id": "wiki",
  "version": "0.1.0",
  "title": "Wiki",
  "description": "Repository knowledge base: markdown notes, wikilinks, backlinks and heading outline over repository feeds.",
  "requires": { "api": "^1.0.0" },
  "capabilities": [],
  "uses": ["app/navigate"],
  "contributes": {
    "views": [{
      "id": "wiki/notes",
      "title": "Wiki",
      "scope": "repository",
      "path": "",
      "sizes": ["full"],
      "minimum": "anyone",
      "reads": ["core/feeds", "core/feed"],
      "render": { "kind": "component", "export": "Wiki" },
      "events": [
        { "name": "next", "local": true },
        { "name": "previous", "local": true }
      ]
    }],
    "slots": [{
      "slot": "repo.tabs",
      "id": "wiki/tab",
      "order": 15,
      "minimum": "anyone",
      "reads": ["core/feeds"],
      "render": { "kind": "component", "export": "RepoTab" }
    }],
    "commands": [{
      "id": "wiki/open",
      "flow": "app/navigate",
      "args": { "to": "/{repo}/-/wiki" },
      "title": "Wiki",
      "minimum": "anyone",
      "slash": { "name": "wiki" },
      "palette": true
    }],
    "keybindings": [
      { "key": "j", "event": "next", "when": "view == wiki/notes && !focus.input" },
      { "key": "k", "event": "previous", "when": "view == wiki/notes && !focus.input" }
    ]
  }
}
