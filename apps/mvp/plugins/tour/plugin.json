{
  "apiVersion": 1,
  "id": "tour",
  "version": "0.1.0",
  "title": "Tour",
  "description": "Interactive guided tour of Smithers: chat, durable flows, code, TODO stack, sandboxes, review queue and factory.",
  "requires": { "api": "^1.0.0" },
  "capabilities": [],
  "uses": ["app/navigate"],
  "$defs": {
    "Go": {
      "type": "object",
      "properties": { "to": { "type": "string", "maxLength": 512 } },
      "required": ["to"],
      "additionalProperties": false
    }
  },
  "contributes": {
    "views": [{
      "id": "tour/tour",
      "title": "Tour",
      "scope": "app",
      "path": "",
      "sizes": ["full"],
      "minimum": "anyone",
      "render": { "kind": "component", "export": "Tour" },
      "events": [
        { "name": "next", "local": true },
        { "name": "previous", "local": true },
        {
          "name": "go",
          "payload": { "$ref": "#/$defs/Go" },
          "flow": "app/navigate",
          "args": { "to": "$event.to" }
        }
      ]
    }],
    "commands": [{
      "id": "tour/open",
      "flow": "app/navigate",
      "args": { "to": "/app/tour" },
      "title": "Take a tour",
      "minimum": "anyone",
      "slash": { "name": "tour" },
      "palette": true
    }],
    "keybindings": [
      { "key": "g t", "command": "tour/open" },
      { "key": "arrowright", "event": "next", "when": "view == tour/tour && !focus.input" },
      { "key": "arrowleft", "event": "previous", "when": "view == tour/tour && !focus.input" },
      { "key": "j", "event": "next", "when": "view == tour/tour && !focus.input" },
      { "key": "k", "event": "previous", "when": "view == tour/tour && !focus.input" }
    ]
  }
}
