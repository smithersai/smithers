{
  "apiVersion": 1,
  "id": "projects",
  "version": "0.1.0",
  "title": "Projects",
  "description": "Your projects across organizations, with links to their Workbench and Runs.",
  "requires": { "api": "^1.0.0" },
  "capabilities": [],
  "uses": ["app/project/add"],
  "contributes": {
    "slots": [{
      "slot": "app.home",
      "id": "projects/dashboard",
      "minimum": "guest",
      "reads": ["core/projects"],
      "render": { "kind": "component", "export": "Projects" },
      "events": [{
        "name": "add",
        "flow": "app/project/add",
        "payload": {
          "type": "object",
          "properties": {
            "project": { "type": "string", "minLength": 3, "maxLength": 140 },
            "personId": { "type": "string", "minLength": 1 }
          },
          "required": ["project", "personId"],
          "additionalProperties": false
        },
        "args": { "project": "$event.project", "personId": "$event.personId" }
      }]
    }]
  }
}
