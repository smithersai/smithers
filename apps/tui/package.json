{
  "name": "smithers-tui",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal terminal coding agent over the Smithers cell harness",
  "type": "module",
  "bin": {
    "smithers-tui": "./src/main.tsx"
  },
  "scripts": {
    "start": "bun src/main.tsx",
    "ask": "bun src/ask.ts",
    "test": "bun test ./test",
    "typecheck": "vibelang -p tsconfig.json --noEmit",
    "test:e2e": "bun test ./e2e",
    "lint": "eslint src --max-warnings=0 && dprint check",
    "coverage:roster": "node coverage-inventory.mjs --write"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.1",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "@smthrs/agent": "workspace:*",
    "@smthrs/capability": "workspace:*",
    "@smthrs/cli": "workspace:*",
    "@smthrs/control": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/gateway": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/journal": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/plugin": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/rpc": "workspace:*",
    "@smthrs/sandbox": "workspace:*",
    "@smthrs/std": "workspace:*",
    "diff": "9.0.0",
    "effect": "4.1.1",
    "react": "19.2.8",
    "string-width": "7.2.0",
    "@smthrs/ui": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "vibelang-runtime": "0.0.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "19.2.18",
    "@smthrs/ui-styleguide": "workspace:*",
    "@xterm/headless": "6.0.0",
    "bun-types": "^1.4.0",
    "dprint": "0.57.1",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "65.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.69.0",
    "vibelang": "0.0.12",
    "@smthrs/testing": "workspace:*"
  },
  "imports": {
    "#vibelang/emitted/src/activity": {
      "types": "./.vibe/declarations/src/activity.d.vibe.ts",
      "vibelang-source": "./src/activity.vibe",
      "default": "./.vibelang/js/src/activity.js"
    },
    "#vibelang/emitted/src/key-dispatch": {
      "types": "./.vibe/declarations/src/key-dispatch.d.vibe.ts",
      "vibelang-source": "./src/key-dispatch.vibe",
      "default": "./.vibelang/js/src/key-dispatch.js"
    },
    "#vibelang/emitted/src/panels": {
      "types": "./.vibe/declarations/src/panels.d.vibe.ts",
      "vibelang-source": "./src/panels.vibe",
      "default": "./.vibelang/js/src/panels.js"
    },
    "#vibelang/emitted/src/tab-error": {
      "types": "./.vibe/declarations/src/tab-error.d.vibe.ts",
      "vibelang-source": "./src/tab-error.vibe",
      "default": "./.vibelang/js/src/tab-error.js"
    },
    "#vibelang/emitted/src/credit": {
      "types": "./.vibe/declarations/src/credit.d.vibe.ts",
      "vibelang-source": "./src/credit.vibe",
      "default": "./.vibelang/js/src/credit.js"
    }
  }
}
