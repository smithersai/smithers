// @vitest-environment node
import { it, expect } from "@effect/vitest"
import { Mythical } from "../src/history/MythicalHistory.vibe"
import { empty } from "../src/history/mythical.vibe"
import * as Runs from "../worker/ActionRuns.vibe"
import { world, request, history } from "../test/support/actionObjects.vibe"
import { artifact, workload, slow } from "./artifact.vibe"

it("SQLite actions preserve admission identity, terminal traces and cancellation", async ({ bench }) => {
  const result = await workload(bench, "action-host-recovery", async () => {
    await runPromise(scoped(effect {
      const w = try world()
      const post = request("apost", "vibelang/Post", { text: "Measured post" }, w.person.id)
      const accepted = try w.directory.start(post, "maintainer")
      const replayed = try w.directory.start(post, "maintainer")
      const conflict = try w.directory.start({ ...post, input: { text: "Changed" } }, "maintainer")
      const obj = try w.object(post.id)
      const recorded = try obj.sequencer.read(0)
      provide history {
        const product = try Mythical
        try obj.host.alarm(w.spend, w.model, product)
        try obj.host.alarm(w.spend, w.model, product)
        const runs = try Runs.read(obj.sequencer)
        const plan = request("acancel", "vibelang/history/Plan", { how: "append", epic: "", newEpic: "Bench", target: "", title: "Must not exist", task: "Cancelled" }, w.person.id)
        const planned = try w.directory.start(plan, "maintainer")
        const cancelled = try w.directory.cancel(plan.id, "maintainer", w.person.id)
        const planning = try w.object(plan.id)
        try planning.host.alarm(w.spend, w.model, product)
        const cancelledRuns = try Runs.read(planning.sequencer)
        const state = try product.outline()
        try Effect.try(() => {
          expect([accepted, replayed, conflict, planned, cancelled]).toEqual([null, null, "conflict", null, null])
          expect(recorded.entries.map(entry => entry.text)).toEqual(["Measured post"])
          expect(runs.map(run => [run.id, run.flow, run.state])).toEqual([["apost", "vibelang/Post", "passed"], ["apost-reply", "vibelang/Reply", "failed"]])
          expect(runs[0]?.steps.length).toBeGreaterThan(0)
          expect(runs[0]?.steps.every(step => step.state === "passed")).toBe(true)
          expect(cancelledRuns.map(run => [run.id, run.state])).toEqual([["acancel", "cancelled"]])
          expect(state.open).toEqual([])
          expect(state.seq).toBe(empty.seq)
        })
      }
    }))
  }).run(slow)
  await runPromise(artifact("action-host", "Vitest built-in bench; actual production action index/per-run hosts with real SQLite and product MockAccounts/Mythical services. Check once-only post acceptance, changed-input conflict, correlated terminal Post/Reply traces after two alarms, and cancelling a queued Plan before admission without any history mutation. Three new scoped worlds, migrations and assertions included.", ["Node SQLite/KV/alarm adapter, no workerd scheduling or remote storage. Deliberately unconfigured model fails the reply; no inference or GitHub mutation. The product mock provides local accounts/history."], result))
})

it("current role is rechecked before a queued action executes", async ({ bench }) => {
  const result = await workload(bench, "action-host-role-downgrade", async () => {
    await runPromise(scoped(effect {
      const w = try world()
      const plan = request("ademoted", "vibelang/history/Plan", { how: "append", epic: "", newEpic: "Bench", target: "", title: "Must not exist", task: "Forbidden" }, w.person.id)
      const accepted = try w.directory.start(plan, "maintainer")
      try w.accounts.grant(w.person.id, "new")
      const obj = try w.object(plan.id)
      provide history {
        const product = try Mythical
        try obj.host.alarm(w.spend, w.model, product)
        try obj.host.alarm(w.spend, w.model, product)
        const state = try product.outline()
        const runs = try Runs.read(obj.sequencer)
        try Effect.try(() => {
          expect(accepted).toBeNull()
          expect(state.seq).toBe(0)
          expect(state.open).toEqual([])
          expect(runs.map(run => [run.id, run.state, run.result])).toEqual([["ademoted", "failed", "Permission changed"]])
        })
      }
    }))
  }).run(slow)
  await runPromise(artifact("action-host-role-downgrade", "Vitest built-in bench; accept a real SQLite-backed history action, revoke its owner's role through product account flows, drive two alarms, then compare the terminal permission refusal and unchanged empty history. Three fresh worlds, setup and assertions included.", ["Product mock identities, no OAuth/provider call. Node SQLite/alarm host; measures admission/recovery overhead without a model."], result))
})
