import { it, expect as assert } from "@effect/vitest"
import { scene, given, expect, role, text, inside, expectAll, all } from "foldkit/scene"
import { newClient } from "../src/core/conversation.vibe"
import { init, Message, type Model, update } from "../src/web/main.vibe"
import { view } from "../src/web/view.vibe"
import { blocks, toHtml } from "../src/web/markdown.vibe"
import { transcript } from "./fixtures.vibe"
import { artifact, workload, quick } from "./artifact.vibe"

for (const length of [10, 1000, 100000]) {
  it(`web at ${length} entries`, async ({ bench }) => {
    const model: Model = { ...init({ session: "bench", name: "Ada", mode: "mock" }).model, surface: "chat", client: { ...newClient, conversation: transcript(length) } }
    const draft = Message.UpdatedDraft({ value: "service" })
    const event = Message.ReceivedEvent({ event: { type: "Posted", seq: length + 1, id: "new", clientId: "new", name: "Ada", text: "new post" } })
    const measurements = []
    measurements.push(await workload(bench, "keystroke-update", "sync", () => {
      const updated = update(model, draft).model
      assert(updated.draft).toBe("service")
      assert(updated.client).toBe(model.client)
    }).run(quick))
    measurements.push(await workload(bench, "incoming-event-update", "sync", () => {
      const updated = update(model, event).model
      assert(updated.client.conversation.entries.length).toBe(length + 1)
      assert(updated.client.conversation.entries.at(-1)?.text).toBe("new post")
    }).run(quick))
    // Scene rendering includes vnode generation, serialization and query traversal; it has no browser layout.
    measurements.push(await workload(bench, "view", "sync", () => {
      scene({ update, view }, given(model), inside(role("log", { name: "Conversation" }), expectAll(all.role("article")).toHaveCount(length), expect(text(`post ${length}`)).toExist()))
    }).run({ time: 0, iterations: 3, warmup: false }))
    await runPromise(artifact(`web-${length}`, "Vitest built-in bench. Immutable update on one draft keystroke and one received event; Foldkit scene renders the whole transcript and checks its exact scoped article count and tail. Setup excluded; assertions included; view 3 unwarmed samples.", ["Scene view includes serialization/query cost, no DOM patch/layout/paint. 100,000 entries may exceed a usable browser transcript; no virtualization exists."], measurements))
  })
}

it("streamed Markdown", async ({ bench }) => {
  const input = "Use `service`.\n\n```vibe\nservice Users {}\n```\n\nDone."
  const measurement = await workload(bench, "markdown-blocks", "sync", () => {
    assert(blocks(input)).toEqual([{ kind: "prose", text: "Use `service`." }, { kind: "code", language: "vibe", text: "service Users {}" }, { kind: "prose", text: "Done." }])
  }).run(quick)
  await runPromise(artifact("markdown", "Vitest built-in bench; parse a paragraph/code/paragraph answer; compare complete blocks.", ["Small fixed answer; rendering is measured separately."], measurement))
})

// Every block the compiler knows, as the wiki's build renders it: a fixed document, so coverage never depends on which
// pages the wiki happens to contain.
const DOCUMENT = [
  "# Benchmarks `pnpm`", "",
  "| Gate | Command |", "| --- | :-: |", "| unit | `a | b` |", "| **bench** | [run](gates.md) |", "",
  "- **VL-5.** No new", "  dependency without approval.", "- [** **](#top)",
  "1. [bad](javascript:alert(1))", "2. second", "",
  "> quoted", "> twice", "",
  "```ts", "const x = 1", "```",
  "Plain text", "continues.",
].join("\n")
const HTML = [
  '<h1 class="sui-md-heading sui-md-h1" id="benchmarks-pnpm">Benchmarks <code class="sui-md-inline-code">pnpm</code></h1>',
  '<table class="sui-table sui-md-table"><thead class="sui-md-thead"><tr class="sui-md-tr"><th class="sui-md-th">Gate</th><th class="sui-md-th">Command</th></tr></thead>'
    + '<tbody class="sui-md-tbody"><tr class="sui-md-tr"><td class="sui-md-td">unit</td><td class="sui-md-td"><code class="sui-md-inline-code">a | b</code></td></tr>'
    + '<tr class="sui-md-tr"><td class="sui-md-td"><strong class="sui-md-strong">bench</strong></td><td class="sui-md-td"><a class="sui-md-link" href="/wiki/gates">run</a></td></tr></tbody></table>',
  '<ul class="sui-md-list"><li class="sui-md-li" id="vl-5"><strong class="sui-md-strong">VL-5.</strong> No new dependency without approval.</li>'
    + '<li class="sui-md-li"><a class="sui-md-link" href="#top">#top</a></li></ul>',
  '<ol class="sui-md-list"><li class="sui-md-li">bad)</li><li class="sui-md-li">second</li></ol>',
  '<blockquote class="sui-md-blockquote">quoted twice</blockquote>',
  '<pre class="sui-md-pre"><code class="sui-md-code">const x = 1</code></pre>',
  '<p class="sui-md-p">Plain text\ncontinues.</p>',
].join("\n")

it("wiki Markdown: headings, tables, lists, quotes, code and links", async ({ bench }) => {
  const resolve = (href: string) => href.endsWith(".md") ? `/wiki/${href.slice(0, -3)}` : href
  const measurement = await workload(bench, "markdown-compile", "sync", () => {
    assert(toHtml(DOCUMENT, resolve)).toBe(HTML)
  }).run(quick)
  await runPromise(artifact("markdown-compile", "Vitest built-in bench; compile and render to HTML, as the wiki's build does, one fixed 21-line document with every block the compiler knows: heading with inline code, a table whose code cell holds a pipe, a list item continued on the next line with a ruling anchor, a link whose label has no visible text, a dashed list followed by a numbered one, an unsafe link left as text, a quote, a fence and a two-line paragraph. Exact HTML compared every call.", ["Fixed small document; the build-time wiki renders about 60 pages once per build. String rendering only; Foldkit rendering of the same tree is measured in the view workloads."], measurement))
})
