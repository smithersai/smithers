import { HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http"
import { type Conversation, type Event, type Entry, empty } from "../src/core/conversation.vibe"

/** Exact event count, one person post, one streaming reply, one-character deltas, then finish. */
export function history(length: number): ReadonlyArray<Event> {
  return [
    { type: "Posted", seq: 1, id: "m1", clientId: "c1", name: "Ada", text: "hi" },
    { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" },
    ...Array.from({ length: length - 3 }, (_, index): Event => ({ type: "ReplyDelta", seq: index + 3, id: "r1", text: "x" })),
    { type: "ReplyFinished", seq: length, id: "r1" },
  ]
}

/** A valid transcript of completed person posts; setup is outside the timed region. */
export function transcript(length: number): Conversation {
  const entries: Array<Entry> = Array.from({ length }, (_, i) => ({
    id: `m${i + 1}`, seq: i + 1, clientId: `c${i + 1}`, inReplyTo: "", author: "person", name: "Ada",
    text: `post ${i + 1}`, done: true, error: "",
  }))
  return { ...empty, seq: length, entries }
}

/** A valid internal history snapshot with one epic and N planned commits, oldest first. */
export function plannedHistory(length: number): import("../src/history/mythical.vibe").History {
  return {
    seq: length + 1, main: "", real: [], epics: [{ id: "e1", title: "Performance" }],
    commits: Array.from({ length }, (_, i) => ({ id: `m${i + 1}`, epic: "e1", rank: i, title: `Commit ${i}`, state: "planned", task: "Task", lane: "", notes: [] })),
  }
}

/** A real local deterministic model endpoint. It exercises the HTTP adapter, agent and QuickJS, without inference. */
export effect function modelService() {
  const server = try HttpServer.HttpServer
  try server.serve(effect {
    const request = try HttpServerRequest.HttpServerRequest
    const body = try request.text
    const tour = body.includes("Give the tour now.")
    const fence = "`".repeat(3)
    // "Bench tools." asks for a reply that calls the history and wiki tools and answers with what each returned.
    const tools = [
      `const outline = await ctx.call("vibelang/history/show", { what: "outline" });`,
      `const started = await ctx.call("vibelang/history/Start", { id: "bench", lane: "bench" });`,
      `let drafted; try { drafted = await ctx.call("vibelang/wiki/draft", { page: "roadmap", ask: "Bench" }); } catch (error) { drafted = String(error && error.message || error); }`,
      `ctx.done(JSON.stringify({ outline: outline.seq > 0, started, drafted }));`,
    ].join("\n")
    const cell = tour
      ? `${fence}cell\nctx.done({stops:["Deterministic tour 1.","Deterministic tour 2.","Deterministic tour 3.","Deterministic tour 4.","Deterministic tour 5."]});\n${fence}`
      : body.includes("Bench tools.") ? `${fence}cell\n${tools}\n${fence}` : `${fence}cell\nctx.done("Deterministic answer.");\n${fence}`
    return HttpServerResponse.text([
      `data: ${JSON.stringify({ id: "bench", object: "chat.completion.chunk", choices: [{ index: 0, delta: { role: "assistant", content: cell }, finish_reason: null }] })}\n\n`,
      `data: ${JSON.stringify({ id: "bench", object: "chat.completion.chunk", choices: [{ index: 0, delta: {}, finish_reason: "stop" }], usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 } })}\n\n`,
      "data: [DONE]\n\n",
    ].join(""), { contentType: "text/event-stream" })
  })
  return HttpServer.formatAddress(server.address).replace("0.0.0.0", "127.0.0.1").replace("[::]", "127.0.0.1")
}
