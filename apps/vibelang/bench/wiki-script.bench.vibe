// @vitest-environment node
import { it, expect } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { node, run } from "../test/support/processes.vibe"
import { artifact, workload, slow } from "./artifact.vibe"

it("wiki generation preserves links, metadata and prior output on failure", async ({ bench }) => {
  const result = await workload(bench, "wiki-script-journey", async () => {
    await runPromise(scoped(effect {
      provide NodeServices.layer, ExperimentalNodeServices.layer {
        const fs = try FileSystem.FileSystem
        const path = try Path.Path
        const root = try path.fromFileUrl(new URL("../dist-script-tests/", import.meta.url))
        const wiki = path.join(root, "wiki")
        const target = path.join(root, "src/assets/wiki.generated.vibe")
        try fs.remove(wiki, { recursive: true, force: true })
        try fs.makeDirectory(path.join(wiki, "decisions"), { recursive: true })
        try fs.makeDirectory(path.join(wiki, "designs"), { recursive: true })
        try fs.makeDirectory(path.dirname(target), { recursive: true })
        try Effect.addFinalizer(() => fs.remove(wiki, { recursive: true, force: true }).pipe(Effect.orDie))
        try Effect.addFinalizer(() => fs.remove(target, { force: true }).pipe(Effect.orDie))
        const input = {
          "index.md": "# Measured wiki\n\n[Rules](rulings.md#rules) [Design](designs/) [Decisions](decisions/) [External](https://example.test/) [Anchor](#measured-wiki)\n",
          "rulings.md": "# Rules\n",
          "designs/index.md": "# Designs\n\n[Home](../index.md)\n",
          "designs/ignore.html": "<h1>Ignored</h1>",
          "decisions/0000-no-heading.md": "Rulings: VL-2 VL-2 VL-7\nNo heading.\n",
          "decisions/0015-fuzzing.md": "# Fuzz\n\n**Status:** package landed\n**Rulings:** VL-14 VL-29\n2026-11-07\n",
          "decisions/0016-coverage.md": "# Coverage\n\n**Status:** in progress\n",
          "decisions/0018-proofs.md": "# Proofs\n\nStatus: superseded\n",
        }
        for (const [file, text] of Object.entries(input)) try fs.writeFileString(path.join(wiki, file), text)
        const executable = try node()
        const script = path.join(root, "scripts/wiki.js")
        const first = try run(executable, [script])
        const source = try fs.readFileString(target)
        const pages = try Effect.try(() => JSON.parse(/^export const pages = (.+)$/m.exec(source)![1]!) as Array<{ id: string; html: string; rulings: string[]; status: string; date: string; title: string }>)
        const suites = try Effect.try(() => JSON.parse(/^export const verificationSuites = (.+)$/m.exec(source)![1]!))
        const again = try run(executable, [script])
        const repeated = try fs.readFileString(target)
        try fs.remove(path.join(wiki, "decisions/0018-proofs.md"))
        const failed = try run(executable, [script])
        const preserved = try fs.readFileString(target)
        try fs.remove(wiki, { recursive: true })
        const missing = try run(executable, [script])
        const stillPreserved = try fs.readFileString(target)
        try Effect.try(() => {
          expect([first.status, again.status, failed.status, missing.status]).toEqual([0, 0, 1, 1])
          expect(first.stdout).toContain("wiki: 8 pages")
          expect(pages.map(page => page.id)).toEqual(["decisions", "decisions/0000-no-heading", "decisions/0015-fuzzing", "decisions/0016-coverage", "decisions/0018-proofs", "designs/index", "index", "rulings"])
          const home = pages.find(page => page.id === "index")!
          for (const href of ["/wiki/rulings#rules", "/wiki/designs/index", "/wiki/decisions", "https://example.test/", "#measured-wiki"]) expect(home.html).toContain(`href="${href}"`)
          expect(pages.find(page => page.id === "designs/index")?.html).toContain('href="/wiki/index"')
          expect(pages.find(page => page.id === "decisions/0000-no-heading")).toMatchObject({ title: "decisions/0000-no-heading", rulings: ["VL-2", "VL-7"], date: "" })
          expect(pages.find(page => page.id === "decisions/0018-proofs")?.status).toBe("Replaced")
          expect(suites).toEqual([
            { label: "Fuzz", state: "package landed", href: "/wiki/decisions/0015-fuzzing" },
            { label: "Coverage", state: "In progress", href: "/wiki/decisions/0016-coverage" },
            { label: "Proofs", state: "", href: "/wiki/decisions/0018-proofs" },
          ])
          expect(repeated).toBe(source); expect(preserved).toBe(source); expect(stillPreserved).toBe(source)
        })
      }
    }))
  }).run(slow)
  await runPromise(artifact("wiki-script", "Vitest built-in bench; actual emitted wiki generator over fixture files in the compiler's ignored output tree. Build twice, remove a required receipt and then the directory. Check exact page roster/order, nested/absolute/external/hash links, ruling deduplication, status/suite metadata, byte-identical second build and preserved output after both real read failures. Three complete four-process journeys; filesystem setup/assertions included, compilation excluded.", ["Small fixture wiki; not a full-site build throughput measurement. Child process startup, source loading and filesystem work included. Run independently of ordinary wiki-process tests, which use the same compiler fixture directory."], result))
})
