// @vitest-environment node
// `login` and `logout` through the live device flow: the real Accounts object over loopback beside the identity-provider
// fixture (test/support/deviceSignIn.vibe). No GitHub credential, no interception; GitHub's answer is the fixture's.
import { it, expect } from "@effect/vitest"
import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { readPending, readSession, removePending, writePending, writeSession, type PendingDevice } from "../src/surfaces/session.vibe"
import { signIn, signOutSurface, SignInFailed } from "../src/surfaces/signin.vibe"
import { configured, live, PERSON, world } from "../test/support/deviceSignIn.vibe"
import { artifact, workload, slow } from "./artifact.vibe"

/** Nothing listens on the discard port: a factory there refuses every connection. */
const CLOSED = "http://127.0.0.1:9"

const pendingFor = (origin: string): PendingDevice => ({ origin, clientId: "fixture-client-id", deviceCode: "private-device-code", userCode: "OLDC-ODE1", verificationUri: origin + "/device", intervalSeconds: 1, expiresAt: Date.now() + 600_000, nextPollAt: 0 })
const refusal = <A, E, R>(program: A!E!R) => Effect.flip(program).pipe(Effect.map(error => (error as unknown as SignInFailed).message))

it("a person signs in with a device code, is remembered, and signs out", async ({ bench }) => {
  const result = await workload(bench, "signin-device", "async", () => runPromise(scoped(effect {
    provide NodeServices.layer, NodeHttpServer.layerTest, live {
      const { origin, grant, interval } = try world()
      try Ref.set(interval, 0)
      const directory = try (try FileSystem.FileSystem).makeTempDirectoryScoped()
      provide configured(origin, directory) {
    const started = try signIn({ wait: false })
    const pending = try signIn({ wait: false })
    try Ref.set(grant, "authorized")
    const signed = try signIn({ wait: false })
    const remembered = try signIn({ wait: false })
    const out = try signOutSurface()
    const left = try readSession()
    try Effect.try(() => {
      expect(started).toEqual({ status: "started", login: "", userCode: "ABCD-EFGH", verificationUri: origin + "/device" })
      expect(pending.status).toBe("pending")
      expect([signed.status, signed.login, remembered.login]).toEqual(["signed-in", PERSON.login, PERSON.login])
      expect([out, left]).toEqual([{ signedOut: true }, undefined])
    })
      }
    }
  }))).run(slow)
  await runPromise(artifact("signin-device", "Vitest built-in bench; actual signIn/signOutSurface over real loopback HTTP to the Accounts object and the identity-provider device fixture, fresh world per sample. Start, pending poll, authorized poll, remembered session, revoking sign-out. Exact statuses and an empty settings directory checked.", ["The identity provider is a local fixture: GitHub's latency and rate limits are absent.", "The fixture interval is 0 s, so no poll waits."], result))
})

it("GitHub's refusals end or slow the device flow", async ({ bench }) => {
  const result = await workload(bench, "signin-device-refusals", "async", () => runPromise(scoped(effect {
    provide NodeServices.layer, NodeHttpServer.layerTest, live {
      const { origin, grant, interval } = try world()
      try Ref.set(interval, 0)
      const directory = try (try FileSystem.FileSystem).makeTempDirectoryScoped()
      provide configured(origin, directory) {
    const answers: Array<string> = []
    for (const answer of ["access_denied", "expired_token"]) {
      try writePending(pendingFor(origin))
      try Ref.set(grant, answer)
      answers.push(try refusal(signIn({ wait: false })))
    }
    try writePending(pendingFor(origin))
    try Ref.set(grant, "slow_down")
    const slowed = try signIn({ wait: false })
    const backedOff = try readPending()
    try writeSession({ origin, cookie: "vibelang-session=forged", login: "old" })
    try Ref.set(grant, "authorization_pending")
    const restarted = try signIn({ wait: false })
    // A new flow: `login` announces the code and waits through waitForSignIn until the person answers.
    try removePending()
    try Ref.set(grant, "access_denied")
    const declined = try refusal(signIn({ wait: true }))
    try Effect.try(() => {
      expect(answers).toEqual(["Sign-in declined.", "Sign-in expired."])
      expect([slowed.status, backedOff?.intervalSeconds]).toEqual(["pending", 30])
      expect(restarted).toMatchObject({ status: "pending" })
      expect(declined).toBe("Sign-in declined.")
    })
      }
    }
  }))).run(slow)
  await runPromise(artifact("signin-device-refusals", "Vitest built-in bench; actual signIn over real loopback HTTP to the Accounts object and the identity-provider device fixture. Declined, expired, slow-down back-off, a forged stored session, and a waited sign-in the person declines. Exact sentences and the 30 s back-off checked.", ["The identity provider is a local fixture.", "The slowed flow is not waited out."], result))
})

// signinDecision's refusalOf/refusalMessage "failed" answer: a poll that fails while `login` waits is neither declined nor expired.
it("a waited sign-in whose poll GitHub rejects ends Sign-in failed", async ({ bench }) => {
  const result = await workload(bench, "signin-device-wait-failed", "async", () => runPromise(scoped(effect {
    provide NodeServices.layer, NodeHttpServer.layerTest, live {
      const { origin, grant, interval } = try world()
      try Ref.set(interval, 0)
      const directory = try (try FileSystem.FileSystem).makeTempDirectoryScoped()
      provide configured(origin, directory) {
        const answers: Array<string> = []
        // GitHub answers an error the device flow doesn't define, then authorizes someone the factory doesn't know.
        for (const answer of ["incorrect_device_code", "unknown-person"]) {
          try removePending()
          try Ref.set(grant, answer)
          answers.push(try refusal(signIn({ wait: true })))
        }
        const session = try readSession()
        try Effect.try(() => {
          expect(answers).toEqual(["Sign-in failed.", "Sign-in failed."])
          expect(session).toBeUndefined()
        })
      }
    }
  }))).run(slow)
  await runPromise(artifact("signin-device-wait-failed", "Vitest built-in bench; actual signIn with wait over real loopback HTTP to the Accounts object and the identity-provider device fixture, fresh world per sample. While login waits, GitHub's token endpoint answers an undefined error, then a token for a person the factory doesn't know. Checks each wait ends with Sign-in failed. and no session is stored.", ["Identity-provider fixture, not GitHub.", "The wait's journal is the real node:sqlite flow host in a temporary directory."], result))
})

it("a waited sign-in succeeds, and an unreachable factory or unwritable settings end it with one sentence", async ({ bench }) => {
  const result = await workload(bench, "signin-device-faults", "async", () => runPromise(scoped(effect {
    provide NodeServices.layer, NodeHttpServer.layerTest, live {
      const { origin, grant, interval } = try world()
      try Ref.set(interval, 0)
      const fs = try FileSystem.FileSystem
      const directory = try fs.makeTempDirectoryScoped()
      // `login` waits through the poll the person authorizes.
      const waited = try (effect {
        try Ref.set(grant, "authorized")
        return try signIn({ wait: true })
      }).pipe(Effect.provide(configured(origin, directory)))
      const out = try signOutSurface().pipe(Effect.provide(configured(origin, directory)))
      // GitHub grants the device, but the factory that should turn it into a session is gone.
      const grantLost = try (effect {
        try writePending(pendingFor(CLOSED))
        return try refusal(signIn({ wait: false }))
      }).pipe(Effect.provide(configured(CLOSED, directory, origin)))
      const keptPending = try readPending().pipe(Effect.provide(configured(CLOSED, directory, origin)))
      // A remembered session whose factory is gone: sign-out reports it, and the session is still forgotten.
      const signOutLost = try (effect {
        try removePending()
        try writeSession({ origin: CLOSED, cookie: "vibelang-session=forged", login: "old" })
        return try refusal(signOutSurface())
      }).pipe(Effect.provide(configured(CLOSED, directory)))
      const forgotten = try readSession().pipe(Effect.provide(configured(CLOSED, directory)))
      // The settings directory works, but the pending flow can't be written: a directory holds its file's place.
      const blocked = try fs.makeTempDirectoryScoped()
      try fs.makeDirectory(`${blocked}/vibelang-factory/device.json/held`, { recursive: true })
      const unwritable = try refusal(signIn({ wait: false })).pipe(Effect.provide(configured(origin, blocked)))
      try Effect.try(() => {
        expect([waited.status, waited.login, out.signedOut]).toEqual(["signed-in", PERSON.login, true])
        expect(grantLost).toBe(`Sign-in at ${CLOSED} can't be reached.`)
        expect(keptPending?.origin).toBe(CLOSED)
        expect([signOutLost, forgotten]).toEqual(["Sign-out couldn't reach the factory.", undefined])
        expect(unwritable).toBe("The sign-in settings couldn't be written.")
      })
    }
  }))).run(slow)
  await runPromise(artifact("signin-device-faults", "Vitest built-in bench; actual signIn/signOutSurface over real loopback HTTP to the Accounts object and the identity-provider device fixture, fresh world per sample. A waited sign-in the person authorizes, then sign-out; a device grant whose factory refuses connections (discard port 9); a sign-out whose factory refuses connections; a pending-flow file that can't be written. Exact sentences, the kept pending flow and the forgotten session checked.", ["The identity provider is a local fixture.", "Unreachable means a refused loopback connection, not a DNS failure or timeout."], result))
})
