// @vitest-environment node
// Every issue write as the site runs it after decision 0165: worker/Issues.vibe's durable flows over SQLite, each write
// through smithers.sh's real per-person connection host (fuzz/delegated.vibe) to real GitHub's recorded answers for
// codeplanesmithers/smithers-vibelang-e2e (test/recordings/issues.json, ruling VL-36). The bench always replays: it
// never writes to GitHub. Nothing intercepts a request.
import * as NodeServices from "@effect/platform-node/NodeServices"
import { it, expect } from "@effect/vitest"
import { HttpRecording } from "@smthrs/testing"
import { recordingPath } from "../test/support/github.vibe"
import { issuesWorld, journey, journeyResult } from "../test/support/issuesWorld.vibe"
import { artifact, workload, slow } from "./artifact.vibe"

it("issues: every maintainer write through smithers.sh's delegation", async ({ bench }) => {
  const label = (await runPromise(HttpRecording.load(await runPromise(recordingPath("issues"))).pipe(Effect.provide(NodeServices.layer)))).label ?? "issues"
  const seen: Array<unknown> = []
  const result = await workload(bench, "issues-delegated-writes", "async", async () => {
    seen.push(await runPromise(scoped(effect { return try journey(try issuesWorld("issues", "replay")) })))
  }).run(slow)
  expect(seen.length).toBeGreaterThan(0)
  for (const each of seen) expect(each).toEqual(journeyResult(label))
  await runPromise(artifact("issues-delegated-writes", "Vitest built-in bench; worker/Issues.vibe's durable flows over Node SQLite object storage, a fresh store and a fresh replay each callback. One maintainer journey: new issue, split, comment, VIP proposal (branch, commit, review, issue), link, commit to the agent, uncommit, accept the VIP, decline a second claim on its review. Every write goes through smithers.sh's real per-person connection host to real GitHub's recorded answers (test/recordings/issues.json). Checked every callback: each write's visible result (title, author, parent, note, VIP state and review, task, assignee, labels, approver, closed state) and the person's write count.", ["Recorded GitHub answers, not api.github.com: no network, rate limit or GitHub latency. Node SQLite storage, not a Durable Object. Recording and passthrough runs are test/issues.github.test.vibe with VIBE_GITHUB."], { seen, result }))
}, 120_000)
