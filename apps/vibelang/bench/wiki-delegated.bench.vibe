// @vitest-environment node
// A wiki edit as the site runs it after decision 0165: worker/Wiki.vibe's durable flows over SQLite, every GitHub read
// and write through smithers.sh's real per-person connection host (fuzz/delegated.vibe) to real GitHub's recorded
// answers for codeplanesmithers/smithers-vibelang-e2e (test/recordings/wiki.json, ruling VL-36). The bench always
// replays: it never writes to GitHub. Nothing intercepts a request.
import { it, expect } from "@effect/vitest"
import { journey, journeyResult, wikiWorld } from "../test/support/wikiWorld.vibe"
import { artifact, workload, slow } from "./artifact.vibe"

it("wiki: read, drafted edit, save and proposal through smithers.sh's delegation", async ({ bench }) => {
  const seen: Array<unknown> = []
  const result = await workload(bench, "wiki-delegated-edit", "async", async () => {
    seen.push(await runPromise(scoped(effect { return try journey(try wikiWorld("wiki", "replay")) })))
  }).run(slow)
  expect(seen.length).toBeGreaterThan(0)
  for (const each of seen) expect(each).toEqual(journeyResult)
  await runPromise(artifact("wiki-delegated-edit", "Vitest built-in bench; worker/Wiki.vibe's durable flows over Node SQLite object storage, a fresh store and a fresh replay each callback. One maintainer reads a page on a disposable base branch, asks the writer for a draft (kept for the person), saves it (one branch, commit and review of exactly that file; the kept text cleared), then proposes a second change from the same base. Every GitHub call goes through smithers.sh's real per-person connection host to real GitHub's recorded answers (test/recordings/wiki.json). Checked every callback: the page source, the draft and its kept copy, the cleared draft, each review's title, author, base, changed file and head text, the base left untouched, and the person's write count. Store setup, the fixture branch, four flows and their re-reads included.", ["Recorded GitHub answers, not api.github.com: no network, rate limit or GitHub latency. Node SQLite storage, not a Durable Object. The writer is a deterministic WikiWriter service, not the model; the model-written draft is the opt-in live path. Recording and passthrough runs are test/wikiEdit.github.test.vibe with VIBE_GITHUB."], { seen, result }))
}, 120_000)
