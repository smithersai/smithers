// The sandbox policy kernel's refusals, each leaving the ledger as it was: a role that may not start, an allowance
// that's used up, a stop with nothing running, and a new sandbox without a usable id.
// Then the mock machine's commands at their edges: a stale generation, a listing, and a blank command.
import { describe, expect, it } from "@effect/vitest"
import { decideSandbox, emptySandboxLedger, type SandboxIntent, type SandboxLedger } from "../src/core/sandboxDecision.vibe"
import { memoryMachines } from "../src/core/sandboxMock.vibe"

const HOUR = 3_600_000
const ledger: SandboxLedger = { ...emptySandboxLedger("ada", "contributor", HOUR, 202611, 1000), sandboxes: [{ id: "s1", conversation: "c1", running: true }] }
const intent = (over: Partial<SandboxIntent>): SandboxIntent => ({ type: "start", conversation: "c2", sandboxId: "s2", operationId: "op", ...over })

describe("a refused start or stop leaves the ledger as it was", () => {
  it.each([
    ["a start by a role that may not start one", { ...ledger, role: "community" as const }, {}, "forbidden"],
    ["a start once the allowance is used up", { ...ledger, usedMilliseconds: HOUR }, {}, "out-of-minutes"],
    ["a stop where nothing runs", ledger, { type: "stop" as const }, "stopped"],
    ["a new sandbox with no id", ledger, { sandboxId: "" }, "invalid"],
    ["a new sandbox with another conversation's id", ledger, { sandboxId: "s1" }, "invalid"],
  ] as const)("%s is refused as %s", (_name, before, over, refusal) => {
    expect(decideSandbox(before, intent(over))).toEqual({ ok: false, refusal, state: before })
  })

  it("an accepted start charges nothing: the meter already ran", () => {
    const decision = decideSandbox(ledger, intent({}))
    expect(decision).toMatchObject({ ok: true, event: { state: { usedMilliseconds: 0, lastMeteredAt: 1000, sequence: 1 } } })
  })
})

describe("the mock machine", () => {
  it.effect("a command for a generation that was replaced is unavailable", () => effect {
    const machines = memoryMachines()
    try machines.start("m1", 1)
    try machines.start("m1", 2)
    const failure = try Effect.flip(machines.command("m1", 1, "op1", "pwd"))
    try Effect.try(() => expect(failure).toMatchObject({ _tag: "Unavailable", reason: "stale-generation" }))
  })

  it.effect("ls lists the files written, and a blank command answers nothing", () => effect {
    const machines = memoryMachines()
    try machines.start("m1", 1)
    const empty = try machines.command("m1", 1, "op1", "ls")
    try machines.command("m1", 1, "op2", "echo a > a.txt")
    try machines.command("m1", 1, "op3", "echo b > notes/b.txt")
    const listed = try machines.command("m1", 1, "op4", "ls")
    const blank = try machines.command("m1", 1, "op5", "   ")
    try Effect.try(() => { expect(empty).toBe(""); expect(listed).toBe("a.txt  notes/b.txt"); expect(blank).toBe("") })
  })

  it.effect("a machine that never started holds no lease and runs no command", () => effect {
    const machines = memoryMachines()
    const lease = try machines.lease("never", 1, 1000)
    const command = try Effect.flip(machines.command("never", 1, "op1", "pwd"))
    try Effect.try(() => { expect(lease).toBe(false); expect(command).toMatchObject({ _tag: "Unavailable", reason: "stale-generation" }) })
  })
})
