// Compile the real mock before runtime responsiveness assertions; browser tests cover cold asset loading.
import "../src/core/MockFactory.vibe"
import { expect, it } from "@effect/vitest"
import { vi } from "vitest"
import { Runtime } from "foldkit"
import { main, page } from "../src/web/startup.vibe"
import { heldHealth } from "./support/heldHealth.vibe"
import { activeId, commandK, container, hasAsk, remove, send } from "./support/browser.ts"

it.live("renders and handles Command K and a post while health is still unresolved", () => scoped(effect {
  const node = try acquireRelease(sync(container), (node) => sync(() => remove(node)))
  try Effect.try(() => {
    const root = node.ownerDocument.createElement("div")
    root.id = "root"
    node.append(root)
  })
  const health = try heldHealth()
  const boot = fork Effect.provide(effect {
    const { application, flags } = try main()
    try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
    try Effect.never
  }, Layer.mergeAll(page, health.layer, Layer.succeed(Clock.Clock, health.deadlineClock)))
  try promise(() => vi.waitFor(() => expect(health.snapshot().calls).toBe(1)))
  // Health cannot answer during either assertion. The old startup blocks here until its three-second timeout.
  try promise(() => vi.waitFor(() => expect(hasAsk()).toBe(true), { timeout: 500 }))
  try sync(commandK)
  try promise(() => vi.waitFor(() => expect(activeId()).toBe("vl-palette-prompt"), { timeout: 500 }))
  try sync(() => send("What is a service?"))
  try Effect.try(() => expect(health.snapshot()).toEqual({ calls: 1, settled: false, cancelled: false }))
  try health.release("mock")
  try promise(() => vi.waitFor(() => expect(node.querySelector("[data-role='assistant'][data-done='true']")).not.toBeNull(), { timeout: 4000 }))
  try Effect.try(() => {
    expect(node.querySelector(".vl-pill")?.textContent).toBe("Mock")
    expect(health.snapshot()).toEqual({ calls: 1, settled: true, cancelled: false })
  })
  try Fiber.interrupt(boot)
}))

it.live("names each page load with a full random UUID, so sandbox operation ids do not collide", () => scoped(effect {
  const node = try acquireRelease(sync(container), (node) => sync(() => remove(node)))
  try Effect.try(() => {
    const root = node.ownerDocument.createElement("div")
    root.id = "root"
    node.append(root)
  })
  const health = try heldHealth()
  const sessions = try Effect.provide(effect {
    const first = (try main()).flags.session
    const second = (try main()).flags.session
    return [first, second]
  }, Layer.mergeAll(page, health.layer, Layer.succeed(Clock.Clock, health.deadlineClock)))
  try Effect.try(() => {
    // 122 random bits: an operation id `${session}/sandbox/${n}` repeats across page loads only by chance that small.
    for (const session of sessions) expect(session).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/)
    expect(sessions[0]).not.toBe(sessions[1])
  })
}))
