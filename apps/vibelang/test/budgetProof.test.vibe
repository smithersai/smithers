import { describe, expect, it } from "@effect/vitest"
import { make, OVER, RESERVED, SPENT, type Ledger } from "../worker/Budget.vibe"
import { reserveAdmissible, settleAdmissible } from "../worker/budgetDecision.vibe"

// A real in-memory ledger; the budget owns the semaphore and all accounting.
effect function ledger() {
  const values = try Ref.make<Readonly<Record<string, number>>>({})
  const storage: Ledger = {
    read: (key) => Ref.get(values).pipe(map((entries) => entries[key])),
    write: (entries) => Ref.update(values, (current) => ({ ...current, ...entries })),
  }
  return { storage, values }
}

describe("the daily ledger's accounting", () => {
  it("runs the kernel only inside its precondition: nonnegative totals, a positive ceiling, a hold within the reservations", () => {
    const max = Number.MAX_SAFE_INTEGER
    expect([reserveAdmissible(0, 0, 0, 0, 1), reserveAdmissible(0, 0, 0, -1, 1), reserveAdmissible(0, 0, 0, 0, 0), reserveAdmissible(max - 2, 1, 0, 0, 1), reserveAdmissible(max - 2, 2, 0, 0, 1)]).toEqual([true, false, false, true, false])
    expect([settleAdmissible(0, 5, 0, 5, 0, 1), settleAdmissible(0, 4, 0, 5, 0, 1), settleAdmissible(0, 5, 0, 5, -1, 1), settleAdmissible(0, 5, max - 1, 5, 0, 1), settleAdmissible(0, 5, max, 5, 0, 1)]).toEqual([true, false, false, true, false])
  })
  it.effect("a stored hold larger than the open reservations stops settlement instead of freeing more than was reserved", () => effect {
    const { storage } = try ledger()
    try storage.write({ [SPENT]: 0, [RESERVED]: 10, [OVER]: 0, "hold/r": 20 })
    const budget = try make(storage, 1000)
    const exit = try Effect.exit(budget.spend("r", 5, true, 40))
    expect(exit._tag).toBe("Failure")
  })
  it.effect("an unusable report charges the call's whole ceiling, never zero or the partial sum", () => effect {
    const { storage, values } = try ledger()
    const budget = try make(storage, 1000)
    for (const reply of ["nan", "infinity", "negative", "absent"]) try budget.admit(reply, 40)
    try budget.spend("nan", Number.NaN, true, 40)
    try budget.spend("infinity", Number.POSITIVE_INFINITY, true, 40)
    try budget.spend("negative", -10, true, 40)
    try budget.spend("absent", 7, false, 40)
    try budget.spend("valid", 12.6, true, 40)
    const saved = try Ref.get(values)
    try Effect.try(() => {
      expect(saved[SPENT]).toBe(4 * 40 + 13)
      expect(saved["reply/absent"]).toBe(40)
      expect(saved["reply/valid"]).toBe(13)
      expect(saved[RESERVED]).toBe(0)
      expect(saved[OVER]).toBe(13)
    })
  })

  it.effect("concurrent repeated spends count one charge per reply and admission stops at the limit", () => effect {
    const { storage, values } = try ledger()
    const budget = try make(storage, 12)
    try all([budget.spend("a", 5, true, 5), budget.spend("a", 5, true, 5), budget.spend("b", 7, true, 7)], { concurrency: "unbounded" })
    const saved = try Ref.get(values)
    const admitted = try budget.admit("c", 1)
    try Effect.try(() => {
      expect(saved).toMatchObject({ spent: 12, "reply/a": 5, "reply/b": 7 })
      expect(admitted).toBe(false)
    })
  })
})

it.effect("an overflowing charge is refused; an unsafe report is charged its ceiling", () => effect {
  const { storage, values } = try ledger()
  const budget = try make(storage, Number.MAX_SAFE_INTEGER)
  try budget.spend("first", Number.MAX_SAFE_INTEGER - 2, true, 1)
  const overflow = try Effect.exit(budget.spend("overflow", 3, true, 1))
  try budget.spend("unsafe", Number.MAX_VALUE, true, 1)
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(Exit.isFailure(overflow)).toBe(true)
    expect(saved).toMatchObject({ spent: Number.MAX_SAFE_INTEGER - 1, "reply/first": Number.MAX_SAFE_INTEGER - 2, "reply/unsafe": 1 })
    expect(saved["reply/overflow"]).toBeUndefined()
  })
})

it.effect("invalid persisted totals cannot be used for a new charge", () => effect {
  const { storage, values } = try ledger()
  try storage.write({ spent: -5 })
  const budget = try make(storage, 100)
  const result = try Effect.exit(budget.spend("reply", 3, true, 10))
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(Exit.isFailure(result)).toBe(true)
    expect(saved).toEqual({ spent: -5 })
  })
})

it.effect("corrupt persisted totals, reservations or ceilings cannot admit a model call", () => effect {
  for (const [key, total] of [...[-5, -Infinity, NaN, Infinity, 0.5, Number.MAX_SAFE_INTEGER + 1].flatMap((value) => [[SPENT, value], [RESERVED, value], [OVER, value]] as const), ["hold/a", -1] as const]) {
    const { storage, values } = try ledger()
    try storage.write({ [key]: total })
    const budget = try make(storage, 100)
    const admission = try Effect.exit(budget.admit("a", 10))
    const saved = try Ref.get(values)
    try Effect.try(() => {
      expect(Exit.isFailure(admission)).toBe(true)
      expect(saved).toEqual({ [key]: total })
    })
  }
  for (const ceiling of [0, -1, 0.5, NaN, Infinity]) {
    const { storage } = try ledger()
    const budget = try make(storage, 100)
    const admission = try Effect.exit(budget.admit("a", ceiling))
    try Effect.try(() => expect(Exit.isFailure(admission)).toBe(true))
  }
})

it.effect("the final safe charge is exact and its replay ignores oversized telemetry", () => effect {
  const { storage, values } = try ledger()
  const budget = try make(storage, Number.MAX_SAFE_INTEGER - 3)
  try budget.spend("first", Number.MAX_SAFE_INTEGER - 4, true, 1)
  try budget.spend("last", 1, true, 1)
  try budget.spend("last", Number.MAX_VALUE, true, 1)
  const admitted = try budget.admit("more", 1)
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(admitted).toBe(false)
    expect(saved).toMatchObject({ spent: Number.MAX_SAFE_INTEGER - 3, "reply/first": Number.MAX_SAFE_INTEGER - 4, "reply/last": 1 })
  })
})
