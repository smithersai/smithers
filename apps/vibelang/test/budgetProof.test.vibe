import { describe, expect, it } from "@effect/vitest"
import { make, SPENT, type Ledger } from "../worker/Budget.vibe"

// A real in-memory ledger; the budget owns the semaphore and all accounting.
effect function ledger() {
  const values = try Ref.make<Readonly<Record<string, number>>>({})
  const storage: Ledger = {
    read: (key) => Ref.get(values).pipe(map((entries) => entries[key])),
    write: (entries) => Ref.update(values, (current) => ({ ...current, ...entries })),
  }
  return { storage, values }
}

describe("the daily ledger's accounting", () => {
  it.effect("invalid usage cannot poison admission or a later valid spend", () => effect {
    const { storage, values } = try ledger()
    const budget = try make(storage, 100)
    try budget.spend("nan", Number.NaN)
    try budget.spend("infinity", Number.POSITIVE_INFINITY)
    try budget.spend("negative", -10)
    try budget.spend("valid", 12.6)
    const saved = try Ref.get(values)
    const admitted = try budget.admit()
    try Effect.try(() => {
      expect(saved[SPENT]).toBe(13)
      expect(saved["reply/valid"]).toBe(13)
      expect(admitted).toBe(true)
    })
  })

  it.effect("concurrent repeated spends count one charge per reply and admission stops at the limit", () => effect {
    const { storage, values } = try ledger()
    const budget = try make(storage, 12)
    try all([budget.spend("a", 5), budget.spend("a", 5), budget.spend("b", 7)], { concurrency: "unbounded" })
    const saved = try Ref.get(values)
    const admitted = try budget.admit()
    try Effect.try(() => {
      expect(saved).toEqual({ spent: 12, "reply/a": 5, "reply/b": 7 })
      expect(admitted).toBe(false)
    })
  })
})

it.effect("usage overflow cannot corrupt the sum of recorded spends", () => effect {
  const { storage, values } = try ledger()
  const budget = try make(storage, Number.MAX_SAFE_INTEGER)
  try budget.spend("first", Number.MAX_SAFE_INTEGER - 1)
  const overflow = try Effect.exit(budget.spend("overflow", 3))
  const unsafe = try Effect.exit(budget.spend("unsafe", Number.MAX_VALUE))
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(Exit.isFailure(overflow)).toBe(true)
    expect(Exit.isFailure(unsafe)).toBe(true)
    expect(saved).toEqual({ spent: Number.MAX_SAFE_INTEGER - 1, "reply/first": Number.MAX_SAFE_INTEGER - 1 })
  })
})

it.effect("invalid persisted totals cannot be used for a new charge", () => effect {
  const { storage, values } = try ledger()
  try storage.write({ spent: -5 })
  const budget = try make(storage, 100)
  const result = try Effect.exit(budget.spend("reply", 3))
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(Exit.isFailure(result)).toBe(true)
    expect(saved).toEqual({ spent: -5 })
  })
})

it.effect("corrupt persisted totals cannot admit a model call", () => effect {
  for (const total of [-5, -Infinity, NaN, Infinity, 0.5, Number.MAX_SAFE_INTEGER + 1]) {
    const { storage, values } = try ledger()
    try storage.write({ spent: total })
    const budget = try make(storage, 100)
    const admission = try Effect.exit(budget.admit())
    const saved = try Ref.get(values)
    try Effect.try(() => {
      expect(Exit.isFailure(admission)).toBe(true)
      expect(saved).toEqual({ spent: total })
    })
  }
})

it.effect("the final safe charge is exact and its replay ignores oversized telemetry", () => effect {
  const { storage, values } = try ledger()
  const budget = try make(storage, Number.MAX_SAFE_INTEGER)
  try budget.spend("first", Number.MAX_SAFE_INTEGER - 1)
  try budget.spend("last", 1)
  try budget.spend("last", Number.MAX_VALUE)
  const admitted = try budget.admit()
  const saved = try Ref.get(values)
  try Effect.try(() => {
    expect(admitted).toBe(false)
    expect(saved).toEqual({ spent: Number.MAX_SAFE_INTEGER, "reply/first": Number.MAX_SAFE_INTEGER - 1, "reply/last": 1 })
  })
})
