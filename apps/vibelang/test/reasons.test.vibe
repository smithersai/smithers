import { ModelError } from "@smthrs/model"
import { describe, expect, it } from "@effect/vitest"
import { REASONS, reasonOf, tagOf } from "../worker/Reply.vibe"

function failure(code: ModelError.ModelError["code"]) {
  return new ModelError.ModelError({ code, message: "a provider's own words, which a person never reads" })
}

describe("the reason a person reads for a provider error", () => {
  it("a provider out of credit or over its quota is the provider's billing, not the deployment's daily budget", () => {
    // Production, 2026-11-07: Cerebras answered 402 payment_required and every reply read "daily budget is spent".
    expect(reasonOf(failure("out_of_credit"))).toBe(REASONS.credit)
    expect(reasonOf(failure("quota_exceeded"))).toBe(REASONS.credit)
    expect(REASONS.credit).not.toBe(REASONS.budget)
  })

  it("a refusal reads as a refusal and anything else as the model being unavailable", () => {
    expect(reasonOf(failure("content_policy"))).toBe(REASONS.refused)
    expect(reasonOf(failure("rate_limited"))).toBe(REASONS.unavailable)
  })
})

it("failure tags never coerce an arbitrary object", () => {
  expect(tagOf({ _tag: { toString: 0 } })).toBe("defect")
  expect(tagOf({ _tag: "ProviderError" })).toBe("ProviderError")
})
