import { describe, expect, it } from "@effect/vitest"
import { Post } from "../src/core/flows.vibe"
import { agentRun, agentRunsSettle, postFlow } from "../worker/actionsDecision.vibe"
import { actionsRoute, callerActor, cancelFlow, crossOriginWrite, declaredTooLarge, runIdValid, runRoute, startActor, startConflict, writeStatus } from "../worker/actionsDecision.vibe"
import { ACTIONS_PATH } from "../src/actions/wire.vibe"

describe("the Actions protocol's and directory's decisions", () => {
  it("refuses a declared body that is not digits or is over the limit", () => {
    expect([declaredTooLarge(undefined, Number.NaN), declaredTooLarge("32000", 32000), declaredTooLarge("32001", 32001), declaredTooLarge("1e3", 1000), declaredTooLarge("", 0)]).toEqual([false, false, true, true, true])
  })
  it("refuses only a write from another page; a request without Origin is no page", () => {
    expect([crossOriginWrite("GET", "https://evil.example", "https://site"), crossOriginWrite("POST", undefined, "https://site"), crossOriginWrite("POST", "https://site", "https://site"), crossOriginWrite("DELETE", "https://evil.example", "https://site")]).toEqual([false, false, false, true])
  })
  it("routes the collections at the shared path and everything else to one run", () => {
    expect(ACTIONS_PATH).toBe("/api/actions")
    expect([actionsRoute("/api/actions", "GET"), actionsRoute("/api/actions/commands", "GET"), actionsRoute("/api/actions/runs", "GET"), actionsRoute("/api/actions/runs", "POST"), actionsRoute("/api/actions", "POST"), actionsRoute("/api/actions/runs/a1", "GET")]).toEqual(["flows", "commands", "runs", "start", "run", "run"])
    expect([runRoute("POST", 2, "rerun"), runRoute("GET", 2, "events"), runRoute("GET", 1, ""), runRoute("DELETE", 1, ""), runRoute("GET", 2, "rerun"), runRoute("POST", 1, ""), runRoute("DELETE", 2, "events")]).toEqual(["rerun", "events", "read", "cancel", "", "", ""])
  })
  it("accepts run ids of a and 1 to 64 more characters", () => {
    expect([runIdValid("a1"), runIdValid("a"), runIdValid("b1"), runIdValid("a" + "x".repeat(64)), runIdValid("a" + "x".repeat(65)), runIdValid("a_1")]).toEqual([true, false, false, true, false, false])
  })
  it("answers a write's refusal and names who acted", () => {
    expect([writeStatus(null, 202, 409), writeStatus("forbidden", 202, 409), writeStatus("busy", 202, 409), writeStatus("missing", 200, 404)]).toEqual([202, 403, 409, 404])
    expect([startActor(true, "button"), startActor(false, "agent"), startActor(false, "slash"), startActor(false, undefined), callerActor(true), callerActor(false)]).toEqual(["agent", "agent", "person", "person", "agent", "person"])
  })
  it("refuses a different request under a used id and cancels a reply child as its Post", () => {
    expect([startConflict(undefined, "{}"), startConflict("{}", "{}"), startConflict("{\"a\":1}", "{}")]).toEqual([false, false, true])
    expect([cancelFlow(true, "vibelang/Post", "vibelang/Reply"), cancelFlow(false, "vibelang/Post", "vibelang/Reply")]).toEqual(["vibelang/Post", "vibelang/Reply"])
  })
})

describe("a post's reply child and its agent runs", () => {
  it("reserves a child only for a post, and settles the agent's runs once the reply is done", () => {
    expect([postFlow("vibelang/Post"), postFlow("vibelang/Tour"), postFlow("vibelang/Post2"), postFlow("")]).toEqual([true, false, false, false])
    expect([agentRunsSettle("vibelang/Post", true), agentRunsSettle("vibelang/Post", false), agentRunsSettle("vibelang/Tour", true)]).toEqual([true, false, false])
    expect([agentRun("agent"), agentRun("person"), agentRun("")]).toEqual([true, false, false])
    expect(Post._tag).toBe("vibelang/Post")
  })
})
