// The workerd test's API Worker (test/live.workerd.test.vibe): plain Durable Objects over the same code the Alchemy ones
// in worker/Api.vibe run (worker/Objects.vibe, worker/Http.vibe), so local workerd runs the real sequencer, the real
// reply flow on the engine in each object's SQLite, and the real HTTP protocol. Alchemy's own bundle can't be loaded
// here (its entry is Node deploy code), so this file is the host: it reaches objects by `fetch` where Alchemy uses RPC,
// and runs each Effect at this boundary. Configuration is the Worker's env, as Alchemy's WorkerConfigProvider reads it.
// Its own answers are Effect's HTTP responses, converted to the platform's here.
import { FlowRuntime } from "@smthrs/flow"
import { CloudflareRuntime, ExecutionObject, ObjectDatabase } from "@smthrs/platform-cloudflare"
import { Tour, toured, Tours, walk } from "../../src/core/flows.vibe"
import { FetchHttpClient, HttpClient, HttpServerRequest, HttpServerResponse } from "effect/http"
import type { Sequencer as HistorySequencer } from "../../src/history/Sequencer.vibe"
import type { Write } from "../../src/history/wire.vibe"
import * as HistoryObject from "../../worker/HistoryObject.vibe"
import { githubMain } from "../../worker/MainLog.vibe"
import type { ReadSnapshot } from "../../src/core/schemas.vibe"
import { chatModel, dailyTokens } from "../../worker/AgentModel.vibe"
import { afterOf, eventStream, handle, type Conversations, type Histories } from "../../worker/Http.vibe"
import * as Objects from "../../worker/Objects.vibe"
import type { Spend } from "../../worker/Reply.vibe"
import type { Sequencer } from "../../worker/Sequencer.vibe"
import { Unreachable } from "../../worker/Unreachable.vibe"

interface Namespace {
  idFromName(name: string): unknown
  get(id: unknown): { fetch(input: string | Request, init?: RequestInit): Promise<Response> }
}

interface Env {
  readonly CONVERSATION: Namespace
  readonly BUDGET: Namespace
  readonly HISTORY: Namespace
  readonly [name: string]: unknown
}

interface State {
  readonly id: { toString(): string }
  readonly storage: Objects.Storage
}

/** The Worker's env as Effect `Config`, as Alchemy provides it to a deployed Worker. */
const configured = <A, E>(env: Env, program: A!E) =>
  Effect.provide(program, ConfigProvider.layer(ConfigProvider.fromUnknown(env)))

/** `body` as the platform's JSON response. */
const json = (body: unknown) => HttpServerResponse.toWeb(HttpServerResponse.jsonUnsafe(body))

const call = async (namespace: Namespace, name: string, path: string, body: unknown) => {
  const response = await namespace.get(namespace.idFromName(name)).fetch(`https://object/${path}`, {
    method: "POST",
    body: JSON.stringify(body),
  })
  if (!response.ok) throw new Error(`${path} answered ${response.status}`)
  return response.json()
}

const reach = <A>(what: string, promise: () => Promise<A>) =>
  Effect.tryPromise({ try: promise, catch: () => new Unreachable({ what }) })

export class Conversation {
  readonly sequencer: Promise<Sequencer>
  readonly releasePark = Deferred.makeUnsafe<void>()

  constructor(readonly state: State, readonly env: Env) {
    this.sequencer = Effect.runPromise(Objects.conversation(state.storage))
  }

  async fetch(request: Request): Promise<Response> {
    const sequencer = await this.sequencer
    const url = new URL(request.url)
    if (url.pathname.endsWith("/events")) {
      await Effect.runPromise(sequencer.ensureDispatched())
      return HttpServerResponse.toWeb(eventStream(sequencer.follow(afterOf(url) ?? 0)))
    }
    const args = await request.json() as { readonly clientId: string; readonly name: string; readonly text: string; readonly after: number }
    if (url.pathname === "/reading-tour") {
      await this.state.storage.put("test/reading-tour", true)
      return json({ refusal: await Effect.runPromise(Objects.tour(this.state.id.toString(), this.state.storage, sequencer)) })
    }
    if (url.pathname === "/parked") return json((await this.state.storage.get("test/parked")) === true)
    if (url.pathname === "/release-park") {
      await Effect.runPromise(Deferred.succeed(this.releasePark, undefined))
      return json(null)
    }
    if (url.pathname === "/post") {
      const refusal = await Effect.runPromise(
        Objects.post(this.state.id.toString(), this.state.storage, sequencer, args.clientId, args.name, args.text),
      )
      return json({ refusal })
    }
    if (url.pathname === "/read") return json(await Effect.runPromise(sequencer.read(args.after)))
    if (url.pathname === "/tour") return json({ refusal: await Effect.runPromise(Objects.tour(this.state.id.toString(), this.state.storage, sequencer)) })
    if (url.pathname === "/end-tour") return json({ refusal: await Effect.runPromise(Objects.endTour(this.state.id.toString(), this.state.storage, sequencer)) })
    // The engine's runs in this object's SQLite, so the suite sees every post and reply ran as a flow (0011).
    if (url.pathname === "/runs") {
      return json(this.state.storage.sql.exec("SELECT run_id, status FROM flows_runs ORDER BY created_at_ms, run_id").toArray())
    }
    return HttpServerResponse.toWeb(HttpServerResponse.text("Not found", { status: 404 }))
  }

  async alarm(): Promise<void> {
    const sequencer = await this.sequencer
    if (await this.state.storage.get("test/reading-tour")) {
      await Effect.runPromise(readingAlarm(this.state.id.toString(), this.state.storage, sequencer, this.releasePark))
      return
    }
    const env = this.env
    const spend: Spend.Shape = {
      admit: (day) => reach("budget", () => call(env.BUDGET, day, "admit", {}) as Promise<boolean>),
      spend: (day, reply, tokens) => reach("budget", () => call(env.BUDGET, day, "spend", { reply, tokens }).then(() => undefined)),
    }
    const model = await Effect.runPromise(Effect.orDie(configured(env, chatModel())))
    await Effect.runPromise(Objects.alarm(this.state.id.toString(), this.state.storage, sequencer, spend, model))
  }
}

/** The product's shared controller in the real SQLite engine, with a faulty wait service holding its park boundary. */
effect function readingAlarm(hostId: string, storage: Objects.Storage, sequencer: Sequencer, release: Deferred.Deferred<void>) {
  const tours: Tours.Shape = Objects.toursOf(sequencer)
  const ended = tours.ended
  tours.ended = (tour) => ensuring(ended(tour), effect {
    if ((try promise(() => storage.get("test/parked"))) !== undefined) return
    try promise(() => storage.put("test/parked", true))
    try Deferred.await(release)
  })
  const registration = Layer.effectDiscard(effect {
    const engine = try FlowRuntime.FlowRuntime
    const words = Array.from({ length: 40 }, () => "word").join(" ")
    try engine.register(Tour, ({ tour }) => toured(tour, walk(tour, [words, words, words, words, words])))
  })
  try ExecutionObject.alarm(Objects.executionStorage(storage), {
    flows: [Tour],
    runtime: (intent) => CloudflareRuntime.layer({ hostId, executionId: intent.executionId, flow: Tour._tag }, registration).pipe(
      Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(Layer.succeed(Tours, tours)),
    ),
    router: Objects.unrouted,
    settledRetentionMs: 10000,
  })
}

export class Budget {
  readonly budget: Promise<Effect.Success<ReturnType<typeof Objects.budget>>>

  constructor(readonly state: State, env: Env) {
    this.budget = Effect.runPromise(Effect.flatMap(
      Effect.orDie(configured(env, dailyTokens)),
      (limit) => Objects.budget(state.storage, limit),
    ))
  }

  async fetch(request: Request): Promise<Response> {
    const budget = await this.budget
    const url = new URL(request.url)
    const args = await request.json() as { readonly reply: string; readonly tokens: number }
    if (url.pathname === "/admit") return json(await Effect.runPromise(budget.admit()))
    await Effect.runPromise(budget.spend(args.reply, args.tokens))
    return json(null)
  }
}

export class History {
  readonly sequencer: Promise<HistorySequencer>
  readonly main = githubMain("smithersai/vibelang", Effect.runSync(Effect.provide(HttpClient.HttpClient, FetchHttpClient.layer)), undefined)

  constructor(readonly state: State, env: Env) {
    const main = this.main
    this.sequencer = Effect.runPromise(Effect.flatMap(HistoryObject.history(state.storage), (sequencer) =>
      Effect.flatMap(sequencer.read(), (history) =>
        history.seq === 0
          ? Effect.as(HistoryObject.bootstrap(state.id.toString(), state.storage, sequencer, main), sequencer)
          : Effect.succeed(sequencer))))
  }

  async fetch(request: Request): Promise<Response> {
    const sequencer = await this.sequencer
    const url = new URL(request.url)
    if (url.pathname.endsWith("/events")) return HttpServerResponse.toWeb(eventStream(sequencer.follow(afterOf(url) ?? 0)))
    if (url.pathname === "/read") return json(await Effect.runPromise(sequencer.read()))
    // The engine's runs in this object's SQLite, so the suite sees each write ran as a flow.
    if (url.pathname === "/runs") {
      return json(this.state.storage.sql.exec("SELECT run_id, status FROM flows_runs ORDER BY created_at_ms, run_id").toArray())
    }
    const args = await request.json() as { readonly name: Write; readonly body: unknown }
    return json(await Effect.runPromise(HistoryObject.write(
      this.state.id.toString(), this.state.storage, sequencer, this.main, HistoryObject.principalOf(request), args.name, args.body,
    )))
  }
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    // The suite's window into a conversation object's engine: /runs/<conversation>.
    const boundary = new URL(request.url).pathname.match(/^\/(reading-tour|parked|release-park)\/(.+)$/)
    if (boundary !== null) return json(await call(env.CONVERSATION, decodeURIComponent(boundary[2]!), boundary[1]!, {}))
    const runs = new URL(request.url).pathname.match(/^\/runs\/(.+)$/)
    if (runs !== null) {
      // /runs/history is the History object's (it is named by its repository); any other name is a conversation's.
      if (runs[1] === "history") return json(await call(env.HISTORY, "vibelang", "runs", {}))
      return json(await call(env.CONVERSATION, decodeURIComponent(runs[1]!), "runs", {}))
    }
    const conversations: Conversations = {
      post: (conversation, body) =>
        reach("conversation", async () => ((await call(env.CONVERSATION, conversation, "post", body)) as { refusal: string | null }).refusal),
      read: (conversation, after) =>
        reach("conversation", () => call(env.CONVERSATION, conversation, "read", { after }) as Promise<ReadSnapshot>),
      tour: (conversation) =>
        reach("conversation", async () => ((await call(env.CONVERSATION, conversation, "tour", {})) as { refusal: string | null }).refusal),
      endTour: (conversation) =>
        reach("conversation", async () => ((await call(env.CONVERSATION, conversation, "end-tour", {})) as { refusal: string | null }).refusal),
      events: (conversation) =>
        Effect.flatMap(HttpServerRequest.HttpServerRequest, (incoming) =>
          reach("conversation", async () => {
            const object = env.CONVERSATION.get(env.CONVERSATION.idFromName(conversation))
            const url = new URL(incoming.url, "https://object")
            return HttpServerResponse.raw(await object.fetch(`https://object/events${url.search}`, { signal: request.signal }))
          })),
    }
    const histories: Histories = {
      read: () => reach("history", () => call(env.HISTORY, "vibelang", "read", {})),
      write: (name, body) =>
        reach("history", () => call(env.HISTORY, "vibelang", "write", { name, body }) as Promise<HistoryObject.Answered>),
      events: () =>
        Effect.flatMap(HttpServerRequest.HttpServerRequest, (incoming) =>
          reach("history", async () => {
            const object = env.HISTORY.get(env.HISTORY.idFromName("vibelang"))
            const url = new URL(incoming.url, "https://object")
            return HttpServerResponse.raw(await object.fetch(`https://object/events${url.search}`, { signal: request.signal }))
          })),
    }
    const response = await Effect.runPromise(
      handle(conversations, histories).pipe(Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(request))),
    )
    return HttpServerResponse.toWeb(response)
  },
}

