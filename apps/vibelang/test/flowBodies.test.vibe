// Each conversation and history flow's body is its named steps, one declared action per step (src/core/flows.vibe). A host supplies
// only the steps' implementations; executing a flow on the engine runs exactly those steps, in order, with the payloads
// the body passes, and answers what they answered. The step names are what the journal, the Actions pane, spans and
// metrics show, so this file pins them.
import { describe, expect, it } from "@effect/vitest"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { FlowRuntime, Interpreter } from "@smthrs/flow"
import {
  BeginTour, DispatchPost, DispatchTour, EndTour, GuideTour, OpenDocs, OpenDocsStep, OpenWiki, OpenWikiStep, PauseTour,
  Post, RecordEndTour, RecordPause, RecordPost, RecordResume, RecordSeek, RecordTour, Reply, ReplyStep, ResumeTour,
  SandboxCommand, SandboxCommandAction, SandboxMeter, SandboxMeterAction, SandboxStart, SandboxStartAction, SandboxStop,
  SandboxStopAction, SeekTour, SignalTour, StartTour, Tour, WakeTour,
} from "../src/core/flows.vibe"
import { Refused } from "../src/core/Factory.vibe"
import {
  Approve, AuthorizeAppend, AuthorizeApprove, AuthorizeFold, AuthorizeNote, AuthorizeRetell, AuthorizeShow, AuthorizeStart,
  Bootstrap, Fold, FoldCommits, FoldMain, FoldRead, LoadBootstrap, Note, Plan, RecordAppend, RecordApprove, RecordNote,
  RecordRetell, RecordStart, Start,
} from "../src/history/flows.vibe"
import type { Action as HistoryAction, Principal } from "../src/history/roles.vibe"
import { ReadShow, Show } from "../src/history/tools.vibe"

const snapshot = { id: "s1", generation: 2, sequence: 1, status: "running" as const, role: "maintainer" as const, allowance: 60, used: 0, remaining: 60, resetAt: 0, output: "" }
const walkthrough = { step: 2, target: "#home", paused: true, revision: 4, remaining: 1000, at: 0 }

/** Runs `go` on an engine in memory with `layer` registered. */
effect function onEngine<A, E>(layer: Layer.Layer<never, never, FlowRuntime.FlowRuntime>, go: (engine: FlowRuntime.FlowRuntime["Service"]) => A!E) {
  const context = try Layer.build(layer.pipe(Layer.provideMerge(FlowEngine.layerMemory), Layer.provide(WebCrypto.layer)))
  return try go(Context.get(context, FlowRuntime.FlowRuntime))
}

/** A recorder of `[step, payload]` pairs, and an implementation of a step that records and answers `answer`. */
effect function recorder() {
  const seen = try Ref.make<ReadonlyArray<readonly [string, unknown]>>([])
  const step = <A>(name: string, answer: A) => (payload: unknown) => Effect.as(Ref.update(seen, (all) => [...all, [name, payload] as const]), answer)
  return { seen, step }
}

describe("each flow's body is its named steps", () => {
  it.effect("the step names are the ones the journal and the Actions pane show", () => effect {
    try Effect.try(() => expect([
      RecordPost.name, DispatchPost.name, ReplyStep.name, RecordTour.name, DispatchTour.name, BeginTour.name, GuideTour.name,
      RecordEndTour.name, WakeTour.name, RecordPause.name, RecordResume.name, RecordSeek.name, SignalTour.name,
      OpenDocsStep.name, OpenWikiStep.name,
    ]).toEqual([
      "vibelang/post/record", "vibelang/post/dispatch", "vibelang/reply/answer", "vibelang/tour/record", "vibelang/tour/dispatch",
      "vibelang/tour/start", "vibelang/tour/guide", "vibelang/tour/end", "vibelang/tour/wake", "vibelang/tour/request/pause",
      "vibelang/tour/request/resume", "vibelang/tour/request/seek", "vibelang/tour/signal", "vibelang/docs/pane/open",
      "vibelang/wiki/pane/open",
    ]))
  })

  it.effect("an accepted record runs its dispatch step after it; a refused one runs no other step", () => scoped(effect {
    const accepted = try recorder()
    const refused = try recorder()
    const layer = (r: typeof accepted, answer: "busy" | null) => Layer.mergeAll(
      Interpreter.layerWithImplementations(Post, Layer.mergeAll(RecordPost.toLayer(r.step("record", answer)), DispatchPost.toLayer(r.step("dispatch", null)))),
      Interpreter.layerWithImplementations(StartTour, Layer.mergeAll(RecordTour.toLayer(r.step("tour/record", answer)), DispatchTour.toLayer(r.step("tour/dispatch", null)))),
      Interpreter.layerWithImplementations(EndTour, Layer.mergeAll(RecordEndTour.toLayer(r.step("end", answer)), WakeTour.toLayer(r.step("wake", null)))),
    )
    const run = (engine: FlowRuntime.FlowRuntime["Service"]) => Effect.all([
      engine.execute(Post, { executionId: "post/1", payload: { clientId: "c", name: "Ada", text: "Hi", owner: "u1" } }),
      engine.execute(StartTour, { executionId: "start/1", payload: {} }),
      engine.execute(EndTour, { executionId: "end/1", payload: {} }),
    ])
    const yes = try onEngine(layer(accepted, null), run)
    const no = try onEngine(layer(refused, "busy"), run)
    const yesSteps = try Ref.get(accepted.seen)
    const noSteps = try Ref.get(refused.seen)
    try Effect.try(() => {
      expect(yes).toEqual([null, null, null])
      expect(yesSteps).toEqual([
        ["record", { clientId: "c", name: "Ada", text: "Hi", owner: "u1" }], ["dispatch", {}],
        ["tour/record", {}], ["tour/dispatch", {}], ["end", {}], ["wake", {}],
      ])
      expect(no).toEqual(["busy", "busy", "busy"])
      expect(noSteps).toEqual([["record", { clientId: "c", name: "Ada", text: "Hi", owner: "u1" }], ["tour/record", {}], ["end", {}]])
    })
  }))

  it.effect("a tour run guides the tour its start step admitted, and only while that tour runs", () => scoped(effect {
    const r = try recorder()
    // Only t1 still runs: its start step admits it; t2's answers "".
    const layer = Interpreter.layerWithImplementations(Tour, Layer.mergeAll(
      BeginTour.toLayer((p) => r.step("start", p.tour === "t1" ? "t1" : "")(p)),
      GuideTour.toLayer(r.step("guide", null)),
    ))
    const answers = try onEngine(layer, (engine) => Effect.all([
      engine.execute(Tour, { executionId: "tour/t1", payload: { tour: "t1" } }),
      engine.execute(Tour, { executionId: "tour/t2", payload: { tour: "t2" } }),
    ]))
    const steps = try Ref.get(r.seen)
    try Effect.try(() => {
      expect(answers).toEqual([null, null])
      expect(steps).toEqual([["start", { tour: "t1" }], ["guide", { tour: "t1" }], ["start", { tour: "t2" }]])
    })
  }))

  it.effect("a walkthrough control signals the parked run only when it changed the walkthrough", () => scoped(effect {
    const r = try recorder()
    const changed = { tour: "t1", previous: 3, state: walkthrough, refusal: null }
    const layer = Layer.mergeAll(
      Interpreter.layerWithImplementations(PauseTour, Layer.mergeAll(RecordPause.toLayer(r.step("pause", changed)), SignalTour.toLayer(r.step("signal", null)))),
      Interpreter.layerWithImplementations(ResumeTour, Layer.mergeAll(RecordResume.toLayer(r.step("resume", { ...changed, state: null, refusal: "not-replying" as const })), SignalTour.toLayer(r.step("signal", null)))),
      Interpreter.layerWithImplementations(SeekTour, Layer.mergeAll(RecordSeek.toLayer(r.step("seek", { ...changed, refusal: "busy" as const })), SignalTour.toLayer(r.step("signal", null)))),
    )
    const answers = try onEngine(layer, (engine) => Effect.all([
      engine.execute(PauseTour, { executionId: "pause/1", payload: {} }),
      engine.execute(ResumeTour, { executionId: "resume/1", payload: {} }),
      engine.execute(SeekTour, { executionId: "seek/1", payload: { step: 3 } }),
    ]))
    const steps = try Ref.get(r.seen)
    try Effect.try(() => {
      expect(answers).toEqual([null, "not-replying", "busy"])
      expect(steps).toEqual([["pause", {}], ["signal", { tour: "t1", previous: 3, state: walkthrough }], ["resume", {}], ["seek", { step: 3 }]])
    })
  }))

  it.effect("Reply is its host's one answer step", () => scoped(effect {
    const r = try recorder()
    const answer = try onEngine(Interpreter.layerWithImplementations(Reply, ReplyStep.toLayer(r.step("answer", null))), (engine) =>
      engine.execute(Reply, { executionId: "reply/m1", payload: { post: "m1" } }))
    const steps = try Ref.get(r.seen)
    try Effect.try(() => {
      expect(answer).toBe(null)
      expect(steps).toEqual([["answer", { post: "m1" }]])
    })
  }))

  it.effect("the docs and wiki tools answer what their open step answered", () => scoped(effect {
    const layer = Layer.mergeAll(
      Interpreter.layerWithImplementations(OpenDocs, OpenDocsStep.toLayer(({ path }) => Effect.succeed(path === "/setup"))),
      Interpreter.layerWithImplementations(OpenWiki, OpenWikiStep.toLayer(({ page }) => Effect.succeed(page === "rulings"))),
    )
    const answers = try onEngine(layer, (engine) => Effect.all([
      engine.execute(OpenDocs, { executionId: "docs/1", payload: { path: "/setup" } }),
      engine.execute(OpenDocs, { executionId: "docs/2", payload: { path: "/nope" } }),
      engine.execute(OpenWiki, { executionId: "wiki/1", payload: { page: "rulings" } }),
      engine.execute(OpenWiki, { executionId: "wiki/2", payload: { page: "nope" } }),
    ]))
    try Effect.try(() => expect(answers).toEqual([true, false, true, false]))
  }))

  it.effect("the sandbox flows run their commit step, and its typed refusal is the flow's", () => scoped(effect {
    const seen = try Ref.make<ReadonlyArray<unknown>>([])
    const saw = (payload: unknown) => Ref.update(seen, (all) => [...all, payload])
    const layer = Layer.mergeAll(
      Interpreter.layerWithImplementations(SandboxStart, SandboxStartAction.toLayer((p) => Effect.as(saw(p), snapshot))),
      Interpreter.layerWithImplementations(SandboxStop, SandboxStopAction.toLayer((p) => Effect.andThen(saw(p), Effect.fail(new Refused({ refusal: "forbidden" }))))),
      Interpreter.layerWithImplementations(SandboxCommand, SandboxCommandAction.toLayer((p) => Effect.as(saw(p), "ok"))),
      Interpreter.layerWithImplementations(SandboxMeter, SandboxMeterAction.toLayer((p) => saw(p))),
    )
    const answers = try onEngine(layer, (engine) => Effect.all([
      engine.execute(SandboxStart, { executionId: "start/1", payload: { conversation: "c", operationId: "o1" } }),
      Effect.flip(engine.execute(SandboxStop, { executionId: "stop/1", payload: { conversation: "c", operationId: "o2", generation: 2 } })),
      engine.execute(SandboxCommand, { executionId: "command/1", payload: { conversation: "c", operationId: "o3", command: "ls", generation: 2 } }),
      engine.execute(SandboxMeter, { executionId: "meter/1", payload: {} }),
    ]))
    const steps = try Ref.get(seen)
    try Effect.try(() => {
      expect(answers[0]).toEqual(snapshot)
      expect(answers[1]).toMatchObject({ _tag: "Refused", refusal: "forbidden" })
      expect(answers.slice(2)).toEqual(["ok", undefined])
      expect(steps).toEqual([
        { conversation: "c", operationId: "o1" }, { conversation: "c", operationId: "o2", generation: 2 },
        { conversation: "c", operationId: "o3", command: "ls", generation: 2 }, {},
      ])
    })
  }))
})

describe("each history flow's body is its named steps", () => {
  const ada: Principal = { role: "maintainer", name: "Ada", agent: false }
  const runOf = (action: HistoryAction, phase: "authorized" | "forbidden") => ({ action, principal: ada, phase, records: 0 })
  const plan = { how: "append" as const, epic: "e1", newEpic: "", target: "", title: "T", task: "" }
  const written = { id: "m1", refusal: null }
  const forbidden = { id: "", refusal: "forbidden" }

  it.effect("the step names are the ones the journal and the Actions pane show", () => effect {
    try Effect.try(() => expect([
      AuthorizeAppend.name, RecordAppend.name, AuthorizeRetell.name, RecordRetell.name, AuthorizeStart.name, RecordStart.name,
      AuthorizeNote.name, RecordNote.name, AuthorizeApprove.name, RecordApprove.name, AuthorizeFold.name, FoldMain.name,
      FoldRead.name, FoldCommits.name, LoadBootstrap.name, AuthorizeShow.name, ReadShow.name,
    ]).toEqual([
      "vibelang/history/append/authorize", "vibelang/history/append/record", "vibelang/history/retell/authorize",
      "vibelang/history/retell/record", "vibelang/history/start/authorize", "vibelang/history/start/record",
      "vibelang/history/note/authorize", "vibelang/history/note/record", "vibelang/history/approve/authorize",
      "vibelang/history/approve/record", "vibelang/history/fold/authorize", "vibelang/history/fold/main",
      "vibelang/history/fold/read", "vibelang/history/fold/commits", "vibelang/history/bootstrap/load",
      "vibelang/history/show/authorize", "vibelang/history/show/read",
    ]))
  })

  it.effect("a write records as the principal its authorize step authorized, and a forbidden one records nothing", () => scoped(effect {
    effect function run(phase: "authorized" | "forbidden") {
      const r = try recorder()
      const layer = Layer.mergeAll(
        Interpreter.layerWithImplementations(Plan, Layer.mergeAll(
          AuthorizeAppend.toLayer(r.step("append/authorize", runOf("append", phase))), RecordAppend.toLayer(r.step("append/record", written)),
          AuthorizeRetell.toLayer(r.step("retell/authorize", runOf("retell", phase))), RecordRetell.toLayer(r.step("retell/record", written)),
        )),
        Interpreter.layerWithImplementations(Start, Layer.mergeAll(AuthorizeStart.toLayer(r.step("start/authorize", runOf("start", phase))), RecordStart.toLayer(r.step("start/record", written)))),
        Interpreter.layerWithImplementations(Note, Layer.mergeAll(AuthorizeNote.toLayer(r.step("note/authorize", runOf("note", phase))), RecordNote.toLayer(r.step("note/record", written)))),
        Interpreter.layerWithImplementations(Approve, Layer.mergeAll(AuthorizeApprove.toLayer(r.step("approve/authorize", runOf("approve", phase))), RecordApprove.toLayer(r.step("approve/record", written)))),
      )
      const answers = try onEngine(layer, (engine) => Effect.all([
        engine.execute(Plan, { executionId: "append/1", payload: plan }),
        engine.execute(Plan, { executionId: "insert/1", payload: { ...plan, how: "insert" } }),
        engine.execute(Plan, { executionId: "amend/1", payload: { ...plan, how: "amend" } }),
        engine.execute(Start, { executionId: "start/1", payload: { id: "m1", lane: "l" } }),
        engine.execute(Note, { executionId: "note/1", payload: { id: "m1", section: "tried", text: "x" } }),
        engine.execute(Approve, { executionId: "approve/1", payload: { id: "m1" } }),
      ]))
      return { answers, steps: try Ref.get(r.seen) }
    }
    const yes = try run("authorized")
    const no = try run("forbidden")
    try Effect.try(() => {
      expect(yes.answers).toEqual([written, written, written, written, written, written])
      expect(yes.steps).toEqual([
        ["append/authorize", {}], ["append/record", { ...plan, principal: ada }],
        ["retell/authorize", {}], ["retell/record", { ...plan, how: "insert", principal: ada }],
        ["retell/authorize", {}], ["retell/record", { ...plan, how: "amend", principal: ada }],
        ["start/authorize", {}], ["start/record", { id: "m1", lane: "l", principal: ada }],
        ["note/authorize", {}], ["note/record", { id: "m1", section: "tried", text: "x", principal: ada }],
        ["approve/authorize", {}], ["approve/record", { id: "m1", principal: ada }],
      ])
      expect(no.answers).toEqual([forbidden, forbidden, forbidden, forbidden, forbidden, forbidden])
      expect(no.steps).toEqual([["append/authorize", {}], ["retell/authorize", {}], ["retell/authorize", {}], ["start/authorize", {}], ["note/authorize", {}], ["approve/authorize", {}]])
    })
  }))

  it.effect("a fold reads main only once authorized, and folds only what it could read", () => scoped(effect {
    const commit = { sha: "abc", change: "", title: "T", message: "M" }
    effect function run(phase: "authorized" | "forbidden", available: boolean) {
      const r = try recorder()
      const layer = Interpreter.layerWithImplementations(Fold, Layer.mergeAll(
        AuthorizeFold.toLayer(r.step("authorize", runOf("fold", phase))),
        FoldMain.toLayer(r.step("main", "f0")),
        FoldRead.toLayer(r.step("read", { available, commits: available ? [commit] : [] })),
        FoldCommits.toLayer(r.step("commits", { folded: 1, refusal: null })),
      ))
      const answer = try onEngine(layer, (engine) => engine.execute(Fold, { executionId: "fold/1", payload: {} }))
      return { answer, steps: try Ref.get(r.seen) }
    }
    const folded = try run("authorized", true)
    const unavailable = try run("authorized", false)
    const refused = try run("forbidden", true)
    try Effect.try(() => {
      expect(folded.answer).toEqual({ folded: 1, refusal: null })
      expect(folded.steps).toEqual([["authorize", {}], ["main", {}], ["read", { main: "f0" }], ["commits", { commits: [commit] }]])
      expect(unavailable.answer).toEqual({ folded: 0, refusal: "unavailable" })
      expect(unavailable.steps).toEqual([["authorize", {}], ["main", {}], ["read", { main: "f0" }]])
      expect(refused.answer).toEqual({ folded: 0, refusal: "forbidden" })
      expect(refused.steps).toEqual([["authorize", {}]])
    })
  }))

  it.effect("Bootstrap is its load step, and show reads after its authorize step", () => scoped(effect {
    const r = try recorder()
    const outline = { seq: 0, main: "", epics: [], open: [] }
    const layer = Layer.mergeAll(
      Interpreter.layerWithImplementations(Bootstrap, LoadBootstrap.toLayer(r.step("load", true))),
      Interpreter.layerWithImplementations(Show, Layer.mergeAll(AuthorizeShow.toLayer(r.step("show/authorize", runOf("show", "authorized"))), ReadShow.toLayer(r.step("show/read", outline)))),
    )
    const answers = try onEngine(layer, (engine) => Effect.all([
      engine.execute(Bootstrap, { executionId: "bootstrap/1", payload: {} }),
      engine.execute(Show, { executionId: "show/1", payload: { what: "outline" } }),
    ]))
    const steps = try Ref.get(r.seen)
    try Effect.try(() => {
      expect(answers).toEqual([true, outline])
      expect(steps).toEqual([["load", {}], ["show/authorize", {}], ["show/read", { what: "outline" }]])
    })
  }))
})
