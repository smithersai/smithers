import { expect, it } from "@effect/vitest"
import { Factory } from "../src/core/Factory.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"

effect function finish(factory: Factory.Shape, room: string, clientId: string) {
  const post = (try factory.read(room, 0)).entries.find(entry => entry.clientId === clientId)!
  try factory.endTour(room)
  try Stream.runDrain(factory.events(room, 0).pipe(
    Stream.dropUntil(event => event.type === "ReplyStarted" && event.inReplyTo === post.id),
    Stream.takeUntil(event => event.type === "ReplyFinished"),
  ))
}

it.live("a queued Viewer issue request cannot borrow the subsequently selected Maintainer", () => effect {
  provide MockFactory {
    const factory = try Factory
    try factory.tour("issue-viewer")
    try factory.post("issue-viewer", "queued", "Guest", "File an issue: Viewer request")
    try factory.accounts!.choose("maintainer")
    try finish(factory, "issue-viewer", "queued")
    const issues = try factory.issues!.read()
    const chat = try factory.read("issue-viewer", 0)
    try Effect.try(() => {
      expect(issues.items.some(issue => issue.title === "Viewer request")).toBe(false)
      expect(chat.entries.at(-1)?.text).toBe("No issue filed.")
    })
  }
})

it.live("a queued issue keeps its original author and the shared project projection after identity switching", () => effect {
  provide MockFactory {
    const factory = try Factory
    const person = try factory.accounts!.choose("contributor")
    try factory.tour("issue-author")
    try factory.post("issue-author", "queued", person.login, "File an issue: Original author")
    try factory.accounts!.choose("maintainer")
    try finish(factory, "issue-author", "queued")
    const seenByOther = try factory.issues!.read()
    try factory.accounts!.choose("contributor")
    const seenByAuthor = try factory.issues!.read()
    try Effect.try(() => {
      expect(seenByOther.items.find(issue => issue.title === "Original author")?.author).toBe(person.login)
      expect(seenByAuthor.items).toEqual(seenByOther.items)
    })
  }
})

it.live("a queued split rechecks its original poster's role after demotion", () => effect {
  provide MockFactory {
    const factory = try Factory
    const person = try factory.accounts!.choose("contributor")
    const before = try factory.issues!.read()
    try factory.tour("issue-demotion")
    try factory.post("issue-demotion", "queued", person.login, "Split #38 into three children, linked under it.")
    try factory.accounts!.choose("maintainer")
    try factory.accounts!.grant(person.id, "new")
    try finish(factory, "issue-demotion", "queued")
    const after = try factory.issues!.read()
    const chat = try factory.read("issue-demotion", 0)
    try Effect.try(() => {
      expect(after.items).toEqual(before.items)
      expect(chat.entries.at(-1)?.text).toBe("Filed 0 children.\n\n[Open #38](#issue-38)")
    })
  }
})
