// main's first-parent log from real GitHub, replayed from test/recordings/main-log.json unless VIBE_GITHUB says
// otherwise (test/support/github.vibe). A replay needs no token and reaches no network.
import { expect, it } from "@effect/vitest"
import { HttpClient, HttpClientRequest } from "effect/http"
import { githubMain } from "../worker/MainLog.vibe"
import { github } from "./support/github.vibe"

it.live("main's log from the empty cursor is the newest commits, each with a short sha and a title", () => scoped(effect {
  const real = try github("main-log")
  // The test, not the site, holds a token: it raises the limit for a real run only.
  const authorized = HttpClient.mapRequest(real.client, HttpClientRequest.bearerToken(Redacted.value(real.token)))
  const commits = try githubMain("smithersai/effect", authorized).since("")
  expect(commits.length).toBeGreaterThan(0)
  for (const commit of commits) {
    expect(commit.sha).toMatch(/^[0-9a-f]{12}$/)
    expect(typeof commit.title).toBe("string")
  }
}), 60_000)
