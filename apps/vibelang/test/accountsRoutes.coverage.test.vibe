// @vitest-environment node
// The Accounts Durable Object's routes at their edges, through its own fetch handler over SQLite object storage: the
// GitHub App install link, Connect GitHub refused to an agent or without a broker, a device agent's principal, an ended
// smithers.sh connection forgotten on a wiki read, a chat draft the engine can't record, and a broker the site can't
// trust. GitHub is the in-memory fuzz GitHub behind smithers.sh's real per-person connection host; nothing intercepts.
import { describe, expect, it } from "@effect/vitest"
import { HttpClient, HttpClientError, HttpClientRequest, HttpClientResponse, HttpServerRequest, HttpServerResponse } from "effect/http"
import { TestNodeRuntime } from "@smthrs/platform-node"
import { pages } from "../src/core/wiki.vibe"
import * as Accounts from "../worker/Accounts.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { wikiRepository } from "../worker/Wiki.vibe"
import { fakeClient, seed } from "../fuzz/issues-node-fake.vibe"
import { BROKER, delegated as connectionHost, reach } from "../fuzz/delegated.vibe"
import { faultyStore } from "../fuzz/faulty-store.ts"
import { ORIGIN, github, setupWith } from "./support/accountsWorld.vibe"

const PAGE = pages[0]!.id
const SOURCE = "# Page\n\nThe repository text.\n"

/** Each `Set-Cookie` as the browser sends it back. */
const cookies = (response: globalThis.Response) => response.headers.getSetCookie().map((line) => line.split(";")[0]!).join("; ")

/**
 * The object over a SQLite store; `setup` overrides the site's configuration, and `delegated` false leaves the delegate
 * to the configured broker. Will (1) and Ada (7) have GitHub accounts.
 */
effect function world(setup: Partial<Accounts.Setup> = {}, delegated = true) {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const store = faultyStore(raw as unknown as Storage)
  const fake = seed()
  fake.files[`${wikiRepository.root}/${PAGE}.md`] = SOURCE
  const site = try connectionHost(fakeClient(fake), reach())
  /** Runs before each request the site sends: a test's concurrent event, such as a sign-out in another tab. */
  const hooks: { beforeSend: void!! ; sent: Array<string> } = { beforeSend: Effect.void, sent: [] }
  const network = site.http.pipe(HttpClient.tapRequest((request) => Effect.suspend(() => { hooks.sent.push(new URL(request.url).origin); return hooks.beforeSend })))
  /** The object as workerd starts it over this storage, as after an eviction. */
  const start = () => Accounts.make("accounts-routes", store.storage, { ...setupWith(github([{ id: 1, login: "will" }, { id: 7, login: "ada" }])), ...(delegated ? { delegate: site.delegate } : {}), ...setup })
    .pipe(Effect.provideService(HttpClient.HttpClient, network))
  const accounts = try start()
  /** One browser request from the site's own origin. */
  const call = (method: string, path: string, cookie = "", body?: unknown) => effect {
    const request = try HttpClientRequest.toWeb(HttpClientRequest.make(method as "GET" | "POST")(ORIGIN + path).pipe(
      HttpClientRequest.setHeaders({ origin: ORIGIN, cookie }),
      body === undefined ? identity : HttpClientRequest.bodyJsonUnsafe(body),
    ))
    const response = try accounts.fetch.pipe(Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(request)))
    return HttpServerResponse.toWeb(response)
  }
  /** The browser sign-in: the start, then GitHub's return with the person's code. */
  const signIn = effect (person: number) => {
    const start = try call("GET", "/api/auth/sign-in")
    const state = new URL(start.headers.get("location") ?? "").searchParams.get("state") ?? ""
    return cookies(try call("GET", `${Accounts.CALLBACK}?state=${state}&code=${person}`, cookies(start)))
  }
  /** A CLI's device sign-in: a session marked as the person's agent. */
  const device = effect (person: number) => {
    const answer = try call("POST", "/api/auth/device", "", { token: `token-${person}` })
    return ((try promise(() => answer.json())) as { readonly cookie: string }).cookie
  }
  /** Ada's smithers.sh connection, as a completed Connect GitHub stores it. */
  const connect = (id: string) => promise(() => store.storage.put(`delegation/${id}`, { ...site.connection, expires: Number.MAX_SAFE_INTEGER }))
  const connection = (id: string) => promise(() => store.storage.get(`delegation/${id}`))
  /** Every session ends, as a sign-out in another tab does. */
  const signOutEveryone = effect {
    for (const key of (try promise(() => store.storage.list({ prefix: "session/" }))).keys()) try promise(() => store.storage.delete(key))
  }
  return { accounts, start, store, site, call, signIn, device, connect, connection, hooks, signOutEveryone }
}

const body = (response: globalThis.Response) => promise(() => response.json())

describe("the GitHub App install link", () => {
  it.live("sends a person to the configured App and answers unavailable without one", () => scoped(effect {
    const installable = try world({ appSlug: "vibelang app" })
    const install = try installable.call("GET", "/api/auth/install")
    expect(install.status).toBe(302)
    expect(install.headers.get("location")).toBe("https://github.com/apps/vibelang%20app/installations/new")
    const posted = try installable.call("POST", "/api/auth/install")
    expect(posted.status).toBe(404)
    const unset = try (try world()).call("GET", "/api/auth/install")
    expect([unset.status, try body(unset)]).toEqual([503, { error: "install unavailable" }])
  }))
})

describe("Connect GitHub", () => {
  it.live("refuses a device agent, an unknown wiki page, a signed-out disconnect, and answers unavailable with no broker", () => scoped(effect {
    const w = try world()
    const agent = try w.call("POST", "/api/auth/connect", try w.device(7))
    expect([agent.status, try body(agent)]).toEqual([403, { error: "agent" }])
    const ada = try w.signIn(7)
    const unknownPage = try w.call("POST", "/api/auth/connect?wiki-page=no-such-page", ada)
    expect([unknownPage.status, try body(unknownPage)]).toEqual([400, { error: "request" }])
    const person = try w.call("POST", "/api/auth/connect", ada)
    expect([person.status, try body(person)]).toEqual([503, { error: "sign-in unavailable" }])
    const signedOut = try w.call("POST", "/api/auth/disconnect")
    expect([signedOut.status, try body(signedOut)]).toEqual([401, { error: "sign-in" }])
  }))

  it.live("a broker the site can't trust leaves sign-in and Connect unavailable", () => scoped(effect {
    // A site secret shorter than 32 characters: neither the broker client nor the delegation client accepts it.
    const w = try world({ broker: { origin: "https://smithers.test", secret: Redacted.make("short") } }, false)
    const session = try body(try w.call("GET", "/api/auth/session"))
    const start = try w.call("GET", "/api/auth/sign-in")
    expect(session).toMatchObject({ available: false })
    expect(start.status).toBe(503)
  }))
})

describe("the principal behind a wiki request", () => {
  it.live("a device agent reads with the person's role but no connection, and may not save", () => scoped(effect {
    const w = try world()
    const agent = try w.device(1)
    try w.connect("1")
    const read = try w.call("GET", `/api/wiki?page=${PAGE}`, agent)
    const page = (try body(read)) as { readonly role: string; readonly pages: ReadonlyArray<{ readonly source: string }> }
    expect([read.status, page.role, page.pages[0]?.source]).toEqual([200, "maintainer", SOURCE])
    const save = try w.call("POST", "/api/wiki", agent, { op: "save", page: PAGE, base: SOURCE, text: "# Page\n\nBetter.\n", key: "k1" })
    expect([save.status, try body(save)]).toEqual([403, { reason: "forbidden" }])
    expect(try w.connection("1")).toBeDefined()
  }))

  it.live("an ended smithers.sh connection still reads the public page and is forgotten", () => scoped(effect {
    const w = try world()
    const ada = try w.signIn(7)
    try w.connect("7")
    try w.site.end()
    const read = try w.call("GET", `/api/wiki?page=${PAGE}`, ada)
    const page = (try body(read)) as { readonly pages: ReadonlyArray<{ readonly source: string }> }
    expect([read.status, page.pages[0]?.source]).toEqual([200, SOURCE])
    expect(try w.connection("7")).toBeUndefined()
  }))

  it.live("a connected person whose role can't save is refused before GitHub", () => scoped(effect {
    const w = try world()
    const ada = try w.signIn(7)
    try w.connect("7")
    const save = try w.call("POST", "/api/wiki", ada, { op: "save", page: PAGE, base: SOURCE, text: "# Page\n\nBetter.\n", key: "k1" })
    expect([save.status, try body(save)]).toEqual([403, { reason: "forbidden" }])
  }))

  it.live("a signed-in person with no connection disconnects without asking smithers.sh", () => scoped(effect {
    const w = try world()
    const ada = try w.signIn(7)
    const before = w.hooks.sent.length
    const disconnect = try w.call("POST", "/api/auth/disconnect", ada)
    expect([disconnect.status, disconnect.headers.get("location"), w.hooks.sent.length - before]).toEqual([303, "/?issues=1", 0])
  }))

  it.live("a read whose person signs out while smithers.sh refuses the ended connection still answers, and forgets that connection", () => scoped(effect {
    const w = try world()
    const ada = try w.signIn(7)
    try w.connect("7")
    try w.site.end()
    w.hooks.beforeSend = w.signOutEveryone
    const wiki = try w.call("GET", `/api/wiki?page=${PAGE}`, ada)
    // The read asked smithers.sh, so it began signed in and connected.
    const askedForWiki = w.hooks.sent.includes(BROKER)
    w.hooks.sent.length = 0
    const page = (try body(wiki)) as { readonly pages: ReadonlyArray<{ readonly source: string }> }
    const again = try w.signIn(7)
    const issues = try w.call("GET", "/api/issues", again)
    // The read named the connection it used when it began, so the ended one is gone though no session was left
    // (0015, session 20: it stayed until the person's next read). Signed in again, the next read asks smithers.sh nothing.
    expect([wiki.status, page.pages[0]?.source, askedForWiki, issues.status, w.hooks.sent.includes(BROKER)]).toEqual([200, SOURCE, true, 200, false])
    expect(try w.connection("7")).toBeUndefined()
  }))

  it.live("the per-site token migration runs once: a restarted object keeps a github/ record written after it", () => scoped(effect {
    const w = try world()
    try promise(() => w.store.storage.put("github/later", { token: "sealed" }))
    try w.start()
    expect(try promise(() => w.store.storage.get("github/later"))).toEqual({ token: "sealed" })
  }))

  it.live("a chat draft the engine can't record or open answers unavailable", () => scoped(effect {
    const w = try world()
    w.store.fail(/^\s*INSERT INTO flows_attempts/)
    expect(try w.accounts.draftWiki("1", PAGE, "ask", "k1")).toBe("unavailable")
    w.store.fail(/^\s*CREATE TABLE IF NOT EXISTS "flows_migrations"/)
    expect(try w.accounts.draftWiki("1", PAGE, "ask", "k2")).toBe("unavailable")
  }))
})

// Review R1 D4 (Neon-D4-002, Fable-D4-001, 002, 017, 036): what a device session may not do, whose token signs in,
// what the accounts lock no longer waits on, and what the object no longer keeps.
describe("a person's agent and the roles ledger", () => {
  it.live("a device session grants and revokes nothing, while the person's browser session does", () => scoped(effect {
    const w = try world()
    try w.signIn(7)
    const agent = try w.device(1)
    const granted = try w.call("POST", "/api/roles", agent, { id: "7", role: "maintainer" })
    expect([granted.status, try body(granted)]).toEqual([403, { refusal: "forbidden" }])
    // Its own role too: an agent never demotes the person it acts for.
    const demoted = try w.call("POST", "/api/roles", agent, { id: "1", role: "new" })
    expect([demoted.status, try body(demoted)]).toEqual([403, { refusal: "forbidden" }])
    // Refused before the body is read: a malformed body is still a 403, never a 400.
    const malformed = try w.call("POST", "/api/roles", agent, { nonsense: true })
    expect(malformed.status).toBe(403)
    expect([try w.accounts.role("7"), try w.accounts.role("1")]).toEqual(["new", "maintainer"])
    const person = try w.call("POST", "/api/roles", try w.signIn(1), { id: "7", role: "maintainer" })
    expect([person.status, try w.accounts.role("7")]).toEqual([200, "maintainer"])
  }))
})

describe("a device sign-in's token", () => {
  it.live("signs nobody in when GitHub knows the person but this App did not issue the token", () => scoped(effect {
    const revoked: Array<string> = []
    const known = github([{ id: 1, login: "will" }, { id: 7, login: "ada" }])
    const w = try world({ issuedHere: () => succeed(false), github: { ...known, revoke: (token) => Effect.sync(() => { revoked.push(Redacted.value(token)) }) } })
    const foreign = try w.call("POST", "/api/auth/device", "", { token: "token-7" })
    expect([foreign.status, try body(foreign)]).toEqual([401, { error: "sign-in" }])
    expect([...(try promise(() => w.store.storage.list({ prefix: "session/" }))).keys()]).toEqual([])
    // Another app's token is never revoked through this App.
    expect(revoked).toEqual([])
    const own = try world()
    const issued = try own.call("POST", "/api/auth/device", "", { token: "token-7" })
    expect(issued.status).toBe(200)
    expect((try promise(() => own.store.storage.list({ prefix: "session/" }))).size).toBe(1)
  }))

  it.live("the App check asks GitHub as the App and fails closed", () => effect {
    const asked: Array<{ readonly url: string; readonly authorization: string; readonly body: string }> = []
    const answering = (status: number, answer: unknown) => HttpClient.make((request) => effect {
      asked.push({ url: request.url, authorization: request.headers["authorization"] ?? "", body: request.body._tag === "Uint8Array" ? new TextDecoder().decode(request.body.body) : "" })
      return HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.jsonUnsafe(answer, { status })))
    })
    const options = { apiBaseUrl: "https://api.github.test", clientId: "Iv1.fixture", clientSecret: Redacted.make("app-secret") }
    const token = Redacted.make("ghu_person")
    const check = (http: HttpClient.HttpClient) => Accounts.appTokenCheck(http, options)(token)
    expect(try check(answering(200, { app: { client_id: "Iv1.fixture" } }))).toBe(true)
    expect(asked).toEqual([{ url: "https://api.github.test/applications/Iv1.fixture/token", authorization: "Basic " + btoa("Iv1.fixture:app-secret"), body: JSON.stringify({ access_token: "ghu_person" }) }])
    // GitHub answers 404 for a personal access token or another app's token.
    expect(try check(answering(404, { message: "Not Found" }))).toBe(false)
    expect(try check(answering(200, { app: { client_id: "Iv1.other" } }))).toBe(false)
    expect(try check(answering(200, {}))).toBe(false)
    expect(try check(answering(503, {}))).toBe(false)
    const down = HttpClient.make((request) => fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request, cause: "down" }) })))
    expect(try check(down)).toBe(false)
  })
})

describe("the accounts lock", () => {
  it.live("a session read answers while a device sign-in waits on GitHub", () => scoped(effect {
    const asked = try Deferred.make<void>()
    const release = try Deferred.make<void>()
    const w = try world({ issuedHere: () => effect { try Deferred.succeed(asked, undefined); try Deferred.await(release); return true } })
    const ada = try w.signIn(7)
    const signing = try Effect.forkScoped(w.call("POST", "/api/auth/device", "", { token: "token-1" }))
    try Deferred.await(asked)
    // GitHub has not answered: a read and another person's write both finish.
    const read = try w.call("GET", "/api/auth/session", ada).pipe(Effect.timeout("2 seconds"))
    expect([read.status, try body(read)]).toMatchObject([200, { id: "7" }])
    const signedOut = try w.call("POST", "/api/auth/sign-out", ada).pipe(Effect.timeout("2 seconds"))
    expect(signedOut.status).toBe(204)
    try Deferred.succeed(release, undefined)
    expect((try Fiber.join(signing)).status).toBe(200)
  }))
})

describe("what the accounts object keeps", () => {
  it.live("the next sign-in start deletes an expired session and keeps a live one", () => scoped(effect {
    const w = try world()
    const ada = try w.signIn(7)
    try promise(() => w.store.storage.put("session/expired", { id: "9", login: "old", expires: 1 }))
    try promise(() => w.store.storage.put("session/malformed", { id: "9", login: "old" }))
    try w.call("GET", "/api/auth/sign-in")
    const kept = [...(try promise(() => w.store.storage.list({ prefix: "session/" }))).keys()]
    expect(kept).toHaveLength(1)
    expect((try body(try w.call("GET", "/api/auth/session", ada)))).toMatchObject({ id: "7" })
  }))

  it.live("the members route answers one page and names the next", () => scoped(effect {
    const w = try world()
    const will = try w.signIn(1)
    for (let id = 1000; id < 1000 + Accounts.MEMBERS_PAGE + 5; id++) try promise(() => w.store.storage.put("person/" + id, { id: String(id), login: "p" + id }))
    const first = try w.call("GET", "/api/roles", will)
    const firstPage = (try body(first)) as ReadonlyArray<{ readonly id: string }>
    const next = first.headers.get("x-vibelang-next")
    expect([first.status, firstPage.length, next]).toEqual([200, Accounts.MEMBERS_PAGE, firstPage[firstPage.length - 1]!.id])
    const second = try w.call("GET", "/api/roles?after=" + next, will)
    const secondPage = (try body(second)) as ReadonlyArray<{ readonly id: string }>
    // Will's own row and the 105 seeded: nobody twice, nobody missed.
    expect([secondPage.length, second.headers.get("x-vibelang-next")]).toEqual([6, null])
    expect(new Set([...firstPage, ...secondPage].map((member) => member.id)).size).toBe(Accounts.MEMBERS_PAGE + 6)
    const malformed = try w.call("GET", "/api/roles?after=../x", will)
    expect(malformed.status).toBe(400)
  }))
})
