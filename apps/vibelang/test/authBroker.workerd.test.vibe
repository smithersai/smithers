import { expect, it } from "@effect/vitest"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { serveAuthBroker } from "./support/workerd.vibe"
import { brokerConnect, brokerSignIn } from "./support/brokerWorld.vibe"
import { GitHub } from "@smthrs/integrations"

const Delegation = GitHub.Delegation

it.live("runs both apps' durable auth hosts in workerd, binding both browser cookies and consuming the handoff", () => scoped(effect {
  const host = try acquireRelease(serveAuthBroker(), host => promise(() => host.dispose()))
  const brokerOrigin = host.origin.replace("127.0.0.1", "localhost")
  const http = try Effect.provide(HttpClient.HttpClient, FetchHttpClient.layer.pipe(Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { redirect: "manual" }))))
  const start = try http.get(host.origin + "/api/auth/sign-in")
  const pending = start.cookies.cookies["vibelang-sign-in"]!.value
  const atBroker = try http.get(start.headers.location!)
  const browser = atBroker.cookies.cookies["smithers-broker"]!.value
  const github = try http.get(atBroker.headers.location!)
  const form = try github.text
  const allow = form.match(/href="([^"]+)"/)![1]!.replaceAll("&amp;", "&")
  const approved = try http.get(allow)
  const callback = approved.headers.location!
  const crossBrowser = try http.get(callback)
  const identityFree = try http.execute(HttpClientRequest.get(callback).pipe(HttpClientRequest.setHeader("cookie", "smithers-broker=" + browser)))
  const handoff = identityFree.headers.location!
  const fragment = new URLSearchParams(new URL(handoff).hash.slice(1))
  const page = try http.get(host.origin + GitHub.Auth.Broker.CALLBACK)
  const script = try page.text
  const submit = (cookie: string, origin = host.origin) => http.execute(HttpClientRequest.post(host.origin + GitHub.Auth.Broker.CALLBACK).pipe(
    HttpClientRequest.setHeader("origin", origin), HttpClientRequest.setHeader("cookie", "vibelang-sign-in=" + cookie),
    HttpClientRequest.bodyJsonUnsafe({ code: fragment.get("code"), state: fragment.get("state") }),
  ))
  const foreignPost = try submit(pending, brokerOrigin)
  const wrongBrowser = try submit(pending + "0")
  const accepted = try submit(pending)
  const repeated = try submit(pending)
  const session = accepted.cookies.cookies["vibelang-session"]!.value
  const who = try (try http.execute(HttpClientRequest.get(host.origin + "/api/auth/session").pipe(HttpClientRequest.setHeader("cookie", "vibelang-session=" + session)))).json
  const journal = try (try http.get(brokerOrigin + "/__journal")).text
  try Effect.try(() => {
    expect([start.status, atBroker.status, approved.status, identityFree.status]).toEqual([302, 303, 303, 303])
    expect(new URL(callback).origin).toBe(brokerOrigin)
    expect([crossBrowser.status, foreignPost.status, wrongBrowser.status, repeated.status]).toEqual([400, 403, 400, 400])
    expect(accepted.status).toBe(200)
    expect(who).toMatchObject({ id: "7", login: "ada", role: "new" })
    expect(script.indexOf("history.replaceState")).toBeLessThan(script.indexOf("fetch("))
    expect(page.headers["referrer-policy"]).toBe("no-referrer")
    expect(page.headers["content-security-policy"]).toContain("default-src 'none'")
    expect(journal).toContain("auth/Broker")
    expect(journal).not.toMatch(/fixture-token|code_verifier|broker_return|\bada\b/)
    expect(handoff).not.toMatch(/fixture-token|ada/)
  })
}), 120_000)


/** Complete both production hosts over HTTP; GitHub is an injected token service, never interception. */
effect function signIn(hostOrigin: string) {
  const http = try HttpClient.HttpClient
  const { accepted, session } = try brokerSignIn(hostOrigin)
  const identity = try (try http.execute(HttpClientRequest.get(hostOrigin + "/api/auth/session").pipe(HttpClientRequest.setHeader("cookie", "vibelang-session=" + session)))).json
  try Effect.try(() => {
    expect(accepted.status).toBe(200)
    expect(identity).toMatchObject({ id: "7", login: "ada" })
  })
  return { session }
}

it.live("workerd: twelve broker sign-ins preserve the kept token under GitHub's ten-token rule", () => scoped(effect {
  const host = try acquireRelease(serveAuthBroker(), host => promise(() => host.dispose()))
  const broker = host.origin.replace("127.0.0.1", "localhost")
  provide FetchHttpClient.layer.pipe(Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { redirect: "manual" }))) {
    const http = try HttpClient.HttpClient
    const before = try (try http.get(broker + "/__tokens")).json
    try Effect.try(() => expect(before).toMatchObject({ kept: true, live: 1, attempts: 0 }))
    for (let index = 0; index < 12; index++) try signIn(host.origin)
    const stats = try (try http.get(broker + "/__tokens")).json
    const journal = try (try http.get(broker + "/__journal")).text
    const logs = try (try http.get(broker + "/__logs")).json as Array<string>
    try Effect.try(() => {
      expect(stats).toMatchObject({ kept: true, live: 1, attempts: 12 })
      const records = logs.map(line => JSON.parse(line)).filter(line => line.message === "auth.broker.revoke")
      expect(records).toHaveLength(12)
      expect(records.every(line => line.annotations.outcome === "revoked")).toBe(true)
      expect(records.every(line => /^[0-9a-f]{32}$/.test(line.annotations.trace_id) && /^[0-9a-f]{16}$/.test(line.annotations.span_id))).toBe(true)
      expect(JSON.stringify(logs)).not.toMatch(/fixture-token|fixture-refresh|code_verifier|\bada\b/)
      expect((JSON.parse(journal) as Array<{ name: string; rows: Array<unknown> }>).find(table => table.name === "flows_attempts")!.rows).toHaveLength(48)
      expect(journal).not.toMatch(/fixture-token|fixture-refresh|code_verifier|\bada\b/)
    })
  }
}), 120_000)

it.live("workerd: exhausted revocation retries count failure without failing sign-in", () => scoped(effect {
  const host = try acquireRelease(serveAuthBroker(), host => promise(() => host.dispose()))
  const broker = host.origin.replace("127.0.0.1", "localhost")
  provide FetchHttpClient.layer.pipe(Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { redirect: "manual" }))) {
    const http = try HttpClient.HttpClient
    const before = try (try http.get(broker + "/__tokens")).json as { failures: number }
    try http.get(broker + "/__fault-revoke?count=100")
    try signIn(host.origin)
    const after = try (try http.get(broker + "/__tokens")).json as { failures: number; attempts: number }
    const logs = try (try http.get(broker + "/__logs")).json as Array<string>
    try Effect.try(() => {
      expect(after.failures - before.failures).toBe(1)
      expect(after.attempts).toBe(3)
      const records = logs.map(line => JSON.parse(line)).filter(line => line.message === "auth.broker.revoke")
      expect(records).toHaveLength(1)
      expect(records[0]).toMatchObject({ level: "WARN", annotations: { outcome: "failed" } })
      expect(records[0].annotations).toMatchObject({ trace_id: expect.stringMatching(/^[0-9a-f]{32}$/), span_id: expect.stringMatching(/^[0-9a-f]{16}$/) })
      expect(JSON.stringify(logs)).not.toMatch(/fixture-token|fixture-refresh|code_verifier|\bada\b/)
    })
  }
}), 120_000)



it.live("connects through smithers.sh, writes once as the person, and every revocation stops the next write", () => scoped(effect {
  const host = try acquireRelease(serveAuthBroker(), host => promise(() => host.dispose()))
  provide FetchHttpClient.layer.pipe(Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { redirect: "manual" }))) {
    const http = try HttpClient.HttpClient
    const session = (try signIn(host.origin)).session
    const brokerOrigin = host.origin.replace("127.0.0.1", "localhost")
    const anonymous = try http.execute(HttpClientRequest.post(host.origin + "/api/auth/connect").pipe(HttpClientRequest.setHeader("origin", host.origin)))
    const issue = (key: string, title = "Delegated") => http.execute(HttpClientRequest.post(host.origin + "/api/issues").pipe(
      HttpClientRequest.setHeader("origin", host.origin), HttpClientRequest.setHeader("cookie", "vibelang-session=" + session),
      HttpClientRequest.bodyJsonUnsafe({ op: "new", key, number: 0, parent: 0, title, text: "private-issue-body", assignee: "", example: "", prior: "" }),
    ))
    const state = effect { return (try (try http.get(host.origin + "/__connection/state")).json) as { issues: Array<{ title: string }>; revoked: number; connections: Array<{ origin: string }>; journal: unknown; rows: unknown } }
    const unconnected = try issue("before")
    const openedBefore = (try (try http.get(host.origin + "/__opened")).json) as number
    const forged = try Delegation.signer({ origin: host.origin, brokerOrigin, secret: Redacted.make("not-the-site-secret-but-32-characters") })
    const call = { person: 9, delegation: "d", mode: "read" as const, key: "", payload: { path: "/repos/smithersai/vibelang" } }
    const unsigned = try http.execute(HttpClientRequest.post(brokerOrigin + Delegation.ROUTE + "?person=9").pipe(HttpClientRequest.bodyJsonUnsafe({ origin: host.origin, person: 9, request: "", payload: "{}" })))
    const wronglySigned = try http.execute(HttpClientRequest.post(brokerOrigin + Delegation.ROUTE + "?person=9").pipe(HttpClientRequest.bodyJsonUnsafe(try forged.envelope(call))))
    const openedAfter = (try (try http.get(host.origin + "/__opened")).json) as number
    const first = try brokerConnect(host.origin, session)
    const written = try issue("key-1")
    const again = try issue("key-1")
    const afterWrite = try state
    const disconnect = try http.execute(HttpClientRequest.post(host.origin + "/api/auth/disconnect").pipe(HttpClientRequest.setHeader("origin", host.origin), HttpClientRequest.setHeader("cookie", "vibelang-session=" + session)))
    const afterDisconnect = try issue("key-2")
    const revokedOnce = (try state).revoked
    try brokerConnect(host.origin, session)
    const rejoined = try issue("key-3", "Second")
    try http.get(host.origin + "/__connection/end")
    const afterGitHubRevoke = try issue("key-4")
    const final = try state
    try Effect.try(() => {
      expect(anonymous.status).toBe(401)
      expect(unconnected.status).toBe(401)
      expect([unsigned.status, wronglySigned.status]).toEqual([403, 403])
      expect(openedAfter).toBe(openedBefore)
      expect(first.press.status).toBe(303)
      expect(first.page).toContain("Connect")
      expect(first.answered.status).toBe(303)
      expect(first.answered.headers.location).toContain(host.origin + GitHub.Auth.Broker.CALLBACK + "#")
      expect(first.accepted.status).toBe(200)
      expect(first.location.location).toBe("/?issues=1")
      expect([written.status, again.status]).toEqual([200, 200])
      expect(afterWrite.issues.map((row) => row.title)).toEqual(["Delegated"])
      expect(afterWrite.connections.map((row) => row.origin)).toEqual([host.origin])
      expect(JSON.stringify(afterWrite.rows) + JSON.stringify(afterWrite.journal)).not.toMatch(/fixture-token|fixture-refresh|private-issue-body/)
      expect(disconnect.status).toBe(303)
      expect(afterDisconnect.status).toBe(401)
      expect(revokedOnce).toBe(1)
      expect(rejoined.status).toBe(200)
      expect(afterGitHubRevoke.status).toBe(401)
      expect(final.connections).toEqual([])
      expect(final.revoked).toBe(1)
      expect(brokerOrigin).not.toBe(host.origin)
    })
  }
}), 120_000)
