import { expect, it } from "@effect/vitest"
import { backend } from "../src/surfaces/backend.vibe"
import { ListActions, RunWorkflow, ReadRun, Rerun } from "../src/surfaces/commands.vibe"
it.live("agent surfaces discover real actions, run by schema, read results and re-run stored input", () => effect {
  provide backend(true, undefined) {
    const list = try ListActions.run({})
    const first = try RunWorkflow.run({ flow: "vibelang/Post", input: '{"text":"How do I install it?"}', wait: true })
    const result = try ReadRun.run(first)
    const repeated = try Rerun.run(first)
    const invalid = RunWorkflow.run({ flow: "vibelang/Post", input: "{broken", wait: false }) catch (e) => e.message
    try Effect.try(() => {
      expect(list.actions.some(entry => entry.name === "vibelang/Post")).toBe(true)
      expect(result.state).toBe("passed")
      expect(result.result).toBe("null")
      expect(repeated.id).not.toBe(first.id)
      expect(invalid).toBe("Invalid action input.")
    })
  }
})
