import { describe, expect, it } from "@effect/vitest"
import { emptySandboxLedger } from "../src/core/sandboxDecision.vibe"
import { meter, monthOf, millisecondOf } from "../src/core/sandboxMeter.vibe"

const boundary = Date.UTC(2026, 11, 1)
const ledger = { ...emptySandboxLedger("u", "contributor", 36000, monthOf(boundary - 10), boundary - 10), usedMilliseconds: 9, sandboxes: [{ id: "a", conversation: "a", running: true }, { id: "b", conversation: "b", running: true }] }
describe("durable meter's exact integer millisecond boundary", () => {
  it.effect("keeps both sides of a UTC boundary and sums concurrent usage", () => effect {
    const next = try meter(ledger, {}, boundary + 20, 36000)
    try Effect.try(() => {
      expect(next.months[String(ledger.month)]).toBe(29)
      expect(next.months[String(boundary)]).toBe(40)
      expect(next.ledger.usedMilliseconds).toBe(40)
      expect(Object.values(next.months).reduce((sum, value) => sum + value, 0)).toBe(69)
    })
  })
  it.effect("counts every delayed millisecond and never resets on month rollback", () => effect {
    const next = try meter(ledger, {}, boundary + 100000, 60)
    const back = try meter(next.ledger, next.months, boundary - 100, 60)
    const forward = try meter(back.ledger, back.months, boundary + 100010, 60)
    try Effect.try(() => {
      expect(next.ledger.usedMilliseconds).toBe(200000)
      expect(back.ledger).toEqual(next.ledger)
      expect(forward.ledger.usedMilliseconds).toBe(200020)
    })
  })
  it.effect("accepts an exact safe sum and refuses overflow without corrupting prior state", () => effect {
    const original = { ...ledger, sandboxes: [ledger.sandboxes[0]!], usedMilliseconds: Number.MAX_SAFE_INTEGER - 1 }
    const exact = try meter(original, {}, original.lastMeteredAt + 1, 36000)
    const overflow = try Effect.result(meter(exact.ledger, exact.months, original.lastMeteredAt + 2, 36000))
    try Effect.try(() => { expect(exact.ledger.usedMilliseconds).toBe(Number.MAX_SAFE_INTEGER); expect(overflow._tag).toBe("Failure"); expect(original.usedMilliseconds).toBe(Number.MAX_SAFE_INTEGER - 1) })
  })
  it.effect("refuses NaN, infinity and invalid Date clocks", () => effect {
    for (const clock of [NaN, Infinity, -1, Number.MAX_SAFE_INTEGER, 8640000000000000]) {
      const result = try Effect.result(millisecondOf(clock))
      try Effect.try(() => expect(result._tag).toBe("Failure"))
    }
  })
})
