// The web app's real view and update, driven the way a person drives them, with Foldkit scenes (no browser).
import { Command, click, expect, given, placeholder, role, scene, Subscription, text, title, type } from "foldkit/scene"
import { describe, expect as assert, it } from "@effect/vitest"
import { newClient } from "../src/core/conversation.vibe"
import {
  ClosePalette, CONTRIBUTE_URL, EndTourCommand, FocusComposer, HOME_CONVERSATION, Message, type Model, PostMessage, ShowPalette,
  StartTourCommand, update,
} from "../src/web/main.vibe"
import { view } from "../src/web/view.vibe"

const home: Model = {
  surface: "splash",
  palette: false,
  draft: "",
  session: "s1",
  name: "Ada",
  reducedMotion: false,
  sent: 0,
  conversation: HOME_CONVERSATION,
  client: newClient,
  mode: "mock",
  stream: "closed",
  epoch: 0,
  from: 0,
  following: true,
  followIntent: 0,
  answer: "",
  announced: 0,
  connection: "",
  tour: false,
  tourError: "",
  docs: "pane",
}

describe("the splash", () => {
  it("is VibeLang's home page: Learn more first, then Ask the agent and Contribute, and routes to the docs and GitHub", () => {
    scene(
      { update, view },
      given(home),
      expect(role("heading", { name: "VibeLang" })).toExist(),
      expect(role("button", { name: "Learn more" })).toHaveClass("vl-primary"),
      expect(role("button", { name: "Ask the agent" })).toHaveClass("vl-ask"),
      expect(role("button", { name: "Ask the agent" })).toHaveAttr("aria-keyshortcuts", "Meta+K"),
      expect(role("link", { name: "Contribute" })).toHaveClass("vl-ask"),
      expect(role("link", { name: "Contribute" })).toHaveAttr("href", CONTRIBUTE_URL),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
      expect(role("link", { name: "Docs" })).toExist(),
      expect(role("link", { name: "GitHub" })).toExist(),
      expect(text("Mock")).toExist(),
      expect(role("button", { name: "Minimize the VibeLang home page" })).toBeAbsent(),
    )
  })

  it("⌘K opens the prompt; a question turns the page into the chat with the splash as its first pane", () => {
    scene(
      { update, view },
      given(home),
      Subscription.emit(Message.ScrolledTranscript({ bottom: false })),
      Subscription.emit(Message.PressedCommandK()),
      Command.expectExact(ShowPalette({})),
      Command.resolve(ShowPalette, Message.FocusedPrompt()),
      expect(role("dialog", { name: "Ask the agent" })).toExist(),
      type(placeholder("Ask about VibeLang, or describe what to change"), "How do I install it?"),
      click(role("button", { name: "Send" })),
      Command.expectExact(PostMessage({ conversation: HOME_CONVERSATION, clientId: "s1-1", name: "Ada", text: "How do I install it?" }), ClosePalette({ dock: true })),
      Command.resolve(ClosePalette, Message.FocusedPrompt()),
      Command.resolve(PostMessage, Message.SucceededPost({ clientId: "s1-1" })),
      expect(role("dialog", { name: "Ask the agent" })).toHaveAttr("data-state", "closed"),
      expect(role("button", { name: "Expand the VibeLang home page" })).toExist(),
      expect(text("How do I install it?")).toExist(),
    )
  })

  it("Escape closes the prompt without sending", () => {
    scene(
      { update, view },
      given({ ...home, palette: true }),
      Subscription.emit(Message.PressedEscape()),
      Command.expectExact(ClosePalette({ dock: false })),
      Command.resolve(ClosePalette, Message.FocusedPrompt()),
      expect(role("dialog", { name: "Ask the agent" })).toHaveAttr("data-state", "closed"),
    )
  })
})

describe("the chat", () => {
  const chatting: Model = { ...home, surface: "chat", stream: "open", sent: 1 }

  it("shows the agent's streamed reply as it arrives and confirms the pending post", () => {
    scene(
      { update, view },
      given({ ...chatting, client: { ...newClient, pending: [{ clientId: "s1-1", text: "hi", error: "" }] } }),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "s1-1", name: "Ada", text: "hi" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" } })),
      expect(role("status", { name: "Thinking" })).toExist(),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 3, id: "r1", text: "Use `npm create`" } })),
      expect(text("npm create")).toExist(),
      expect(role("log", { name: "Conversation" })).toExist(),
      expect(role("status", { name: "Answer" })).toHaveText(""),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFinished", seq: 4, id: "r1" } })),
      expect(text("VibeLang agent")).toExist(),
      expect(role("status", { name: "Answer" })).toHaveText("Answer 1: Use `npm create`"),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFinished", seq: 4, id: "r1" } })),
      Command.expectNone(),
      expect(role("status", { name: "Answer" })).toHaveText("Answer 1: Use `npm create`"),
    )
  })

  it("a failed answer is announced once, without announcing its streamed pieces", () => {
    scene(
      { update, view },
      given({ ...chatting, following: false }),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "s1-1", name: "Ada", text: "hi" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 3, id: "r1", text: "partial" } })),
      expect(role("status", { name: "Answer" })).toHaveText(""),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFailed", seq: 4, id: "r1", reason: "interrupted" } })),
      expect(role("status", { name: "Answer" })).toHaveText("Answer 1: Answer failed"),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFailed", seq: 4, id: "r1", reason: "interrupted" } })),
      Command.expectNone(),
      expect(role("status", { name: "Answer" })).toHaveText("Answer 1: Answer failed"),
    )
  })

  it("a failed answer says why, in the agent's words, and live mode shows no Mock pill", () => {
    const reason = "The agent's daily budget is spent. It resets at 00:00 UTC."
    scene(
      { update, view },
      given({ ...chatting, mode: "live" }),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "s1-1", name: "Ada", text: "hi" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFailed", seq: 3, id: "r1", reason } })),
      expect(text(reason)).toExist(),
      expect(text("Answer failed")).not.toExist(),
      expect(role("status", { name: "Thinking" })).not.toExist(),
      expect(text("Mock")).not.toExist(),
    )
  })

  it("scrolling up pauses following; Latest follows the transcript again", () => {
    scene(
      { update, view },
      given(chatting),
      Subscription.emit(Message.ScrolledTranscript({ bottom: false })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "other", name: "Grace", text: "hi" } })),
      Command.expectNone(),
      expect(role("button", { name: "Latest" })).toExist(),
      click(role("button", { name: "Latest" })),
      Command.expectExact(FocusComposer({})),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(role("button", { name: "Latest" })).toBeAbsent(),
      Subscription.emit(Message.ScrolledTranscript({ bottom: false })),
      Subscription.emit(Message.ScrolledTranscript({ bottom: true })),
      expect(role("button", { name: "Latest" })).toBeAbsent(),
    )
  })

  it("a refused post stays, marked with why", () => {
    scene(
      { update, view },
      given({ ...chatting, client: { ...newClient, pending: [{ clientId: "s1-1", text: "hi", error: "" }] } }),
      Subscription.emit(Message.FailedPost({ clientId: "s1-1", reason: "too-long" })),
      expect(text("too-long")).toBeAbsent(),
      expect(text("Message too long")).toExist(),
      click(role("button", { name: "Retry" })),
      Command.expectExact(PostMessage({ conversation: HOME_CONVERSATION, clientId: "s1-1", name: "Ada", text: "hi" }), FocusComposer({})),
      expect(text("Message too long")).toBeAbsent(),
      Command.resolve(PostMessage, Message.SucceededPost({ clientId: "s1-1" })),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
    )
  })

  it("a broken event stream offers to reconnect", () => {
    scene(
      { update, view },
      given(chatting),
      Subscription.emit(Message.FailedEvents({ reason: "network" })),
      expect(text("Disconnected")).toExist(),
      expect(role("status", { name: "Connection" })).toHaveText("Disconnected"),
      click(role("button", { name: "Reconnect" })),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(role("button", { name: "Reconnect" })).toBeAbsent(),
      expect(role("status", { name: "Connection" })).toHaveText("Reconnecting"),
    )
  })

  it("the pane maximizes the splash again, and its minimize button returns to the conversation", () => {
    scene(
      { update, view },
      given({ ...chatting, client: { ...newClient, pending: [{ clientId: "s1-1", text: "hi", error: "" }] } }),
      click(role("button", { name: "Expand the VibeLang home page" })),
      expect(role("heading", { name: "VibeLang" })).toExist(),
      expect(role("button", { name: "Chat" })).toBeAbsent(),
      click(role("button", { name: "Minimize the VibeLang home page" })),
      Command.expectExact(FocusComposer({})),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(text("hi")).toExist(),
    )
  })

  it("Escape minimizes the maximized splash, and does nothing more in the chat", () => {
    scene(
      { update, view },
      given({ ...chatting, surface: "splash", client: { ...newClient, pending: [{ clientId: "s1-1", text: "hi", error: "" }] } }),
      Subscription.emit(Message.PressedEscape()),
      Command.expectExact(FocusComposer({})),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(text("hi")).toExist(),
      Subscription.emit(Message.PressedEscape()),
      Command.expectNone(),
      expect(text("hi")).toExist(),
    )
  })

  it("Escape keeps the splash when there is no conversation to return to", () => {
    scene(
      { update, view },
      given(home),
      Subscription.emit(Message.PressedEscape()),
      Command.expectNone(),
      expect(role("heading", { name: "VibeLang" })).toExist(),
    )
  })
})

describe("product language and authors", () => {
  it("labels this tab's posts You and keeps another visitor's neutral name", () => {
    scene({ update, view }, given({ ...home, surface: "chat", sent: 1 }),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "s1-1", name: "Guest", text: "mine" } })),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 2, id: "m2", clientId: "other-1", name: "Guest", text: "theirs" } })),
      expect(text("You")).toExist(), expect(text("Guest")).toExist())
  })
  for (const [reason, label] of [["empty", "Empty message"], ["duplicate", "Already sent"], ["busy", "Agent busy"], ["not-replying", "Answer unavailable"], ["Factory closed", "Send failed"]]) {
    it(`a refused post uses product words for ${reason}`, () => {
      scene({ update, view }, given({ ...home, surface: "chat", client: { ...newClient, pending: [{ clientId: "s1-1", text: "hi", error: reason! }] } }),
        expect(text(label!)).toExist(), expect(role("button", { name: "Retry" })).toExist())
    })
  }
  it("has no mock explanation tooltip or repeated answer-failure sentence", () => {
    scene({ update, view }, given({ ...home, surface: "chat", client: { ...newClient, conversation: { ...newClient.conversation, agent: "failed" } } }),
      expect(text("Mock")).not.toHaveAttr("title", "No backend or model: answers are scripted"),
      expect(text("The last answer failed")).toBeAbsent())
  })
})

describe("Learn more: the agent's tour", () => {
  const TOUR = "tour-s1"
  const started = [
    Subscription.emit(Message.ReceivedEvent({ event: { type: "TourStarted", seq: 1, id: "t1" } })),
    Subscription.emit(Message.ReceivedEvent({ event: { type: "PaneOpened", seq: 2, id: "t1", url: "https://vibelang.sh/" } })),
    Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 3, id: "t1", text: "VibeLang is Effect as its own language." } })),
  ] as const

  it("turns the page into this tab's tour conversation, with the agent in control: a glow and Esc", () => {
    scene(
      { update, view },
      given(home),
      click(role("button", { name: "Learn more" })),
      Command.expectExact(StartTourCommand({ conversation: TOUR })),
      Command.resolve(StartTourCommand, Message.SucceededTour()),
      expect(role("log", { name: "Conversation" })).toExist(),
      expect(role("button", { name: "Esc" })).toHaveAttr("aria-keyshortcuts", "Escape"),
      expect(text("Esc")).toExist(),
      expect(role("region", { name: "Docs" })).toBeAbsent(),
    )
  })

  it("opens the docs pane where the agent says, moves it, and shows the narration as it arrives", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true }),
      ...started,
      expect(role("region", { name: "Docs" })).toExist(),
      expect(title("VibeLang docs")).toHaveAttr("src", "https://vibelang.sh/"),
      expect(text("VibeLang is Effect as its own language.")).toExist(),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "PaneOpened", seq: 4, id: "t1", url: "https://vibelang.sh/setup" } })),
      expect(title("VibeLang docs")).toHaveAttr("src", "https://vibelang.sh/setup"),
      expect(text("vibelang.sh/setup")).toExist(),
      expect(role("button", { name: "Esc" })).toExist(),
    )
  })

  it("Escape ends the tour at once: the glow and Esc go, the conversation and the docs pane stay", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true }),
      ...started,
      Subscription.emit(Message.PressedEscape()),
      Command.expectExact(EndTourCommand({ conversation: TOUR }), FocusComposer({})),
      Command.resolve(EndTourCommand, Message.FocusedPrompt()),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
      expect(title("VibeLang docs")).toHaveAttr("src", "https://vibelang.sh/"),
      expect(text("VibeLang is Effect as its own language.")).toExist(),
      Subscription.emit(Message.ReceivedEvent({ event: { type: "TourEnded", seq: 4, id: "t1" } })),
      expect(role("status", { name: "Answer" })).toHaveText("Answer 1: VibeLang is Effect as its own language."),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
    )
  })

  it("clicking Esc ends the tour the same way", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true }),
      ...started,
      click(role("button", { name: "Esc" })),
      Command.expectExact(EndTourCommand({ conversation: TOUR }), FocusComposer({})),
      Command.resolve(EndTourCommand, Message.FocusedPrompt()),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
      expect(role("region", { name: "Docs" })).toExist(),
    )
  })

  it("Escape still stops a tour whose end didn't reach the agent", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: false }),
      ...started,
      Subscription.emit(Message.PressedEscape()),
      Command.expectExact(EndTourCommand({ conversation: TOUR }), FocusComposer({})),
      Command.resolve(EndTourCommand, Message.FocusedPrompt()),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
    )
  })

  it("a second Learn more while the tour runs does nothing new", () => {
    scene(
      { update, view },
      given({ ...home, conversation: TOUR, stream: "open", tour: true }),
      ...started,
      Subscription.emit(Message.ClickedSplash()),
      click(role("button", { name: "Learn more" })),
      Command.expectNone(),
      expect(role("heading", { name: "VibeLang" })).toExist(),
    )
  })

  it("the glow goes when the tour finishes on its own", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true }),
      ...started,
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFinished", seq: 4, id: "t1" } })),
      Command.expectNone(),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
      expect(role("region", { name: "Docs" })).toExist(),
    )
  })

  it("ending before the tour was recorded ends it once it is", () => {
    const learning = update(home, Message.ClickedLearnMore())
    const ended = update(learning.model, Message.PressedEscape())
    const named = (commands: ReadonlyArray<{ readonly name: string; readonly args?: unknown }> | undefined) =>
      commands?.map((command) => [command.name, command.args])
    assert(named(ended.commands)).toEqual([["EndTour", { conversation: TOUR }], ["FocusComposer", {}]])
    assert(named(update(ended.model, Message.SucceededTour()).commands)).toEqual([["EndTour", { conversation: TOUR }]])
    assert(update(learning.model, Message.SucceededTour()).commands).toBeUndefined()
  })

  it("a refused tour gives control back and says why", () => {
    scene(
      { update, view },
      given(home),
      click(role("button", { name: "Learn more" })),
      Command.resolve(StartTourCommand, Message.FailedTour({ reason: "busy" })),
      expect(role("button", { name: "Esc" })).toBeAbsent(),
      expect(text("Agent busy")).toExist(),
    )
  })

  it("the docs pane maximizes, and Escape or its button minimizes it", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open" }),
      ...started,
      Subscription.emit(Message.ReceivedEvent({ event: { type: "ReplyFinished", seq: 4, id: "t1" } })),
      click(role("button", { name: "Maximize the docs" })),
      expect(role("region", { name: "Docs" })).toHaveAttr("data-maximized", "true"),
      Subscription.emit(Message.PressedEscape()),
      Command.expectNone(),
      expect(role("region", { name: "Docs" })).toHaveAttr("data-maximized", "false"),
      click(role("button", { name: "Maximize the docs" })),
      click(role("button", { name: "Minimize the docs" })),
      expect(role("region", { name: "Docs" })).toHaveAttr("data-maximized", "false"),
    )
  })

  it("an end that never reached the agent gives Esc back while the tour still runs", () => {
    scene(
      { update, view },
      given({ ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true }),
      ...started,
      click(role("button", { name: "Esc" })),
      Command.resolve(EndTourCommand, Message.FailedEndTour()),
      Command.resolve(FocusComposer, Message.FocusedPrompt()),
      expect(role("button", { name: "Esc" })).toExist(),
    )
  })

  it("Learn more after the stream broke follows the conversation again from where it was", () => {
    const broken: Model = { ...home, conversation: TOUR, stream: "failed", epoch: 3, from: 0 }
    const learning = update(broken, Message.ClickedLearnMore())
    assert(learning.model).toMatchObject({ stream: "open", epoch: 4, from: 0, tour: true })
  })

  it("a Learn more refused busy by this tab's own running tour keeps that tour in control", () => {
    const touring = [{ type: "TourStarted", seq: 1, id: "t1" }].reduce(
      (model: Model, event) => update(model, Message.ReceivedEvent({ event: event as never })).model,
      { ...home, surface: "chat", conversation: TOUR, stream: "open", tour: true } as Model,
    )
    assert(update(touring, Message.FailedTour({ reason: "busy" })).model.tour).toBe(true)
    assert(update(home, Message.FailedTour({ reason: "busy" })).model.tour).toBe(false)
  })
})
