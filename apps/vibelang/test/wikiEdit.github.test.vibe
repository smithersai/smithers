// @vitest-environment node
// Wiki edits as the site makes them after decision 0165, on real GitHub: reads, a drafted edit, a maintainer's save and
// proposal and a contributor's proposal go through smithers.sh's per-person connection host (fuzz/delegated.vibe) to
// codeplanesmithers/smithers-vibelang-e2e, on the durable engine over SQLite, against a disposable base branch
// (test/support/wikiWorld.vibe). Nothing merges. Replayed from test/recordings/wiki.json unless VIBE_GITHUB says
// otherwise (test/support/github.vibe). Unhappy paths stay in test/wikiDelegated.coverage.test.vibe as injected faulty services.
import { describe, expect, it } from "@effect/vitest"
import { TEST_AUTHOR } from "./support/github.vibe"
import { failed, journey, journeyResult, PAGE, PATH, SOURCE, succeeded, wikiWorld } from "./support/wikiWorld.vibe"

const EDITED = `${SOURCE}\nBetter text.\n`

describe("wiki edits on real GitHub through smithers.sh's delegation", () => {
  it.live("a read, a kept draft, a save and proposals each open one review of exactly the page as the person", () => scoped(effect {
    const w = try wikiWorld("wiki")
    try ensuring(effect {
      expect(try journey(w)).toEqual(journeyResult)
      const writes = w.writes()

      // A read observes the page's source and its blob revision on GitHub, and stores both.
      const read = try succeeded(try w.perform({}))
      expect(read.pages).toEqual([{ id: PAGE, source: SOURCE, revision: expect.stringMatching(/^[0-9a-f]{40}$/) }])
      expect(read.draft).toBeUndefined()
      expect(try promise(() => w.storage.get(`wiki/page/${PAGE}`))).toEqual(read.pages[0])
      expect(try promise(() => w.storage.get("wiki/revision"))).toBe(read.seq)
      // The reader's kept text comes back; a visitor has none, and a stored value that is not a draft is ignored.
      try promise(() => w.storage.put(w.draftKey, { page: PAGE, text: "Kept." }))
      expect((try succeeded(try w.perform({}))).draft).toEqual({ page: PAGE, text: "Kept." })
      try Ref.set(w.caller, undefined)
      expect((try succeeded(try w.perform({}))).draft).toBeUndefined()
      try Ref.set(w.caller, { role: "maintainer" })
      try promise(() => w.storage.put(w.draftKey, { text: 1 }))
      expect((try succeeded(try w.perform({}))).draft).toBeUndefined()
      expect((try succeeded(try w.perform({}, false))).pages).toHaveLength(1)

      // A change refuses a moved base and an empty or unchanged text before any write.
      expect(failed(try w.act("save", { base: "Stale.", text: EDITED }))).toEqual({ reason: "conflict", unwritten: true })
      expect(failed(try w.act("save", { base: SOURCE, text: "  " }))).toEqual({ reason: "empty", unwritten: true })
      expect(failed(try w.act("save", { base: SOURCE, text: SOURCE }))).toEqual({ reason: "empty", unwritten: true })
      // An agent may draft but never save; a draft needs an ask and a key.
      try Ref.set(w.caller, { role: "maintainer", kind: "agent" })
      expect(failed(try w.perform({ op: "save", base: SOURCE, text: EDITED }))?.reason).toBe("forbidden")
      expect(failed(try w.perform({ op: "draft", text: " " }))?.reason).toBe("empty")
      expect(failed(try w.perform({ op: "draft", text: "Hi", key: "" }))?.reason).toBe("sign-in")
      const drafted = try succeeded(try w.perform({ op: "draft", text: "Shorter." }, false))
      expect(drafted.draft).toEqual({ page: PAGE, text: `${SOURCE}\nShorter.\n` })
      expect(w.writes()).toBe(writes)

      // A contributor proposes through an authority with no live operation check: still one review, as the person.
      try Ref.set(w.caller, { role: "contributor" })
      w.check(false)
      try promise(() => w.storage.put(w.draftKey, { page: PAGE, text: "Other." }))
      const proposed = try succeeded(try w.act("propose", { base: SOURCE, text: EDITED }))
      expect(try w.review(proposed.review!)).toMatchObject({ author: TEST_AUTHOR, files: [[PATH, "modified"]], head: EDITED, onBase: SOURCE })
      // A different kept text stays.
      expect(try w.kept()).toEqual({ page: PAGE, text: "Other." })
      expect(w.writes()).toBe(writes + 3)
    }, w.cleanup)
  }), 300_000)
})
