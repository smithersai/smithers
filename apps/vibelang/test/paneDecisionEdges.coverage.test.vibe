// The wiki editor's submit plan and error words, and the sandbox pane's periodic read (src/web/paneDecision.vibe),
// on every arm their contracts state.
import { describe, expect, it } from "@effect/vitest"
import { polledFailure, polledSandbox, wikiEditErrorText, wikiSubmitPlan } from "../src/web/paneDecision.vibe"

describe("submitting the wiki editor", () => {
  it.each([
    ["while a write is in flight, whatever the text", true, "new", "old", true, true, "ignore"],
    ["while busy even with no change", true, "same", "same", false, false, "ignore"],
    ["with the page unchanged", false, "same", "same", true, true, "no-changes"],
    ["as someone who may save", false, "new", "old", true, true, "save"],
    ["as someone who may only propose", false, "new", "old", false, true, "propose"],
    ["as someone who may do neither", false, "new", "old", false, false, "refuse"],
  ] as const)("%s plans %s", (_name, busy, text, base, canSave, canPropose, plan) => {
    expect(wikiSubmitPlan(busy, text, base, canSave, canPropose)).toBe(plan)
  })
})

describe("the wiki editor's error words", () => {
  it.each([
    ["forbidden", "Not allowed."],
    ["conflict", "The page changed. Reload the editor."],
    ["connect", "Connect GitHub."],
    ["sign-in", "Connect GitHub."],
    ["fork", "Fork on GitHub."],
    ["install", "Install Smithers on your fork."],
    ["unavailable", "Couldn't save. Retry."],
    ["", "Couldn't save. Retry."],
  ] as const)("%j reads %j", (reason, words) => {
    expect(wikiEditErrorText(reason)).toBe(words)
  })
})

describe("the open sandbox pane's periodic read", () => {
  const idleFailure = { pane: "pane", operation: "", busy: false, error: "closed" } as const
  const failedStart = { pane: "pane", operation: "start", busy: false, error: "closed" } as const
  const waitingStop = { pane: "closed", operation: "stop", busy: true, error: "" } as const
  it("ends a failed read", () => {
    expect(polledSandbox(idleFailure, false)).toEqual({ pane: "pane", operation: "", busy: false, error: "" })
  })
  it("keeps a failed start's reason so its alert and Retry stay", () => {
    expect(polledSandbox(failedStart, false)).toEqual(failedStart)
  })
  it("keeps an operation waiting, and still opens the pane when told to", () => {
    expect(polledSandbox(waitingStop, true)).toEqual({ ...waitingStop, pane: "pane" })
  })
  it("names a failed read only when no operation is waiting or failed", () => {
    expect(polledFailure({ ...idleFailure, error: "" }, "offline")).toEqual({ ...idleFailure, error: "offline" })
    expect(polledFailure(failedStart, "offline")).toEqual(failedStart)
    expect(polledFailure(waitingStop, "offline")).toEqual(waitingStop)
  })
})
