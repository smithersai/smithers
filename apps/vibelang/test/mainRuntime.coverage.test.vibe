// The browser Commands that touch the page and the subscriptions that listen to it, on the real runtime: Render.afterCommit
// resolves on a real commit and each subscription hears a real DOM event.
import { describe, expect, it } from "@effect/vitest"
import { vi } from "vitest"
import { Runtime } from "foldkit"
import { Actions } from "../src/actions/Actions.vibe"
import { MockActions } from "../src/actions/MockActions.vibe"
import type { Factory } from "../src/core/Factory.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"
import { newClient } from "../src/core/conversation.vibe"
import { initial as initialActions } from "../src/web/actionModel.vibe"
import { accountOf, CloseIssueDialog, CloseRoleDialog, FocusAccountMenu, FocusIssueControl, FocusTourControl, FocusWikiEditor, init, MeasureTheatre, type Model, PresentTour, RevealWiki, RunAction, ShowIssueDialog, ShowRoleDialog, WikiLocation } from "../src/web/main.vibe"
import { Factory as FactoryService, Refused, Unavailable } from "../src/core/Factory.vibe"
import { overlaid } from "./support/overlaid.vibe"
import { application } from "./support/application.vibe"
import { faultyActions } from "./support/FaultyActions.vibe"
import { activeIs, addElement, clickLink, container, dispatchWindow, location, popTo, press, remove } from "./support/browser.ts"

const flags = { session: "r", name: "Ada", mode: "mock" as const }
type Started = ReturnType<typeof init>
const quiet = (over: Partial<Model> = {}, commands: () => NonNullable<Started["commands"]> = () => []) => (): Started => ({ model: { ...init(flags).model, surface: "chat", ...over }, commands: commands() })

/** The app starting from `first`; `seen.model` is the latest model it rendered. */
effect function started(make: () => Started, actions: Layer.Layer<Actions, never, Factory> = MockActions({ actor: "person" }), resources: Layer.Layer<Factory> = MockFactory) {
  const first = try Effect.try(make)
  const seen: { model: Model; messages: Array<string> } = { model: first.model, messages: [] }
  const node = try acquireRelease(sync(container), (node) => sync(() => remove(node)))
  const program = try Effect.try(() => application(node, resources, (model) => { seen.model = model }, () => first, actions, (message) => { seen.messages.push(message._tag) }))
  try acquireRelease(sync(() => Runtime.embed(program, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
  return seen
}

const owned = <E extends HTMLElement>(tag: string, id: string, parent?: HTMLElement) => acquireRelease(sync(() => addElement<E>(tag, id, parent)), (node) => sync(() => node.remove()))
const settled = (check: () => void, timeout = 4000) => promise(() => vi.waitFor(check, { timeout }))
/**
 * An ordering witness: a window resize always answers RemeasureTheatre, after the messages of every event dispatched
 * before it. Returns the messages that arrived before the witness.
 */
const witnessed = (seen: { readonly messages: ReadonlyArray<string> }, act: () => void = () => {}) => effect {
  const from = seen.messages.length
  try settled(() => { act(); dispatchWindow("resize"); expect(seen.messages.slice(from)).toContain("RemeasureTheatre") })
  return seen.messages.slice(from, seen.messages.indexOf("RemeasureTheatre", from))
}
describe("page commands", () => {
  it.live("show both dialogs once the view has committed", () => scoped(effect {
    const role = try owned<HTMLDialogElement>("dialog", "vl-role-dialog")
    try owned("button", "vl-role-cancel", role)
    const issue = try owned<HTMLDialogElement>("dialog", "ix-dialog")
    try started(quiet({}, () => [ShowRoleDialog({}), ShowIssueDialog({})]))
    try settled(() => { expect(role.open).toBe(true); expect(issue.open).toBe(true) })
  }))
  it.live("close both dialogs and return focus to the commit control", () => scoped(effect {
    const role = try owned<HTMLDialogElement>("dialog", "vl-role-dialog")
    const issue = try owned<HTMLDialogElement>("dialog", "ix-dialog")
    const commit = try owned<HTMLButtonElement>("button", "ix-commit")
    try Effect.try(() => { role.showModal(); issue.showModal() })
    try started(quiet({}, () => [CloseRoleDialog({}), CloseIssueDialog({})]))
    try settled(() => { expect(role.open).toBe(false); expect(issue.open).toBe(false); expect(activeIs(commit)).toBe(true) })
  }))
  it.live("a page without the dialogs still answers", () => scoped(effect {
    const seen = try started(quiet({}, () => [ShowRoleDialog({}), CloseRoleDialog({}), ShowIssueDialog({}), CloseIssueDialog({})]))
    try settled(() => expect(seen.model.surface).toBe("chat"))
  }))
  it.each([
    ["the account menu's people control", () => FocusAccountMenu({ open: true }), "vl-account-people"],
    ["the wiki editor", () => FocusWikiEditor({}), "vl-wiki-editor"],
    ["a named issue control", () => FocusIssueControl({ id: "ix-kind-VIPs" }), "ix-kind-VIPs"],
  ] as const)("focus %s", (_label, make, id) => Effect.runPromise(scoped(effect {
    const target = try owned<HTMLTextAreaElement>("textarea", id)
    try started(quiet({}, () => [make()]))
    try settled(() => expect(activeIs(target)).toBe(true))
  })))
})

describe("the wiki location", () => {
  it.live("pushes a new page, scrolls its content to the top and reveals the docked pane", () => scoped(effect {
    const content = try owned<HTMLDivElement>("div", "wiki-content-test")
    const pane = try owned<HTMLDivElement>("div", "vl-wiki")
    try sync(() => { content.className = "vl-wiki-content"; content.scrollTop = 80; pane.setAttribute("data-maximized", "false") })
    try started(quiet({}, () => [WikiLocation({ url: "/wiki/testing" }), RevealWiki({})]))
    try settled(() => { expect(location()).toBe("/wiki/testing"); expect(content.scrollTop).toBe(0) })
  }))
  it.live("goes to a heading, keeps a maximized pane where it is, and leaves an equal address alone", () => scoped(effect {
    const heading = try owned<HTMLHeadingElement>("h2", "rulings")
    const pane = try owned<HTMLDivElement>("div", "vl-wiki")
    let scrolled = 0
    try sync(() => { heading.scrollIntoView = () => { scrolled += 1 }; pane.setAttribute("data-maximized", "true") })
    try started(quiet({}, () => [WikiLocation({ url: "/wiki/rulings#rulings" })]))
    try settled(() => { expect(location()).toBe("/wiki/rulings#rulings"); expect(scrolled).toBe(1) })
    try started(quiet({}, () => [WikiLocation({ url: "/wiki/rulings#rulings" }), RevealWiki({})]))
    try settled(() => expect(scrolled).toBe(2))
    try Effect.try(() => expect(location()).toBe("/wiki/rulings#rulings"))
  }))
})

describe("page listeners", () => {
  const maintainer = { account: { ...accountOf(init(flags).model), identity: { id: "1", login: "ada", role: "maintainer" as const } } }
  it.live("a plain click on a wiki link visits it; a modified click or another address does not", () => scoped(effect {
    const seen = try started(quiet())
    try settled(() => { expect(clickLink("vl-wiki-content", "/wiki/index")).toBe(true); expect(seen.model.wikiRequested).toBe("/wiki/index") })
    try Effect.try(() => {
      expect(clickLink("vl-wiki-content", "/wiki/index", { metaKey: true })).toBe(false)
      expect(clickLink("vl-wiki-content", "/wiki/index", { button: 1 })).toBe(false)
      expect(clickLink("vl-wiki-content", "https://example.test/")).toBe(false)
    })
  }))
  it.live("a draft link opens the editor on an existing page only", () => scoped(effect {
    const seen = try started(quiet(maintainer))
    try settled(() => { expect(clickLink("sui-chat-bubble", "#wiki-draft-index")).toBe(true); expect(seen.model.wikiEdit?.page).toBe("index") })
    try Effect.try(() => {
      expect(clickLink("sui-chat-bubble", "#wiki-draft-index", { ctrlKey: true })).toBe(false)
      expect(clickLink("sui-chat-bubble", "#wiki-draft-nothing")).toBe(false)
      expect(clickLink("sui-chat-bubble", "#elsewhere")).toBe(false)
    })
  }))
  it.live("back and forward follow the wiki and the home page, and ignore any other address", () => scoped(effect {
    const seen = try started(quiet())
    try settled(() => { popTo("/wiki/testing"); expect(seen.model.wikiRequested).toBe("/wiki/testing") })
    try settled(() => { popTo("/"); expect(seen.model.surface).toBe("splash") })
    // The wiki read the first address started still settles; compare after it does.
    try settled(() => expect(seen.model.wikiStatus).not.toBe("loading"))
    // The retried pops above may still have answers queued; a first witness drains them.
    try witnessed(seen)
    const before = seen.model
    const answered = try witnessed(seen, () => popTo("/elsewhere"))
    try Effect.try(() => { expect(answered).toEqual([]); expect(seen.model).toEqual(before) })
  }))
  it.live("while touring, tour keys are claimed; other keys are left alone, and resizing re-measures", () => scoped(effect {
    const seen = try started(quiet({ tour: true }))
    try settled(() => expect(press({ key: "Tab" })).toBe(true))
    try Effect.try(() => {
      expect(press({ key: "Tab", shiftKey: true })).toBe(true)
      expect(press({ key: " " })).toBe(true)
      expect(press({ key: "ArrowLeft" })).toBe(true)
      expect(press({ key: "ArrowRight" })).toBe(true)
      expect(press({ key: "k", metaKey: true })).toBe(true)
      expect(press({ key: "K", ctrlKey: true })).toBe(true)
      expect(press({ key: "j", metaKey: true })).toBe(false)
      expect(press({ key: "x" })).toBe(false)
    })
    try sync(() => { dispatchWindow("resize"); dispatchWindow("orientationchange") })
    try settled(() => expect(seen.model.theatreBox).toBeDefined())
  }))
  it.live("an untouched splash starts the tour on its own", () => scoped(effect {
    const seen = try started(quiet({ surface: "splash", autoTour: true }))
    try settled(() => expect(seen.model.tour).toBe(true))
  }))
  it.live("a running action ticks the clock", () => scoped(effect {
    const seen = try started(quiet({ actions: { ...initialActions } }, () => [RunAction({ name: "vibelang/Tour", text: "", door: "button", format: "none" })]))
    try settled(() => expect(seen.model.actions?.runs.length).toBe(1))
    try settled(() => expect(seen.model.actions?.now ?? 0).toBeGreaterThan(0))
  }))
  it.live("a started action is followed to its end", () => scoped(effect {
    const seen = try started(quiet({ actions: { ...initialActions } }, () => [RunAction({ name: "vibelang/history/show", text: "", door: "button", format: "json" })]), MockActions({ role: "contributor", actor: "person" }))
    // This action lazily imports its real durable history runtime; compilation shares the host with other suites.
    try settled(() => expect(seen.model.actions?.runs[0]?.state).toBe("passed"), 15_000)
  }))
  it.live("a run the service no longer knows ends its follow quietly", () => scoped(effect {
    const run = { id: "gone", flow: "vibelang/Tour", door: "button" as const, actor: "person" as const, state: "running" as const, started: 0, at: 1, result: "", steps: [] }
    // The follow's end is the latch; the witness then proves no message it sent is still queued.
    const ended: Array<string> = []
    const watched = Layer.effect(Actions, map(Actions, (base) => ({
      list: base.list, commands: base.commands, runs: base.runs, read: base.read, start: base.start, command: base.command, rerun: base.rerun, cancel: base.cancel,
      follow: (id: string) => base.follow(id).pipe(Stream.ensuring(sync(() => { ended.push(id) }))),
    }))).pipe(Layer.provide(MockActions({ actor: "person" })))
    const seen = try started(quiet({ actions: { ...initialActions, runs: [run] } }), watched)
    try settled(() => expect(ended).toContain("gone"))
    const answered = try witnessed(seen)
    try Effect.try(() => { expect(answered).not.toContain("ChangedAction"); expect(seen.model.actions?.runs[0]?.state).toBe("running") })
  }))
})

describe("the presenter", () => {
  it.live("measures, presents and moves focus through the tour controls", () => scoped(effect {
    const seen = try started(quiet({ tour: true }, () => [PresentTour({ step: 1, sound: false, active: true, paused: false }), MeasureTheatre({ target: "splash" }), FocusTourControl({ backward: false }), FocusTourControl({ backward: true })]))
    try settled(() => expect(seen.model.theatreBox).toBeDefined())
  }))
})

describe("a backend that fails", () => {
  const faulty = (over: Parameters<typeof overlaid>[1]) => Layer.effect(FactoryService, map(FactoryService, (base) => overlaid(base, over))).pipe(Layer.provide(MockFactory))
  const actions = MockActions({ actor: "person" })
  it.live("a broken tour stream follows again 2 seconds later and reports nothing", () => scoped(effect {
    const follows: Array<number> = []
    const seen = try started(quiet({ tourClient: newClient }), actions, faulty({ events: (conversation) => {
      if (!conversation.startsWith("tour-")) return Stream.never
      follows.push(Date.now())
      return follows.length === 1 ? Stream.fail(new Unavailable({ reason: "closed" })) : Stream.never
    } }))
    try settled(() => expect(follows).toHaveLength(2), 6000)
    try Effect.try(() => { expect(follows[1]! - follows[0]!).toBeGreaterThanOrEqual(1900); expect(seen.model.tourError).toBe("") })
  }))
  for (const [label, sandbox, reason] of [
    ["a refusal by its reason", () => Effect.fail(new Refused({ refusal: "forbidden" })), "forbidden"],
    ["an outage by its reason", () => Effect.fail(new Unavailable({ reason: "closed" })), "closed"],
  ] as const) {
    it.live(`the sandbox poll names ${label}`, () => scoped(effect {
      const seen = try started(quiet(), actions, faulty({ sandbox }))
      try settled(() => expect(seen.model.sandboxError).toBe(reason))
    }))
  }
  it.live("a backend without accounts leaves a signed-in person undisturbed", () => scoped(effect {
    const identity = { id: "1", login: "ada", role: "new" as const }
    const seen = try started(quiet({ account: { ...accountOf(init(flags).model), identity } }), actions, faulty({ accounts: undefined }))
    try witnessed(seen)
    try Effect.try(() => expect(accountOf(seen.model).identity).toEqual(identity))
  }))
})


it.live("a run cancelled by another client settles in the page after its first follow is lost", () => scoped(effect {
  const services = MockActions({ role: "contributor", actor: "person" }).pipe(Layer.provideMerge(MockFactory))
  provide services {
    const factory = try FactoryService
    const actions = try Actions
    const seen = try started(
      quiet({ actions: { ...initialActions, open: true } }, () => [RunAction({ name: "vibelang/Tour", text: "", door: "button", format: "none" })]),
      faultyActions(Layer.succeed(Actions, actions), "follow"),
      Layer.succeed(FactoryService, factory),
    )
    try settled(() => expect(seen.model.actions?.runs.some(run => run.state === "running" || run.state === "queued")).toBe(true))
    const id = seen.model.actions!.runs[0]!.id
    // Another client cancels through the same public Actions service. The page receives no CancelAction reply;
    // only its reconnected follow can learn that the run ended.
    try actions.cancel(id)
    try settled(() => expect(seen.model.actions?.runs.find(run => run.id === id)?.state).toBe("cancelled"), 8000)
  }
}))
