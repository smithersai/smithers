// @vitest-environment node
// worker/Wiki.vibe as the site runs it after decision 0165: a page read, a drafted edit and a saved or proposed change
// go through smithers.sh's real per-person connection host (fuzz/delegated.vibe) to an in-memory GitHub over the real
// client protocol (fuzz/issues-node-fake.vibe), on the durable engine over SQLite. A misbehaving GitHub is a wrapped
// client service; nothing intercepts a request.
import { describe, expect, it } from "@effect/vitest"
import { HttpClient, HttpClientRequest, HttpClientResponse, HttpServerRequest, HttpServerResponse } from "effect/http"
import { WebCrypto } from "@smthrs/crypto"
import { TestNodeRuntime } from "@smthrs/platform-node"
import { pages } from "../src/core/wiki.vibe"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import type { WikiRequest, WikiState } from "../src/core/wikiSchemas.vibe"
import { WikiHost } from "../src/core/wikiFlows.vibe"
import type { Principal } from "../worker/Issues.vibe"
import { executeWiki, githubWikiHost, serveWiki, WikiAuthority, type WikiRepository } from "../worker/Wiki.vibe"
import { GitHubDelegate } from "../worker/GitHubDelegate.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { API, fakeClient, forked, seed } from "../fuzz/issues-node-fake.vibe"
import { delegated, reach } from "../fuzz/delegated.vibe"
import { faultyStore } from "../fuzz/faulty-store.ts"

type State = typeof WikiState.Type
type Op = WikiRequest["op"]
/** Who is asking: "fuzz" (GitHub id 7) with a role, connected unless `connected` is false. */
interface Caller { readonly role: Principal["role"]; readonly connected?: boolean; readonly kind?: "person" | "agent" }
/** Answers one GitHub request in place of the in-memory GitHub, or undefined to let it answer. */
type Fault = (request: HttpClientRequest.HttpClientRequest, url: URL) => globalThis.Response | undefined
interface Options {
  /** false: an authority with no live operation check. */
  readonly authorize?: boolean
  /** false: the site has no smithers.sh delegate configured. */
  readonly delegate?: boolean
  /** false: a host with no object storage to keep drafts in. */
  readonly stored?: boolean
  readonly writer?: boolean
  readonly repo?: WikiRepository
}

const repo: WikiRepository = { owner: "o", name: "r", api: API, agent: "", root: "wiki" }
const PAGE = pages[0]!.id
const PATH = `wiki/${PAGE}.md`
const SOURCE = "# Page\n\nThe repository text.\n"
const EDITED = "# Page\n\nBetter text.\n"
const json = (status: number, body: unknown) => HttpServerResponse.toWeb(HttpServerResponse.text(JSON.stringify(body), { status, headers: { "content-type": "application/json" } }))
const blank: WikiRequest = { op: "read", page: PAGE, base: "", text: "", key: "k" }

effect function world(options: Options = {}) {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const store = faultyStore(raw as unknown as Storage)
  const fake = seed()
  forked(fake)
  fake.files[PATH] = SOURCE
  const inner = fakeClient(fake)
  let fault: Fault = () => undefined
  const github = HttpClient.make((request, url) => {
    const answer = fault(request, url)
    return answer === undefined ? inner.execute(request) : succeed(HttpClientResponse.fromWeb(request, answer))
  })
  const site = try delegated(github, reach())
  const caller = try Ref.make<Caller | undefined>({ role: "maintainer" })
  const lost = try Ref.make(0)
  const principal = (who: Caller | undefined): Principal | undefined => who === undefined ? undefined : { id: "7", login: "fuzz", role: who.role, ...(who.kind === undefined ? {} : { kind: who.kind }), ...(who.connected === false ? {} : { connection: site.connection }) }
  const asked = try Ref.make(0)
  let then: { readonly from: number; readonly caller: Caller | undefined } | undefined
  const authority: WikiAuthority.Shape = {
    current: () => Effect.flatMap(Ref.updateAndGet(asked, (n) => n + 1), (n) => Effect.map(Ref.get(caller), (who) => principal(then !== undefined && n >= then.from ? then.caller : who))),
    ...(options.authorize === false ? {} : { authorize: () => Effect.void }),
    lost: () => Ref.update(lost, (n) => n + 1),
  }
  const writer = Layer.succeed(WikiWriter, { draft: (request) => succeed({ page: request.page, text: `${request.source}\n${request.ask}` }) })
  const provided = <A, E, R>(program: A!E!R) => program.pipe(
    Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, site.http),
    Effect.provide(options.delegate === false ? Layer.empty : Layer.succeed(GitHubDelegate, site.delegate)),
    Effect.provide(options.writer === true ? writer : Layer.empty), Effect.provide(WebCrypto.layer),
  )
  let keys = 0
  /** The durable flow, as HTTP, the CLI and the agent's tool run it. */
  const act = (op: Op, extra: Partial<WikiRequest> = {}) => {
    keys += 1
    return Effect.exit(provided(executeWiki("wiki-delegated", store.storage, { ...blank, op, key: `k${keys}`, ...extra }, options.repo ?? repo)))
  }
  const host = try provided(githubWikiHost(options.repo ?? repo, options.stored === false ? undefined : store.storage))
  /** The host alone, off the engine: reads, drafts and the refusals before a journaled write. */
  const perform = (request: Partial<WikiRequest>) => Effect.exit(provided((host.perform as (request: WikiRequest) => State!unknown)({ ...blank, ...request })))
  const kept = () => promise(() => store.storage.get(`wiki/draft/7/${PAGE}`))
  return {
    fake, site, store, caller, lost, act, perform, kept, provided,
    fault: (next: Fault) => { fault = next },
    /** From the `from`-th identity lookup of the next call on, `next` asks instead. */
    turn: effect (from: number, next: Caller | undefined) => {
      try Ref.set(asked, 0)
      then = { from, caller: next }
    },
  }
}

/** The typed refusal, an engine error's tag, or "defect"; undefined on success. */
const failed = (exit: Exit.Exit<State, unknown>) => {
  if (exit._tag === "Success") return undefined
  const found = Cause.findErrorOption(exit.cause)
  if (Option.isNone(found)) return { reason: "defect", unwritten: false }
  const failure = found.value as { readonly _tag: string; readonly reason?: string; readonly unwritten?: boolean }
  return { reason: failure.reason ?? failure._tag, unwritten: failure.unwritten === true }
}
const succeeded = (exit: Exit.Exit<State, unknown>): State => {
  expect(failed(exit)).toBeUndefined()
  return exit._tag === "Success" ? exit.value : { seq: -1, pages: [] }
}

describe("the wiki through smithers.sh's delegation", () => {
  it.live("a read observes the page's source and revision, with the reader's kept text", () => scoped(effect {
    const w = try world()
    const read = succeeded(try w.perform({}))
    expect(read.pages).toEqual([{ id: PAGE, source: SOURCE, revision: `sha-${SOURCE.length}` }])
    expect(read.draft).toBeUndefined()
    expect(try promise(() => w.store.storage.get(`wiki/page/${PAGE}`))).toEqual({ id: PAGE, source: SOURCE, revision: `sha-${SOURCE.length}` })
    expect(try promise(() => w.store.storage.get("wiki/revision"))).toBe(read.seq)

    try promise(() => w.store.storage.put(`wiki/draft/7/${PAGE}`, { page: PAGE, text: "Kept." }))
    expect(succeeded(try w.perform({})).draft).toEqual({ page: PAGE, text: "Kept." })
    // A visitor has no kept text, and a stored value that is not a draft is ignored.
    try Ref.set(w.caller, undefined)
    expect(succeeded(try w.perform({})).draft).toBeUndefined()
    try Ref.set(w.caller, { role: "maintainer" })
    try promise(() => w.store.storage.put(`wiki/draft/7/${PAGE}`, { text: 1 }))
    expect(succeeded(try w.perform({})).draft).toBeUndefined()

    const bare = try world({ stored: false })
    expect(succeeded(try bare.perform({})).pages).toHaveLength(1)
  }))

  it.live("a read names an unknown page, a missing file and GitHub's refusals", () => scoped(effect {
    const w = try world()
    expect(failed(try w.perform({ page: "decisions" }))).toEqual({ reason: "missing", unwritten: false })
    expect(failed(try w.perform({ page: "no-such-page" }))?.reason).toBe("missing")
    expect(failed(try w.act("read", { page: "no-such-page" }))).toEqual({ reason: "missing", unwritten: true })
    delete w.fake.files[PATH]
    expect(failed(try w.perform({}))?.reason).toBe("missing")
    w.fake.files[PATH] = SOURCE
    w.fake.contentStatus = 403
    expect(failed(try w.perform({}))?.reason).toBe("forbidden")
    w.fake.contentStatus = 401
    expect(failed(try w.perform({}))?.reason).toBe("sign-in")
  }))

  it.live("an ended delegation still reads the public page and forgets the connection; a refused read is not retried", () => scoped(effect {
    const w = try world()
    try w.site.end()
    expect(succeeded(try w.perform({})).pages[0]!.source).toBe(SOURCE)
    expect(try Ref.get(w.lost)).toBe(1)
    const fresh = try world()
    fresh.fake.contentStatus = 403
    expect(failed(try fresh.perform({}))?.reason).toBe("forbidden")
    expect(try Ref.get(fresh.lost)).toBe(0)
  }))

  it.live("a save and a proposal open one review of exactly the page as the person, and clear the text they kept", () => scoped(effect {
    const w = try world()
    try promise(() => w.store.storage.put(`wiki/draft/7/${PAGE}`, { page: PAGE, text: EDITED }))
    const saved = succeeded(try w.act("save", { base: SOURCE, text: EDITED }))
    expect(saved.review).toBe("https://github.com/o/r/pull/600")
    expect(w.fake.pulls.at(-1)).toMatchObject({ title: `Wiki: ${PAGE}`, files: [{ filename: PATH, status: "modified" }] })
    expect(try w.kept()).toBeUndefined()

    // A different kept text stays; a repository that names its branch cuts from it.
    try promise(() => w.store.storage.put(`wiki/draft/7/${PAGE}`, { page: PAGE, text: "Other." }))
    const branched = try world({ repo: { ...repo, branch: "main" } })
    try promise(() => branched.store.storage.put(`wiki/draft/7/${PAGE}`, { page: PAGE, text: "Other." }))
    expect(succeeded(try branched.act("propose", { base: SOURCE, text: EDITED })).review).toBe("https://github.com/o/r/pull/600")
    expect(try branched.kept()).toEqual({ page: PAGE, text: "Other." })
  }))

  it.live("a change refuses a moved base, an empty or unchanged text, and a missing or advanced main, before any write", () => scoped(effect {
    const w = try world()
    expect(failed(try w.act("save", { base: "Stale.", text: EDITED }))).toEqual({ reason: "conflict", unwritten: true })
    expect(failed(try w.act("save", { base: SOURCE, text: "  " }))).toEqual({ reason: "empty", unwritten: true })
    expect(failed(try w.act("save", { base: SOURCE, text: SOURCE }))).toEqual({ reason: "empty", unwritten: true })
    w.fake.noMain = true
    expect(failed(try w.act("propose", { base: SOURCE, text: EDITED }))?.reason).toBe("missing")
    w.fake.noMain = false
    w.fake.pinnedText = "Main advanced."
    expect(failed(try w.act("propose", { base: SOURCE, text: EDITED }))?.reason).toBe("conflict")
    expect(w.fake.writes).toBe(0)
  }))

  it.live("a review GitHub first shows changing another file is retried and adopted: one branch, one commit, one review", () => scoped(effect {
    const w = try world()
    let opened = false
    let lagged = 0
    w.fault((request, url) => {
      if (request.method === "POST" && url.pathname === "/repos/o/r/pulls") opened = true
      if (!opened || lagged > 0 || request.method !== "GET" || url.pathname !== "/repos/o/r/pulls/600/files") return undefined
      lagged += 1
      return json(200, [{ filename: "wiki/elsewhere.md", status: "modified" }])
    })
    const saved = succeeded(try w.act("save", { base: SOURCE, text: EDITED }))
    expect(lagged).toBe(1)
    expect(saved.review).toBe("https://github.com/o/r/pull/600")
    expect(w.fake.pulls).toHaveLength(2)
    expect(Object.keys(w.fake.branches["fuzz/r"]!).filter((name) => name.startsWith("vibelang/wiki-"))).toHaveLength(1)
    expect(w.fake.writes).toBe(3)
  }))

  it.live("without a credential the reviewed text is kept for the person and the write waits to connect", () => scoped(effect {
    const w = try world()
    try Ref.set(w.caller, { role: "maintainer", connected: false })
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED }))).toEqual({ reason: "connect", unwritten: true })
    expect(try w.kept()).toEqual({ page: PAGE, text: EDITED })
    expect(try Ref.get(w.lost)).toBe(1)
    const bare = try world({ stored: false })
    try Ref.set(bare.caller, { role: "maintainer", connected: false })
    expect(failed(try bare.perform({ op: "save", base: SOURCE, text: EDITED }))?.reason).toBe("connect")
    expect(w.fake.writes + bare.fake.writes).toBe(0)
  }))

  it.live("every step re-reads who asks: a role or credential lost mid-flow, or no delegate, stops the write", () => scoped(effect {
    const w = try world()
    // Calls 1 and 2 admit the request (executeWiki, githubWikiHost); the third is the first step's own check.
    try w.turn(3, { role: "viewer" })
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED }))?.reason).toBe("forbidden")
    try w.turn(3, undefined)
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED }))?.reason).toBe("forbidden")
    try w.turn(3, { role: "maintainer", connected: false })
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED }))).toEqual({ reason: "connect", unwritten: true })
    expect(try w.kept()).toEqual({ page: PAGE, text: EDITED })

    const undelegated = try world({ delegate: false })
    expect(failed(try undelegated.act("save", { base: SOURCE, text: EDITED }))?.reason).toBe("connect")
    const unchecked = try world({ authorize: false })
    expect(succeeded(try unchecked.act("save", { base: SOURCE, text: EDITED })).review).toBe("https://github.com/o/r/pull/600")
    expect(w.fake.writes + undelegated.fake.writes).toBe(0)
  }))

  it.live("an agent may draft but never save; a draft needs an ask and a writer, and is kept for the person", () => scoped(effect {
    const w = try world({ writer: true })
    try Ref.set(w.caller, { role: "maintainer", kind: "agent" })
    expect(failed(try w.perform({ op: "save", base: SOURCE, text: EDITED }))?.reason).toBe("forbidden")
    expect(failed(try w.perform({ op: "draft", text: " " }))?.reason).toBe("empty")
    const drafted = succeeded(try w.perform({ op: "draft", text: "Shorter." }))
    expect(drafted.draft).toEqual({ page: PAGE, text: `${SOURCE}\nShorter.` })
    expect(try w.kept()).toEqual(drafted.draft)
    expect(failed(try w.perform({ op: "draft", text: "Hi", key: "" }))?.reason).toBe("sign-in")

    const unwritten = try world()
    expect(failed(try unwritten.perform({ op: "draft", text: "Shorter." }))?.reason).toBe("unavailable")
    const bare = try world({ writer: true, stored: false })
    expect(succeeded(try bare.perform({ op: "draft", text: "Shorter." })).draft?.text).toBe(`${SOURCE}\nShorter.`)
  }))

  it.live("a GitHub refusal outside the delegation is named, and a malformed request is invalid before it runs", () => scoped(effect {
    const w = try world()
    w.fault((request, url) => request.method === "GET" && url.pathname === "/repos/o/r/git/ref/heads/main" ? json(403, { message: "Forbidden" }) : undefined)
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED }))?.reason).toBe("forbidden")
    expect(failed(try w.act("bogus" as Op))).toEqual({ reason: "invalid", unwritten: true })
    expect(w.fake.writes).toBe(0)
  }))

  it.live("a store that fails answers unavailable over HTTP, on a replay or a retry, and an engine defect stays a defect", () => scoped(effect {
    const w = try world()
    w.store.fail(/^\s*CREATE TABLE IF NOT EXISTS "flows_migrations"/)
    const web = try HttpClientRequest.toWeb(HttpClientRequest.get(`https://wiki.invalid/api/wiki?page=${PAGE}`))
    const response = try w.provided(serveWiki("wiki-http", w.store.storage, repo)).pipe(Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web)))
    expect(response.status).toBe(503)
    expect(try promise(() => HttpServerResponse.toWeb(response).text())).toBe(JSON.stringify({ reason: "unavailable" }))

    // A replay of a finished read whose recorded request cannot be read.
    w.store.fail()
    succeeded(try w.act("read", { key: "again" }))
    w.store.fail(/^\s*SELECT r\.run_id/)
    expect(failed(try w.act("read", { key: "again" }))?.reason).toBe("unavailable")

    // A failed save retried after its journal lost the save's step.
    w.store.fail()
    w.fault((request, url) => request.method === "GET" && url.pathname === "/repos/o/r/git/ref/heads/main" ? json(403, { message: "Forbidden" }) : undefined)
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED, key: "lost" }))?.reason).toBe("forbidden")
    w.fault(() => undefined)
    try Effect.try(() => w.store.storage.sql.exec("DELETE FROM flows_attempts"))
    try Effect.try(() => w.store.storage.sql.exec("DELETE FROM flows_journal_events WHERE event_type IN ('flows.engine.attempt-started', 'flows.engine.attempt-finished', 'flows.engine.node-scheduled', 'flows.engine.node-settled')"))
    expect(failed(try w.act("save", { base: SOURCE, text: EDITED, key: "lost", recovery: "r1" }))?.reason).toBe("unavailable")
    expect(w.fake.writes).toBe(0)

    // A step the engine cannot record answers unavailable before any GitHub write.
    w.store.fail(/^\s*INSERT INTO flows_attempts/)
    expect(failed(try w.act("read"))?.reason).toBe("unavailable")
    expect(w.fake.writes).toBe(0)
  }))

  it.live("a host defect other than the read deadline stays a defect, never an answer", () => scoped(effect {
    const w = try world()
    const dying: WikiHost.Shape = { perform: () => Effect.die(new Error("host defect")) }
    const died = try Effect.exit(w.provided(executeWiki("wiki-dying", w.store.storage, { ...blank, key: "dies" }, repo)).pipe(Effect.provideService(WikiHost, dying)))
    expect(died._tag === "Failure" && Cause.hasDies(died.cause)).toBe(true)
  }))
})
