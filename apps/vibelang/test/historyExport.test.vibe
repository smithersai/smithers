// Where the History object publishes the mythical history (worker/HistoryExport.vibe; decision 0020, "The git export"):
// off unless the setting names a GitHub repository and a token is given. The GitHub path itself runs on a recording in
// test/export.github.test.vibe.
import { describe, expect, it } from "@effect/vitest"
import { HttpClient } from "effect/http"
import { REF_NAMES } from "../src/history/export.vibe"
import { exporterOf, OFF, off } from "../worker/HistoryExport.vibe"
import { Repository } from "@smthrs/jj"

/** A client that fails the test if the exporter reaches it: an off export makes no request. */
const unreachable = HttpClient.make(() => Effect.die("an off export made a request"))
const token = Redacted.make("token-for-tests")

describe("the export setting", () => {
  for (const [setting, given] of [
    [undefined, token],
    ["off", token],
    ["", token],
    ["github:codeplanesmithers", token],
    ["gitlab:codeplanesmithers/smithers-vibelang-e2e", token],
    ["github:../x", token],
    ["github:codeplanesmithers/smithers-vibelang-e2e", undefined],
  ] as const) {
    it.effect(`is off for ${JSON.stringify(setting)}${given === undefined ? " without a token" : ""}`, () => effect {
      const exporter = try exporterOf(setting, given, unreachable)
      const refused = try Effect.flip(exporter.repository.readRefs([REF_NAMES.mythical]))
      try Effect.try(() => {
        expect(exporter).toBe(off)
        expect(exporter.names).toEqual(REF_NAMES)
        expect([refused.code, refused.message.endsWith(OFF)]).toEqual(["unsupported", true])
      })
    })
  }

  it.effect("reaches the GitHub API it names, with the token, only when a call is made", () => effect {
    const seen: Array<string> = []
    const recording = HttpClient.make((request) => {
      seen.push(`${request.method} ${request.url} ${request.headers["authorization"] === "Bearer token-for-tests"}`)
      return Effect.die("stop here")
    })
    const github = try exporterOf("github:codeplanesmithers/smithers-vibelang-e2e", token, recording, REF_NAMES, "https://github.test")
    const before = seen.length
    try Effect.exit(github.repository.readBlob("e".repeat(40)))
    try Effect.try(() => {
      expect(before).toBe(0)
      expect(seen).toEqual(["GET https://github.test/repos/codeplanesmithers/smithers-vibelang-e2e/git/blobs/" + "e".repeat(40) + " true"])
    })
  })

  it.effect("names VibeLang's own refs: the bookmark, its notes and the manifest bookmark", () => effect {
    const exporter = try exporterOf("github:smithersai/vibelang", token, unreachable)
    try Effect.try(() => expect(exporter.names).toEqual({ mythical: "refs/heads/mythical", notes: "refs/notes/mythical", manifest: "refs/heads/smithers/history" }))
  })
  // Will's grant (VL-39) is the export's three refs on smithersai/vibelang, never main and never the `vibe` branch: the
  // exporter refuses any other ref before it sends a request, whatever it is told.
  const tip = "a".repeat(40)
  for (const ref of ["refs/heads/main", "refs/heads/vibe", "refs/heads/feature", "refs/tags/v1", "refs/notes/commits"]) {
    it.effect(`refuses to move ${ref}, outside its three refs, before any request`, () => effect {
      const exporter = try exporterOf("github:smithersai/vibelang", token, unreachable)
      const refused = try Effect.flip(exporter.repository.updateRefs({ operation: "test", updates: [
        { ref: REF_NAMES.mythical, before: null, after: tip },
        { ref, before: null, after: tip },
      ] }))
      try Effect.try(() => expect([refused.code, refused.method, refused.refs]).toEqual(["invalid", "updateRefs", [ref]]))
    })
  }

  for (const name of ["mythical", "notes", "manifest"] as const) {
    it.effect(`is off when its ${name} ref is named main, and makes no request`, () => effect {
      const names = { ...REF_NAMES, [name]: "refs/heads/main" }
      const exporter = try exporterOf("github:smithersai/vibelang", token, unreachable, names)
      const refused = try Effect.flip(exporter.repository.updateRefs({ operation: "test", updates: [{ ref: "refs/heads/main", before: null, after: tip }] }))
      try Effect.try(() => {
        expect(exporter.repository).not.toBe(off.repository)
        expect([refused.code, refused.refs]).toEqual(["invalid", ["refs/heads/main"]])
      })
    })
  }

  it.effect("still moves its own three refs, in one request", () => effect {
    const seen: Array<string> = []
    const recording = HttpClient.make((request) => {
      seen.push(`${request.method} ${request.url}`)
      return Effect.die("stop here")
    })
    const exporter = try exporterOf("github:smithersai/vibelang", token, recording, REF_NAMES, "https://github.test")
    try Effect.exit(exporter.repository.updateRefs({ operation: "test", updates: [
      { ref: REF_NAMES.mythical, before: null, after: tip },
      { ref: REF_NAMES.notes, before: null, after: tip },
      { ref: REF_NAMES.manifest, before: null, after: tip },
    ] }))
    try Effect.try(() => expect(seen).toEqual(["POST https://github.test/graphql"]))
  })
})
