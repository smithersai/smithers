// A day's ledger at its service boundary: limits, rounding, ordering and retry idempotency.
import { describe, expect, it } from "@effect/vitest"
import * as Budget from "../worker/Budget.vibe"

effect function ledger() {
  const data = try Ref.make<Readonly<Record<string, number>>>({})
  return {
    data,
    service: { read: (key: string) => Ref.get(data).pipe(Effect.map((entries) => entries[key])), write: (entries: Readonly<Record<string, number>>) => Ref.update(data, (current) => ({ ...current, ...entries })) },
  }
}

describe("daily budget", () => {
  for (const limit of [0, 1, 10]) {
    it.effect(`admits only strictly below its ${limit}-token limit`, () => effect {
      const log = try ledger()
      const budget = try Budget.make(log.service, limit)
      const before = try budget.admit()
      try budget.spend("a", limit)
      const at = try budget.admit()
      try budget.spend("b", 1)
      const after = try budget.admit()
      try Effect.try(() => {
        expect(before).toBe(limit > 0)
        expect(at).toBe(false)
        expect(after).toBe(false)
      })
    })
  }
  it.effect("rounds positive spend, clamps negatives, and charges a repeated reply once under concurrent retry", () => effect {
    const log = try ledger()
    const budget = try Budget.make(log.service, 100)
    try all(Array.from<unknown, void!!>({ length: 12 }, () => budget.spend("same", 1.6)), { concurrency: "unbounded" })
    try budget.spend("negative", -3)
    try budget.spend("negative", 9)
    try budget.spend("second", 2.4)
    const data = try Ref.get(log.data)
    const restored = try Budget.make(log.service, 4)
    try restored.spend("same", 99)
    const admitted = try restored.admit()
    const final = try Ref.get(log.data)
    try Effect.try(() => {
      expect(data).toEqual({ spent: 4, "reply/same": 2, "reply/negative": 0, "reply/second": 2 })
      expect(final).toEqual(data)
      expect(admitted).toBe(false)
    })
  })
})
