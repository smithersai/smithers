// Third-lane batch 6 (0018): the issues host's decisions, proved in issueHostDecision as Issues and Wiki use them.
import { describe, expect, it } from "@effect/vitest"
import { carriesCode, choiceLabel, choiceLogin, failureReason, issueWriteRefusal, refusalReason, issueTask, nextRevision, revisionRoom, validRevision, projectedVip, refusalStatus, requestKey, resumable, resumeStatus, timelineText, unwritten, vipState } from "../src/core/issueHostDecision.vibe"
import { issueFailureOf } from "../worker/Issues.vibe"
import { connectFailure, grantsParticipation, issuePagesExhausted, joinsReceipt, needsConnection, objectPath, parentInRepository, readRetriesSignedOut, retriesSettledFailure, sameActor, selectsIssue, wikiEditRefusal } from "../src/core/issueHostDecision.vibe"

describe("the issues host", () => {
  it("refuses an issue write before it writes: title, then the split's issue or the proposal's details; else the issue, empty text, a closed commitment", () => {
    const refusal = (op: string, { title = false, details = false, text = false, known = true, open = true } = {}) => issueWriteRefusal(op, title, details, text, known, open)
    expect([refusal("new", { title: true }), refusal("split", { title: true, known: false }), refusal("propose", { title: true, details: true })]).toEqual(["title", "title", "title"])
    expect([refusal("new", { known: false }), refusal("split", { known: false }), refusal("propose", { details: true }), refusal("propose", { text: true, known: false })]).toEqual(["", "missing", "incomplete", ""])
    expect([refusal("comment", { known: false, text: true }), refusal("comment", { text: true }), refusal("commit", { open: false }), refusal("uncommit", { open: false }), refusal("link", { title: true, text: true })]).toEqual(["missing", "empty", "closed", "", ""])
  })
  it("reports a broker refusal by its own reason, a key conflict as invalid, and codes only what a retry may clear", () => {
    expect(["connect", "install", "fork", "forbidden", "unavailable", "unknown", "key_conflict", "missing"].map(refusal => [refusalReason(refusal), carriesCode(refusalReason(refusal))])).toEqual([
      ["connect", false], ["install", false], ["fork", false], ["forbidden", false], ["unavailable", true], ["unknown", true], ["invalid", false], ["missing", false],
    ])
  })
  it("admits a request key of 1 to 100 ASCII letters, digits and dashes, as the old pattern did", () => {
    const keys = ["", "a", "A-9", "x".repeat(100), "x".repeat(101), "a b", "a_b", "ключ", "a\n", "😀", "a-"]
    expect(keys.map(requestKey)).toEqual(keys.map((key) => /^[A-Za-z0-9-]{1,100}$/.test(key)))
    expect(keys.map(requestKey)).toEqual([false, true, true, true, false, false, false, false, false, false, true])
  })
  it("classifies a GitHub failure by outcome, truncation, rate limit, then status", () => {
    expect([failureReason(true, true, true, 401), failureReason(false, true, true, 401), failureReason(false, false, true, 401)]).toEqual(["unknown", "partial", "rate-limited"])
    expect([401, 403, 404, 500, 0].map((status) => failureReason(false, false, false, status))).toEqual(["sign-in", "forbidden", "missing", "unavailable", "unavailable"])
    expect(issueFailureOf({ details: { status: 403 } })).toMatchObject({ reason: "forbidden" })
    expect(issueFailureOf({ details: { status: "403", rateLimited: true, retryAfterMillis: 5 } })).toMatchObject({ reason: "rate-limited", code: "rate-limited", retryAfterMillis: 5 })
    expect(issueFailureOf({ details: { status: "404" } })).toMatchObject({ reason: "unavailable", code: "unavailable" })
  })
  it("answers each refusal with its HTTP status", () => {
    const reasons = ["forbidden", "sign-in", "connect", "missing", "unknown", "title", "fork", "install", "partial", "rate-limited", "protocol"]
    expect(reasons.map(refusalStatus)).toEqual([403, 401, 401, 404, 409, 400, 400, 400, 503, 503, 503])
  })
  it("marks unwritten only a first execution refused before any write", () => {
    expect([unwritten(true, false, "title"), unwritten(true, true, "title"), unwritten(false, false, "title"), unwritten(true, false, "invalid")]).toEqual([true, false, false, false])
  })
  it("reads an issue as a task and a VIP", () => {
    expect([issueTask(true, true, true, true), issueTask(true, true, false, true), issueTask(true, true, false, false), issueTask(true, false, false, false), issueTask(false, true, true, true)]).toEqual(["Done", "Running", "Queued", "", ""])
    expect([vipState(true, true, true), vipState(true, false, true), vipState(true, false, false), vipState(false, true, false)]).toEqual(["Accepted", "Declined", "In review", ""])
  })
  it("keeps an Accepted label only with this project's receipt", () => {
    expect([projectedVip("Accepted", true), projectedVip("Accepted", false), projectedVip("Declined", false), projectedVip("", false)]).toEqual(["Accepted", "In review", "Declined", ""])
  })
  it("advances the revision past the stored one and never behind GitHub's", () => {
    expect([revisionRoom(-1), revisionRoom(0), revisionRoom(Number.MAX_SAFE_INTEGER - 1), revisionRoom(Number.MAX_SAFE_INTEGER)]).toEqual([false, true, true, false])
    expect([validRevision(-1), validRevision(Number.MAX_SAFE_INTEGER), validRevision(Number.MAX_SAFE_INTEGER + 1)]).toEqual([false, true, false])
    expect([nextRevision(4, 2), nextRevision(4, 9), nextRevision(4, 5)]).toEqual([5, 9, 5])
  })
  it("resumes only durable writes, and reports a resumed run's status", () => {
    expect(["new", "spec-review", "read", "draft", ""].map(resumable)).toEqual([true, true, false, false, false])
    expect([resumeStatus(true, true), resumeStatus(true, false), resumeStatus(false, false)]).toEqual(["completed", "failed", "running"])
  })
  it("offers the agent under its product name and reads the name back", () => {
    expect([choiceLabel("bot", "bot"), choiceLabel("ada", "bot"), choiceLogin("VibeLang agent", "bot"), choiceLogin("ada", "bot")]).toEqual(["VibeLang agent", "ada", "bot", "ada"])
  })
  it("says what a timeline event did, and nothing for one it does not show", () => {
    expect([
      timelineText("labeled", true, "bug", false, ""), timelineText("unlabeled", true, "bug", false, ""), timelineText("assigned", false, "", true, "ada"),
      timelineText("unassigned", false, "", true, "ada"), timelineText("closed", false, "", false, ""), timelineText("reopened", false, "", false, ""),
      timelineText("labeled", false, "", false, ""), timelineText("unlabeled", false, "", false, ""), timelineText("assigned", false, "", false, ""),
      timelineText("unassigned", false, "", false, ""), timelineText("mentioned", true, "bug", true, "ada"),
    ]).toEqual(["added the bug label", "removed the bug label", "assigned ada", "unassigned ada", "closed this issue", "reopened this issue", "", "", "", "", ""])
  })
})

describe("the issues and wiki hosts' remaining decisions (batch 51)", () => {
  it("caps the list at 50 pages, reads only this repository's parents, and selects a positive number", () => {
    expect([issuePagesExhausted(true, 50), issuePagesExhausted(true, 49), issuePagesExhausted(false, 50)]).toEqual([true, false, false])
    const prefix = "https://api.github.com/repos/o/r/issues/"
    expect([parentInRepository(prefix + "7", prefix), parentInRepository("https://api.github.com/repos/o/x/issues/7", prefix), parentInRepository("", prefix)]).toEqual([true, false, false])
    expect([selectsIssue(1), selectsIssue(0), selectsIssue(-1)]).toEqual([true, false, false])
  })
  it("needs a connection for every write but a draft, the same person throughout, and retries a read signed out", () => {
    expect([needsConnection("new", false), needsConnection("draft", false), needsConnection("new", true)]).toEqual([true, false, false])
    expect([sameActor("1", "1"), sameActor("2", "1")]).toEqual([true, false])
    expect([readRetriesSignedOut("read", true), readRetriesSignedOut("read", false), readRetriesSignedOut("new", true)]).toEqual([true, false, false])
    expect(["connect", "missing", "forbidden"].map(connectFailure)).toEqual([true, false, false])
  })
  it("retries only a settled failure with a recovery key, joins a known receipt otherwise, and grants participation for new issues and comments", () => {
    expect([retriesSettledFailure(true, true), retriesSettledFailure(false, true), retriesSettledFailure(true, false)]).toEqual([true, false, false])
    expect([joinsReceipt(false, false), joinsReceipt(true, false), joinsReceipt(false, true)]).toEqual([true, false, false])
    expect(["new", "comment", "link", "read"].map(grantsParticipation)).toEqual([true, true, false, false])
    expect([objectPath("/api/issues", "/api/issues"), objectPath("/api/issues/x", "/api/issues"), objectPath("/api/wiki", "/api/issues")]).toEqual([true, true, false])
  })
  it("refuses a wiki edit on a stale base, a blank text or an unchanged page", () => {
    expect([wikiEditRefusal(false, false, false), wikiEditRefusal(false, true, true), wikiEditRefusal(true, true, false), wikiEditRefusal(true, false, true), wikiEditRefusal(true, false, false)]).toEqual(["conflict", "conflict", "empty", "empty", ""])
  })
})
