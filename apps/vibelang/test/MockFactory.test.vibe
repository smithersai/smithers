// The mock factory through the `Factory` service, as every surface calls it: the real sequencer, the scripted agent,
// and two clients following one conversation (wiki/decisions/0007-multiplayer.md).
import { describe, expect, it } from "@effect/vitest"
import { apply, empty, type Event } from "../src/core/conversation.vibe"
import { Factory } from "../src/core/Factory.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"
import { mockReply } from "../src/core/mockReplies.vibe"

/** Every event of `conversation` up to and including the one that finishes its `replies`-th reply. */
effect function untilReplies(conversation: string, replies: number) {
  const factory = try Factory
  let finished = 0
  const events = try Stream.runCollect(
    factory.events(conversation, 0) |> Stream.takeUntil(%, (event: Event) => event.type === "ReplyFinished" && ++finished === replies),
  )
  return Array.from(events)
}

describe("MockFactory", () => {
  it.live("records a post and streams the scripted reply, every event numbered in order", () => effect {
    provide MockFactory {
      const factory = try Factory
      try factory.post("c1", "a", "Ada", "  How do I install it?  ")
      const events = try untilReplies("c1", 1)
      try Effect.try(() => {
        expect(events.map((event) => event.seq)).toEqual(events.map((_, index) => index + 1))
        expect(events[0]).toEqual({ type: "Posted", seq: 1, id: "m1", clientId: "a", name: "Ada", text: "How do I install it?" })
        expect(events[1]!.type).toBe("ReplyStarted")
        const conversation = events.reduce(apply, empty)
        expect(conversation.entries[1]!.text).toBe(mockReply("How do I install it?"))
        expect(conversation.agent).toBe("idle")
        expect(factory.mode).toBe("mock")
      })
    }
  })

  it.live("refuses a repeated client id and a blank post", () => effect {
    provide MockFactory {
      const factory = try Factory
      try factory.post("c1", "a", "Ada", "hi")
      const repeated = factory.post("c1", "a", "Ada", "hi again") catch (error) => error._tag === "Refused" ? error.refusal : error.reason
      const blank = factory.post("c1", "b", "Ada", "   ") catch (error) => error._tag === "Refused" ? error.refusal : error.reason
      try Effect.try(() => {
        expect(repeated).toBe("duplicate")
        expect(blank).toBe("empty")
      })
    }
  })

  it.live("answers posts one at a time, and two followers see the same events", () => effect {
    provide MockFactory {
      const factory = try Factory
      try factory.post("c2", "a", "Ada", "What is a service?")
      try factory.post("c2", "b", "Grace", "How do errors work?")
      const [first, second] = try.all [untilReplies("c2", 2), untilReplies("c2", 2)]
      try Effect.try(() => {
        expect(first).toEqual(second)
        const conversation = first.reduce(apply, empty)
        const people = conversation.entries.filter((entry) => entry.author === "person")
        const replies = conversation.entries.filter((entry) => entry.author === "agent")
        expect(people.map((entry) => [entry.name, entry.clientId])).toEqual([["Ada", "a"], ["Grace", "b"]])
        expect(replies.map((entry) => [entry.inReplyTo, entry.text, entry.done, entry.error])).toEqual([
          [people[0]!.id, mockReply("What is a service?"), true, ""],
          [people[1]!.id, mockReply("How do errors work?"), true, ""],
        ])
        expect(first.filter((event) => event.type === "ReplyStarted" || event.type === "ReplyFinished").map((event) => event.type)).toEqual(["ReplyStarted", "ReplyFinished", "ReplyStarted", "ReplyFinished"])
        expect(first.map((event) => event.seq)).toEqual(first.map((_, index) => index + 1))
      })
    }
  })

  it.live("replays only the events after the number a reconnecting client already has", () => effect {
    provide MockFactory {
      const factory = try Factory
      try factory.post("c3", "a", "Ada", "hi")
      const all = try untilReplies("c3", 1)
      const tail = try Stream.runCollect(factory.events("c3", 2) |> Stream.take(%, all.length - 2))
      try Effect.try(() => expect(Array.from(tail)).toEqual(all.slice(2)))
    }
  })

  // Both followers stay live through both answers, including after another follower is cancelled.
  it.live("keeps complete live transcripts apart and survives cancelling another follower", () => effect {
    provide MockFactory {
      const factory = try Factory
      const four = try Ref.make<ReadonlyArray<Event>>([])
      const five = try Ref.make<ReadonlyArray<Event>>([])
      const done4 = try Deferred.make<void>()
      const done5 = try Deferred.make<void>()
      const follow4 = fork Stream.runForEach(factory.events("c4", 0), effect (event) => {
        try Ref.update(four, (events) => [...events, event])
        if (event.type === "ReplyFinished") try Deferred.succeed(done4, undefined)
      })
      const follow5 = fork Stream.runForEach(factory.events("c5", 0), effect (event) => {
        try Ref.update(five, (events) => [...events, event])
        if (event.type === "ReplyFinished") try Deferred.succeed(done5, undefined)
      })
      const cancelled = fork Stream.runDrain(factory.events("c4", 0))
      try sleep("10 millis")
      try factory.post("c4", "a", "Ada", "install")
      try Fiber.interrupt(cancelled)
      try factory.post("c5", "a", "Grace", "errors")
      try Deferred.await(done4)
      try Deferred.await(done5)
      try Fiber.interrupt(follow4)
      try Fiber.interrupt(follow5)
      const [events4, events5] = try.all [Ref.get(four), Ref.get(five)]
      try Effect.try(() => {
        for (const [events, name, prompt] of [[events4, "Ada", "install"], [events5, "Grace", "errors"]] as const) {
          expect(events.map((event) => event.seq)).toEqual(events.map((_, index) => index + 1))
          const state = events.reduce(apply, empty)
          expect(state.entries.map((entry) => [entry.name, entry.text, entry.done])).toEqual([
            [name, prompt, true], ["VibeLang agent", mockReply(prompt), true],
          ])
          expect(events.filter((event) => event.type === "Posted")).toHaveLength(1)
          expect(events.filter((event) => event.type === "ReplyFinished")).toHaveLength(1)
        }
      })
    }
  }, 10_000)
})
