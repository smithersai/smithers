import { IssueFailure } from "../../src/core/issueSchemas.vibe"
import { WikiFailure } from "../../src/core/wikiSchemas.vibe"
// A transport fault over the product's real MockFactory: posts, replies, replay and live delivery stay real.
import type { Event } from "../../src/core/conversation.vibe"
import { ConversationRead, Factory, Refused, Unavailable } from "../../src/core/Factory.vibe"
import { AccountUnavailable, Accounts } from "../../src/core/roles.vibe"
import { MockFactory, mockFactoryFor } from "../../src/core/MockFactory.vibe"
import { MockJournal } from "../../src/core/MockJournal.vibe"
import { makeWikiStore } from "../../src/core/WikiFactory.vibe"
import { recordedWikiStore } from "./recordedWiki.vibe"
import { forge, forgery, forges, resumeAt, type Forgery } from "./forgedEvents.vibe"
import { faultyMachines, machineFault, type MachineFault } from "./faultyMachines.vibe"

export type Fault = "accounts" | "live-details" | "wiki" | "wiki-edit" | "wiki-repository" | "tour-control" | "drop" | "disconnect" | "end" | "refuse" | "thinking" | "streaming" | "tour-refuse" | "tour-unavailable" | "end-tour-unavailable" | "issues" | "issue-write" | "live-header" | "sandbox-read" | "sandbox-start" | "sandbox-low" | "sandbox-out" | "sandbox-last-minute" | "sandbox-month-end" | "sandbox-clock" | "sandbox-clock-read" | "sandbox-replay" | "roles" | "roles-gap" | "tour-events" | "stale" | "issue-connect" | "issue-fork" | "issue-install" | "issue-forbidden" | "issue-closed" | "issue-no-model" | "issue-assignee" | "wiki-forbidden" | "wiki-conflict" | "wiki-connect" | "wiki-fork" | "wiki-install" | "post-empty" | "post-duplicate" | "post-not-replying" | "post-full" | "end-twice" | "forged" | "held-details" | "held-actions" | "held-start" | "held-start-failed" | "account-read" | "held-wiki-read" | "held-wiki-read-failed" | "held-wiki-save" | "held-tour" | "held-tour-step" | MachineFault
export interface Trace {
  subscriptions: Array<{ conversation: string; after: number }>
  delivered: Event[]
  base?: Factory.Shape
  release?: () => void!!
  faulted: boolean
  /** `held-tour-step`: true while the tour's first step is held. */
  holding?: boolean
  /** `forged`: what the forging transport inserted, by conversation. */
  forgery?: Forgery
}
/** When GitHub last confirmed the copies a `stale` fault serves: 2026-11-10 13:40 UTC. */
export const STALE_AT = Date.UTC(2026, 10, 10, 13, 40)

export function trace(): Trace {
  return { subscriptions: [], delivered: [], faulted: false }
}

/** The real accounts, except that a subscription `fails()` names ends at once with AccountUnavailable. */
function rolesFault(accounts: Accounts.Shape, fails: () => boolean): Accounts.Shape {
  return {
    current: () => accounts.current(),
    members: () => accounts.members(),
    grant: (id, role) => accounts.grant(id, role),
    signOut: () => accounts.signOut(),
    choose: (role) => accounts.choose(role),
    signInAgent: () => accounts.signInAgent(),
    participated: (personId) => accounts.participated(personId),
    events: (after) => fails() ? Stream.fail(new AccountUnavailable({ reason: "roles unavailable" })) : accounts.events(after),
  }
}

/** The real accounts, except that the role event of the first grant is lost, so the next grant arrives after a gap. */
function rolesGapFault(accounts: Accounts.Shape, loses: () => boolean): Accounts.Shape {
  const lost = { pending: false }
  return {
    current: () => accounts.current(),
    members: () => accounts.members(),
    grant: (id, role) => Effect.suspend(() => {
      if (loses()) lost.pending = true
      return accounts.grant(id, role)
    }),
    signOut: () => accounts.signOut(),
    choose: (role) => accounts.choose(role),
    signInAgent: () => accounts.signInAgent(),
    participated: (personId) => accounts.participated(personId),
    events: (after) => accounts.events(after).pipe(Stream.filter((event) => {
      if (!lost.pending || event.type !== "RoleGranted") return true
      lost.pending = false
      return false
    })),
  }
}

/** The real accounts, except that the first `choose` (sign-in, Visit as), `members`, `grant` and `signOut` each fail once. */
function accountsFault(accounts: Accounts.Shape, first: (name: string) => boolean): Accounts.Shape {
  return {
    current: () => accounts.current(),
    members: () => first("accounts:members") ? Effect.fail(new AccountUnavailable({ reason: "accounts unavailable" })) : accounts.members(),
    grant: (id, role) => first("accounts:grant") ? Effect.fail(new AccountUnavailable({ reason: "accounts unavailable" })) : accounts.grant(id, role),
    signOut: () => first("accounts:signOut") ? Effect.fail(new AccountUnavailable({ reason: "accounts unavailable" })) : accounts.signOut(),
    choose: (role) => first("accounts:choose") ? Effect.fail(new AccountUnavailable({ reason: "accounts unavailable" })) : accounts.choose(role),
    signInAgent: () => accounts.signInAgent(),
    participated: (personId) => accounts.participated(personId),
    events: (after) => accounts.events(after),
  }
}

/**
 * Lose #3 once, or break before #4 mid-reply. Subsequent subscriptions use the unmodified real stream. `sandbox-read`
 * fails every sandbox read; `sandbox-start` fails the first start; each `machine-*` fault fails the mock sandbox's
 * machine once (faultyMachines.vibe); `sandbox-low`, `sandbox-last-minute` and `sandbox-out` move the sandbox
 * meter's clock, once the first sandbox starts, to five minutes or 30 seconds before the allowance runs out, or a
 * minute past it; `sandbox-month-end` leaves five minutes too, and once the first stop ends moves the clock to
 * three seconds before the next UTC month, so a sandbox started again runs across the month's end;
 * `sandbox-replay` is a transport that loses the answers to the first sandbox start and the first command and sends each
 * again with its operation id, then reuses the first command's id for the second command, as a client with a stale id
 * does: the writer answers a resend from its receipt and refuses a different request under a used id.
 * `sandbox-clock` makes that clock read before 1970 for the first sandbox command; `roles` ends the first role subscription with AccountUnavailable; `roles-gap` loses the first grant's role event;
 * `tour-events` ends the first tour conversation subscription with Unavailable; `accounts` fails the first sign-in or role
 * choice, member list, grant and sign-out; `live-details` runs live mode and fails the first issue's details read.
 * `issue-connect`, `issue-fork` and `issue-install` refuse the first issue write before it happens, as the live Worker does
 * for a person whose GitHub is not connected, who has no fork, or whose fork lacks the App. `issue-forbidden`, `issue-closed`,
 * `issue-no-model` and `issue-assignee` refuse it with that reason, as the live host does for a role it refuses, a closed
 * issue, a review with no model and a commit to someone it cannot assign. `wiki-forbidden`, `wiki-conflict`,
 * `wiki-connect`, `wiki-fork` and `wiki-install` refuse the first wiki save with that reason, as the live wiki host does.
 * `post-empty` loses the first post's text on the way, and the mock's sequencer refuses it as empty; `post-duplicate`,
 * `post-not-replying` and `post-full` refuse the first post with that refusal, as the sequencer answers another
 * client's post.
 * `end-twice` sends the first tour end twice, as a client that resends an end whose answer it lost: the mock's sequencer
 * (decide.vibe) refuses the second, and the page reads that refusal as the tour already ended.
 * `held-details` runs live mode and holds the first issue's details read until the next details read has answered,
 * then fails it: a failure that arrives after the person has moved to another issue.
 * `forged` inserts events that break the conversation's rules into the home and tour conversations (forgedEvents.vibe).
 * `held-actions`, `held-start` and `held-start-failed` fault nothing here: the host's Actions hold a list or a start
 * until the page releases it (heldActions.vibe).
 * `account-read` fails the first read of the signed-in account. `held-wiki-read` holds the editor's first page read
 * until the page releases it; `held-wiki-read-failed` then fails it. `held-wiki-save` holds the first wiki save or
 * proposal until the page releases it, then writes it. `held-tour` holds the first tour start until the page releases
 * it, then starts the tour. `held-tour-step` holds the journal write of the tour's first step, under the room's lock,
 * until the page releases it (`holding` reads true meanwhile): an end the person asks for then waits for that lock and
 * lands while the tour is still speaking. `faulted` turns true as each hold ends.
 * `wiki-repository` faults nothing: its fixture repository's Benchmarks page is the recorded GitHub copy (recordedWiki.vibe).
 * Each fault happens once.
 */
export function faultyFactory(fault: Fault, observation: Trace) {
  const device = machineFault(fault)
  // The faulty machines move the meter's clock, which the Factory below owns.
  const meterClock: { exhaust: Effect.Effect<void> } = { exhaust: Effect.void }
  // Reads pass through to the mock; the page never reads (Factory.vibe `ConversationRead`).
  return Layer.merge(Layer.effect(ConversationRead, effect { return try ConversationRead }), Layer.effect(Factory, effect {
    const base = try Factory
    const released = try Deferred.make<void>()
    const completions = try Queue.unbounded<void>()
    const forging = forgery()
    if (fault === "forged") observation.forgery = forging
    const wikiRefusal = fault.startsWith("wiki-") && fault !== "wiki-edit" && fault !== "wiki-repository" ? fault.slice("wiki-".length) : undefined
    const setup = fault === "issue-connect" ? "connect" : fault === "issue-fork" ? "fork" : fault === "issue-install" ? "install" : fault === "issue-forbidden" ? "forbidden" : fault === "issue-closed" ? "closed" : fault === "issue-no-model" ? "no-model" : fault === "issue-assignee" ? "assignee" : undefined
    if (fault !== "held-tour-step") observation.release = () => fault === "streaming"
      ? Effect.asVoid(Queue.offer(completions, undefined))
      : Effect.asVoid(Deferred.succeed(released, undefined))
    try sync(() => { observation.base = base })
    // The first call of each named fault point, `fault:point`, fails; later calls are real.
    const once = new Set<string>()
    const first = (name: string) => {
      if (fault !== name.split(":")[0] || once.has(name)) return false
      once.add(name)
      return true
    }
    // The sandbox meter's faulty clock: the wall clock plus `skew`. It starts on the 15th of this month (UTC), so the
    // jump when the first sandbox starts, at most a contributor's 600 minutes, never crosses into the next month.
    const wall = try Clock.Clock
    const skewed = fault === "sandbox-low" || fault === "sandbox-month-end" || fault === "sandbox-last-minute" || fault === "sandbox-out" || fault === "machine-command-exhausted"
    const clockFault = fault === "sandbox-clock" || fault === "sandbox-clock-read" || fault === "machine-stop-clock"
    let broken = false
    const built = new Date(wall.currentTimeMillisUnsafe())
    let skew = skewed ? Date.UTC(built.getUTCFullYear(), built.getUTCMonth(), 15) - built.getTime() : 0
    let skewNanos = try Effect.orDie(Effect.try(() => BigInt(skew) * 1_000_000n))
    let jumped = false
    // `sandbox-replay`: the first command's operation id, which the second command reuses.
    let firstCommand = ""
    // `machine-command-exhausted`: the minutes left when the sandbox started, and the jump past them, which the
    // machine asks for while it holds the first command.
    let remaining = 0
    meterClock.exhaust = effect {
      skew += (remaining + 1) * 60_000
      skewNanos = try Effect.orDie(Effect.try(() => BigInt(skew) * 1_000_000n))
    }
    const clock: Clock.Clock = {
      currentTimeMillisUnsafe: () => broken ? -1 : wall.currentTimeMillisUnsafe() + skew,
      currentTimeMillis: sync(() => broken ? -1 : wall.currentTimeMillisUnsafe() + skew),
      currentTimeNanosUnsafe: () => broken ? -1_000_000n : wall.currentTimeNanosUnsafe() + skewNanos,
      currentTimeNanos: sync(() => broken ? -1_000_000n : wall.currentTimeNanosUnsafe() + skewNanos),
      monotonicTimeNanosUnsafe: () => wall.monotonicTimeNanosUnsafe(),
      monotonicTimeNanos: wall.monotonicTimeNanos,
      sleep: (duration) => wall.sleep(duration),
    }
    // `sandbox-clock`: the call that reads the broken clock mends it when it ends.
    const metered = <A, E, R>(run: Effect.Effect<A, E, R>) => skewed || clockFault
      ? Effect.provideService(clockFault ? Effect.ensuring(run, sync(() => { if (broken) { broken = false; jumped = true } })) : run, Clock.Clock, clock)
      : run
    return {
      mode: fault === "live-header" || fault === "live-details" || fault === "held-details" ? "live" : base.mode,
      accounts: fault === "account-read" ? { ...base.accounts, current: () => first("account-read") ? Effect.fail(new AccountUnavailable({ reason: "accounts unavailable" })) : base.accounts.current() } : fault === "roles" ? rolesFault(base.accounts, () => first("roles")) : fault === "roles-gap" ? rolesGapFault(base.accounts, () => first("roles-gap")) : fault === "accounts" ? accountsFault(base.accounts, first) : base.accounts,
      ...(base.policy === undefined ? {} : { policy: base.policy }),
      wiki: {
        read: effect (page) => {
          if ((fault === "held-wiki-read" || fault === "held-wiki-read-failed") && first(`${fault}:read`)) {
            try Deferred.await(released)
            try sync(() => { observation.faulted = true })
            if (fault === "held-wiki-read-failed") throw new WikiFailure({ reason: "unavailable" })
          }
          const read = try base.wiki.read(page)
          return fault === "stale" ? { ...read, stale: STALE_AT } : read
        },
        // `wiki-edit`: the first save or proposal fails before anything is written; later ones are real.
        act: effect (request) => {
          if (request.op !== "read" && first("held-wiki-save:act")) {
            try Deferred.await(released)
            try sync(() => { observation.faulted = true })
          }
          if (request.op !== "read" && first("wiki-edit:act")) throw new WikiFailure({ reason: "unavailable", unwritten: true })
          if (wikiRefusal !== undefined && request.op !== "read" && first(fault)) throw new WikiFailure({ reason: wikiRefusal })
          return try base.wiki.act(request)
        },
      },
      issues: {
        read: effect () => {
          if (fault === "issues" && !observation.faulted) { observation.faulted = true; throw new IssueFailure({ reason: "unavailable" }) }
          const read = try base.issues.read()
          // GitHub refused to refresh: the object serves its last good copy, marked stale (decision 0031).
          return fault === "stale" ? { ...read, stale: STALE_AT } : read
        },
        act: effect (request) => {
          if (request.op === "read" && request.number > 0 && first("live-details:read")) throw new IssueFailure({ reason: "unavailable" })
          if (setup !== undefined && request.op !== "read" && first(fault)) throw new IssueFailure({ reason: setup })
          if (request.op === "read" && request.number > 0 && first("held-details:read")) {
            try Deferred.await(released)
            try sync(() => { observation.faulted = true })
            throw new IssueFailure({ reason: "unavailable" })
          }
          const result = try base.issues.act(request)
          if (fault === "held-details" && request.op === "read" && request.number > 0) try Deferred.succeed(released, undefined)
          if (fault === "issue-write" && request.op !== "read" && !observation.faulted) { observation.faulted = true; throw new IssueFailure({ reason: "unavailable" }) }
          return result
        },
      },
      post: effect (conversation, clientId, name, text) => {
        // `post-empty` sends the post with its text lost, so the mock's sequencer (decide.vibe) refuses it itself.
        if (fault === "post-empty" && first(fault)) return try base.post(conversation, clientId, name, "")
        if (fault.startsWith("post-") && first(fault)) throw new Refused({ refusal: fault.slice("post-".length) as "empty" | "duplicate" | "not-replying" | "full" })
        if (fault === "refuse" && !observation.faulted) {
          try sync(() => { observation.faulted = true })
          throw new Unavailable({ reason: "Factory closed" })
        }
        try base.post(conversation, clientId, name, text)
      },
      openWiki: effect (conversation, page) => {
        if (fault === "wiki" && !observation.faulted) {
          try sync(() => { observation.faulted = true })
          throw new Unavailable({ reason: "wiki unavailable" })
        }
        try base.openWiki(conversation, page)
      },
      tour: effect (conversation) => {
        if (first("held-tour")) {
          try Deferred.await(released)
          try sync(() => { observation.faulted = true })
        }
        if ((fault === "tour-refuse" || fault === "tour-unavailable") && !observation.faulted) {
          observation.faulted = true
          if (fault === "tour-refuse") throw new Refused({ refusal: "busy" })
          throw new Unavailable({ reason: "Factory closed" })
        }
        try base.tour(conversation)
      },
      controlTour: effect (conversation, action, step) => {
        if (base.controlTour === undefined || first("tour-control:control")) throw new Unavailable({ reason: "control unavailable" })
        try base.controlTour(conversation, action, step)
      },
      endTour: effect (conversation) => {
        if (first("end-twice")) try base.endTour(conversation)
        if (fault === "end-tour-unavailable" && !observation.faulted) {
          observation.faulted = true
          throw new Unavailable({ reason: "Factory closed" })
        }
        try base.endTour(conversation)
      },
      sandbox: effect (conversation) => {
        if (fault === "sandbox-read") throw new Unavailable({ reason: "sandbox unavailable" })
        // `sandbox-clock-read`: the clock reads before 1970 for the first sandbox read, before the writer has saved
        // anything; that read fails, and the clock mends when it ends.
        if (first("sandbox-clock-read:read")) broken = true
        return try metered(base.sandbox(conversation))
      },
      startSandbox: effect (conversation, operationId) => {
        if (first("sandbox-start")) throw new Unavailable({ reason: "sandbox unavailable" })
        if (first("sandbox-replay:start")) try metered(base.startSandbox(conversation, operationId))
        const started = try metered(base.startSandbox(conversation, operationId))
        // `machine-command-exhausted` jumps when the machine holds the first command, not at the start.
        if (fault === "machine-command-exhausted") remaining = started.remaining
        if (skewed && !jumped && fault !== "machine-command-exhausted") {
          jumped = true
          skew += fault === "sandbox-last-minute" ? started.remaining * 60_000 - 30_000 : (fault === "sandbox-low" || fault === "sandbox-month-end" ? started.remaining - 5 : started.remaining + 1) * 60_000
          skewNanos = try Effect.orDie(Effect.try(() => BigInt(skew) * 1_000_000n))
          try Effect.logInfo("vibelang.e2e.sandbox-clock").pipe(Effect.annotateLogs({ fault }))
        }
        return started
      },
      stopSandbox: effect (conversation, operationId, generation) => {
        const stopped = try metered(base.stopSandbox(conversation, operationId, generation))
        // `sandbox-month-end`: nothing runs, so the jump to three seconds before the next UTC month charges nothing.
        if (fault === "sandbox-month-end" && first("sandbox-month-end:stop")) {
          const at = new Date(wall.currentTimeMillisUnsafe() + skew)
          skew += Date.UTC(at.getUTCFullYear(), at.getUTCMonth() + 1, 1) - 3_000 - at.getTime()
          skewNanos = try Effect.orDie(Effect.try(() => BigInt(skew) * 1_000_000n))
          try Effect.logInfo("vibelang.e2e.sandbox-clock").pipe(Effect.annotateLogs({ fault }))
        }
        return stopped
      },
      // `sandbox-clock` breaks the clock for the first command, not the next call of any kind: a status read that
      // came first under load stopped the sandbox before the person could type one.
      sandboxCommand: effect (conversation, operationId, command, generation) => {
        if ((fault === "sandbox-clock" || fault === "machine-stop-clock") && !jumped && !broken) {
          broken = true
          try Effect.logInfo("vibelang.e2e.sandbox-clock").pipe(Effect.annotateLogs({ fault }))
        }
        if (first("sandbox-replay:command")) {
          firstCommand = operationId
          try metered(base.sandboxCommand(conversation, operationId, command, generation))
        } else if (first("sandbox-replay:reuse")) return try metered(base.sandboxCommand(conversation, firstCommand, command, generation))
        // `machine-command-replay`: the machine refuses the first command and its answer is lost, so the transport sends
        // it again under the same operation id.
        if (first("machine-command-replay:lost")) try Effect.ignore(metered(base.sandboxCommand(conversation, operationId, command, generation)))
        return try metered(base.sandboxCommand(conversation, operationId, command, generation))
      },
      events: (conversation, after) => Stream.unwrap(effect {
        try sync(() => { observation.subscriptions.push({ conversation, after }) })
        if (conversation.startsWith("tour-") && first("tour-events")) return Stream.fail(new Unavailable({ reason: "connection interrupted" }))
        const ending = fault === "end" && !observation.faulted
        const forged = fault === "forged" && forges(conversation)
        const resumed = forged ? resumeAt(forging, conversation, after) : { cursor: after, first: [] }
        const real = base.events(conversation, resumed.cursor).pipe(
          Stream.mapEffect(effect (event) => {
            // Hold each real terminal event until the browser has observed its streamed text and announcements.
            if (fault === "streaming" && event.type === "ReplyFinished") try Queue.take(completions)
            if (fault === "thinking" && event.type === "ReplyDelta" && !observation.faulted) {
              observation.faulted = true
              try Deferred.await(released)
            }
            if ((fault === "drop" || fault === "disconnect") && !observation.faulted && event.seq === (fault === "drop" ? 3 : 4)) {
              try sync(() => { observation.faulted = true })
              if (fault === "disconnect") throw new Unavailable({ reason: "connection interrupted" })
              return Result.failVoid
            }
            try sync(() => { observation.delivered.push(event) })
            return Result.succeed(event)
          }),
          Stream.filterMap((event) => event),
          Stream.takeUntil((event) => {
            if (ending && event.seq === 3) { observation.faulted = true; return true }
            return false
          }),
        )
        return forged ? Stream.concat(Stream.fromIterable(resumed.first), real.pipe(Stream.flatMap((event) => Stream.fromIterable(forge(forging, conversation, event))))) : real
      }),
    }
  })).pipe(Layer.provide((fault === "wiki-repository" ? mockFactoryFor(undefined, recordedWikiStore()) : device !== undefined ? mockFactoryFor(undefined, makeWikiStore(), faultyMachines(device, Effect.suspend(() => meterClock.exhaust))) : MockFactory).pipe(Layer.provide(fault === "held-tour-step" ? heldStepJournal(observation) : Layer.empty))))
}

/** `held-tour-step`'s journal: the first write that records a tour's step waits for the page's release. */
function heldStepJournal(observation: Trace) {
  return Layer.effect(MockJournal, effect {
    const released = try Deferred.make<void>()
    observation.release = () => Effect.asVoid(Deferred.succeed(released, undefined))
    let held = false
    return {
      read: (_conversation: string) => succeed([] as ReadonlyArray<Event>),
      write: effect (_conversation: string, events: ReadonlyArray<Event>) => {
        if (held || events.at(-1)?.type !== "WalkthroughDriven") return
        held = true
        try sync(() => { observation.holding = true })
        try Deferred.await(released)
        try sync(() => { observation.holding = false; observation.faulted = true })
      },
    }
  })
}
