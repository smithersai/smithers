// Real action-index/per-run hosts with product accounts/history and a SQLite/KV/alarm platform adapter.
import * as MockAccounts from "../../src/core/MockAccounts.vibe"
import { MockMythical } from "../../src/history/MockMythical.vibe"
import { empty as emptyHistory } from "../../src/history/mythical.vibe"
import type { RunRequest } from "../../src/actions/wire.vibe"
import * as Directory from "../../worker/ActionDirectory.vibe"
import * as Runs from "../../worker/ActionRuns.vibe"
import * as Identity from "../../worker/ActionIdentity.vibe"
import * as Objects from "../../worker/Objects.vibe"
import { chargeKeyOf } from "../../worker/budgetDecision.vibe"
import { Unreachable } from "../../worker/Unreachable.vibe"
import { objectStorage } from "./objectStorage.ts"

/** A product world; only the platform's SQLite/KV/alarm adapter differs from workerd. */
export effect function world() {
  const accounts = try MockAccounts.make()
  const person = try accounts.choose("maintainer")
  const authority = Identity.fromAccounts({
    current: () => Effect.orDie(accounts.current()), role: accounts.role,
    allowed: (actor, action) => accounts.policy.authorize(actor, action).pipe(Effect.as(true), Effect.catch(() => succeed(false))),
  })
  const objects = new Map<string, {
    readonly storage: Objects.Storage
    readonly sequencer: Effect.Success<ReturnType<typeof Objects.conversation>>
    readonly host: ReturnType<typeof Runs.make>
  }>()
  effect function object(id: string) {
    const root = id
    const existing = objects.get(root)
    if (existing !== undefined) return existing
    const storage = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Objects.Storage
    const sequencer = try Objects.conversation(storage)
    const found = { storage, sequencer, host: Runs.make(root, storage, sequencer, authority) }
    objects.set(root, found)
    return found
  }
  const storage = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Objects.Storage
  const adapters: Directory.Runs = {
    request: effect (id, exact) => { const obj = try object(exact === true ? id : try directory.root(id)); return try promise(() => obj.storage.get<RunRequest>("action/request")) },
    read: effect (id) => try Runs.read((try object(try directory.root(id))).sequencer),
    start: effect (request, role) => try (try object(request.id)).host.start(request, role),
    cancel: effect (id, role, owner) => try Effect.mapError((try object(try directory.root(id))).host.cancel(id, role, owner), () => new Unreachable({ what: "action" })),
  }
  const directory = Directory.directory("index", storage, adapters, authority)
  const budget = try Objects.budget(storage, 10_000_000)
  // The live RPC adapter scopes a daily ledger's keys by host; independent objects may have identical reply ids.
  const spendFor = (host: string) => ({
    admit: (_day: string, reply: string, ceiling: number) => budget.admit(chargeKeyOf(host, reply), ceiling),
    spend: (_day: string, reply: string, tokens: number, reported: boolean, ceiling: number) => budget.spend(chargeKeyOf(host, reply), tokens, reported, ceiling),
  })
  const spend = spendFor("world")
  const model = { model: undefined, unusable: "no-model" }
  return { accounts, person, object, directory, spend, spendFor, model, authority, budgetStorage: storage }
}
export function request(id: string, flow: string, input: Schema.Json, owner: string): RunRequest {
  return { id, flow, input, door: "button", actor: "person", owner, name: "will" }
}
export const history = MockMythical({ role: "maintainer", name: "will", agent: false }, () => succeed(emptyHistory))

type Sequencer = Effect.Success<ReturnType<typeof Objects.conversation>>
/** The host stops once `write` commits: that write and every later one on this incarnation die, as an evicted object's do. */
export function stopsAfter(sequencer: Sequencer, write: keyof Sequencer): Sequencer {
  let stopped = false
  const halt = () => Effect.die(new Error("host stopped"))
  const entries = Object.entries(sequencer).map(([key, value]) => {
    if (typeof value !== "function") return [key, value]
    const call = value as (...args: Array<unknown>) => unknown!unknown
    return [key, (...args: Array<unknown>) => stopped ? halt()
      : key === write ? Effect.andThen(call(...args), Effect.suspend(() => { stopped = true; return halt() }))
      : call(...args)]
  })
  return Object.fromEntries(entries) as Sequencer
}

/** One object's storage, a first incarnation that stops after `write`, and fresh incarnations over the same storage. */
export effect function interrupted(id: string, write: keyof Sequencer, authority: Parameters<typeof Runs.make>[3]) {
  const storage = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Objects.Storage
  const first = Runs.make(id, storage, stopsAfter(try Objects.conversation(storage), write), authority)
  const restart = effect () => {
    const sequencer = try Objects.conversation(storage)
    return { sequencer, host: Runs.make(id, storage, sequencer, authority) }
  }
  return { storage, first, restart }
}
