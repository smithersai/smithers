// `held-actions`, `held-start` and `held-start-failed` for the e2e host (e2e/runtime/entry.vibe): an actions answer
// that arrives after the person's role changed.
import { Actions, ActionFailure } from "../../src/actions/Actions.vibe"
import { MockActions } from "../../src/actions/MockActions.vibe"
import { Factory } from "../../src/core/Factory.vibe"

/** Which answer waits: the first command list answered for a maintainer, or the first run start (then starts or fails). */
export type Held = "commands" | "start" | "start-failed"

/**
 * The product's MockActions, except that one answer waits until `release` runs, then `answered` runs. A page that
 * changes role meanwhile receives that answer under its old epoch. A held start begins only after `release`, so a
 * list the page loads meanwhile does not hold its run; `answered` runs once the started run has been read.
 */
export function heldActions(holds: Held, answered: () => void) {
  const gate: { open: () => Promise<boolean> } = { open: () => Promise.resolve(false) }
  const layer = Layer.effect(Actions, effect {
    const real = try Actions
    const factory = try Factory
    const released = try Deferred.make<void>()
    gate.open = () => runPromise(Deferred.succeed(released, undefined))
    let held = false
    let started = ""
    return {
      list: () => real.list(),
      runs: (flow) => real.runs(flow),
      read: effect (id) => {
        const run = try real.read(id)
        if (id === started) {
          started = ""
          try sync(answered)
        }
        return run
      },
      follow: (id) => real.follow(id),
      start: effect (flow, input, door) => {
        if (holds === "commands" || held) return try real.start(flow, input, door)
        held = true
        try Deferred.await(released)
        if (holds === "start-failed") {
          try sync(answered)
          throw new ActionFailure({ code: "unavailable" })
        }
        const id = try real.start(flow, input, door)
        started = id
        return id
      },
      command: (text, door) => door === undefined ? real.command(text) : real.command(text, door),
      rerun: (id) => real.rerun(id),
      cancel: (id) => real.cancel(id),
      commands: effect () => {
        const role = (try Effect.orDie(factory.accounts.current())).role
        const holdsList = holds === "commands" && !held && role === "maintainer"
        if (holdsList) held = true
        const commands = try real.commands()
        if (holdsList) {
          try Deferred.await(released)
          try sync(answered)
        }
        return commands
      },
    }
  }).pipe(Layer.provide(MockActions({ actor: "person" })))
  return { layer, release: () => gate.open() }
}
