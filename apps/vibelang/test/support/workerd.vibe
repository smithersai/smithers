// Local workerd for the live suites (test/*.workerd.test.vibe): Miniflare runs test/workerd/worker.vibe, the API
// Worker's Durable Objects over the app's real code, or the site Worker alone, each listening on a free loopback port.
// The suites start one in `beforeAll` with `await runPromise(serveApi())` and stop it in `afterAll`.
import * as NodeServices from "@effect/platform-node/NodeServices"
import { SecureRandom } from "effect/crypto"
import { build } from "esbuild"
import { Miniflare } from "miniflare"
import vibelang from "vibelang-unplugin/esbuild"
import { dumpWorkerdCoverage, instrumentBundle } from "./workerdCoverage.ts"

/** esbuild or Miniflare failed to bundle or start a Worker. */
error WorkerdFailed { cause: unknown }

/** The model key the opt-in real-model case uses; unset, that case skips. */
export const modelKey = Option.getOrUndefined(runSync(Config.option(Config.String("CEREBRAS_API_KEY"))))

/** What a Worker's bundle is: its ES module, and the `.wasm` files it imports, by module name. */
interface Bundle {
  readonly module: string
  readonly wasm: ReadonlyArray<{ readonly name: string; readonly path: string }>
  /** The bundler's source map when built for the coverage command; undefined otherwise (0017). */
  readonly bundleMap: Record<string, unknown> | undefined
}

/**
 * The module at `relative` (to this file) as one ES module for workerd, its `.vibe` modules compiled, workerd's own
 * modules left to it. A `#quickjs.wasm` import (`@smthrs/harness/QuickJSWorkerd`) stays a module of its own, as
 * Cloudflare's bundlers upload it: workerd compiles WebAssembly only from a module, never from bytes.
 */
effect function bundle(relative: string) {
  const path = try (try Path.Path).fromFileUrl(new URL(relative, import.meta.url))
  const wasm: Array<{ readonly name: string; readonly path: string }> = []
  const wasmModules = {
    name: "wasm-modules",
    setup(build: { onResolve: Function; resolve: Function }) {
      build.onResolve({ filter: /^#quickjs\.wasm$/ }, async (args: { path: string; importer: string; resolveDir: string; kind: string; pluginData?: unknown }) => {
        if (args.pluginData === "inner") return undefined
        const resolved = await build.resolve(args.path, { importer: args.importer, resolveDir: args.resolveDir, kind: args.kind, pluginData: "inner" })
        if (!wasm.some((file) => file.path === resolved.path)) wasm.push({ name: "quickjs.wasm", path: resolved.path })
        return { path: "./quickjs.wasm", external: true }
      })
    },
  }
  const coverage = try Config.withDefault(Config.Boolean("BENCH_COVERAGE"), false)
  const result = try tryPromise({
    try: () => build({
      entryPoints: [path], bundle: true, write: false, format: "esm", platform: "browser", target: "es2022",
      conditions: ["workerd", "worker", "browser"], external: ["node:*", "cloudflare:*"], logLevel: "silent",
      plugins: [vibelang(), wasmModules as never],
      ...(coverage ? { sourcemap: true, outfile: "worker.js" } : {}),
    }),
    catch: (cause) => new WorkerdFailed({ cause }),
  })
  if (coverage) {
    const js = result.outputFiles.find((file) => !file.path.endsWith(".map"))!
    const map = result.outputFiles.find((file) => file.path.endsWith(".map"))!
    const instrumented = try Effect.try(() => instrumentBundle(js.text))
    const instrumentedBundle: Bundle = { module: instrumented, wasm, bundleMap: try Effect.try(() => JSON.parse(map.text)) }
    return instrumentedBundle
  }
  const bundled: Bundle = { module: result.outputFiles[0]!.text, wasm, bundleMap: undefined }
  return bundled
}

/** The bundle as Miniflare's modules: the ES module first, then each `.wasm` as a compiled WebAssembly module. */
effect function modulesOf(bundled: Bundle) {
  const fs = try FileSystem.FileSystem
  const modules: Record<string, { readonly type: string; readonly contents: string | Uint8Array }> = {
    "worker.js": { type: "esm", contents: bundled.module },
  }
  for (const file of bundled.wasm) modules[file.name] = { type: "wasm", contents: try fs.readFile(file.path) }
  return modules
}

export interface Served {
  readonly origin: string
  readonly dispose: () => Promise<void>
  /** Dispatches through this actual workerd instance, preserving the incoming request. */
  readonly fetch: (request: Request) => Promise<Response>
}

effect function listen(config: Record<string, unknown>, port = 0, bundleMap: Record<string, unknown> | undefined = undefined) {
  const options = { host: "127.0.0.1", port, workers: [{ config }] } as ConstructorParameters<typeof Miniflare>[0]
  if (bundleMap !== undefined) options.inspectorPort = 0
  const worker = try Effect.try({ try: () => new Miniflare(options), catch: (cause) => new WorkerdFailed({ cause }) })
  const url = try tryPromise({ try: () => worker.ready, catch: (cause) => new WorkerdFailed({ cause }) })
  const name = String(config.name)
  const served: Served = {
    origin: url.origin,
    dispose: async () => {
      // Coverage mode: the worker's accumulated counters are execution evidence; dump before the isolate is gone.
      if (bundleMap !== undefined) await dumpWorkerdCoverage(worker, name, bundleMap, "coverage/bench/workerd-raw")
      await worker.dispose()
    },
    fetch: async (request) => {
      const response = await worker.dispatchFetch(request.url, { method: request.method, headers: Object.fromEntries(request.headers), ...(request.method === "GET" || request.method === "HEAD" ? {} : { body: await request.text() }) })
      // Miniflare and the browser expose the same Fetch response with distinct platform declarations.
      return response as unknown as Response
    },
  }
  return served
}

/** The API Worker's bundle, built once per suite file. */
let apiBundle: Bundle | undefined

/** The API Worker with `env` as its configuration: the deployment's Config, as text bindings. */
export effect function serveApi(env: Readonly<Record<string, string>> = {}, port = 0) {
  provide NodeServices.layer {
    apiBundle ??= try bundle("../workerd/worker.vibe")
    const modules = try modulesOf(apiBundle)
    return try listen({
      name: "api",
      compatibilityDate: "2026-10-01",
      compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules },
      env: {
        ...Object.fromEntries(Object.entries(env).map(([name, value]) => [name, { type: "text", value }])),
        CONVERSATION: { type: "durable-object", worker: "api", exportName: "Conversation" },
        BUDGET: { type: "durable-object", worker: "api", exportName: "Budget" },
        ACCOUNTS: { type: "durable-object", worker: "api", exportName: "ProjectAccounts" },
        HISTORY: { type: "durable-object", worker: "api", exportName: "History" },
        SANDBOX_LEDGER: { type: "durable-object", worker: "api", exportName: "SandboxLedger" },
        ACTION_INDEX: { type: "durable-object", worker: "api", exportName: "ActionIndex" },
      },
      exports: {
        Conversation: { type: "durable-object", storage: "sqlite" },
        Budget: { type: "durable-object", storage: "sqlite" },
        ProjectAccounts: { type: "durable-object", storage: "sqlite" },
        History: { type: "durable-object", storage: "sqlite" },
        SandboxLedger: { type: "durable-object", storage: "sqlite" },
        ActionIndex: { type: "durable-object", storage: "sqlite" },
      },
    }, port, apiBundle.bundleMap)
  }
}

/** The site Worker with no API Worker bound: the mock deployment. */
export effect function serveSite(withAssets = false) {
  provide NodeServices.layer {
    const bundled = try bundle("../../worker/index.vibe")
    const modules = try modulesOf(bundled)
    return try listen({
      name: "site",
      compatibilityDate: "2026-10-01",
      ...(withAssets ? {
        assets: { directory: try (try Path.Path).fromFileUrl(new URL("../../dist/", import.meta.url)), hasUserWorker: true, runWorkerFirst: true, notFoundHandling: "single-page-application" },
        env: { ASSETS: { type: "assets" } },
      } : {}),
      manifest: { mainModule: "worker.js", modules },
    }, 0, bundled.bundleMap)
  }
}

/** A fresh conversation id, so cases share no object. */
export effect function room(name: string) {
  provide SecureRandom.layerWebCrypto {
    const id = try (try SecureRandom.SecureRandom).uuidV4()
    return `${name}-${id.slice(0, 8)}`
  }
}

/** The wiki fixture repository on the persistent engine in real workerd SQLite. */
export effect function serveWikiHost() {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/wiki.vibe")
    const modules = try modulesOf(bundled)
    return try listen({
      name: "wiki", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules },
      env: { WIKI: { type: "durable-object", worker: "wiki", exportName: "WikiObject" } },
      exports: { WikiObject: { type: "durable-object", storage: "sqlite" } },
    }, 0, bundled.bundleMap)
  }
}

