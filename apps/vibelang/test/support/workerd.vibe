}

/** Both production auth hosts, on distinct local origins, plus a GitHub service fixture. Never shipped. */
export effect function serveAuthBroker() {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/authbroker.vibe")
    return try listen({
      name: "authbroker", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules: try modulesOf(bundled) },
      env: {
        BROKER: { type: "durable-object", worker: "authbroker", exportName: "HostedBroker" },
        SITE: { type: "durable-object", worker: "authbroker", exportName: "HostedSite" },
        CONNECTION: { type: "durable-object", worker: "authbroker", exportName: "HostedConnection" },
      },
      exports: { HostedBroker: { type: "durable-object", storage: "sqlite" }, HostedSite: { type: "durable-object", storage: "sqlite" }, HostedConnection: { type: "durable-object", storage: "sqlite" } },
    })
  }
}

/** The production sandbox objects on an in-memory Container, never part of the deployed Worker (0017). */
export effect function serveSandboxObjects() {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/bench-sandbox.vibe")
    return try listen({
      name: "bench-sandbox", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules: try modulesOf(bundled) },
      env: {
        MACHINE: { type: "durable-object", worker: "bench-sandbox", exportName: "MachineHost" },
        ACCOUNT: { type: "durable-object", worker: "bench-sandbox", exportName: "AccountHost" },
      },
      exports: { MachineHost: { type: "durable-object", storage: "sqlite" }, AccountHost: { type: "durable-object", storage: "sqlite" } },
    }, 0, bundled.bundleMap)
  }
}

/** worker/Api.vibe's production bodies on workerd; `bindings` supplies the Worker's text configuration. */
export effect function serveApiObjects(bindings: Readonly<Record<string, string>>) {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/bench-api.vibe")
    const objects = ["Conversation", "Budget", "ProjectAccounts", "History", "ActionIndex"]
    const names: Readonly<Record<string, string>> = { Conversation: "CONVERSATION", Budget: "BUDGET", ProjectAccounts: "ACCOUNTS", History: "HISTORY", ActionIndex: "ACTION_INDEX" }
    return try listen({
      name: "bench-api", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules: try modulesOf(bundled) },
      env: {
        ...Object.fromEntries(Object.entries(bindings).map(([name, value]) => [name, { type: "text", value }])),
        ...Object.fromEntries(objects.map((exportName) => [names[exportName]!, { type: "durable-object", worker: "bench-api", exportName }])),
      },
      exports: Object.fromEntries(objects.map((name) => [name, { type: "durable-object", storage: "sqlite" }])),
    }, 0, bundled.bundleMap)
  }
}

/** Production draft/review agents against a benchmark-owned model endpoint, never part of the deployed Worker. */
export effect function serveDraftsBenchmark(bindings: Readonly<Record<string, string>>) {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/bench-drafts.vibe")
    const modules = try modulesOf(bundled)
    return try listen({
      name: "bench-drafts", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules },
      env: { ...Object.fromEntries(Object.entries(bindings).map(([name, text]) => [name, { type: "text", value: text }])), DRAFTS: { type: "durable-object", worker: "bench-drafts", exportName: "DraftsObject" } },
      exports: { DraftsObject: { type: "durable-object", storage: "sqlite" } },
    }, 0, bundled.bundleMap)
  }
}
