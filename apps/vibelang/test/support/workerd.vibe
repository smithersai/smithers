}

/** worker/Api.vibe's production bodies on workerd; `bindings` supplies the Worker's text configuration. */
export effect function serveApiObjects(bindings: Readonly<Record<string, string>>) {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/bench-api.vibe", try configuredMeasure())
    const objects = ["Conversation", "Budget", "ProjectAccounts", "History", "ActionIndex"]
    const names: Readonly<Record<string, string>> = { Conversation: "CONVERSATION", Budget: "BUDGET", ProjectAccounts: "ACCOUNTS", History: "HISTORY", ActionIndex: "ACTION_INDEX" }
    return try listen({
      name: "bench-api", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules: try modulesOf(bundled) },
      env: {
        ...Object.fromEntries(Object.entries(bindings).map(([name, value]) => [name, { type: "text", value }])),
        ...Object.fromEntries(objects.map((exportName) => [names[exportName]!, { type: "durable-object", worker: "bench-api", exportName }])),
      },
      exports: Object.fromEntries(objects.map((name) => [name, { type: "durable-object", storage: "sqlite" }])),
    }, 0, bundled.measure)
  }
}

/** Production draft/review agents against a benchmark-owned model endpoint, never part of the deployed Worker. */
export effect function serveDraftsBenchmark(bindings: Readonly<Record<string, string>>) {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/bench-drafts.vibe", try configuredMeasure())
    const modules = try modulesOf(bundled)
    return try listen({
      name: "bench-drafts", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules },
      env: { ...Object.fromEntries(Object.entries(bindings).map(([name, text]) => [name, { type: "text", value: text }])), DRAFTS: { type: "durable-object", worker: "bench-drafts", exportName: "DraftsObject" } },
      exports: { DraftsObject: { type: "durable-object", storage: "sqlite" } },
    }, 0, bundled.measure)
  }
}

/** The coverage fixture's measured bundle, built once per suite file; only the dump directory differs per Worker. */
let coverageObjectBundle: Bundle | undefined

/**
 * test/support/coverageObject.vibe's Durable Object, only its own module measured into `directory`: the proof that
 * workerd's counters follow what a test runs (test/workerdCoverage.workerd.test.vibe).
 */
export effect function serveCoverageObject(directory: string) {
  provide NodeServices.layer {
    const fixture = try (try Path.Path).fromFileUrl(new URL("./coverageObject.vibe", import.meta.url))
    const measure: Measure = { directory, instrumented: (file) => file === fixture }
    coverageObjectBundle ??= try bundle("./coverageObject.vibe", measure)
    return try listen({
      name: "coverage-object", compatibilityDate: "2026-10-01",
      manifest: { mainModule: "worker.js", modules: try modulesOf(coverageObjectBundle) },
      env: { TALLY: { type: "durable-object", worker: "coverage-object", exportName: "Tally" } },
      exports: { Tally: { type: "durable-object", storage: "sqlite" } },
    }, 0, measure)
  }
}

/** Cutover/rollback over the same real Durable Object SQLite and key-value store. */
export effect function serveConnectfixHost() {
  provide NodeServices.layer {
    const bundled = try bundle("../workerd/connectfix.vibe", try configuredMeasure())
    return try listen({
      name: "connectfix", compatibilityDate: "2026-10-01", compatibilityFlags: ["nodejs_compat"],
      manifest: { mainModule: "worker.js", modules: try modulesOf(bundled) },
      env: { PHASE: { type: "text", value: "seed" }, ACCOUNTS: { type: "durable-object", worker: "connectfix", exportName: "ProjectAccounts" } },
      exports: { ProjectAccounts: { type: "durable-object", storage: "sqlite" } },
    }, 0, bundled.measure)
  }
}
