// The real-Container suite's body (decision 0024, rulings VL-35 and VL-36), shared by `pnpm test:sandboxes-live` against
// the vl-test stage, by test/sandboxesReplay.test.vibe over that run's recording, by test/sandboxProbe.test.vibe
// against the same probe served over loopback with local processes, and by test/sandboxProbe.workerd.test.vibe over
// the real Container's recorded calls. Each script is one probe owner and one sandbox at a time; a scope that fails
// sweeps it.
import { expect } from "@effect/vitest"
import { HttpRecording } from "@smthrs/testing"
import * as ContainerRecording from "@smthrs/testing/ContainerRecording"
import { HttpClient, HttpClientRequest } from "effect/http"
import { Factory } from "../../src/core/Factory.vibe"
import { LiveFactory } from "../../src/core/LiveFactory.vibe"
import type { Answer } from "../../worker/machineObject.vibe"
import { DIRECT_CONVERSATION, OWNER_HEADER, PROBE_CONVERSATION, PROBE_WINDOW_MS, probeOwner } from "../../worker/sandboxProbeFetch.vibe"

/** A real Container run's recording: request headers (the token, the owner) never reach it. */
export const RECORDING = "test/recordings/sandboxes-live.json"
/** The origin a recording is keyed under, whatever URL the probe was deployed at. */
export const REPLAY_ORIGIN = "https://probe.invalid"
export function normalize(request: HttpRecording.RecordedRequest): HttpRecording.RecordedRequest {
  return { ...request, url: request.url.replace(/^https?:\/\/[^/]+/, REPLAY_ORIGIN) }
}

/**
 * Each script's recorded Container calls (VL-36): `<script>.json`, the calls of the one machine the script uses, from
 * the probe's `POST /api/probe/container`. `VIBELANG_SANDBOX_MODE=record pnpm test:sandboxes-live` against a stage
 * deployed with `VIBELANG_SANDBOX_CONTAINER_MODE=record` writes them; test/sandboxProbe.workerd.test.vibe replays them.
 */
export const CONTAINERS = "test/recordings/containers"
export const SCRIPTS = { lifecycle: PROBE_CONVERSATION, direct: DIRECT_CONVERSATION, "sweep-before": PROBE_CONVERSATION, deadline: PROBE_CONVERSATION, unused: PROBE_CONVERSATION } as const
export type Script = keyof typeof SCRIPTS
export const containerRecording = (script: Script) => `${CONTAINERS}/${script}.json`
/**
 * Runs with a script's owner before its first request, outside the script's HttpClient. A replay loads the owner's
 * machine with the script's recorded calls here; a real run has nothing to prepare.
 */
export type Prepare = (owner: string) => void!unknown
const unprepared: Prepare = () => Effect.void

/** The probe's client: every request carries the token and this run's owner. */
export function probeClient(client: HttpClient.HttpClient, token: string, owner: string) {
  return HttpClient.mapRequest(client, (request) => request.pipe(
    HttpClientRequest.setHeader("authorization", `Bearer ${token}`),
    HttpClientRequest.setHeader(OWNER_HEADER, owner),
  ))
}

/** Asks the probe to stop what `owner` left running; answers whether its container still runs. */
export effect function sweep(client: HttpClient.HttpClient, origin: string) {
  const response = try client.execute(HttpClientRequest.post(`${origin}/api/probe/sweep`))
  if (response.status !== 200) return { running: true, status: response.status }
  const body = (try response.json) as { readonly running: boolean }
  return { running: body.running, status: response.status }
}

/**
 * Start, write, Stop (checkpoint), Start (restore), read, Stop and sweep, through the product's Factory client and the
 * HttpClient in context. The owner's deadline is `window` away, PROBE_WINDOW_MS at most, so the probe tears the sandbox
 * down by then anyway; a scope that ends in failure sweeps at once.
 */
export effect function lifecycle(origin: string, token: string, window = PROBE_WINDOW_MS, prepare = unprepared) {
  const began = try Clock.currentTimeMillis
  const owner = probeOwner(began + window)
  try prepare(owner)
  const client = probeClient(try HttpClient.HttpClient, token, owner)
  try Effect.addFinalizer((exit) => exit._tag === "Success" ? Effect.void : Effect.asVoid(Effect.exit(sweep(client, origin))))
  provide LiveFactory(origin).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, client))) {
    const factory = try Factory
    const first = try factory.startSandbox(PROBE_CONVERSATION, "start-1")
    const written = try factory.sandboxCommand(PROBE_CONVERSATION, "write", "printf saved > keep.txt && cat keep.txt", first.generation)
    const stopped = try factory.stopSandbox(PROBE_CONVERSATION, "stop-1", first.generation)
    const second = try factory.startSandbox(PROBE_CONVERSATION, "start-2")
    const restored = try factory.sandboxCommand(PROBE_CONVERSATION, "read", "cat keep.txt", second.generation)
    const ended = try factory.stopSandbox(PROBE_CONVERSATION, "stop-2", second.generation)
    const elapsed = (try Clock.currentTimeMillis) - began
    const swept = try sweep(client, origin)
    return { owner, first, written, stopped, second, restored, ended, elapsed, swept }
  }
}
export type Run = Effect.Success<ReturnType<typeof lifecycle>>

/**
 * What every run must show. `timed` compares the metered minutes with this run's own wall time, which a replay can't:
 * its minutes were metered when it was recorded.
 */
export function expectLifecycle(run: Run, timed: boolean) {
  expect([run.first.status, run.first.generation, run.first.role]).toEqual(["running", 1, "contributor"])
  expect([run.written, run.restored]).toEqual(["saved", "saved"])
  expect([run.stopped.status, run.second.status, run.second.generation, run.ended.status]).toEqual(["stopped", "running", 2, "stopped"])
  expect(run.ended.used).toBeGreaterThan(0)
  expect(run.ended.used).toBeGreaterThanOrEqual(run.stopped.used)
  expect(run.ended.remaining).toBe(Math.ceil(run.ended.allowance - run.ended.used))
  if (timed) expect(run.ended.used * 60_000).toBeLessThanOrEqual(run.elapsed)
  expect(run.swept).toEqual({ running: false, status: 200 })
}

/**
 * The direct machine route's script (`POST /api/probe/machine`, generation 1): the machine's own answers on a running
 * box. A lease the account never asks for (`soon`), a command before any lease, a lease, a write, the same write again
 * (its receipt), the write's id with another command (a conflict), a failing command, a read, a stop and the state.
 */
export const DIRECT_STEPS = [
  ["start", "start-1", ""], ["status", "", ""], ["lease", "", "soon"], ["command", "early", "cat keep.txt"], ["lease", "", "60000"],
  ["command", "write", "printf saved > keep.txt && cat keep.txt"], ["command", "write", "printf saved > keep.txt && cat keep.txt"],
  ["command", "write", "cat keep.txt"], ["command", "missing", "cat gone.txt"], ["command", "last", "cat keep.txt"], ["stop", "stop-1", ""], ["status", "", ""],
] as const
/** Where the `dies` fault is armed in a replay of DIRECT_STEPS: before `last`. */
export const LAST_STEP = 9
const refused = (reason: string) => ({ ok: false, output: "", reason })

/** One step on the owner's direct machine. */
export effect function directStep(client: HttpClient.HttpClient, origin: string, step: readonly [string, string, string]) {
  const response = try client.execute(HttpClientRequest.post(`${origin}/api/probe/machine`).pipe(HttpClientRequest.bodyJsonUnsafe(step)))
  return { status: response.status, body: (try response.json) as Answer }
}

/** DIRECT_STEPS as one owner; a scope that ends in failure stops the machine. */
export effect function direct(origin: string, token: string, prepare = unprepared) {
  const owner = probeOwner((try Clock.currentTimeMillis) + PROBE_WINDOW_MS)
  try prepare(owner)
  const client = probeClient(try HttpClient.HttpClient, token, owner)
  try Effect.addFinalizer((exit) => exit._tag === "Success" ? Effect.void : Effect.asVoid(Effect.exit(directStep(client, origin, ["stop", "cleanup", ""]))))
  const answers = try Effect.forEach(DIRECT_STEPS, (step) => directStep(client, origin, step))
  return { owner, answers }
}
export function expectDirect(run: Effect.Success<ReturnType<typeof direct>>) {
  expect(run.answers.map((answer) => answer.status)).toEqual(DIRECT_STEPS.map(() => 200))
  expect(run.answers.map((answer) => answer.body)).toEqual([
    { ok: true, output: "" }, { ok: true, output: "running" }, refused("lease-duration"), refused("lease-expired"), { ok: true, output: "running" },
    { ok: true, output: "saved" }, { ok: true, output: "saved" }, { ok: false, output: "saved", reason: "receipt-conflict" },
    { ok: true, output: expect.stringMatching(/\nExit 1$/) }, { ok: true, output: "saved" }, { ok: true, output: "" }, { ok: true, output: "stopped" },
  ])
}

/** Start, then the sweep before the deadline: it stops what the owner left running. */
export effect function sweepBefore(origin: string, token: string, prepare = unprepared) {
  const owner = probeOwner((try Clock.currentTimeMillis) + PROBE_WINDOW_MS)
  try prepare(owner)
  const client = probeClient(try HttpClient.HttpClient, token, owner)
  try Effect.addFinalizer((exit) => exit._tag === "Success" ? Effect.void : Effect.asVoid(Effect.exit(sweep(client, origin))))
  provide LiveFactory(origin).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, client))) {
    const started = try (try Factory).startSandbox(PROBE_CONVERSATION, "left-1")
    return { owner, started, swept: try sweep(client, origin) }
  }
}

/**
 * Start with the owner's deadline `window` away, wait past it, then sweep: the owner is a Viewer, so the account's
 * alarm (SandboxMeter) stops the sandbox. A real Container's start takes seconds, so a real run passes a longer window.
 */
export effect function deadline(origin: string, token: string, window: number, prepare = unprepared) {
  const end = (try Clock.currentTimeMillis) + window
  const owner = probeOwner(end)
  try prepare(owner)
  const client = probeClient(try HttpClient.HttpClient, token, owner)
  try Effect.addFinalizer((exit) => exit._tag === "Success" ? Effect.void : Effect.asVoid(Effect.exit(sweep(client, origin))))
  provide LiveFactory(origin).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, client))) {
    const started = try (try Factory).startSandbox(PROBE_CONVERSATION, "start-1")
    try Effect.sleep(Duration.millis(Math.max(0, end - (try Clock.currentTimeMillis) + 100)))
    return { owner, started, swept: try sweep(client, origin) }
  }
}

/** The sweep of an owner that never started a sandbox: nothing runs. */
export effect function unused(origin: string, token: string, prepare = unprepared) {
  const owner = probeOwner((try Clock.currentTimeMillis) + PROBE_WINDOW_MS)
  try prepare(owner)
  return { owner, swept: try sweep(probeClient(try HttpClient.HttpClient, token, owner), origin) }
}

/** The Container calls the probe recorded for the machine `owner` used in `script`. */
export effect function containerCalls(origin: string, token: string, owner: string, script: Script) {
  const client = probeClient(try HttpClient.HttpClient, token, owner)
  const response = try client.execute(HttpClientRequest.post(`${origin}/api/probe/container?conversation=${SCRIPTS[script]}`))
  if (response.status !== 200) return try Effect.die(new Error(`the probe answered ${response.status} for the ${script} recording`))
  return ((try response.json) as unknown as ContainerRecording.Recording).calls
}
