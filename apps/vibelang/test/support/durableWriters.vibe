// One durable execution on the memory engine, and a day's budget ledger: the model writers' unit tests and fuzz targets
// run the live writers inside both.
import { Digest, SecureRandom } from "effect/crypto"
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Journal } from "@smthrs/journal"
import { Flow, FlowRuntime } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { Spend } from "../../worker/Reply.vibe"
import { Unreachable } from "../../worker/Unreachable.vibe"

/** The budget's answer to every admission: admitted, refused, or unreachable. */
export type Admission = "admit" | "refuse" | "fault"

/**
 * A budget answering `admission`. Like the production ledger, a key is settled once. `admitted` and `spent` count the
 * run's own keys; `calls`, `tokens` and `unreported` count physical model calls (`model/` keys) and what they were
 * charged: the reported tokens, or the call's ceiling when it reported nothing usable.
 */
export function ledger(admission: Admission) {
  const log = { admitted: 0, spent: 0, calls: 0, tokens: 0, unreported: 0 }
  const settled = new Set<string>()
  const spend: Spend.Shape = {
    admit: (_day, key) => effect {
      if (key.startsWith("model/")) log.calls += 1
      else log.admitted += 1
      if (admission === "fault") throw new Unreachable({ what: "budget" })
      return admission === "admit"
    },
    spend: (_day, key, tokens, reported, ceiling) => sync(() => {
      if (settled.has(key)) return
      settled.add(key)
      if (!key.startsWith("model/")) {
        log.spent += 1
        return
      }
      log.tokens += reported ? tokens : ceiling
      if (!reported) log.unreported += 1
    }),
  }
  return { log, spend }
}

/** Only the final run-key settlement fails once; parent release and physical-call accounting remain healthy. */
export function settlementFaultOnce() {
  const day = ledger("admit")
  const log = { charges: 0, runSpends: 0, physicalCharges: 0 }
  const spend: Spend.Shape = {
    admit: day.spend.admit,
    spend: effect (name, key, tokens, reported, ceiling) => {
      log.charges += 1
      if (key.startsWith("model/")) log.physicalCharges += 1
      else {
        log.runSpends += 1
        if (log.runSpends === 2) throw new Unreachable({ what: "budget" })
      }
      try day.spend.spend(name, key, tokens, reported, ceiling)
    },
  }
  return { log, spend }
}

const Outcome = Flow.make("test/model-writers/outcome", { payload: {}, success: Schema.String, body: () => Node.succeed("") })

/** One durable execution of `program`, whose string answer says how it ended. */
effect function execution<S>(layer: Layer.Layer<S>, program: Effect<string, never, S | FlowRuntime.FlowRuntime | FlowRuntime.FlowInstance | Digest.Digest | SecureRandom.SecureRandom>) {
  const registration = Layer.effectDiscard(effect {
    const engine = try FlowRuntime.FlowRuntime
    const services = try Effect.context<S | Digest.Digest | SecureRandom.SecureRandom>()
    try engine.register(Outcome, () => Effect.provide(program, services) as never)
  })
  const context = try Layer.build(registration.pipe(Layer.provide(layer), Layer.provideMerge(FlowEngine.layerMemory), Layer.provide(WebCrypto.layer)))
  return try Context.get(context, FlowRuntime.FlowRuntime).execute(Outcome, { executionId: "test/model-writers/fuzz", payload: {} })
}

// The engine's generic requirements stay unresolved over S; every service is provided above, and Scope remains.
export const within = <S>(layer: Layer.Layer<S>, program: Effect<string, never, S | FlowRuntime.FlowRuntime | FlowRuntime.FlowInstance | Digest.Digest | SecureRandom.SecureRandom>) => execution(layer, program) as unknown as Effect<string, unknown, Scope.Scope>

/**
 * A journal whose every read fails. Its flush succeeds, so the page read itself is the failure a budget's recovery
 * meets; its writes are closed. A writer whose meter is asked for usage under it cannot learn what the run spent.
 */
export const unreadableJournal = Layer.succeed(Journal.Journal, Journal.makeNoop({ flush: Effect.void }))

/** A logger and the lines it has captured: each line is a log's message and annotations, as JSON. */
export effect function capturedLogs() {
  const { References } = try promise(() => import("effect"))
  const lines = try Ref.make<ReadonlyArray<string>>([])
  const layer = Logger.layer([Logger.make(options => {
    runSync(Ref.update(lines, all => [...all, JSON.stringify({ message: options.message, annotations: options.fiber.getRef(References.CurrentLogAnnotations) })]))
  })])
  return { layer, lines: Ref.get(lines) }
}

/** Whether `lines` hold the warning a writer logs when its meter cannot read the run's usage. */
export function usageUnavailable(lines: ReadonlyArray<string>): boolean {
  return lines.some(line => line.includes("vibelang.budget.usage") && line.includes('"outcome":"unavailable"'))
}
