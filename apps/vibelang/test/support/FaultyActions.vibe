// An Actions fault over the product's real MockActions: the first call at the named point fails with ActionFailure
// ("unavailable"); later calls are real. `list` fails a load, `start` a run's start, `read` a run read, `follow` fails a
// run's first follow subscription, `follow-close` closes it without a receipt, `cancel` a cancel.
import { ActionFailure, Actions } from "../../src/actions/Actions.vibe"

export type ActionFault = "list" | "start" | "read" | "follow" | "follow-close" | "cancel"

export function faultyActions<E, R>(base: Layer.Layer<Actions, E, R>, point: ActionFault = "list", followed?: Array<string>) {
  return Layer.effect(Actions, effect {
    const actions = try Actions
    let failed = false
    const first = (at: ActionFault) => {
      if (failed || at !== point) return false
      failed = true
      return true
    }
    const unavailable = () => new ActionFailure({ code: "unavailable" })
    const shape: Actions.Shape = {
      list: () => first("list") ? Effect.fail(unavailable()) : actions.list(),
      commands: () => actions.commands(),
      runs: (flow) => actions.runs(flow),
      read: (id) => first("read") ? Effect.fail(unavailable()) : actions.read(id),
      follow: (id) => {
        followed?.push(id)
        return first("follow") ? Stream.fail(unavailable()) : first("follow-close") ? Stream.empty : actions.follow(id)
      },
      start: (flow, input, door) => first("start") ? Effect.fail(unavailable()) : actions.start(flow, input, door),
      command: (text, door) => actions.command(text, door),
      rerun: (id) => actions.rerun(id),
      cancel: (id) => first("cancel") ? Effect.fail(unavailable()) : actions.cancel(id),
    }
    return shape
  }).pipe(Layer.provide(base))
}
