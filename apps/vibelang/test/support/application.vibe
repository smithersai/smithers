// The test host supplies only the resource layer and an observation of the actual rendered model.
import { Runtime } from "foldkit"
import type { Actions } from "../../src/actions/Actions.vibe"
import { MockActions } from "../../src/actions/MockActions.vibe"
import type { Factory } from "../../src/core/Factory.vibe"
import { Flags, init, Model, subscriptions, update, viewTransition } from "../../src/web/main.vibe"
import { view } from "../../src/web/view.vibe"

/** The app in `node`, listening to the keyboard and scrolling of the document that owns it. */
export function application(node: HTMLElement, resources: Layer.Layer<Factory>, observe: (model: Model) => void, initialize = init, actions: Layer.Layer<Actions, never, Factory> = MockActions({ actor: "person" })) {
  return Runtime.makeApplication({
    Model, Flags, init: initialize, update,
    view: (model, h) => { observe(model); return view(model, h) },
    subscriptions: subscriptions(node.ownerDocument, node.ownerDocument), viewTransition,
    resources: actions.pipe(Layer.provideMerge(resources)), container: node,
  })
}
