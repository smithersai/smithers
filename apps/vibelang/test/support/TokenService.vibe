import { GitHub } from "@smthrs/integrations"
const { GitHubAuth, GitHubRefused } = GitHub.Auth

/**
 * Injected OAuth service: ten live token pairs per person/app, evicting the least recently used pair, and GitHub's
 * hourly count of new tokens. Past nine new tokens in an hour GitHub shows its re-authorization page instead of
 * redirecting at once; it revokes nothing for it ("Creating multiple tokens for OAuth apps",
 * https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps; production showed the page
 * at the tenth, smithers.sh decision 0165).
 */
export effect function tokenService() {
  const issued: Array<{ accessToken: Redacted.Redacted<string>; refreshToken: Redacted.Redacted<string>; expiresAt: null }> = []
  let serial = 0
  let uses = 0
  let failures = 0
  let attempts = 0
  const pairs = new Map<string, { refresh: string; used: number }>()
  const issuedAt: Array<number> = []
  const issue = effect () => {
    issuedAt.push(try Clock.currentTimeMillis)
    const token = "fixture-token-private-" + ++serial
    if (pairs.size === 10) {
      const oldest = [...pairs].sort((left, right) => left[1].used - right[1].used)[0]!
      pairs.delete(oldest[0])
    }
    pairs.set(token, { refresh: "fixture-refresh-private-" + serial, used: ++uses })
    const pair = { accessToken: Redacted.make(token), refreshToken: Redacted.make("fixture-refresh-private-" + serial), expiresAt: null }
    issued.push(pair)
    return pair
  }
  const github = GitHubAuth.of({
    authorizeUrl: ({ state, codeChallenge, redirectUri }) => "https://github.test/authorize?" + new URLSearchParams({ state, challenge: codeChallenge, redirect_uri: redirectUri }),
    exchange: issue,
    user: effect (token) => {
      const pair = pairs.get(Redacted.value(token))
      if (pair === undefined) throw new GitHubRefused({ step: "user", reason: "rejected" })
      pair.used = ++uses
      return { id: 7, login: "ada" }
    },
    revoke: effect (token) => {
      attempts++
      if (failures > 0) { failures--; throw new GitHubRefused({ step: "revoke", reason: "unavailable" }) }
      pairs.delete(Redacted.value(token))
    },
    refresh: effect (token) => {
      const pair = [...pairs].find(([, pair]) => pair.refresh === Redacted.value(token))
      if (pair === undefined) throw new GitHubRefused({ step: "refresh", reason: "rejected" })
      pairs.delete(pair[0])
      return try issue()
    },
    permission: () => succeed("read"),
    deviceCode: () => fail(new GitHubRefused({ step: "device", reason: "unavailable" })),
    deviceToken: () => fail(new GitHubRefused({ step: "device", reason: "unavailable" })),
  } satisfies GitHub.Auth.GitHubAuth["Service"])
  // A pair the person held from before the last hour.
  const kept = try issue()
  issuedAt.length = 0
  return { github, kept, issued, failRevocations: (count: number) => sync(() => { failures = count }), stats: () => sync(() => ({ live: pairs.size, attempts })),
    /** Whether GitHub would show its re-authorization page before the next token: nine or more new in the last hour. */
    reauthorize: () => effect { const now = try Clock.currentTimeMillis; return issuedAt.filter((at) => at > now - 3_600_000).length >= 9 } }
}
