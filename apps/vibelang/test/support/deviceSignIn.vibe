// The device sign-in world the `login` test and benchmark share: the real Accounts object over loopback beside the
// identity-provider fixture (GitHub's device endpoints on a real socket). `grant` is what the token endpoint answers.
import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer"
import { HttpServer, HttpServerRequest, HttpServerResponse } from "effect/http"
import { GitHub } from "@smthrs/integrations"
import { Factory } from "../../src/core/Factory.vibe"
import * as Accounts from "../../worker/Accounts.vibe"
import type { Storage } from "../../worker/Objects.vibe"
import { objectStorage } from "./objectStorage.ts"
export const PERSON = { id: 9, login: "fixture-person-9" }
export const live = Layer.succeed(Factory, { mode: "live" } as unknown as Factory["Service"])

/** `revoked` records each token the site revokes at GitHub. */
export function githubService(revoked: Array<string> = []): GitHub.Auth.GitHubAuth["Service"] {
  const refused = (step: "device" | "exchange" | "refresh" | "user") => fail(new GitHub.Auth.GitHubRefused({ step, reason: "rejected" }))
  return {
    authorizeUrl: () => "https://github.test/login", exchange: () => refused("exchange"), refresh: () => refused("refresh"),
    user: (token) => Redacted.value(token) === "device-token-9" ? succeed(PERSON) : refused("user"),
    permission: () => succeed("read"), revoke: (token) => Effect.sync(() => { revoked.push(Redacted.value(token)) }), deviceCode: () => refused("device"), deviceToken: () => refused("device"),
  }
}

/** Serves the real accounts object beside the identity-provider fixture; `grant` is what the token endpoint answers next. */
export effect function world() {
  const grant = try Ref.make<string>("authorization_pending")
  const revoked: Array<string> = []
  const interval = try Ref.make(1)
  const address = (try HttpServer.HttpServer).address
  const origin = address._tag === "UnixPathAddress" ? "http://localhost" : `http://127.0.0.1:${address.port}`
  const storage = (try Effect.try(() => objectStorage())) as unknown as Storage
  const accounts = try Accounts.make("signin-test", storage, {
    origin, initialMaintainer: "1", clientId: "fixture-client-id",
    signingSecret: Redacted.make("fixture-only-signing-secret-32-chars"),
    encryptionKey: Redacted.make("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="),
    github: githubService(revoked),
  })
  try HttpServer.serveEffect(effect {
    const request = try HttpServerRequest.HttpServerRequest
    const path = new URL(request.url, origin).pathname
    // GitHub's device endpoints answer JSON only to `Accept: application/json`; otherwise the same fields form-encoded.
    const answer = (fields: Record<string, string | number>) => (request.headers.accept ?? "").includes("application/json")
      ? HttpServerResponse.jsonUnsafe(fields)
      : HttpServerResponse.text(new URLSearchParams(Object.entries(fields).map(([key, value]) => [key, String(value)])).toString(), { contentType: "application/x-www-form-urlencoded" })
    if (path === "/login/device/code") return answer({ device_code: "private-device-code", user_code: "ABCD-EFGH", verification_uri: origin + "/device", expires_in: 600, interval: try Ref.get(interval) })
    if (path === "/login/oauth/access_token") {
      const state = try Ref.get(grant)
      return answer(state === "authorized" ? { access_token: "device-token-9", token_type: "bearer", scope: "read:user" } : state === "unknown-person" ? { access_token: "stranger", token_type: "bearer", scope: "read:user" } : state === "slow_down" ? { error: state, interval: 30 } : { error: state })
    }
    return try accounts.fetch
  })
  return { origin, grant, interval, revoked }
}

/** Runs a `login`/`logout` step with this directory and factory origin. */
export function configured(origin: string, directory: string, github = origin) {
  return ConfigProvider.layer(ConfigProvider.fromUnknown({ VIBELANG_FACTORY_URL: origin, VIBELANG_GITHUB_WEB: github, XDG_CONFIG_HOME: directory }))
}
