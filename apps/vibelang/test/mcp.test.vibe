// @vitest-environment node
import { describe, expect, it } from "@effect/vitest"
import { McpClient, McpProtocol } from "effect/ai"
import { ChildProcess } from "effect/process"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { ActionList, AskOutput, ReadOutput, RunId } from "../src/surfaces/commands.vibe"
import { Registered, Run } from "../src/actions/Actions.vibe"
import { mockReply } from "../src/core/mockReplies.vibe"
import { node } from "./support/processes.vibe"
import { cliManifest, serverPath } from "./surface-host.vibe"

/** The platform the suites run on: Node.js's services and this Node.js executable. */
const platform = Layer.mergeAll(NodeServices.layer, ExperimentalNodeServices.layer)

const clientLayer = Layer.unwrap(effect {
  const command = ChildProcess.make(try node(), [try serverPath(), "--mock"])
  return McpClient.layerStdio({
    name: "Factory surface tests", version: "1", protocol: McpProtocol.v2025_11_25, timeout: "10 seconds", command,
  })
}).pipe(Layer.provide(platform))

// Match the CLI process suite: allow startup plus the MCP client's ten-second protocol deadline.
const LIMIT = 30_000

describe("built MCP stdio server through McpClient", () => {
  it.live("discovers the exact same names and schemas as the CLI manifest", () => effect {
    provide clientLayer, platform {
      const client = try McpClient.McpClient
      const tools = try client.listTools()
      const markdown = try cliManifest()
      const sections = markdown.split("\n## ").slice(1)
      const discovered = try Effect.try(() => sections.map((section) => ({
        name: section.split("\n")[0], ...JSON.parse(section.split("```json\n")[1]!.split("\n```")[0]!),
      })))
      try Effect.try(() => {
        expect(tools.map((tool) => tool.name)).toEqual(["ask", "read", "history", "plan", "start", "note", "sandboxes", "sandbox-start", "sandbox-stop", "sandbox-run", "issues", "issue", "actions", "run", "trace", "cancel", "rerun", "wiki"])
        expect(discovered).toEqual(tools.map((tool) => ({ name: tool.name, inputSchema: tool.inputSchema, outputSchema: tool.outputSchema })))
        // Compact discovery: about 1,000 characters per command on average.
        expect(markdown.length).toBeLessThan(1000 * tools.length)
      })
    }
  }, LIMIT)

  it.live("requests four specification reviews over real stdio and cannot submit a VIP acceptance", () => effect {
    provide clientLayer {
      const client = try McpClient.McpClient
      const issue = (try client.listTools()).find(tool => tool.name === "issue")!
      const output = Schema.Struct({ detail: Schema.String })
      const revised = try client.callTool({ tool: issue, schema: output, arguments: { op: "spec-revise", revision: 2, text: "MCP specification revision", key: "mcp-spec" } })
      try Effect.try(() => expect(JSON.parse(revised.detail).specification.revision).toBe(3))
      for (const reviewer of ["astra", "sol", "fable", "opus"]) {
        const result = try client.callTool({ tool: issue, schema: output, arguments: { op: "spec-review", revision: 3, reviewer, key: "mcp-review-" + reviewer } })
        try Effect.try(() => expect(JSON.parse(result.detail).specification[reviewer]).toMatchObject({ verdict: "LGTM", grade: reviewer === "opus" ? "B" : "A", revision: 3 }))
      }
      const refused = try Effect.result(client.callTool({ tool: issue, schema: output, arguments: { op: "accept", number: 45, key: "mcp-cannot-accept" } }))
      try Effect.try(() => expect(refused._tag).toBe("Failure"))
    }
  }, LIMIT)

  it.live("asks, reads, polls after a cursor, and shares state across tool calls", () => effect {
    provide clientLayer {
      const client = try McpClient.McpClient
      const tools = try client.listTools()
      const ask = tools.find((tool) => tool.name === "ask")!
      const read = tools.find((tool) => tool.name === "read")!
      const empty = try client.callTool({ tool: read, schema: ReadOutput, arguments: {} })
      const answer = try client.callTool({ tool: ask, schema: AskOutput, arguments: { text: "How do I install it?" } })
      const snapshot = try client.callTool({ tool: read, schema: ReadOutput, arguments: { after: 0 } })
      const tail = try client.callTool({ tool: read, schema: ReadOutput, arguments: { after: snapshot.seq } })
      const other = try client.callTool({ tool: read, schema: ReadOutput, arguments: { conversation: "other" } })
      try Effect.try(() => {
        expect(empty.entries).toEqual([])
        expect(answer.text).toBe(mockReply("install"))
        expect(snapshot.entries[1]).toMatchObject({ text: answer.text, done: true })
        expect(snapshot.seq).toBe(answer.events.at(-1))
        expect(tail.entries).toEqual([])
        expect(other.entries).toEqual([])
      })
    }
  }, LIMIT)

  it.live("starts actions and reads their real results across MCP tool calls", () => effect {
    provide clientLayer {
      const client = try McpClient.McpClient
      const tools = try client.listTools()
      const list = tools.find(tool => tool.name === "actions")!
      const run = tools.find(tool => tool.name === "run")!
      const trace = tools.find(tool => tool.name === "trace")!
      const rerun = tools.find(tool => tool.name === "rerun")!
      const entries = try client.callTool({ tool: list, schema: ActionList, arguments: {} })
      const first = try client.callTool({ tool: run, schema: RunId, arguments: { flow: "vibelang/Post", input: '{"text":"What is Effect?"}', wait: true } })
      const result = try client.callTool({ tool: trace, schema: Run, arguments: first })
      const next = try client.callTool({ tool: rerun, schema: RunId, arguments: first })
      try Effect.try(() => {
        expect(entries.actions.some(entry => entry.name === "vibelang/Tour")).toBe(true)
        expect(result.state).toBe("passed")
        expect(result.steps.some(step => step.state === "passed")).toBe(true)
        expect(next.id).not.toBe(first.id)
      })
    }
  })

  it.live("returns declared refusals and rejects malformed input through the protocol", () => effect {
    provide clientLayer {
      const client = try McpClient.McpClient
      const tools = try client.listTools()
      const ask = tools.find((tool) => tool.name === "ask")!
      const read = tools.find((tool) => tool.name === "read")!
      const refused = try client.callTool({ tool: ask, arguments: { text: " " } })
      const invalid = try exit(client.callTool({ tool: read, schema: ReadOutput, arguments: { after: -1 } }))
      const missing = try exit(client.callTool({ tool: ask, schema: AskOutput, arguments: {} }))
      try Effect.try(() => {
        expect(refused.isError).toBe(true)
        expect(refused.content).toEqual([{ type: "text", text: "The message was refused: empty" }])
        expect(Exit.isFailure(invalid)).toBe(true)
        expect(Exit.isFailure(missing)).toBe(true)
      })
      const healthy = try client.callTool({ tool: read, schema: ReadOutput, arguments: {} })
      try Effect.try(() => expect(healthy.entries).toEqual([]))
    }
  }, LIMIT)
})

import { WikiState } from "../src/core/wikiSchemas.vibe"
it.live("wiki read, draft and person submission share one MCP factory without changing the source", () => effect {
  provide clientLayer {
    const client = try McpClient.McpClient
    const wiki = (try client.listTools()).find(tool => tool.name === "wiki")!
    const read = try client.callTool({ tool: wiki, schema: WikiState, arguments: { op: "read", page: "roadmap" } })
    const base = read.pages.find(page => page.id === "roadmap")!.source
    const draft = try client.callTool({ tool: wiki, schema: WikiState, arguments: { op: "draft", page: "roadmap", text: "MCP reviewed change", key: "mcp-wiki-draft" } })
    const review = try client.callTool({ tool: wiki, schema: WikiState, arguments: { op: "save", page: "roadmap", base, text: draft.draft!.text, key: "mcp-wiki-save" } })
    const after = try client.callTool({ tool: wiki, schema: WikiState, arguments: { op: "read", page: "roadmap" } })
    try Effect.try(() => {
      expect(draft.draft?.text).toContain("MCP reviewed change")
      expect(review.review).toMatch(/\/pull\/[0-9]+$/)
      expect(after.pages.find(page => page.id === "roadmap")?.source).toBe(base)
    })
  }
}, LIMIT)
