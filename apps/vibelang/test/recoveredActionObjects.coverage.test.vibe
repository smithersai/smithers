// @vitest-environment node
// Real conversation hosts: durable tour controls, failed alarms and admission after a recorded reply start.
import { expect, it } from "@effect/vitest"
import { Mythical } from "../src/history/MythicalHistory.vibe"
import { WALKTHROUGH } from "../src/core/walkthroughSteps.vibe"
import * as HistoryActions from "../worker/HistoryActions.vibe"
import * as Objects from "../worker/Objects.vibe"
import * as Runs from "../worker/ActionRuns.vibe"
import { world, request, history } from "./support/actionObjects.vibe"

it.live("a parked tour pauses, resumes and seeks to its final stop, then its real flow finishes", () => scoped(effect {
  const w = try world()
  const id = "controlled-tour"
  const obj = try w.object(id)
  expect(try obj.host.start(request(id, "vibelang/Tour", {}, w.person.id), "maintainer")).toBeNull()
  provide history {
    const product = try Mythical
    try obj.host.alarm(w.spend, w.model, product)
    expect(try Objects.controlTour(id, obj.storage, obj.sequencer, "pause", 0)).toBeNull()
    expect((try obj.sequencer.snapshot()).walkthrough?.paused).toBe(true)
    expect(try Objects.controlTour(id, obj.storage, obj.sequencer, "resume", 0)).toBeNull()
    expect((try obj.sequencer.snapshot()).walkthrough?.paused).toBe(false)
    expect(try Objects.controlTour(id, obj.storage, obj.sequencer, "seek", WALKTHROUGH.length)).toBeNull()
    try obj.host.alarm(w.spend, w.model, product)
    expect((try obj.sequencer.snapshot()).walkthrough?.target).toBe("finish")
    try sleep(WALKTHROUGH.at(-1)!.duration)
    for (let round = 0; round < 3; round++) {
      try obj.host.alarm(w.spend, w.model, product).pipe(Effect.timeout("5 seconds"))
    }
    const snapshot = try obj.sequencer.snapshot()
    expect(snapshot.entries[0]).toMatchObject({ done: true, error: "" })
    expect(snapshot.entries[0]!.text).toContain(WALKTHROUGH.at(-1)!.subtitle)
    expect(try Runs.read(obj.sequencer)).toMatchObject([{ id, state: "passed", result: "null" }])
  }
}), 60_000)

it.live("an invalid wiki path is empty; speaking as an absent tour writes nothing", () => scoped(effect {
  const w = try world()
  const obj = try w.object("inactive-tour")
  const before = try obj.sequencer.read(0)
  expect(try Objects.openWiki("inactive-tour", obj.storage, obj.sequencer, "../outside")).toBe("empty")
  expect(try obj.sequencer.say("absent-tour", "Retain no words.")).toBe(false)
  expect(try Objects.controlTour("inactive-tour", obj.storage, obj.sequencer, "resume", 0)).not.toBeNull()
  expect(try obj.sequencer.read(0)).toEqual(before)
  expect(try Objects.openWiki("inactive-tour", obj.storage, obj.sequencer, "index")).toBeNull()
  expect((try obj.sequencer.snapshot()).pane).toBe("/wiki/index")
}))

it.live("a tour whose narration store dies settles its registered run failed and closes the active answer", () => scoped(effect {
  const w = try world()
  const id = "failed-tour"
  const obj = try w.object(id)
  const faulty: typeof obj.sequencer = { ...obj.sequencer, say: () => Effect.die(new Error("tour narration unavailable")) }
  const host = Runs.make(id, obj.storage, faulty, w.authority)
  expect(try host.start(request(id, "vibelang/Tour", {}, w.person.id), "maintainer")).toBeNull()
  provide history {
    try host.alarm(w.spend, w.model, try Mythical)
  }
  expect(try Runs.read(obj.sequencer)).toMatchObject([{ id, state: "failed", result: "Action failed" }])
  expect((try obj.sequencer.read(0)).entries[0]).toMatchObject({ done: true, error: "Action failed" })
}))

it.live("a failed alarm preserves its cause and settles no answer; a healthy retry answers once", () => scoped(effect {
  const w = try world()
  const id = "failed-alarm"
  const obj = try w.object(id)
  expect(try obj.host.start(request(id, "vibelang/Post", { text: "Keep the question." }, w.person.id), "maintainer")).toBeNull()
  const before = try obj.sequencer.read(0)
  const beforeRuns = try Runs.read(obj.sequencer)
  const faulty = { ...Objects.executionHost(id, obj.storage, obj.sequencer), alarm: () => Effect.die(new Error("alarm host unavailable")) }
  provide history {
    const product = try Mythical
    const failed = try Effect.exit(Runs.alarm(id, obj.storage, obj.sequencer, w.spend, w.model, product, HistoryActions.make(id, obj.storage), faulty, w.authority))
    expect(Exit.isFailure(failed)).toBe(true)
    if (Exit.isFailure(failed)) expect(Cause.pretty(failed.cause)).toContain("alarm host unavailable")
    expect(try obj.sequencer.read(0)).toEqual(before)
    expect(try Runs.read(obj.sequencer)).toEqual(beforeRuns)
    try obj.host.alarm(w.spend, w.model, product)
  }
  const after = try obj.sequencer.read(0)
  expect(after.entries.filter((entry) => entry.author === "person")).toHaveLength(1)
  expect(after.entries.filter((entry) => entry.author === "agent")).toMatchObject([{ done: true, error: "The agent has no model configured." }])
}))

it.live("a host resumed after recording reply-start refuses a now-demoted person and closes the unfinished answer", () => scoped(effect {
  const w = try world()
  const id = "demoted-after-start"
  const obj = try w.object(id)
  expect(try obj.host.start(request(id, "vibelang/Post", { text: "Retain the accepted question." }, w.person.id), "maintainer")).toBeNull()
  const accepted = (try obj.sequencer.read(0)).entries.find((entry) => entry.author === "person")!
  try obj.sequencer.start(accepted.id)
  expect((try obj.sequencer.read(0)).entries.find((entry) => entry.author === "agent")?.done).toBe(false)
  try w.accounts.grant(w.person.id, "new")
  const recovered = try Objects.conversation(obj.storage)
  const restarted = Runs.make(id, obj.storage, recovered, w.authority)
  provide history {
    try restarted.alarm(w.spend, w.model, try Mythical)
  }
  const after = try recovered.read(0)
  expect(after.entries.filter((entry) => entry.author === "person")).toHaveLength(1)
  expect(after.entries.find((entry) => entry.author === "agent")).toMatchObject({ done: true, error: "Permission changed" })
  expect(try Runs.read(recovered)).toMatchObject([{ id, state: "passed", result: "null" }])
}))
