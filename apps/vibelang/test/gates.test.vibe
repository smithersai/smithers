import { describe, expect, it } from "@effect/vitest"
import { approveVip, specificationAccepted, specificationAcceptedUnder, reviseSpecification, reviseSpecificationUnder, recordSpecificationReview, SPEC_REVISION_POLICY } from "../src/core/conversation.vibe"
import { fixtureIssues } from "../src/core/IssuesFactory.vibe"
const review = { verdict: "LGTM" as const, grade: "A", revision: 2, link: "/review/1" }
const spec = { revision: 2, text: "Specification", astra: review, sol: review, fable: review, opus: review }
describe("factory acceptance gates", () => {
  it("an agent cannot accept a VIP even with a maintainer role", () => {
    const vip = fixtureIssues.find(i => i.number === 45)!
    expect(approveVip(vip, "maintainer", "agent", "agent", "2026-11-08")).toEqual(vip)
    expect(approveVip(vip, "contributor", "person", "jun", "2026-11-08")).toEqual(vip)
    expect(approveVip(vip, "maintainer", "person", "", "2026-11-08")).toEqual(vip)
    expect(approveVip(vip, "maintainer", "person", "will", "")).toEqual(vip)
    const settled = { ...vip, vip: "Accepted" as const }
    expect(approveVip(settled, "maintainer", "person", "will", "2026-11-08")).toBe(settled)
    expect(approveVip(vip, "maintainer", "person", "will", "2026-11-08")).toMatchObject({ vip: "Accepted", approvedBy: "will", approvedAt: "2026-11-08" })
  })
  it("requires four current LGTM A reviews with review links", () => {
    expect(specificationAccepted(spec)).toBe(true)
    for (const reviewer of ["astra", "sol", "fable", "opus"] as const) {
      expect(specificationAccepted({ ...spec, [reviewer]: { ...review, grade: "B" } })).toBe(false)
      expect(specificationAccepted({ ...spec, [reviewer]: { ...review, verdict: "Changes requested" } })).toBe(false)
      expect(specificationAccepted({ ...spec, [reviewer]: { ...review, revision: 1 } })).toBe(false)
      expect(specificationAccepted({ ...spec, [reviewer]: { ...review, link: "" } })).toBe(false)
    }
  })
  it("keeps the reset behind one named policy, which reads reset until Will rules (VL-32)", () => {
    expect(SPEC_REVISION_POLICY).toBe("reset")
    const kept = reviseSpecificationUnder(spec, "Revised specification", "keep")
    expect(kept.revision).toBe(3)
    for (const who of ["astra", "sol", "fable", "opus"] as const) expect(kept[who]).toEqual(spec[who])
    expect(specificationAcceptedUnder(kept, "keep")).toBe(true)
    expect(specificationAcceptedUnder(kept, "reset")).toBe(false)
    expect(specificationAcceptedUnder({ ...kept, opus: { ...kept.opus, revision: 1 } }, "keep")).toBe(false)
    expect(reviseSpecificationUnder(spec, "Revised specification", "reset")).toEqual(reviseSpecification(spec, "Revised specification"))
  })
  it("resets all answers on a new revision and rejects old results and person impersonation", () => {
    expect(reviseSpecification(spec, spec.text)).toBe(spec)
    const reset = reviseSpecification(spec, "Revised specification")
    expect(reset.revision).toBe(3)
    expect(specificationAccepted(reset)).toBe(false)
    for (const who of ["astra", "sol", "fable", "opus"] as const) expect(reset[who].verdict).toBe("")
    expect(recordSpecificationReview(reset, "astra", "person", { ...review, revision: 3 })).toEqual(reset)
    expect(recordSpecificationReview(reset, "astra", "astra", review)).toEqual(reset)
    const next = recordSpecificationReview(reset, "astra", "astra", { ...review, revision: 3 })
    expect(next.astra.verdict).toBe("LGTM")
    expect(next.sol.verdict).toBe("")
    for (const reviewer of ["astra", "sol", "fable", "opus"] as const) {
      const answer = { ...review, revision: 3 }
      expect(recordSpecificationReview(reset, reviewer, reviewer, answer)[reviewer]).toEqual(answer)
      expect(recordSpecificationReview(reset, reviewer, reviewer, { ...answer, verdict: "" })).toBe(reset)
      expect(recordSpecificationReview(reset, reviewer, reviewer, { ...answer, link: "" })).toBe(reset)
    }
    expect(recordSpecificationReview(reset, "unknown", "unknown", { ...review, revision: 3 })).toBe(reset)
  })
})

import { makeIssueFactory } from "../src/core/IssuesFactory.vibe"
import { SpecificationReviewers } from "../src/core/specification.vibe"
import { IssueFailure, IssueRequest } from "../src/core/issueSchemas.vibe"
import { Issue } from "../src/surfaces/commands.vibe"
import { Factory } from "../src/core/Factory.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"
const request = (op: IssueRequest["op"], key: string): IssueRequest => ({ op, key, number: 45, parent: 0, title: "", text: "", example: "", prior: "", assignee: "" })
it.effect("agent authority cannot accept through the same Factory flow as a maintainer", () => scoped(effect {
  const agent = try makeIssueFactory(effect () => ({ id: "agent", login: "agent", role: "maintainer", kind: "agent" }))
  const refused = try Effect.result(agent.act(request("accept", "agent-accept")))
  try Effect.try(() => expect(refused).toMatchObject({ _tag: "Failure", failure: { reason: "forbidden" } }))
  const person = try makeIssueFactory("maintainer")
  const accepted = try person.act(request("accept", "person-accept"))
  const replay = try person.act(request("accept", "person-accept"))
  try Effect.try(() => {
    expect(accepted.items.find(i => i.number === 45)).toMatchObject({ vip: "Accepted", approvedBy: "will" })
    expect(replay).toEqual(accepted)
  })
}))
it.effect("the shared flow records scripted reviews, refuses three As and a B, then accepts and resets", () => scoped(effect {
  const api = try makeIssueFactory("maintainer")
  const initial = try api.read()
  let state = try api.act({ ...request("spec-revise", "revision"), revision: initial.specification!.revision, text: "A revised specification." })
  for (const reviewer of ["astra", "sol", "fable", "opus"] as const) state = try api.act({ ...request("spec-review", reviewer), revision: 3, reviewer })
  try Effect.try(() => {
    expect(state.specification!.opus.grade).toBe("B")
    expect(specificationAccepted(state.specification!)).toBe(false)
    expect(state.specificationHistory!.filter(e => e.event === "reset")).toHaveLength(2)
  })
  state = try api.act({ ...request("spec-review", "opus-again"), revision: 3, reviewer: "opus" })
  try Effect.try(() => expect(specificationAccepted(state.specification!)).toBe(true))
  const stale = try Effect.result(api.act({ ...request("spec-review", "stale"), revision: 2, reviewer: "sol" }))
  try Effect.try(() => expect(stale).toMatchObject({ _tag: "Failure", failure: { reason: "review" } }))
  const reset = try api.act({ ...request("spec-revise", "reset-again"), revision: 3, text: "Another revision." })
  try Effect.try(() => expect(specificationAccepted(reset.specification!)).toBe(false))
}))
it.effect("a person can request a reviewer but cannot supply their grade or answer", () => scoped(effect {
  const api = try makeIssueFactory("maintainer")
  try api.act({ ...request("spec-revise", "new-spec"), revision: 2, text: "New revision" })
  const forged = { ...request("spec-review", "forged"), revision: 3, reviewer: "opus" as const, verdict: "LGTM", grade: "A", principal: "opus" }
  const result = try api.act(forged)
  try Effect.try(() => expect(result.specification!.opus.grade).toBe("B"))
}))
it.effect("CLI and MCP request reviews through the same command and refuse VIP acceptance", () => effect {
  provide MockFactory {
    try (try Factory).accounts!.choose("maintainer")
    const initial = try Issue.run({ op: "read", key: "spec-read" })
    try Effect.try(() => expect(JSON.parse(initial.detail).specification.revision).toBe(2))
    const revised = try Issue.run({ op: "spec-revise", revision: 2, text: "CLI specification", key: "cli-revision" })
    try Effect.try(() => expect(JSON.parse(revised.detail).specification.revision).toBe(3))
    const reviewed = try Issue.run({ op: "spec-review", revision: 3, reviewer: "astra", key: "cli-review" })
    try Effect.try(() => expect(JSON.parse(reviewed.detail).specification.astra).toMatchObject({ grade: "A", verdict: "LGTM", revision: 3 }))
    const forbidden = try Effect.result(Issue.run({ op: "accept", number: 45, key: "forged-accept" }))
    try Effect.try(() => expect(forbidden._tag).toBe("Failure"))
  }
})

it.effect("a faulty reviewer cannot record a stale result or change the gate after a failed review", () => scoped(effect {
  const api = try makeIssueFactory("maintainer")
  const before = try api.read()
  for (const stale of [true, false]) {
    const faulty: SpecificationReviewers.Shape = { review: () => stale ? succeed({ revision: 1, verdict: "LGTM", grade: "A", link: "#stale" }) : fail(new IssueFailure({ reason: "unavailable" })) }
    const result = try Effect.result(api.act({ ...request("spec-review", stale ? "stale-model" : "failed-model"), revision: 2, reviewer: "astra" }).pipe(Effect.provideService(SpecificationReviewers, faulty)))
    try Effect.try(() => expect(result._tag).toBe("Failure"))
    const after = try api.read()
    try Effect.try(() => expect(after).toEqual(before))
  }
}))
it.live("the in-chat scripted agent requests the same named-review flow", () => scoped(effect {
  provide MockFactory {
    const factory = try Factory
    try factory.accounts!.choose("maintainer")
    try factory.issues!.act({ ...request("spec-revise", "chat-revision"), revision: 2, text: "Chat review revision" })
    try factory.post("gates-chat", "request-review", "Will", "Review the specification with Codex Astra")
    try Stream.runDrain(factory.events("gates-chat", 0).pipe(Stream.takeUntil(event => event.type === "ReplyFinished")))
    const state = try factory.issues!.read()
    try Effect.try(() => expect(state.specification!.astra).toMatchObject({ verdict: "LGTM", grade: "A", revision: 3 }))
  }
}))
