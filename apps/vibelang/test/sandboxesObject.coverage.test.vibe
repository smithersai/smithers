// @vitest-environment node
// worker/Sandboxes.vibe: the per-person allowance object's SQLite store and durable execute over the real engine,
// with a scripted Machines host — start/command/meter/stop, receipt replay by operation id, and the refusal paths.
import { describe, expect, it } from "@effect/vitest"
import * as Sandboxes from "../worker/Sandboxes.vibe"
import { mockPolicy } from "../src/core/sandboxPolicy.vibe"
import { Refused, Unavailable, type SandboxSnapshot } from "../src/core/Factory.vibe"
import type { Machines, SandboxState } from "../src/core/sandboxHost.vibe"
import { objectStorage } from "./support/objectStorage.ts"
import { holding } from "./support/sandboxWorld.vibe"

/** A Machines host that records its calls and fails the named kinds. */
function fakeMachines(failures: ReadonlyArray<"start" | "stop" | "command" | "lease"> = []) {
  const calls: Array<string> = []
  const machines: Machines = {
    start: (id, generation) => {
      calls.push(`start:${id}:${generation}`)
      return failures.includes("start") ? fail(new Unavailable({ reason: "no image" })) : Effect.void
    },
    stop: (id, generation) => {
      calls.push(`stop:${id}:${generation}`)
      return failures.includes("stop") ? fail(new Unavailable({ reason: "wedged" })) : Effect.void
    },
    lease: (id, generation, milliseconds) => {
      calls.push(`lease:${id}:${generation}:${milliseconds > 0}`)
      return failures.includes("lease") ? fail(new Unavailable({ reason: "lease refused" })) : succeed(true)
    },
    command: (id, generation, operationId, command) => {
      calls.push(`command:${id}:${generation}:${operationId}`)
      return failures.includes("command") ? fail(new Unavailable({ reason: "lost" })) : succeed(`ran ${command}`)
    },
  }
  return { calls, machines }
}

/** Opens the object host over fresh storage, as `role`'s person. */
effect function openAs(role: "viewer" | "maintainer", machines: Machines) {
  const storage = (try Effect.try(() => objectStorage())) as unknown as Sandboxes.SandboxStorage
  const host = try Effect.provide(Sandboxes.open(storage, machines), mockPolicy(role))
  return { storage, host }
}

/** The pending operation the object's SQLite holds. */
effect function pendingIn(storage: Sandboxes.SandboxStorage) {
  const saved = try Effect.try(() => JSON.parse(storage.sql.exec<{ body: string }>("SELECT body FROM vibelang_sandbox_state WHERE id = 1").toArray()[0]!.body) as SandboxState)
  return saved.pending
}

/** `tag:detail` of the Refused or Unavailable an execute fails with, or `ok`. */
effect function failed(work: Effect<unknown, unknown>) {
  return work.pipe(Effect.map(() => "ok")) catch (error) => {
    const tagged = error as { readonly _tag: string; readonly refusal?: string; readonly reason?: string }
    return tagged._tag + ":" + (tagged._tag === "Refused" ? tagged.refusal : tagged.reason)
  }
}

describe("the sandbox object", () => {
  it.live("starts, commands, meters and stops, replaying each receipt by its operation id", () => effect {
    const { calls, machines } = fakeMachines()
    const { storage, host } = try openAs("maintainer", machines)
    const started = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const replayed = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const output = (try Sandboxes.execute("h", storage, host, "command", "c-1", "op-2", 1, "echo hi")) as string
    const replayedOutput = (try Sandboxes.execute("h", storage, host, "command", "c-1", "op-2", 1, "echo hi")) as string
    try Sandboxes.execute("h", storage, host, "meter", "", "", 0, "")
    const stopped = (try Sandboxes.execute("h", storage, host, "stop", "c-1", "op-3", 1, "")) as SandboxSnapshot
    const after = try host.snapshot("c-1")
    try Effect.try(() => {
      expect(started.status).toBe("running")
      expect(replayed).toEqual(started)
      expect(output).toBe("ran echo hi")
      expect(replayedOutput).toBe("ran echo hi")
      expect(stopped.status).toBe("stopped")
      expect(after.status).toBe("stopped")
      expect(calls.filter((call) => call.startsWith("start:"))).toEqual(["start:mock-person/c-1:1"])
      expect(calls.filter((call) => call.startsWith("command:"))).toEqual(["command:mock-person/c-1:1:op-2"])
      expect(calls.filter((call) => call.startsWith("stop:"))).toEqual(["stop:mock-person/c-1:1"])
      expect(calls.filter((call) => call.startsWith("lease:")).length).toBeGreaterThan(0)
    })
  }, 60_000)

  it.live("refuses the invalid, the unsigned, the stopped and the stale before any machine call", () => effect {
    const { calls, machines } = fakeMachines()
    const { storage, host } = try openAs("maintainer", machines)
    const invalid = try failed(Sandboxes.execute("h", storage, host, "start", "c-1", "bad id", 0, ""))
    const stopped = try failed(Sandboxes.execute("h", storage, host, "command", "c-1", "op-9", 0, "ls"))
    const started = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const stale = try failed(Sandboxes.execute("h", storage, host, "stop", "c-1", "op-10", 9, ""))
    const again = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-11", 0, "")) as SandboxSnapshot
    const viewer = try openAs("viewer", machines)
    const forbidden = try failed(Sandboxes.execute("h", viewer.storage, viewer.host, "start", "c-1", "op-12", 0, ""))
    try Effect.try(() => {
      expect(invalid).toBe("Refused:invalid")
      expect(stopped).toBe("Refused:stopped")
      expect(started.status).toBe("running")
      expect(stale).toBe("Refused:stale-generation")
      expect(again.status).toBe("running")
      expect(forbidden).toBe("Refused:forbidden")
      expect(calls.filter((call) => call.startsWith("start:"))).toEqual(["start:mock-person/c-1:1"])
      expect(calls.some((call) => call.startsWith("command:") || call.startsWith("stop:"))).toBe(false)
    })
  }, 60_000)

  it.live("cancels a failed start and replays its refusal without another machine call", () => effect {
    const { calls, machines } = fakeMachines(["start"])
    const { storage, host } = try openAs("maintainer", machines)
    const failedStart = try failed(Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, ""))
    const replayed = try failed(Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, ""))
    const snapshot = try host.snapshot("c-1")
    try Effect.try(() => {
      // The machine's own reason survives the cancel and the replay, so a live failure names its cause.
      expect(failedStart).toBe("Unavailable:start-failed:no image")
      expect(replayed).toBe("Unavailable:start-failed:no image")
      expect(snapshot.status).toBe("stopped")
      expect(calls).toEqual(["start:mock-person/c-1:1", "stop:mock-person/c-1:1"])
    })
  }, 60_000)

  it.live("a command failure is uncertain and never retried by its operation id", () => effect {
    const { calls, machines } = fakeMachines(["command"])
    const { storage, host } = try openAs("maintainer", machines)
    try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")
    const failedCommand = try failed(Sandboxes.execute("h", storage, host, "command", "c-1", "op-2", 1, "rm -rf /"))
    const replayed = try failed(Sandboxes.execute("h", storage, host, "command", "c-1", "op-2", 1, "rm -rf /"))
    try Effect.try(() => {
      expect(failedCommand).toBe("Unavailable:command-uncertain")
      expect(replayed).toBe("Unavailable:command-uncertain")
      expect(calls.filter((call) => call.startsWith("command:"))).toHaveLength(1)
    })
  }, 60_000)

  it.live("settles a command an evicted incarnation left running as uncertain, and never runs it again", () => effect {
    const { calls, machines } = fakeMachines()
    const { held, entered, release } = try holding(machines)
    const storage = (try Effect.try(() => objectStorage())) as unknown as Sandboxes.SandboxStorage
    const evicted = try Effect.provide(Sandboxes.open(storage, held), mockPolicy("maintainer"))
    const started = (try Sandboxes.execute("h", storage, evicted, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const running = try Effect.forkChild(Effect.result(evicted.command("c-1", "op-2", "make", started.generation)).pipe(Effect.provide(mockPolicy("maintainer"))))
    try Deferred.await(entered)
    const before = try pendingIn(storage)
    const next = try Effect.provide(Sandboxes.open(storage, machines), mockPolicy("maintainer"))
    try Effect.provide(next.tick(), mockPolicy("maintainer"))
    const after = try pendingIn(storage)
    try Deferred.succeed(release, undefined)
    const answered = try Fiber.join(running)
    const replayed = try failed(Sandboxes.execute("h", storage, next, "command", "c-1", "op-2", started.generation, "make"))
    try Effect.try(() => {
      expect(before?.operationId).toBe("op-2")
      expect(after).toBeNull()
      expect(answered._tag === "Failure" ? (answered.failure as { readonly reason?: string }).reason : "ran").toBe("command-uncertain")
      expect(replayed).toBe("Unavailable:command-uncertain")
      expect(calls.filter((call) => call.startsWith("command:"))).toEqual(["command:mock-person/c-1:1:op-2"])
    })
  }, 60_000)

  it.live("settles a command whose fiber was interrupted as uncertain", () => effect {
    const { calls, machines } = fakeMachines()
    const { held, entered } = try holding(machines)
    const { storage, host } = try openAs("maintainer", held)
    const started = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const running = try Effect.forkChild(host.command("c-1", "op-2", "make", started.generation).pipe(Effect.provide(mockPolicy("maintainer"))))
    try Deferred.await(entered)
    try Fiber.interrupt(running)
    try Effect.provide(host.tick(), mockPolicy("maintainer"))
    const settled = try pendingIn(storage)
    const replayed = try failed(Sandboxes.execute("h", storage, host, "command", "c-1", "op-2", started.generation, "make"))
    try Effect.try(() => {
      expect(settled).toBeNull()
      expect(replayed).toBe("Unavailable:command-uncertain")
      expect(calls.filter((call) => call.startsWith("command:"))).toHaveLength(1)
    })
  }, 60_000)

  it.live("leaves a running command to its fiber, even after a refused copy of it", () => effect {
    const { machines } = fakeMachines()
    const { held, entered, release } = try holding(machines)
    const { storage, host } = try openAs("maintainer", held)
    const started = (try Sandboxes.execute("h", storage, host, "start", "c-1", "op-1", 0, "")) as SandboxSnapshot
    const running = try Effect.forkChild(host.command("c-1", "op-2", "make", started.generation).pipe(Effect.provide(mockPolicy("maintainer"))))
    try Deferred.await(entered)
    const copy = try failed(Effect.provide(host.command("c-1", "op-2", "make", started.generation), mockPolicy("maintainer")))
    try Effect.provide(host.tick(), mockPolicy("maintainer"))
    const during = try pendingIn(storage)
    try Deferred.succeed(release, undefined)
    const output = try Fiber.join(running)
    const end = try pendingIn(storage)
    try Effect.try(() => {
      expect(copy).toBe("Refused:busy")
      expect(during?.operationId).toBe("op-2")
      expect(output).toBe("ran make")
      expect(end).toBeNull()
    })
  }, 60_000)
})
