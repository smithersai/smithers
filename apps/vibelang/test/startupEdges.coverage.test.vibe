// Browser startup's reading of the page: the address's flags, the saved mock or live choice, a finished tour, and
// storage the browser refuses, and the tour journal the page keeps in its own storage. The page's window is the real one; the refusing one is an injected faulty Window.
import { expect, it } from "@effect/vitest"
import { vi } from "vitest"
import { Runtime } from "foldkit"
import { ExperimentalBrowserDocument, ExperimentalBrowserMediaQuery } from "vibelang-runtime/experimental/platform-browser"
import { SecureRandom } from "effect/crypto"
import { main, page } from "../src/web/startup.vibe"
import { heldHealth } from "./support/heldHealth.vibe"
import { clickAsk, container, focusOn, hasAsk, forgetTours, fullLocation, journalKeys, refusingJournal, refusingStorage, remove, send, setLocation, storedJournal, transcript } from "./support/browser.ts"

const KEYS = ["vibelang.agent", "vibelang:toured", "vibelang:tour-sound"]

/** Runs `main` at `address` on the real page, restoring the address and the stored keys after. */
effect function startedAt(address: string, host: typeof page = page) {
  const node = try acquireRelease(sync(container), (node) => sync(() => remove(node)))
  const before = try sync(() => ({ address: fullLocation(), stored: KEYS.map((key) => window.localStorage.getItem(key)) }))
  try addFinalizer(() => sync(() => {
    setLocation(before.address)
    KEYS.forEach((key, index) => { const value = before.stored[index]; if (value === null || value === undefined) window.localStorage.removeItem(key); else window.localStorage.setItem(key, value) })
  }))
  try Effect.try(() => { const root = node.ownerDocument.createElement("div"); root.id = "root"; node.append(root); setLocation(address) })
  const health = try heldHealth()
  return try Effect.provide(main(), Layer.mergeAll(host, health.layer, Layer.succeed(Clock.Clock, health.deadlineClock)))
}

it.live("reads recovery, issues, sign-in and the wiki page from the address", () => scoped(effect {
  const { flags } = try startedAt("/wiki/index?resume-recovery=r1&resume-op=read&resume-key=k1&issues=1&sign-in=failed#usage")
  try Effect.try(() => expect(flags).toMatchObject({ resumeRecovery: "r1", resumeOp: "read", resumeKey: "k1", openIssues: true, signInFailed: true, wiki: "/wiki/index#usage" }))
}))

it.live("an address without them starts plain", () => scoped(effect {
  const { flags } = try startedAt("/")
  try Effect.try(() => {
    expect(flags).toMatchObject({ openIssues: false, signInFailed: false })
    expect(flags).not.toHaveProperty("resumeRecovery")
    expect(flags).not.toHaveProperty("wiki")
  })
}))

it.live("?agent=mock saves the choice, a later plain load keeps it, and ?agent=live clears it", () => scoped(effect {
  try startedAt("/?agent=mock")
  const saved = try sync(() => window.localStorage.getItem("vibelang.agent"))
  try startedAt("/")
  const kept = try sync(() => window.localStorage.getItem("vibelang.agent"))
  try startedAt("/?agent=live")
  const cleared = try sync(() => window.localStorage.getItem("vibelang.agent"))
  try Effect.try(() => { expect(saved).toBe("mock"); expect(kept).toBe("mock"); expect(cleared).toBeNull() })
}))

it.live("a person who finished the tour once is not toured again on load", () => scoped(effect {
  try acquireRelease(sync(() => window.localStorage.setItem("vibelang:toured", "1")), () => sync(() => window.localStorage.removeItem("vibelang:toured")))
  const { flags } = try startedAt("/")
  try Effect.try(() => expect(flags.autoTour).toBe(false))
}))

it.live("storage the browser refuses starts a fresh tour session and the page still loads", () => scoped(effect {
  const refusing = try Effect.try(refusingStorage)
  const style = try Effect.try(() => window.getComputedStyle.bind(window))
  const host = Layer.mergeAll(
    Layer.succeed(Experimental.Window.Window, Experimental.Window.make({ window: () => refusing, computedStyle: style })),
    ExperimentalBrowserDocument.layer, ExperimentalBrowserMediaQuery.layer, SecureRandom.layerWebCrypto,
  )
  const chosen = try startedAt("/?agent=mock", host)
  const plain = try startedAt("/", host)
  try Effect.try(() => {
    for (const { flags } of [chosen, plain]) expect(flags).toMatchObject({ tutorialSession: flags.session, tourSound: false, resumeTour: false, autoTour: true })
  })
}))

/** A first visit in a fresh tab: no journals or tour keys before the test, none left after. */
const cleaned = acquireRelease(sync(forgetTours), () => sync(forgetTours))
/** Runs the started page's application until `done` holds. */
effect function running(address: string, done: () => void, host: typeof page = page) {
  const { application, flags } = try startedAt(address, host)
  try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
  try promise(() => vi.waitFor(done, { timeout: 15_000, interval: 50 }))
  return flags
}
const length = (key: string) => storedJournal(key)?.length ?? 0

it.live("the first visit's tour keeps its journal in the page's storage, and the next load continues it", () => scoped(effect {
  try cleaned
  const first = try scoped(running("/?agent=mock", () => expect(journalKeys()).toHaveLength(1)))
  const key = try sync(() => journalKeys()[0]!)
  const kept = try sync(() => storedJournal(key) ?? [])
  // The next load in this tab joins the same tour conversation and appends to what it read back.
  try running("/?agent=mock", () => expect(length(key)).toBeGreaterThan(kept.length))
  const continued = try sync(() => storedJournal(key) ?? [])
  try Effect.try(() => {
    expect(key).toBe(`vibelang:walkthrough:tour-${first.tutorialSession}`)
    expect(kept.length).toBeGreaterThan(0)
    expect(continued.slice(0, kept.length)).toEqual(kept)
  })
}))

it.live("a stored journal that isn't a journal starts the tour afresh", () => scoped(effect {
  try cleaned
  try scoped(running("/?agent=mock", () => expect(journalKeys()).toHaveLength(1)))
  const key = try sync(() => journalKeys()[0]!)
  try sync(() => window.localStorage.setItem(key, "{not json"))
  try running("/?agent=mock", () => expect(length(key)).toBeGreaterThan(0))
  const fresh = try sync(() => storedJournal(key) ?? [])
  try Effect.try(() => expect(fresh[0]?.seq).toBe(1))
}))

it.live("a tour whose journal the browser refuses keeps going and stores nothing", () => scoped(effect {
  try cleaned
  const { window: refusing, refused } = try Effect.try(refusingJournal)
  const style = try Effect.try(() => window.getComputedStyle.bind(window))
  const host = Layer.mergeAll(
    Layer.succeed(Experimental.Window.Window, Experimental.Window.make({ window: () => refusing, computedStyle: style })),
    ExperimentalBrowserDocument.layer, ExperimentalBrowserMediaQuery.layer, SecureRandom.layerWebCrypto,
  )
  // Each recorded event is one refused write, so several writes mean the tour went on after the first refusal.
  try running("/?agent=mock", () => expect(refused.filter((call) => call === "write").length).toBeGreaterThan(2), host)
  const keys = try Effect.try(() => journalKeys())
  try Effect.try(() => { expect(refused[0]).toBe("read"); expect(keys).toEqual([]) })
}))

it.live("a post to the shared home conversation is never kept in the page's storage", () => scoped(effect {
  try cleaned
  // A person who finished the tour: the page starts without one, so only the home conversation records.
  try sync(() => window.localStorage.setItem("vibelang:toured", "1"))
  try running("/?agent=mock", () => expect(hasAsk()).toBe(true))
  try Effect.try(() => clickAsk())
  try promise(() => vi.waitFor(() => focusOn("#vl-palette-prompt"), { timeout: 15_000, interval: 50 }))
  try Effect.try(() => send("hello"))
  try promise(() => vi.waitFor(() => expect(transcript().map(([, text]) => text)).toEqual(["hello", "done=true"]), { timeout: 15_000, interval: 50 }))
  const keys = try Effect.try(() => journalKeys())
  try Effect.try(() => expect(keys).toEqual([]))
}))
