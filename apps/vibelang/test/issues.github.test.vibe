// @vitest-environment node
// The issues flow as the site runs it after decision 0165, on real GitHub: every read and write goes through
// smithers.sh's per-person connection host (fuzz/delegated.vibe) to codeplanesmithers/smithers-vibelang-e2e, on the
// durable engine over SQLite. Replayed from test/recordings/issues.json unless VIBE_GITHUB says otherwise
// (test/support/github.vibe); a replay needs no token and reaches no network. Unhappy paths stay in
// test/issuesDelegated.coverage.test.vibe as injected faulty services.
import { describe, expect, it } from "@effect/vitest"
import { Base64 } from "effect/encoding"
import { HttpClient } from "effect/http"
import { GitHub } from "@smthrs/integrations"
import { WebCrypto } from "@smthrs/crypto"
import { TestNodeRuntime } from "@smthrs/platform-node"
import type { IssueRecord } from "../src/core/conversation.vibe"
import type { IssueRequest, IssuesState } from "../src/core/issueSchemas.vibe"
import { executeIssues, IssueAuthority, type Repository } from "../worker/Issues.vibe"
import { GitHubDelegate } from "../worker/GitHubDelegate.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { delegated, reach } from "../fuzz/delegated.vibe"
import { github, TEST_ASSIGNEE, TEST_AUTHOR, TEST_REPOSITORY } from "./support/github.vibe"

type State = typeof IssuesState.Type
const repo: Repository = { owner: TEST_REPOSITORY.owner, name: TEST_REPOSITORY.name, api: TEST_REPOSITORY.api, agent: TEST_ASSIGNEE }
const full = `${TEST_REPOSITORY.owner}/${TEST_REPOSITORY.name}`
const blank: IssueRequest = { op: "read", number: 0, parent: 0, title: "", text: "", example: "", prior: "", assignee: "", key: "k" }
const item = (state: State, number: number): IssueRecord => state.items.find((entry) => entry.number === number)!

/** A person connected through smithers.sh to the test repository, on GitHub as `recording` holds it or as it is now. */
effect function world(recording: string) {
  const real = try github(recording)
  const storage = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const site = try delegated(real.client, reach(), TEST_REPOSITORY.owner, { api: TEST_REPOSITORY.api, repository: full, repositoryId: TEST_REPOSITORY.id, token: real.token })
  const authority: IssueAuthority.Shape = {
    current: () => succeed({ id: "7", login: TEST_REPOSITORY.owner, role: "maintainer" as const, connection: site.connection }),
    authorize: () => Effect.void,
  }
  const provided = <A, E, R>(program: A!E!R) => program.pipe(
    Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, site.http),
    Effect.provideService(GitHubDelegate, site.delegate), Effect.provide(WebCrypto.layer),
  )
  let keys = 0
  const act = (op: IssueRequest["op"], extra: Partial<IssueRequest> = {}) => {
    keys += 1
    return provided(executeIssues("issues-recorded", storage as unknown as Storage, { ...blank, op, key: `${real.label}-${keys}`, ...extra }, repo))
  }
  // Cleanup runs through the same recorded client, so a replay replays it too. A closed issue's body is blanked:
  // every read verifies each VIP marker in the repository, so markers left behind would grow every later recording.
  const client = try GitHub.GitHubClient.make({ token: Redacted.value(real.token) }, {}).pipe(Effect.provideService(HttpClient.HttpClient, real.client))
  const made: Array<number> = []
  const reviews: Array<{ number: number; branch: string }> = []
  const cleanup = Effect.suspend(() => Effect.all([
    Effect.forEach(made, (number) => client.request("PATCH", `/repos/${full}/issues/${number}`, { state: "closed", body: "" }) |> ignore(%), { discard: true }),
    Effect.forEach(reviews, (review) => effect {
      try client.request("PATCH", `/repos/${full}/pulls/${review.number}`, { state: "closed" })
      try client.request("DELETE", `/repos/${full}/git/refs/heads/${review.branch}`)
    } |> ignore(%), { discard: true }),
  ], { discard: true }))
  return { label: real.label, act, client, made, reviews, cleanup }
}

describe("issues on real GitHub through smithers.sh's delegation", () => {
  it.live("a person's issue, split, comment and task are GitHub's truth", () => scoped(effect {
    const w = try world("issues")
    try ensuring(effect {
      const created = try w.act("new", { title: `${w.label} parent`, text: "VibeLang issues recorded test." })
      const parent = item(created, created.selected!)
      w.made.push(parent.number)
      expect(parent).toMatchObject({ title: `${w.label} parent`, author: TEST_AUTHOR, parent: 0, state: "open" })

      const split = try w.act("split", { number: parent.number, title: `${w.label} child` })
      const child = item(split, split.selected!)
      w.made.push(child.number)
      expect(child).toMatchObject({ title: `${w.label} child`, parent: parent.number, author: TEST_AUTHOR })

      const commented = try w.act("comment", { number: child.number, text: " A note " })
      expect(item(commented, child.number).notes.filter((note) => !note.event).map((note) => note.text)).toEqual(["A note"])

      const committed = try w.act("commit", { number: child.number, assignee: "VibeLang agent" })
      expect(item(committed, child.number)).toMatchObject({ task: "Queued", assignee: TEST_ASSIGNEE, labels: ["vibelang:task"] })
      const uncommitted = try w.act("uncommit", { number: child.number })
      expect(item(uncommitted, child.number)).toMatchObject({ task: "", assignee: "", labels: [] })

      // A read shows its selected issue as GitHub holds it now; the list itself trails writes by seconds.
      expect(item(try w.act("read", { number: child.number }), child.number)).toMatchObject({ parent: parent.number, task: "" })
    }, w.cleanup)
  }), 180_000)

  it.live("a person's VIP proposal opens its branch, document, review and issue on GitHub", () => scoped(effect {
    const w = try world("issues-proposal")
    try ensuring(effect {
      const proposed = try w.act("propose", { title: `${w.label} tuples`, text: "One feature with an example.", example: "const tuple = [1, 2]", prior: "Rust tuple patterns" })
      const vip = item(proposed, proposed.selected!)
      w.made.push(vip.number)
      expect(vip).toMatchObject({ title: `${w.label} tuples`, vip: "In review", task: "", author: TEST_AUTHOR })
      expect(vip.path).toMatch(/^docs\/design\/vips\/proposal-[0-9a-f]{64}\.md$/)
      const pullNumber = Number(vip.review.split("/").at(-1))
      expect(vip.review).toBe(`https://github.com/${full}/pull/${pullNumber}`)
      const pull = try w.client.request("GET", `/repos/${full}/pulls/${pullNumber}`, undefined, { schema: Schema.Struct({ title: Schema.String, user: Schema.Struct({ login: Schema.String }), head: Schema.Struct({ ref: Schema.String }) }) })
      w.reviews.push({ number: pullNumber, branch: pull.head.ref })
      expect(pull).toMatchObject({ title: `VIP: ${w.label} tuples`, user: { login: TEST_AUTHOR } })
      expect(pull.head.ref).toMatch(/^vibelang\/vip-/)
      const document = try w.client.request("GET", `/repos/${full}/contents/${vip.path}?ref=${encodeURIComponent(pull.head.ref)}`, undefined, { schema: Schema.Struct({ content: Schema.String }) })
      const text = Base64.decodeString(document.content.replace(/\s/g, ""))
      expect(text._tag === "Success" ? text.success : "").toContain("## Example\n\n```vibe\nconst tuple = [1, 2]")
      expect(item(try w.act("read", { number: vip.number }), vip.number)).toMatchObject({ vip: "In review", review: vip.review })
    }, w.cleanup)
  }), 180_000)
})
