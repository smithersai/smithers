// @vitest-environment node
// The issues flow as the site runs it after decision 0165, on real GitHub: every read and write goes through
// smithers.sh's per-person connection host (fuzz/delegated.vibe) to codeplanesmithers/smithers-vibelang-e2e, on the
// durable engine over SQLite (test/support/issuesWorld.vibe). Replayed from test/recordings/issues*.json unless
// VIBE_GITHUB says otherwise (test/support/github.vibe); a replay needs no token and reaches no network. Each case
// writes the state it reads, and puts the repository back. Unhappy paths stay in test/issuesDelegated.coverage.test.vibe
// as injected faulty services.
import { describe, expect, it } from "@effect/vitest"
import { Base64 } from "effect/encoding"
import { emptySpecification } from "../src/core/specification.vibe"
import { GitHub } from "@smthrs/integrations"
import { TEST_ASSIGNEE, TEST_AUTHOR, TEST_REPOSITORY } from "./support/github.vibe"
import { failed, FULL, issuesWorld, item, journey, journeyResult, succeeded } from "./support/issuesWorld.vibe"

schema Opened { readonly number: number }

describe("issues on real GitHub through smithers.sh's delegation", () => {
  it.live("a maintainer's new issue, split, comment, VIP, link, task, acceptance and decline are GitHub's truth", () => scoped(effect {
    const w = try issuesWorld("issues")
    try ensuring(effect {
      const seen = try journey(w)
      expect(seen).toEqual(journeyResult(w.label))
      const { issue, child, vip, second, pull } = seen.ids

      const opened = try w.client.request("GET", `/repos/${FULL}/pulls/${pull}`, undefined, { schema: Schema.Struct({ user: Schema.Struct({ login: Schema.String }), head: Schema.Struct({ ref: Schema.String }) }) })
      expect(opened.user.login).toBe(TEST_AUTHOR)
      const path = item(try succeeded(try w.act("read", { number: vip })), vip).path
      const document = try w.client.request("GET", `/repos/${FULL}/contents/${path}?ref=${encodeURIComponent(opened.head.ref)}`, undefined, { schema: Schema.Struct({ content: Schema.String }) })
      const text = Base64.decodeString(document.content.replace(/\s/g, ""))
      expect(text._tag === "Success" ? text.success : "").toContain("## Example\n\n```vibe\nconst t = [1, 2]")

      // Accepting again keeps the receipt, and a declined, closed VIP declined again: nothing left to write.
      const writes = w.writes()
      expect(item(try succeeded(try w.act("accept", { number: vip })), vip).vip).toBe("Accepted")
      expect(item(try succeeded(try w.act("decline", { number: second })), second)).toMatchObject({ vip: "Declined", state: "closed" })
      expect(w.writes()).toBe(writes)
      // A read shows its selected issue as GitHub holds it now; the list itself trails writes by seconds.
      expect(item(try succeeded(try w.act("read", { number: child })), child)).toMatchObject({ parent: issue, task: "" })
    }, w.cleanup)
  }), 300_000)

  it.live("a read shows each issue's task, verified VIP, parent and notes; refusals write nothing", () => scoped(effect {
    const w = try issuesWorld("issues-read")
    try ensuring(effect {
      // A VIP in review written as the test: its branch, document, review with one comment, and the issue claiming it.
      const main = try w.client.request("GET", `/repos/${FULL}/git/ref/heads/main`, undefined, { schema: Schema.Struct({ object: Schema.Struct({ sha: Schema.String }) }) })
      const branch = `vibelang/vip-${w.label}`
      const path = `docs/design/vips/proposal-${w.label}.md`
      try w.client.request("POST", `/repos/${FULL}/git/refs`, { ref: `refs/heads/${branch}`, sha: main.object.sha })
      const contents = try Effect.try(() => Base64.encode("# A seeded proposal\n"))
      try GitHub.Commits.createOnBranch(TEST_REPOSITORY.owner, TEST_REPOSITORY.name, { branch, expectedHeadOid: main.object.sha, headline: "A seeded proposal", additions: [{ path, contents }], deletions: [] }).pipe(Effect.provideService(GitHub.GitHubClient.GitHubClient, w.client))
      const pull = try w.client.request("POST", `/repos/${FULL}/pulls`, { title: `VIP: ${w.label}`, head: branch, base: "main", body: "Seeded review" }, { schema: Opened })
      w.reviews.push({ number: pull.number, branch })
      try w.client.request("POST", `/repos/${FULL}/pulls/${pull.number}/reviews`, { event: "COMMENT", body: "Reviewed." })
      const review = `https://github.com/${FULL}/pull/${pull.number}`
      const marker = (url: string, at = path) => `<!-- vibelang:vip path=${at} review=${url} -->`
      const inReview = try w.seedIssue("in review", { body: `A reviewed proposal\n\n${marker(review)}` })
      // Body markers are only claims: each of these fails one check and reads as a plain issue.
      const claims = [
        try w.seedIssue("other repository", { body: marker(`https://github.com/other/r/pull/${pull.number}`) }),
        try w.seedIssue("padded number", { body: marker(`https://github.com/${FULL}/pull/0${pull.number}`) }),
        try w.seedIssue("no such review", { body: marker(`https://github.com/${FULL}/pull/999999`) }),
        try w.seedIssue("other document", { body: marker(review, "docs/design/vips/proposal-elsewhere.md") }),
      ]
      try w.bringsLabel("vibelang:running")
      const queued = try w.seedIssue("queued", { labels: ["vibelang:task"], assignees: [TEST_ASSIGNEE] })
      const running = try w.seedIssue("running", { labels: ["vibelang:task", "vibelang:running"], assignees: [TEST_ASSIGNEE] })
      const done = try w.seedIssue("done", { labels: ["vibelang:task"], assignees: [TEST_ASSIGNEE] })
      const child = try w.seedIssue("child")
      try w.client.request("POST", `/repos/${FULL}/issues/${queued.number}/sub_issues`, { sub_issue_id: child.id })
      const plain = try w.seedIssue("plain")
      try w.client.request("POST", `/repos/${FULL}/issues/${plain.number}/comments`, { body: "First note" })

      try w.listed(w.made)
      // Closed once GitHub lists it: its creation's label event is published by then, so the timeline's order is fixed.
      try w.client.request("PATCH", `/repos/${FULL}/issues/${done.number}`, { state: "closed" })
      const proposal = try succeeded(try w.act("read", { number: inReview.number }))
      expect(proposal.absoluteDates).toBe(true)
      expect(proposal.assignees).toEqual([{ login: TEST_ASSIGNEE, label: "VibeLang agent" }])
      expect(item(proposal, inReview.number)).toMatchObject({ vip: "In review", review, path, body: "A reviewed proposal\n\n", author: TEST_AUTHOR })
      // Only the opened issue's review is read.
      expect(proposal.reviewers).toEqual([TEST_AUTHOR])
      expect(claims.map((claim) => item(proposal, claim.number).vip)).toEqual(["", "", "", ""])
      expect([done, running, queued, plain].map((issue) => item(proposal, issue.number).task)).toEqual(["Done", "Running", "Queued", ""])
      expect(item(proposal, running.number).assignee).toBe(TEST_ASSIGNEE)
      expect(item(proposal, child.number).parent).toBe(queued.number)
      expect(item(proposal, plain.number).notes).toEqual([])

      const noted = try succeeded(try w.act("read", { number: plain.number }))
      expect(item(noted, plain.number).notes.filter((note) => !note.event).map(({ author, text }) => ({ author, text }))).toEqual([{ author: TEST_AUTHOR, text: "First note" }])
      expect(noted.reviewers).toEqual([])
      const closed = try succeeded(try w.act("read", { number: done.number }))
      expect(item(closed, done.number).notes.filter((note) => note.event).map((note) => note.text)).toEqual(expect.arrayContaining(["added the vibelang:task label", `assigned ${TEST_ASSIGNEE}`, "closed this issue"]))

      // Every refusal below is decided before a write: GitHub sees none of them.
      expect(failed(try w.act("new", { title: "   " }))).toEqual({ reason: "title", unwritten: true })
      expect(failed(try w.act("split", { number: 999999, title: "Orphan" }))?.reason).toBe("missing")
      expect(failed(try w.act("comment", { number: plain.number, text: "  " }))).toEqual({ reason: "empty", unwritten: true })
      expect(failed(try w.act("comment", { number: 999999, text: "Hi" }))?.reason).toBe("missing")
      expect(failed(try w.act("link", { number: queued.number, parent: queued.number }))).toEqual({ reason: "tree", unwritten: true })
      expect(item(try succeeded(try w.act("link", { number: child.number, parent: queued.number })), child.number).parent).toBe(queued.number)
      expect(failed(try w.act("commit", { number: done.number, assignee: TEST_ASSIGNEE }))).toEqual({ reason: "closed", unwritten: true })
      expect(failed(try w.act("commit", { number: queued.number, assignee: "ghost" }))).toEqual({ reason: "assignee", unwritten: true })
      expect(failed(try w.act("commit", { number: queued.number, assignee: " " }))?.reason).toBe("assignee")
      expect(failed(try w.act("accept", { number: plain.number }))).toEqual({ reason: "review", unwritten: true })
      // An agent, or a maintainer GitHub names no one, cannot accept a VIP.
      try Ref.set(w.caller, { role: "maintainer", kind: "agent" })
      expect(failed(try w.act("accept", { number: inReview.number }))?.reason).toBe("forbidden")
      try Ref.set(w.caller, { role: "maintainer", login: "" })
      expect(failed(try w.act("accept", { number: inReview.number }))?.reason).toBe("forbidden")
      try Ref.set(w.caller, { role: "maintainer" })
      expect(w.writes()).toBe(0)

      // An authority with no live operation check still writes as the connected person.
      w.check(false)
      expect(item(try succeeded(try w.act("comment", { number: plain.number, text: "Hi" })), plain.number).comments).toBe(2)
      w.check(true)
      // A reused key with another payload is refused before it writes.
      try succeeded(try w.act("comment", { number: plain.number, text: "Once", key: `${w.label}-reused` }))
      expect(failed(try w.act("comment", { number: plain.number, text: "Twice", key: `${w.label}-reused` }))?.reason).toBe("invalid")
      expect(w.writes()).toBe(2)
      // The durable flow counts reads from the stored revision.
      try promise(() => w.storage.put("issues/revision", 41))
      try succeeded(try w.act("read"))
      expect(try promise(() => w.storage.get("issues/revision"))).toBe(42)
      try promise(() => w.storage.put("issues/revision", "lost"))
      try succeeded(try w.act("read"))
      expect(try promise(() => w.storage.get("issues/revision"))).toBe(1)
      // Gate state saved before the specification existed reads with an empty one.
      try promise(() => w.storage.put("gates/state", { seq: 3, items: [] }))
      const older = try succeeded(try w.act("read"))
      expect(older.specification).toEqual(emptySpecification)
      expect(older.seq).toBe(4)
    }, w.cleanup)
  }), 300_000)
})
