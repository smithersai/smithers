import { describe, expect, it } from "@effect/vitest"
import { agentRefused, issueModelInvocable, issueOperationIndex, issueOperations, keyedOperation, operationTier, readDeadline, wikiModelInvocable, wikiOperationIndex, wikiOperations } from "../src/core/flowPolicyDecision.vibe"
import { issueFlow } from "../src/core/issueFlows.vibe"
import { wikiEditFlow } from "../src/core/wikiFlows.vibe"
import type { IssueOperation, WikiOperation } from "../src/core/conversation.vibe"

const issueOps = ["read", "new", "comment", "link", "split", "commit", "uncommit", "propose", "accept", "decline", "draft", "spec-revise", "spec-review"]
const wikiOps = ["read", "save", "propose", "draft"]

describe("issue and wiki flow policies", () => {
  it("seals reads and drafts and keys every other operation", () => {
    expect(issueOps.filter((op) => operationTier(op) === "sealed")).toEqual(["read", "draft"])
    expect(wikiOps.filter((op) => operationTier(op) === "irreversible")).toEqual(["save", "propose"])
    expect(issueOps.filter(keyedOperation)).toEqual(["new", "comment", "link", "split", "commit", "uncommit", "propose", "accept", "decline", "spec-revise", "spec-review"])
    expect(wikiOps.filter(keyedOperation)).toEqual(["save", "propose"])
  })
  it("never offers the agent a VIP decision", () => {
    expect(issueOps.filter((op) => !issueModelInvocable(op))).toEqual(["accept", "decline"])
  })
  it("refuses an agent's accept and decline only", () => {
    expect([agentRefused("accept", "agent"), agentRefused("decline", "agent"), agentRefused("comment", "agent"), agentRefused("accept", "person")]).toEqual([true, true, false, false])
  })
  it("offers the agent only wiki reads and drafts", () => {
    expect(wikiOps.filter(wikiModelInvocable)).toEqual(["read", "draft"])
  })
  it("bounds only reads by a deadline", () => {
    expect([...issueOps, ...wikiOps].filter(readDeadline)).toEqual(["read", "read"])
  })
  it("lists every operation once and finds each one's own flow", () => {
    expect(issueOperations()).toEqual(issueOps)
    expect(wikiOperations()).toEqual(wikiOps)
    for (const op of issueOps as ReadonlyArray<IssueOperation>) {
      expect(issueOperations()[issueOperationIndex(op)]).toBe(op)
      expect(issueFlow(op)._tag).toBe(`vibelang/issues/${op}`)
    }
    for (const op of wikiOps as ReadonlyArray<WikiOperation>) {
      expect(wikiOperations()[wikiOperationIndex(op)]).toBe(op)
      expect(wikiEditFlow(op)._tag).toBe(`vibelang/wiki/${op}`)
    }
  })
})
