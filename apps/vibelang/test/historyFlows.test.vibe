// The mythical history's flows through the `Mythical` service, on the mock (wiki/decisions/0020-mythical-history.md):
// the same declarations, sequencer and machine as live, on the in-memory engine. Who may do what, how a task walks
// from planned to landed, and what folds where.
import { describe, expect, it } from "@effect/vitest"
import { landedSha, MockMythical } from "../src/history/MockMythical.vibe"
import type { Event, History } from "../src/history/mythical.vibe"
import { Mythical, Refused, Unavailable } from "../src/history/MythicalHistory.vibe"
import type { Principal, Role } from "../src/history/roles.vibe"
import { intentsOf, replay, seedOf } from "../src/history/seed.vibe"

/** A small bootstrapped history: The compiler (m1 "one", m2 "three"), then Docs (m3 "two"), all landed. */
function small(): History {
  const commits = ["fix(compiler): one", "docs: two", "fix(compiler): three"].map((description, index) => ({
    sha: `${index + 1}`.padStart(12, "0"),
    change: "",
    description,
    parents: index === 0 ? [] : [`${index}`.padStart(12, "0")],
  }))
  return replay(intentsOf(seedOf("o/r", commits, []))).history
}

function as(role: Role, agent = false): Principal {
  return { role, name: "Ada", agent }
}

/** Runs `body` against a mock history for `principal`, bootstrapped from `small()`. */
function withHistory<A, E>(principal: Principal, body: A!E!Mythical) {
  return Effect.provide(body, MockMythical(principal, () => Effect.succeed(small())))
}

effect function refusalOf<A>(write: A!(Refused | Unavailable)) {
  return Effect.map(write, () => "") catch (error) => error._tag === "Refused" ? error.refusal : error._tag
}

/** The ids of the stack in order. */
function stack(history: History): ReadonlyArray<string> {
  const order = new Map(history.epics.map((epic, index) => [epic.id, index]))
  return [...history.commits].sort((a, b) => (order.get(a.epic)! - order.get(b.epic)!) || a.rank - b.rank).map((commit) => commit.id)
}

describe("the bootstrap", () => {
  it.effect("loads the bootstrapped history once, as the first start", () => withHistory(as("viewer"), effect {
    const history = try (try Mythical).read()
    try Effect.try(() => {
      expect(history).toEqual(small())
      expect(stack(history)).toEqual(["m1", "m2", "m3"])
    })
  }))
})

describe("planning", () => {
  it.effect("appends to an epic's end, or to a new epic at the stack's end", () => withHistory(as("contributor"), effect {
    const mythical = try Mythical
    const appended = try mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "fix(compiler): four", task: "t1" })
    const opened = try mythical.plan({ how: "append", epic: "", newEpic: "Sandboxes", target: "", title: "feat(sandbox): start", task: "t2" })
    const history = try mythical.read()
    try Effect.try(() => {
      expect([appended, opened]).toEqual(["m4", "m5"])
      expect(stack(history)).toEqual(["m1", "m2", "m4", "m3", "m5"])
      expect(history.epics.map((epic) => epic.title)).toEqual(["The compiler", "Docs, guides and the site", "Sandboxes"])
      expect(history.commits.find((commit) => commit.id === "m4")).toMatchObject({ state: "planned", task: "t1", epic: "e1" })
    })
  }))

  it.effect("lets only a maintainer insert or amend; a contributor's retelling is forbidden and changes nothing", () => effect {
    const insert = { how: "insert" as const, epic: "", newEpic: "", target: "m2", title: "fix(compiler): before three", task: "t" }
    const amend = { how: "amend" as const, epic: "", newEpic: "", target: "m1", title: "", task: "t9" }
    const contributor = try withHistory(as("contributor"), effect {
      const mythical = try Mythical
      return { insert: try refusalOf(mythical.plan(insert)), amend: try refusalOf(mythical.plan(amend)), history: try mythical.read() }
    })
    const maintainer = try withHistory(as("maintainer"), effect {
      const mythical = try Mythical
      const id = try mythical.plan(insert)
      try mythical.plan(amend)
      return { id, history: try mythical.read() }
    })
    try Effect.try(() => {
      expect(contributor).toEqual({ insert: "forbidden", amend: "forbidden", history: small() })
      expect(maintainer.id).toBe("m4")
      expect(stack(maintainer.history)).toEqual(["m1", "m4", "m2", "m3"])
      expect(maintainer.history.commits.find((commit) => commit.id === "m1")).toMatchObject({ state: "planned", task: "t9" })
    })
  })

  it.effect("refuses a viewer every write, and the sequencer's refusals arrive typed", () => effect {
    const viewer = try withHistory(as("viewer"), effect {
      const mythical = try Mythical
      return [
        try refusalOf(mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "x", task: "" })),
        try refusalOf(mythical.start("m1", "lane")),
        try refusalOf(mythical.note("m1", "tried", "x")),
        try refusalOf(mythical.approve("m1")),
        try refusalOf(mythical.fold()),
      ]
    })
    const refusals = try withHistory(as("maintainer"), effect {
      const mythical = try Mythical
      return [
        try refusalOf(mythical.plan({ how: "append", epic: "e9", newEpic: "", target: "", title: "x", task: "" })),
        try refusalOf(mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "  ", task: "" })),
        try refusalOf(mythical.start("m1", "lane")),
        try refusalOf(mythical.note("m9", "tried", "x")),
      ]
    })
    try Effect.try(() => {
      expect(viewer).toEqual(["forbidden", "forbidden", "forbidden", "forbidden", "forbidden"])
      expect(refusals).toEqual(["unknown", "empty", "state", "unknown"])
    })
  })
})

describe("a task from planned to landed", () => {
  it.effect("is worked, noted, approved by a person, landed by the queue and folded into its own commit", () => withHistory(as("maintainer"), effect {
    const mythical = try Mythical
    const id = try mythical.plan({ how: "append", epic: "e2", newEpic: "", target: "", title: "docs: four", task: "t4" })
    try mythical.start(id, "lane-a")
    try mythical.note(id, "tried", "A table first; too wide on phones.")
    const before = try mythical.fold()
    try mythical.approve(id)
    const folded = try mythical.fold()
    const again = try mythical.fold()
    const history = try mythical.read()
    const commit = history.commits.find((each) => each.id === id)!
    try Effect.try(() => {
      expect([before, folded, again]).toEqual([0, 1, 0])
      expect(commit).toMatchObject({ state: "landed", task: "", lane: "" })
      expect(commit.notes).toEqual([
        { section: "tried", text: "A table first; too wide on phones.", by: "Ada" },
        { section: "evidence", text: "approved", by: "Ada" },
      ])
      expect(history.real[history.real.length - 1]).toMatchObject({ sha: landedSha(id), mythical: id })
      expect(history.main).toBe(landedSha(id))
    })
  }))

  it.effect("lets the agent plan, start and note for its person, never approve or fold", () => withHistory(as("maintainer", true), effect {
    const mythical = try Mythical
    const id = try mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "fix(compiler): agent's", task: "t" })
    try mythical.start(id, "lane-b")
    try mythical.note(id, "evidence", "Tests: 3 passed")
    const approve = try refusalOf(mythical.approve(id))
    const fold = try refusalOf(mythical.fold())
    const history = try mythical.read()
    try Effect.try(() => {
      expect([approve, fold]).toEqual(["forbidden", "forbidden"])
      expect(history.commits.find((each) => each.id === id)).toMatchObject({ state: "working" })
      expect(history.commits.find((each) => each.id === id)!.notes).toEqual([{ section: "evidence", text: "Tests: 3 passed", by: "Ada (agent)" }])
    })
  }))
})

describe("following", () => {
  it.effect("replays the events after a cursor, then each new one", () => withHistory(as("contributor"), effect {
    const mythical = try Mythical
    const seq = (try mythical.read()).seq
    const seen = try Effect.forkChild(Stream.runCollect(Stream.take(mythical.events(seq), 2)))
    try mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "fix(compiler): four", task: "" })
    try mythical.start("m4", "lane")
    const events: ReadonlyArray<Event> = try Fiber.join(seen)
    try Effect.try(() => expect(events.map((event) => [event.type, event.seq])).toEqual([["Planned", seq + 1], ["Started", seq + 2]]))
  }))
})
