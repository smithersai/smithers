// @vitest-environment node
// Literal source ranges for the browser gate's structure (e2e/coverage-reporter.ts `measure` with a build).
import { it, expect } from "@effect/vitest"
import { builtStructure, emittedPositions } from "./support/coverageUnion.ts"

const file = "/app/e2e/coverage-fixtures/initializer.vibe"
const range = (line: number, start: number, endLine: number, end: number) => ({ start: { line, column: start }, end: { line: endLine, column: end } })
const empty = { path: file, statementMap: {}, fnMap: {}, branchMap: {}, s: {}, f: {}, b: {} }
const starts = (ranges: Readonly<Record<string, { readonly start: { readonly line: number; readonly column: number | null } }>>) =>
  Object.values(ranges).map(loc => `${loc.start.line}:${loc.start.column}`)

// The compiler starts `const next = (serial ?? 0) + 1` at `(`; Rolldown's map has no segment there, so the bundle starts
// it at `next`. `dropped` (line 10) is tree-shaken from the bundle.
// A multi-line initializer starts on line 5 in the compiler's map and at its name on line 4 in the bundle's.
const compiler = {
  ...empty,
  statementMap: { "0": range(4, 15, 4, 32), "1": range(10, 2, 10, 11), "2": range(6, 4, 7, 9) }, s: { "0": 0, "1": 0, "2": 0 },
  fnMap: { "0": { name: "make", decl: range(2, 16, 2, 24), loc: range(2, 24, 6, 1) }, "1": { name: "dropped", decl: range(9, 16, 9, 23), loc: range(9, 26, 11, 1) } },
  f: { "0": 0, "1": 0 },
}
// Rolldown renames a colliding inner function `make_2`; both map to the compiler's one function start.
const bundle = {
  ...empty,
  statementMap: { "0": range(4, 8, 4, 32), "1": range(5, 8, 7, 9) }, s: { "0": 0, "1": 0 },
  fnMap: { "0": { name: "make", decl: range(2, 16, 2, 24), loc: range(2, 24, 6, 1) }, "1": { name: "make_2", decl: range(2, 16, 2, 24), loc: range(2, 24, 6, 1) } },
  f: { "0": 0, "1": 0 },
}

it("the build replaces corresponding shifted initializers and keeps tree-shaken code", () => {
  const json = builtStructure(compiler, bundle)
  expect(starts(json.statementMap)).toEqual(["4:8", "5:8", "10:2"])
  expect(Object.values(json.fnMap).map(fn => fn.name)).toEqual(["make", "dropped"])
})

it("the build's structure counts one item per source start, as the gate credits it", () => {
  const json = builtStructure(compiler, bundle)
  expect(Object.keys(json.f)).toHaveLength(2)
  expect(starts(Object.fromEntries(Object.entries(json.fnMap).map(([id, fn]) => [id, fn.loc!])))).toEqual(["2:24", "9:26"])
})

it.each([0, 7, 30])("keeps nested tree-shaken obligations at line offset %i", (offset) => {
  const at = (line: number, column: number, endLine: number, end: number) => range(line + offset, column, endLine + offset, end)
  const retained = { name: "result", decl: at(1, 16, 1, 22), loc: at(1, 25, 5, 1) }
  const nested = { name: "unused", decl: at(2, 8, 2, 14), loc: at(2, 23, 2, 24) }
  const full = {
    ...empty,
    statementMap: { "0": at(2, 17, 2, 24), "1": at(2, 23, 2, 24), "2": at(3, 17, 3, 29), "3": at(4, 2, 4, 10) },
    s: { "0": 0, "1": 0, "2": 0, "3": 0 },
    fnMap: { "0": retained, "1": nested }, f: { "0": 0, "1": 0 },
    branchMap: { "0": { loc: at(3, 17, 3, 29), type: "cond-expr", locations: [at(3, 24, 3, 25), at(3, 28, 3, 29)] } }, b: { "0": [0, 0] },
  }
  const shipped = {
    ...empty,
    statementMap: { "0": at(4, 2, 4, 10) }, s: { "0": 1 },
    fnMap: { "0": retained }, f: { "0": 1 },
  }
  const json = builtStructure(full, shipped)
  expect(Object.values(json.fnMap).map(fn => fn.name)).toEqual(["result", "unused"])
  expect(starts(json.statementMap)).toEqual([4 + offset + ":2", 2 + offset + ":17", 2 + offset + ":23", 3 + offset + ":17"])
  expect(Object.values(json.f)).toEqual([1, 0])
  expect(Object.values(json.s)).toEqual([1, 0, 0, 0])
  expect(Object.values(json.b)).toEqual([[0, 0]])
})

it("a shifted declaration replaces only its initializer, not a removed arrow body sharing its end", () => {
  const declaration = range(2, 8, 2, 35)
  const initializer = range(2, 17, 2, 35)
  const inner = range(2, 30, 2, 35)
  const json = builtStructure({
    ...empty,
    statementMap: { "0": initializer, "1": inner }, s: { "0": 0, "1": 0 },
    fnMap: { "0": { name: "unused", decl: range(2, 17, 2, 20), loc: inner } }, f: { "0": 0 },
  }, {
    ...empty,
    statementMap: { "0": declaration }, s: { "0": 1 },
  })
  expect(starts(json.statementMap)).toEqual(["2:8", "2:30"])
  expect(Object.values(json.s)).toEqual([1, 0])
  expect(Object.values(json.f)).toEqual([0])
})

it("a bundle statement starting after its compiler counterpart replaces only that statement", () => {
  const json = builtStructure({
    ...empty,
    statementMap: { "0": range(2, 8, 2, 30), "1": range(2, 12, 2, 20) }, s: { "0": 0, "1": 0 },
  }, {
    ...empty,
    statementMap: { "0": range(2, 10, 2, 30) }, s: { "0": 1 },
  })
  expect(starts(json.statementMap)).toEqual(["2:10", "2:12"])
  expect(Object.values(json.s)).toEqual([1, 0])
})

it("duplicate bundled starts share one replacement and retain unmatched nested statements", () => {
  const shipped = range(1, 5, 1, 40)
  const json = builtStructure({
    ...empty,
    statementMap: { "0": range(1, 10, 1, 40), "1": range(1, 20, 1, 40) }, s: { "0": 0, "1": 0 },
  }, {
    ...empty,
    statementMap: { "0": shipped, "1": shipped }, s: { "0": 1, "1": 1 },
  })
  expect(starts(json.statementMap)).toEqual(["1:5", "1:20"])
  expect(Object.values(json.s)).toEqual([1, 0])
})

// Rolldown's minified map starts a branch's later arm elsewhere than the compiler's map does: a ternary's second arm at
// its first arm's start, an if/else printed as an `if` with no else. The bundle's branch, which Chromium's ranges
// credit, replaces the compiler's; keeping both left the compiler's copy open forever (17 such branches in 12 files
// of the browser gate, 2026-11-13: sandboxDecision.replaceSandbox's `if`, MockAccounts' `??`).
it("the build's branch replaces the compiler's branch of the same kind, start and arm count", () => {
  const json = builtStructure({
    ...empty,
    branchMap: {
      "0": { loc: range(3, 9, 3, 65), type: "cond-expr", locations: [range(3, 24, 3, 25), range(3, 28, 3, 65)] },
      "1": { loc: range(5, 2, 9, 3), type: "if", locations: [range(5, 2, 9, 3), range(7, 9, 9, 3)] },
      "2": { loc: range(11, 4, 11, 20), type: "binary-expr", locations: [range(11, 4, 11, 8), range(11, 12, 11, 20)] },
    },
    b: { "0": [0, 0], "1": [0, 0], "2": [0, 0] },
  }, {
    ...empty,
    branchMap: {
      "0": { loc: range(3, 9, 3, 65), type: "cond-expr", locations: [range(3, 24, 3, 29), range(3, 24, 3, 65)] },
      "1": { loc: range(5, 2, 6, 26), type: "if", locations: [range(5, 2, 6, 26), { start: {}, end: {} }] },
    },
    b: { "0": [1, 1], "1": [1, 0] },
  })
  expect(Object.values(json.branchMap).map(branch => `${branch.type}@${branch.loc.start.line}:${branch.loc.start.column}`)).toEqual(["cond-expr@3:9", "if@5:2", "binary-expr@11:4"])
  expect(Object.values(json.b)).toEqual([[1, 1], [1, 0], [0, 0]])
})

it("decodes the source positions a map's segments name, per source", () => {
  // Rows are generated lines; fields are relative. `IAAI` moves 4 generated and 4 original columns, `ACAA` moves to
  // source 1, `AAAAA` names a symbol, and a 1-field segment maps nothing.
  const positions = emittedPositions("AAAA;AACA,IAAI,ACAA,AAAAA,E;;AAEA")
  expect([...positions.entries()]).toEqual([[0, [[1, 0], [2, 0], [2, 4]]], [1, [[2, 4], [2, 4], [4, 4]]]])
  expect(emittedPositions("gBAAgB").get(0)).toEqual([[1, 16]])
  expect(() => emittedPositions("A!AA")).toThrow("not base64")
})

// `const element = event.target; const link = element?.closest?.("a"); return link?.id ?? "none"`: Rolldown prints
// `return event.target?.closest?.("a")?.id ?? "none"`, with segments at both inlined initializers.
it("a statement the bundle inlines into another is no obligation; tree-shaken code still is", () => {
  const compiler = {
    ...empty,
    statementMap: { "0": range(2, 18, 2, 30), "1": range(3, 15, 3, 37), "2": range(4, 2, 4, 28), "3": range(5, 17, 5, 29), "4": range(6, 26, 6, 30) },
    s: { "0": 0, "1": 0, "2": 0, "3": 0, "4": 0 },
    fnMap: { "0": { name: "linked", decl: range(1, 16, 1, 22), loc: range(1, 30, 7, 1) }, "1": { name: "unused", decl: range(6, 8, 6, 14), loc: range(6, 26, 6, 30) } },
    f: { "0": 0, "1": 0 },
  }
  const bundle = { ...empty, statementMap: { "0": range(4, 2, 4, 28) }, s: { "0": 0 }, fnMap: { "0": compiler.fnMap["0"] }, f: { "0": 0 } }
  // Segments at the inlined `event.target` and `?.closest?.("a")`, the return, and inside the removed `unused`; none
  // in the tree-shaken `5:17` statement.
  const emitted = [[4, 2], [4, 9], [2, 18], [2, 24], [3, 22], [6, 27]] as const
  expect(starts(builtStructure(compiler, bundle, emitted).statementMap)).toEqual(["4:2", "5:17", "6:26"])
  // Without the map's positions, nothing tells inlined code from tree-shaken code: both stay obligations.
  expect(starts(builtStructure(compiler, bundle).statementMap)).toEqual(["4:2", "2:18", "3:15", "5:17", "6:26"])
  // A segment exactly at a statement's end belongs to what follows it.
  expect(starts(builtStructure(compiler, bundle, [[5, 29]]).statementMap)).toContain("5:17")
})

// `if (role !== undefined) try choose(role)`: the bundle ships the `if` as one statement, so the consequent's code is
// emitted, but the `if` ran whether or not its consequent did.
it("a statement nested in a shipped statement of its own function stays an obligation", () => {
  const consequent = range(3, 30, 3, 48)
  const compiler = { ...empty, statementMap: { "0": range(3, 4, 3, 48), "1": consequent }, s: { "0": 0, "1": 0 } }
  const outer = { name: "make", decl: range(1, 9, 1, 13), loc: range(1, 16, 9, 1) }
  const inner = { name: "handler", decl: range(2, 2, 2, 9), loc: range(2, 12, 5, 3) }
  const bundle = { ...empty, statementMap: { "0": range(1, 0, 9, 1), "1": range(3, 4, 3, 48) }, s: { "0": 0, "1": 0 }, fnMap: { "0": outer, "1": inner }, f: { "0": 0, "1": 0 } }
  expect(starts(builtStructure(compiler, bundle, [[3, 4], [3, 30], [3, 40]]).statementMap)).toEqual(["1:0", "3:4", "3:30"])
  // A statement enclosing the whole function (an exported `const` holding it) is outside that function: it does not count.
  const inlined = { ...compiler, statementMap: { "0": range(4, 4, 4, 20) }, s: { "0": 0 } }
  expect(starts(builtStructure(inlined, bundle, [[4, 10]]).statementMap)).toEqual(["1:0", "3:4"])
})
