import { WALKTHROUGH } from "../src/core/walkthroughSteps.vibe"
// The live Factory end to end in local workerd (wiki/decisions/0010-live-agent.md, 0008-testing.md): Miniflare runs
// the API Worker's Durable Objects over the real sequencer, the real `vibelang/Reply` flow on the engine in each
// conversation's own SQLite, and the real HTTP protocol (test/workerd/worker.vibe), and `LiveFactory` talks to it over
// HTTP from this process, as the CLI and the browser do. No model is scripted: without a key the agent's real
// configuration has no model, so every reply fails saying so, and a spent budget refuses before any model call. The
// opt-in case asks the real model when `CEREBRAS_API_KEY` is set. Run with `pnpm test:workerd`.
import { describe, expect, it } from "@effect/vitest"
import { FetchHttpClient, HttpClient, HttpClientResponse } from "effect/http"
import { afterAll, beforeAll } from "vitest"
import { apply, empty, type Event } from "../src/core/conversation.vibe"
import { ConversationRead, Factory } from "../src/core/Factory.vibe"
import { health, LiveFactory } from "../src/core/LiveFactory.vibe"
import { LiveRead } from "../src/core/LiveRead.vibe"
import { AgentBackend, BrowserFactory } from "../src/web/backend.vibe"
import { dayOf, REASONS } from "../worker/Reply.vibe"
import { deadline, modelKey, room, serveApi, type Served } from "./support/workerd.vibe"

/** The live Factory at `origin`, over this process's fetch. */
function live(origin: string) {
  return Layer.merge(LiveFactory(origin), LiveRead(origin)).pipe(Layer.provide(FetchHttpClient.layer))
}

/** What `origin`'s `/api/health` says, over this process's fetch. */
effect function healthOf(origin: string) {
  provide FetchHttpClient.layer {
    return try health(origin)
  }
}

/** The runs of `conversation`'s engine, oldest first, from the test host's window into its SQLite. */
effect function runsOf(origin: string, conversation: string) {
  provide FetchHttpClient.layer {
    const response = try HttpClient.get(`${origin}/runs/${encodeURIComponent(conversation)}`)
    return try HttpClientResponse.schemaBodyJson(Schema.Array(Run))(response)
  }
}

schema Run { readonly run_id: string; readonly status: string }

/** Every event of `conversation` after `after`, up to the one that settles its `replies`-th reply. */
effect function untilSettled(conversation: string, replies: number, after = 0) {
  const factory = try Factory
  let settled = 0
  const events = try Stream.runCollect(
    factory.events(conversation, after) |> Stream.takeUntil(%, (event: Event) =>
      (event.type === "ReplyFinished" || event.type === "ReplyFailed") && ++settled === replies),
  )
  return Array.from(events)
}

describe("the live Factory in local workerd, with no model key", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi()) }, deadline(120_000))
  afterAll(async () => { await api?.dispose() })

  it.live("says it is live, and a post's reply runs as a durable flow that fails, saying the agent has no model", () => effect {
    const origin = api!.origin
    const answer = try healthOf(origin)
    provide live(origin) {
      const factory = try Factory
      const conversation = try room("unconfigured")
      try factory.post(conversation, "a", "Ada", "  How do services work?  ")
      const events = try untilSettled(conversation, 1)
      const snapshot = try (try ConversationRead).read(conversation, 0)
      try Effect.try(() => {
        expect(answer).toEqual({ ok: true, agent: "live" })
        expect(factory.mode).toBe("live")
        expect(events).toEqual([
          { type: "Posted", seq: 1, id: "m1", clientId: "a", name: "Guest", text: "How do services work?" },
          { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" },
          { type: "ReplyFailed", seq: 3, id: "r1", reason: REASONS.unconfigured },
        ])
        expect(snapshot).toEqual({ seq: 3, entries: events.reduce(apply, empty).entries })
      })
    }
  })

  it.live("the browser selects the real live backend and delegates post and events to it", () => effect {
    provide BrowserFactory(api!.origin, false).pipe(Layer.provide(FetchHttpClient.layer)) {
      const factory = try Factory
      const backend = try AgentBackend
      const mode = try backend.ready
      const conversation = try room("browser-startup")
      try factory.post(conversation, "startup", "Guest", "How do services work?")
      const events = try untilSettled(conversation, 1)
      try Effect.try(() => {
        expect(mode).toBe("live")
        expect(factory.mode).toBe("live")
        expect(events[0]).toMatchObject({ type: "Posted", clientId: "startup" })
        expect(events.at(-1)).toMatchObject({ type: "ReplyFailed", reason: REASONS.unconfigured })
      })
    }
  })

  it.live("runs every post as a vibelang/Post flow in the conversation's engine, refused ones included", () => effect {
    const origin = api!.origin
    provide live(origin) {
      const factory = try Factory
      const conversation = try room("post-flows")
      try factory.post(conversation, "a", "Ada", "first")
      const refused = factory.post(conversation, "a", "Ada", "again") catch (error) => error._tag === "Refused" ? error.refusal : error.reason
      try untilSettled(conversation, 1)
      const runs = try runsOf(origin, conversation)
      const posts = runs.filter((run) => run.run_id.startsWith("post/"))
      try Effect.try(() => {
        expect(refused).toBe("duplicate")
        expect(posts.map((run) => run.status)).toEqual(["completed", "completed"])
        expect(runs.map((run) => run.run_id)).toContain("reply/m1")
      })
    }
  })

  it.live("answers posts one at a time in order, two followers see the same events, and a cursor resumes", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("queue")
      try factory.post(conversation, "a", "Ada", "first")
      try factory.post(conversation, "b", "Grace", "second")
      const [first, second] = try.all [untilSettled(conversation, 2), untilSettled(conversation, 2)]
      const resumed = try untilSettled(conversation, 1, 3)
      try Effect.try(() => {
        expect(first).toEqual(second)
        expect(first.map((event) => event.seq)).toEqual(first.map((_, index) => index + 1))
        const state = first.reduce(apply, empty)
        const posts = state.entries.filter((entry) => entry.author === "person").map((entry) => entry.id)
        const replies = state.entries.filter((entry) => entry.author === "agent")
        expect(state.entries.filter((entry) => entry.author === "person").map((entry) => entry.text)).toEqual(["first", "second"])
        expect(replies.map((reply) => [reply.inReplyTo, reply.error])).toEqual(posts.map((post) => [post, REASONS.unconfigured]))
        // The second reply starts only after the first settles.
        const settledFirst = first.findIndex((event) => event.type === "ReplyFailed")
        const startedSecond = first.findIndex((event) => event.type === "ReplyStarted" && event.inReplyTo === posts[1])
        expect(settledFirst).toBeLessThan(startedSecond)
        expect(state.agent).toBe("failed")
        expect(resumed.map((event) => event.seq)).toEqual(first.filter((event) => event.seq > 3).map((event) => event.seq))
      })
    }
  })

  it.live("runs the exact walkthrough without a model, finishes by seek and then answers a post", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("tour-unconfigured")
      try factory.tour(conversation)
      const driven = Array.from(try Stream.runCollect(factory.events(conversation, 0).pipe(Stream.takeUntil(event => event.type === "ReplyDelta"))))
      try factory.controlTour!(conversation, "seek", 11)
      const toured = try untilSettled(conversation, 1)
      try factory.post(conversation, "a", "Ada", "hi")
      const events = try untilSettled(conversation, 2)
      try Effect.try(() => {
        expect(driven.some(event => event.type === "WalkthroughDriven" && event.target === "splash")).toBe(true)
        expect(toured.at(-1)?.type).toBe("ReplyFinished")
        expect(events.at(-1)).toMatchObject({ type: "ReplyFailed", reason: REASONS.unconfigured })
      })
    }
  })

  it.live("Escape during a reading timer's suspension transition wakes the parked tour immediately", () => effect {
    const origin = api!.origin
    const conversation = try room("tour-park-boundary")
    provide live(origin), FetchHttpClient.layer {
      const call = effect (path: string) => {
        const response = try HttpClient.get(`${origin}/${path}/${encodeURIComponent(conversation)}`)
        return try HttpClientResponse.schemaBodyJson(Schema.Unknown)(response)
      }
      try call("reading-tour")
      try Effect.repeat(call("parked"), { until: (value) => value === true, schedule: Schedule.spaced("10 millis") })
      const factory = try Factory
      // The flow body has requested suspension, but its held finalizer keeps the run row Running.
      const before = try runsOf(origin, conversation)
      try Effect.try(() => expect(before.find((run) => run.run_id === "tour/t1")?.status).toBe("running"))
      try factory.endTour(conversation)
      try call("release-park")
      const completed = runsOf(origin, conversation).pipe(
        Effect.repeat({ until: (runs) => runs.find((run) => run.run_id === "tour/t1")?.status === "completed", schedule: Schedule.spaced("10 millis") }),
        timeout("2 seconds"),
      )
      try completed
      const snapshot = try (try ConversationRead).read(conversation, 0)
      try Effect.try(() => {
        expect(snapshot.entries[0]).toMatchObject({ done: true })
        expect(snapshot.entries[0]!.text).toBe(WALKTHROUGH[0]!.subtitle)
      })
    }
  }, deadline(30_000))

  it.live("refuses blank, repeated and oversized posts with the sequencer's reasons", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("refusals")
      const refusal = effect (clientId: string, text: string) => {
        return factory.post(conversation, clientId, "Ada", text) catch (error) => error._tag === "Refused" ? error.refusal : error.reason
      }
      const blank = try refusal("a", "   ")
      try factory.post(conversation, "b", "Ada", "hi")
      const repeated = try refusal("b", "hi again")
      const long = try refusal("c", "x".repeat(8001))
      try Effect.try(() => {
        expect(blank).toBe("empty")
        expect(repeated).toBe("duplicate")
        expect(long).toBe("too-long")
      })
    }
  })
})

describe("the live Factory in local workerd, with the day's budget spent", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi({ CHAT_DAILY_TOKENS: "0", CEREBRAS_API_KEY: "unused-key" })) }, deadline(120_000))
  afterAll(async () => { await api?.dispose() })

  it.live("refuses the reply before any model call, saying the budget is spent", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("budget")
      try factory.post(conversation, "a", "Ada", "hi")
      const events = try untilSettled(conversation, 1)
      try Effect.try(() => {
        expect(events.at(-1)).toEqual({ type: "ReplyFailed", seq: 3, id: "r1", reason: REASONS.budget })
      })
    }
  })
})

// A model nobody answers: a host under `.invalid`, which never resolves (RFC 2606). The reply reaches smithers.sh's agent (its host, its seat and its workerd
// sandbox build), whose model call fails as a real connection fails; no model is scripted.
const UNREACHABLE_MODEL = JSON.stringify({
  protocol: "openai-chat", baseUrl: "https://model.invalid", modelId: "qwen-3.8-27b", credential: "UNANSWERED",
})

/** The unanswered model's key and the one origin it may reach, as @smthrs/model-host reads a custom credential. */
const UNANSWERED = { SMITHERS_MODEL_KEY_UNANSWERED: "unused-key", SMITHERS_MODEL_KEY_UNANSWERED_ORIGIN: "https://model.invalid" }

describe("the live Factory in local workerd, with a model nobody answers", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi({ CHAT_MODEL: UNREACHABLE_MODEL, ...UNANSWERED })) }, deadline(120_000))
  afterAll(async () => { await api?.dispose() })

  it.live("runs the reply on smithers.sh's agent, which fails saying the model is unavailable", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("agent")
      try factory.post(conversation, "a", "Ada", "How do services work?")
      const events = try untilSettled(conversation, 1)
      const runs = try runsOf(api!.origin, conversation)
      try Effect.try(() => {
        expect(events.at(-1)).toEqual({ type: "ReplyFailed", seq: 3, id: "r1", reason: REASONS.unavailable })
        expect(runs.map((run) => run.run_id)).toContain("reply/m1")
      })
    }
  }, deadline(300_000))

  it.live("ending the tour while its agent waits on the model stops the agent's flow, and the next post is answered", () => effect {
    const origin = api!.origin
    provide live(origin) {
      const factory = try Factory
      const conversation = try room("tour-ended")
      try factory.tour(conversation)
      const started = try Stream.runCollect(factory.events(conversation, 0) |> Stream.take(%, 1))
      try factory.endTour(conversation)
      try factory.post(conversation, "a", "Ada", "hi")
      // The ended tour's execution settles, so the post's reply flow can start in the same object.
      const events = Array.from(try Stream.runCollect(
        factory.events(conversation, 0) |> Stream.takeUntil(%, (event: Event) => event.type === "ReplyStarted"),
      ))
      const runs = try runsOf(origin, conversation)
      try Effect.try(() => {
        expect(Array.from(started)).toEqual([{ type: "TourStarted", seq: 1, id: "t1" }])
        const end = events.find((event) => event.type === "TourEnded")!
        const post = events.find((event) => event.type === "Posted")!
        expect(end.id).toBe("t1")
        expect(post).toMatchObject({ clientId: "a", name: "Guest", text: "hi" })
        expect(post.seq).toBeGreaterThan(end.seq)
        expect(events.at(-1)).toMatchObject({ type: "ReplyStarted", inReplyTo: post.id })
        expect(events.at(-1)!.seq).toBeGreaterThan(post.seq)
        expect(events.filter((event) => event.type === "PaneOpened" && event.seq > end.seq)).toEqual([])
        expect(runs.find((run) => run.run_id === "tour/t1")?.status).toBe("completed")
      })
    }
  }, deadline(300_000))
})

/** The day's charge keys in the shared budget object, from the test host's window. */
effect function chargeKeys(origin: string, day: string) {
  provide FetchHttpClient.layer {
    const response = try HttpClient.get(`${origin}/budget/${encodeURIComponent(day)}/ledger`)
    return try HttpClientResponse.schemaBodyJson(Schema.Array(Schema.String))(response)
  }
}

describe("the live Factory in local workerd, two conversations in one day", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi({ CHAT_MODEL: UNREACHABLE_MODEL, ...UNANSWERED })) }, deadline(120_000))
  afterAll(async () => { await api?.dispose() })

  it.live("charges each conversation's first reply under its own key, though both replies are r1", () => effect {
    const origin = api!.origin
    provide live(origin) {
      const factory = try Factory
      const first = try room("budget-one")
      const second = try room("budget-two")
      try factory.post(first, "a", "Ada", "one")
      try factory.post(second, "a", "Ada", "two")
      const settled = try Effect.all([untilSettled(first, 1), untilSettled(second, 1)], { concurrency: "unbounded" })
      const keys = try chargeKeys(origin, dayOf(Date.now()))
      const parents = keys.filter(key => key.endsWith(":r1"))
      try Effect.try(() => {
        expect(settled[0]!.at(-1)).toMatchObject({ type: "ReplyFailed", id: "r1", reason: REASONS.unavailable })
        expect(settled[1]!.at(-1)).toMatchObject({ type: "ReplyFailed", id: "r1", reason: REASONS.unavailable })
        expect(parents).toHaveLength(2)
        // Each unreachable model retries under separate physical receipts;
        // both conversations retain their own parent and child namespace.
        const prefixes = parents.map(key => key.slice(0, -2))
        for (const prefix of prefixes) expect(keys.filter(key => key.startsWith(`${prefix}model/`)).length).toBeGreaterThan(0)
        expect(keys.every(key => parents.includes(key) || prefixes.some(prefix => key.startsWith(`${prefix}model/`)))).toBe(true)
        expect(keys).not.toContain("reply/r1")
      })
    }
  }, deadline(300_000))
})

describe.skipIf(modelKey === undefined)("the live Factory with the real model (opt in: CEREBRAS_API_KEY)", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi({ CEREBRAS_API_KEY: modelKey ?? "" })) }, deadline(120_000))
  afterAll(async () => { await api?.dispose() })

  it.live("streams an answer that finishes with VibeLang in it", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("model")
      try factory.post(conversation, "a", "Ada", "Show me a VibeLang service with one effect method.")
      const events = try untilSettled(conversation, 1)
      const reply = events.reduce(apply, empty).entries[1]!
      try Effect.try(() => {
        expect(events.at(-1)!.type).toBe("ReplyFinished")
        expect(events.some((event) => event.type === "ReplyDelta")).toBe(true)
        expect(reply.text).toContain("service")
      })
    }
  }, deadline(180_000))

  it.live("answers about the mythical history from its tool, vibelang/history/show", () => effect {
    provide live(api!.origin) {
      const factory = try Factory
      const conversation = try room("model-history")
      try factory.post(conversation, "a", "Ada", "Which epics does VibeLang's mythical history have? Read it with your tool.")
      const events = try untilSettled(conversation, 1)
      const reply = events.reduce(apply, empty).entries[1]!
      try Effect.try(() => {
        expect(events.at(-1)!.type).toBe("ReplyFinished")
        // Only the history's outline names its epics; VibeLang's reference doesn't.
        expect(reply.text).toContain("The compiler")
      })
    }
  }, deadline(180_000))


})
