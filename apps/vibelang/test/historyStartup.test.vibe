// Real happy-dom input, the page's actual startup and Foldkit runtime, and the product MockMythical flows; live, the
// real Accounts object and the Worker's history routes on a loopback socket.
import { MockMythical } from "../src/history/MockMythical.vibe"
import { expect, it } from "@effect/vitest"
import { vi } from "vitest"
import * as NodeHttpClient from "@effect/platform-node/NodeHttpClient"
import * as NodeHttpServer from "@effect/platform-node/NodeHttpServer"
import { FetchHttpClient, HttpClient, HttpClientError, HttpClientRequest, HttpServer, HttpServerRequest } from "effect/http"
import { Core, GitHub } from "@smthrs/integrations"
import { Runtime } from "foldkit"
import * as LiveAccounts from "../src/core/LiveAccounts.vibe"
import { historyMain, mockRole } from "../src/web/historyStartup.vibe"
import { page } from "../src/web/startup.vibe"
import { HISTORY_JSON } from "../src/history/seed/vibelang.vibe"
import type { History } from "../src/history/mythical.vibe"
import { intentsOf, replay, seedOf } from "../src/history/seed.vibe"
import * as Accounts from "../worker/Accounts.vibe"
import { handle } from "../worker/Http.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { container, remove } from "./support/browser.ts"
import { heldHealth } from "./support/heldHealth.vibe"
import { histories, unavailableConversations } from "./support/historyHttpHost.vibe"
import { objectStorage } from "./support/objectStorage.ts"

/** An actual window with the page's root; restore this host's URL, storage and styles when it closes. */
effect function host() {
  const node = try acquireRelease(sync(container), (node) => sync(() => remove(node)))
  const window = node.ownerDocument.defaultView!
  const before = try Effect.try(() => ({ url: window.location.href, state: window.history.state, title: node.ownerDocument.title, role: window.localStorage.getItem("vibelang.role"), agent: window.localStorage.getItem("vibelang.agent"), styles: [...node.ownerDocument.head.querySelectorAll("style")] }))
  try Effect.addFinalizer(() => sync(() => {
    window.history.replaceState(before.state, "", before.url)
    node.ownerDocument.title = before.title
    for (const [key, value] of [["vibelang.role", before.role], ["vibelang.agent", before.agent]] as const) {
      if (value === null) window.localStorage.removeItem(key)
      else window.localStorage.setItem(key, value)
    }
    for (const style of node.ownerDocument.head.querySelectorAll("style")) if (!before.styles.includes(style)) style.remove()
  }))
  try sync(() => {
    const root = node.ownerDocument.createElement("div")
    root.id = "root"
    node.append(root)
  })
  return { node, window }
}

/** A faulty Window service over the real host: storage is unavailable; other host operations still use it. */
effect function withoutStorage(window: Window) {
  let reads = 0
  const add = try Effect.try(() => window.addEventListener.bind(window))
  const remove = try Effect.try(() => window.removeEventListener.bind(window))
  const style = try Effect.try(() => window.getComputedStyle.bind(window))
  const current = try Effect.try(() => new Proxy(window, {
    get(target, property) {
      if (property === "localStorage") { reads++; return undefined }
      if (property === "addEventListener") return add
      if (property === "removeEventListener") return remove
      return target[property as keyof Window]
    },
  }))
  return {
    layer: Layer.succeed(Experimental.Window.Window, Experimental.Window.make({ window: () => current, computedStyle: style })),
    reads: () => reads,
  }
}

const roles = ["viewer", "new", "community", "contributor", "maintainer"] as const
const choices = [
  ...roles.flatMap((asked) => roles.map((stored) => [`?role=${asked}`, stored, asked] as const)),
  ...roles.map((stored) => ["", stored, stored] as const),
  ...roles.map((asked) => [`?role=${asked}`, null, asked] as const),
  ["", null, "maintainer"],
  ["", "", "maintainer"],
  ["?role=", null, "maintainer"],
  ["", "viewer ", "maintainer"],
  ["?role=unknown", "contributor", "maintainer"],
  ["?role=VIEWER", "viewer", "maintainer"],
  ["?role=", "contributor", "contributor"],
  ["?role=viewer&role=maintainer", "contributor", "viewer"],
  ["?role=&role=viewer", "contributor", "contributor"],
] as const

for (const [query, stored, wanted] of choices) {
  it.live(`chooses the mock role from ${query || "no query"} and ${stored ?? "no stored role"}`, () => scoped(effect {
    const { window } = try host()
    try sync(() => {
      window.history.replaceState(null, "", `/history${query}`)
      if (stored === null) window.localStorage.removeItem("vibelang.role")
      else window.localStorage.setItem("vibelang.role", stored)
    })
    try Effect.try(() => expect(mockRole(window)).toBe(wanted))
  }))
}

for (const [query, wanted, reads] of [["", "maintainer", true], ["?role=viewer", "viewer", false], ["?role=unknown", "maintainer", false]] as const) {
  it.live(`chooses ${wanted} with unavailable storage and ${query || "no query"}`, () => scoped(effect {
    const { window } = try host()
    try sync(() => window.history.replaceState(null, "", `/history${query}`))
    const faulty = try withoutStorage(window)
    provide faulty.layer {
      const current = try (try Experimental.Window.Window).current
      try Effect.try(() => {
        expect(mockRole(current)).toBe(wanted)
        expect(faulty.reads() > 0).toBe(reads)
      })
    }
  }))
}

for (const denied of [false, true]) {
it.live(`starts a usable mock history when health${denied ? " and storage are" : " is"} unavailable`, () => scoped(effect {
  const { node, window } = try host()
  try sync(() => {
    window.history.replaceState(null, "", "/history")
    window.localStorage.removeItem("vibelang.role")
    window.localStorage.removeItem("vibelang.agent")
  })
  const faulty = try withoutStorage(window)
  let probes = 0
  const client = HttpClient.make((request) => {
    probes++
    return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request, cause: "offline" }) }))
  })
  provide Layer.mergeAll(page, Layer.succeed(HttpClient.HttpClient, client), denied ? faulty.layer : Layer.empty) {
    const { application, flags } = try historyMain()
    try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
    try promise(() => vi.waitFor(() => {
      const frame = node.querySelector("[data-surface='history']")
      expect(frame?.getAttribute("data-role")).toBe("maintainer")
      expect(frame?.getAttribute("data-mode")).toBe("mock")
      expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
    }, { timeout: 5000 }))
    try Effect.try(() => {
      expect(faulty.reads() > 0).toBe(denied)
      expect(probes).toBe(1)
    })
  }
}), 30_000)
}

it.live("disposing the mounted history cancels an unresolved health selection", () => scoped(effect {
  const { node, window } = try host()
  try sync(() => {
    window.history.replaceState(null, "", "/history")
    window.localStorage.removeItem("vibelang.agent")
  })
  const health = try heldHealth()
  const mounted = try acquireRelease(Scope.make(), (scope) => Scope.close(scope, Exit.succeed(undefined)))
  provide Layer.merge(page, health.layer) {
    const { application, flags } = try historyMain()
    provide Scope.Scope = mounted {
      try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
    }
    try promise(() => vi.waitFor(() => {
      expect(health.snapshot()).toEqual({ calls: 1, settled: false, cancelled: false })
      expect(node.querySelector("[data-surface='history']")?.getAttribute("data-mode")).toBe("pending")
    }, { timeout: 1000 }))
    try Scope.close(mounted, Exit.succeed(undefined))
    try promise(() => vi.waitFor(() => expect(health.snapshot()).toEqual({ calls: 1, settled: false, cancelled: true })))
  }
}), 30_000)

for (const [role, force, initialHash] of [["viewer", "query", ""], ["new", "query", ""], ["community", "storage", ""], ["contributor", "storage", ""], ["maintainer", "query", ""], ["viewer", "query", "m1"], ["maintainer", "storage", "e1"]] as const) {
  it.live(`starts the ${role}'s history at #${initialHash} through ${force} mock selection and follows real hash navigation`, () => scoped(effect {
    const { node, window } = try host()
    try sync(() => {
      window.history.replaceState(null, "", `/history?role=${role}${force === "query" ? "&agent=mock" : ""}${initialHash ? `#${initialHash}` : ""}`)
      window.localStorage.removeItem("vibelang.agent")
      if (force === "storage") window.localStorage.setItem("vibelang.agent", "mock")
    })
    const seed = try Effect.try(() => JSON.parse(HISTORY_JSON) as History)
    const epicTitle = try Effect.try(() => seed.epics.find((epic) => epic.id === "e1")!.title)
    const title = try Effect.try(() => seed.commits.find((commit) => commit.id === "m1")!.title)
    provide Layer.merge(page, FetchHttpClient.layer) {
      const { application, flags } = try historyMain()
      try Effect.try(() => expect(flags).toEqual({ mode: "pending", role, hash: initialHash }))
      try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
      try promise(() => vi.waitFor(() => {
        const frame = node.querySelector("[data-surface='history']")
        expect(frame?.getAttribute("data-role")).toBe(role)
        expect(frame?.getAttribute("data-mode")).toBe("mock")
      }, { timeout: 5000 }))
      if (initialHash === "") {
        try promise(() => vi.waitFor(() => expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull(), { timeout: 5000 }))
        const buttons = try Effect.try(() => Array.from(node.querySelectorAll("button"), (button) => button.textContent))
        try Effect.try(() => {
          expect(buttons.includes("Plan work")).toBe(role === "contributor" || role === "maintainer")
          expect(buttons.includes("Fold")).toBe(role === "maintainer")
        })
        try sync(() => node.querySelector<HTMLElement>(".mh-epics [role='button']")!.click())
        try promise(() => vi.waitFor(() => expect(node.querySelector("a[href='#e1']")).not.toBeNull(), { timeout: 5000 }))
        try sync(() => node.querySelector<HTMLAnchorElement>("a[href='#e1']")!.click())
      }
      if (initialHash !== "m1") {
        // The expanded outline already has commit links. Require the epic page itself before following one.
        try promise(() => vi.waitFor(() => {
          expect(window.location.hash).toBe("#e1")
          expect(node.querySelector("h1")?.textContent).toBe(epicTitle)
          expect(node.querySelector("a[href='#m1']")).not.toBeNull()
        }, { timeout: 5000 }))
        try sync(() => node.querySelector<HTMLAnchorElement>("a[href='#m1']")!.click())
      }
      try promise(() => vi.waitFor(() => {
        expect(window.location.hash).toBe("#m1")
        expect(node.querySelector("h1")?.textContent).toBe(title)
      }, { timeout: 5000 }))
      const history = try Effect.try(() => node.querySelector<HTMLAnchorElement>("a[href='#']")!)
      try Effect.try(() => expect(history.textContent).toBe("History"))
      try sync(() => history.click())
      try promise(() => vi.waitFor(() => {
        expect(window.location.hash).toBe("")
        expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
      }, { timeout: 5000 }))
    }
  }), 30_000)
}

it.live("?agent=mock starts the mock history even when storage refuses to remember the choice", () => scoped(effect {
  const { node, window } = try host()
  try sync(() => window.history.replaceState(null, "", "/history?agent=mock"))
  const faulty = try withoutStorage(window)
  let probes = 0
  const client = HttpClient.make((request) => {
    probes++
    return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request, cause: "offline" }) }))
  })
  provide Layer.mergeAll(page, Layer.succeed(HttpClient.HttpClient, client), faulty.layer) {
    const { application, flags } = try historyMain()
    try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
    try promise(() => vi.waitFor(() => {
      const frame = node.querySelector("[data-surface='history']")
      expect(frame?.getAttribute("data-mode")).toBe("mock")
      expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
    }, { timeout: 5000 }))
    try Effect.try(() => {
      expect(faulty.reads()).toBeGreaterThan(0)
      expect(probes).toBe(0)
    })
  }
}), 30_000)

it.live("?agent=live forgets a stored mock choice and asks the server", () => scoped(effect {
  const { node, window } = try host()
  try sync(() => {
    window.localStorage.setItem("vibelang.agent", "mock")
    window.history.replaceState(null, "", "/history?agent=live")
  })
  let probes = 0
  const client = HttpClient.make((request) => {
    probes++
    return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request, cause: "offline" }) }))
  })
  provide Layer.mergeAll(page, Layer.succeed(HttpClient.HttpClient, client)) {
    const { application, flags } = try historyMain()
    try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
    try promise(() => vi.waitFor(() => {
      expect(node.querySelector("[data-surface='history']")?.getAttribute("data-mode")).not.toBe("mock")
      expect(probes).toBeGreaterThan(0)
    }, { timeout: 5000 }))
    try Effect.try(() => expect(window.localStorage.getItem("vibelang.agent")).toBeNull())
  }
}), 30_000)

// ── live: the session decides who you are (decision 0019) ────────────────────────────────────────────────────────

/** The compiler (m1), then Docs (m2), landed: a small history for the live page to read. */
const small = () => succeed(replay(intentsOf(seedOf("o/r", ["fix(compiler): one", "docs: two"].map((description, index) => ({
  sha: `${index + 1}`.padStart(12, "0"), change: "", description, parents: index === 0 ? [] : ["000000000001"],
})), []))).history)

const PERSON = { role: "maintainer" as const, name: "Ada", agent: false }

/**
 * The project's API on the scope's loopback server: health live, the real Accounts object over stored sessions (host
 * fixture state, as test/accountsClientHttp.test.vibe sets it) for sign-in and roles, and the Worker's history routes
 * over the product mock. Answers the origin, a native client, the session cookie of a new person, and the first
 * maintainer's own Accounts client for the grants a test makes while a page is open.
 */
effect function serveApi() {
  const address = (try HttpServer.HttpServer).address
  const origin = address._tag === "UnixPathAddress" ? "http://localhost" : `http://127.0.0.1:${address.port}`
  const signingSecret = Redacted.make("fixture-only-signing-secret-32-chars")
  const storage = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Storage
  const github = Context.get(try Layer.build(GitHub.Auth.layer({ clientId: "fixture", clientSecret: Redacted.make("fixture-only") })), GitHub.Auth.GitHubAuth)
  const keys = try Core.CookieKeys.make({ primary: signingSecret }, "primary")
  const expires = (try Clock.currentTimeMillis) + 60_000
  effect function session(person: { readonly id: string; readonly login: string }) {
    const token = try keys.token
    try promise(() => storage.put("session/" + token, { ...person, expires }))
    try promise(() => storage.put("person/" + person.id, person))
    return Accounts.SESSION + "=" + (try keys.sign("session", token))
  }
  const will = try session({ id: "1", login: "will" })
  const ada = try session({ id: "7", login: "ada" })
  const accounts = try Accounts.make("history-startup", storage, {
    origin, signingSecret, encryptionKey: Redacted.make("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="), initialMaintainer: "1", clientId: "fixture-client-id", github,
  })
  const history = try histories()
  try HttpServer.serveEffect(effect {
    const request = try HttpServerRequest.HttpServerRequest
    const path = new URL(request.url, origin).pathname
    return path.startsWith("/api/auth/") || path.startsWith("/api/roles") ? try accounts.fetch : try handle(unavailableConversations, history)
  })
  const native = Context.get(try Layer.build(NodeHttpClient.layerNodeHttp), HttpClient.HttpClient)
  const maintainer = try Effect.provideService(LiveAccounts.make(origin), HttpClient.HttpClient, HttpClient.mapRequest(native, (request) => HttpClientRequest.setHeader(request, "cookie", will)))
  return { origin, native, ada, maintainer }
}

/**
 * The page's client: requests to its own origin reach the loopback API with the browser's session cookie (none when
 * `cookie` is empty). Each path in `faults` fails once, as a lost transport would, before any request is sent.
 */
function pageClient(native: HttpClient.HttpClient, origin: string, cookie: string, faults: Array<string> = []) {
  const asked: Array<string> = []
  const routed = HttpClient.mapRequest(native, (request) => {
    const url = new URL(request.url)
    const toApi = HttpClientRequest.setUrl(request, origin + url.pathname + url.search)
    return cookie === "" ? toApi : HttpClientRequest.setHeader(toApi, "cookie", cookie)
  })
  const client = HttpClient.transform(routed, (response, request) => {
    const path = new URL(request.url).pathname
    asked.push(path)
    const at = faults.indexOf(path)
    if (at < 0) return response
    faults.splice(at, 1)
    return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request, cause: "offline" }) }))
  })
  return { layer: Layer.succeed(HttpClient.HttpClient, client), asked: (path: string) => asked.filter((each) => each === path).length, faults }
}

/** Mounts the page's own live startup with `client` on the host's window; the frame and the buttons it shows. */
effect function mountLive(node: HTMLElement, window: Window, client: Layer.Layer<HttpClient.HttpClient>) {
  try sync(() => {
    window.history.replaceState(null, "", "/history?agent=live")
    window.localStorage.removeItem("vibelang.role")
  })
  provide Layer.merge(page, client) {
    const { application, flags } = try historyMain()
    try Effect.try(() => expect(flags.mode).toBe("pending"))
    try acquireRelease(sync(() => Runtime.embed(application, { flags: succeed(flags) })), (handle) => sync(() => handle.dispose()))
  }
  return {
    frame: () => node.querySelector("[data-surface='history']"),
    buttons: () => Array.from(node.querySelectorAll("button"), (button) => button.textContent),
  }
}

it.live("live, a signed-in person plays the session's role, and a grant changes it without a reload", () => scoped(effect {
  const { node, window } = try host()
  provide NodeHttpServer.layerTest, MockMythical(PERSON, small) {
    try scoped(effect {
      const api = try serveApi()
      try api.maintainer.grant("7", "contributor")
      const client = pageClient(api.native, api.origin, api.ada)
      const { frame, buttons } = try mountLive(node, window, client.layer)
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-mode")).toBe("live")
        expect(frame()?.getAttribute("data-role")).toBe("contributor")
        expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
      }, { timeout: 5000 }))
      try Effect.try(() => {
        expect(buttons()).toContain("Plan work")
        expect(buttons()).not.toContain("Fold")
        expect(client.asked("/api/auth/session")).toBe(1)
      })
      try api.maintainer.grant("7", "maintainer")
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-role")).toBe("maintainer")
        expect(buttons()).toContain("Fold")
      }, { timeout: 5000 }))
      // The grant arrived as a role event; the session was not read again.
      try Effect.try(() => expect(client.asked("/api/auth/session")).toBe(1))
    })
  }
}), 30_000)

it.live("live, a visitor is a viewer and follows no grants", () => scoped(effect {
  const { node, window } = try host()
  provide NodeHttpServer.layerTest, MockMythical(PERSON, small) {
    try scoped(effect {
      const api = try serveApi()
      const client = pageClient(api.native, api.origin, "")
      const { frame, buttons } = try mountLive(node, window, client.layer)
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-mode")).toBe("live")
        expect(client.asked("/api/auth/session")).toBe(1)
        expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
      }, { timeout: 5000 }))
      try Effect.try(() => {
        expect(frame()?.getAttribute("data-role")).toBe("viewer")
        expect(buttons()).not.toContain("Plan work")
        expect(client.asked("/api/roles/events")).toBe(0)
      })
    })
  }
}), 30_000)

it.live("live, an unanswered session or a lost grant stream leaves a viewer who is asked about again 2 seconds later", () => scoped(effect {
  const { node, window } = try host()
  provide NodeHttpServer.layerTest, MockMythical(PERSON, small) {
    try scoped(effect {
      const api = try serveApi()
      try api.maintainer.grant("7", "contributor")
      const client = pageClient(api.native, api.origin, api.ada, ["/api/auth/session", "/api/roles/events"])
      const { frame, buttons } = try mountLive(node, window, client.layer)
      // The session failed once: a viewer, with the history loaded.
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-mode")).toBe("live")
        expect(client.asked("/api/auth/session")).toBe(1)
        expect(node.querySelector(".mh-epics [role='button']")).not.toBeNull()
      }, { timeout: 5000 }))
      try Effect.try(() => {
        expect(frame()?.getAttribute("data-role")).toBe("viewer")
        expect(buttons()).not.toContain("Plan work")
      })
      // Asked again: the session answers and the role shows, although the grant stream failed once.
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-role")).toBe("contributor")
        expect(client.asked("/api/roles/events")).toBe(1)
      }, { timeout: 5000 }))
      // Followed again: a later grant reaches the page.
      try promise(() => vi.waitFor(() => expect(client.asked("/api/roles/events")).toBe(2), { timeout: 5000 }))
      try api.maintainer.grant("7", "maintainer")
      try promise(() => vi.waitFor(() => {
        expect(frame()?.getAttribute("data-role")).toBe("maintainer")
        expect(buttons()).toContain("Fold")
      }, { timeout: 5000 }))
      try Effect.try(() => expect(client.faults).toEqual([]))
    })
  }
}), 30_000)
