// @vitest-environment node
// The agent's system context is VibeLang's own skill, generated into worker/agentContext.vibe (decision 0010). It must
// match the installed `vibelang`, so a VibeLang upgrade can't leave the agent teaching an older language.
import * as NodeServices from "@effect/platform-node/NodeServices"
import { expect, it } from "@effect/vitest"
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { AGENT_CONTEXT } from "../worker/agentContext.vibe"
import { builtScript, node, run } from "./support/processes.vibe"

it.live("is generated from the installed VibeLang skill", () => effect {
  provide NodeServices.layer, ExperimentalNodeServices.layer {
    const script = try builtScript(try (try Path.Path).fromFileUrl(new URL("../dist-scripts/agent-context.js", import.meta.url)))
    const check = try run(try node(), [script, "--check"])
    try Effect.try(() => {
      expect(check.status, check.stderr).toBe(0)
      expect(AGENT_CONTEXT).toContain("You are the VibeLang agent on vibelang.smithers.sh")
      expect(AGENT_CONTEXT).toContain("`effect` goes exactly where `async` goes")
      expect(AGENT_CONTEXT).not.toMatch(/^---/)
    })
  }
}, 30_000)

it.live("writes an isolated context and rejects missing or changed generated output", () => scoped(effect {
  provide NodeServices.layer, ExperimentalNodeServices.layer {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    // Keep the compiler-emitted executable and its maps until the coverage provider has collected child processes.
    // Its relative output lives in this ignored fixture tree, never in the app's worker directory.
    const root = try path.fromFileUrl(new URL("../dist-script-tests/", import.meta.url))
    const script = try builtScript(path.join(root, "scripts/agent-context.js"))
    const target = path.join(root, "worker/agentContext.vibe")
    try fs.makeDirectory(path.join(root, "worker"), { recursive: true })
    try fs.remove(target, { force: true })
    try Effect.addFinalizer(() => fs.remove(target, { force: true }).pipe(Effect.orDie))
    const executable = try node()
    const missing = try run(executable, [script, "--check"])
    const written = try run(executable, [script])
    const generated = try fs.readFileString(target)
    const current = try run(executable, [script, "--check"])
    try fs.writeFileString(target, "changed")
    const changed = try run(executable, [script, "--check"])
    try Effect.try(() => {
      expect(written.status, written.stderr).toBe(0)
      expect(current.status, current.stderr).toBe(0)
      expect(generated).toContain(JSON.stringify(AGENT_CONTEXT))
      for (const failed of [missing, changed]) {
        expect(failed.status).toBe(1)
        expect(failed.stderr).toContain("worker/agentContext.vibe is stale")
      }
      expect(changed.stderr).not.toContain(AGENT_CONTEXT)
    })
  }
}), 30_000)
