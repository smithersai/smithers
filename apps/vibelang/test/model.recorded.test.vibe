// @vitest-environment node
// The model's happy paths on recordings of the real model (ruling VL-36): the VIP and wiki draft writers, a
// specification reviewer, a reply, and a reply in Markdown through the live Worker in workerd (the chat Markdown journey,
// e2e/chat-markdown.spec.ts, replays the same recording), each with smithers.sh's real agent inside one durable execution, over the
// deployment's default model (DEFAULT_CHAT_MODEL) through test/support/model.vibe. Replayed from
// test/recordings/model-*.json unless VIBE_MODEL says otherwise; a replay needs no key and reaches no network. Until
// a case's recording is committed (`pnpm record:model` with CEREBRAS_API_KEY, at most 40 model calls) that case skips.
// A real answer differs from run to run, so each case checks what the product promises of any answer, not its words.
// Failures stay on the scripted model (fuzz/model-server.vibe) as injected faulty answers.
import { describe, expect, it } from "@effect/vitest"
import { FetchHttpClient } from "effect/http"
import { VipWriter } from "../src/core/VipWriter.vibe"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import { SpecificationReviewers } from "../src/core/specification.vibe"
import { unansweredSpecificationReview } from "../src/core/conversation.vibe"
import type { IssueRequest } from "../src/core/issueSchemas.vibe"
import * as Budget from "../worker/Budget.vibe"
import { ChatModel, REPLY_CEILING, Spend } from "../worker/Reply.vibe"
import { liveSpecificationReviewers } from "../worker/SpecificationReviewers.vibe"
import { agentLayer, writer } from "../worker/VipDraft.vibe"
import { wikiAgentLayer, wikiWriter } from "../worker/WikiDraft.vibe"
import { ledger, within } from "./support/durableWriters.vibe"
import { configured, recordedModel } from "./support/model.vibe"
import { recordingText } from "./support/recordingFile.ts"
import { MARKDOWN_PROMPT, replyFrom, serveRecordedProvider } from "./support/recordedProvider.vibe"
import { replyWorld } from "./support/replyWorld.vibe"
import { serveApi } from "./support/workerd.vibe"

const CASES = ["vip-draft", "wiki-draft", "review", "reply", "markdown"] as const
const missing = CASES.filter((name) => recordingText(`test/recordings/model-${name}.json`) === undefined)
const VIP: IssueRequest = { op: "draft", key: "d1", number: 0, parent: 0, title: "Tuple patterns", text: "Match on tuples in a case expression.", example: "case (a, b) -> a", prior: "ML", assignee: "" }
const PAGE = { page: "roadmap", source: "# Roadmap\n\nTuples, then records, then pattern guards.\n", ask: "Make it one sentence." }
const nonEmpty = expect.stringMatching(/\S/)

/**
 * The draft's own key is admitted and settled once, and every model request is charged on its own receipt with the
 * tokens the provider reported. An agent may take several frames (each a model call), so the count is the requests'.
 */
function chargedOnce(log: { admitted: number; spent: number; calls: number; tokens: number; unreported: number }, requests: number) {
  expect(log).toMatchObject({ admitted: 1, spent: 1, unreported: 0 })
  expect(requests).toBeGreaterThan(0)
  expect(log.calls).toBe(requests)
  expect(log.tokens).toBeGreaterThan(0)
}

effect function parsed(text: string) {
  return (try Effect.orDie(Effect.try(() => JSON.parse(text)))) as Record<string, unknown>
}

/** A case replays only once its recording is committed; record and pass-through always run. */
const whenRecorded = (name: (typeof CASES)[number]) => it.live.skipIf(configured === "replay" && missing.includes(name))

describe(`the real model's answers (record with CEREBRAS_API_KEY: pnpm record:model)`, () => {
  whenRecorded("vip-draft")("the VIP agent drafts every field of the proposal, charged once", () => scoped(effect {
    const recorded = try recordedModel("vip-draft")
    const { log, spend } = ledger("admit")
    const layer = writer.pipe(Layer.provide(agentLayer), Layer.provide(Layer.succeed(ChatModel, { model: recorded.model, unusable: "" })), Layer.provide(Layer.succeed(Spend, spend)))
    const draft = try parsed(try within(layer, Effect.orDie(effect { return JSON.stringify(try (try VipWriter).draft(VIP)) })))
    expect(draft).toEqual({ title: nonEmpty, summary: nonEmpty, example: nonEmpty, prior: nonEmpty })
    chargedOnce(log, recorded.requests.count)
  }), 120_000)

  whenRecorded("wiki-draft")("the wiki agent drafts the asked page with text, charged once", () => scoped(effect {
    const recorded = try recordedModel("wiki-draft")
    const { log, spend } = ledger("admit")
    const layer = wikiWriter.pipe(Layer.provide(wikiAgentLayer), Layer.provide(Layer.succeed(ChatModel, { model: recorded.model, unusable: "" })), Layer.provide(Layer.succeed(Spend, spend)))
    const draft = try parsed(try within(layer, Effect.orDie(effect { return JSON.stringify(try (try WikiWriter).draft(PAGE)) })))
    expect(draft).toEqual({ page: "roadmap", text: nonEmpty })
    chargedOnce(log, recorded.requests.count)
  }), 120_000)

  whenRecorded("review")("a specification reviewer answers a verdict and grade at the asked revision, charged once", () => scoped(effect {
    const recorded = try recordedModel("review")
    const { log, spend } = ledger("admit")
    // The reviewer builds its model from the deployment's record; its provider calls go through the recorded fetch.
    const config = { ...recorded.values, SPEC_REVIEW_SOL: JSON.stringify(recorded.record) }
    const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, spend)), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(config))))
    const spec = { revision: 3, text: "# VIP: tuple patterns\n\nA case expression matches a tuple by position: `case (a, b) -> a`. Every arm binds the same names.\n", astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
    const answer = try parsed(try within(layer, effect {
      const result = try Effect.result((try SpecificationReviewers).review("sol", spec))
      return JSON.stringify(result._tag === "Success" ? result.success : { reason: result.failure.reason })
    }).pipe(Effect.provideService(FetchHttpClient.Fetch, recorded.fetch)))
    expect(answer).toMatchObject({ verdict: nonEmpty, grade: expect.stringMatching(/^[A-F][+-]?$/), revision: 3, link: "#review" })
    chargedOnce(log, recorded.requests.count)
  }), 120_000)

  whenRecorded("reply")("a reply answers a post with text, and charges what the provider counted within the ceiling", () => scoped(effect {
    const recorded = try recordedModel("reply")
    const w = try replyWorld(recorded.model)
    const { entry, types, ledger: spent } = try w.answer("In one sentence: what is a tuple?")
    expect(entry).toMatchObject({ text: nonEmpty, done: true, error: "" })
    expect(types).toContain("ReplyFinished")
    expect(spent[Budget.SPENT]).toBeGreaterThan(0)
    expect(spent[Budget.SPENT]).toBeLessThanOrEqual(REPLY_CEILING)
    expect(spent[Budget.RESERVED]).toBe(0)
  }), 120_000)

  whenRecorded("markdown")("a reply in the live Worker answers in Markdown: a table, a list and a quote", () => scoped(effect {
    const provider = try serveRecordedProvider("markdown")
    const api = try acquireRelease(serveApi(provider.bindings), (served) => promise(() => served.dispose()))
    const reply = try replyFrom(api.origin, MARKDOWN_PROMPT)
    expect(reply).toMatchObject({ done: true, error: "" })
    expect(reply.text).toMatch(/^\|.+\|\s*$/m)
    expect(reply.text).toMatch(/^\|\s*:?-{3,}/m)
    expect(reply.text).toMatch(/^\s*(?:[-*+]|\d+\.)\s+\S/m)
    expect(reply.text).toMatch(/^>\s*\S/m)
  }), 300_000)
})
