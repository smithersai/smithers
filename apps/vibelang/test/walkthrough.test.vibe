import { describe, expect, it } from "@effect/vitest"
import { apply, empty, tourWalkthrough } from "../src/core/conversation.vibe"
import { decide } from "../src/core/decide.vibe"
import { WALKTHROUGH, walkthroughStop } from "../src/core/walkthroughSteps.vibe"

describe("walkthrough state", () => {
  it("numbers the drive, freezes remaining reading time, resumes and seeks without touching entries", () => {
    const started = apply(empty, { type: "TourStarted", seq: 1, id: "t1" })
    const driven = decide(started, { type: "DriveWalkthrough", id: "t1", step: 3, target: "issues", at: 1000, duration: 15000 })
    expect(driven.ok).toBe(true)
    if (!driven.ok) return
    const showing = apply(started, driven.event)
    expect(showing.walkthrough).toMatchObject({ step: 3, target: "issues", paused: false, remaining: 15000 })
    const pause = decide(showing, { type: "PauseTour", id: "t1", at: 4000 })
    if (!pause.ok) return expect(pause.ok).toBe(true)
    const paused = apply(showing, pause.event)
    expect(paused.walkthrough).toMatchObject({ paused: true, remaining: 12000 })
    const resume = decide(paused, { type: "ResumeTour", id: "t1", at: 90000 })
    if (!resume.ok) return expect(resume.ok).toBe(true)
    const resumed = apply(paused, resume.event)
    expect(resumed.walkthrough).toMatchObject({ paused: false, remaining: 12000, at: 90000 })
    expect(resumed.entries).toEqual(started.entries)
    const seek = decide(resumed, { type: "SeekTour", id: "t1", step: 2, at: 91000 })
    if (!seek.ok) return expect(seek.ok).toBe(true)
    expect(apply(resumed, seek.event).walkthrough).toMatchObject({ step: 2, target: "", paused: false })
    expect(decide(empty, { type: "PauseTour", id: "t1", at: 0 })).toMatchObject({ ok: false, refusal: "not-replying" })
    expect(decide(showing, { type: "SeekTour", id: "t1", step: 12, at: 0 })).toMatchObject({ ok: false })
    expect(apply(showing, driven.event)).toBe(showing)
  })
  it("has the designer's ten destinations, subtitles, voices and two-minute holds", () => {
    expect(WALKTHROUGH.map(step => step.target)).toEqual(["splash", "palette", "issues", "issue:48", "issues:vips", "wiki:index", "history-nav", "composer", "sandbox-pane", "finish"])
    expect(WALKTHROUGH.reduce((total, step) => total + step.duration, 0)).toBe(134000)
    for (const step of WALKTHROUGH) expect(step.subtitle.split(/\s+/).length).toBeLessThanOrEqual(65)
  })
})

import { ConversationRead, Factory } from "../src/core/Factory.vibe"
import { mockFactoryFor } from "../src/core/MockFactory.vibe"
import { MockJournal } from "../src/core/MockJournal.vibe"
import { TestClock } from "effect/testing"
import type { Event } from "../src/core/conversation.vibe"
/** Every subtitle stays within the live agent's word bound: at most 65 words and 560 characters. */
const Narration = Schema.Struct({ stops: Schema.Array(Schema.String.check(Schema.isPattern(/^(?:\S+\s+){0,64}\S+\s*$/), Schema.isMaxLength(560))).check(Schema.isMinLength(WALKTHROUGH.length), Schema.isMaxLength(WALKTHROUGH.length)) })

it("keeps every subtitle within the live agent's word bound", () => {
  expect(Schema.decodeUnknownOption(Narration)({ stops: WALKTHROUGH.map(step => step.subtitle) })._tag).toBe("Some")
  expect(Schema.decodeUnknownOption(Narration)({ stops: WALKTHROUGH.map(() => Array.from({ length: 66 }, () => "word").join(" ")) })._tag).toBe("None")
})

it.effect("a paused private Mock tour survives rebuilding its host and resumes without repeated narration", () => effect {
  const retained = new Map<string, ReadonlyArray<Event>>()
  const journal = Layer.succeed(MockJournal, {
    read: (room: string) => succeed(retained.get(room) ?? []),
    write: (room: string, events: ReadonlyArray<Event>) => sync(() => { retained.set(room, events) }),
  })
  const layer = mockFactoryFor().pipe(Layer.provide(journal))
  try scoped(effect {
    provide layer {
      const factory = try Factory
      try factory.tour("tour-reload")
      try Stream.runDrain(factory.events("tour-reload", 0).pipe(Stream.takeUntil(event => event.type === "ReplyDelta")))
      try factory.controlTour!("tour-reload", "seek", 4)
      try Stream.runDrain(factory.events("tour-reload", 0).pipe(Stream.takeUntil(event => event.type === "ReplyDelta" && event.text.endsWith(WALKTHROUGH[3]!.subtitle))))
      try factory.controlTour!("tour-reload", "pause", 0)
    }
  })
  const count = retained.get("tour-reload")!.filter(event => event.type === "ReplyDelta").length
  try scoped(effect {
    provide layer {
      const factory = try Factory
      const events = Array.from(try Stream.runCollect(factory.events("tour-reload", 0).pipe(Stream.takeUntil(event => event.type === "TourPaused"))))
      try TestClock.adjust("5 seconds")
      const before = try (try ConversationRead).read("tour-reload", 0)
      try Effect.try(() => {
        expect(before.seq).toBe(events.at(-1)!.seq)
        expect(events.reduce(apply, empty).walkthrough).toMatchObject({ step: 4, paused: true })
        expect(retained.get("tour-reload")!.filter(event => event.type === "ReplyDelta")).toHaveLength(count)
      })
      try factory.controlTour!("tour-reload", "resume", 0)
      try factory.controlTour!("tour-reload", "seek", 5)
      try Stream.runDrain(factory.events("tour-reload", 0).pipe(Stream.takeUntil(event => event.type === "ReplyDelta" && event.text.endsWith(WALKTHROUGH[4]!.subtitle))))
      try factory.endTour("tour-reload")
      const refused = factory.controlTour!("tour-reload", "pause", 0) catch (error) => error._tag === "Refused" ? error.refusal : "unavailable"
      try Effect.try(() => expect(refused).toBe("not-replying"))
    }
  })
}, 30000)

it("rejects fractional destinations and malformed drives before they can break the controller", () => {
  const started = apply(empty, { type: "TourStarted", seq: 1, id: "t1" })
  const driven = { type: "WalkthroughDriven" as const, seq: 2, id: "t1", step: 1, target: "splash", at: 0, duration: 7000 }
  const showing = apply(started, driven)
  expect(decide(showing, { type: "SeekTour", id: "t1", step: 1.5, at: 0 })).toMatchObject({ ok: false })
  for (const payload of [{ step: 1.5 }, { duration: -1 }, { target: "" }]) {
    expect(apply(started, { ...driven, ...payload }).walkthrough).toBeUndefined()
  }
})

describe("the stop at a step", () => {
  it("steps 1 and 10 are the first and last stops; a step outside them shows the nearest stop", () => {
    expect(walkthroughStop(1)).toBe(WALKTHROUGH[0])
    expect(walkthroughStop(4).target).toBe("issue:48")
    expect(walkthroughStop(10)).toBe(WALKTHROUGH[9])
    expect(walkthroughStop(0)).toBe(WALKTHROUGH[0])
    expect(walkthroughStop(11)).toBe(WALKTHROUGH[9])
    expect(walkthroughStop(2.49)).toBe(WALKTHROUGH[1])
    expect(walkthroughStop(2.5)).toBe(WALKTHROUGH[2])
    expect(walkthroughStop(Number.NaN)).toBe(WALKTHROUGH[0])
    expect(walkthroughStop(Number.NEGATIVE_INFINITY)).toBe(WALKTHROUGH[0])
    expect(walkthroughStop(Number.POSITIVE_INFINITY)).toBe(WALKTHROUGH[9])
  })
})


it("refuses controls on a new tour until its first drive, including replayed events", () => {
  const started = apply(empty, { type: "TourStarted", seq: 1, id: "first" })
  const showing = apply(started, { type: "WalkthroughDriven", seq: 2, id: "first", step: 7, target: "history-nav", at: 0, duration: 10000 })
  const ended = apply(showing, { type: "TourEnded", seq: 3, id: "first" })
  expect(ended.walkthrough).toBe(showing.walkthrough)
  const next = apply(ended, { type: "TourStarted", seq: 4, id: "second" })
  expect(tourWalkthrough(next)).toBeNull()
  for (const type of ["PauseTour", "ResumeTour", "SeekTour"] as const) {
    expect(decide(next, { type, id: "second", step: 5, at: 1000 })).toEqual({ ok: false, refusal: "not-replying" })
  }
  for (const type of ["TourPaused", "TourResumed", "TourSought"] as const) {
    const controlled = apply(next, { type, seq: 5, id: "second", step: 5, at: 1000 })
    expect(tourWalkthrough(controlled)).toBeNull()
  }
  const driven = apply(next, { type: "WalkthroughDriven", seq: 5, id: "second", step: 1, target: "splash", at: 1000, duration: 7000 })
  expect(tourWalkthrough(driven)).toMatchObject({ step: 1, target: "splash", paused: false })
  expect(decide(driven, { type: "PauseTour", id: "second", at: 1000 }).ok).toBe(true)
})

it("keeps an ended tour's walkthrough in the conversation, but shows it as no tour's", () => {
  const started = apply(empty, { type: "TourStarted", seq: 1, id: "first" })
  const showing = apply(started, { type: "WalkthroughDriven", seq: 2, id: "first", step: 7, target: "history-nav", at: 0, duration: 10000 })
  expect(tourWalkthrough(showing)).toMatchObject({ step: 7, target: "history-nav" })
  const ended = apply(showing, { type: "TourEnded", seq: 3, id: "first" })
  expect(ended.walkthrough).toMatchObject({ step: 7, target: "history-nav" })
  expect(tourWalkthrough(ended)).toBeNull()
})
