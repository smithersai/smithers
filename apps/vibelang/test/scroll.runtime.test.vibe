import { expect, it } from "@effect/vitest"
import { vi } from "vitest"
import { Dom, Runtime, Subscription } from "foldkit"
import { MockFactory } from "../src/core/MockFactory.vibe"
import { init, Message, Model, Flags, subscriptions, update } from "../src/web/main.vibe"
import { view } from "../src/web/view.vibe"
import { scrollHost } from "./support/scrollHost.ts"

for (const input of ["wheel", "touch", "PageUp", "Home", "ArrowUp"] as const) {
  for (const ordering of ["commit-first", "intent-first", "delta-first"] as const) {
    it.live(`${input}, ${ordering}: upward intent vetoes pending follow and deltas until Latest or bottom`, () => scoped(effect {
      const host = try acquireRelease(sync(scrollHost), (host) => sync(() => host.dispose()))
      const initial = init({ session: "scroll", name: "Ada", mode: "mock" }).model
      let latest: Model = { ...initial, surface: "chat" }
      const program = try Effect.try(() => Runtime.makeApplication({
        Model, Flags, init: () => ({ model: latest }), update,
        view: (model, h) => { latest = model; return view(model, h) },
        subscriptions: Subscription.aggregate(subscriptions(host.page, host.page), Subscription.make<Model, Message>()(() => ({
          // A test input channel delivers numbered events; it does not replace any production subscription.
          driver: Subscription.persistentEntry(Dom.streamFromEvent({
            target: host.target, type: "delta", mapEvent: (event: Event) => host.message(event),
          })),
        }))), resources: MockFactory, container: host.node,
      }))
      try acquireRelease(
        sync(() => Runtime.embed(program, { flags: succeed({ session: "scroll", name: "Ada", mode: "mock" as const }) })),
        (handle) => sync(() => handle.dispose()),
      )
      try promise(() => vi.waitFor(() => expect(host.pending()).toBeGreaterThan(0)))
      // Vary the host ordering without yielding between intent, commit and delta. The old follow's scroll event
      // still reports the bottom before the native upward movement; it must not undo the reader's intent.
      try sync(() => {
        // A reply answers a post (finding 3 of the Fable review), so the conversation starts with one.
        host.emit(Message.ReceivedEvent({ event: { type: "Posted", seq: 1, id: "m1", clientId: "other-1", name: "Guest", text: "question" } }))
        if (ordering === "commit-first") host.frame()
        if (ordering === "delta-first") {
          host.emit(Message.ReceivedEvent({ event: { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" } }))
          host.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 3, id: "r1", text: "new piece" } }))
        }
        host.markIntent()
        host.up(input)
        host.scrolled()
        if (ordering !== "delta-first") {
          host.emit(Message.ReceivedEvent({ event: { type: "ReplyStarted", seq: 2, id: "r1", inReplyTo: "m1" } }))
          host.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 3, id: "r1", text: "new piece" } }))
        }
        if (ordering !== "commit-first") host.frame()
      })
      try promise(() => vi.waitFor(() => {
        host.frame()
        expect(latest.following).toBe(false)
        expect(latest.client.conversation.seq).toBe(3)
      }))
      try Effect.try(() => expect(host.scrollsAfterIntent()).toBe(0))
      // Further deltas cannot follow. Going back through the splash cannot resume either.
      try sync(() => {
        host.moveTo(0)
        host.emit(Message.ClickedSplash())
        host.emit(Message.ClickedChat())
        host.emit(Message.ReceivedEvent({ event: { type: "ReplyDelta", seq: 4, id: "r1", text: " and another" } }))
      })
      try promise(() => vi.waitFor(() => {
        host.frame()
        expect(latest.client.conversation.seq).toBe(4)
        expect(latest.following).toBe(false)
      }))
      try Effect.try(() => expect(host.scrollsAfterIntent()).toBe(0))
      // Actual downward travel into the bottom resumes following, including a duplicate scroll notification.
      try sync(() => { host.moveTo(600); host.scrolled() })
      try promise(() => vi.waitFor(() => {
        host.frame()
        expect(latest.following).toBe(true)
        expect(host.scrollsAfterIntent()).toBeGreaterThan(0)
      }))
      // Latest is the other explicit resumption, even before the upward default action changes the position.
      try sync(() => { host.up(input); host.scrolled() })
      try promise(() => vi.waitFor(() => { host.frame(); expect(latest.following).toBe(false) }))
      const beforeLatest = try sync(host.scrollsAfterIntent)
      try sync(host.latest)
      try promise(() => vi.waitFor(() => {
        host.frame()
        expect(latest.following).toBe(true)
        expect(host.scrollsAfterIntent()).toBeGreaterThan(beforeLatest)
      }))
    }))
  }
}
