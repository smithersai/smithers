// Batch 28 (0018): native RegExp captures remain the independent oracle for the wiki build's proved scans.
import { describe, expect, it } from "@effect/vitest"
import { pages } from "../src/assets/wiki.generated.vibe"
import { decisionFile, pageFields, pageId, suiteState } from "../src/core/wikiPage.vibe"

function before(file: string, markdown: string) {
  const id = file.replace(/\.md$/, "")
  const decision = /^decisions\/[0-9]{4}-/.test(id)
  const title = /^# (.+)$/m.exec(markdown)?.[1] ?? id
  const rulings = decision ? Array.from(new Set((/(?:\*\*)?Rulings?:(?:\*\*)?([^\n]*)/.exec(markdown)?.[1] ?? markdown.slice(0, 350)).match(/VL-[0-9]+/g) ?? [])) : []
  return {
    id, title, decision, rulings,
    label: decision ? id.slice(10).replace(/^(\d{4})-/, "$1 ") : undefined,
    status: /replaced|superseded/i.test(/(?:\*\*)?Status:(?:\*\*)?([^\n]*)/.exec(markdown)?.[1] ?? "") ? "Replaced" : "Accepted",
    date: /2026-\d\d-\d\d/.exec(markdown)?.[0] ?? "",
  }
}

function suiteBefore(markdown: string) {
  const status = /\*\*Status:\*\*([^\n]*)/.exec(markdown)?.[1] ?? ""
  return /in progress/i.test(status) ? "In progress" : status.trim()
}

describe("the wiki build's proved text decisions", () => {
  it("keeps heading, fields, first date and ruling order on the current wiki", () => {
    for (const page of pages) {
      expect(pageFields(page.id + ".md", page.source)).toEqual(before(page.id + ".md", page.source))
      expect(suiteState(page.source)).toBe(suiteBefore(page.source))
    }
  })
  it("handles every line ending, optional stars, duplicate rulings and absent fields", () => {
    const files = ["index.md", "decisions/0018-proofs.md", "decisions/7.md", "decisions/0018", "decisions/0000-x.md", "x.md\n", ""]
    const texts = ["", "# ", "# A\r\n# B", "x\u2028# A\u2029# B", "**Rulings:** VL-3 VL-2 VL-3\n**Status:** SUPERSEDED\n2026-00-99",
      "Ruling: VL-8\nRulings: VL-9", "Status:** replaced\rVL-1\n# T", "**Status:** in PROGRESS", "Status: accepted\nStatus: replaced",
      "Rulings: none\nVL-3", "VL-003 VL-03 VL-003", "2026-1-02 2026-12-34", "# A\r# B", "***Ruling:*** VL-2"]
    for (const file of files) {
      expect(pageId(file)).toBe(file.replace(/\.md$/, ""))
      expect(decisionFile(file)).toBe(/^decisions\/[0-9]/.test(file))
      for (const text of texts) {
        expect(pageFields(file, text)).toEqual(before(file, text))
        expect(suiteState(text)).toBe(suiteBefore(text))
      }
    }
  })
  it("answers as the replaced expressions on mixed generated Markdown", () => {
    const units = ["# ", "Title", "\r", "\n", "\u2028", "\u2029", "**", "Ruling:", "Rulings:", "Status:", "VL-", "7", "003",
      "2026-", "12-", "34", "replaced", "SUPERSEDED", "in PROGRESS", " ", "x", "\ud800", "\u017f", "\u212a"]
    let state = 28
    const next = () => (state = (Math.imul(state, 1664525) + 1013904223) >>> 0)
    for (let n = 0; n < 8000; n++) {
      let text = ""
      for (let i = next() % 25; i > 0; i--) text += units[next() % units.length]
      expect(pageFields("decisions/0018-proofs.md", text)).toEqual(before("decisions/0018-proofs.md", text))
      expect(suiteState(text)).toBe(suiteBefore(text))
    }
  })
  it("scans large pages, status fields and digit runs without exhausting the call stack", () => {
    for (const text of ["x".repeat(100000) + "\n# Title", "**Status:**" + "x".repeat(100000) + "in progress",
      "Rulings: VL-" + "7".repeat(100000)]) {
      expect(pageFields("decisions/0018-proofs.md", text)).toEqual(before("decisions/0018-proofs.md", text))
      expect(suiteState(text)).toBe(suiteBefore(text))
    }
  })
})

import * as Scan from "../src/core/wikiBuildDecision.vibe"

describe("the wiki scan specifications", () => {
  it("classifies digits, line ends and ASCII folding on every UTF-16 unit", () => {
    for (let unit = 0; unit < 65536; unit++) {
      const text = String.fromCharCode(unit)
      expect(Scan.digitAt(unit)).toBe(/[0-9]/.test(text))
      expect(Scan.terminatorUnit(unit)).toBe(/[\n\r\u2028\u2029]/.test(text))
      expect(Scan.foldedUnit(unit)).toBe(/[A-Z]/.test(text) ? text.toLowerCase().charCodeAt(0) : unit)
    }
  })
  it("reads ids and labels outside the numbered-decision case too", () => {
    for (const id of ["", "short", "abcdefghijx", "abcdefghij1234-x", "abcdefghij1234x", "decisions/99-x",
      "decisions/x234-x", "decisions/1x34-x", "decisions/12x4-x", "decisions/123x-x"]) {
      expect(Scan.decisionLabel(id)).toBe(id.slice(10).replace(/^(\d{4})-/, "$1 "))
    }
    expect([Scan.valueStart("a**b", 1), Scan.valueStart("a*b", 1), Scan.valueStart("", -1)]).toEqual([3, 1, -1])
    expect([Scan.earlier(-1, -1), Scan.earlier(-1, 3), Scan.earlier(3, -1), Scan.earlier(3, 4),
      Scan.earlier(4, 3), Scan.earlier(3, 3)]).toEqual([-1, 3, 3, 3, 3, 3])
  })
  it("reads complete lines, keys, dates and rulings at valid and absent positions", () => {
    const texts = ["", "plain", "# ", "#  ", "# Title", "x\n# A\r\n# B", "x# T\n# B", "\r# C\u2028# D\u2029tail",
      "**Status:** in PROGRESS\nRulings: VL-7 VL-2 VL-7", "Status:**Replaced\n2026-12-34 and 2026-01-02",
      "VL-0xVL-123 9x", "2026-0x-12", "9", "VL-x", "***Status:*** superseded", "**Status:**", "# Title\n", "x\n"]
    const heading = /^# (.+)$/gm
    const ruling = /VL-[0-9]+/y
    const date = /2026-\d\d-\d\d/y
    for (const text of texts) {
      expect(Scan.headingTitle(text)).toBe(/^# (.+)$/m.exec(text)?.[1] ?? "")
      expect(Scan.findDate(text)).toBe(/2026-\d\d-\d\d/.exec(text)?.[0] ?? "")
      expect(Scan.findRulings(text)).toEqual(text.match(/VL-[0-9]+/g) ?? [])
      for (const key of ["", "Status:", "**Status:**", "VL-", "missing"]) expect(Scan.findKey(text, key)).toBe(text.indexOf(key))
      const status = /(?:\*\*)?Status:(?:\*\*)?([^\n]*)/.exec(text)
      expect(Scan.fieldValue(text, "Status:")).toBe(status === null ? -1 : status.index + status[0].length - status[1]!.length)
      const keyAt = text.indexOf("**Status:**")
      expect(Scan.keyValue(text, "**Status:**")).toBe(keyAt < 0 ? -1 : keyAt + 11)
      for (const at of [-1, 0, 1, text.length, text.length + 1]) {
        const lineEnd = at < 0 || at >= text.length ? at : at + /^[^\n\r\u2028\u2029]*/.exec(text.slice(at))![0].length
        expect(Scan.lineEnd(text, at)).toBe(lineEnd)
        expect(Scan.findLineEnd(text, at)).toBe(lineEnd)
        const feed = at < 0 || at >= text.length ? at : at + /^[^\n]*/.exec(text.slice(at))![0].length
        expect(Scan.feedFrom(text, at)).toBe(feed)
        expect(Scan.findFeed(text, at)).toBe(feed)
        expect(Scan.lineStart(text, at)).toBe(at === 0 || (0 < at && at <= text.length && /[\n\r\u2028\u2029]/.test(text.charAt(at - 1))))
        expect(Scan.headingAt(text, at)).toBe(at >= 0 && /^# ./.test(text.slice(at)))
        heading.lastIndex = at
        const h = at < 0 ? null : heading.exec(text)
        expect(Scan.firstHeading(text, at)).toBe(h?.index ?? -1)
        expect(Scan.fieldText(text, at)).toBe(at < 0 || at > text.length ? "" : text.slice(at).split("\n")[0])
        for (const key of ["", "Status:", "VL-", "missing"]) {
          expect(Scan.keyAt(text, at, key)).toBe(at >= 0 && at + key.length <= text.length && text.startsWith(key, at))
          expect(Scan.keyFrom(text, at, key)).toBe(at < 0 || at > text.length ? -1 : text.indexOf(key, at))
        }
        ruling.lastIndex = at
        const r = at < 0 ? null : ruling.exec(text)
        const end = r === null ? -1 : at + r[0].length
        expect(Scan.rulingEnd(text, at)).toBe(end)
        expect(Scan.findRulingEnd(text, at)).toBe(end)
        const digits = at < 0 || at >= text.length ? at : at + /^[0-9]*/.exec(text.slice(at))![0].length
        expect(Scan.digitsEnd(text, at)).toBe(digits)
        expect(Scan.findDigitsEnd(text, at)).toBe(digits)
        expect(Scan.rulingsFrom(text, at)).toEqual(at < 0 ? [] : text.slice(at).match(/VL-[0-9]+/g) ?? [])
        date.lastIndex = at
        const d = at < 0 ? null : date.exec(text)
        expect(Scan.dateAt(text, at)).toBe(d !== null)
        expect(Scan.firstDate(text, at)).toBe(at < 0 ? "" : /2026-\d\d-\d\d/.exec(text.slice(at))?.[0] ?? "")
      }
    }
  })
  it("matches the case-insensitive status words at offsets and across whole fields", () => {
    const words = ["replaced", "superseded", "in progress", ""]
    const patterns = [/replaced/iy, /superseded/iy, /in progress/iy, /(?:)/iy]
    for (const text of ["", "REPLACED", "a Superseded", "in PROGRESS", "replacex", "x", "\u017fuperseded", "\u212a"]) {
      for (let n = 0; n < words.length; n++) {
        const word = words[n]!
        for (const at of [-1, 0, 1, text.length, text.length + 1]) {
          const re = patterns[n]!
          re.lastIndex = at
          const exact = at < 0 || at > text.length ? false : re.exec(text) !== null
          expect(Scan.foldedAt(text, at, word, 0)).toBe(exact)
          let includes = false
          if (at >= 0) for (let i = at; i + word.length <= text.length; i++) {
            re.lastIndex = i
            if (re.exec(text) !== null) { includes = true; break }
          }
          expect(Scan.foldedIncludes(text, at, word)).toBe(includes)
        }
        expect(Scan.findFolded(text, word)).toBe(Scan.foldedIncludes(text, 0, word))
      }
    }
  })
})
