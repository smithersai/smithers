import { describe, expect, it } from "@effect/vitest"
import * as D from "../src/web/modelDecision.vibe"

describe("web update decisions", () => {
  it("names the failed account operation", () => {
    expect(D.accountFailureText("grant")).toBe("Role change failed.")
    expect(D.accountFailureText("people")).toBe("People couldn’t load.")
    expect(D.accountFailureText("sign-out")).toBe("Sign out failed.")
    expect(D.accountFailureText("sign-in")).toBe(D.accountFailureText("roles"))
  })
  it("routes account retries", () => {
    expect(D.accountRetryPlan("roles")).toBe("resume")
    expect(D.accountRetryPlan("sign-in")).toBe("sign-in")
    for (const retry of ["people", "grant", "sign-out"] as const) expect(D.accountRetryPlan(retry)).toBe("command")
  })
  it("gates sign-in and the role dialog", () => {
    expect(D.signInRefused(true, true)).toBe(true)
    expect(D.signInRefused(false, true)).toBe(false)
    expect(D.signInRefused(true, false)).toBe(false)
    expect(D.canSelectRole("maintainer")).toBe(true)
    expect(D.canSelectRole("contributor")).toBe(false)
    expect(D.roleDialogCloses("contributor", "user-1")).toBe(true)
    expect(D.roleDialogCloses("maintainer", "user-1")).toBe(false)
    expect(D.roleDialogCloses("contributor", "")).toBe(false)
  })
  it("sizes the people pane", () => {
    expect(D.peopleOpened(true)).toBe("max")
    expect(D.peopleOpened(false)).toBe("pane")
    expect(D.peopleToggled("max")).toBe("pane")
    expect(D.peopleToggled("pane")).toBe("max")
    expect(D.peopleToggled("closed")).toBe("max")
  })
  it("detects account and role changes", () => {
    expect(D.accountChanged("a", "a", "community", "community")).toBe(false)
    expect(D.accountChanged("b", "a", "community", "community")).toBe(true)
    expect(D.accountChanged("a", "a", "maintainer", "community")).toBe(true)
    expect(D.roleGrantApplied(2, 1, 3, 2)).toBe(true)
    expect(D.roleGrantApplied(1, 1, 3, 2)).toBe(false)
    expect(D.roleGrantApplied(2, 1, 2, 2)).toBe(false)
  })
  it("fences stale action responses, reading an absent epoch as zero", () => {
    expect(D.actionsEpochCurrent(null, null)).toBe(true)
    expect(D.actionsEpochCurrent(null, 0)).toBe(true)
    expect(D.actionsEpochCurrent(0, null)).toBe(true)
    expect(D.actionsEpochCurrent(1, null)).toBe(false)
    expect(D.actionsEpochCurrent(null, 1)).toBe(false)
    expect(D.actionsEpochCurrent(2, 2)).toBe(true)
    expect(D.actionsEpochCurrent(2, 3)).toBe(false)
    expect(D.actionsFailureApplies(null, 7)).toBe(true)
    expect(D.actionsFailureApplies(7, 7)).toBe(true)
    expect(D.actionsFailureApplies(6, 7)).toBe(false)
    expect(D.actionsFailureApplies(0, null)).toBe(true)
    expect(D.actionsFailureApplies(1, null)).toBe(false)
  })
  it("keeps the actions clock monotone", () => {
    expect(D.actionsClock(5, 9)).toBe(9)
    expect(D.actionsClock(9, 5)).toBe(9)
  })
  it("wraps the slash highlight and stays in range after the menu shrinks", () => {
    expect(D.slashHighlight(0, 1, 0)).toBe(0)
    expect(D.slashHighlight(0, 1, 3)).toBe(1)
    expect(D.slashHighlight(2, 1, 3)).toBe(0)
    expect(D.slashHighlight(0, -1, 3)).toBe(2)
    expect(D.slashHighlight(9, 1, 3)).toBeLessThan(3)
    expect(D.slashHighlight(9, -1, 3)).toBeGreaterThanOrEqual(0)
  })
  it("settles an issue response only for its own retry", () => {
    expect(D.issueResponseSettles(null, null, "new", "k")).toBe(true)
    expect(D.issueResponseSettles("new", "k", "new", "k")).toBe(true)
    expect(D.issueResponseSettles("new", "k", "new", "other")).toBe(false)
    expect(D.issueResponseSettles("new", "k", "comment", "k")).toBe(false)
    expect(D.issueResponseSettles("new", "k", null, null)).toBe(false)
  })
  it("applies issue details only to the selected issue, at or past the current sequence", () => {
    expect(D.issueDetailsApply(4, 4, 8, 8)).toBe(true)
    expect(D.issueDetailsApply(4, 5, 8, 8)).toBe(false)
    expect(D.issueDetailsApply(4, 4, 7, 8)).toBe(false)
    expect(D.issueDetailsFailureShows(4, 4, false)).toBe(true)
    expect(D.issueDetailsFailureShows(4, 5, false)).toBe(false)
    expect(D.issueDetailsFailureShows(4, 4, true)).toBe(false)
  })
  it("lets only the latest loading wiki request fail", () => {
    expect(D.wikiFailureApplies(2, 2, true)).toBe(true)
    expect(D.wikiFailureApplies(1, 2, true)).toBe(false)
    expect(D.wikiFailureApplies(2, 2, false)).toBe(false)
  })
  it("decides sandbox minute notices and the running transition", () => {
    expect(D.sandboxOutOfMinutes(0, "s", "stopped")).toBe(true)
    expect(D.sandboxOutOfMinutes(0, "", "stopped")).toBe(false)
    expect(D.sandboxOutOfMinutes(0, "s", "running")).toBe(false)
    expect(D.sandboxOutOfMinutes(1, "s", "stopped")).toBe(false)
    expect(D.sandboxLowMinutes(10, null, 100)).toBe(true)
    expect(D.sandboxLowMinutes(11, null, 100)).toBe(false)
    expect(D.sandboxLowMinutes(0, null, 100)).toBe(false)
    expect(D.sandboxLowMinutes(5, 100, 100)).toBe(false)
    expect(D.sandboxPaneOpens("running", "stopped")).toBe(true)
    expect(D.sandboxPaneOpens("running", null)).toBe(true)
    expect(D.sandboxPaneOpens("running", "running")).toBe(false)
    expect(D.sandboxPaneOpens("stopped", null)).toBe(false)
  })
})
