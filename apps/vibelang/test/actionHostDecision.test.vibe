import { describe, expect, it } from "@effect/vitest"
import { actionActor, indexedRun, matchingFlow, mockState, ownerRefused, sameRun } from "../src/actions/actionHostDecision.vibe"

describe("action hosts' decisions", () => {
  it("passes only a successful non-refusal; a refusal or an engine failure fails", () => {
    expect([mockState(true, false), mockState(true, true), mockState(false, false), mockState(false, true)]).toEqual(["passed", "failed", "failed", "failed"])
  })
  it("allows viewer work across owners and requires the same owner for writes", () => {
    expect([ownerRefused("viewer", "old", "new"), ownerRefused("contributor", "old", "new"), ownerRefused("maintainer", "same", "same")]).toEqual([false, true, false])
  })
  it("records agent doors as agent actions while retaining a person's button action", () => {
    expect([actionActor("agent", "person"), actionActor("button", "agent"), actionActor("button", "person")]).toEqual(["agent", "agent", "person"])
  })
  it("lists every flow only when the filter is empty", () => {
    expect([matchingFlow("", "Post"), matchingFlow("Post", "Post"), matchingFlow("Tour", "Post")]).toEqual([true, true, false])
  })
  it("lists a run once from its own index and keeps an unindexed child", () => {
    expect([indexedRun("own", "own", true), indexedRun("child", "parent", true), indexedRun("child", "parent", false)]).toEqual([true, false, true])
    expect([indexedRun("", undefined, true), indexedRun("", undefined, false)]).toEqual([false, true])
  })
  it("reads and follows exactly the requested run", () => {
    expect([sameRun("a1", "a1"), sameRun("a2", "a1"), sameRun("", "")]).toEqual([true, false, true])
  })
})
