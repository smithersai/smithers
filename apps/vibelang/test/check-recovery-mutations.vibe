// Retain the review's counterexamples: both suites must reject removal of either recovery mechanism, each failing
// exactly the cases it breaks (the fault they recover from) while every other case passes.
// Run with no other build/test process writing this workspace. The source is restored however the run ends.
//   node --import=vibelang/register test/check-recovery-mutations.vibe [--browser]
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { run } from "./support/processes.vibe"
import { MUTATIONS, killed } from "./support/recoveryMutations.vibe"

/** A mutation that no longer matches the recovery code, or a suite that didn't reject exactly the cases it breaks. */
error Survived { message: string }

export effect function main() {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const configured = try Config.option(Config.String("VIBELANG_MUTATION_LOG_DIR"))
  const directory = Option.isSome(configured) ? configured.value : try fs.makeTempDirectory({ prefix: "vl-recovery-" })
  try fs.makeDirectory(directory, { recursive: true })
  const suites: Array<readonly [string, ReadonlyArray<string>]> = [["runtime", ["exec", "vitest", "run", "test/recovery.runtime.test.vibe"]]]
  if ((try (try Stdio.Stdio).args).includes("--browser")) {
    suites.push(["browser", ["exec", "playwright", "test", "e2e/recovery.spec.ts", "--project=dark", "--workers=1"]])
  }
  for (const { name: mutation, file, mutate, breaks } of MUTATIONS) {
    const source = try path.fromFileUrl(new URL("../src/web/" + file, import.meta.url))
    const original = try fs.readFileString(source)
    const broken = mutate(original)
    if (broken === original) throw new Survived({ message: `Mutation ${mutation} did not match ${file}` })
    try ensuring(effect {
      try fs.writeFileString(source, broken)
      for (const [suite, args] of suites) {
        const result = try timeout(run("pnpm", args), suite === "browser" ? "15 minutes" : "180 seconds")
        const output = result.stdout + result.stderr
        const log = path.join(directory, `${mutation}-${suite}.log`)
        try fs.writeFileString(log, output)
        if (result.status !== 1 || !killed(output, breaks)) {
          throw new Survived({ message: `${mutation}/${suite} did not reject exactly its affected behavior: ${log}` })
        }
        try Console.log(`Killed ${mutation}/${suite}: its cases failed, the rest passed (${log})`)
      }
    }, Effect.orDie(fs.writeFileString(source, original)))
  }
}

NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
