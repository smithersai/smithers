// @vitest-environment node
// worker/Issues.vibe's real GitHub host against a stateful URL-level fake: the read's parents, labels, timeline
// notes and comments, and the new/comment/link/commit/uncommit writes with their re-reads. No network.
import { describe, expect, it } from "@effect/vitest"
import { HttpClient, HttpClientRequest, HttpClientResponse, HttpServerResponse } from "effect/http"
import { Redacted } from "effect"
import type { Storage } from "../worker/Objects.vibe"
import { objectStorage } from "./support/objectStorage.ts"
import * as Issues from "../worker/Issues.vibe"
import type { IssueRequest } from "../src/core/issueSchemas.vibe"

const repo: Issues.Repository = { owner: "o", name: "r", api: "https://github.test", agent: "agent-bot" }
const principal: Issues.Principal = { id: "7", login: "ada", role: "maintainer", token: Redacted.make("token") }
const authority: Issues.IssueAuthority["Service"] = { current: () => succeed(principal) }

interface FakeIssue {
  id: number
  node_id: string
  number: number
  title: string
  body: string
  state: "open" | "closed"
  state_reason: null
  user: { id: number; login: string }
  labels: Array<{ name: string }>
  comments: number
  created_at: string
  updated_at: string
  closed_at: string | null
  assignees: Array<{ id: number; login: string }>
  parent_issue_url?: string
}

/** A small GitHub: issues, their comments and timelines, labels and sub-issues, recording every write. */
function fakeGitHub() {
  const writes: Array<string> = []
  const issues: Array<FakeIssue> = [
    { id: 701, node_id: "n701", number: 7, title: "task one", body: "do the thing", state: "open", state_reason: null, user: { id: 7, login: "ada" }, labels: [{ name: "vibelang:task" }, { name: "vibelang:running" }], comments: 2, created_at: "2026-01-02T00:00:00Z", updated_at: "2026-01-02T00:00:00Z", closed_at: null, assignees: [{ id: 7, login: "ada" }] },
    { id: 901, node_id: "n901", number: 9, title: "child task", body: "part of one", state: "closed", state_reason: null, user: { id: 1, login: "will" }, labels: [{ name: "vibelang:task" }], comments: 0, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", closed_at: "2026-01-04T00:00:00Z", assignees: [{ id: 1, login: "will" }] },
  ]
  const comments: Record<number, Array<Record<string, unknown>>> = {
    7: [
      { id: 5001, node_id: "c5001", created_at: "2026-01-02T01:00:00Z", updated_at: "2026-01-02T01:00:00Z", issue_url: "https://github.test/repos/o/r/issues/7", user: { id: 1, login: "will" }, body: "first note" },
      { id: 5002, node_id: "c5002", created_at: "2026-01-02T02:00:00Z", updated_at: "2026-01-02T02:00:00Z", issue_url: "https://github.test/repos/o/r/issues/7", user: null, body: "ghost note" },
    ],
  }
  const timelines: Record<number, Array<Record<string, unknown>>> = {
    7: [
      { event: "labeled", actor: { id: 1, login: "will" }, created_at: "2026-01-02T00:10:00Z", label: { name: "vibelang:task" } },
      { event: "assigned", actor: { id: 1, login: "will" }, created_at: "2026-01-02T00:20:00Z", assignee: { id: 7, login: "ada" } },
      { event: "mentioned", actor: { id: 1, login: "will" }, created_at: "2026-01-02T00:30:00Z" },
    ],
  }
  let nextNumber = 42
  let nextId = 4200

  const answer = (request: HttpClientRequest.HttpClientRequest, status: number, data: unknown) =>
    HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.jsonUnsafe(data, { status })))

  const route = effect (request: HttpClientRequest.HttpClientRequest) => {
    const url = new URL(request.url)
    const path = url.pathname
    const issueMatch = /^\/repos\/o\/r\/issues\/(\d+)$/.exec(path)
    const commentsMatch = /^\/repos\/o\/r\/issues\/(\d+)\/comments$/.exec(path)
    const timelineMatch = /^\/repos\/o\/r\/issues\/(\d+)\/timeline$/.exec(path)
    const subIssuesMatch = /^\/repos\/o\/r\/issues\/(\d+)\/sub_issues$/.exec(path)
    const labelsMatch = /^\/repos\/o\/r\/issues\/(\d+)\/labels$/.exec(path)
    const removeMatch = /^\/repos\/o\/r\/issues\/(\d+)\/labels\/(.+)$/.exec(path)
    let body: Record<string, unknown> = {}
    if (request.method !== "GET" && request.method !== "DELETE") {
      const web = try HttpClientRequest.toWeb(request)
      body = (try promise(() => web.json())) as Record<string, unknown>
    }
    if (path === "/repos/o/r/issues" && request.method === "GET") return answer(request, 200, issues)
    if (path === "/repos/o/r/issues" && request.method === "POST") {
      const made: FakeIssue = {
        id: nextId++, node_id: `n${nextId}`, number: nextNumber++, title: String(body.title ?? ""), body: String(body.body ?? ""),
        state: "open", state_reason: null, user: { id: 7, login: "ada" }, labels: [], comments: 0,
        created_at: "2026-01-05T00:00:00Z", updated_at: "2026-01-05T00:00:00Z", closed_at: null, assignees: [],
      }
      issues.push(made)
      writes.push(`create:${made.number}:${made.title}`)
      return answer(request, 201, made)
    }
    if (commentsMatch !== null && request.method === "GET") return answer(request, 200, comments[Number(commentsMatch[1])] ?? [])
    if (commentsMatch !== null && request.method === "POST") {
      const number = Number(commentsMatch[1])
      const list = comments[number] ?? (comments[number] = [])
      const made = { id: 5000 + list.length + 1, node_id: `c${5000 + list.length + 1}`, created_at: "2026-01-05T00:00:00Z", updated_at: "2026-01-05T00:00:00Z", issue_url: `https://github.test/repos/o/r/issues/${number}`, user: { id: 7, login: "ada" }, body: String(body.body ?? "") }
      list.push(made)
      writes.push(`comment:${number}`)
      return answer(request, 201, made)
    }
    if (timelineMatch !== null && request.method === "GET") return answer(request, 200, timelines[Number(timelineMatch[1])] ?? [])
    if (path === "/repos/o/r/assignees" && request.method === "GET") {
      return answer(request, 200, [{ id: 1, login: "will" }, { id: 7, login: "ada" }, { id: 3, login: "agent-bot" }])
    }
    if (subIssuesMatch !== null && request.method === "POST") {
      const child = issues.find((issue) => issue.id === Number(body.sub_issue_id))
      if (child !== undefined) child.parent_issue_url = `https://github.test/repos/o/r/issues/${subIssuesMatch[1]}`
      writes.push(`link:${subIssuesMatch[1]}:${String(body.sub_issue_id)}`)
      return answer(request, 200, child ?? {})
    }
    if (labelsMatch !== null && request.method === "POST") {
      const issue = issues.find((one) => one.number === Number(labelsMatch[1]))
      for (const name of (body.labels as Array<string> | undefined) ?? []) if (issue !== undefined && !issue.labels.some((label) => label.name === name)) issue.labels.push({ name })
      writes.push(`addLabels:${labelsMatch[1]}`)
      return answer(request, 200, [])
    }
    if (removeMatch !== null && request.method === "DELETE") {
      const issue = issues.find((one) => one.number === Number(removeMatch[1]))
      const name = (removeMatch[2] ?? "").replaceAll("%3A", ":")
      if (issue !== undefined) issue.labels = issue.labels.filter((label) => label.name !== name)
      writes.push(`removeLabel:${removeMatch[1]}:${name}`)
      return answer(request, 200, [])
    }
    if (path === "/repos/o/r/labels" && request.method === "POST") {
      writes.push(`createLabel:${String(body.name)}`)
      return answer(request, 201, { name: body.name })
    }
    if (issueMatch !== null && request.method === "GET") {
      const found = issues.find((issue) => issue.number === Number(issueMatch[1]))
      return answer(request, found === undefined ? 404 : 200, found ?? { message: "Not Found" })
    }
    if (issueMatch !== null && request.method === "PATCH") {
      const found = issues.find((issue) => issue.number === Number(issueMatch[1]))
      if (found !== undefined && Array.isArray(body.assignees)) found.assignees = (body.assignees as Array<string>).map((login, index) => ({ id: index + 1, login }))
      writes.push(`update:${issueMatch[1]}:${JSON.stringify(body.assignees ?? null)}`)
      return answer(request, 200, found ?? {})
    }
    return try Effect.die(`no route: ${request.method} ${path}`)
  }
  const client = HttpClient.make((request) => Effect.orDie(route(request)))
  return { client, writes, issues }
}

const read = (over: Partial<IssueRequest>): IssueRequest => ({ op: "read", number: 0, parent: 0, title: "", text: "", assignee: "", example: "", prior: "", key: "k1", ...over })

/** The object's execute against the fake GitHub, over fresh in-memory storage. */
effect function driving(client: HttpClient.HttpClient) {
  const storage = (try Effect.try(() => objectStorage())) as unknown as Storage
  return (request: IssueRequest) => Issues.executeIssues("h", storage, request, repo).pipe(
    Effect.provideService(Issues.IssueAuthority, authority),
    Effect.provideService(HttpClient.HttpClient, client),
  )
}

describe("the GitHub issues host", () => {
  it.live("reads, writes and re-reads: parents, notes, assignees and the label writes", () => effect {
    const { client, writes } = fakeGitHub()
    const perform = try driving(client)
    const first = try perform(read({ key: "r1" }))
    const seven = first.items.find((issue) => issue.number === 7)!
    const nine = first.items.find((issue) => issue.number === 9)!
    try Effect.try(() => {
      expect(first.items.map((issue) => issue.number)).toEqual([9, 7])
      expect(seven.task).toBe("Running")
      expect(seven.assignee).toBe("ada")
      expect(nine.task).toBe("Done")
      expect(nine.parent).toBe(0)
      expect((first.assignees ?? []).map((choice) => choice.label)).toEqual(["VibeLang agent", "ada", "will"])
      expect(first.absoluteDates).toBe(true)
    })
    const detail = try perform(read({ number: 7, key: "r2" }))
    const detailed = detail.items.find((issue) => issue.number === 7)!
    try Effect.try(() => {
      expect(detailed.notes.map((note) => note.text)).toEqual([
        "added the vibelang:task label",
        "assigned ada",
        "first note",
        "ghost note",
      ])
      expect(detailed.notes[3]?.author).toBe("deleted")
    })
    const made = try perform(read({ op: "new", title: "write one", text: "its body", key: "k2" }))
    try Effect.try(() => {
      expect(writes).toContain("create:42:write one")
      expect(made.selected).toBe(42)
      expect(made.items.some((issue) => issue.number === 42 && issue.title === "write one")).toBe(true)
    })
    const commented = try perform(read({ op: "comment", number: 7, text: "a note", key: "k3" }))
    try Effect.try(() => {
      expect(writes).toContain("comment:7")
      expect(commented.items.find((issue) => issue.number === 7)?.notes.some((note) => note.text === "a note")).toBe(true)
    })
    const linked = try perform(read({ op: "link", number: 9, parent: 7, key: "k4" }))
    try Effect.try(() => {
      expect(writes.some((write) => write.startsWith("link:7:"))).toBe(true)
      expect(linked.items.find((issue) => issue.number === 9)?.parent).toBe(7)
    })
    const committed = try perform(read({ op: "commit", number: 7, assignee: "ada", key: "k5" }))
    try Effect.try(() => {
      expect(writes).toContain('update:7:["ada"]')
      expect(writes).toContain("createLabel:vibelang:task")
      expect(writes).toContain("addLabels:7")
      expect(writes).toContain("removeLabel:7:vibelang:running")
      expect(committed.items.find((issue) => issue.number === 7)?.task).toBe("Queued")
    })
    const uncommitted = try perform(read({ op: "uncommit", number: 7, assignee: "ada", key: "k6" }))
    try Effect.try(() => {
      expect(writes).toContain("update:7:[]")
      expect(writes).toContain("removeLabel:7:vibelang:task")
      expect(uncommitted.items.find((issue) => issue.number === 7)?.task).toBe("")
    })
  }, 60_000)

  it.live("refuses the empty and the missing before any write", () => effect {
    const { client, writes } = fakeGitHub()
    const perform = try driving(client)
    const emptyTitle = try Effect.flip(perform(read({ op: "new", title: " ", key: "k2" })))
    const emptyComment = try Effect.flip(perform(read({ op: "comment", number: 7, text: " ", key: "k3" })))
    const missing = try Effect.flip(perform(read({ op: "comment", number: 99, text: "hi", key: "k4" })))
    const badLink = try Effect.flip(perform(read({ op: "link", number: 7, parent: 7, key: "k5" })))
    try Effect.try(() => {
      expect([emptyTitle, emptyComment, missing, badLink].map((error) => error._tag === "IssueFailure" ? error.reason : error._tag)).toEqual(["title", "empty", "missing", "tree"])
      expect(writes).toEqual([])
    })
  }, 60_000)
})
