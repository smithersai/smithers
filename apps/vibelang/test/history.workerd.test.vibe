// The History object in local workerd (wiki/decisions/0020-mythical-history.md): the API Worker's real routes, the real
// sequencer over the object's storage, the bootstrap on first start, and each write's flow on the engine in the
// object's SQLite, through the raw protocol and `LiveMythical`. Every HTTP caller is a viewer until sign-in lands, so
// every write is refused `forbidden` and changes nothing.
import * as NodeServices from "@effect/platform-node/NodeServices"
import { afterAll, beforeAll, describe, expect, it } from "@effect/vitest"
import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { LiveMythical } from "../src/history/LiveMythical.vibe"
import { Mythical } from "../src/history/MythicalHistory.vibe"
import { PAGE } from "../src/history/pages.vibe"
import { CommitPage, EpicPage, Matches, Outline } from "../src/history/schemas.vibe"
import { serveApi, type Served } from "./support/workerd.vibe"

const platform = Layer.mergeAll(NodeServices.layer, FetchHttpClient.layer)

/** `origin` + `path` answered: a GET, or a POST of `body`. */
effect function at(origin: string, path: string, body?: string) {
  const client = try HttpClient.HttpClient
  return try client.execute(body === undefined
    ? HttpClientRequest.get(origin + path)
    : HttpClientRequest.post(origin + path).pipe(HttpClientRequest.bodyText(body, "application/json")))
}

describe("the History object in local workerd", () => {
  let api: Served | undefined
  beforeAll(async () => { api = await runPromise(serveApi()) }, 120_000)
  afterAll(async () => { await api?.dispose() })

  it.live("loads VibeLang's bootstrapped history on its first start, as a flow, once", () => effect {
    provide platform {
      const origin = api!.origin
      const response = try at(origin, "/api/history")
      const text = try response.text
      const outline = try Schema.decodeUnknownEffect(Schema.fromJsonString(Outline))(text)
      const again = try Schema.decodeUnknownEffect(Outline)(try (try at(origin, "/api/history")).json)
      const runs = try (try at(origin, "/runs/history")).json
      try Effect.try(() => {
        expect(response.status).toBe(200)
        expect(outline.epics.length).toBe(11)
        expect(outline.epics.reduce((total, epic) => total + epic.folds, 0)).toBeGreaterThan(6000)
        // The first view is the outline alone, not the 3 MB history.
        expect(text.length).toBeLessThan(16 * 1024)
        expect(again.seq).toBe(outline.seq)
        expect(runs).toEqual([{ run_id: "bootstrap/first-start", status: "completed" }])
      })
    }
  })

  it.live("refuses every write to a viewer as a flow, and the history is unchanged", () => effect {
    provide platform {
      const origin = api!.origin
      const before = try (try at(origin, "/api/history")).json
      const plan = JSON.stringify({ how: "append", epic: "e1", newEpic: "", target: "", title: "fix(compiler): x", task: "t" })
      const answers = [
        try at(origin, "/api/history/plan", plan),
        try at(origin, "/api/history/start", JSON.stringify({ id: "m1", lane: "a" })),
        try at(origin, "/api/history/note", JSON.stringify({ id: "m1", section: "tried", text: "x" })),
        try at(origin, "/api/history/approve", JSON.stringify({ id: "m1" })),
        try at(origin, "/api/history/fold", "{}"),
      ]
      const statuses = answers.map((answer) => answer.status)
      const bodies: Array<unknown> = []
      for (const answer of answers) bodies.push(try answer.json)
      const after = try (try at(origin, "/api/history")).json
      const runs = (try (try at(origin, "/runs/history")).json) as ReadonlyArray<{ readonly run_id: string; readonly status: string }>
      try Effect.try(() => {
        expect(statuses).toEqual([403, 403, 403, 403, 403])
        expect(bodies).toEqual(Array(5).fill({ refusal: "forbidden" }))
        expect(after).toEqual(before)
        expect(runs.filter((run) => run.run_id.startsWith("history-")).map((run) => [run.run_id.split("/")[0], run.status])).toEqual([
          ["history-plan", "completed"], ["history-start", "completed"], ["history-note", "completed"],
          ["history-approve", "completed"], ["history-fold", "completed"],
        ])
      })
    }
  })

  it.live("reads an epic by page, a commit in full and a search, each small", () => effect {
    provide platform {
      const origin = api!.origin
      const outline = try Schema.decodeUnknownEffect(Outline)(try (try at(origin, "/api/history")).json)
      const compiler = outline.epics.find((epic) => epic.title === "The compiler")!
      const firstText = try (try at(origin, `/api/history/epics/${compiler.id}`)).text
      const first = try Schema.decodeUnknownEffect(Schema.fromJsonString(EpicPage))(firstText)
      const second = try Schema.decodeUnknownEffect(EpicPage)(try (try at(origin, `/api/history/epics/${compiler.id}?from=${PAGE}`)).json)
      const commit = try Schema.decodeUnknownEffect(CommitPage)(try (try at(origin, `/api/history/commits/${first.commits[0]!.id}`)).json)
      const none = try Schema.decodeUnknownEffect(CommitPage)(try (try at(origin, "/api/history/commits/m999999")).json)
      const found = try Schema.decodeUnknownEffect(Matches)(try (try at(origin, `/api/history/search?q=${encodeURIComponent("register the computed-key match witness once")}`)).json)
      try Effect.try(() => {
        expect([first.from, first.total, first.commits.length]).toEqual([0, compiler.commits, PAGE])
        expect(firstText.length).toBeLessThan(32 * 1024)
        expect(second.from).toBe(PAGE)
        expect(second.commits[0]!.rank).toBeGreaterThan(first.commits[PAGE - 1]!.rank)
        expect(commit.commit!.id).toBe(first.commits[0]!.id)
        expect(commit.real.length).toBe(first.commits[0]!.folds)
        expect(none).toEqual({ seq: outline.seq, commit: null, real: [] })
        expect(found.commits.map((each) => each.title)).toContain("fix(fuzz): register the computed-key match witness once")
      })
    }
  })

  it.live("answers the protocol's errors: unknown writes, bad bodies and bad cursors", () => effect {
    provide platform {
      const origin = api!.origin
      const statuses = [
        (try at(origin, "/api/history/merge", "{}")).status,
        (try at(origin, "/api/history/plan", "{")).status,
        (try at(origin, "/api/history/plan", JSON.stringify({ how: "rebase", epic: "", newEpic: "", target: "", title: "x", task: "" }))).status,
        (try at(origin, "/api/history/note", JSON.stringify({ id: "m1", section: "lies", text: "x" }))).status,
        (try at(origin, "/api/history/events?after=-1")).status,
        (try at(origin, "/api/history/plan", "x".repeat(40_000))).status,
        (try at(origin, "/api/history/epics/e1?from=-1")).status,
        (try at(origin, "/api/history/epics/x1")).status,
        (try at(origin, "/api/history/commits/m1/notes")).status,
        (try at(origin, "/api/history/plan")).status,
      ]
      try Effect.try(() => expect(statuses).toEqual([404, 400, 400, 400, 400, 413, 404, 404, 404, 404]))
    }
  })

  it.live("lets a conversation's agent read the history by page and run its flows there, refused while its person is a viewer", () => effect {
    provide platform {
      const origin = api!.origin
      const outline = try (try at(origin, "/api/history")).json
      const shown = try (try at(origin, "/history-tool/agent-tools", JSON.stringify({ tool: "show", show: { what: "outline" } }))).json
      const commit = try Schema.decodeUnknownEffect(CommitPage)(
        try (try at(origin, "/history-tool/agent-tools", JSON.stringify({ tool: "show", show: { what: "commit", id: "m1" } }))).json,
      )
      const noted = try (try at(origin, "/history-tool/agent-tools", JSON.stringify({ tool: "note", id: "m1", text: "x." }))).json
      const runs = (try (try at(origin, "/runs/history")).json) as ReadonlyArray<{ readonly run_id: string; readonly status: string }>
      const after = try (try at(origin, "/api/history")).json
      try Effect.try(() => {
        expect(shown).toEqual(outline)
        expect(commit.commit!.id).toBe("m1")
        expect(noted).toEqual({ id: "", refusal: "forbidden" })
        // The note ran as the history's own flow, in the History object's engine, and changed nothing.
        expect(runs.filter((run) => run.run_id.startsWith("history-note")).length).toBeGreaterThan(0)
        expect(after).toEqual(outline)
      })
    }
  })

  it.live("serves LiveMythical: the same history, and a refusal typed as Refused", () => effect {
    provide platform {
      const result = try effect {
        provide LiveMythical(api!.origin) {
          const mythical = try Mythical
          const outline = try mythical.outline()
          const page = try mythical.epic("e1", 0)
          const commit = try mythical.commit(page.commits[0]!.id)
          const matches = try mythical.search(page.commits[0]!.title)
          const refusal = mythical.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "x", task: "" }) catch (error) =>
            error._tag === "Refused" ? error.refusal : error._tag
          return { epics: outline.epics.length, page: page.commits.length === Math.min(PAGE, outline.epics[0]!.commits), found: matches.commits.some((each) => each.id === commit.commit?.id), refusal }
        }
      }
      try Effect.try(() => expect(result).toEqual({ epics: 11, page: true, found: true, refusal: "forbidden" }))
    }
  })
})
