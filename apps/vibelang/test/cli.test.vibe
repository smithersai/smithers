// @vitest-environment node
import * as NodeServices from "@effect/platform-node/NodeServices"
import { expect, layer } from "@effect/vitest"
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { mockReply } from "../src/core/mockReplies.vibe"
import { unreachable } from "../src/surfaces/backend.vibe"
import { node, run } from "./support/processes.vibe"
import { cliPath, serverPath } from "./surface-host.vibe"

/** Nothing listens on the discard port: the live Factory there is unreachable. test/live.workerd.test.vibe serves one. */
const CLOSED = "http://127.0.0.1:9"

/** Each process gets up to this long; a hung one fails its case. */
const LIMIT = 30_000

/** The emitted CLI, run as its own executable, with `backend` as `VIBELANG_FACTORY`. */
effect function cli(args: ReadonlyArray<string>, backend = "") {
  return try run(try cliPath(), args, { VIBELANG_FACTORY: backend, VIBELANG_FACTORY_URL: CLOSED, NO_COLOR: "1" })
}

/** The JSON a command printed. */
effect function json(text: string) {
  return try Effect.try(() => JSON.parse(text))
}

const platform = Layer.mergeAll(NodeServices.layer, ExperimentalNodeServices.layer)

layer(platform)("built CLI process", (it) => {
  it.effect("reads and revises a specification through the shared flow and refuses VIP acceptance", () => effect {
    const read = try cli(["--mock", "--json", "issue", "read"])
    const revised = try cli(["--mock", "--json", "issue", "spec-revise", "--revision", "2", "--text", "CLI revision", "--key", "cli-spec"])
    const refused = try cli(["--mock", "--json", "issue", "accept", "--number", "45"])
    const initial = try json(read.stdout)
    const next = try json(revised.stdout)
    try Effect.try(() => {
      expect(read.status).toBe(0)
      expect(revised.status).toBe(0)
      expect(JSON.parse(initial.detail).specification.revision).toBe(2)
      expect(JSON.parse(next.detail).specification.astra.verdict).toBe("")
      expect(JSON.parse(next.detail).specification.revision).toBe(3)
      expect(refused.status).not.toBe(0)
    })
  }, LIMIT)

  it.effect("prints the complete reply and event numbers", () => effect {
    const result = try cli(["--mock", "ask", "How do I install it?"])
    try Effect.try(() => {
      expect(result.status).toBe(0)
      expect(result.stdout).toContain(mockReply("install"))
      expect(result.stdout).toMatch(/Events: 1, 2, 3/)
      expect(result.stderr).toBe("")
    })
  }, LIMIT)
  it.effect("supports JSON and global flags on either side of a subcommand", () => effect {
    const result = try cli(["ask", "install", "--json", "--mock", "--conversation", "docs"])
    const output = try json(result.stdout)
    try Effect.try(() => {
      expect(result.status).toBe(0)
      expect(output).toMatchObject({ conversation: "docs", text: mockReply("install") })
      expect(output.events[0]).toBe(1)
      expect(output.events.at(-1)).toBe(output.events.length)
      expect(result.stderr).toBe("")
    })
  }, LIMIT)
  it.effect("reads without waiting and honors the environment backend", () => effect {
    const result = try cli(["read", "--after", "0", "--json"], "mock")
    const output = try json(result.stdout)
    const plain = try cli(["--mock", "read"])
    try Effect.try(() => {
      expect(result.status).toBe(0)
      expect(output).toEqual({ conversation: "home", seq: 0, entries: [] })
      expect(plain.stdout).toBe("No entries. Event: 0\n")
    })
  }, LIMIT)
  it.effect.each([
    [["read"], "can't be reached"],
    [["--mock", "ask", " "], "message was refused: empty"],
    [["--mock", "read", "--after", "-1"], "after"],
    [["--mock", "ask"], "text"],
    [["--wat"], "wat"],
  ] as const)("fails with a plain error for %j", ([args, message]) => effect {
    const result = try cli(args)
    try Effect.try(() => {
      expect(result.status, result.stderr).toBe(1)
      expect(result.stderr).toContain(message)
    })
  }, LIMIT)
  it.effect.each([["--help"], ["ask", "--help"], ["--llms"]])("discovers %j without a backend", (args) => effect {
    const result = try cli(args)
    try Effect.try(() => {
      expect(result.status).toBe(0)
      expect(result.stdout).toContain("ask")
      expect(result.stdout).toContain(args[0] === "--llms" ? "inputSchema" : "--mock")
      expect(result.stderr).toBe("")
    })
  }, LIMIT)
  it.effect("keeps MCP startup errors on stderr and exits nonzero without a live backend", () => effect {
    const result = try run(try node(), [try serverPath()], { VIBELANG_FACTORY: "", VIBELANG_FACTORY_URL: CLOSED })
    try Effect.try(() => {
      expect(result.status).toBe(1)
      expect(result.stdout).toBe("")
      expect(result.stderr).toBe(`${unreachable(CLOSED)}\n`)
    })
  }, LIMIT)
  it.effect("ships a concise skill that describes both commands and backend lifetime", () => effect {
    const file = try (try Path.Path).fromFileUrl(new URL("../skills/vibelang-factory/SKILL.md", import.meta.url))
    const skill = try (try FileSystem.FileSystem).readFileString(file)
    try Effect.try(() => {
      expect(skill).toMatch(/^---\nname: vibelang-factory\ndescription: .+\n---/)
      expect(skill.split(/\s+/).length).toBeLessThan(600)
      for (const phrase of [" ask ", " read ", "--llms", "--json", "--mock", "one process"]) expect(skill).toContain(phrase)
    })
  })
})
