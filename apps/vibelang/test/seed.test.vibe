// The bootstrap of a mythical history from real history (wiki/decisions/0020-mythical-history.md): grouping, epics,
// notes, buckets, and the committed snapshot of VibeLang's own history, replayed through the real sequencer.
import { describe, expect, it } from "@effect/vitest"
import { MAX_NOTE, MAX_TITLE } from "../src/history/mythical.vibe"
import { History as HistorySchema } from "../src/history/schemas.vibe"
import {
  areaOf, BOOTSTRAP, bucketsOf, endsSentence, evidenceOf, FOUNDATIONS, intentsOf, type QueueEntry, type RawCommit, replay,
  sanitize, scopeOf, seedFrom, seedOf, titleOf, UNTITLED, wholeSentences,
} from "../src/history/seed.vibe"
import { HISTORY_JSON, REPOSITORY } from "../src/history/seed/vibelang.vibe"

/** A linear history of commits with these descriptions, oldest first. */
function linear(descriptions: ReadonlyArray<string>): ReadonlyArray<RawCommit> {
  return descriptions.map((description, index) => ({
    sha: `${index + 1}`.padStart(12, "a"),
    change: `c${index + 1}`,
    description,
    parents: index === 0 ? [] : [`${index}`.padStart(12, "a")],
  }))
}

function entry(id: string, state: string, titles: ReadonlyArray<string>, reason = ""): QueueEntry {
  return { id, lane: `lane-${id}`, state, reason, gate: state === "landed" ? `gate-${id}` : "", titles }
}

describe("reading commit messages", () => {
  it("takes a conventional scope, else a bare prefix, else nothing", () => {
    expect(scopeOf("fix(compiler): honor catches")).toBe("compiler")
    expect(scopeOf("fix(vite,unplugin): serve")).toBe("vite")
    expect(scopeOf("docs: describe")).toBe("docs")
    expect(scopeOf("mapper: read optional records")).toBe("mapper")
    expect(scopeOf("Parser: read records")).toBe("parser")
    expect(scopeOf("Add repository README")).toBe("")
  })

  it("puts a commit in the epic its scope names, and anything else in Foundations", () => {
    expect(areaOf("fix(compiler): a")).toBe("The compiler")
    expect(areaOf("test(fuzz): b")).toBe("Fuzzing")
    expect(areaOf("chore(release): c")).toBe("Release, CI and tooling")
    expect(areaOf("Add repository README")).toBe(FOUNDATIONS)
    expect(areaOf("weird(unknown-scope): d")).toBe(FOUNDATIONS)
  })

  it("keeps no local path or host in a note, and ends it as a sentence", () => {
    expect(sanitize("failed in /home/lane/vibe/mq/x.log on nyc-01, see ~/vl/a")).toBe("failed in <path> on <host>, see <path>.")
    expect(sanitize("a\n  b")).toBe("a b.")
    expect(sanitize("Tests pass (41).")).toBe("Tests pass (41).")
    expect(sanitize("Before: it fails;")).toBe("Before: it fails.")
  })

  it("bounds a note by whole sentences, never cutting one", () => {
    expect(wholeSentences("One is short. Two is longer than the rest. Three.", 20)).toBe("One is short.")
    expect(wholeSentences("One is short. Two is longer than the rest. Three.", 45)).toBe("One is short. Two is longer than the rest.")
    // An abbreviation or a path's dots end no sentence.
    expect(wholeSentences("See e.g. the docs. Then go test ./... runs. Done.", 25)).toBe("See e.g. the docs.")
    // A first sentence longer than the bound is kept whole up to the note's limit, else dropped.
    expect(wholeSentences(`${"word ".repeat(30)}end. Next.`, 20)).toBe(`${"word ".repeat(30)}end.`)
    expect(wholeSentences("x".repeat(MAX_NOTE + 1), 20)).toBe("")
    expect(wholeSentences(" , ", 20)).toBe("")
  })

  it("reads an evidence paragraph whole, with the lines it wraps onto", () => {
    // 4b88900e5414 in VibeLang: the seed once kept "Before: TestShortTargetsBudgeted fails for".
    const message = [
      "test(fuzz): budget the registry allowance fuzz target", "",
      "FuzzRegistryDeclarationAllowances lacked startShortBudget, so", "TestShortTargetsBudgeted failed on vibe.", "",
      "Before: TestShortTargetsBudgeted fails for", "FuzzRegistryDeclarationAllowances. After: it passes.", "",
    ].join("\n")
    expect(evidenceOf(message)).toEqual(["Before: TestShortTargetsBudgeted fails for FuzzRegistryDeclarationAllowances. After: it passes."])
    // A paragraph ends at a blank line, another `Key:` line or a list item.
    expect(evidenceOf("Tests: 3 pass,\nall green\nCo-Authored-By: someone\n- item\nAfter: ok\n- item\n\nprose")).toEqual([
      "Tests: 3 pass, all green.", "After: ok.",
    ])
  })

  it("reads evidence lines and titles a commit with no description", () => {
    expect(evidenceOf("fix: a\n\nValidation: unit and e2e\nTests: 12 passed\nOther: no\nRegression: fails before")).toEqual([
      "Validation: unit and e2e.", "Tests: 12 passed.", "Regression: fails before.",
    ])
    expect(titleOf("")).toBe(UNTITLED)
    expect(titleOf("  fix: a  \nbody")).toBe("fix: a")
  })
})

describe("buckets", () => {
  it("gives a merge's side commits to the merge, so every reachable commit is in exactly one bucket", () => {
    const commits: ReadonlyArray<RawCommit> = [
      { sha: "a", change: "", description: "one", parents: [] },
      { sha: "s1", change: "", description: "side one", parents: ["a"] },
      { sha: "b", change: "", description: "two", parents: ["a"] },
      { sha: "s2", change: "", description: "side two", parents: ["s1"] },
      { sha: "m", change: "", description: "merge", parents: ["b", "s2"] },
      { sha: "c", change: "", description: "three", parents: ["m"] },
    ]
    expect(bucketsOf(commits).map(({ commit, step }) => `${commit.sha}<${step}`)).toEqual([
      "a<a", "b<b", "s1<m", "s2<m", "m<m", "c<c",
    ])
  })
})

describe("grouping into mythical commits", () => {
  it("makes one commit of a landed entry's commits, folds regenerated docs and reverts, and notes attempts", () => {
    const commits = linear([
      "fix(compiler): first\n\nValidation: unit",
      "chore(docs): regenerate token counts and site pages",
      "test(compiler): first's regression",
      "docs: a page",
      "Revert \"docs: a page\"",
      "",
    ])
    const seed = seedOf("o/r", commits, [
      entry("q1", "rejected", ["fix(compiler): first"], "conflicts in /home/lane/x"),
      entry("q2", "landed", ["fix(compiler): first", "test(compiler): first's regression"]),
    ])
    const all = seed.epics.flatMap((epic) => epic.commits)
    expect(seed.epics.map((epic) => epic.title)).toEqual(["The compiler", "Docs, guides and the site", FOUNDATIONS])
    expect(all.map((commit) => commit.title)).toEqual(["fix(compiler): first", "docs: a page", UNTITLED])
    const first = all[0]!
    expect(first.notes).toEqual([
      { section: "tried", text: "Rejected in the merge queue (lane-q1): conflicts in <path>." },
      { section: "evidence", text: "Landed by the merge queue from lane lane-q2 through gate-q2 (matched by title)." },
      { section: "evidence", text: "Validation: unit." },
    ])
    expect(all[1]!.notes).toEqual([{ section: "tried", text: "Reverted in aaaaaaaaaaa5." }])
    // Every real commit, in main's order, folds into exactly one mythical commit.
    expect(seed.real.map((real) => real.into)).toEqual([first.id, first.id, first.id, all[1]!.id, all[1]!.id, all[2]!.id])
    expect(seed.main).toBe("aaaaaaaaaaa6")
  })

  it("records every intent of a seed: nothing refused, one real commit per reachable commit", () => {
    const commits = linear(["fix(compiler): a", "docs: b", `fix(compiler): ${"x".repeat(MAX_TITLE)}`])
    const { history, refused } = replay(intentsOf(seedOf("o/r", commits, [])))
    expect(refused).toEqual([])
    expect(history.real.length).toBe(3)
    expect(history.commits.every((commit) => commit.state === "landed" && commit.title.length <= MAX_TITLE)).toBe(true)
  })
})

describe("VibeLang's bootstrapped history", () => {
  // This integration replays over 6,000 commits through the real machine; retain all content/count assertions.
  it.effect("is exactly what its seed's intents build through the real sequencer", () => effect {
    const history = try Schema.decodeUnknownEffect(Schema.fromJsonString(HistorySchema))(HISTORY_JSON)
    const { history: rebuilt, refused } = replay(intentsOf(seedFrom(REPOSITORY, history)))
    try Effect.try(() => {
      expect(refused).toEqual([])
      expect(rebuilt).toEqual(history)
      expect(new Set(history.real.map((real) => real.sha)).size).toBe(history.real.length)
      expect(history.real.length).toBeGreaterThan(6000)
    })
  }, 20_000)

  it.effect("ends every note the bootstrap wrote with a whole sentence", () => effect {
    const history = try Schema.decodeUnknownEffect(Schema.fromJsonString(HistorySchema))(HISTORY_JSON)
    const notes = history.commits.flatMap((commit) => commit.notes.filter((note) => note.by === BOOTSTRAP))
    // A note the bootstrap cut ended in "…" or mid-line; a message's own "…" inside a sentence is its text.
    const cut = notes.filter((note) => !endsSentence(note.text)).map((note) => note.text)
    try Effect.try(() => {
      expect(notes.filter((note) => note.section === "evidence").length).toBeGreaterThan(4000)
      expect(cut).toEqual([])
    })
  }, 20_000)
})
