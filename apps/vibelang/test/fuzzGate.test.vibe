import * as NodeServices from "@effect/platform-node/NodeServices"
import { expect, it } from "@effect/vitest"
import { gate, run } from "../fuzz/run.vibe"

const config = (values: Record<string, string>) => Effect.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(values)))

// The fuzzer finishes any execution it starts, so a starved run is the report it leaves: zero executions.
it.effect("a fuzz target that ran no execution fails and names its budget and the host load", () => effect {
  const outcome = try Effect.result(gate("gate/starved", Duration.millis(250), Option.none(), { executions: 0 }).pipe(Effect.provide(NodeServices.layer)))
  expect(outcome._tag).toBe("Failure")
  if (outcome._tag === "Failure") {
    expect(outcome.failure._tag).toBe("NoExecution")
    expect(outcome.failure.message).toMatch(/^gate\/starved ran no execution in 250 ms \(host load (\d+\.\d+|unknown)\)$/)
  }
})

it.effect("the gate passes a target that ran its property, and an explicit replay-only run", () => effect {
  try gate("gate/fed", Duration.millis(250), Option.none(), { executions: 1 }).pipe(Effect.provide(NodeServices.layer))
  try gate("gate/replay", Duration.millis(250), Option.some(0), { executions: 0 }).pipe(Effect.provide(NodeServices.layer))
})

it.live("run passes a target that executed, and FUZZ_EXECUTIONS=0 replays without executing", () => effect {
  try run("gate/fed", Schema.Int, (n) => Number.isInteger(n)).pipe(config({ FUZZ_BUDGET: "200 millis", FUZZ_SEED: "1" }))
  try run("gate/replay", Schema.Int, () => false).pipe(config({ FUZZ_BUDGET: "200 millis", FUZZ_SEED: "1", FUZZ_EXECUTIONS: "0" }))
}, 30_000)
