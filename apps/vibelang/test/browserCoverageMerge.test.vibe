// @vitest-environment node
// A real minified Vite bundle of the Chromium fixture, executed under native V8, through the e2e reporter's `measure`.
import { it, expect } from "@effect/vitest"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { ExperimentalNodeServices } from "vibelang-runtime/experimental/platform-node"
import { build } from "vite"
import { measure } from "../e2e/coverage-reporter.ts"
import { node, run } from "./support/processes.vibe"

interface Count { readonly covered: number; readonly total: number }
type Summary = Readonly<Record<"lines" | "branches" | "functions" | "statements", Count>>
interface Range { readonly start: { readonly line: number } }
interface Coverage {
  readonly statementMap: Readonly<Record<string, Range>>
  readonly fnMap: Readonly<Record<string, { readonly name: string }>>
  readonly branchMap: Readonly<Record<string, { readonly type: string }>>
  readonly s: Readonly<Record<string, number>>
  readonly f: Readonly<Record<string, number>>
}
const hitsAt = (hits: Coverage["s"], ranges: Coverage["statementMap"], line: number) =>
  Object.entries(ranges).filter(([, range]) => range.start.line === line).map(([id]) => Math.min(hits[id] ?? 0, 1))

/** One real build and V8 run, shared by both tests: a Vite build that bundles effect takes about a minute. */
let observed: Promise<{ readonly status: number; readonly stderr: string; readonly stdout: string; readonly native: boolean; readonly before: Summary; readonly after: Summary; readonly file: Coverage }> | undefined
const observe = () => observed ??= runPromise(scoped(effect {
  provide NodeServices.layer, ExperimentalNodeServices.layer {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const app = try path.fromFileUrl(new URL("../", import.meta.url))
    const fixture = path.join(app, "e2e/coverage-fixtures/fixture.vibe")
    // Inside the app's node_modules so the entry resolves `effect` like the app does; removed with the scope.
    const root = try fs.makeTempDirectoryScoped({ directory: path.join(app, "node_modules"), prefix: ".browser-coverage-merge-" })
    try fs.writeFileString(path.join(root, "entry.mjs"), `import { Effect } from "effect"\nimport { answer } from ${JSON.stringify(fixture)}\nconsole.log(Effect.runSync(answer(true)))\n`)
    const output = path.join(root, "dist")
    // The production build minifies, as the e2e build does: `if (first) return 7; return 9` becomes one return.
    try tryPromise(() => build({
      root, configFile: path.join(app, "vite.config.ts"), mode: "production", logLevel: "silent",
      build: { outDir: output, sourcemap: true, rolldownOptions: { input: path.join(root, "entry.mjs"), output: { entryFileNames: "bundle.mjs" } } },
    }))
    const raw = path.join(root, "raw")
    try fs.makeDirectory(raw)
    const bundle = path.join(output, "bundle.mjs")
    const executed = try run(try node(), [bundle], { NODE_V8_COVERAGE: raw })
    const url = (try path.toFileUrl(bundle)).href
    let native: { scriptId: string; url: string; functions: unknown } | undefined
    for (const name of try fs.readDirectory(raw)) {
      const json = try fs.readFileString(path.join(raw, name))
      const record = try Effect.try(() => JSON.parse(json) as { result: Array<{ scriptId: string; url: string; functions: unknown }> })
      native ??= record.result.find(script => script.url === url)
    }
    const mapText = try fs.readFileString(bundle + ".map")
    const sourceMap = try Effect.try(() => JSON.parse(mapText) as { sources: string[] })
    // `measure` reads map sources relative to the app's dist/assets, where the e2e build writes its chunks.
    sourceMap.sources = sourceMap.sources.map(source => path.relative(path.join(app, "dist/assets"), path.resolve(output, source)))
    const source = try fs.readFileString(bundle)
    const directories = [path.relative(app, path.dirname(fixture))]
    const seeded = try tryPromise(() => measure([], directories))
    const merged = try tryPromise(() => measure([{ ...native!, source, sourceMap }], directories))
    const summary = (map: typeof merged) => map.fileCoverageFor(fixture).toSummary().toJSON() as Summary
    const before = summary(seeded), after = summary(merged)
    const file = try Effect.try(() => merged.fileCoverageFor(fixture).toJSON() as Coverage)
    return { status: executed.status, stderr: executed.stderr, stdout: executed.stdout, native: native !== undefined, before, after, file }
  }
}))

it.live("the browser gate counts a bundled source once, on its compiler structure", () => effect {
  const { status, stderr, stdout, native, before, after, file } = try tryPromise(observe)
  try Effect.try(() => {
    expect(status, stderr).toBe(0)
    expect(stdout.trim()).toBe("7")
    expect(native).toBe(true)
    // The denominator is the source's own structure; the bundle's ternary and its renamed function add nothing.
    for (const metric of ["lines", "branches", "functions", "statements"] as const) {
      expect([metric, after[metric].total]).toEqual([metric, before[metric].total])
    }
    expect(Object.values(file.branchMap).map(branch => branch.type)).toEqual(["if"])
    expect(Object.values(file.fnMap).map(fn => fn.name)).toEqual(["answer", "unused"])
    // The tree-shaken export stays in the denominator, uncovered.
    expect(hitsAt(file.s, file.statementMap, 9)).toEqual([0])
    expect(Object.entries(file.fnMap).filter(([, fn]) => fn.name === "unused").map(([id]) => file.f[id])).toEqual([0])
  })
  // A real Vite build that bundles effect: 49 s alone at load 57, past 120 s inside the full suite (2026-11-10).
}, 300_000)

// Expected to fail until the bundled-range defect is fixed (decision 0016, ~/vl/vibelang-bugs/coverage-source-ranges):
// the bundle's one statement carries the compiler's range for line 4, which never ran (`answer(true)` returns at
// line 3), so the merge credits it. When this test starts passing, the defect is fixed: drop `.fails`.
it.live.fails("the merge credits no statement the bundle never executed", () => effect {
  const { file } = try tryPromise(observe)
  try Effect.try(() => expect(hitsAt(file.s, file.statementMap, 4)).toEqual([0]))
}, 300_000)
