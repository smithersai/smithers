// Competing public requests must never lose the post between dispatch and the first reply step.
import { expect, it } from "@effect/vitest"
import { Factory } from "../src/core/Factory.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"
import { replyIdOf } from "../src/core/flows.vibe"
import { mockReply } from "../src/core/mockReplies.vibe"

class YieldingScheduler extends Scheduler.MixedScheduler {
  private turns = 0
  constructor(private readonly period: number) { super() }
  override shouldYield() { return ++this.turns % this.period === 0 }
}

for (const period of [6, 7, 11, 17]) {
  it.live(`answers every accepted post when tours race dispatch (yield every ${period})`, () =>
    provideService(effect {
      provide MockFactory {
        const factory = try Factory
        try forEach(Array.from({ length: 8 }, (_, index) => index), effect (index) => {
          const room = `race-${index}`
          const tour = effect {
            return factory.tour(room) catch effect (error) => {
              if (error._tag === "Refused" && error.refusal === "busy") return "busy"
              throw error
            }
          }
          const [, toured] = try.all [factory.post(room, "a", "Ada", "install"), tour]
          if (toured !== "busy") {
            factory.endTour(room) catch effect (error) => {
              if (error._tag === "Refused" && error.refusal === "not-replying") return
              throw error
            }
          }
          try Stream.runCollect(factory.events(room, 0).pipe(
            Stream.takeUntil((event) => event.type === "ReplyFinished"),
            Stream.timeout("5 seconds"),
          ))
          const snapshot = try factory.read(room, 0)
          const person = snapshot.entries.find((entry) => entry.author === "person")
          const reply = snapshot.entries.find((entry) => entry.inReplyTo === person?.id)
          try Effect.try(() => {
            expect(person).toMatchObject({ text: "install", clientId: "a" })
            expect(reply).toMatchObject({ text: mockReply("install"), done: true })
          })
        }, { concurrency: "unbounded", discard: true })
      }
    }, Scheduler.Scheduler, new YieldingScheduler(period)), 30_000)
}

it.live("finishes a concurrently accepted tour before answering the waiting post without cancellation", () =>
  provideService(effect {
    provide MockFactory {
      const factory = try Factory
      const tours = try Ref.make(0)
      try forEach(Array.from({ length: 8 }, (_, index) => index), effect (index) => {
        const room = `natural-${index}`
        const start = effect {
          const result = factory.tour(room) catch effect (error) => {
            if (error._tag === "Refused" && error.refusal === "busy") return "busy"
            throw error
          }
          if (result !== "busy") try Ref.update(tours, (count) => count + 1)
        }
        try.all [factory.post(room, "a", "Ada", "install"), start]
        const accepted = try factory.read(room, 0)
        const person = accepted.entries.find((entry) => entry.author === "person")!
        try Stream.runCollect(factory.events(room, 0).pipe(
          Stream.takeUntil((event) => event.type === "ReplyFinished" && event.id === replyIdOf(person.id)),
          Stream.timeout("20 seconds"),
        ))
        const snapshot = try factory.read(room, 0)
        const reply = snapshot.entries.find((entry) => entry.inReplyTo === person.id)
        try Effect.try(() => {
          expect(reply).toMatchObject({ text: mockReply("install"), done: true })
          expect(snapshot.entries.every((entry) => entry.author === "person" || entry.done)).toBe(true)
        })
      }, { concurrency: "unbounded", discard: true })
      const acceptedTours = try Ref.get(tours)
      try Effect.try(() => expect(acceptedTours).toBeGreaterThan(0))
    }
  }, Scheduler.Scheduler, new YieldingScheduler(17)), 30_000)
