// Native media outcomes are counted and logged without any asset URL or conversation content.
import { describe, expect, it } from "@effect/vitest"
import { mediaEvents, observeMedia } from "../src/web/media.vibe"

describe("media observations", () => {
  it.effect("records loaded and failed image and video outcomes with bounded labels", () => effect {
    const lines: Array<string> = []
    const logger = Logger.layer([Logger.make((options) => { lines.push(JSON.stringify(options.message)) })])
    for (const kind of ["image", "video"] as const) {
      for (const outcome of ["loaded", "failed"] as const) {
        const metric = Metric.withAttributes(mediaEvents, { outcome, kind })
        const before = try Metric.value(metric)
        provide logger { try observeMedia(outcome, kind) }
        const after = try Metric.value(metric)
        try Effect.try(() => expect(after.count).toBe(before.count + 1))
      }
    }
    try Effect.try(() => {
      expect(lines).toHaveLength(4)
      expect(lines).toEqual([
        JSON.stringify(["vibelang.media", { outcome: "loaded", kind: "image" }]),
        JSON.stringify(["vibelang.media", { outcome: "failed", kind: "image" }]),
        JSON.stringify(["vibelang.media", { outcome: "loaded", kind: "video" }]),
        JSON.stringify(["vibelang.media", { outcome: "failed", kind: "video" }]),
      ])
    })
  })
})
