// The site's only route to GitHub as a person (decision 0165): a per-person delegation, never a token.
import { GitHub } from "@smthrs/integrations"
import { HttpClient } from "effect/http"

export interface Connection { readonly person: number; readonly delegation: string }
export type Delegate = Effect.Success<ReturnType<typeof GitHub.Delegation.site>>
export class GitHubDelegate extends Context.Service<GitHubDelegate, Delegate>()("vibelang/GitHubDelegate") {}

/** The broker's reason, whether it arrived on a typed write or on a delegated read's GitHub error. */
export function refusalOf(error: unknown): GitHub.Delegation.Reason | undefined {
  const candidate = error as { readonly _tag?: string; readonly reason?: GitHub.Delegation.Reason; readonly details?: Readonly<Record<string, unknown>> }
  if (candidate?._tag === "@smthrs/integrations/DelegationRefused") return candidate.reason
  return candidate?.details === undefined ? undefined : GitHub.Delegation.reasonOf(candidate)
}

/** GitHub as this person when they are connected, otherwise anonymously for public reads. */
export function asPerson(connection: Connection | undefined, api: string, http: HttpClient.HttpClient, delegate: Option.Option<Delegate>) {
  return <A, E, R>(program: A!E!R) => connection !== undefined && Option.isSome(delegate)
    ? Effect.provideService(program, GitHub.GitHubClient.GitHubClient, delegate.value.client(connection.person, connection.delegation, http)) as Effect.Effect<A, E, Exclude<R, GitHub.GitHubClient.GitHubClient>>
    : program.pipe(GitHub.Calls.withToken(Redacted.make(""), api), Effect.provideService(HttpClient.HttpClient, http)) as Effect.Effect<A, E, Exclude<Exclude<R, GitHub.GitHubClient.GitHubClient>, HttpClient.HttpClient>>
}
