// The site Worker: serves the Vite build and hands /api/* to the API Worker (worker/Api.vibe) over its service
// binding, as apps/mvp's site does. Without the binding the site runs the mock agent in the browser, and `/api/health`
// says so; with it, the API answers health itself, `agent: "live"` (wiki/decisions/0006-hosting.md, 0010-live-agent.md).
// Its own answers are Effect's HTTP responses, converted to the platform's at this boundary.
import { HttpServerResponse } from "effect/http"

interface Env {
  readonly ASSETS: Fetcher
  /** The API Worker; absent on a mock-only deployment. */
  readonly API?: Fetcher
}

/** The answer for every path that isn't home, a built asset or the API. */
function notFound() {
  return HttpServerResponse.toWeb(HttpServerResponse.text("Not found", { status: 404 }))
}

export default {
  fetch: async (request, env) => {
    const url = new URL(request.url)
    if (url.pathname.startsWith("/api/")) {
      if (env.API !== undefined) return env.API.fetch(request)
      if (url.pathname === "/api/health") return HttpServerResponse.toWeb(HttpServerResponse.jsonUnsafe({ ok: true, agent: "mock" }))
      return notFound()
    }
    // Only the chat/history pages and built assets exist. Reject before the asset service's SPA fallback can turn a miss into 200.
    const page = url.pathname === "/" || url.pathname === "/index.html" || url.pathname === "/history" || url.pathname.startsWith("/history/")
    const asset = /^\/(?:assets|media)\/[^?]+\.[^/]+$/.test(url.pathname)
    if (!page && !asset) return notFound()
    const response = await env.ASSETS.fetch(request)
    if (asset && response.headers.get("Content-Type")?.includes("text/html")) return notFound()
    return response
  },
} satisfies ExportedHandler<Env>
