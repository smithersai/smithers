import { selectModelTurns } from "../src/core/sequenceDecision.vibe"
// One conversation's sequencer (wiki/decisions/0003-one-state-machine.md, 0010-live-agent.md, 0011-post-flow.md): the
// only writer of its numbered events. Every intent, a step of a person's post flow or of the agent's reply flow, goes
// through `decide` and `apply` under one lock, is written to the conversation's log before anyone sees it, and is then
// published to every follower. The Durable Object that hosts it (Objects.vibe) supplies the log and the dispatch; nothing here names
// Cloudflare.
import {
  apply,
  empty,
  isReplying,
  isTouring,
  replayLog,
  roleOf,
  type GrantMode,
  type Role,
  type Action,
  type Conversation,
  type Entry,
  type Event,
} from "../src/core/conversation.vibe"
import { decide, type Intent, type Refusal } from "../src/core/decide.vibe"
import { endsTour, replyIdOf, touring, unanswered } from "../src/core/flows.vibe"
import { appends, startAnswer } from "../src/core/flowDecision.vibe"
import { EventSchema, type ReadSnapshot } from "../src/core/schemas.vibe"

/** Where the conversation's numbered events persist, in order. `write` returns once the event is durable. */
export interface Log {
  read(): ReadonlyArray<Event>!!
  write(event: Event, owner?: string): void!!
}

/**
 * Starts the agent's reply flow for the first of `posts` that has none, or the running tour's flow; a no-op while
 * another of its flows runs.
 */
export interface Dispatch {
  start(posts: ReadonlyArray<string>): void!!
  tour(tour: string): void!!
}

/** What a reply step got: done (or already done), `busy` while another reply streams, or a final refusal. */
export type Answer = "done" | "busy" | "refused"

/** One turn of the conversation as the model reads it. */
export schema Turn { readonly author: "person" | "agent"; readonly text: string }

interface State {
  readonly conversation: Conversation
  readonly log: ReadonlyArray<Event>
}

/** How many times `reply` restarted: its current model attempt is one more. */
function attemptOf(log: ReadonlyArray<Event>, reply: string): number {
  return 1 + log.filter((event) => event.type === "ReplyRestarted" && event.id === reply).length
}

function entryOf(conversation: Conversation, id: string): Entry | undefined {
  return conversation.entries.find((entry) => entry.id === id)
}

/** The sequencer over `log`, publishing to its followers and dispatching replies through `dispatch`. */
export effect function make(log: Log, dispatch: Dispatch) {
  const lock = try Semaphore.make(1)
  const published = try PubSub.unbounded<Event>()
  const loaded = try Ref.make<State | undefined>(undefined)

  effect function state() {
    const current = try Ref.get(loaded)
    if (current !== undefined) return current
    const events = try Schema.decodeUnknownEffect(Schema.Array(EventSchema))(try log.read()).pipe(
      Effect.mapError(() => new Error("Invalid conversation events")), Effect.orDie,
    )
    const restored: State = { conversation: replayLog(empty, events), log: events }
    try Ref.set(loaded, restored)
    return restored
  }

  /** Decides `intent` against the current state; an accepted event is written, applied and published. */
  effect function record(intent: Intent, owner?: string) {
    const current = try state()
    const decision = decide(current.conversation, intent)
    if (!decision.ok) return decision
    try log.write(decision.event, owner)
    try Ref.set(loaded, { conversation: apply(current.conversation, decision.event), log: [...current.log, decision.event] })
    try PubSub.publish(published, decision.event)
    return decision
  }

  function locked<A, E, R>(body: A!E!R) {
    return Semaphore.withPermits(lock, 1)(body)
  }

  /** Starts the running tour's flow, or else the next unanswered post's reply flow, if the agent isn't replying. */
  effect function ensureDispatched() {
    const conversation = (try locked(state())).conversation
    const tour = touring(conversation)
    if (tour !== "") return try dispatch.tour(tour)
    const posts = unanswered(conversation)
    if (posts.length > 0) try dispatch.start(posts)
  }

  /** Records `intent` under the lock: whether the sequencer accepted it. */
  function accepted(intent: Intent) {
    return locked(Effect.map(record(intent), (decision) => decision.ok))
  }

  /** Every event after `after`, then each new one as it is numbered. Subscribing first loses none between. */
  function follow(after: number) {
    return Stream.unwrap(effect {
      const live = try PubSub.subscribe(published)
      const current = try locked(state())
      const replay = current.log.filter((event) => event.seq > after)
      const replayedTo = replay.length === 0 ? after : replay[replay.length - 1]!.seq
      return Stream.concat(
        Stream.fromIterable(replay),
        Stream.fromSubscription(live).pipe(Stream.filter((event) => event.seq > replayedTo)),
      )
    })
  }

  /** Settles the streaming reply with `intent` (finish or fail), then dispatches the next post. */
  effect function settle(reply: string, intent: Intent, settled: (entry: Entry) => boolean) {
    const answer = try locked(effect {
      const current = try state()
      const entry = entryOf(current.conversation, reply)
      const already: Answer = entry !== undefined && settled(entry) ? "done" : "refused"
      if (entry === undefined || !isReplying(current.conversation, reply)) return already
      try record(intent)
      const done: Answer = "done"
      return done
    })
    try ensureDispatched()
    return answer
  }

  return {
    ensureDispatched,
    snapshot: effect () => (try locked(state())).conversation,
    allows: effect (by: string, action: Action) => decide((try locked(state())).conversation, { type: "Authorize", id: "policy", by, action }).ok,
    role: effect (id: string) => roleOf((try locked(state())).conversation.roles, id),
    grant: (id: string, by: string, role: Role, mode: GrantMode) => locked(effect {
      const decision = try record({ type: "GrantRole", id, by, role, mode })
      return decision.ok ? null : decision.refusal
    }),

    /** Registered action projections use the same numbered, durable event log as the conversation. */
    action: (intent: Extract<Intent, { readonly type: "RequestAction" | "TraceAction" | "SettleAction" }>) => accepted(intent),
    actions: effect () => (try locked(state())).conversation.runs ?? [],

    /**
     * Records a person's post: `null` once its event is stored, else the sequencer's refusal. The `vibelang/Post`
     * flow's record step (src/core/flows.vibe); its next step dispatches the reply.
     */
    post: effect (clientId: string, name: string, text: string, owner?: string) => {
      const decision = try locked(effect {
        const seq = (try state()).conversation.seq + 1
        return try record({ type: "Post", id: `m${seq}`, clientId, name, text }, owner)
      })
      const answer: Refusal | null = decision.ok ? null : decision.refusal
      return answer
    },

    /** Current copies of the entries touched by an event after `after`, and the cursor. */
    read: effect (after: number) => {
      const current = try locked(state())
      const touched = new Set(current.log.filter((event) => event.seq > after).map((event) => event.id))
      const snapshot: ReadSnapshot = {
        seq: current.conversation.seq,
        entries: current.conversation.entries.filter((entry) => touched.has(entry.id)),
      }
      return snapshot
    },

    follow,

    /** The turns the model reads to answer `post`: every post and finished answer up to it. */
    history: effect (post: string) => {
      const current = try locked(state())
      return selectModelTurns(current.conversation.entries, post).turns
    },

    /** Starts the reply to `post`. Done again when that reply already exists. */
    start: effect (post: string) => {
      const reply = replyIdOf(post)
      return try locked(effect {
        const decision = try record({ type: "StartReply", id: reply, inReplyTo: post })
        const exists = entryOf((try state()).conversation, reply)?.inReplyTo === post
        const answer: Answer = startAnswer(decision.ok, exists, decision.ok ? "" : decision.refusal)
        return answer
      })
    },

    /** Appends `text` at `offset` of attempt `attempt`. A piece already applied, or of an earlier attempt, is ignored. */
    append: effect (reply: string, attempt: number, offset: number, text: string) => {
      try locked(effect {
        const current = try state()
        const entry = entryOf(current.conversation, reply)
        if (entry === undefined || !isReplying(current.conversation, reply)) return
        if (!appends(attemptOf(current.log, reply), attempt, entry.text.length, offset, text)) return
        try record({ type: "AppendReply", id: reply, text })
      })
    },

    /** The model's attempt `attempt` begins: what streamed before it is discarded. Each attempt restarts once. */
    restart: effect (reply: string, attempt: number) => {
      try locked(effect {
        const current = try state()
        if (!isReplying(current.conversation, reply)) return
        // One restart per attempt, skipped attempts included, so this attempt's pieces apply.
        for (let next = attemptOf(current.log, reply); next < attempt; next++) {
          try record({ type: "RestartReply", id: reply })
        }
      })
    },

    /**
     * Finishes the reply as exactly `text`, the model's settled answer: whatever streamed is completed, or replaced
     * when a lost piece left it different. Done again once finished. Then the next post is dispatched.
     */
    finish: effect (reply: string, text: string) => {
      try locked(effect {
        const current = try state()
        const entry = entryOf(current.conversation, reply)
        if (entry === undefined || !isReplying(current.conversation, reply)) return
        if (!text.startsWith(entry.text)) try record({ type: "RestartReply", id: reply })
        const shown = text.startsWith(entry.text) ? entry.text : ""
        if (text.length > shown.length) try record({ type: "AppendReply", id: reply, text: text.slice(shown.length) })
      })
      return try settle(reply, { type: "FinishReply", id: reply }, (entry) => entry.done && entry.error === "")
    },

    /** Fails the reply with `reason`, shown on it. Done again once failed. Then the next post is dispatched. */
    fail: effect (reply: string, reason: string) => {
      return try settle(reply, { type: "FailReply", id: reply, reason }, (entry) => entry.error !== "")
    },

    /** Starts a tour, `t<seq>`: `null` once its event is stored, else the refusal (`busy` while the agent works). */
    startTour: effect () => {
      const decision = try locked(effect {
        const seq = (try state()).conversation.seq + 1
        return try record({ type: "StartTour", id: `t${seq}` })
      })
      const answer: Refusal | null = decision.ok ? null : decision.refusal
      return answer
    },

    /** Ends the running tour: `null` once its event is stored, else the refusal (`not-replying` when none runs). */
    endTour: effect () => {
      const decision = try locked(effect {
        return try record({ type: "EndTour", id: touring((try state()).conversation) })
      })
      const answer: Refusal | null = decision.ok ? null : decision.refusal
      return answer
    },

    drive: (tour: string, step: number, target: string, duration: number) => locked(effect {
      try record({ type: "DriveWalkthrough", id: tour, step, target, duration, at: try Clock.currentTimeMillis })
      return (try state()).conversation.walkthrough!
    }),
    controlTour: (action: "pause" | "resume" | "seek", step: number) => locked(effect {
      const current = (try state()).conversation
      const tour = touring(current)
      const at = try Clock.currentTimeMillis
      const decision = try record(action === "seek" ? { type: "SeekTour", id: tour, step, at } : { type: action === "pause" ? "PauseTour" : "ResumeTour", id: tour, at })
      return { tour, previous: current.walkthrough?.revision ?? 0, state: (try state()).conversation.walkthrough ?? null, refusal: decision.ok ? null : decision.refusal }
    }),
    running: (tour: string) => locked(Effect.map(state(), (current) => isTouring(current.conversation, tour))),

    /** Shows `url` in the docs pane while `tour` runs. */
    open: (tour: string, url: string) => accepted({ type: "OpenPane", id: tour, url }),

    /** Adds `text` to what `tour` said while it runs. */
    say: (tour: string, text: string) => locked(effect {
      const entry = entryOf((try state()).conversation, tour)
      const decision = try record({ type: "AppendReply", id: tour, text: entry?.text ? `\n\n${text}` : text })
      return decision.ok
    }),

    /** Settles `tour` as finished, or failed with `reason`, then dispatches the next post. */
    finishTour: effect (tour: string, reason: string) => {
      const intent: Intent = reason === "" ? { type: "FinishReply", id: tour } : { type: "FailReply", id: tour, reason }
      try settle(tour, intent, (entry) => entry.done)
    },

    /** Completes once `tour` no longer runs: it finished, failed, or the person ended it. */
    ended: (tour: string) => Stream.runDrain(follow(0).pipe(Stream.takeUntil((event) => endsTour(event, tour)))),
  }
}

export type Sequencer = Effect.Success<ReturnType<typeof make>>
