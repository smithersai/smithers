// The shared Smithers container host, as apps/mvp/worker/BranchSandboxes.ts uses it, with native filesystem snapshots.
import * as Cloudflare from "@alchemy.run/cloudflare"
import { SandboxImage } from "../infra/SandboxImage.vibe"
import { machineObject, type MachineShape } from "./machineObject.vibe"

export { machineObject } from "./machineObject.vibe"
export type { MachineBox, MachineShape, ObjectState } from "./machineObject.vibe"
export class SandboxMachine extends Cloudflare.DurableObject<SandboxMachine, MachineShape>()("VibelangSandboxMachine") {}

export const machineLive = SandboxMachine.make(effect {
  const box = try SandboxImage
  const state = try Cloudflare.DurableObjectState
  return machineObject(box, state)
})
