// The shared Smithers container host, as apps/mvp/worker/BranchSandboxes.ts uses it, with native filesystem snapshots.
import * as Cloudflare from "@alchemy.run/cloudflare"
import { SandboxImage } from "../infra/SandboxImage.vibe"
import { machineObject, type MachineShape } from "./machineObject.vibe"
import type { SandboxCounters } from "../bench/sandbox-counters.ts"
import { withCounters } from "./benchmarkCounters.vibe"

export { machineObject } from "./machineObject.vibe"
export type { MachineBox, MachineShape, ObjectState } from "./machineObject.vibe"
export interface MachineBindingShape extends MachineShape { benchmarkCoverage(): SandboxCounters!! }
export class SandboxMachine extends Cloudflare.DurableObject<SandboxMachine, MachineBindingShape>()("VibelangSandboxMachine") {}

/** The probe supplies its existing recording body; production supplies machineObject unchanged. */
export const machineWithBody = (body: Effect.Effect<typeof machineObject>) => SandboxMachine.make(effect {
  const box = try SandboxImage
  const state = try Cloudflare.DurableObjectState
  const open = try body
  return Effect.map(open(box, state), withCounters)
})
export const machineLive = machineWithBody(Effect.succeed(machineObject))
