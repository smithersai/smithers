import { callBudget, INPUT_CEILING } from "./CallBudget.vibe"
import { WikiDrafting } from "../src/core/WikiWriter.vibe"
import { beginReply, recordReplyStart, canComposeReply, beginReplyComposition, finishReplyComposition, recordReplySettlement } from "../src/core/replyDecision.vibe"
import { initialProgress, advanceProgress, completion, type ProgressState } from "./replyProgressDecision.vibe"
import { promptForm, promptWindow, speaker } from "../src/core/sequenceDecision.vibe"
// The agent's reply to one post, a durable `@smthrs/flow` flow (rulings VL-11; wiki/decisions/0010-live-agent.md,
// 0012-smithers-agent.md). Every side effect is a journaled step, so a reset Durable Object resumes the reply where it
// stopped. The answer is smithers.sh's agent: `@smthrs/agent`'s `AgentAction`, the codemode loop apps/mvp's chat runs
// (its cells in QuickJS, here the workerd build), with VibeLang's skill as context; its model calls are the agent's
// own `ModelStep`s, never a raw provider call. The reply streams through the conversation's sequencer as
// `StartReply`, `AppendReply`, `RestartReply` (the visible answer started over) and `FinishReply`; every failure
// becomes `FailReply` with a reason the person reads.
import { Agent, AgentAction, Budget, EventSink, QuotaPolicy, Seat, SeatResolver } from "@smthrs/agent"
import { WebCrypto } from "@smthrs/crypto"
import { Action, Deadline, Interpreter, RetryPolicy } from "@smthrs/flow"
import { type AgentEvent, DoneText, type FlowBinding, HarnessError } from "@smthrs/harness"
import * as QuickJSWorkerd from "@smthrs/harness/QuickJSWorkerd"
import { Evaluator, ModelRequest } from "@smthrs/model"
import type { HostModel } from "@smthrs/model-host"
import { Registry } from "@smthrs/registry"
import { patient, Reply, replyDeadline, ReplyStep, replyIdOf, Tours } from "../src/core/flows.vibe"
import { wikiTools, WIKI_INSTRUCTION } from "./WikiTools.vibe"
import { AGENT_CONTEXT } from "./agentContext.vibe"
import { AgentActions } from "../src/actions/agent.vibe"
import { actionTools } from "../src/actions/tools.vibe"
import { HISTORY_INSTRUCTION, historyTools, HistoryTools, REPLY_CALLS } from "./HistoryTools.vibe"
import { closed, SandboxAgent, sandboxTools, SANDBOX_INSTRUCTION } from "./SandboxTools.vibe"
import { Turn, type Answer } from "./Sequencer.vibe"
import { Unreachable } from "./Unreachable.vibe"
import { reasonCode, failureCode } from "./replyReasons.vibe"

/** Another reply streams in this conversation; starting waits for it. */
export schema error Busy {}

const Answered = Schema.Literals(["done", "busy", "refused"])

/** The conversation's sequencer, as the reply's steps reach it: in the same Durable Object (Sequencer.vibe). */
export service Replies {
  start(post: string): Answer!!
  history(post: string): ReadonlyArray<Turn>!!
  append(reply: string, attempt: number, offset: number, text: string): void!!
  restart(reply: string, attempt: number): void!!
  finish(reply: string, text: string): Answer!!
  fail(reply: string, reason: string): Answer!!
}

/**
 * The day's token budget (Budget.vibe), in its own Durable Object: `admit` reserves a call's whole `ceiling` before its
 * model calls, or refuses when the day has no room for it; `spend` settles the call after them, charging `tokens` when
 * the provider `reported` them and the whole `ceiling` when it did not, and frees the reservation.
 */
export service Spend {
  readonly checkpoint?: (day: string, reply: string, tokens: number, reported: boolean, ceiling: number) => void!!
  admit(day: string, reply: string, ceiling: number): boolean!Unreachable
  spend(day: string, reply: string, tokens: number, reported: boolean, ceiling: number): void!Unreachable
}

/** The agent's model, or why there is none: `CHAT_MODEL` and its key (AgentModel.vibe). */
export service ChatModel {
  readonly model: HostModel["Service"] | undefined
  readonly unusable: string
}

/** The reasons a person reads on a failed reply. Short, and never a provider's message, which could hold anything. */
export const REASONS = {
  budget: "The agent's daily budget is spent. It resets at 00:00 UTC.",
  credit: "The agent's model provider is out of credit.",
  unconfigured: "The agent has no model configured.",
  refused: "The model refused to answer.",
  unavailable: "The model is unavailable. Try again.",
  empty: "The model returned no answer.",
  failed: "The agent failed. Try again.",
} as const

/** The fixed product wording for the proved model failure code. */
export function reasonOf(error: { readonly code: string }): string {
  return REASONS[reasonCode(error.code)]
}

/** The fixed product wording for the proved agent failure code. */
export function failureReason(tag: string, progress: Progress): string {
  return REASONS[failureCode(tag, progress.failed)]
}

/** The most tokens one model call may write, and the most turns of the conversation the agent reads. */
export const MAX_ANSWER_TOKENS = 2048
export const MAX_TURNS = 24

/** The most model turns (frames) one reply takes, as smithers.sh's chat answer (apps/mvp's `MAX_FRAMES`). */
export const MAX_FRAMES = 8

/** The context window the agent compacts against, as smithers.sh's agents do. */
export const CONTEXT_WINDOW_TOKENS = INPUT_CEILING

/** The reservation for `frames` calls with this input allowance and maximum answer. */
export function ceilingOf(frames: number, answer: number): number {
  return frames * (CONTEXT_WINDOW_TOKENS + answer)
}

/** The first call's reservation; every physical call, including a reissue, reserves separately. */
export const REPLY_CEILING = ceilingOf(1, MAX_ANSWER_TOKENS)

/** The seat the agent declares; the host answers it with the deployment's chat model. */
export const AGENT_SEAT = "agent"

/**
 * One cell's limits: no tool calls unless the agent is given tools (`agentOf`'s `calls`), a QuickJS heap well inside
 * the isolate's 128 MiB, and five seconds of evaluation.
 */
export const LIMITS = { calls: 0, memoryBytes: 32 * 1024 * 1024, timeMs: 5_000 }

export { patient } from "../src/core/flows.vibe"

/**
 * A draft's token charge (wiki draft, VIP draft, specification review) retries an unreachable Budget object for about
 * two minutes of engine time, apart from the model call's deadline (0015); then the draft fails visibly, with Retry.
 */
export const draftSpend = RetryPolicy.make({ initialMs: 500, factor: 2, maxMs: 30_000, jitterRatio: 0.2, expirationMs: 120_000 })

/** Logs and counts a draft whose charge gave up, under fixed names and the draft's kind only. */
export function draftSpendFailed(draft: "wiki" | "vip" | "specification") {
  return Effect.logWarning("vibelang.draft.spend").pipe(
    Effect.annotateLogs({ draft, outcome: "unreachable" }),
    Effect.andThen(Metric.update(Metric.withAttributes(Metric.counter("vibelang_draft_spend_failures", { incremental: true }), { draft }), 1)),
  )
}

/** Whether an agent run failed because a model call was refused: the day's budget is spent (worker/CallBudget.vibe). */
export function daySpent(failure: unknown): boolean {
  return typeof failure === "object" && failure !== null && "cause" in failure && typeof failure.cause === "object" && failure.cause !== null && "_tag" in failure.cause && failure.cause._tag === "vibelang/DailyBudgetExceeded"
}

/** The UTC day of `millis`, as the budget names it: `2026-11-07`. */
export function dayOf(millis: number): string {
  return new Date(millis).toISOString().slice(0, 10)
}

/** The agent's task: the conversation so far, then the post it answers, as smithers.sh's chat asks it. */
export function promptOf(payload: { readonly turns: ReadonlyArray<Turn> }): string {
  const turns = promptWindow(payload.turns, MAX_TURNS)
  const form = promptForm(turns.length)
  const asked = turns.at(-1)
  const history = turns.slice(0, -1)
  if (form === "none" || asked === undefined) return ""
  if (form === "asked") return asked.text
  return [
    "The conversation so far:",
    ...history.map((turn) => `${speaker(turn.author)}: ${turn.text}`),
    "",
    `The person now asks: ${asked.text}`,
  ].join("\n")
}

/**
 * `vibelang/reply/agent`: smithers.sh's agent answers the post, VibeLang's own reference its system context, the
 * mythical history its tools (HistoryTools.vibe).
 */
export const Respond = AgentAction.make("vibelang/reply/agent", {
  payload: { turns: Schema.Array(Turn) },
  output: Schema.String,
  seat: AGENT_SEAT,
  system: [AGENT_CONTEXT, HISTORY_INSTRUCTION, SANDBOX_INSTRUCTION, WIKI_INSTRUCTION, "Use vibelang/actions/List to discover registered actions. Start them with vibelang/actions/Start, then Read their run ids for progress or Cancel when asked. A request is not completion; report the actual result."],
  profile: "conversation",
  prompt: promptOf,
  maxFrames: MAX_FRAMES,
  modelParams: ModelRequest.GenerationParams.make({ maxTokens: MAX_ANSWER_TOKENS }),
})

/** A failure's tag for the logs: never its message, which can carry a provider's words or a person's text. */
export function tagOf(error: unknown): string {
  try {
    if (typeof error !== "object" || error === null || !("_tag" in error)) return "defect"
    const tag = error._tag
    return typeof tag === "string" ? tag : "defect"
  } catch {
    return "defect"
  }
}

/** What the agent showed and spent while it answered, folded from its events. */
export type Progress = ProgressState

export const started: Progress = initialProgress()

/** Folds one agent event into the reply's progress. A new model call or a retry starts the reply's text over. */
export function fold(progress: Progress, event: AgentEvent.AgentEvent): Progress {
  let piece = ""
  let projected: string | undefined = undefined
  let textDelta = false
  let input = 0
  let output = 0
  let code = ""
  let present = false
  let safeTotal = false
  let safeInput = false
  let safeOutput = false
  // SDK payload projection and DoneText stay at this native boundary; the kernel owns every state choice.
  switch (event._tag) {
    case "model-delta":
      if (event.delta.type === "text-delta") {
        textDelta = true
        piece = event.delta.text
        projected = Option.getOrUndefined(DoneText.project(progress.reply + piece))
      }
      break
    case "model-settled":
      present = Budget.reportsTokens(event.usage)
      // The provider's total is authoritative; without one, count both reported components.
      input = event.usage.totalTokens ?? event.usage.inputTokens ?? 0
      output = event.usage.totalTokens === undefined ? event.usage.outputTokens ?? 0 : 0
      safeTotal = Number.isSafeInteger(progress.tokens)
      safeInput = Number.isSafeInteger(input)
      safeOutput = Number.isSafeInteger(output)
      break
    case "model-failed":
      code = event.code
      break
  }
  return advanceProgress(progress, { kind: event._tag, textDelta, piece, projected, input, output, code, present, safeTotal, safeInput, safeOutput })
}

/**
 * smithers.sh's agent running `action` over `model`: no registry, the cell sandbox on workerd, its events to `sink`.
 * Its agent calls `flows`, at most `calls` times a cell: the reply's are the mythical history's (0020).
 */
export function agentOf<ROut, E, RIn>(
  action: Layer.Layer<ROut, E, RIn>,
  model: HostModel["Service"],
  sink: EventSink.Service,
  flows: ReadonlyArray<FlowBinding.Source> = [],
  calls = 0,
  budget: Budget.Service = Budget.makeUnbounded(),
) {
  const seat = Seat.make({
    id: AGENT_SEAT,
    modelId: model.modelId,
    model: model.model,
    route: model.route,
    contextWindowTokens: CONTEXT_WINDOW_TOKENS,
  })
  return action.pipe(
    Layer.provide(Layer.mergeAll(
      AgentAction.layerHost({
        registry: Registry.makeNoop(),
        flows,
        limits: { ...LIMITS, calls },
        capabilityEnvelope: [],
        maxFrames: MAX_FRAMES,
      }),
      SeatResolver.layer({
        resolve: (id) => id === AGENT_SEAT
          ? Effect.succeed(seat)
          : Effect.fail(new Seat.SeatUnresolved({ seat: id, message: "The VibeLang agent has one seat, agent." })),
      }),
      Agent.layer,
      EventSink.layer(sink),
    )),
    Layer.provide(Layer.mergeAll(QuotaPolicy.layerDefault(), Layer.succeed(Budget.Budget, budget))),
    Layer.provide(Layer.mergeAll(Agent.layerDefaultsWithVariant, Evaluator.layerUnavailable())),
    Layer.provide(QuickJSWorkerd.variant),
  )
}

data Outcome { Answered { text: string }; Failed { reason: string } }

/**
 * Runs the agent on `turns`, streaming its visible answer into `reply`: each event goes on a queue (the sink runs
 * inside the engine's write, so it never writes storage itself), and a fiber hands the text to the sequencer as
 * appends, or a restart when the answer started over.
 */
effect function respond(reply: string, model: HostModel["Service"], turns: ReadonlyArray<Turn>, budget: Budget.Service) {
  const replies = try Replies
  const events = try Queue.unbounded<AgentEvent.AgentEvent | undefined>()
  const progress = try Ref.make(started)
  const sink: EventSink.Service = { emit: (event) => Effect.asVoid(Queue.offer(events, event)) }
  const streamer = fork effect {
    let attempt = 1
    let shown = ""
    while (true) {
      const event = try Queue.take(events)
      if (event === undefined) return
      const next = fold(try Ref.get(progress), event)
      try Ref.set(progress, next)
      if (next.text === shown) continue
      if (!next.text.startsWith(shown)) {
        attempt += 1
        shown = ""
        try replies.restart(reply, attempt)
      }
      try replies.append(reply, attempt, shown.length, next.text.slice(shown.length))
      shown = next.text
    }
  }
  const answered = try exit(run(reply, model, sink, turns, budget))
  try Queue.offer(events, undefined)
  join streamer
  return { answered, progress: try Ref.get(progress) }
}

/** One run of the reply agent, with both history and captured pane tools. */
effect function run(reply: string, model: HostModel["Service"], sink: EventSink.Service, turns: ReadonlyArray<Turn>, budget: Budget.Service) {
  const tours = try Tours
  const { history } = try HistoryTools
  const sandbox = Option.getOrElse(try Effect.serviceOption(SandboxAgent), () => closed)
  const drafting = Option.getOrUndefined(try Effect.serviceOption(WikiDrafting))
  const tools = try AgentActions
  const actions = tools.actions === undefined ? [] : [actionTools(tools.actions, tools.announce)]
  provide agentOf(Respond.layer, model, sink, [historyTools(history), sandboxTools(sandbox.factory, sandbox.conversation), wikiTools(reply, tours, drafting), ...actions], REPLY_CALLS, budget), EventSink.EventSink = sink {
    const implementation = try Respond.requirement
    return try implementation.action({ turns })
  }
}

/** Everything between starting the reply and settling it: the budget, the history, the agent and the spend. */
effect function compose(post: string, reply: string) {
  const replies = try Replies
  const spend = try Spend
  const chat = try ChatModel
  const model = chat.model
  if (model === undefined) {
    try Effect.logWarning("vibelang.reply.unconfigured").pipe(Effect.annotateLogs({ reason: chat.unusable }))
    return Outcome.Failed({ reason: REASONS.unconfigured })
  }
  const admission = try Action.make({
    name: "vibelang/reply/admit",
    success: Schema.Struct({ day: Schema.String, admitted: Schema.Boolean }),
    error: Unreachable,
    retryPolicy: patient,
    execute: effect {
      const day = dayOf(try Clock.currentTimeMillis)
      return { day, admitted: try spend.admit(day, reply, REPLY_CEILING) }
    },
  })
  if (!admission.admitted) return Outcome.Failed({ reason: REASONS.budget })
  const turns = try Action.make({
    name: "vibelang/reply/history",
    success: Schema.Array(Turn),
    execute: replies.history(post),
  })
  const meter = callBudget(try Effect.orDie(Budget.make({})), spend, reply, admission.day, REPLY_CEILING)
  const { answered, progress } = try respond(reply, model, turns, meter)
  if (Exit.isFailure(answered) && Cause.hasInterrupts(answered.cause)) return try Effect.failCause(answered.cause)
  try Action.make({
    name: "vibelang/reply/spend",
    error: Unreachable,
    retryPolicy: patient,
    execute: spend.spend(admission.day, reply, progress.tokens, progress.usageValid && progress.failed === undefined, REPLY_CEILING),
  })
  const failure = Exit.isFailure(answered) ? Cause.squash(answered.cause) : undefined
  const tag = failure === undefined ? "answered" : tagOf(failure)
  try Effect.logInfo("vibelang.reply.agent").pipe(Effect.annotateLogs({ outcome: progress.usageValid ? progress.failed ?? tag : "invalid-usage", tokens: progress.tokens }))
  const rawText = Exit.isSuccess(answered) ? answered.value : undefined
  const text = typeof rawText === "string" ? rawText : ""
  const disposition = completion(Exit.isFailure(answered), progress.usageValid, text.trim() !== "")
  if (disposition === "answered") return Outcome.Answered({ text })
  if (disposition === "empty") return Outcome.Failed({ reason: REASONS.empty })
  // The ledger could not record a model call's charge: the budget's failure, not the model's.
  if (meter.ledgerUnavailable()) {
    try Effect.logWarning("vibelang.reply.spend").pipe(Effect.annotateLogs({ outcome: "unreachable" }))
    try Metric.update(Metric.counter("vibelang_reply_spend_failures", { incremental: true }), 1)
    return Outcome.Failed({ reason: REASONS.budget })
  }
  return Outcome.Failed({ reason: failure instanceof HarnessError.HarnessError && typeof failure.cause === "object" && failure.cause !== null && "_tag" in failure.cause && failure.cause._tag === "vibelang/DailyBudgetExceeded" ? REASONS.budget : Exit.isFailure(answered) ? failureReason(tag, progress) : REASONS.failed })
}

/** The reply flow's body: start the reply, compose it, then settle it as finished or failed. */
export effect function answer(post: string) {
  let run = beginReply()
  const replies = try Replies
  const reply = replyIdOf(post)
  const started = try Action.make({
    name: "vibelang/reply/start",
    success: Answered,
    error: Busy,
    retryPolicy: patient,
    execute: effect {
      const answered = try replies.start(post)
      if (answered === "busy") throw new Busy()
      return answered
    },
  })
  run = recordReplyStart(run, started)
  if (!canComposeReply(run)) {
    try Effect.logWarning("vibelang.reply").pipe(Effect.annotateLogs({ outcome: "refused" }))
    return null
  }
  // Interruption is the engine's (a reset or a yielded drive): it resumes the flow, so it is never a failed reply.
  run = beginReplyComposition(run)
  // The engine's deadline counts from the journaled start, so a restarted reply keeps it; expiry is a defect, a failed reply.
  const bounded = try Effect.try(() => Deadline.bound({ flowName: Reply._tag, deadline: replyDeadline })).pipe(Effect.orDie)
  const outcome = try Effect.catchCause(compose(post, reply).pipe(bounded), (cause) => {
    if (Cause.hasInterrupts(cause)) return Effect.failCause(cause)
    return Effect.as(
      Effect.logError("vibelang.reply").pipe(Effect.annotateLogs({ outcome: "failed", error: tagOf(Cause.squash(cause)) })),
      Outcome.Failed({ reason: REASONS.failed }),
    )
  })
  run = finishReplyComposition(run)
  const settled = match (outcome) {
    when { _tag: "Answered", let text }: replies.finish(reply, text);
    when { _tag: "Failed", let reason }: replies.fail(reply, reason);
  }
  // A composed reply settles once: by the proved contracts above, a run past `canComposeReply` is ready with one start
  // and one composition and no settlement, which is `canSettleReply`.
  try Action.make({ name: "vibelang/reply/settle", success: Answered, execute: settled })
  run = recordReplySettlement(run)
  try Effect.logInfo("vibelang.reply.order").pipe(Effect.annotateLogs({ startReceipts: run.starts, compositions: run.compositions, settlementReceipts: run.settlements }))
  return null
}

/** Registers `Reply` with the engine; its steps reach the sequencer, the budget and the model through services. */
export const registration = Interpreter.layerWithImplementations(Reply, ReplyStep.toLayer((payload) => Effect.orDie(answer(payload.post))))
  .pipe(Layer.provide(WebCrypto.layer))
