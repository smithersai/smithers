// The Actions HTTP protocol's and run directory's decisions (0023; 0018, lane vl-proveall2 worker batch), for
// ActionsHttp.vibe and ActionDirectory.vibe. The callers keep URL parsing, Number, Schema decoding, JSON comparison,
// the body read and every engine call. Each kernel restates an expression those modules used.

import type { InvocationKind } from "../src/actions/actionHostDecision.vibe"

/** The longest action request body read, in bytes. */
export const MAX_BODY = 32000

/** A declared body length is refused when it is not all ASCII digits or names more than MAX_BODY bytes. */
//@ verify
//@ ensures declared == undefined ==> !\result
//@ ensures declared != undefined ==> \result == (!\matches("^[0-9]+$", declared) || value > 32000)
export function declaredTooLarge(declared: string | undefined, value: number): boolean {
  return declared !== undefined && (!/^[0-9]+$/.test(declared) || value > 32000)
}

/** A write from another page is refused; a request without Origin (a CLI, a server) is not a browser page. */
//@ verify
//@ ensures \result == (method != "GET" && origin != undefined && origin != own)
export function crossOriginWrite(method: string, origin: string | undefined, own: string): boolean {
  return method !== "GET" && origin !== undefined && origin !== own
}

export type ActionsRoute = "flows" | "commands" | "runs" | "start" | "run"

/** Which collection a request names; anything else under the path is a single run's route. */
//@ verify
//@ ensures \result == (path == "/api/actions" && method == "GET" ? "flows" : (path == "/api/actions/commands" && method == "GET" ? "commands" : (path == "/api/actions/runs" && method == "GET" ? "runs" : (path == "/api/actions/runs" && method == "POST" ? "start" : "run"))))
export function actionsRoute(path: string, method: string): ActionsRoute {
  if (path === "/api/actions" && method === "GET") return "flows"
  if (path === "/api/actions/commands" && method === "GET") return "commands"
  if (path === "/api/actions/runs" && method === "GET") return "runs"
  if (path === "/api/actions/runs" && method === "POST") return "start"
  return "run"
}

/** A run id: `a` then 1 to 64 letters, digits and hyphens. */
//@ verify
//@ ensures \result == \matches("^a[a-zA-Z0-9-]{1,64}$", id)
export function runIdValid(id: string): boolean {
  return /^a[a-zA-Z0-9-]{1,64}$/.test(id)
}

export type RunRoute = "rerun" | "events" | "read" | "cancel" | ""

/** What a request does to one run, from its method and the path parts after the run id. */
//@ verify
//@ ensures \result == (method == "POST" && parts == 2 && second == "rerun" ? "rerun" : (method == "GET" && parts == 2 && second == "events" ? "events" : (method == "GET" && parts == 1 ? "read" : (method == "DELETE" && parts == 1 ? "cancel" : ""))))
export function runRoute(method: string, parts: number, second: string): RunRoute {
  if (method === "POST" && parts === 2 && second === "rerun") return "rerun"
  if (method === "GET" && parts === 2 && second === "events") return "events"
  if (method === "GET" && parts === 1) return "read"
  if (method === "DELETE" && parts === 1) return "cancel"
  return ""
}

/** A write's status: `accepted` when nothing refused it, 403 when forbidden, else `otherwise`. */
//@ verify
//@ ensures refusal == null ==> \result == accepted
//@ ensures refusal != null ==> \result == (refusal == "forbidden" ? 403 : otherwise)
export function writeStatus(refusal: string | null, accepted: number, otherwise: number): number {
  if (refusal === null) return accepted
  return refusal === "forbidden" ? 403 : otherwise
}

/** Who started a run: an agent principal, or any principal through the agent door, is the agent; else the person. */
//@ verify
//@ ensures \result == ((agent || door == "agent") ? "agent" : "person")
export function startActor(agent: boolean, door: string | undefined): "agent" | "person" {
  return agent || door === "agent" ? "agent" : "person"
}

/** A rerun is the caller's own: an agent principal reruns as the agent, everyone else as a person. */
//@ verify
//@ ensures \result == (agent ? "agent" : "person")
export function callerActor(agent: boolean): "agent" | "person" {
  return agent ? "agent" : "person"
}

/** A start whose id already holds a different request is a conflict; the same request again is not. */
//@ verify
//@ ensures \result == (original != undefined && original != request)
export function startConflict(original: string | undefined, request: string): boolean {
  return original !== undefined && original !== request
}

/** The flow whose role a cancel needs: a Post's reply child is cancelled as its Post, any other run as itself. */
//@ verify
//@ ensures \result == (replyChild ? requestFlow : runFlow)
export function cancelFlow(replyChild: boolean, requestFlow: string, runFlow: string): string {
  return replyChild ? requestFlow : runFlow
}

/** A post is the one flow that reserves a reply child: its route, its index entry and a child's root. */
//@ verify
//@ ensures \result == (flow == "vibelang/Post")
export function postFlow(flow: string): boolean {
  return flow === "vibelang/Post"
}

/** A post's alarm settles the agent-started runs once its reply is done. */
//@ verify
//@ ensures \result == (flow == "vibelang/Post" && done)
export function agentRunsSettle(flow: string, done: boolean): boolean {
  return postFlow(flow) && done
}

/** Only a run the agent started settles with the post's reply. */
//@ verify
//@ ensures \result == (actor == "agent")
export function agentRun(actor: string): boolean {
  return actor === "agent"
}

/** A post's reply child reserved for another post conflicts; unreserved, or reserved for this post, does not. */
//@ verify
//@ ensures \result == (reserved != undefined && reserved != id)
export function reservedByOther(reserved: string | undefined, id: string): boolean {
  return reserved !== undefined && reserved !== id
}

/** A conversation's open agent reply, the one an engine failure, a cancel or a changed permission fails: the agent's
 * entry that has not finished. */
//@ verify
//@ ensures \result == (author == "agent" && !done)
export function openAgentReply(author: string, done: boolean): boolean {
  return author === "agent" && !done
}

/** A tour's accepted start dispatched its first agent reply: open, and answering no entry. */
//@ verify
//@ ensures \result == (author == "agent" && !done && inReplyTo == "")
export function openRootReply(author: string, done: boolean, inReplyTo: string): boolean {
  return openAgentReply(author, done) && inReplyTo === ""
}

/** Tour and Post are the conversational runs: their replies live in the run's conversation, not a history host. */
//@ verify
//@ ensures \result == (flow == "vibelang/Tour" || flow == "vibelang/Post")
export function conversationalFlow(flow: string): boolean {
  return flow === "vibelang/Tour" || postFlow(flow)
}

/** A run's reply is done when the agent's reply is there and finished. */
//@ verify
//@ ensures \result == (present && done)
export function replyDone(present: boolean, done: boolean): boolean {
  return present && done
}

/** A run's reply failed when the engine failed its execution, or the agent's reply is there with an error. */
//@ verify
//@ ensures \result == (engineFailed || (present && error != ""))
export function replyFailed(engineFailed: boolean, present: boolean, error: string): boolean {
  return engineFailed || (present && error !== "")
}

/** A Post run's trace event from its Reply flow belongs to the post's reply child. */
//@ verify
//@ ensures \result == (eventFlow == "vibelang/Reply" && requestFlow == "vibelang/Post")
export function replyChildEvent(eventFlow: string, requestFlow: string): boolean {
  return eventFlow === "vibelang/Reply" && postFlow(requestFlow)
}

/** Whether a directory lists a run it read from index `source`: from its own index, or a child no index holds. */
//@ verify
//@ ensures \result == (id == source || !indexed)
export function indexedRun(id: string, source: string | undefined, indexed: boolean): boolean {
  return id === source || !indexed
}

/** Whether an invocation runs on the history host (worker/HistoryActions): everything but a post and a tour. */
//@ verify
//@ ensures \result == (kind != "post" && kind != "tour")
export function historyKind(kind: InvocationKind): boolean {
  return kind !== "post" && kind !== "tour"
}
