// The ledger's integer transition, called inside Budget's storage lock.
export interface Charge { readonly spent: number; readonly added: number; readonly write: boolean }

/** Admission is strict: a day at its allowance cannot start another answer. */
//@ verify
//@ ensures \result == (spent < limit)
export function admits(spent: number, limit: number): boolean {
  return spent < limit
}

/** A replay adds nothing; a new reply's entire nonnegative charge is added exactly once. */
//@ verify
//@ requires 0 <= spent && 0 <= used && spent + used <= 9007199254740991
//@ ensures \result.write == !recorded
//@ ensures \result.spent >= 0 && \result.added >= 0
//@ ensures \result.spent == spent + \result.added
//@ ensures recorded ==> \result.spent == spent && \result.added == 0
//@ ensures !recorded ==> \result.spent == spent + used && \result.added == used
export function charge(spent: number, used: number, recorded: boolean): Charge {
  if (recorded) return { spent, added: 0, write: false }
  return { spent: spent + used, added: used, write: true }
}

/** The integer arithmetic domain a new ledger charge must stay inside. */
//@ verify
//@ ensures \result == (0 <= spent && 0 <= used && spent + used <= 9007199254740991)
export function canCharge(spent: number, used: number): boolean {
  return spent >= 0 && used >= 0 && used <= 9007199254740991 - spent
}

/** One conversation's charge key in the day's shared ledger: the object's identity namespaces it. */
//@ verify
//@ ensures \result == host + ":" + reply
export function chargeKeyOf(host: string, reply: string): string {
  return host + ":" + reply
}
