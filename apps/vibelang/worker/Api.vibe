import * as Cloudflare from "@alchemy.run/cloudflare"
import { Telemetry } from "alchemy"
import { GitHub } from "@smthrs/integrations"
import { workerBuild } from "../infra/WorkerBuild.vibe"
import { FetchHttpClient, HttpClient } from "effect/http"
import type { AccountsShape, ActionDirectoryShape, BudgetShape, ConversationShape, HistoryShape, Namespace } from "./apiObjects.vibe"

export type { AccountsShape, ActionDirectoryShape, BudgetShape, ConversationShape, HistoryShape } from "./apiObjects.vibe"

/**
 * The Worker's request code: its objects, the agent, the model and the flows. Cloudflare refuses a Worker whose global
 * scope takes more than 1 second of CPU (https://developers.cloudflare.com/workers/platform/limits/#worker-startup-time),
 * and parsing this graph took most of it, so it loads when the first event builds the Worker or an object, never at
 * startup (wiki/decisions/0033-worker-startup.md). Imported statically, it is evaluated at startup again.
 */
const runtime = withSpan(effect {
  const loaded = try promise(() => import("./apiRuntime.vibe"))
  try Metric.update(Metric.counter("vibelang_api_runtime_loads", { incremental: true }), 1)
  return loaded
}, "vibelang.api.runtime")

/** One conversation's sequencer and current reply, named by the conversation's id. */
export class Conversation extends Cloudflare.DurableObject<Conversation, ConversationShape>()("Conversation") {}
/** One UTC day's token budget, named by the day. */
export class Budget extends Cloudflare.DurableObject<Budget, BudgetShape>()("Budget") {}
/** VibeLang's mythical history, named by the repository (wiki/decisions/0020-mythical-history.md). */
export class History extends Cloudflare.DurableObject<History, HistoryShape>()("History") {}
export class ProjectAccounts extends Cloudflare.DurableObject<ProjectAccounts, AccountsShape>()("ProjectAccounts") {}
export class ActionIndex extends Cloudflare.DurableObject<ActionIndex, ActionDirectoryShape>()("ActionIndex") {}

const authTelemetry = Telemetry.layer(GitHub.Auth.Broker.httpPolicy)
const executionProps = Effect.flatMap(Cloudflare.WorkerExecutionContext, (context) => context.props as Record<string, unknown>!!)

const AccountsLive = ProjectAccounts.make(effect {
  try Layer.build(authTelemetry)
  const state = try Cloudflare.DurableObjectState
  const budgets = (try Budget) as Namespace<BudgetShape>
  const { Accounts, accountsObject, chatModel, specificationModels } = try runtime
  const model = try Effect.orDie(chatModel())
  try Effect.orDie(specificationModels())
  const setup = try Effect.orDie(Accounts.configured().pipe(Effect.provide(FetchHttpClient.layer)))
  return accountsObject(state, budgets, model, setup, try Effect.provide(HttpClient.HttpClient, FetchHttpClient.layer))
})

const BudgetLive = Budget.make(effect {
  const state = try Cloudflare.DurableObjectState
  const { budgetObject, dailyTokens } = try runtime
  const limit = try Effect.orDie(dailyTokens)
  return budgetObject(state, limit)
})

const HistoryLive = History.make(effect {
  const state = try Cloudflare.DurableObjectState
  // Read when the Worker deploys and when an object starts. The site holds no GitHub token: main is read through
  // smithers.sh's App with the site's broker key (0031).
  const { exporterOf, historyObject, readSetup } = try runtime
  const reads = try Effect.orDie(readSetup())
  const client = try Effect.provide(HttpClient.HttpClient, FetchHttpClient.layer)
  // Publishing the mythical history stays off until Will grants the site a write to VibeLang's repository (0020).
  const setting = Option.getOrUndefined(try Effect.orDie(Config.option(Config.String("HISTORY_EXPORT"))))
  const token = Option.getOrUndefined(try Effect.orDie(Config.option(Config.Redacted("HISTORY_EXPORT_TOKEN"))))
  return historyObject(state, reads, client, try exporterOf(setting, token, client))
})

const ConversationLive = Conversation.make(effect {
  const state = try Cloudflare.DurableObjectState
  const budgets = (try Budget) as Namespace<BudgetShape>
  const histories = (try History) as Namespace<HistoryShape>
  const accounts = (try ProjectAccounts) as Namespace<AccountsShape>
  const { chatModel, conversationObject } = try runtime
  // Read when the Worker deploys and when an object starts, so the deployment's model and key are bound.
  const model = try Effect.orDie(chatModel())
  return conversationObject(state, budgets, histories, accounts, model, Cloudflare.toHttpClient)
})

const ActionIndexLive = ActionIndex.make(effect {
  const accounts = (try ProjectAccounts) as Namespace<AccountsShape>
  const state = try Cloudflare.DurableObjectState
  const conversations = (try Conversation) as Namespace<ConversationShape>
  const { actionIndexObject } = try runtime
  return actionIndexObject(state, accounts, conversations)
})

/** The Worker's settings. */
export const props = {
  main: "worker/Api.vibe",
  compatibility: { date: "2026-10-01" },
  observability: { enabled: true, logs: { enabled: true, invocationLogs: true, persist: true } },
  // An alarm drives a reply, its model call included; waiting on the model costs no CPU.
  limits: { cpuMs: 300_000 },
  // The site reaches it by service binding, so locally it takes any free port.
  dev: { port: 0 },
  // Its import graph reaches `.vibe` modules, which vibelang-unplugin compiles.
  build: workerBuild,
}

const AuthenticatedSandboxes = Layer.unwrap(effect {
  const { gatewayWithIdentity, sandboxIdentityOf, SandboxIdentity } = try runtime
  const identity = Layer.effect(SandboxIdentity, effect {
    const namespace = (try ProjectAccounts) as Namespace<AccountsShape>
    return sandboxIdentityOf(namespace, executionProps)
  })
  return gatewayWithIdentity.pipe(Layer.provide(identity))
})

const program = effect {
  const conversations = (try Conversation) as Namespace<ConversationShape>
  const { apiFetch, chatModel, dailyTokens, SandboxGateway, specificationModels } = try runtime
  const { gateway } = try SandboxGateway
  const accounts = (try ProjectAccounts) as Namespace<AccountsShape>
  const actions = (try ActionIndex) as Namespace<ActionDirectoryShape>
  const histories = (try History) as Namespace<HistoryShape>
  // Bound when the Worker deploys, as its objects read them. The commit lets /api/health say what is deployed.
  const commit = Option.getOrUndefined(try Effect.orDie(Config.option(Config.String("VIBELANG_COMMIT"))))
  try Effect.orDie(chatModel())
  try Effect.orDie(dailyTokens)
  try Effect.orDie(specificationModels())
  return { fetch: apiFetch({ conversations, accounts, actions, histories, budgets: (try Budget) as Namespace<BudgetShape> }, gateway, commit, executionProps) }
}

export default class Api extends Cloudflare.Worker<Api>()(
  "VibelangApi",
  props,
  program.pipe(Effect.provide(ActionIndexLive), Effect.provide(ConversationLive), Effect.provide(AuthenticatedSandboxes), Effect.provide(AccountsLive), Effect.provide(BudgetLive), Effect.provide(HistoryLive), Effect.provide(authTelemetry)),
) {}

