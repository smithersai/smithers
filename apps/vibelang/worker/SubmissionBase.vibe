import type { Storage } from "./Objects.vibe"
import { submissionStep } from "./workerDecision.vibe"

/** The immutable source of a logical submission, shared by its automatic retries and recovery executions. */
schema SubmissionBase { repository: string; branch: string; sha: string }

/** Persist the source before binding any GitHub write key. A failed observation never binds a source. */
export effect function submissionBase<E, R>(storage: Storage | undefined, executionId: string, observe: () => SubmissionBase!E!R) {
  const key = `submission/base/${executionId}`
  let known: unknown = undefined
  if (storage !== undefined) known = try promise(() => storage.get(key))
  const step = submissionStep(storage !== undefined, known !== undefined)
  // "observe" holds exactly when storage is undefined (proved); the second test narrows the type.
  if (step === "observe" || storage === undefined) return try observe()
  if (step === "decode") return try Schema.decodeUnknownEffect(SubmissionBase)(known)
  const base = try observe()
  try promise(() => storage.put(key, base))
  return base
}
