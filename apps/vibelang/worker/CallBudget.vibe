// Each physical provider invocation owns a durable receipt, including reissues inside one model step.
import { Budget } from "@smthrs/agent"
import { HarnessError } from "@smthrs/harness"
import { Clock, Effect, Schema } from "effect"
import { SecureRandom } from "effect/crypto"

interface Ledger {
  admit(day: string, key: string, ceiling: number): Effect.Effect<boolean, unknown>
  spend(day: string, key: string, used: number, reported: boolean, ceiling: number): Effect.Effect<void, unknown>
}

/** The input allowance shared by the agent compactor and each call reservation. */
export const INPUT_CEILING = 32_768

const Receipt = Schema.fromJsonString(Schema.Struct({ day: Schema.String, key: Schema.String, ceiling: Schema.Number }))
const unavailable = (cause: unknown) => new Budget.AccountingUnavailable({ phase: "record", runId: "physical-call", message: "The daily budget ledger is unavailable", cause })

/** A call meter that also says whether the day's ledger was unreachable during the run. */
export interface CallBudget extends Budget.Service {
  /** Whether a ledger operation of this run was unavailable. The harness's error loses the cause's tag. */
  readonly ledgerUnavailable: () => boolean
}

/** Replaces the ordinary meter's provider boundary; its logical-step ledger remains unchanged. */
export function callBudget(meter: Budget.Service, ledger: Ledger, parent: string, admittedDay: string, parentCeiling: number): CallBudget {
  let outage = false
  /**
   * One ledger attempt, then accounting unavailable. DUR-2: the flow engine owns retries, never this callback.
   * The model step seals its receipt before recording usage; a failed charge retains its reservation (0030).
   */
  const steady = <A>(operation: Effect.Effect<A, unknown>) => operation.pipe(
    Effect.tapError(() => Effect.sync(() => { outage = true })),
    Effect.mapError(unavailable),
  )
  return {
    ...meter,
    ledgerUnavailable: () => outage,
    reserveCall: request => Effect.gen(function*() {
      // The run admission prevents work when the day is full. Physical receipts
      // take over its reservation, once; the final run charge is then an idempotent no-op.
      yield* steady(ledger.spend(admittedDay, parent, 0, true, parentCeiling))
      const maximum = request.params.maxTokens
      if (maximum === undefined || !Number.isSafeInteger(maximum) || maximum <= 0 || !Number.isSafeInteger(INPUT_CEILING + maximum)) {
        return yield* Effect.fail(new HarnessError.HarnessError({ code: "engine_failed", message: "The model call has no usable ceiling" }))
      }
      const ceiling = INPUT_CEILING + maximum
      const day = new Date(yield* Clock.currentTimeMillis).toISOString().slice(0, 10)
      const id = yield* Effect.gen(function*() { return yield* (yield* SecureRandom.SecureRandom).uuidV4() }).pipe(Effect.provide(SecureRandom.layerWebCrypto), Effect.mapError(unavailable))
      const key = `model/${id}`
      const admitted = yield* steady(ledger.admit(day, key, ceiling))
      if (!admitted) return yield* Effect.fail(new HarnessError.HarnessError({ code: "engine_failed", cause: { _tag: "vibelang/DailyBudgetExceeded" }, message: "The daily model budget is spent" }))
      return yield* Schema.encodeEffect(Receipt)({ day, key, ceiling }).pipe(Effect.mapError(unavailable))
    }),
    recordCall: (receipt, usage, settled) => Effect.gen(function*() {
      const call = yield* Schema.decodeUnknownEffect(Receipt)(receipt).pipe(Effect.mapError(unavailable))
      const usable = settled && Budget.reportsTokens(usage)
      const used = usable ? Budget.tokensOf(usage) : 0
      yield* steady(ledger.spend(call.day, call.key, used, usable, call.ceiling))
    }),
  }
}
