// Test-stage counter export. No production Worker mounts this handler. The identity checks the probe token and
// deadline before any RPC; responses hold only the instrumenter's counts, locations and compiler source maps.
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import type { AccountBindingShape } from "./SandboxAccounts.vibe"
import type { MachineBindingShape } from "./SandboxMachine.vibe"
import type { SandboxIdentity } from "./accountObject.vibe"
import { PROBE_CONVERSATION } from "./sandboxProbeFetch.vibe"
import { sandboxCounters } from "../bench/sandbox-counters.ts"
import { observed } from "../src/core/sandboxHost.vibe"

export function benchmarkFetch(fetch: Effect.Effect<HttpServerResponse.HttpServerResponse, never, HttpServerRequest.HttpServerRequest | RuntimeContext>, accounts: { getByName(name: string): AccountBindingShape }, machines: { getByName(name: string): MachineBindingShape }, identity: SandboxIdentity.Shape) {
  return observed("benchmark-coverage", effect {
    const request = try HttpServerRequest.HttpServerRequest
    if (new URL(request.url, "https://probe.invalid").pathname !== "/api/probe/coverage") return try fetch
    const { owner } = try identity.request()
    if (owner === "") return HttpServerResponse.jsonUnsafe({ error: "forbidden" }, { status: 403 })
    if (request.method !== "POST") return HttpServerResponse.jsonUnsafe({ error: "method" }, { status: 405 })
    const account = try accounts.getByName(owner).benchmarkCoverage()
    const machine = try machines.getByName(`${owner}/${PROBE_CONVERSATION}`).benchmarkCoverage()
    return HttpServerResponse.jsonUnsafe({ schema: 1, snapshots: [sandboxCounters(), account, machine] }, { headers: { "cache-control": "no-store" } })
  })
}
