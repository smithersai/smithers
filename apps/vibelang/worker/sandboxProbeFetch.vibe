// The vl-test stage's sandbox probe (decision 0024, ruling VL-35): the product's sandbox objects and HTTP protocol over
// real Cloudflare Containers, reached with a test token instead of a person's session. Alchemy is imported for types
// only, so a Node test can serve this body; its binding is SandboxProbe.vibe.
//
// Spend is bounded by the owner itself: a probe owner is `probe-<deadline>`, admitted only while now < deadline and the
// deadline is at most PROBE_WINDOW_MS away. Past the deadline the owner is a Viewer, so its account's alarm stops every
// running generation through the SandboxMeter flow (the leftover sweeper), and every lease is clamped to the deadline,
// so Cloudflare's inactivity timeout ends a container even if the alarm never runs.
import { digestSync } from "@smthrs/crypto"
import type { RuntimeContext } from "alchemy/RuntimeContext"
import { HttpServerRequest, HttpServerResponse } from "effect/http"
import type { Role } from "../src/core/sandboxDecision.vibe"
import { observed } from "../src/core/sandboxHost.vibe"
import type { AccountShape, SandboxIdentity } from "./accountObject.vibe"
import type { MachineShape } from "./machineObject.vibe"
import type * as ContainerRecording from "@smthrs/testing/ContainerRecording"
import { sandboxRequest, type Gateway } from "./SandboxHttp.vibe"
import { leaseMillis, PROBE_WINDOW, probeAdmitted, probeOwnerOf, probeConversationKnown, probeOwnerShaped, probeRole, probeRoute, stillRunning } from "./sandboxWorkerDecision.vibe"

/** The Alchemy stage that deploys only the probe, its objects and the image (infra/Stack.vibe). */
export const PROBE_STAGE = "vl-test"
/** The longest a probe owner may hold compute: its deadline is at most this far from any admitted request. */
export const PROBE_WINDOW_MS = PROBE_WINDOW
/** The one conversation a probe run uses, so one run holds at most one sandbox. */
export const PROBE_CONVERSATION = "live"
export const OWNER_HEADER = "x-vibelang-probe-owner"
/**
 * The direct route's conversation: one machine per owner that `POST /api/probe/machine` drives outside any account,
 * always at DIRECT_GENERATION, so the suite records the machine's own refusals of a running box on a real Container.
 * Its spend ends with the suite's stop, or with Cloudflare's inactivity timeout: a lease there is clamped as well.
 */
export const DIRECT_CONVERSATION = "direct"
export const DIRECT_GENERATION = 1
/** A probe machine also answers the Container calls it recorded (sandboxProbeContainer.vibe). */
export interface Recorded { recording(): ReadonlyArray<ContainerRecording.Call>!!RuntimeContext }
const DirectRequest = Schema.Tuple([Schema.Literals(["start", "stop", "command", "lease", "status"]), Schema.String, Schema.String])
const ROUTES = new Set(["/api/probe/sweep", "/api/probe/machine", "/api/probe/container"])

type Named<Shape> = { getByName(name: string): Shape }

export function probeOwner(deadline: number) {
  return `probe-${deadline}`
}
export function deadlineOf(owner: string): number | undefined {
  return probeOwnerShaped(owner) ? Number(owner.slice("probe-".length)) : undefined
}
/** An owner holds compute only before its deadline, and only a deadline within the window is accepted. */
export function admitted(owner: string, now: number) {
  return probeAdmitted(deadlineOf(owner), now)
}
/** A lease never outlives its owner's deadline; machineObject's floor of one second still applies. */
export function leaseFor(id: string, milliseconds: number, now: number) {
  return leaseMillis(deadlineOf(id.split("/")[0]!), milliseconds, now)
}

/** Compare by digest, so the comparison's time doesn't depend on how much of the token a caller guessed. */
effect function authorized(token: string, header: string | undefined) {
  return token !== "" && (try Effect.orDie(Effect.try(() => digestSync(header ?? "") === digestSync(`Bearer ${token}`))))
}
effect function ownerOf(request: HttpServerRequest.HttpServerRequest, token: string, now: number) {
  const owner = request.headers[OWNER_HEADER] ?? ""
  return probeOwnerOf(try authorized(token, request.headers["authorization"]), admitted(owner, now), owner)
}

/** The probe's principal: a Contributor while its token matches and its owner's deadline holds; otherwise signed out. */
export function probeIdentity(token: string): SandboxIdentity.Shape {
  return {
    request: effect () => {
      const owner = try ownerOf(try HttpServerRequest.HttpServerRequest, token, try Clock.currentTimeMillis)
      return { owner, role: probeRole(owner !== "") }
    },
    role: effect (owner: string) => probeRole(admitted(owner, try Clock.currentTimeMillis)) as Role,
  }
}

/** The machine namespace the probe's accounts see: every lease clamped to its owner's deadline. */
export function leaseClamped(namespace: Named<MachineShape>): Named<MachineShape> {
  return {
    getByName: (id) => {
      const stub = namespace.getByName(id)
      return {
        apply: (kind, generation, operationId, command) => kind !== "lease" ? stub.apply(kind, generation, operationId, command) : Effect.flatMap(Clock.currentTimeMillis, (now) => stub.apply(kind, generation, operationId, String(leaseFor(id, Number(command), now)))),
      }
    },
  }
}

const json = (body: unknown, status = 200) => HttpServerResponse.jsonUnsafe(body, { status, headers: { "cache-control": "no-store" } })

/**
 * Stops what a probe owner left running and answers whether its container still runs. Before the deadline it stops the
 * running generation through the account's Stop flow; after it, the account's alarm runs SandboxMeter, which stops
 * every generation of an owner who may no longer start. The answer is the container's own state, not the ledger's.
 */
export effect function sweep(accounts: Named<AccountShape>, machines: Named<MachineShape>, owner: string) {
  const account = try Effect.try(() => accounts.getByName(owner))
  const now = try Clock.currentTimeMillis
  if (admitted(owner, now)) {
    const read = try account.run(owner, "read", PROBE_CONVERSATION, `sweep-read/${now}`, 0, "")
    if (read.ok && read.snapshot.status === "running") try account.run(owner, "stop", PROBE_CONVERSATION, `sweep/${read.snapshot.generation}`, read.snapshot.generation, "")
  } else try account.alarm()
  const machine = try Effect.try(() => machines.getByName(`${owner}/${PROBE_CONVERSATION}`))
  const status = try machine.apply("status", 0, "", "")
  return { running: stillRunning(status.ok, status.output) }
}

/** One operation on the owner's direct machine, before the owner's deadline only; its lease is clamped to it. */
effect function direct(request: HttpServerRequest.HttpServerRequest, machines: Named<MachineShape>, owner: string) {
  if (!admitted(owner, try Clock.currentTimeMillis)) return json({ error: "forbidden" }, 403)
  const body = try Effect.option(Effect.flatMap(request.json, Schema.decodeUnknownEffect(DirectRequest)))
  if (Option.isNone(body)) return json({ error: "request" }, 400)
  const [kind, operationId, command] = body.value
  const machine = Effect.flatMap(Effect.try(() => leaseClamped(machines).getByName(`${owner}/${DIRECT_CONVERSATION}`)), (stub) => stub.apply(kind, DIRECT_GENERATION, operationId, command))
  const answer = observed("probe-machine", machine) catch () => undefined
  return answer === undefined ? json({ error: "sandbox unavailable" }, 503) : json(answer)
}

/** The Container calls the owner's machine of `?conversation=` recorded, before or after the deadline. */
effect function recorded(request: HttpServerRequest.HttpServerRequest, machines: Named<Recorded>, owner: string) {
  const conversation = new URL(request.url, "http://probe.invalid").searchParams.get("conversation")
  if (!probeConversationKnown(conversation ?? "")) return json({ error: "conversation" }, 400)
  const calls = observed("probe-container", Effect.flatMap(Effect.try(() => machines.getByName(`${owner}/${conversation}`)), (stub) => stub.recording())) catch () => undefined
  return calls === undefined ? json({ error: "sandbox unavailable" }, 503) : json({ calls })
}

/**
 * The probe Worker's fetch: the product's sandbox protocol, and the token-only sweep, direct machine route and
 * Container recording read.
 */
export function probeFetch(token: string, gateway: Gateway<RuntimeContext>, accounts: Named<AccountShape>, machines: Named<MachineShape & Recorded>) {
  return effect {
    const request = try HttpServerRequest.HttpServerRequest
    const path = new URL(request.url, "http://probe.invalid").pathname
    const route = probeRoute(path, request.method)
    if (route === "sandbox") return try sandboxRequest(gateway)
    if (route === "not-found") return json({ error: "not found" }, 404)
    if (!(try authorized(token, request.headers["authorization"]))) return json({ error: "forbidden" }, 403)
    const owner = request.headers[OWNER_HEADER] ?? ""
    if (!probeOwnerShaped(owner)) return json({ error: "owner" }, 400)
    if (route === "machine") return try direct(request, machines, owner)
    if (route === "container") return try recorded(request, machines, owner)
    const answer = observed("probe-sweep", sweep(accounts, machines, owner)) catch () => undefined
    return answer === undefined ? json({ error: "sandbox unavailable" }, 503) : json(answer)
  }
}
