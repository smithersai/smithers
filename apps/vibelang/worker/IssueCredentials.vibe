// The account host owns this encrypted, session-bound connection. Tokens never enter a flow payload or result.
import { WebCryptoCipher } from "@smthrs/control"
import { IssueFailure } from "../src/core/issueSchemas.vibe"
import type { Principal } from "./Issues.vibe"
import type { Storage } from "./Objects.vibe"

export interface SessionPerson { readonly key: string; readonly id: string; readonly login: string; readonly role: Principal["role"] }
schema Credential { readonly owner: string; readonly expires: number; readonly access: { readonly nonce: string; readonly ciphertext: string } }
export effect function make(storage: Storage, encryptionKey: Redacted.Redacted<string>, person: (signed: string | undefined) => (SessionPerson | undefined)!!) {
  const cipher = try Effect.orDie(WebCryptoCipher.make({ key: encryptionKey }))
  const context = (session: string) => ({ id: session, name: "github-issues", version: 1 })
  const credentials = {
    remember: effect (session: string, owner: string, token: Redacted.Redacted<string>, expires: number) => {
      const access = try Effect.orDie(cipher.seal(token, context(session)))
      try promise(() => storage.put("github/" + session, { owner, expires, access }))
    },
    forget: (session: string) => promise(() => storage.delete("github/" + session)).pipe(Effect.asVoid),
    current: effect (signed: string | undefined): (Principal | undefined)!IssueFailure => {
      const live = try person(signed).pipe(Effect.mapError(() => new IssueFailure({ reason: "sign-in" })))
      if (live === undefined) return undefined
      const read = promise(() => storage.get("github/" + live.key)) catch () => undefined
      const stored = Schema.decodeUnknownOption(Credential)(read)
      let token = Redacted.make("")
      if (Option.isSome(stored) && stored.value.owner === live.id && stored.value.expires > (try Clock.currentTimeMillis)) {
        token = try cipher.open(stored.value.access, context(live.key)).pipe(Effect.mapError(() => new IssueFailure({ reason: "connect" })))
      }
      return { id: live.id, login: live.login, role: live.role, token }
    },
  }
  return credentials
}
