// Public run index: requests are durable steps; each registered workflow runs in its own Conversation object.
import { Action, Flow, FlowRuntime, Interpreter } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { CloudflareRuntime, ObjectDatabase } from "@smthrs/platform-cloudflare"
import { type Role, type Run } from "../src/actions/Actions.vibe"
import { allowed, registration } from "../src/actions/catalog.vibe"
import { RunRequest } from "../src/actions/wire.vibe"
import { signedOut, type ActionIdentity } from "./ActionIdentity.vibe"
import { Unreachable } from "./Unreachable.vibe"
import type { Storage } from "./Objects.vibe"

export interface Runs {
  start(request: RunRequest, role: Role): (string | null)!Unreachable
  request(id: string): (RunRequest | undefined)!Unreachable
  read(id: string): ReadonlyArray<Run>!Unreachable
  cancel(id: string, role: Role, owner: string): (string | null)!Unreachable
}

/** Indexes the request's run id, so the directory lists it. */
export const IndexRequest = Action.make("vibelang/actions/index", { payload: { request: RunRequest }, success: Schema.Null })
/** Starts the request's run in its conversation: `null` once started, else the refusal. */
export const StartRequest = Action.make("vibelang/actions/start", { payload: { request: RunRequest }, success: Schema.NullOr(Schema.String), error: Unreachable })
/** Cancels the run through its own engine: `null` once cancelled, else the refusal. */
export const CancelRun = Action.make("vibelang/actions/cancel", { payload: { id: Schema.String }, success: Schema.NullOr(Schema.String), error: Unreachable })
export const RequestAction = Flow.make("vibelang/actions/Request", {
  description: "Records a registered action request and dispatches its durable run.",
  modelInvocable: false,
  error: Unreachable, payload: { request: RunRequest }, success: Schema.NullOr(Schema.String),
  body: Node.capture({}, (payload) => IndexRequest.call(payload).pipe(Node.andThen(StartRequest.call(payload)))),
})
export const CancelAction = Flow.make("vibelang/actions/Cancel", {
  description: "Cancels a registered action through its run's durable engine.",
  modelInvocable: false,
  error: Unreachable, payload: { id: Schema.String }, success: Schema.NullOr(Schema.String),
  body: Node.capture({}, (payload) => CancelRun.call(payload)),
})

/** Logs and counts a start refused because its id's journal holds a different request; fixed names only. */
function identityConflict() {
  return Effect.logWarning("vibelang.actions.start").pipe(
    Effect.annotateLogs({ outcome: "conflict" }),
    Effect.andThen(Metric.update(Metric.counter("vibelang_action_start_conflicts", { incremental: true }), 1)),
  )
}

export function directory(hostId: string, storage: Storage, runs: Runs, authority: Pick<ActionIdentity.Shape, "role"> = signedOut) {
  effect function list(flow: string) {
    const stored = try promise(() => storage.list({ prefix: "action-index/" }))
    const ids = [...stored.values()] as ReadonlyArray<string>
    const indexed = new Set(ids)
    const rows = try Effect.orDie(all(ids.map((id) => runs.read(id)), { concurrency: 4 }))
    // A run the agent starts inside another run is announced in that run's conversation too: each indexed run is listed
    // once, from its own conversation.
    return rows.flatMap((read, at) => read.filter((run) => run.id === ids[at] || !indexed.has(run.id))).filter((run) => flow === "" || run.flow === flow).sort((a, b) => b.started - a.started)
  }
  effect function start(request: RunRequest, role: Role) {
    const currentRole = try authority.role(request.owner ?? "")
    if (!allowed(currentRole, registration(request.flow))) return "forbidden"
    const original = try runs.request(request.id)
    if (original !== undefined && JSON.stringify(original) !== JSON.stringify(request)) return "conflict"
    // The steps act on the request admitted above, with the role decided above. The journaled payload is that request
    // decoded, whose keys follow the schema's order; storing the admitted object keeps a replay's conflict check (a
    // JSON comparison with the caller's request) byte-identical.
    const runtime = CloudflareRuntime.layer({ hostId, executionId: `request/${request.id}`, flow: RequestAction._tag }, Interpreter.layerWithImplementations(RequestAction, Layer.mergeAll(
      IndexRequest.toLayer(() => Effect.as(promise(() => storage.put(`action-index/${request.id}`, request.id)), null)),
      StartRequest.toLayer(() => runs.start(request, currentRole)),
    ))).pipe(Layer.provide(ObjectDatabase.layer(storage)))
    return try Effect.orDie(Effect.provide(effect {
      return try (try FlowRuntime.FlowRuntime).execute(RequestAction, { executionId: `request/${request.id}`, payload: { request } }).pipe(
        // A start refused before its run object stored the request (`input`, `forbidden`) leaves only this journal's
        // record of it, so a different request under that id is refused here, as the check above refuses a stored one.
        Effect.catchCause((cause) => {
          const reason = cause.reasons.length === 1 ? cause.reasons.find(Cause.isDieReason) : undefined
          return reason?.defect instanceof FlowRuntime.ExecutionIdentityConflict ? Effect.as(identityConflict(), "conflict") : Effect.failCause(cause)
        }),
      )
    }, runtime))
  }
  effect function cancel(id: string, role: Role, owner = "") {
    const currentRole = try authority.role(owner)
    const run = (try runs.read(id)).find(run => run.id === id)
    if (run === undefined) return "not-found"
    const request = try runs.request(id)
    const parent = run.flow === "vibelang/Reply" && request?.flow === "vibelang/Post" && id === `${request.id}-reply` ? request.flow : run.flow
    if (!allowed(currentRole, registration(parent))) return "forbidden"
    const runtime = CloudflareRuntime.layer({ hostId, executionId: `cancel/${id}`, flow: CancelAction._tag }, Interpreter.layerWithImplementations(CancelAction,
      CancelRun.toLayer((p) => runs.cancel(p.id, currentRole, owner)),
    )).pipe(Layer.provide(ObjectDatabase.layer(storage)))
    return try Effect.orDie(Effect.provide(effect {
      return try (try FlowRuntime.FlowRuntime).execute(CancelAction, { executionId: `cancel/${id}`, payload: { id } })
    }, runtime))
  }
  effect function rerun(id: string, next: string, role: Role, owner = "", caller?: { readonly name: string; readonly actor: "person" | "agent" }) {
    const original = try Effect.orDie(runs.request(id))
    if (original === undefined) return "not-found"
    return try start({ ...original, ...caller, owner, id: next, door: "button" }, role)
  }
  return { list, start, cancel, rerun }
}
