import { wikiSubmissionAllowed } from "../src/core/wikiDecision.vibe"
import { Digest, SecureRandom } from "effect/crypto"
import { Base64 } from "effect/encoding"
// The repository's Markdown is the wiki (GH-1, 0021): every edit is the person's own change, journaled once.
import { GitHub } from "@smthrs/integrations"
import { Action, FlowRuntime, RetryPolicy } from "@smthrs/flow"
import { CloudflareRuntime, ObjectDatabase, RunInspection } from "@smthrs/platform-cloudflare"
import { HttpClient, FetchHttpClient, HttpServerRequest, HttpServerResponse } from "effect/http"
import { applyWikiEdits, emptyWikiEdits, wikiPermission, type WikiEdits, type WikiOperation } from "../src/core/conversation.vibe"
import { WikiHost, wikiEditFlows, wikiEditRegistration, authorizeWiki, wikiExecutionId, wikiRecoveryId } from "../src/core/wikiFlows.vibe"
import { WikiFailure, WikiRequest, WikiState } from "../src/core/wikiSchemas.vibe"
import { pages } from "../src/core/wikiIndex.vibe"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import type { Principal, Repository } from "./Issues.vibe"
/** The embedded wiki is versioned with this app, separately from VibeLang's issue tracker. */
export interface WikiRepository extends Repository { readonly root: string; readonly branch?: string }
export const wikiRepository: WikiRepository = { owner: "smithersai", name: "smithers", api: "https://api.github.com", agent: "", root: "apps/vibelang/wiki" }
import type { Storage } from "./Objects.vibe"
import { GitHubDelegate, asPerson, refusalOf, type Connection } from "./GitHubDelegate.vibe"
import { submissionBase } from "./SubmissionBase.vibe"
import { PublicReads, READ_PATIENCE } from "./PublicReads.vibe"
import { carriesCode, connectFailure, failureReason, draftProposed, joinsReceipt, objectPath, pinnedConflict, readRetriesSignedOut, refusalReason, requestKey, retriesSettledFailure, sameActor, wikiDraftRefusal, wikiEditRefusal, writeKeyMissing, wikiRefusalStatus, wikiUnwritten } from "../src/core/issueHostDecision.vibe"
import { editable } from "../src/core/wikiPageDecision.vibe"
import { bodyLimit, objectMethod, withinBodyLimit } from "./workerDecision.vibe"

export service WikiAuthority {
  current(): (Principal | undefined)!WikiFailure
  readonly authorize?: (operation: WikiOperation) => void!WikiFailure
  readonly lost?: () => void!!
}

/** A page's repository path, or undefined for the generated decisions index and unknown pages. */
export function wikiFilePath(page: string, root = wikiRepository.root): string | undefined {
  return editable(pages, page) ? `${root}/${page}.md` : undefined
}

/** No raw provider error, request content or credential crosses this boundary. */
export function wikiFailureOf(error: unknown): WikiFailure {
  const refusal = refusalOf(error)
  if (refusal !== undefined) {
    const reason = refusalReason(refusal)
    return new WikiFailure({ reason, ...(carriesCode(reason) ? { code: reason } : {}) })
  }
  const details = (error as { readonly details?: Readonly<Record<string, unknown>> })?.details
  const status = details?.status
  const reason = failureReason(details?.outcomeUnknown === true, details?.incomplete === true, details?.rateLimited === true, typeof status === "number" ? status : 0)
  return new WikiFailure({ reason, ...(carriesCode(reason) ? { code: reason } : {}), ...(typeof details?.retryAfterMillis === "number" ? { retryAfterMillis: details.retryAfterMillis } : {}) })
}

/** Stable across native recovery executions; a changed payload can never adopt another execution's write. */
export effect function wikiWriteKey(repo: Repository, actor: string, request: WikiRequest, name: string) {
  const logical = JSON.stringify(["vibelang/wiki/v1", repo.owner, repo.name, actor, request.op, request.key, name])
  return try (try Digest.Digest).digestHex(Digest.sha256, new TextEncoder().encode(logical))
}

const StoredDraft = Schema.Struct({ page: Schema.String, text: Schema.String })

/** The GitHub host: reads are public observations; writes are the authenticated person's own commits and review changes. */
export effect function githubWikiHost(repo: WikiRepository = wikiRepository, storage?: Storage, fresh: () => boolean = () => false): WikiHost.Shape!never!(WikiAuthority | HttpClient.HttpClient) {
  const authority = try WikiAuthority
  const http = try HttpClient.HttpClient
  const writer = try Effect.serviceOption(WikiWriter)
  const delegate = try Effect.serviceOption(GitHubDelegate)
  const reads = try Effect.serviceOption(PublicReads)
  let edits: WikiEdits = emptyWikiEdits
  let touched = false
  effect function loadDraft(person: string, page: string) {
    if (storage === undefined || person === "") return undefined
    const stored = try promise(() => storage.get(`wiki/draft/${person}/${page}`))
    return Schema.decodeUnknownOption(StoredDraft)(stored).pipe(Option.getOrUndefined)
  }
  effect function readSource(path: string, ref = repo.branch) {
    const file = try GitHub.Contents.getText(repo.owner, repo.name, path, { ref }).pipe(Effect.mapError(wikiFailureOf))
    if (Option.isNone(file)) throw new WikiFailure({ reason: "missing" })
    return file.value
  }
  const host: WikiHost.Shape = {
    perform: effect (request) => {
      const actor = try authority.current()
      if (authority.authorize !== undefined) try authority.authorize(request.op)
      if ((!wikiPermission(actor?.role ?? "viewer", request.op) || !wikiSubmissionAllowed(request.op, actor?.kind ?? "person"))) throw new WikiFailure({ reason: "forbidden" })
      const path = wikiFilePath(request.page, repo.root)
      if (path === undefined) throw new WikiFailure({ reason: "missing", ...(fresh() ? { unwritten: true } : {}) })
      const work = effect {
        if (request.op === "read") {
          // A signed-out read GitHub refused answers the last good copy, marked with when GitHub last confirmed it (0031).
          const observed = try GitHub.ReadCache.observeStale(readSource(path), { patience: READ_PATIENCE })
          // executeWiki constructs a host per request. Observations belong to its answer; only people's drafts persist.
          const page = { id: request.page, source: observed.value.text, revision: observed.value.sha }
          const state = applyWikiEdits(edits, { type: "WikiEditsObserved", seq: edits.seq + 1, pages: [...edits.pages.filter(entry => entry.id !== page.id), page] })
          edits = state
          const draft = try loadDraft(actor?.id ?? "", request.page)
          const answer = draft === undefined ? state : { ...state, draft }
          return observed.stale === undefined ? answer : { ...answer, stale: observed.stale }
        }
        if (actor === undefined || writeKeyMissing(request.key)) throw new WikiFailure({ reason: "sign-in" })
        const key = (name: string) => wikiWriteKey(repo, actor.id, request, name)
        const repository = `${repo.owner}/${repo.name}`
        /** Every step re-reads who is asking; a role lost mid-flow stops the next one. */
        const live = effect {
          const current = try authority.current()
          if (current === undefined || !sameActor(current.id, actor.id) || !wikiPermission(current.role, request.op) || !wikiSubmissionAllowed(request.op, current.kind ?? "person")) throw new WikiFailure({ reason: "forbidden" })
          if (current.connection === undefined || Option.isNone(delegate)) {
            // As when the person arrived without a credential: keep the reviewed text until they reconnect.
            if (storage !== undefined && !touched) try promise(() => storage.put(`wiki/draft/${actor.id}/${request.page}`, { page: request.page, text: request.text }))
            throw new WikiFailure({ reason: "connect" })
          }
          if (authority.authorize !== undefined) try authority.authorize(request.op)
          return { connection: current.connection, delegate: delegate.value }
        }
        const authorized = <A, E, R>(program: A!E!R) => effect {
          const { connection } = try live
          return try program.pipe(asPerson(connection, repo.api, http, delegate, reads))
        }
        const permitted = (operation: GitHub.DelegationPolicy.Operation): Action.Keyed<GitHub.Delegation.Receipt, WikiFailure, never> => ({
          find: (name) => effect {
            const { connection, delegate } = try live
            return try delegate.keyed(connection.person, connection.delegation, operation).find(name).pipe(Effect.provideService(HttpClient.HttpClient, http), Effect.mapError(wikiFailureOf))
          },
          perform: (name) => effect {
            const { connection, delegate } = try live
            touched = true
            return try delegate.keyed(connection.person, connection.delegation, operation).perform(name).pipe(Effect.provideService(HttpClient.HttpClient, http), Effect.mapError(wikiFailureOf))
          },
        })
        if (request.op === "draft") {
          const draftRefusal = wikiDraftRefusal(request.text.trim() === "", Option.isSome(writer))
          if (draftRefusal !== "") throw new WikiFailure({ reason: draftRefusal })
          // The proved refusal answered "unavailable" for a missing writer.
          const drafter = Option.getOrThrow(writer)
          const file = try readSource(path)
          const drafted = try drafter.draft({ page: request.page, source: file.text, ask: request.text })
          if (storage !== undefined) try promise(() => storage.put(`wiki/draft/${actor.id}/${request.page}`, { page: drafted.page, text: drafted.text }))
          return { ...edits, draft: { page: drafted.page, text: drafted.text } }
        }
        if (actor.connection === undefined) {
          // Retain the person's reviewed text across the explicit credential connection; no GitHub write has begun.
          if (storage !== undefined) try promise(() => storage.put(`wiki/draft/${actor.id}/${request.page}`, { page: request.page, text: request.text }))
          throw new WikiFailure({ reason: "connect", ...(fresh() ? { unwritten: true } : {}) })
        }
        const current = try authorized(readSource(path))
        const refusal = wikiEditRefusal(request.base === current.text, request.text.trim() === "", request.text === current.text)
        if (refusal !== "") throw new WikiFailure({ reason: refusal })
        const contents = try Effect.try(() => Base64.encode(request.text))
        // WikiOperation is read, save, propose or draft (wikiSchemas.vibe); read and draft returned above, and every
        // caller's request is a decoded WikiRequest. A fifth operation fails to compile here.
        request.op satisfies "propose" | "save"
        // The person's fork owns the change, derived and verified by smithers.sh; the review is theirs. People merge; the agent never does.
        const base = try submissionBase(storage, try wikiExecutionId(actor.id, request.op, request.key), effect () => {
          const upstream = try authorized(Effect.flatMap(GitHub.GitHubClient.GitHubClient, (api) => api.request("GET", `/repos/${repository}`, undefined, { schema: Schema.Struct({ default_branch: Schema.String }) })))
          const branch = repo.branch ?? upstream.default_branch
          const head = try GitHub.Refs.getBranch(repo.owner, repo.name, branch)
          if (Option.isNone(head)) throw new WikiFailure({ reason: "missing" })
          // Validate the exact commit before persisting it or binding any write key.
          const pinned = try authorized(readSource(path, head.value.sha))
          if (pinnedConflict(pinned.text, request.base)) throw new WikiFailure({ reason: "conflict" })
          return { repository, branch, sha: head.value.sha }
        })
        const branch = try Action.once("branch", permitted({ kind: "branch.create", repository: base.repository, prefix: "vibelang/wiki-", label: request.page.replace(/[^a-z0-9]+/gi, "-").slice(0, 40), at: base.sha }), { key: try key("branch") })
        // The commit the branch was cut from, never the branch's current head: a retry adopts a branch its own commit
        // advanced, and smithers.sh refuses a key whose operation changed (key_conflict).
        try Action.once("commit", permitted({ kind: "commit.create", repository: base.repository, branch: branch.name!, expectedHeadOid: base.sha, headline: `Wiki: ${request.page}`, additions: [{ path, contents }], deletions: [] }), { key: try key("commit") })
        const pull = try Action.once("review", permitted({ kind: "pull.create", repository: base.repository, head: `${actor.login}:${branch.name!}`, base: base.branch, title: `Wiki: ${request.page}`, body: `A proposed edit to [${request.page}](https://vibelang.smithers.sh/wiki/${request.page}).` }), { key: try key("review") })
        // Native evidence before the answer: the PR exists, is the person's, and changes exactly this page.
        const observedReview = try authorized(GitHub.Proposals.documentReview(repo.owner, repo.name, pull.number!))
        const authored = actor.id !== "" && observedReview.pipe(Option.exists((review) => String(review.author) === actor.id))
        const changed = observedReview.pipe(Option.exists((review) => review.files.length === 1 && review.files[0]!.filename === path && review.files[0]!.status === "modified"))
        if (!authored || !changed) throw new WikiFailure({ reason: "unavailable", code: "unavailable" })
        const retained = try loadDraft(actor.id, request.page)
        if (storage !== undefined && draftProposed(retained !== undefined, retained?.text ?? "", request.text)) try promise(() => storage.delete(`wiki/draft/${actor.id}/${request.page}`))
        return { ...edits, review: `https://github.com/${repo.owner}/${repo.name}/pull/${pull.number!}` }
      }
      const run = (connection: Connection | undefined) => work.pipe(asPerson(connection, repo.api, http, delegate, reads), Effect.mapError((error) => {
        const failure = error._tag === "WikiFailure" ? error : wikiFailureOf(error)
        return wikiUnwritten(fresh(), touched, failure.reason) ? new WikiFailure({ ...failure, unwritten: true }) : failure
      }), Effect.tapError((failure) => connectFailure(failure.reason) && authority.lost !== undefined ? authority.lost() : Effect.void))
      // A delegation that ended must not hide the public wiki from its owner.
      if (readRetriesSignedOut(request.op, actor?.connection !== undefined) && actor?.connection !== undefined) {
        const first = try Effect.result(run(actor.connection))
        if (first._tag === "Success") return first.success
        if (!connectFailure(first.failure.reason)) throw first.failure
        return try run(undefined)
      }
      return try run(actor?.connection)
    },
  }
  return host
}

/** Runs the exact browser/agent flow with the object's persistent engine, then answers the HTTP request. */
export effect function serveWiki(hostId: string, storage: Storage, repo: WikiRepository = wikiRepository) {
  const request = try HttpServerRequest.HttpServerRequest
  const url = new URL(request.url, "https://wiki.invalid")
  if (!objectPath(url.pathname, "/api/wiki")) return HttpServerResponse.empty({ status: 404 })
  const authority = try WikiAuthority
  if (!objectMethod(request.method)) return HttpServerResponse.empty({ status: 405 })
  if (!withinBodyLimit(Number(request.headers["content-length"]), bodyLimit("wiki"))) return HttpServerResponse.jsonUnsafe({ reason: "invalid" }, { status: 413 })
  const body = request.method === "GET"
    ? { op: "read", page: url.searchParams.get("page") ?? "index", base: "", text: "", key: `read-${try effect { return try (try SecureRandom.SecureRandom).uuidV4() }.pipe(Effect.provide(SecureRandom.layerWebCrypto))}` }
    : (request.json.pipe(Effect.provideService(HttpServerRequest.MaxBodySize, ByteSize.bytes(bodyLimit("wiki"))), Effect.timeout("3 seconds")) catch () => undefined)
  const input = Schema.decodeUnknownOption(WikiRequest)(body)
  if (Option.isNone(input) || !requestKey(input.value.key)) return HttpServerResponse.jsonUnsafe({ reason: "invalid" }, { status: 400 })
  const result = try Effect.result(executeWiki(hostId, storage, input.value, repo))
  if (result._tag === "Failure") {
    const reason = result.failure._tag === "WikiFailure" ? result.failure.reason : "unavailable"
    const status = wikiRefusalStatus(reason)
    return HttpServerResponse.jsonUnsafe({ reason, ...(result.failure._tag === "WikiFailure" && result.failure.unwritten === true ? { unwritten: true } : {}) }, { status, headers: { "cache-control": "no-store" } })
  }
  const current = try authority.current()
  return HttpServerResponse.jsonUnsafe({ ...result.success, role: current?.role ?? "viewer" }, { headers: { "cache-control": "no-store" } })
}

/** The same durable execution for HTTP, CLI/MCP and a delegated chat tool. */
export effect function executeWiki(hostId: string, storage: Storage, input: WikiRequest, repo: WikiRepository = wikiRepository) {
  const payload = try Schema.decodeUnknownEffect(WikiRequest)(input).pipe(Effect.mapError(() => new WikiFailure({ reason: "invalid", unwritten: true })))
  if (!requestKey(payload.key)) throw new WikiFailure({ reason: "invalid" })
  const authority = try WikiAuthority
  const actor = try authority.current()
  if (authority.authorize !== undefined) try authority.authorize(payload.op)
  try authorizeWiki(actor?.role ?? "viewer", payload.op, actor?.kind ?? "person")
  const flow = wikiEditFlows.find((f) => f._tag === `vibelang/wiki/${payload.op}`)!
  let fresh = false
  const injected = try Effect.serviceOption(WikiHost)
  const host = Option.isSome(injected) ? injected.value : try githubWikiHost(repo, storage, () => fresh)
  const executionId = try wikiExecutionId(actor?.id || "public", payload.op, payload.key)
  if (payload.recovery !== undefined && !requestKey(payload.recovery)) throw new WikiFailure({ reason: "invalid" })
  const { recovery, ...original } = payload
  const runtime = (id: string) => Layer.merge(CloudflareRuntime.layer({ hostId, executionId: id, flow: flow._tag }, wikiEditRegistration), RunInspection.layerWith({ flows: wikiEditFlows })).pipe(Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(Layer.succeed(WikiHost, host)))
  // Only an explicit retry of a settled failure starts another execution. A lost success joins its receipt.
  const observed = try scoped(Effect.provide(effect {
    const polled = try Effect.result((try FlowRuntime.FlowRuntime).poll(flow, executionId))
    return { fresh: polled._tag === "Failure", failed: polled._tag === "Success" && Option.isSome(polled.success) && polled.success.value._tag === "Complete" && polled.success.value.exit._tag === "Failure" }
  }, runtime(executionId)))
  fresh = observed.fresh
  const failed = retriesSettledFailure(recovery !== undefined, observed.failed)
  const target = failed ? try wikiRecoveryId(executionId, recovery!) : executionId
  const result = try scoped(Effect.provide(effect {
    const engine = try FlowRuntime.FlowRuntime
    if (joinsReceipt(observed.fresh, failed)) {
      const inspection = try RunInspection.RunInspection
      const recorded = try inspection.payload(executionId)
      const decoded = Schema.decodeUnknownOption(WikiRequest)(recorded.payload)
      if (Option.isNone(decoded) || Object.entries(original).some(([name, value]) => decoded.value[name as keyof WikiRequest] !== value)) throw new WikiFailure({ reason: "invalid" })
    }
    if (failed) {
      const known = engine.poll(flow, target).pipe(Effect.as(true)) catch () => false
      if (!known) {
        // CloudflareRuntime's engine store always retries from a step (EngineStore's `retryFrom`).
        const retryFrom = engine.retryFrom!
        const inspection = try RunInspection.RunInspection
        const recorded = try inspection.payload(executionId)
        const decoded = Schema.decodeUnknownOption(WikiRequest)(recorded.payload)
        if (Option.isNone(decoded) || Object.entries(original).some(([name, value]) => decoded.value[name as keyof WikiRequest] !== value)) throw new WikiFailure({ reason: "invalid" })
        const source = try inspection.inspect(executionId)
        const step = source.steps.find((item) => item.action === `${flow._tag}/perform`)
        if (step === undefined) throw new WikiFailure({ reason: "unavailable" })
        try retryFrom(flow, { source: executionId, step: step.nodeId, executionId: target })
      }
    }
    return try engine.execute(flow, { executionId: target, payload: original })
  }, runtime(target))).pipe(
    Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: "unavailable" })),
    // The read flow's engine deadline (0015) settles it as a defect, journaled as an Error named by its tag; the person sees "unavailable" and Retry.
    Effect.catchDefect((defect) => RetryPolicy.errorTag(defect) === "@smthrs/flow/DeadlineExceeded"
      ? Effect.logWarning("vibelang.wiki.deadline").pipe(Effect.annotateLogs({ op: payload.op }), Effect.andThen(Metric.update(Metric.withAttributes(Metric.counter("vibelang_wiki_deadline", { incremental: true }), { op: payload.op }), 1)), Effect.andThen(Effect.fail(new WikiFailure({ reason: "unavailable", code: "unavailable" }))))
      : Effect.die(defect)),
  )
  return { ...result, role: actor?.role ?? "viewer" }
}

/** Unconfigured sign-in still leaves the repository's public wiki readable, through `reads` when given. */
export function publicWiki(hostId: string, storage: Storage, reads?: HttpClient.HttpClient) {
  const served = serveWiki(hostId, storage).pipe(Effect.provideService(WikiAuthority, { current: () => Effect.succeed(undefined) }))
  return (reads === undefined ? served : Effect.provideService(served, PublicReads, { client: reads })).pipe(Effect.provide(FetchHttpClient.layer))
}
