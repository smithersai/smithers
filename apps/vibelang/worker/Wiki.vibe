import { wikiSubmissionAllowed } from "../src/core/wikiDecision.vibe"
import { Digest, SecureRandom } from "effect/crypto"
import { Base64 } from "effect/encoding"
// The repository's Markdown is the wiki (GH-1, 0021): every edit is the person's own change, journaled once.
import { GitHub } from "@smthrs/integrations"
import { Action, FlowRuntime } from "@smthrs/flow"
import { CloudflareRuntime, ObjectDatabase, RunInspection } from "@smthrs/platform-cloudflare"
import { HttpClient, FetchHttpClient, HttpServerRequest, HttpServerResponse } from "effect/http"
import { applyWikiEdits, emptyWikiEdits, wikiPermission, type WikiEdits, type WikiOperation, type WikiPageState } from "../src/core/conversation.vibe"
import { WikiHost, wikiEditFlows, wikiEditRegistration, authorizeWiki, wikiExecutionId, wikiRecoveryId } from "../src/core/wikiFlows.vibe"
import { WikiFailure, WikiRequest, WikiState } from "../src/core/wikiSchemas.vibe"
import { pages } from "../src/core/wiki.vibe"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import type { Principal, Repository } from "./Issues.vibe"
/** The embedded wiki is versioned with this app, separately from VibeLang's issue tracker. */
export interface WikiRepository extends Repository { readonly root: string; readonly branch?: string }
export const wikiRepository: WikiRepository = { owner: "smithersai", name: "smithers", api: "https://api.github.com", agent: "", root: "apps/vibelang/wiki" }
import type { Storage } from "./Objects.vibe"

export service WikiAuthority {
  current(): (Principal | undefined)!WikiFailure
  readonly authorize?: (operation: WikiOperation) => void!WikiFailure
}

/** A page's repository path, or undefined for the generated decisions index and unknown pages. */
export function wikiFilePath(page: string, root = wikiRepository.root): string | undefined {
  if (page === "decisions") return undefined
  return pages.some((entry) => entry.id === page) ? `${root}/${page}.md` : undefined
}

/** No raw provider error, request content or credential crosses this boundary. */
export function wikiFailureOf(error: unknown): WikiFailure {
  const details = (error as { readonly details?: Readonly<Record<string, unknown>> })?.details
  const status = details?.status
  const reason = details?.outcomeUnknown === true ? "unknown" : details?.incomplete === true ? "partial" : details?.rateLimited === true ? "rate-limited" : status === 401 ? "sign-in" : status === 403 ? "forbidden" : status === 404 ? "missing" : "unavailable"
  return new WikiFailure({ reason, ...(["unknown", "rate-limited", "unavailable"].includes(reason) ? { code: reason } : {}), ...(typeof details?.retryAfterMillis === "number" ? { retryAfterMillis: details.retryAfterMillis } : {}) })
}

/** Stable across native recovery executions; a changed payload can never adopt another execution's write. */
export effect function wikiWriteKey(repo: Repository, actor: string, request: WikiRequest, name: string) {
  const logical = JSON.stringify(["vibelang/wiki/v1", repo.owner, repo.name, actor, request.op, request.key, name])
  return try (try Digest.Digest).digestHex(Digest.sha256, new TextEncoder().encode(logical))
}

const StoredDraft = Schema.Struct({ page: Schema.String, text: Schema.String })

/** The GitHub host: reads are public observations; writes are the authenticated person's own commits and review changes. */
export effect function githubWikiHost(repo: WikiRepository = wikiRepository, storage?: Storage, fresh: () => boolean = () => false): WikiHost.Shape!never!(WikiAuthority | HttpClient.HttpClient) {
  const authority = try WikiAuthority
  const http = try HttpClient.HttpClient
  const writer = try Effect.serviceOption(WikiWriter)
  let edits: WikiEdits = emptyWikiEdits
  let touched = false
  effect function loadDraft(person: string, page: string) {
    if (storage === undefined || person === "") return undefined
    const stored = try promise(() => storage.get(`wiki/draft/${person}/${page}`))
    return Schema.decodeUnknownOption(StoredDraft)(stored).pipe(Option.getOrUndefined)
  }
  effect function note(page: WikiPageState) {
    edits = applyWikiEdits(edits, { type: "WikiEditsObserved", seq: edits.seq + 1, pages: [...edits.pages.filter((entry) => entry.id !== page.id), page] })
    if (storage !== undefined) {
      try promise(() => storage.put("wiki/revision", edits.seq))
      try promise(() => storage.put(`wiki/page/${page.id}`, { id: page.id, source: page.source, revision: page.revision }))
    }
    return edits
  }
  effect function readSource(path: string, ref = repo.branch) {
    const file = try GitHub.Contents.getText(repo.owner, repo.name, path, { ref }).pipe(Effect.mapError(wikiFailureOf))
    if (Option.isNone(file)) throw new WikiFailure({ reason: "missing" })
    return file.value
  }
  const host: WikiHost.Shape = {
    perform: effect (request) => {
      const actor = try authority.current()
      if (authority.authorize !== undefined) try authority.authorize(request.op)
      if ((!wikiPermission(actor?.role ?? "viewer", request.op) || !wikiSubmissionAllowed(request.op, actor?.kind ?? "person"))) throw new WikiFailure({ reason: "forbidden" })
      const path = wikiFilePath(request.page, repo.root)
      if (path === undefined) throw new WikiFailure({ reason: "missing", ...(fresh() ? { unwritten: true } : {}) })
      const blank = Redacted.make("")
      const work = effect {
        if (request.op === "read") {
          const file = try readSource(path)
          const state = try note({ id: request.page, source: file.text, revision: file.sha })
          const draft = try loadDraft(actor?.id ?? "", request.page)
          return draft === undefined ? state : { ...state, draft }
        }
        if (actor === undefined || request.key === "") throw new WikiFailure({ reason: "sign-in" })
        const key = (name: string) => wikiWriteKey(repo, actor.id, request, name)
        const authorized = <A, E, R>(program: A!E!R, mutation = false) => effect {
          const current = try authority.current()
          if (current === undefined || current.id !== actor.id || !wikiPermission(current.role, request.op) || !wikiSubmissionAllowed(request.op, current.kind ?? "person")) throw new WikiFailure({ reason: "forbidden" })
          if (Redacted.value(current.token) === "") throw new WikiFailure({ reason: "connect" })
          if (authority.authorize !== undefined) try authority.authorize(request.op)
          if (mutation) touched = true
          return try program.pipe(GitHub.Calls.withToken(current.token, repo.api), Effect.provideService(HttpClient.HttpClient, http))
        }
        const permitted = <A, E, R>(operation: Action.Keyed<A, E, R>): Action.Keyed<A, E | WikiFailure, Exclude<R, GitHub.GitHubClient.GitHubClient>> => ({
          find: (key) => authorized(operation.find(key)), perform: (key) => authorized(operation.perform(key), true),
        })
        if (request.op === "draft") {
          if (request.text.trim() === "") throw new WikiFailure({ reason: "empty" })
          if (Option.isNone(writer)) throw new WikiFailure({ reason: "unavailable" })
          const file = try readSource(path)
          const drafted = try writer.value.draft({ page: request.page, source: file.text, ask: request.text })
          if (storage !== undefined) try promise(() => storage.put(`wiki/draft/${actor.id}/${request.page}`, { page: drafted.page, text: drafted.text }))
          return { ...edits, draft: { page: drafted.page, text: drafted.text } }
        }
        if (Redacted.value(actor.token) === "") {
          // Retain the person's reviewed text across the explicit credential connection; no GitHub write has begun.
          if (storage !== undefined) try promise(() => storage.put(`wiki/draft/${actor.id}/${request.page}`, { page: request.page, text: request.text }))
          throw new WikiFailure({ reason: "connect", ...(fresh() ? { unwritten: true } : {}) })
        }
        const current = try authorized(readSource(path))
        if (request.base !== current.text) throw new WikiFailure({ reason: "conflict" })
        if (request.text.trim() === "") throw new WikiFailure({ reason: "empty" })
        if (request.text === current.text) throw new WikiFailure({ reason: "empty" })
        const contents = try Effect.try(() => Base64.encode(request.text))
        if (request.op === "propose" || request.op === "save") {
          // The person's fork owns the change; the review is theirs. People merge; the agent never does.
          const personalRepo = try authorized(GitHub.Proposals.ensureFork(repo.owner, repo.name, actor.login))
          const base = repo.branch ?? personalRepo.sourceDefaultBranch
          const head = try GitHub.Refs.getBranch(repo.owner, repo.name, base)
          if (Option.isNone(head)) throw new WikiFailure({ reason: "missing" })
          // Compare against the exact commit the new branch will use, even if main advanced after the first read.
          const pinned = try authorized(readSource(path, head.value.sha))
          if (pinned.text !== request.base) throw new WikiFailure({ reason: "conflict" })
          const branch = try Action.once("branch", permitted(try Effect.try(() => GitHub.Once.branch(personalRepo.owner.login, personalRepo.name, { prefix: "vibelang/wiki-", label: request.page.replace(/[^a-z0-9]+/gi, "-").slice(0, 40), at: Effect.succeed(head.value.sha) }))), { key: try key("branch") })
          try Action.once("commit", permitted(try Effect.try(() => GitHub.Once.commitOnBranch(personalRepo.owner.login, personalRepo.name, { branch: branch.name, expectedHeadOid: branch.sha, headline: `Wiki: ${request.page}`, additions: [{ path, contents }], deletions: [] }))), { key: try key("commit") })
          const pull = try Action.once("review", permitted(try Effect.try(() => GitHub.Once.pull(repo.owner, repo.name, { head: `${actor.login}:${branch.name}`, base, title: `Wiki: ${request.page}`, body: `A proposed edit to [${request.page}](https://vibelang.smithers.sh/wiki/${request.page}).`, draft: false }))), { key: try key("review") })
          // Native evidence before the answer: the PR exists, is the person's, and changes exactly this page.
          const observedReview = try authorized(GitHub.Proposals.documentReview(repo.owner, repo.name, pull.number))
          const authored = actor.id !== "" && observedReview.pipe(Option.exists((review) => String(review.author) === actor.id))
          const changed = observedReview.pipe(Option.exists((review) => review.files.length === 1 && review.files[0]!.filename === path && review.files[0]!.status === "modified"))
          if (!authored || !changed) throw new WikiFailure({ reason: "unavailable", code: "unavailable" })
          const retained = try loadDraft(actor.id, request.page)
          if (storage !== undefined && retained?.text === request.text) try promise(() => storage.delete(`wiki/draft/${actor.id}/${request.page}`))
          return { ...edits, review: `https://github.com/${repo.owner}/${repo.name}/pull/${pull.number}` }
        }
        throw new WikiFailure({ reason: "invalid", unwritten: true })
      }
      return try work.pipe(GitHub.Calls.withToken(actor === undefined ? blank : actor.token, repo.api), Effect.provideService(HttpClient.HttpClient, http), Effect.mapError((error) => {
        const failure = error._tag === "WikiFailure" ? error : wikiFailureOf(error)
        return fresh() && !touched && ["conflict", "empty"].includes(failure.reason) ? new WikiFailure({ ...failure, unwritten: true }) : failure
      }))
    },
  }
  return host
}

/** Runs the exact browser/agent flow with the object's persistent engine, then answers the HTTP request. */
export effect function serveWiki(hostId: string, storage: Storage, repo: WikiRepository = wikiRepository) {
  const request = try HttpServerRequest.HttpServerRequest
  const url = new URL(request.url, "https://wiki.invalid")
  if (!url.pathname.startsWith("/api/wiki")) return HttpServerResponse.empty({ status: 404 })
  const authority = try WikiAuthority
  if (request.method !== "GET" && request.method !== "POST") return HttpServerResponse.empty({ status: 405 })
  if (Number(request.headers["content-length"]) > 4_194_304) return HttpServerResponse.jsonUnsafe({ reason: "invalid" }, { status: 413 })
  const body = request.method === "GET"
    ? { op: "read", page: url.searchParams.get("page") ?? "index", base: "", text: "", key: `read-${try effect { return try (try SecureRandom.SecureRandom).uuidV4() }.pipe(Effect.provide(SecureRandom.layerWebCrypto))}` }
    : (request.json.pipe(Effect.provideService(HttpServerRequest.MaxBodySize, ByteSize.bytes(4_194_304)), Effect.timeout("3 seconds")) catch () => undefined)
  const input = Schema.decodeUnknownOption(WikiRequest)(body)
  if (Option.isNone(input) || !/^[A-Za-z0-9-]{1,100}$/.test(input.value.key)) return HttpServerResponse.jsonUnsafe({ reason: "invalid" }, { status: 400 })
  const result = try Effect.result(executeWiki(hostId, storage, input.value, repo))
  if (result._tag === "Failure") {
    const reason = result.failure._tag === "WikiFailure" ? result.failure.reason : "unavailable"
    const status = reason === "forbidden" ? 403 : reason === "sign-in" || reason === "connect" ? 401 : reason === "missing" ? 404 : reason === "unknown" || reason === "conflict" ? 409 : ["empty", "invalid"].includes(reason) ? 400 : 503
    return HttpServerResponse.jsonUnsafe({ reason, ...(result.failure._tag === "WikiFailure" && result.failure.unwritten === true ? { unwritten: true } : {}) }, { status, headers: { "cache-control": "no-store" } })
  }
  const current = try authority.current()
  return HttpServerResponse.jsonUnsafe({ ...result.success, role: current?.role ?? "viewer" }, { headers: { "cache-control": "no-store" } })
}

/** The same durable execution for HTTP, CLI/MCP and a delegated chat tool. */
export effect function executeWiki(hostId: string, storage: Storage, input: WikiRequest, repo: WikiRepository = wikiRepository) {
  const payload = try Schema.decodeUnknownEffect(WikiRequest)(input).pipe(Effect.mapError(() => new WikiFailure({ reason: "invalid", unwritten: true })))
  if (!/^[A-Za-z0-9-]{1,100}$/.test(payload.key)) throw new WikiFailure({ reason: "invalid" })
  const authority = try WikiAuthority
  const actor = try authority.current()
  if (authority.authorize !== undefined) try authority.authorize(payload.op)
  try authorizeWiki(actor?.role ?? "viewer", payload.op, actor?.kind ?? "person")
  const flow = wikiEditFlows.find((f) => f._tag === `vibelang/wiki/${payload.op}`)!
  let fresh = false
  const injected = try Effect.serviceOption(WikiHost)
  const host = Option.isSome(injected) ? injected.value : try githubWikiHost(repo, storage, () => fresh)
  const executionId = try wikiExecutionId(actor?.id || "public", payload.op, payload.key)
  if (payload.recovery !== undefined && !/^[A-Za-z0-9-]{1,100}$/.test(payload.recovery)) throw new WikiFailure({ reason: "invalid" })
  const { recovery, ...original } = payload
  const runtime = (id: string) => Layer.merge(CloudflareRuntime.layer({ hostId, executionId: id, flow: flow._tag }, wikiEditRegistration), RunInspection.layerWith({ flows: wikiEditFlows })).pipe(Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(Layer.succeed(WikiHost, host)))
  // Only an explicit retry of a settled failure starts another execution. A lost success joins its receipt.
  const observed = try scoped(Effect.provide(effect {
    const polled = try Effect.result((try FlowRuntime.FlowRuntime).poll(flow, executionId))
    return { fresh: polled._tag === "Failure", failed: polled._tag === "Success" && Option.isSome(polled.success) && polled.success.value._tag === "Complete" && polled.success.value.exit._tag === "Failure" }
  }, runtime(executionId)))
  fresh = observed.fresh
  const failed = recovery !== undefined && observed.failed
  const target = failed ? try wikiRecoveryId(executionId, recovery!) : executionId
  const result = try scoped(Effect.provide(effect {
    const engine = try FlowRuntime.FlowRuntime
    if (!observed.fresh && !failed) {
      const inspection = try RunInspection.RunInspection
      const recorded = try inspection.payload(executionId).pipe(Effect.mapError(() => new WikiFailure({ reason: "unavailable" })))
      const decoded = Schema.decodeUnknownOption(WikiRequest)(recorded.payload)
      if (Option.isNone(decoded) || Object.entries(original).some(([name, value]) => decoded.value[name as keyof WikiRequest] !== value)) throw new WikiFailure({ reason: "invalid" })
    }
    if (failed) {
      const known = engine.poll(flow, target).pipe(Effect.as(true)) catch () => false
      if (!known) {
        if (engine.retryFrom === undefined) throw new WikiFailure({ reason: "unavailable" })
        const inspection = try RunInspection.RunInspection
        const recorded = try inspection.payload(executionId).pipe(Effect.mapError(() => new WikiFailure({ reason: "unavailable" })))
        const decoded = Schema.decodeUnknownOption(WikiRequest)(recorded.payload)
        if (Option.isNone(decoded) || Object.entries(original).some(([name, value]) => decoded.value[name as keyof WikiRequest] !== value)) throw new WikiFailure({ reason: "invalid" })
        const source = try inspection.inspect(executionId).pipe(Effect.mapError(() => new WikiFailure({ reason: "unavailable" })))
        const step = source.steps.find((item) => item.action === `${flow._tag}/perform`)
        if (step === undefined) throw new WikiFailure({ reason: "unavailable" })
        try engine.retryFrom(flow, { source: executionId, step: step.nodeId, executionId: target }).pipe(Effect.mapError(() => new WikiFailure({ reason: "unavailable" })))
      }
    }
    return try engine.execute(flow, { executionId: target, payload: original })
  }, runtime(target))).pipe(Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: "unavailable" })))
  return { ...result, role: actor?.role ?? "viewer" }
}

/** Unconfigured sign-in still leaves the repository's public wiki readable. */
export function publicWiki(hostId: string, storage: Storage) {
  return serveWiki(hostId, storage).pipe(Effect.provideService(WikiAuthority, { current: () => Effect.succeed(undefined) }), Effect.provide(FetchHttpClient.layer))
}
