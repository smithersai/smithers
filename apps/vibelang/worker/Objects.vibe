import * as ReplyAccounting from "./ReplyAccounting.vibe"
import { initialDispatch, probeDispatch, finishDispatch } from "./liveDispatchDecision.vibe"
// What each Durable Object runs, whoever hosts it: the Alchemy objects the API Worker deploys (Api.vibe) and the plain
// ones the workerd test runs (test/workerd/worker.vibe). Both hosts hand it the object's own storage and the budget's
// caller, so they run the same code.
//
//   Conversation (one per conversation)   the sequencer; each post's flow, and each start or end of a tour, run in
//                                         the request that asks; and the reply flow of the post it answers now, or
//                                         its tour's flow: its intent and alarm (`ExecutionObject`). Every journal
//                                         lives in the object's SQLite.
//   Budget (one per UTC day)              the day's token ledger
//
// A conversation answers one post at a time, so one execution per object is enough, and the flow's steps reach the
// sequencer in the same object. When a reply settles its execution is forgotten at the next alarm, which then starts
// the next unanswered post's.
import { WebCrypto } from "@smthrs/crypto"
import { FlowRuntime, type Flow } from "@smthrs/flow"
import { CloudflareRuntime, ExecutionObject, ObjectDatabase } from "@smthrs/platform-cloudflare"
import { SecureRandom } from "effect/crypto"
import { PostBody } from "../src/core/wire.vibe"
import { PauseTour, ResumeTour, SeekTour, OpenWiki, wikiRegistration, EndTour, Post, postRegistration, Posts, Reply, StartTour, Tour, tourRegistration, Tours } from "../src/core/flows.vibe"
import * as Budget from "./Budget.vibe"
import { ledgerOver, logOver, type KeyValue } from "./ObjectStorage.vibe"
import type { HistoryReader } from "../src/history/tools.vibe"
import { HistoryTools } from "./HistoryTools.vibe"
import { ChatModel, registration, Replies, Spend } from "./Reply.vibe"
import * as Sequencer from "./Sequencer.vibe"
import { unanswered } from "../src/core/flows.vibe"
import type { Refusal } from "../src/core/decide.vibe"
import { tourWalkthrough } from "../src/core/conversation.vibe"
import { tourAgentRegistration } from "./Tour.vibe"

/** A conversation object's storage: key-value for the log and the execution's intent, SQLite for the engine. */
export type Storage = KeyValue & ObjectDatabase.Storage

/** The reply flow's execution for `post`. Its object is the conversation's, so the post alone names it. */
export function executionIdOf(post: string): string {
  return `reply/${post}`
}

/** The tour's flow execution for tour `tour`. */
export function tourExecutionIdOf(tour: string): string {
  return `tour/${tour}`
}

const dispatchedKey = (post: string) => `dispatched/${post}`

/** `ExecutionObject.Storage` over the object's own key-value storage and alarm. */
export function executionStorage(storage: KeyValue): ExecutionObject.Storage {
  return {
    get: <A>(key: string) => promise(() => storage.get(key) as Promise<A | undefined>),
    put: (key, value) => promise(() => storage.put(key, value)),
    delete: (key) => promise(() => storage.delete(key)),
    setAlarm: (scheduledTime) => promise(() => storage.setAlarm(scheduledTime)),
    deleteAlarm: () => promise(() => storage.deleteAlarm()),
  }
}

/**
 * Starts the reply flow of the first unanswered post this object never started one for. While another execution
 * is held (running, or settled and not yet forgotten) the start is refused and waits for the next dispatch; a post
 * whose flow settled without answering it is not started again, so it can't loop.
 */
function dispatcher(storage: KeyValue): Sequencer.Dispatch {
  const executions = executionStorage(storage)
  return {
    tour: effect (tour: string) => {
      const executionId = tourExecutionIdOf(tour)
      if ((try promise(() => storage.get(dispatchedKey(executionId)))) !== undefined) return
      const intent = try Effect.orDie(ExecutionObject.intent(Tour, { executionId, payload: { tour } }))
      const started = try Effect.match(ExecutionObject.start(executions, intent, Effect.void), {
        onFailure: () => false,
        onSuccess: () => true,
      })
      try Effect.logInfo("vibelang.dispatch").pipe(Effect.annotateLogs({ outcome: started ? "started" : "waiting", tour }))
      if (started) try promise(() => storage.put(dispatchedKey(executionId), true))
    },
    start: effect (posts: ReadonlyArray<string>) => {
      let scan = initialDispatch()
      while (scan.phase === "scan") {
        const current = posts[scan.index]
        const marked = current === undefined ? false : (try promise(() => storage.get(dispatchedKey(current)))) !== undefined
        scan = probeDispatch(scan, posts, marked)
        if (scan.phase !== "attempt") continue
        const post = scan.post
        const intent = try Effect.orDie(ExecutionObject.intent(Reply, { executionId: executionIdOf(post), payload: { post } }))
        const started = try Effect.match(ExecutionObject.start(executions, intent, Effect.void), {
          onFailure: () => false,
          onSuccess: () => true,
        })
        scan = finishDispatch(scan, started)
        try Effect.logInfo("vibelang.dispatch").pipe(Effect.annotateLogs({ outcome: scan.started ? "started" : "waiting", post }))
        if (scan.started) try promise(() => storage.put(dispatchedKey(post), true))
      }
    },
  }
}

/** The conversation's sequencer over its object's storage. */
export function conversation(storage: KeyValue) {
  return Sequencer.make(logOver(storage), dispatcher(storage))
}

/** The day's budget over its object's storage. */
export function budget(storage: KeyValue, limit: number) {
  return Budget.make(ledgerOver(storage), limit)
}

/** The sequencer as a post flow's steps reach it: record the post, then dispatch its reply. */
export function postsOf(sequencer: Sequencer.Sequencer): Posts.Shape {
  return { record: sequencer.post, dispatch: sequencer.ensureDispatched }
}

/** The sequencer as a tour's steps reach it: record, dispatch, end, open, say, settle and wait for the end. */
export function toursOf(sequencer: Sequencer.Sequencer, wake: () => void!!): Tours.Shape {
  return {
    current: () => Effect.map(sequencer.snapshot(), tourWalkthrough),
    drive: sequencer.drive,
    control: sequencer.controlTour,
    start: sequencer.startTour,
    dispatch: sequencer.ensureDispatched,
    end: sequencer.endTour,
    wake,
    running: sequencer.running,
    open: sequencer.open,
    say: sequencer.say,
    finish: (tour) => sequencer.finishTour(tour, ""),
    ended: sequencer.ended,
  }
}

/** A post or tour flow's execution: one per request, so a repeated client id meets the sequencer's `duplicate` as before. */
export effect function postExecutionId(prefix = "post") {
  provide WebCrypto.layer {
    return `${prefix}/${try (try SecureRandom.SecureRandom).uuidV4()}`
  }
}

/**
 * Settled engine runs in an object's own SQLite are forgotten a day after they finish (review 2026-11-08 P1,
 * `CloudflareRuntime.Options.retention`): a day outlasts any retried execution id, since a re-executed tool call
 * resumes within minutes, and a meter, read, post or tour execution names a fresh random id a caller never re-asks.
 */
export const EXECUTION_RETENTION: CloudflareRuntime.Retention = { olderThanMs: 86_400_000 }

/** The object's tour waker, for every composition that provides Tours: a flow that wakes the tour wakes this object's. */
function tourWaker(hostId: string, storage: Storage) {
  return () => Effect.orDie(wakeTour(hostId, storage))
}

/** Resume a parked reading hold after Escape, then let the object's normal alarm settle the tour. */
effect function wakeTour(hostId: string, storage: Storage) {
  // Wake the execution the object holds, even if another tour was accepted after the ended event.
  const raw = try promise(() => storage.get<string>(ExecutionObject.intentKey))
  if (raw === undefined) return
  const intent = try Schema.decodeUnknownEffect(Schema.fromJsonString(ExecutionObject.Intent))(raw)
  if (intent.flow !== Tour._tag) return
  const executionId = intent.executionId
  const runtime = CloudflareRuntime.layer({ hostId, executionId, flow: Tour._tag, retention: EXECUTION_RETENTION }, Layer.empty).pipe(Layer.provide(ObjectDatabase.layer(storage)))
  provide runtime {
    const engine = try FlowRuntime.FlowRuntime
    const state = engine.poll(Tour, executionId) catch () => undefined
    // Running includes the interval after the body's interrupt but before its Suspended receipt. Persist the wake
    // there too, so the parking alarm cannot overwrite Escape's wake with the future reading deadline.
    if (state !== undefined && (Option.isNone(state) || state.value._tag === "Suspended")) try engine.resume(Tour, executionId)
  }
  try ExecutionObject.wake(executionStorage(storage))
}

/**
 * Runs a person's Learn more as a `vibelang/StartTour` execution in the request, as a post is (0011): it answers once
 * the tour is recorded and its flow dispatched. `null` once recorded, else the sequencer's refusal.
 */
export effect function tour(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer) {
  // A post's reply that was dispatched but has not started holds this object's one execution, and its start would
  // wait on a tour accepted now while the tour waits on it. Learn more is busy until that question is answered.
  const held = try promise(() => storage.get(ExecutionObject.intentKey))
  if (held !== undefined && unanswered(try sequencer.snapshot()).length > 0) {
    try Effect.logInfo("vibelang.tour.start").pipe(Effect.annotateLogs({ outcome: "busy", reason: "reply-waiting" }))
    const busy: Refusal = "busy"
    return busy
  }
  return try asked(hostId, storage, sequencer, StartTour, "start-tour")
}

/** Runs a person's Escape as a `vibelang/EndTour` execution in the request: `null` once ended, else the refusal. */
export effect function endTour(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer) {
  return try asked(hostId, storage, sequencer, EndTour, "end-tour")
}

export effect function controlTour(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, action: "pause" | "resume" | "seek", step: number) {
  const executionId = try postExecutionId("control-tour")
  const flow = action === "pause" ? PauseTour : action === "resume" ? ResumeTour : SeekTour
  const runtime = CloudflareRuntime.layer({ hostId, executionId, flow: flow._tag, retention: EXECUTION_RETENTION }, tourRegistration).pipe(
    Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(Layer.succeed(Tours, toursOf(sequencer, tourWaker(hostId, storage)))),
  )
  return try Effect.orDie(Effect.provide(effect { const engine = try FlowRuntime.FlowRuntime; return try (action === "pause" ? engine.execute(PauseTour, { executionId, payload: {} }) : action === "resume" ? engine.execute(ResumeTour, { executionId, payload: {} }) : engine.execute(SeekTour, { executionId, payload: { step } })) }, runtime))
}

effect function asked(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, flow: typeof StartTour | typeof EndTour, prefix: string) {
  const executionId = try postExecutionId(prefix)
  const runtime = CloudflareRuntime.layer({ hostId, executionId, flow: flow._tag, retention: EXECUTION_RETENTION }, tourRegistration).pipe(
    Layer.provide(ObjectDatabase.layer(storage)),
    Layer.provide(Layer.succeed(Tours, toursOf(sequencer, tourWaker(hostId, storage)))),
  )
  return try Effect.orDie(effect {
    provide runtime {
      const engine = try FlowRuntime.FlowRuntime
      return try engine.execute(flow, { executionId, payload: {} })
    }
  })
}

/**
 * Runs a person's post as a `vibelang/Post` execution on the engine in the object's SQLite, in the request that
 * posts it (0011): it answers once the post is recorded and its reply dispatched, never after the model. `null` once
 * recorded, else the sequencer's refusal.
 */
export effect function post(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, clientId: string, name: string, text: string, owner?: string) {
  // HTTP decodes PostBody first; malformed direct host calls leave storage untouched.
  if (!Schema.is(PostBody)({ clientId, name, text })) return "invalid"
  const executionId = try postExecutionId()
  const runtime = CloudflareRuntime.layer({ hostId, executionId, flow: Post._tag, retention: EXECUTION_RETENTION }, postRegistration).pipe(
    Layer.provide(ObjectDatabase.layer(storage)),
    Layer.provide(Layer.succeed(Posts, postsOf(sequencer))),
  )
  // The engine's store failing to open is a defect, as the log failing to write is: the post was not answered.
  return try Effect.orDie(execute(runtime, executionId, { clientId, name, text, ...(owner === undefined ? {} : { owner }) }))
}

effect function execute<E>(
  runtime: Layer.Layer<FlowRuntime.FlowRuntime, E>,
  executionId: string,
  payload: { readonly clientId: string; readonly name: string; readonly text: string; readonly owner?: string },
) {
  provide runtime {
    const engine = try FlowRuntime.FlowRuntime
    return try engine.execute(Post, { executionId, payload })
  }
}

/** The sequencer as the reply flow's steps reach it. */
export function repliesOf(sequencer: Sequencer.Sequencer): Replies.Shape {
  return {
    start: sequencer.start,
    history: sequencer.history,
    append: sequencer.append,
    restart: sequencer.restart,
    finish: sequencer.finish,
    fail: sequencer.fail,
  }
}

/** A reply or tour execution starts no child flow and hands off to no round, so routing anything is a defect. */
export const unrouted: ExecutionObject.Router = {
  start: (intent) => die(new Error(`vibelang/Reply routed a start of ${intent.executionId}`)),
  wake: (executionId) => die(new Error(`vibelang/Reply routed a wake of ${executionId}`)),
}

/** A settled reply's execution is forgotten at its next alarm, so the next post's can start. */
export const SETTLED_RETENTION_MS = 0

/**
 * One alarm of a conversation's object: drives its reply execution in the engine over the object's SQLite, then
 * dispatches the next post. `hostId` is the object's id, the same for every incarnation.
 */
export effect function alarm(
  hostId: string,
  storage: Storage,
  sequencer: Sequencer.Sequencer,
  spend: Spend.Shape,
  model: ChatModel.Shape,
  history: HistoryReader,
) {
  const outcome = try ReplyAccounting.alarm(hostId, storage, spend, ExecutionObject.alarm(executionStorage(storage), {
    flows: [Reply, Tour],
    runtime: (intent) => executionLayer(hostId, storage, sequencer, intent, { spend, model, history }),
    router: unrouted,
    settledRetentionMs: SETTLED_RETENTION_MS,
  }), unrouted)
  try sequencer.ensureDispatched()
  return outcome
}

interface ExecutionServices { readonly spend: Spend.Shape; readonly model: ChatModel.Shape; readonly history: HistoryReader }
export service ActiveExecution { readonly services: ExecutionServices }
function executionLayer(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, intent: ExecutionObject.Intent, active: ExecutionServices) {
  const services = Layer.mergeAll(
    Layer.succeed(HistoryTools, { history: active.history }),
    Layer.succeed(Replies, repliesOf(sequencer)),
    Layer.succeed(Tours, toursOf(sequencer, tourWaker(hostId, storage))),
    Layer.succeed(Spend, ReplyAccounting.tracked(storage, intent.executionId, active.spend)), Layer.succeed(ChatModel, active.model),
  )
  return CloudflareRuntime.layer({ hostId, executionId: intent.executionId, flow: intent.flow, retention: EXECUTION_RETENTION }, Layer.mergeAll(registration, tourAgentRegistration)).pipe(
    Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(services),
  )
}

/** One SDK host per action-object incarnation: cancellation interrupts the active drive and survives reload. */
export function executionHost(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, admit?: () => boolean!!) {
  const host = ExecutionObject.make(executionStorage(storage), {
    flows: [Reply, Tour], router: unrouted, settledRetentionMs: SETTLED_RETENTION_MS,
    runtime: (intent) => Layer.unwrap(effect { return executionLayer(hostId, storage, sequencer, intent, (try ActiveExecution).services) }),
    canStart: admit,
  })
  return {
    ...host,
    alarm: effect () => {
      const outcome = try ReplyAccounting.alarm(hostId, storage, (try ActiveExecution).services.spend, host.alarm(), unrouted)
      try sequencer.ensureDispatched()
      return outcome
    },
  }
}

/** A cancelled intent may have been refused before the SDK admitted any execution row. */
export effect function existingReceipt<A, E, R>(storage: Storage, poll: Option.Option<Flow.Result<A, E>>!FlowRuntime.FlowExecutionNotFound!R) {
  return try withSpan(effect {
    return poll catch effect (error) => {
      const cancelled = try promise(() => storage.get<number>(ExecutionObject.cancelledKey))
      if (cancelled === undefined) throw error
      try Metric.update(Metric.withAttributes(Metric.counter("vibelang_action_receipts", { incremental: true }), { outcome: "unadmitted-cancelled" }), 1)
      try Effect.logInfo("vibelang.action.receipt").pipe(Effect.annotateLogs({ outcome: "unadmitted-cancelled" }))
      return Option.none()
    }
  }, "vibelang.action.receipt")
}

/** Read the existing SDK journal result; alarm settlement also includes failed and cancelled executions. */
export effect function executionResult(hostId: string, storage: Storage, intent: ExecutionObject.Intent) {
  const runtime = CloudflareRuntime.layer({ hostId, executionId: intent.executionId, flow: intent.flow }, Layer.empty).pipe(Layer.provide(ObjectDatabase.layer(storage)))
  return try Effect.orDie(Effect.provide(effect {
    const engine = try FlowRuntime.FlowRuntime
    if (intent.flow === Reply._tag) return try existingReceipt(storage, engine.poll(Reply, intent.executionId))
    return try existingReceipt(storage, engine.poll(Tour, intent.executionId))
  }, runtime))
}


/** The same wiki flow as the mock and agent tools, journaled in the conversation object's store. */
export effect function openWiki(hostId: string, storage: Storage, sequencer: Sequencer.Sequencer, page: string) {
  const executionId = try postExecutionId("wiki")
  const runtime = CloudflareRuntime.layer({ hostId, executionId, flow: OpenWiki._tag }, wikiRegistration).pipe(
    Layer.provide(ObjectDatabase.layer(storage)), Layer.provide(Layer.succeed(Tours, toursOf(sequencer, tourWaker(hostId, storage)))),
  )
  const opened = try Effect.orDie(effect {
    provide runtime {
      return try (try FlowRuntime.FlowRuntime).execute(OpenWiki, { executionId, payload: { page } })
    }
  })
  return opened ? null : "empty"
}
