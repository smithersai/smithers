import { callBudget } from "./CallBudget.vibe"
// The agent drafts one wiki edit through its journaled AgentAction, using the existing model host and budget.
import { AgentAction, EventSink, Budget } from "@smthrs/agent"
import { Action, FlowRuntime } from "@smthrs/flow"
import { Digest, SecureRandom } from "effect/crypto"
import { ModelRequest } from "@smthrs/model"
import { WikiDraft, WikiWriter } from "../src/core/WikiWriter.vibe"
import { WikiFailure } from "../src/core/wikiSchemas.vibe"
import { AGENT_CONTEXT } from "./agentContext.vibe"
import { agentOf, ChatModel, dayOf, Spend, draftSpend, draftSpendFailed, ceilingOf, daySpent } from "./Reply.vibe"
/** Frame and answer limits; initial admission holds one call, then each physical invocation reserves separately. */
const WIKI_FRAMES = 8
const WIKI_ANSWER_TOKENS = 8192
export const WIKI_CEILING = ceilingOf(1, WIKI_ANSWER_TOKENS)

export const DraftWiki = AgentAction.make("vibelang/wiki/draft-agent", {
  payload: { page: Schema.String, source: Schema.String, ask: Schema.String },
  output: WikiDraft, seat: "agent", profile: "conversation", maxFrames: WIKI_FRAMES,
  system: [AGENT_CONTEXT, "Draft one edit to the given project wiki page. Return the complete edited Markdown page with ctx.done({page, text}): the source given, changed exactly where the person's ask needs, nothing else rewritten. Keep the page's structure and voice. Never submit, approve or merge anything."],
  prompt: (request) => JSON.stringify(request), modelParams: ModelRequest.GenerationParams.make({ maxTokens: WIKI_ANSWER_TOKENS }),
})
export service WikiDraftAgent {
  readonly available: boolean
  run(request: { readonly page: string; readonly source: string; readonly ask: string }, meter: Budget.Service): WikiDraft!WikiFailure!(FlowRuntime.FlowRuntime | FlowRuntime.FlowInstance | Digest.Digest | SecureRandom.SecureRandom)
}
export const wikiAgentLayer = Layer.effect(WikiDraftAgent, effect {
  const chat = try ChatModel
  return {
    available: chat.model !== undefined,
    run: effect (request, meter) => {
      const model = chat.model
      if (model === undefined) throw new WikiFailure({ reason: "no-model" })
      const sink: EventSink.Service = { emit: (event) => Metric.update(Metric.withAttributes(Metric.counter("vibelang_wiki_agent_events", { incremental: true }), { event: event._tag }), 1) }
      const result = try Effect.result(effect {
        provide agentOf(DraftWiki.layer, model, sink, [], 0, meter), EventSink.EventSink = sink {
          return try (try DraftWiki.requirement).action({ page: request.page, source: request.source, ask: request.ask })
        }
      })
      // A model call refused because the day is spent is the budget's failure, not the draft's.
      if (result._tag === "Failure") throw new WikiFailure({ reason: daySpent(result.failure) ? "budget" : "draft" })
      // The agent already refused an output that is not a WikiDraft; this decode only types it.
      const decoded = try Effect.orDie(Schema.decodeUnknownEffect(WikiDraft)(result.success))
      if (decoded.page !== request.page || decoded.text.trim() === "") throw new WikiFailure({ reason: "draft" })
      return decoded
    },
  }
})
/** Public service seam: faults replace the agent, while metering and the real durable engine remain unchanged. */
export const wikiWriter = Layer.effect(WikiWriter, effect {
  const agent = try WikiDraftAgent
  const spend = try Spend
  return {
    draft: effect (request) => {
      if (!agent.available) throw new WikiFailure({ reason: "no-model" })
      const instance = try FlowRuntime.FlowInstance
      const admission = try Action.make({ name: "vibelang/wiki/admit", success: Schema.Struct({ day: Schema.String, admitted: Schema.Boolean }), error: WikiFailure, execute: effect {
        const day = dayOf(try Clock.currentTimeMillis)
        return { day, admitted: try spend.admit(day, `wiki-draft/${instance.executionId}`, WIKI_CEILING).pipe(Effect.mapError(() => new WikiFailure({ reason: "budget" }))) }
      } })
      if (!admission.admitted) throw new WikiFailure({ reason: "budget" })
      // An empty policy is valid, so making the meter cannot fail.
      const meter = callBudget(try Effect.orDie(Budget.make({})), spend, `wiki-draft/${instance.executionId}`, admission.day, WIKI_CEILING)
      const result = try Effect.result(agent.run(request, meter))
      const usage = meter.usageOf(instance.executionId) catch effect () => {
        try Effect.logWarning("vibelang.budget.usage").pipe(Effect.annotateLogs({ outcome: "unavailable" }))
        return { tokens: 0, calls: 0, unreported: 1 }
      }
      try Effect.tapError(effect { try Action.make({ name: "vibelang/wiki/draft-spend", error: WikiFailure, retryPolicy: draftSpend, execute: spend.spend(admission.day, `wiki-draft/${instance.executionId}`, usage.tokens, usage.calls > 0 && usage.unreported === undefined, WIKI_CEILING).pipe(Effect.mapError(() => new WikiFailure({ reason: "budget" }))) }) }, () => draftSpendFailed("wiki"))
      if (result._tag === "Failure") {
        // The run failed because the ledger could not record a model call (its answer is sealed, so a retry pays
        // the ledger, not the provider): the budget's failure, logged and counted like a failed settlement.
        if (meter.ledgerUnavailable()) {
          try draftSpendFailed("wiki")
          throw new WikiFailure({ reason: "budget" })
        }
        throw result.failure
      }
      return result.success
    },
  }
})
export const wikiWriterLayer = wikiWriter.pipe(Layer.provide(wikiAgentLayer))
