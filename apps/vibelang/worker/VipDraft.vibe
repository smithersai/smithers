import { callBudget } from "./CallBudget.vibe"
// The agent drafts one feature through its journaled AgentAction, using the existing model host and budget.
import { AgentAction, EventSink, Budget } from "@smthrs/agent"
import { Action, FlowRuntime } from "@smthrs/flow"
import { Digest, SecureRandom } from "effect/crypto"
import { ModelRequest } from "@smthrs/model"
import { VipDraft, VipWriter } from "../src/core/VipWriter.vibe"
import { IssueFailure, type IssueRequest } from "../src/core/issueSchemas.vibe"
import { AGENT_CONTEXT } from "./agentContext.vibe"
import { agentOf, ChatModel, dayOf, Spend, draftSpend, draftSpendFailed, ceilingOf, daySpent } from "./Reply.vibe"
/** Frame and answer limits; initial admission holds one call, then each physical invocation reserves separately. */
const VIP_FRAMES = 8
const VIP_ANSWER_TOKENS = 2048
export const VIP_CEILING = ceilingOf(1, VIP_ANSWER_TOKENS)

export const DraftVip = AgentAction.make("vibelang/vip/draft-agent", {
  payload: { title: Schema.String, text: Schema.String, example: Schema.String, prior: Schema.String },
  output: VipDraft, seat: "agent", profile: "conversation", maxFrames: VIP_FRAMES,
  system: [AGENT_CONTEXT, "Draft one VibeLang language feature, with a concrete example and relevant prior art. Return the draft with ctx.done({title, summary, example, prior}). Keep the person's feature and flag uncertainty in the draft. Never submit, approve or merge anything."],
  prompt: (request) => JSON.stringify(request), modelParams: ModelRequest.GenerationParams.make({ maxTokens: VIP_ANSWER_TOKENS }),
})
export service DraftAgent {
  readonly available: boolean
  run(request: IssueRequest, meter: Budget.Service): VipDraft!IssueFailure!(FlowRuntime.FlowRuntime | FlowRuntime.FlowInstance | Digest.Digest | SecureRandom.SecureRandom)
}
export const agentLayer = Layer.effect(DraftAgent, effect {
  const chat = try ChatModel
  return {
    available: chat.model !== undefined,
    run: effect (request, meter) => {
      const model = chat.model
      if (model === undefined) throw new IssueFailure({ reason: "no-model" })
      const sink: EventSink.Service = { emit: (event) => Metric.update(Metric.withAttributes(Metric.counter("vibelang_vip_agent_events", { incremental: true }), { event: event._tag }), 1) }
      const result = try Effect.result(effect {
        provide agentOf(DraftVip.layer, model, sink, [], 0, meter), EventSink.EventSink = sink {
          return try (try DraftVip.requirement).action({ title: request.title, text: request.text, example: request.example, prior: request.prior })
        }
      })
      // A model call refused because the day is spent is the budget's failure, not the draft's.
      if (result._tag === "Failure") throw new IssueFailure({ reason: daySpent(result.failure) ? "budget" : "draft" })
      // The agent already refused an output that is not a VipDraft; this decode only types it.
      return try Effect.orDie(Schema.decodeUnknownEffect(VipDraft)(result.success))
    },
  }
})
/** Public service seam: faults replace the agent, while metering and the real durable engine remain unchanged. */
export const writer = Layer.effect(VipWriter, effect {
  const agent = try DraftAgent
  const spend = try Spend
  return {
    draft: effect (request) => {
      if (!agent.available) throw new IssueFailure({ reason: "no-model" })
      const instance = try FlowRuntime.FlowInstance
      const admission = try Action.make({ name: "vibelang/vip/admit", success: Schema.Struct({ day: Schema.String, admitted: Schema.Boolean }), error: IssueFailure, execute: effect {
        const day = dayOf(try Clock.currentTimeMillis)
        return { day, admitted: try spend.admit(day, `vip-draft/${instance.executionId}`, VIP_CEILING).pipe(Effect.mapError(() => new IssueFailure({ reason: "budget" }))) }
      } })
      if (!admission.admitted) throw new IssueFailure({ reason: "budget" })
      // An empty policy is valid, so making the meter cannot fail.
      const meter = callBudget(try Effect.orDie(Budget.make({})), spend, `vip-draft/${instance.executionId}`, admission.day, VIP_CEILING)
      const result = try Effect.result(agent.run(request, meter))
      const usage = meter.usageOf(instance.executionId) catch effect () => {
        try Effect.logWarning("vibelang.budget.usage").pipe(Effect.annotateLogs({ outcome: "unavailable" }))
        return { tokens: 0, calls: 0, unreported: 1 }
      }
      try Effect.tapError(effect { try Action.make({ name: "vibelang/vip/spend", error: IssueFailure, retryPolicy: draftSpend, execute: spend.spend(admission.day, `vip-draft/${instance.executionId}`, usage.tokens, usage.calls > 0 && usage.unreported === undefined, VIP_CEILING).pipe(Effect.mapError(() => new IssueFailure({ reason: "budget" }))) }) }, () => draftSpendFailed("vip"))
      if (result._tag === "Failure") {
        // The run failed because the ledger could not record a model call (its answer is sealed, so a retry pays
        // the ledger, not the provider): the budget's failure, logged and counted like a failed settlement.
        if (meter.ledgerUnavailable()) {
          try draftSpendFailed("vip")
          throw new IssueFailure({ reason: "budget" })
        }
        throw result.failure
      }
      return result.success
    },
  }
})
export const writerLayer = writer.pipe(Layer.provide(agentLayer))
