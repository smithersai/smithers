// VibeLang's main as a fold reads it on Cloudflare (wiki/decisions/0020-mythical-history.md): GitHub's commit list of
// the repository's main, newest first, read a page at a time until the folded cursor and every new ancestor are
// accounted for. Each first-parent step follows the side commits its merge brought in; a side commit already folded
// is refused `duplicate` by the sequencer and changes nothing.
import { HttpClient, HttpClientRequest } from "effect/http"
import { MainLog, MainUnavailable } from "../src/history/flows.vibe"
import { SHA_LENGTH, titleOf } from "../src/history/seed.vibe"
import type { MainCommit } from "../src/history/Sequencer.vibe"
import { newCommitOrder, pageAccepted, readsAnotherPage } from "./mainLogDecision.vibe"

/** One commit of GitHub's list: `GET /repos/<owner>/<repo>/commits`. */
export schema GitHubCommit {
  readonly sha: string
  readonly commit: { readonly message: string }
  readonly parents: ReadonlyArray<{ readonly sha: string }>
}

const decodePage = Schema.decodeUnknownEffect(Schema.Array(GitHubCommit))

/** How many commits a page holds, and how many pages a fold reads at most. */
export const PER_PAGE = 100
export const MAX_PAGES = 10

/**
 * The commits of `fetched` (newest first, as GitHub lists them) after `cursor`, a shortened id of a commit on main's
 * first-parent line, oldest first: each first-parent step after its side commits. `undefined` when the first-parent
 * walk from the newest commit doesn't reach `cursor`, a new side ancestor of `cursor` is unlisted, or the walk meets
 * a commit twice. An empty `cursor` takes the walk `fetched` holds.
 */
export function newCommits(fetched: ReadonlyArray<GitHubCommit>, cursor: string): ReadonlyArray<MainCommit> | undefined {
  // The proved order (mainLogDecision newCommitOrder) over each commit's id and its parents' ids.
  const order = newCommitOrder(fetched.map((commit) => ({ sha: commit.sha, parents: commit.parents.map((parent) => parent.sha) })), cursor)
  return order?.map((index) => toCommit(fetched[index]!))
}

/** A listed commit as the history folds it. */
function toCommit(commit: GitHubCommit): MainCommit {
  return { sha: commit.sha.slice(0, SHA_LENGTH), change: "", title: titleOf(commit.commit.message), message: commit.commit.message }
}

/** main of `repository` (`owner/name`) on GitHub, read signed out over `client` (the object's cached public reads, 0031). */
export function githubMain(repository: string, client: HttpClient.HttpClient): MainLog.Shape {
  return {
    since: effect (cursor: string) => {
      const fetched: Array<GitHubCommit> = []
      let page = 1
      while (true) {
        const request = HttpClientRequest.get(`https://api.github.com/repos/${repository}/commits?sha=main&per_page=${PER_PAGE}&page=${page}`).pipe(
          HttpClientRequest.setHeader("accept", "application/vnd.github+json"),
          HttpClientRequest.setHeader("user-agent", "vibelang-factory"),
        )
        const response = try Effect.mapError(client.execute(request), () => new MainUnavailable({ reason: "GitHub unreachable" }))
        if (!pageAccepted(response.status)) throw new MainUnavailable({ reason: `GitHub answered ${response.status}` })
        const body = try Effect.mapError(response.json, () => new MainUnavailable({ reason: "GitHub's answer is not JSON" }))
        const commits = try Effect.mapError(decodePage(body), () => new MainUnavailable({ reason: "GitHub's answer is not a commit list" }))
        fetched.push(...commits)
        const found = newCommits(fetched, cursor)
        if (found !== undefined) return found
        if (!readsAnotherPage(commits.length, page, PER_PAGE, MAX_PAGES)) break
        page += 1
      }
      throw new MainUnavailable({ reason: "main's folded cursor or merge ancestry is not within reach" })
    },
  }
}
