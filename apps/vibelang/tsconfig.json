{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "ES2024.String",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "test",
    "fuzz",
    "fuzz.config.ts",
    "e2e",
    "infra",
    "scripts",
    "bench",
    "alchemy.run.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  // The site Worker's test needs Cloudflare's types, so the Worker project checks it (worker/tsconfig.json).
  "exclude": [
    "test/worker.test.vibe", "test/workerd/api.vibe", "bench/site.bench.vibe", "fuzz/site.node.fuzz.vibe"
  ]
}
