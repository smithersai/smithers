{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@smthrs/ui-styleguide": [
        "../../packages/smithers/ui/ui-styleguide/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "e2e",
    "infra",
    "alchemy.run.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
