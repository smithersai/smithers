// The host supplies whether the validated origin uses HTTPS.
//@ verify
//@ ensures secure ==> \result === "__Host-vibelang-session"
//@ ensures !secure ==> \result === "vibelang-session"
export function cookieName(secure: boolean): string {
  return secure ? "__Host-vibelang-session" : "vibelang-session"
}

/** The session cookie an origin uses: the host-prefixed one exactly when the origin is HTTPS. */
//@ verify
//@ ensures origin.startsWith("https:") ==> \result === "__Host-vibelang-session"
//@ ensures !origin.startsWith("https:") ==> \result === "vibelang-session"
export function sessionCookieOf(origin: string): string {
  return cookieName(origin.startsWith("https:"))
}

/** Whether a URL's host is this machine, where plain HTTP is allowed. */
//@ verify
//@ ensures \result == (http && (hostname == "localhost" || hostname == "127.0.0.1" || hostname == "[::1]"))
export function localOrigin(http: boolean, hostname: string): boolean {
  return http && (hostname === "localhost" || hostname === "127.0.0.1" || hostname === "[::1]")
}

/**
 * Whether a session cookie is accepted for an origin, from the host's URL parse and cookie matches: the origin is
 * canonical and HTTPS or local; then the host-prefixed cookie, or on a local origin only the plain one. So an HTTPS
 * deployment never accepts the plain cookie.
 */
//@ verify
//@ ensures \result == (canonical && (https || local) && (hostCookie || (local && plainCookie)))
//@ ensures \result && !local ==> hostCookie
export function cookieAccepted(canonical: boolean, https: boolean, local: boolean, hostCookie: boolean, plainCookie: boolean): boolean {
  if (!canonical || (!https && !local)) return false
  if (hostCookie) return true
  return local && plainCookie
}

/** The sign-in state cookie: host-prefixed on HTTPS, plain on a local HTTP origin. */
//@ verify
//@ ensures secure ==> \result === "__Host-vibelang-sign-in"
//@ ensures !secure ==> \result === "vibelang-sign-in"
export function signInCookieName(secure: boolean): string {
  return secure ? "__Host-vibelang-sign-in" : "vibelang-sign-in"
}

/**
 * The session a request presents: on HTTPS only the host-prefixed cookie; on a local HTTP origin the plain cookie,
 * else the host-prefixed one.
 */
//@ verify
//@ ensures secure ==> \result == host
//@ ensures !secure && plain != undefined ==> \result == plain
//@ ensures !secure && plain == undefined ==> \result == host
export function presentedSession(secure: boolean, host: string | undefined, plain: string | undefined): string | undefined {
  if (secure) return host
  return plain !== undefined ? plain : host
}
