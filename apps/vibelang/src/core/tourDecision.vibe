// The tour's own decisions and the reply id (wiki/decisions/0014-agent-tour.md, 0011-post-flow.md, 0018 third-lane
// batch 2): which tour runs, which reply answers a post and which stop a step selects. `flows.vibe` and
// `walkthroughSteps.vibe` call these. Which paths the docs pane may show is `docsDecision.vibe`.
//
// VibeLang in LemmaScript's verifiable subset: TypeScript syntax with no Effect code, so `pnpm verify` proves this
// file's own text (0005). Strings are sequences of UTF-16 code units, as in JavaScript.

import { type Conversation, isTour } from "./conversation.vibe"

/** The running tour of `conversation`: its id, `""` when none runs. */
//@ verify
//@ ensures \result == ((conversation.agent == "working" && isTour(conversation.entries, conversation.replying)) ? conversation.replying : "")
export function runningTour(conversation: Conversation): string {
  return conversation.agent === "working" && isTour(conversation.entries, conversation.replying) ? conversation.replying : ""
}

/**
 * The reply that answers a post, unchanged across retries: `r` and the post id after its first character, so post
 * `m7` gets `r7`. Two posts with the same first character never share a reply.
 */
//@ verify
//@ ensures post.length == 0 ==> \result == "r"
//@ ensures post.length > 0 ==> \result == "r" + post.slice(1)
//@ ensures \result.length == (post.length == 0 ? 1 : post.length)
export function replyIdOf(post: string): string {
  if (post.length === 0) return "r"
  return "r" + post.slice(1)
}


/** The tour stop a whole step selects: the nearest of the `count` stops, the first below it and the last above it. */
//@ verify
//@ requires count >= 1
//@ ensures 0 <= \result && \result < count
//@ ensures \result == (whole < 1 ? 0 : (whole > count ? count - 1 : whole - 1))
export function stopIndex(whole: number, count: number): number {
  if (whole < 1) return 0
  return whole > count ? count - 1 : whole - 1
}
