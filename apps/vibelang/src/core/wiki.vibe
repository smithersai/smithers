// Wiki identity is independent of the deployment. The build embeds current Markdown; the flow admits only its pages.
import { pages } from "../assets/wiki.generated.vibe"
export { pages }
export function wikiPath(page: string): string | undefined {
  const normalized = page.replace(/^\/wiki\/?/, "").replace(/\.md(?=#|$)/, "") || "index"
  const [raw, hash] = normalized.split("#")
  const id = raw === "designs" ? "designs/index" : raw
  if (!pages.some(page => page.id === id)) return undefined
  if (hash !== undefined && !/^[a-z0-9-]+$/.test(hash)) return undefined
  return `/wiki/${id}${hash ? `#${hash}` : ""}`
}
export function wikiPage(url: string) {
  return pages.find(page => `/wiki/${page.id}` === url.split("#")[0])
}
/** Scripted product agent's wiki request. Live replies discover the same pages through their tool catalog. */
export function requestedWiki(text: string): string | undefined {
  if (!/wiki/i.test(text)) return undefined
  const direct = [...pages].sort((a, b) => b.id.length - a.id.length).find(page => text.toLowerCase().includes(page.id.toLowerCase()))
  if (direct) return direct.id
  if (/designs/i.test(text)) return "designs/index"
  const number = /\b([0-9]{4})\b/.exec(text)?.[1]
  if (number) return pages.find(page => page.id.startsWith(`decisions/${number}-`))?.id
  return /rulings/i.test(text) ? "rulings" : /roadmap/i.test(text) ? "roadmap" : "index"
}
