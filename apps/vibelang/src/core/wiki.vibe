// Wiki identity is independent of the deployment. The build embeds current Markdown; the flow admits only its pages.
// The pages with their bodies, for the browser. Worker code imports src/core/wikiIndex.vibe instead (0033).
import { pages } from "../assets/wiki.generated.vibe"
import { pageIndex } from "./wikiPageDecision.vibe"
export { pages }
export { requestedWiki, wikiEditable, wikiPath } from "./wikiIndex.vibe"
export function wikiPage(url: string) {
  const base = url.split("#")[0] ?? ""
  const index = base.startsWith("/wiki/") ? pageIndex(pages, base.slice("/wiki/".length)) : -1
  return index < 0 ? undefined : pages[index]
}
export { wikiLink } from "./wikiLinks.vibe"
