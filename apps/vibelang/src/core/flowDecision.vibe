// Decisions used by the durable Post and Tour steps. Execution and storage stay in their Effect shells. The Worker's
// reply and sequencer decisions are in `replyDecision.vibe`, so no browser code imports them.

/** Only the addressed tour's terminal event releases its running speaker. */
//@ verify
//@ ensures \result == (id == tour && (kind == "TourEnded" || kind == "ReplyFinished" || kind == "ReplyFailed"))
export function endsTourEvent(kind: string, id: string, tour: string): boolean {
  return id === tour && (kind === "TourEnded" || kind === "ReplyFinished" || kind === "ReplyFailed")
}

/** How a tour stopped, from the kind of event that stopped it: `finished` when it finished itself, else `ended`. */
//@ verify
//@ ensures \result == (kind == "ReplyFinished" ? "finished" : "ended")
export function tourStop(kind: string): string {
  return kind === "ReplyFinished" ? "finished" : "ended"
}

/** Reading time at 200 words/minute, plus one second to orient, with a four-second floor. */
//@ verify
//@ requires wordCount >= 0 && wordCount <= 4294967295
//@ ensures \result >= 4000 && \result <= 1288490189500
//@ ensures wordCount <= 10 ==> \result == 4000
//@ ensures wordCount > 10 ==> \result == wordCount * 300 + 1000
export function readingHold(wordCount: number): number {
  const millis = wordCount * 300 + 1000
  return millis < 4000 ? 4000 : millis
}

// The first source position whose reply flow has not already been dispatched.
//@ verify
//@ ensures 0 <= \result && \result <= posts.length
//@ ensures \result < posts.length ==> !dispatched.has(posts[\result])
//@ ensures forall(i, 0 <= i && i < \result ==> dispatched.has(posts[i]))
export function firstUndispatched(posts: ReadonlyArray<string>, dispatched: Set<string>): number {
  let i = 0
  while (i < posts.length) {
    //@ invariant 0 <= i && i <= posts.length
    //@ invariant forall(j, 0 <= j && j < i ==> dispatched.has(posts[j]))
    //@ decreases posts.length - i
    if (!dispatched.has(posts[i]!)) return i
    i++
  }
  return posts.length
}

/** One speaker invocation after a current active observation. Inactive and terminal runs admit no further speaker. */
export type TourPhase = "begun" | "ready" | "inactive" | "speaking" | "finished" | "ended"
export interface TourRun {
  readonly phase: TourPhase
  readonly speakers: number
  readonly outcome: string
}

//@ verify
//@ ensures tourLawful(\result)
//@ ensures \result.phase == "begun" && \result.speakers == 0 && \result.outcome == ""
export function beginTourBody(): TourRun {
  const phase: TourPhase = "begun"
  return { phase, speakers: 0, outcome: "" }
}

//@ verify
//@ ensures tourLawful(run) ==> tourLawful(\result)
//@ ensures run.phase != "begun" ==> \result == run
//@ ensures run.phase == "begun" ==> \result.speakers == 0 && \result.outcome == ""
//@ ensures run.phase == "begun" && active ==> \result.phase == "ready"
//@ ensures run.phase == "begun" && !active ==> \result.phase == "inactive"
export function observeTourActivity(run: TourRun, active: boolean): TourRun {
  if (run.phase !== "begun") return run
  const phase: TourPhase = active ? "ready" : "inactive"
  return { phase, speakers: 0, outcome: "" }
}

//@ verify
//@ ensures \result == (run.phase == "ready" && run.speakers == 0 && run.outcome == "")
export function canSpeakTour(run: TourRun): boolean {
  return run.phase === "ready" && run.speakers === 0 && run.outcome === ""
}

//@ verify
//@ ensures tourLawful(run) ==> tourLawful(\result)
//@ ensures !canSpeakTour(run) ==> \result == run
//@ ensures canSpeakTour(run) ==> \result.phase == "speaking" && \result.speakers == 1
//@ ensures \result.outcome == run.outcome
export function startTourSpeech(run: TourRun): TourRun {
  if (!canSpeakTour(run)) return run
  const phase: TourPhase = "speaking"
  return { ...run, phase, speakers: 1 }
}

//@ verify
//@ ensures tourLawful(run) ==> tourLawful(\result)
//@ ensures run.phase != "speaking" ==> \result == run
//@ ensures run.phase == "speaking" && ended ==> \result.phase == "ended" && \result.outcome == "ended"
//@ ensures run.phase == "speaking" && !ended ==> \result.phase == "finished" && \result.outcome == "finished"
//@ ensures \result.speakers == run.speakers
export function finishTourSpeech(run: TourRun, ended: boolean): TourRun {
  if (run.phase !== "speaking") return run
  const phase: TourPhase = ended ? "ended" : "finished"
  return { phase, speakers: run.speakers, outcome: ended ? "ended" : "finished" }
}

//@ verify
//@ ensures \result ==> 0 <= run.speakers && run.speakers <= 1
//@ ensures \result == (((run.phase == "begun" || run.phase == "ready" || run.phase == "inactive") && run.speakers == 0 && run.outcome == "") || (run.phase == "speaking" && run.speakers == 1 && run.outcome == "") || (run.phase == "finished" && run.speakers == 1 && run.outcome == "finished") || (run.phase == "ended" && run.speakers == 1 && run.outcome == "ended"))
export function tourLawful(run: TourRun): boolean {
  if (run.phase === "begun" || run.phase === "ready" || run.phase === "inactive") return run.speakers === 0 && run.outcome === ""
  if (run.phase === "speaking") return run.speakers === 1 && run.outcome === ""
  if (run.phase === "finished") return run.speakers === 1 && run.outcome === "finished"
  return run.speakers === 1 && run.outcome === "ended"
}

/** Private visit/turn identities use native exact integers; serialized step names remain decimal strings. */
//@ verify
//@ ensures \result == value + 1
//@ ensures \result > value
//@ ensures value >= 0 ==> \result >= 1
export function nextTourCounter(value: bigint): bigint {
  return value + 1n
}

//@ verify
//@ ensures \result == (value == 0)
export function firstTourVisit(value: bigint): boolean {
  return value === 0n
}

//@ verify
//@ ensures paused ==> \result == "control"
//@ ensures !paused ==> \result == "race"
export function tourWait(paused: boolean): "control" | "race" {
  return paused ? "control" : "race"
}

export type TourControlAction = "seek" | "wait"
export interface TourControlChoice { readonly action: TourControlAction; readonly step: number }

/** A seek chooses the requested step. Pause/resume retain the existing cursor. */
//@ verify
//@ ensures target == "" ==> \result.action == "seek" && \result.step == requested
//@ ensures target != "" ==> \result.action == "wait" && \result.step == current
export function tourControlChoice(current: number, target: string, requested: number): TourControlChoice {
  const action: TourControlAction = target === "" ? "seek" : "wait"
  return { action, step: target === "" ? requested : current }
}

/** Only the reading clock advances to the next step; the caller bounds this cursor by its finite script. */
//@ verify
//@ requires 0 <= current && current < 9007199254740991
//@ ensures \result == current + 1 && 1 <= \result && \result <= 9007199254740991
export function nextTourStep(current: number): number {
  return current + 1
}
