// Which specification requests are refused before any work, which review answers count, and the scripted grade
// (0018, third-lane batch 20). `specification.vibe`'s performSpecification calls these.

/**
 * Why a specification request is refused before any work, else "". A missing key or a stale or absent revision is
 * "review"; then a blank revision text or an exhausted revision counter, or a review with no reviewer or of no
 * specification yet, is "invalid". Nothing is written on a refusal.
 */
//@ verify
//@ ensures (key == "" || requested != current) ==> \result == "review"
//@ ensures key != "" && requested == current && revise ==> \result == ((blank || current >= 9007199254740991) ? "invalid" : "")
//@ ensures key != "" && requested == current && !revise ==> \result == ((!hasReviewer || current == 0) ? "invalid" : "")
export function specificationRefusal(revise: boolean, key: string, requested: number | undefined, current: number, blank: boolean, hasReviewer: boolean): "review" | "invalid" | "" {
  if (key === "" || requested !== current) return "review"
  if (revise) return blank || current >= 9007199254740991 ? "invalid" : ""
  return !hasReviewer || current === 0 ? "invalid" : ""
}

/** A reviewer's answer counts only for the current revision, with a verdict and a link. */
//@ verify
//@ ensures \result == (answered == current && verdict != "" && link != "")
export function reviewAnswerAccepted(answered: number, current: number, verdict: string, link: string): boolean {
  return answered === current && verdict !== "" && link !== ""
}

/** The scripted grade: Opus, not yet reviewed, first answers B+; every other review gets its accepted grade. */
//@ verify
//@ ensures \result == ((reviewer == "opus" && previousVerdict == "") ? "B+" : accepted)
export function scriptedGrade(reviewer: string, previousVerdict: string, accepted: string): string {
  return reviewer === "opus" && previousVerdict === "" ? "B+" : accepted
}

/** The history event a revision records: a reset of every review, or a revision that keeps them (0018 third-lane batch 34). */
//@ verify
//@ ensures \result == (reset ? "reset" : "revision")
export function revisionEvent(reset: boolean): "reset" | "revision" {
  return reset ? "reset" : "revision"
}

export type ReviewSource = "provider" | "scripted" | "none"

/** Who answers a review: a deployment's reviewer when one is bound, else the scripted product mode when on, else no one. */
//@ verify
//@ ensures hasProvider ==> \result == "provider"
//@ ensures !hasProvider && scripted ==> \result == "scripted"
//@ ensures !hasProvider && !scripted ==> \result == "none"
export function reviewSource(hasProvider: boolean, scripted: boolean): ReviewSource {
  if (hasProvider) return "provider"
  return scripted ? "scripted" : "none"
}
