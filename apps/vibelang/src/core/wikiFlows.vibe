// Every wiki operation is the same flow for the browser, the CLI/MCP and the agent (FLOW-3). Hosts inject identity and storage.
import { Digest, SecureRandom } from "effect/crypto"
import { Action, Flow, FlowRuntime, RetryPolicy, Interpreter } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { wikiSubmissionAllowed } from "./wikiDecision.vibe"
import { WikiFailure, WikiRequest, WikiState } from "./wikiSchemas.vibe"
import { wikiPermission, type Role, type WikiOperation } from "./conversation.vibe"

export service WikiHost {
  perform(request: WikiRequest): typeof WikiState.Type!WikiFailure!(FlowRuntime.FlowRuntime | FlowRuntime.FlowInstance | Digest.Digest | SecureRandom.SecureRandom)
}
const operations: ReadonlyArray<WikiOperation> = ["read", "save", "propose", "draft"]
const retries = RetryPolicy.make({ initialMs: 1000, factor: 2, maxMs: 60_000, expirationMs: 120_000, retryable: [{ tag: "WikiFailure", code: "unavailable" }, { tag: "WikiFailure", code: "rate-limited" }, { tag: "WikiFailure", code: "unknown" }] })
/** A read answers a waiting person: past this the engine settles it and the page shows Retry (0015). Writes keep the full retry window. */
export const wikiReadDeadline = "5 seconds"
const steps = Metric.counter("vibelang_wiki_edit_steps", { incremental: true })
const definitions = operations.map((op) => {
  const action = Action.make(`vibelang/wiki/${op}/perform`, {
    payload: WikiRequest.fields, success: WikiState, error: WikiFailure,
    tier: op === "read" || op === "draft" ? "sealed" : "irreversible",
    implementationVersion: "wiki-edit/v1", retryPolicy: retries,
    ...(op === "read" || op === "draft" ? {} : { idempotencyKey: (payload: WikiRequest) => ({ request: payload.key, operation: payload.op }) }),
  })
  const flow = Flow.make(`vibelang/wiki/${op}`, {
    description: `VibeLang wiki: ${op}. Runs with the current person's policy and GitHub identity.`,
    modelInvocable: op === "read" || op === "draft",
    ...(op === "read" ? { deadline: wikiReadDeadline } : {}),
    payload: WikiRequest.fields, success: WikiState, error: WikiFailure,
    body: Node.capture({}, (request) => action.call(request)),
  })
  return { action, flow, op }
})
export const wikiEditFlows = definitions.map(({ flow }) => flow)
/** The flow that runs one operation. `definitions` maps every operation, so the lookup always finds one. */
export function wikiEditFlow(op: WikiOperation) { return definitions.find((definition) => definition.op === op)!.flow }
export const wikiEditRegistration = Layer.unwrap(effect {
  const host = try WikiHost
  return Layer.mergeAll(Layer.empty, ...definitions.map(({ action, flow, op }) => Interpreter.layerWithImplementations(flow,
    action.toLayer((request) => withSpan(effect {
      const result = try Effect.result(host.perform(request))
      const outcome = result._tag === "Success" ? "accepted" : result.failure.reason
      try Metric.update(Metric.withAttributes(steps, { op, outcome }), 1)
      try Effect.logInfo("vibelang.wiki.edit.step").pipe(Effect.annotateLogs({ op, outcome }))
      if (result._tag === "Failure") throw result.failure
      return result.success
    }, `vibelang.wiki.${op}`), { implementationVersion: "wiki-edit/v1" }),
  )))
})

/** A cached receipt never bypasses today's least-role check. No payload or write identity enters telemetry. */
export const authorizeWiki = (role: Role, op: WikiOperation, kind: "person" | "agent" = "person") => withSpan(effect {
  const allowed = wikiPermission(role, op) && wikiSubmissionAllowed(op, kind)
  const outcome = allowed ? "accepted" : "forbidden"
  try Metric.update(Metric.withAttributes(Metric.counter("vibelang_wiki_access", { incremental: true }), { op, outcome }), 1)
  try Effect.logInfo("vibelang.wiki.access").pipe(Effect.annotateLogs({ op, outcome }))
  if (!allowed) throw new WikiFailure({ reason: "forbidden" })
}, "vibelang.wiki.authorize")

/** Runtime telemetry sees a digest, never a caller-supplied request key. */
export effect function wikiExecutionId(actor: string, op: WikiOperation, key: string) {
  provide Digest.layerWebCrypto {
    const hash = try (try Digest.Digest).digestHex(Digest.sha256, new TextEncoder().encode(JSON.stringify(["vibelang/wiki/run/v1", actor, op, key])))
    return `wiki/${actor}/${op}/${hash}`
  }
}
export effect function wikiRecoveryId(root: string, recovery: string) {
  provide Digest.layerWebCrypto {
    const hash = try (try Digest.Digest).digestHex(Digest.sha256, new TextEncoder().encode(JSON.stringify(["vibelang/wiki/recovery/v1", root, recovery])))
    return `${root}/retry/${hash}`
  }
}
