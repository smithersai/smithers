// Shared by the cold wiki generator and the pane; independent of generated assets.
import { absoluteHref, hashSuffix, lastSlash, linkPage, localLink, resolvedSegments } from "./wikiLinkDecision.vibe"
/** One Markdown link rule for the build and the pane's edited pages: relative links resolve against their page. */
export function wikiLink(fromId: string, href: string, ids: ReadonlyArray<string>): string {
  if (absoluteHref(href)) return href
  const [relative, hash] = href.split("#")
  const slash = lastSlash(fromId)
  // An empty base adds an empty segment, which resolvedSegments drops.
  const parts = [...fromId.slice(0, Math.max(slash, 0)).split("/"), ...relative!.split("/")]
  const out = resolvedSegments(parts)
  const target = out.join("/").replace(/\.md$/, "").replace(/\/$/, "")
  const page = linkPage(ids.includes(target), ids.includes(`${target}/index`)) === "index" ? `${target}/index` : target
  const section = hashSuffix(hash ?? "")
  return localLink(ids.includes(page), page) ? `/wiki/${page}${section}` : `https://github.com/smithersai/smithers/blob/main/apps/vibelang/wiki/${out.join("/")}${section}`
}
