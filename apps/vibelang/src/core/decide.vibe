// The sequencer's decision (wiki/decisions/0003-one-state-machine.md): an intent becomes the next numbered event or a refusal.
//
// Its own module so its proof finishes well inside the verifier's limit: `decide` and `apply` are almost all of the
// conversation proof's obligations (wiki/decisions/0018-proofs.md). Contracts are in terms of the `conversation.vibe`
// functions it imports, which that module proves.

import { type Action, type Conversation, type Event, type GrantMode, type Role, apply, canGrant, canReplyTo, empty, hasClientId, hasEntryId, hasOpenRun, hasRun, isReplying, isTouring, may, roleOf, runsOf } from "./conversation.vibe"

/** The most characters one message may hold. */
export const MAX_TEXT = 8000

export type Intent =
  | { readonly type: "DriveWalkthrough"; readonly id: string; readonly step: number; readonly target: string; readonly at: number; readonly duration: number }
  | { readonly type: "PauseTour"; readonly id: string; readonly at: number }
  | { readonly type: "ResumeTour"; readonly id: string; readonly at: number }
  | { readonly type: "SeekTour"; readonly id: string; readonly at: number; readonly step: number }
  | { readonly type: "GrantRole"; readonly id: string; readonly by: string; readonly role: Role; readonly mode: GrantMode }
  | { readonly type: "Authorize"; readonly id: string; readonly by: string; readonly action: Action }
  | { readonly type: "RequestAction"; readonly id: string; readonly flow: string; readonly door: string; readonly actor: string; readonly at: number }
  | { readonly type: "TraceAction"; readonly id: string; readonly key: string; readonly name: string; readonly attempt: number; readonly state: string; readonly at: number }
  | { readonly type: "SettleAction"; readonly id: string; readonly state: string; readonly result: string; readonly at: number }
  | { readonly type: "Post"; readonly id: string; readonly clientId: string; readonly name: string; readonly text: string }
  | { readonly type: "StartReply"; readonly id: string; readonly inReplyTo: string }
  | { readonly type: "AppendReply"; readonly id: string; readonly text: string }
  | { readonly type: "RestartReply"; readonly id: string }
  | { readonly type: "FinishReply"; readonly id: string }
  | { readonly type: "FailReply"; readonly id: string; readonly reason: string }
  | { readonly type: "StartTour"; readonly id: string }
  | { readonly type: "EndTour"; readonly id: string }
  | { readonly type: "OpenPane"; readonly id: string; readonly url: string }

/** Why the sequencer refused an intent. */
export type Refusal = "empty" | "too-long" | "duplicate" | "busy" | "not-replying" | "forbidden" | "full"

/** The sequencer's answer: the next event, or why there is none. */
export type Decision =
  | { readonly ok: true; readonly event: Event }
  | { readonly ok: false; readonly refusal: Refusal }

// Typed constructors keep nested union construction explicit for LemmaScript.
//@ verify
//@ ensures \result.ok && \result.event == event
function accepted(event: Event): Decision {
  return { ok: true, event }
}

//@ verify
//@ ensures !\result.ok && \result.refusal == refusal
function refused(refusal: Refusal): Decision {
  return { ok: false, refusal }
}

/**
 * The event that records `intent` as the next one, or a refusal. Every event it returns is one `apply` takes as is:
 * applying it changes the conversation the way its type says.
 */
//@ verify
//@ requires 0 <= conversation.seq && conversation.seq <= 9007199254740991
//@ ensures \result.ok && intent.type == "GrantRole" ==> intent.id != "" && intent.role != "viewer"
//@ ensures \result.ok && intent.type == "GrantRole" && intent.mode == "person" && intent.by != intent.id ==> intent.by != "" && exists(i, 0 <= i && i < conversation.roles.length && conversation.roles[i].id == intent.by && conversation.roles[i].role == "maintainer" && forall(j, 0 <= j && j < i ==> conversation.roles[j].id != intent.by))
//@ ensures \result.ok && intent.type == "Authorize" && (intent.action == "merge" || intent.action == "settings" || intent.action == "roles") ==> intent.by != "" && exists(i, 0 <= i && i < conversation.roles.length && conversation.roles[i].id == intent.by && conversation.roles[i].role == "maintainer" && forall(j, 0 <= j && j < i ==> conversation.roles[j].id != intent.by))
//@ ensures conversation.seq < 9007199254740991 && intent.type == "GrantRole" ==> (\result.ok == canGrant(conversation.roles, intent.id, intent.by, intent.role, intent.mode)) && (!\result.ok ==> \result.refusal == "forbidden")
//@ ensures \result.ok && intent.type == "GrantRole" ==> \result.event.type == "RoleGranted" && \result.event.id == intent.id && \result.event.by == intent.by && \result.event.role == intent.role && \result.event.mode == intent.mode
//@ ensures conversation.seq < 9007199254740991 && intent.type == "Authorize" ==> (\result.ok == may(roleOf(conversation.roles, intent.by), intent.action)) && (!\result.ok ==> \result.refusal == "forbidden")
//@ ensures \result.ok && intent.type == "Authorize" ==> \result.event.type == "ActionAuthorized" && \result.event.id == intent.id && \result.event.by == intent.by && \result.event.action == intent.action
//@ ensures \result.ok ==> \result.event.seq == conversation.seq + 1
//@ ensures \result.ok && \result.event.type == "ReplyStarted" ==> conversation.agent != "working" && \result.event.id != ""
//@ ensures \result.ok && \result.event.type == "Posted" ==> \result.event.clientId != "" && \result.event.text != ""
//@ ensures \result.ok && \result.event.type == "Posted" ==> \result.event.text.length <= MAX_TEXT
//@ ensures \result.ok && (\result.event.type == "Posted" || \result.event.type == "ReplyStarted" || \result.event.type == "TourStarted") ==> \result.event.id != "" && forall(i, 0 <= i && i < conversation.entries.length ==> conversation.entries[i].id != \result.event.id)
//@ ensures \result.ok && \result.event.type == "Posted" ==> forall(i, 0 <= i && i < conversation.entries.length ==> conversation.entries[i].clientId != \result.event.clientId)
//@ ensures \result.ok && \result.event.type == "ReplyStarted" ==> \result.event.inReplyTo != "" && exists(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].author == "person" && conversation.entries[i].id == \result.event.inReplyTo) && forall(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].author == "agent" ==> conversation.entries[i].inReplyTo != \result.event.inReplyTo)
//@ ensures intent.type == "StartReply" && \result.ok ==> \result.event.type == "ReplyStarted" && \result.event.inReplyTo == intent.inReplyTo
//@ ensures \result.ok && \result.event.type == "ReplyRestarted" ==> conversation.agent == "working" && conversation.replying == \result.event.id && \result.event.id != ""
//@ ensures \result.ok && \result.event.type == "TourStarted" ==> conversation.agent != "working"
//@ ensures intent.type == "StartTour" && \result.ok ==> \result.event.type == "TourStarted" && \result.event.id == intent.id
//@ ensures \result.ok && \result.event.type == "TourEnded" ==> conversation.agent == "working" && conversation.replying == \result.event.id && \result.event.id != "" && exists(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].id == \result.event.id && conversation.entries[i].author == "agent" && conversation.entries[i].inReplyTo == "")
//@ ensures \result.ok && \result.event.type == "PaneOpened" ==> (\result.event.id == "" || (conversation.agent == "working" && conversation.replying == \result.event.id && \result.event.id != "")) && \result.event.url != ""
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "OpenPane" && intent.id == "" && intent.url != "" ==> \result.ok && \result.event.type == "PaneOpened" && \result.event.id == "" && \result.event.url == intent.url)
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "Post" && intent.text.trim() != "" && intent.text.trim().length <= MAX_TEXT && intent.id != "" && intent.clientId != "" && forall(i, 0 <= i && i < conversation.entries.length ==> conversation.entries[i].id != intent.id && conversation.entries[i].clientId != intent.clientId) ==> \result.ok && \result.event.type == "Posted" && \result.event.text == intent.text.trim() && \result.event.id == intent.id && \result.event.name == intent.name && \result.event.clientId == intent.clientId)
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "StartReply" && conversation.agent != "working" && intent.id != "" && forall(i, 0 <= i && i < conversation.entries.length ==> conversation.entries[i].id != intent.id) && intent.inReplyTo != "" && exists(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].author == "person" && conversation.entries[i].id == intent.inReplyTo) && forall(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].author == "agent" ==> conversation.entries[i].inReplyTo != intent.inReplyTo) ==> \result.ok && \result.event.type == "ReplyStarted" && \result.event.id == intent.id)
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "StartTour" && conversation.agent != "working" && intent.id != "" && forall(i, 0 <= i && i < conversation.entries.length ==> conversation.entries[i].id != intent.id) ==> \result.ok)
//@ ensures conversation.seq < 9007199254740991 ==> ((intent.type == "AppendReply" || intent.type == "RestartReply" || intent.type == "FinishReply" || intent.type == "FailReply") ==> (\result.ok == (conversation.agent == "working" && conversation.replying == intent.id && intent.id != "")))
//@ ensures intent.type == "AppendReply" && \result.ok ==> \result.event.type == "ReplyDelta" && \result.event.id == intent.id && \result.event.text == intent.text
//@ ensures intent.type == "RestartReply" && \result.ok ==> \result.event.type == "ReplyRestarted" && \result.event.id == intent.id
//@ ensures intent.type == "FinishReply" && \result.ok ==> \result.event.type == "ReplyFinished" && \result.event.id == intent.id
//@ ensures intent.type == "FailReply" && \result.ok ==> \result.event.type == "ReplyFailed" && \result.event.id == intent.id && \result.event.reason == intent.reason
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "EndTour" && conversation.agent == "working" && conversation.replying == intent.id && intent.id != "" && exists(i, 0 <= i && i < conversation.entries.length && conversation.entries[i].id == intent.id && conversation.entries[i].author == "agent" && conversation.entries[i].inReplyTo == "") ==> \result.ok && \result.event.id == intent.id)
//@ ensures conversation.seq < 9007199254740991 ==> (intent.type == "OpenPane" && conversation.agent == "working" && conversation.replying == intent.id && intent.id != "" && intent.url != "" ==> \result.ok && \result.event.id == intent.id && \result.event.type == "PaneOpened" && \result.event.url == intent.url)
//@ ensures conversation.seq == 9007199254740991 ==> !\result.ok && \result.refusal == "full"
//@ ensures \result.ok ==> conversation.seq < 9007199254740991 && \result.event.seq == conversation.seq + 1 && \result.event.seq <= 9007199254740991
//@ ensures \result.ok && intent.type == "DriveWalkthrough" ==> (conversation.agent == "working" && conversation.replying == intent.id && intent.id != "") && 1 <= intent.step && intent.step <= 10 && intent.target != "" && intent.duration >= 0 && \result.event.type == "WalkthroughDriven" && \result.event.step == intent.step && \result.event.target == intent.target
//@ ensures \result.ok && (intent.type == "PauseTour" || intent.type == "ResumeTour" || intent.type == "SeekTour") ==> (conversation.agent == "working" && conversation.replying == intent.id && intent.id != "") && conversation.walkthrough != undefined
//@ ensures \result.ok && intent.type == "RequestAction" ==> intent.id != "" && intent.flow != "" && forall(i, 0 <= i && i < runsOf(conversation).length ==> runsOf(conversation)[i].id != intent.id) && \result.event.type == "ActionRequested" && \result.event.id == intent.id && \result.event.flow == intent.flow && \result.event.door == intent.door && \result.event.actor == intent.actor && \result.event.at == intent.at
//@ ensures conversation.seq < 9007199254740991 && intent.type == "RequestAction" && intent.id != "" && intent.flow != "" && forall(i, 0 <= i && i < runsOf(conversation).length ==> runsOf(conversation)[i].id != intent.id) ==> \result.ok
//@ ensures \result.ok && intent.type == "TraceAction" ==> exists(i, 0 <= i && i < runsOf(conversation).length && runsOf(conversation)[i].id == intent.id && (runsOf(conversation)[i].state == "queued" || runsOf(conversation)[i].state == "running")) && \result.event.type == "ActionStep" && \result.event.id == intent.id && \result.event.key == intent.key && \result.event.name == intent.name && \result.event.attempt == intent.attempt && \result.event.state == intent.state && \result.event.at == intent.at
//@ ensures \result.ok && intent.type == "SettleAction" ==> exists(i, 0 <= i && i < runsOf(conversation).length && runsOf(conversation)[i].id == intent.id && (runsOf(conversation)[i].state == "queued" || runsOf(conversation)[i].state == "running")) && \result.event.type == "ActionSettled" && \result.event.id == intent.id && \result.event.state == intent.state && \result.event.result == intent.result && \result.event.at == intent.at
//@ ensures conversation.seq < 9007199254740991 && (intent.type == "TraceAction" || intent.type == "SettleAction") ==> (\result.ok == exists(i, 0 <= i && i < runsOf(conversation).length && runsOf(conversation)[i].id == intent.id && (runsOf(conversation)[i].state == "queued" || runsOf(conversation)[i].state == "running")))
export function decide(conversation: Conversation, intent: Intent): Decision {
  if (conversation.seq >= 9007199254740991) return refused("full")
  const seq = conversation.seq + 1
  switch (intent.type) {
    case "GrantRole":
      if (!canGrant(conversation.roles, intent.id, intent.by, intent.role, intent.mode)) return refused("forbidden")
      return accepted({ type: "RoleGranted", seq, id: intent.id, by: intent.by, role: intent.role, mode: intent.mode })
    case "Authorize":
      if (!may(roleOf(conversation.roles, intent.by), intent.action)) return refused("forbidden")
      return accepted({ type: "ActionAuthorized", seq, id: intent.id, by: intent.by, action: intent.action })
    case "RequestAction":
      if (intent.id === "" || intent.flow === "") return refused("empty")
      if (hasRun(runsOf(conversation), intent.id)) return refused("duplicate")
      return accepted({ type: "ActionRequested", seq, id: intent.id, flow: intent.flow, door: intent.door, actor: intent.actor, at: intent.at })
    case "TraceAction":
      if (!hasOpenRun(runsOf(conversation), intent.id)) return refused("not-replying")
      return accepted({ type: "ActionStep", seq, id: intent.id, key: intent.key, name: intent.name, attempt: intent.attempt, state: intent.state, at: intent.at })
    case "SettleAction":
      if (!hasOpenRun(runsOf(conversation), intent.id)) return refused("not-replying")
      return accepted({ type: "ActionSettled", seq, id: intent.id, state: intent.state, result: intent.result, at: intent.at })
    case "Post": {
      const text = intent.text.trim()
      if (text === "") return refused("empty")
      if (text.length > MAX_TEXT) return refused("too-long")
      if (hasEntryId(conversation.entries, intent.id)) return refused("duplicate")
      if (intent.clientId === "" || hasClientId(conversation.entries, intent.clientId)) {
        return refused("duplicate")
      }
      return accepted({ type: "Posted", seq, id: intent.id, clientId: intent.clientId, name: intent.name, text })
    }
    case "StartReply":
      if (conversation.agent === "working") return refused("busy")
      if (intent.id === "") return refused("not-replying")
      if (hasEntryId(conversation.entries, intent.id)) return refused("duplicate")
      if (!canReplyTo(conversation.entries, intent.inReplyTo)) return refused("not-replying")
      return accepted({ type: "ReplyStarted", seq, id: intent.id, inReplyTo: intent.inReplyTo })
    case "AppendReply":
      if (!isReplying(conversation, intent.id)) return refused("not-replying")
      return accepted({ type: "ReplyDelta", seq, id: intent.id, text: intent.text })
    case "RestartReply":
      if (!isReplying(conversation, intent.id)) return refused("not-replying")
      return accepted({ type: "ReplyRestarted", seq, id: intent.id })
    case "FinishReply":
      if (!isReplying(conversation, intent.id)) return refused("not-replying")
      return accepted({ type: "ReplyFinished", seq, id: intent.id })
    case "FailReply":
      if (!isReplying(conversation, intent.id)) return refused("not-replying")
      return accepted({ type: "ReplyFailed", seq, id: intent.id, reason: intent.reason })
    case "StartTour":
      if ("working" === conversation.agent) return refused("busy")
      if (intent.id === "") return refused("not-replying")
      if (hasEntryId(conversation.entries, intent.id)) return refused("duplicate")
      return accepted({ type: "TourStarted", seq, id: intent.id })
    case "EndTour":
      if (!isTouring(conversation, intent.id)) return refused("not-replying")
      return accepted({ type: "TourEnded", seq, id: intent.id })
    case "DriveWalkthrough":
      if (!isTouring(conversation, intent.id)) return refused("not-replying")
      if (intent.step < 1 || intent.step > 10 || intent.step % 1 !== 0 || intent.target === "" || intent.duration < 0 || intent.duration % 1 !== 0) return refused("empty")
      return accepted({ type: "WalkthroughDriven", seq, id: intent.id, step: intent.step, target: intent.target, at: intent.at, duration: intent.duration })
    case "PauseTour":
    case "ResumeTour":
    case "SeekTour":
      if (!isTouring(conversation, intent.id) || conversation.walkthrough === undefined) return refused("not-replying")
      if (intent.type === "SeekTour") {
        if (intent.step < 1 || intent.step > 11 || intent.step % 1 !== 0) return refused("empty")
        return accepted({ type: "TourSought", seq, id: intent.id, step: intent.step, at: intent.at })
      }
      if (intent.type === "PauseTour") return accepted({ type: "TourPaused", seq, id: intent.id, at: intent.at })
      return accepted({ type: "TourResumed", seq, id: intent.id, at: intent.at })
    case "OpenPane":
      if (intent.id !== "" && !isReplying(conversation, intent.id)) return refused("not-replying")
      if (intent.url === "") return refused("empty")
      return accepted({ type: "PaneOpened", seq, id: intent.id, url: intent.url })
  }
}
