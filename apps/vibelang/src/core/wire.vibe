// The HTTP protocol between `LiveFactory` and the API Worker (wiki/decisions/0010-live-agent.md). Both sides import
// these schemas, so the browser, the CLI and the Worker cannot disagree about a field.
//
//   GET  /api/health                                   Health
//   POST /api/conversations/<id>/posts                 PostBody → 200 {} | 409 Refusal
//   GET  /api/conversations/<id>?after=<seq>           ReadSnapshot
//   GET  /api/conversations/<id>/events?after=<seq>    text/event-stream: `id: <seq>`, `data: <EventSchema JSON>`
//   POST   /api/conversations/<id>/tour                starts the agent's tour → 200 {} | 409 Refusal
//   DELETE /api/conversations/<id>/tour                ends it → 200 {} | 409 Refusal
import { routeKind, validConversationLength } from "./protocolDecision.vibe"
import { MAX_TEXT } from "./conversation.vibe"
import { Seq } from "./schemas.vibe"

export const HEALTH_PATH = "/api/health"
export const CONVERSATIONS = "/api/conversations/"

/** A conversation's tour, below its path. */
export const TOUR_PATH = "/tour"

/** The most characters a conversation id or a poster's name may hold. */
export const MAX_CONVERSATION = 128
export const MAX_NAME = 64

/** What `/api/health` says: `live` when the API Worker is bound, `mock` when the site serves the mock agent. */
export schema Health { readonly ok: boolean; readonly agent: "mock" | "live" }

/** Text the durable store can retain exactly: no unpaired UTF-16 surrogate. */
export const DurableText = Schema.String.check(Schema.isPattern(/^[^\uD800-\uDFFF]*$/u))

/** A person's post. `text` may be longer than `MAX_TEXT`: the sequencer refuses it as `too-long`. */
export schema PostBody {
  readonly clientId: DurableText
  readonly name: DurableText
  readonly text: DurableText
}

/** Why the sequencer refused a post, with HTTP 409. */
export schema Refusal { readonly refusal: "empty" | "too-long" | "duplicate" | "busy" | "not-replying" | "full" }

/** The largest post body the API reads: the longest text, its client id and name, as UTF-8, with room for JSON. */
export const MAX_POST_BYTES = MAX_TEXT * 4 + 4096

/** The cursor a `read` or `events` request asks for: `after=<seq>`, zero when absent. */
export const After = Seq

/** The path of a valid conversation id, or undefined for an empty, long or malformed UTF-16 id. */
export function conversationPath(conversation: string): string | undefined {
  if (conversation.length === 0 || conversation.length > MAX_CONVERSATION) return undefined
  try {
    return CONVERSATIONS + encodeURIComponent(conversation)
  } catch {
    return undefined
  }
}

/** A route of the conversation API: the conversation and what is asked of it. */
export type Route =
  | { readonly kind: "read"; readonly conversation: string }
  | { readonly kind: "post"; readonly conversation: string }
  | { readonly kind: "events"; readonly conversation: string }
  | { readonly kind: "tour-control"; readonly conversation: string }
  | { readonly kind: "wiki"; readonly conversation: string }
  | { readonly kind: "tour"; readonly conversation: string }
  | { readonly kind: "end-tour"; readonly conversation: string }

/** The route a path names, or `undefined`. A conversation id is 1 to `MAX_CONVERSATION` characters. */
export function routeOf(method: string, pathname: string): Route | undefined {
  if (!pathname.startsWith(CONVERSATIONS)) return undefined
  const parts = pathname.slice(CONVERSATIONS.length).split("/")
  if (parts.length > 2) return undefined
  const decoded = decodeSegment(parts[0]!)
  if (decoded === undefined || !validConversationLength(decoded.length, MAX_CONVERSATION)) return undefined
  const kind = routeKind(method, parts[1])
  return kind === "" ? undefined : { kind, conversation: decoded }
}

function decodeSegment(segment: string): string | undefined {
  try {
    return decodeURIComponent(segment)
  } catch {
    return undefined
  }
}

export schema WikiBody { readonly page: string }

export schema TourControlBody { readonly action: "pause" | "resume" | "seek"; readonly step: Seq }
