// Pure decisions of the API Worker, its routes and the command hosts. Parsing and encoding stay at the edge. The
// browser's own protocol decisions are in `clientProtocolDecision.vibe`, so no browser code imports this file.

/** The wire's conversation length contract. */
//@ verify
//@ ensures \result == (length > 0 && length <= maximum)
export function validConversationLength(length: number, maximum: number): boolean {
  return length > 0 && length <= maximum
}

/** The CLI/MCP registry accepts nonempty conversation identifiers. */
//@ verify
//@ ensures \result == (value.length >= 1)
export function commandConversation(value: string): boolean {
  return value.length >= 1
}

/** Routing after URI decoding: a method and remaining segment identify exactly one operation. */
//@ verify
//@ ensures rest == undefined && method == "GET" ==> \result == "read"
//@ ensures rest == "tour-control" && method == "POST" ==> \result == "tour-control"
//@ ensures rest == "wiki" && method == "POST" ==> \result == "wiki"
//@ ensures rest == "posts" && method == "POST" ==> \result == "post"
//@ ensures rest == "events" && method == "GET" ==> \result == "events"
//@ ensures rest == "tour" && method == "POST" ==> \result == "tour"
//@ ensures rest == "tour" && method == "DELETE" ==> \result == "end-tour"
//@ ensures \result != "" ==> (rest == "tour-control" && method == "POST") || (rest == undefined && method == "GET") || (rest == "posts" && method == "POST") || (rest == "wiki" && method == "POST") || (rest == "events" && method == "GET") || (rest == "tour" && (method == "POST" || method == "DELETE"))
export function routeKind(method: string, rest: string | undefined): "read" | "post" | "events" | "tour" | "end-tour" | "wiki" | "tour-control" | "" {
  if (rest === undefined && method === "GET") return "read"
  if (rest === "tour-control" && method === "POST") return "tour-control"
  if (rest === "wiki" && method === "POST") return "wiki"
  if (rest === "posts" && method === "POST") return "post"
  if (rest === "events" && method === "GET") return "events"
  if (rest === "tour" && method === "POST") return "tour"
  if (rest === "tour" && method === "DELETE") return "end-tour"
  return ""
}

/** Only a bounded positive body length is read. */
//@ verify
//@ ensures \result == (length > 0 && length <= maximum)
export function validBodyLength(length: number, maximum: number): boolean {
  return length > 0 && length <= maximum
}

/** Explicit mock choice wins over live lookup in every command host. */
//@ verify
//@ ensures \result == (flag || environment == "mock")
export function prefersMock(flag: boolean, environment: string | undefined): boolean {
  return flag || environment === "mock"
}

/** The account host owns sign-in, roles and person-authenticated issue operations. */
//@ verify
//@ ensures \result == (path == "/api/wiki" || path == "/api/issues" || path.startsWith("/api/auth/") || path.startsWith("/api/roles"))
export function accountRoute(path: string): boolean {
  return path === "/api/wiki" || path === "/api/issues" || path.startsWith("/api/auth/") || path.startsWith("/api/roles")
}

/** A history write's declared length: empty (a chunked body declares none) up to `maximum` bytes. */
//@ verify
//@ ensures \result == (length >= 0 && length <= maximum)
export function validWriteLength(length: number, maximum: number): boolean {
  return length >= 0 && length <= maximum
}

/** A write's HTTP status: 409 for a refusal, else 200. */
//@ verify
//@ ensures refused ==> \result == 409
//@ ensures !refused ==> \result == 200
export function writeStatus(refused: boolean): number {
  return refused ? 409 : 200
}

/** Whether a request goes to the Factory's own origin, so it may carry the person's session: never another host. */
//@ verify
//@ ensures \result == url.startsWith(origin + "/")
//@ ensures \result ==> url.length > origin.length && url.charCodeAt(origin.length) == 47
export function sameOriginRequest(url: string, origin: string): boolean {
  return url.startsWith(origin + "/")
}

/** The cookie a stored session gives the Factory's origin: its own, when it was stored for that origin and is valid. */
//@ verify
//@ ensures \result == (storedOrigin == origin && valid ? cookie : "")
export function sessionCookie(storedOrigin: string, origin: string, valid: boolean, cookie: string): string {
  return storedOrigin === origin && valid ? cookie : ""
}
