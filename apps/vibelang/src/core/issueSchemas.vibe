// GitHub projection and action protocol; no credential, role or actor is accepted in an action payload.
import { DurableText } from "./wire.vibe"
export const IssueOperation = Schema.Literals(["read", "new", "comment", "link", "split", "commit", "uncommit", "propose", "accept", "decline", "draft", "spec-revise", "spec-review"])
export const IssueNote = Schema.Struct({ age: Schema.String.pipe(Schema.withDecodingDefaultKey(succeed(""))), author: Schema.String, text: Schema.String, event: Schema.Boolean })
export const IssueRecord = Schema.Struct({
  number: Schema.Number, githubId: Schema.Number, title: Schema.String, body: Schema.String, author: Schema.String,
  age: Schema.String, state: Schema.Literals(["open", "closed"]), labels: Schema.Array(Schema.String), parent: Schema.Number,
  task: Schema.Literals(["", "Queued", "Running", "Done"]), assignee: Schema.String,
  approvedBy: Schema.optionalKey(Schema.String), approvedAt: Schema.optionalKey(Schema.String),
  vip: Schema.Literals(["", "In review", "Accepted", "Declined"]), review: Schema.String, path: Schema.String,
  comments: Schema.Number, notes: Schema.Array(IssueNote),
})
export const SpecificationReviewer = Schema.Literals(["astra", "sol", "fable", "opus"])
export const SpecificationReview = Schema.Struct({ review: Schema.optionalKey(Schema.String), verdict: Schema.Literals(["", "LGTM", "Changes requested"]), grade: Schema.String, revision: Schema.Number, link: Schema.String })
export const Specification = Schema.Struct({ revision: Schema.Number, text: Schema.String, astra: SpecificationReview, sol: SpecificationReview, fable: SpecificationReview, opus: SpecificationReview })
export const SpecificationEvent = Schema.Struct({ review: Schema.optionalKey(Schema.String), revision: Schema.Number, event: Schema.Literals(["reset", "revision", "review"]), reviewer: Schema.String, verdict: Schema.String, grade: Schema.String, link: Schema.String, at: Schema.String })
export const IssueRequest = Schema.Struct({
  revision: Schema.optionalKey(Schema.Number), reviewer: Schema.optionalKey(SpecificationReviewer),
  resumeRecovery: Schema.optionalKey(DurableText), resumeOp: Schema.optionalKey(DurableText), resumeKey: Schema.optionalKey(DurableText), recovery: Schema.optionalKey(DurableText), op: IssueOperation, number: Schema.Number, parent: Schema.Number, title: DurableText, text: DurableText,
  assignee: DurableText, example: DurableText, prior: DurableText, key: DurableText,
})
export const IssuesState = Schema.Struct({ specification: Schema.optionalKey(Specification), specificationHistory: Schema.optionalKey(Schema.Array(SpecificationEvent)), saved: Schema.optionalKey(Schema.Struct({ request: IssueRequest, status: Schema.Literals(["running", "failed", "completed"]), unwritten: Schema.Boolean, selected: Schema.Number })), absoluteDates: Schema.optionalKey(Schema.Boolean), reviewers: Schema.optionalKey(Schema.Array(Schema.String)), seq: Schema.Number, connected: Schema.optionalKey(Schema.Boolean), selected: Schema.optionalKey(Schema.Number), assignees: Schema.optionalKey(Schema.Array(Schema.Struct({ login: Schema.String, label: Schema.String }))), items: Schema.Array(IssueRecord), role: Schema.optionalKey(Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])), stale: Schema.optionalKey(Schema.Number), draft: Schema.optionalKey(Schema.Struct({ title: Schema.String, summary: Schema.String, example: Schema.String, prior: Schema.String })) })

export type IssueRequest = typeof IssueRequest.Type
export schema error IssueFailure { reason: string; unwritten?: boolean; code?: string; retryAfterMillis?: number }
export interface IssuesApi {
  readonly read: () => typeof IssuesState.Type!IssueFailure
  readonly act: (request: IssueRequest) => typeof IssuesState.Type!IssueFailure
}

/** Person-readable Markdown, persisted in the repository, one feature per review. */
export function vipDocument(request: IssueRequest): string {
  return `# ${request.title.trim()}\n\n## Summary\n\n${request.text.trim()}\n\n## Example\n\n\`\`\`vibe\n${request.example.trim()}\n\`\`\`\n\n## Prior art\n\n${request.prior.trim()}\n`
}

/** The tracking issue mirrors the designer's compact proposal; the canonical repository document keeps its headings. */
export function vipIssueBody(request: IssueRequest): string {
  return `${request.text.trim()}\n\n\`\`\`vibe\n${request.example.trim()}\n\`\`\`\n\n${request.prior.trim()}`
}
