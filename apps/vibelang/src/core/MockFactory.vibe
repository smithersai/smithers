import { firstUndispatched } from "./flowDecision.vibe"
import * as MockAccounts from "./MockAccounts.vibe"
// The factory with no backend and no model (wiki/decisions/0004-mock-mode.md). It runs the live factory's flows
// (flows.vibe, 0011) on `@smthrs/engine`'s engine in memory, one engine per conversation as the live one has one per
// conversation object: a post is a `vibelang/Post` execution whose steps record it and dispatch its reply, and each
// reply is a `vibelang/Reply` execution, the scripted agent's (mockReplies.vibe), started oldest post first. A tour is
// a `vibelang/Tour` execution whose scripted agent opens the same stops and says the script's words (0014).
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { Digest, SecureRandom } from "effect/crypto"
import { Action, FlowRuntime } from "@smthrs/flow"
import { apply, decide, empty, isTouring, type Conversation, type Decision, type Event, type Intent } from "./conversation.vibe"
import { Factory, type Mode, Refused, Unavailable } from "./Factory.vibe"
import {
  EndTour, endsTour, patient, Post, postRegistration, Posts, Reply, replyIdOf, StartTour, Tour, toured, touring, tourRegistration,
  Tours, unanswered, walk,
} from "./flows.vibe"
import { Mythical } from "../history/MythicalHistory.vibe"
import type { Principal } from "../history/roles.vibe"
import { type HistoryPages, show } from "../history/tools.vibe"
import { matches } from "./mockDecision.vibe"
import { makeMockSandboxes } from "./sandboxMock.vibe"
import type { Role } from "./sandboxDecision.vibe"
import { SandboxPolicy } from "./sandboxPolicy.vibe"
import { chunks, HISTORY_WORDS, historyReply, mockReply, TOUR } from "./mockReplies.vibe"

/** Who the scripted agent reads the mythical history as: the agent for a person who has not signed in. */
const MOCK_AGENT: Principal = { role: "viewer", name: "Guest", agent: true }

/** One conversation's sequencer state and every event it numbered. */
interface State {
  readonly conversation: Conversation
  readonly log: ReadonlyArray<Event>
}

/** A room owns its acceptance lock, its engine and the signal its reply worker waits on. */
interface Room {
  readonly state: Ref.Ref<State>
  readonly engine: FlowRuntime.FlowRuntime["Service"]
}

/** A numbered event and the conversation it belongs to. */
interface Published {
  readonly conversation: string
  readonly event: Event
}

/** How long the scripted agent waits between the pieces of its reply. */
export const MOCK_DELTA_DELAY = "25 millis"

/** Reply starts that yield to a concurrently accepted tour; no conversation or text labels. */
const replyStarts = Metric.counter("vibelang_mock_reply_starts", { incremental: true })

/** A tour won the acceptance race; the same durable reply waits for it. */
schema error ReplyBusy {}

/** The scripted agent's reply to `post`, `vibelang/Reply`'s mock body: every record is a step. */
effect function scripted(
  engine: FlowRuntime.FlowRuntime["Service"],
  state: Ref.Ref<State>,
  record: (intent: Intent) => Decision!!,
  post: string,
  history: HistoryPages!!,
  conversation: string,
  sandboxTools: Pick<Factory.Shape, "startSandbox">,
) {
  const id = replyIdOf(post)
  const started = try Action.make({
    name: "vibelang/reply/start",
    success: Schema.Boolean,
    error: ReplyBusy,
    retryPolicy: patient,
    execute: effect {
      const decision = try record({ type: "StartReply", id, inReplyTo: post })
      if (!decision.ok && decision.refusal === "busy") {
        const tour = touring((try Ref.get(state)).conversation)
        // The actor is awaiting this reply. Run the already accepted tour as a child so it can settle naturally;
        // the engine then retries this same start action, preserving the post's reply execution and ordering.
        if (tour !== "") try Effect.orDie(engine.execute(Tour, { executionId: `tour/${tour}`, payload: { tour } }))
        try Metric.update(Metric.withAttributes(replyStarts, { outcome: "contended" }), 1)
        try Effect.logInfo("vibelang.reply.start").pipe(Effect.annotateLogs({ outcome: "contended" }))
        throw new ReplyBusy()
      }
      return decision.ok
    },
  })
  if (!started) return null
  const prompt = (try Ref.get(state)).conversation.entries.find((entry) => entry.id === post)?.text ?? ""
  // Asked about the mythical history, the scripted agent reads it through the live agent's tool, as a step.
  const text = /\b(start|run|use|spin up)\b.*\bsandbox\b/i.test(prompt) ? (effect {
    const snapshot = try sandboxTools.startSandbox(conversation, `agent-${id}`)
    return `Started ${snapshot.id}.`
  } catch () => "Couldn't start a sandbox") : matches(prompt.toLowerCase(), HISTORY_WORDS)
    ? try Action.make({
      name: "vibelang/history/show",
      success: Schema.String,
      execute: effect {
        const page = show(try history, { what: "outline" }) catch () => undefined
        return page !== undefined && "epics" in page ? historyReply(page) : "The history can't be reached."
      },
    })
    : mockReply(prompt)
  const pieces = chunks(text)
  for (let index = 0; index < pieces.length; index++) {
    try sleep(MOCK_DELTA_DELAY)
    try Action.make({ name: `vibelang/reply/append/${index}`, execute: Effect.asVoid(record({ type: "AppendReply", id, text: pieces[index]! })) })
  }
  try Action.make({ name: "vibelang/reply/finish", execute: Effect.asVoid(record({ type: "FinishReply", id })) })
  return null
}

effect function cryptoOf() {
  provide WebCrypto.layer {
    return { digest: try Digest.Digest, random: try SecureRandom.SecureRandom }
  }
}

/** The mock factory. Each layer build is its own world; closing that layer ends all work and subscriptions. */
export function mockFactoryFor(role?: Role) {
return Layer.effect(Factory, effect {
  const scope = try Effect.scope
  const accounts = try MockAccounts.make()
  if (role !== undefined) try Effect.orDie(accounts.choose(role))
  const rooms = try Ref.make(new Map<string, Room>())
  const published = try acquireRelease(PubSub.unbounded<Published>(), PubSub.shutdown)
  const ids = try Ref.make(0)
  const executions = try Ref.make(0)
  const sandboxAccounts = new Map<string, Pick<Factory.Shape, "sandbox" | "startSandbox" | "stopSandbox" | "sandboxCommand">>()
  const sandboxLock = try Semaphore.make(1)
  const sandboxForOwner = (owner: string) => Semaphore.withPermits(sandboxLock, 1)(effect {
    let service = sandboxAccounts.get(owner)
    if (service === undefined) {
      const policy = Layer.succeed(SandboxPolicy, { current: effect () => ({ owner, role: try accounts.role(owner) }) })
      service = try Effect.provideService(makeMockSandboxes(try accounts.role(owner), policy), Scope.Scope, scope)
      sandboxAccounts.set(owner, service)
    }
    return service
  })
  const sandboxFor = effect {
    const person = try Effect.mapError(accounts.current(), () => new Unavailable({ reason: "account-unavailable" }))
    return try sandboxForOwner(person.id)
  }
  const sandboxes: Pick<Factory.Shape, "sandbox" | "startSandbox" | "stopSandbox" | "sandboxCommand"> = {
    sandbox: effect (conversation) => try (try sandboxFor).sandbox(conversation),
    startSandbox: effect (conversation, operationId) => try (try sandboxFor).startSandbox(conversation, operationId),
    stopSandbox: effect (conversation, operationId, generation) => try (try sandboxFor).stopSandbox(conversation, operationId, generation),
    sandboxCommand: effect (conversation, operationId, command, generation) => try (try sandboxFor).sandboxCommand(conversation, operationId, command, generation),
  }
  // The engine digests what it journals, with the platform's Web Crypto.
  const crypto = try cryptoOf()
  // The mythical history the scripted agent reads, built (and its snapshot downloaded) only when first asked about.
  const history = try Effect.cached(effect {
    const { MockMythical } = try promise(() => import("../history/MockMythical.vibe"))
    const reader: HistoryPages = Context.get(try Layer.buildWithScope(MockMythical(MOCK_AGENT), scope), Mythical)
    return reader
  })
  // This lock only creates rooms. Acceptance and replies use each room's own lock and engine.
  const registry = try Semaphore.make(1)
  try Scope.addFinalizer(scope, Semaphore.withPermits(registry, 1)(Effect.void))

  effect function nextId(prefix: string) {
    const n = try Ref.updateAndGet(ids, (value) => value + 1)
    return `${prefix}${n}`
  }

  /** The conversation's sequencer: `decide` and `apply` under the room's lock, then publish. */
  function recorder(state: Ref.Ref<State>, gate: Semaphore.Semaphore, conversation: string) {
    return (intent: Intent) => Semaphore.withPermits(gate, 1)(Effect.uninterruptible(effect {
      const decision = try Ref.modify(state, (current): readonly [Decision, State] => {
        const decided = decide(current.conversation, intent)
        if (!decided.ok) return [decided, current]
        return [decided, { conversation: apply(current.conversation, decided.event), log: [...current.log, decided.event] }]
      })
      if (decision.ok) try PubSub.publish(published, { conversation, event: decision.event })
      return decision
    }))
  }

  /**
   * Runs the conversation's tour in its own `vibelang/Tour` execution, then answers every unanswered post, oldest
   * first, each in its own `vibelang/Reply` execution; each at most once.
   */
  effect function answer(state: Ref.Ref<State>, engine: FlowRuntime.FlowRuntime["Service"], wake: Queue.Queue<void>, activeTour: Ref.Ref<string>) {
    const dispatched = new Set<string>()
    while (true) {
      try Queue.take(wake)
      while (true) {
        const tour = touring((try Ref.get(state)).conversation)
        if (tour !== "" && !dispatched.has(`tour/${tour}`)) {
          dispatched.add(`tour/${tour}`)
          try Ref.set(activeTour, tour)
          try ensuring(Effect.orDie(engine.execute(Tour, { executionId: `tour/${tour}`, payload: { tour } })), Ref.set(activeTour, ""))
          continue
        }
        const posts = unanswered((try Ref.get(state)).conversation)
        const index = firstUndispatched(posts, dispatched)
        if (index === posts.length) break
        const post = posts[index]!
        dispatched.add(post)
        try Effect.orDie(engine.execute(Reply, { executionId: `reply/${post}`, payload: { post } }))
      }
    }
  }

  effect function openRoom(conversation: string) {
    return try Semaphore.withPermits(registry, 1)(Effect.uninterruptible(effect {
      if (scope.state._tag === "Closed") throw new Unavailable({ reason: "Factory closed" })
      const all = try Ref.get(rooms)
      const existing = all.get(conversation)
      if (existing !== undefined) return existing
      const state = try Ref.make<State>({ conversation: empty, log: [] })
      const gate = try Semaphore.make(1)
      const wake = try Scope.provide(scope)(acquireRelease(Queue.sliding<void>(1), Queue.shutdown))
      const record = recorder(state, gate, conversation)
      // Recorded with the accepted post; delayed replies never borrow the currently selected identity.
      const postOwners = new Map<string, string>()
      const posts: Posts.Shape = {
        record: effect (clientId: string, name: string, text: string, owner?: string) => {
          const id = try nextId("m")
          const decision = try record({ type: "Post", id, clientId, name, text })
          if (decision.ok) postOwners.set(id, owner ?? "")
          return decision.ok ? null : decision.refusal
        },
        dispatch: () => Effect.asVoid(Queue.offer(wake, undefined)),
      }
      const cryptoLayer = Layer.mergeAll(Layer.succeed(Digest.Digest, crypto.digest), Layer.succeed(SecureRandom.SecureRandom, crypto.random))
      const engine = Context.get(try Layer.buildWithScope(FlowEngine.layerMemory.pipe(Layer.provide(cryptoLayer)), scope), FlowRuntime.FlowRuntime)
      const activeTour = try Ref.make("")
      const accepted = (intent: Intent) => Effect.map(record(intent), (decision) => decision.ok)
      const tours: Tours.Shape = {
        start: effect () => {
          const decision = try record({ type: "StartTour", id: try nextId("t") })
          return decision.ok ? null : decision.refusal
        },
        dispatch: () => Effect.asVoid(Queue.offer(wake, undefined)),
        end: effect () => {
          const decision = try record({ type: "EndTour", id: touring((try Ref.get(state)).conversation) })
          return decision.ok ? null : decision.refusal
        },
        wake: effect () => {
          const tour = try Ref.get(activeTour)
          if (tour !== "") try engine.resume(Tour, `tour/${tour}`)
        },
        running: (tour: string) => Effect.map(Ref.get(state), (current) => isTouring(current.conversation, tour)),
        open: (tour: string, url: string) => accepted({ type: "OpenPane", id: tour, url }),
        say: effect (tour: string, text: string) => {
          const entry = (try Ref.get(state)).conversation.entries.find((entry) => entry.id === tour)
          return try accepted({ type: "AppendReply", id: tour, text: entry?.text ? `\n\n${text}` : text })
        },
        finish: (tour: string, reason: string) =>
          Effect.asVoid(record(reason === "" ? { type: "FinishReply", id: tour } : { type: "FailReply", id: tour, reason })),
        // Subscribe before reading the state, so the event that ends the tour can't fall between.
        ended: (tour: string) => scoped(effect {
          const live = try PubSub.subscribe(published)
          if (!isTouring((try Ref.get(state)).conversation, tour)) return
          try Stream.runDrain(Stream.fromSubscription(live).pipe(
            Stream.takeUntil((item) => item.conversation === conversation && endsTour(item.event, tour)),
          ))
        }),
      }
      const flows = Layer.mergeAll(
        postRegistration,
        tourRegistration,
        Layer.effectDiscard(effect {
          const engine = try FlowRuntime.FlowRuntime
          try engine.register(Reply, (payload) => Effect.orDie(withSpan(scripted(engine, state, record, payload.post, history, conversation, {
            startSandbox: effect (room, operationId) => try (try sandboxForOwner(postOwners.get(payload.post) ?? "")).startSandbox(room, operationId),
          }), "vibelang.reply")))
          try engine.register(Tour, (payload) => withSpan(toured(payload.tour, walk(payload.tour, TOUR.map((stop) => stop.words))), "vibelang.tour"))
        }),
      ).pipe(
        Layer.provide(Layer.succeed(FlowRuntime.FlowRuntime, engine)),
        Layer.provide(Layer.mergeAll(Layer.succeed(Posts, posts), Layer.succeed(Tours, tours))),
        Layer.provide(Layer.mergeAll(Layer.succeed(Digest.Digest, crypto.digest), Layer.succeed(SecureRandom.SecureRandom, crypto.random))),
      )
      try Layer.buildWithScope(flows, scope)
      const room: Room = { state, engine }
      try Ref.set(rooms, new Map(all).set(conversation, room))
      try Effect.forkIn(answer(state, engine, wake, activeTour), scope)
      // Wait for any already-accepted commit/publish before disposal completes. New calls see Closed.
      try Scope.addFinalizer(scope, Semaphore.withPermits(gate, 1)(Effect.void))
      return room
    }))
  }

  const mode: Mode = "mock"
  return {
    mode,
    accounts,
    post: effect (conversation: string, clientId: string, name: string, text: string) => {
      const identity = try Effect.orDie(accounts.current())
      const room = try openRoom(conversation)
      const executionId = `post/${try Ref.updateAndGet(executions, (value) => value + 1)}`
      const refusal = try Effect.orDie(room.engine.execute(Post, { executionId, payload: { clientId, name: identity.login || name, text, owner: identity.id } }))
      if (refusal !== null) throw new Refused({ refusal })
      try Effect.orDie(accounts.participated(identity.id))
    },
    tour: effect (conversation: string) => {
      const room = try openRoom(conversation)
      const executionId = `start-tour/${try Ref.updateAndGet(executions, (value) => value + 1)}`
      const refusal = try Effect.orDie(room.engine.execute(StartTour, { executionId, payload: {} }))
      if (refusal !== null) throw new Refused({ refusal })
    },
    endTour: effect (conversation: string) => {
      const room = try openRoom(conversation)
      const executionId = `end-tour/${try Ref.updateAndGet(executions, (value) => value + 1)}`
      const refusal = try Effect.orDie(room.engine.execute(EndTour, { executionId, payload: {} }))
      if (refusal !== null) throw new Refused({ refusal })
    },
    ...sandboxes,
    read: effect (conversation: string, after: number) => {
      // Reading never opens a room: a conversation nobody posted to or followed is empty.
      const room = (try Ref.get(rooms)).get(conversation)
      if (room === undefined) return { seq: 0, entries: [] }
      const state = try Ref.get(room.state)
      const touched = new Set(state.log.filter((event) => event.seq > after).map((event) => event.id))
      return { seq: state.conversation.seq, entries: state.conversation.entries.filter((entry) => touched.has(entry.id)) }
    },
    events: (conversation: string, after: number) =>
      Stream.unwrap(effect {
        const room = try openRoom(conversation)
        // Subscribe before reading the log, so no event falls between the replay and the live tail.
        const live = try PubSub.subscribe(published)
        const state = try Ref.get(room.state)
        const log = state.log.filter((event) => event.seq > after)
        const replayedTo = log.length === 0 ? after : log[log.length - 1]!.seq
        return Stream.concat(
          Stream.fromIterable(log),
          Stream.fromSubscription(live).pipe(
            Stream.filter((item) => item.conversation === conversation && item.event.seq > replayedTo),
            Stream.map((item) => item.event),
          ),
        )
      }),
  }
})

}
export const MockFactory = mockFactoryFor()
