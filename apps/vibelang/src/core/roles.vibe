import { Conversation } from "./schemas.vibe"
import type { Action, Role, SignedRole, Event } from "./conversation.vibe"

/** Session identity is separate from its current project grant. */
export schema Identity {
  readonly id: string
  readonly login: string
  readonly role: "viewer" | "new" | "community" | "contributor" | "maintainer"
  readonly available?: boolean
  readonly ledger?: Conversation
}
export const viewer: Identity = { id: "", login: "", role: "viewer" }

/** The authorization seam future workflows can implement; hosts supply the authenticated actor. */
export service Policy {
  authorize(actor: string, action: Action): void!Denied
}

/** A role check failed; transport errors are never permission grants. */
export error Denied { action: string; least: Role }

/** The identity and grants surface of the Factory core. Mock selection is a product-only method. */
export service Accounts {
  current(): Identity!AccountUnavailable
  members(): ReadonlyArray<Identity>!(AccountUnavailable | Denied)
  grant(id: string, role: SignedRole): void!(AccountUnavailable | Denied)
  signOut(): void!AccountUnavailable
  choose(role: Role): Identity!AccountUnavailable
  participated(personId?: string): void!AccountUnavailable
  events(after: number): Stream.Stream<Event, AccountUnavailable>
}
export error AccountUnavailable { reason: string }
