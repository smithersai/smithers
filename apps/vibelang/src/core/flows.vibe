// The conversation's durable flows (rulings VL-11; wiki/decisions/0011-post-flow.md): every action the factory takes on
// a conversation is a `@smthrs/flow` step. Both backends register these same declarations: the live one on the engine
// in each conversation's Durable Object (worker/Objects.vibe), the mock one on the engine in memory (MockFactory.vibe).
//
//   vibelang/Post        record ──▶ dispatch     a person's post; its caller answers once the flow settles
//   vibelang/Reply       the agent's answer to one post, started by a Post's dispatch step (worker/Reply.vibe)
//   vibelang/StartTour   record ──▶ dispatch     a person's Learn more (wiki/decisions/0014-agent-tour.md)
//   vibelang/Tour        the agent's tour: it opens docs pages (vibelang/docs/open) and says what each is
//                        (vibelang/tour/say), raced against the person ending it
//   vibelang/EndTour     end                     a person's Escape: the tour stops at once
//
// The steps reach the conversation's one state machine (conversation.vibe) through the `Posts` and `Tours` services;
// nothing here decides anything.
import { Action, DurableClock, Flow, FlowRuntime, RetryPolicy } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { canReplyTo, type Conversation, type Event, isTour, type Refusal } from "./conversation.vibe"
import { dispatches, endsTourEvent, readingHold } from "./flowDecision.vibe"
import { RefusalReason } from "./schemas.vibe"

/** A contended reply or remote object waits through the engine's journaled retry policy. */
export const patient = RetryPolicy.make({ initialMs: 500, factor: 2, maxMs: 60_000, jitterRatio: 0.2 })

/** A post's answer: `null` once the sequencer recorded it, else why it refused. */
export const PostAnswer = Schema.NullOr(RefusalReason)

export const Post = Flow.make("vibelang/Post", {
  description: "Records a person's post in its conversation, then makes sure the agent answers it.",
  modelInvocable: false,
  payload: { clientId: Schema.String, name: Schema.String, text: Schema.String },
  success: PostAnswer,
  body: () => Node.succeed(null),
})

export const Reply = Flow.make("vibelang/Reply", {
  description: "The VibeLang agent answers one person's post in its conversation.",
  modelInvocable: false,
  payload: { post: Schema.String },
  success: Schema.Null,
  body: () => Node.succeed(null),
})

/** The reply that answers a post, unchanged across retries. Slice lowering is tracked in decision 0018. */
export function replyIdOf(post: string): string {
  return `r${post.slice(1)}`
}

/** The person posts no reply targets, oldest first, when the agent isn't replying: the ones to answer next. */
export function unanswered(conversation: Conversation): ReadonlyArray<string> {
  if (conversation.agent === "working") return []
  return conversation.entries
    .filter((entry) => entry.author === "person" && canReplyTo(conversation.entries, entry.id))
    .map((entry) => entry.id)
}

/** The conversation's sequencer, as a Post's steps reach it. */
export service Posts {
  /** Runs `decide` and `apply` on the post and stores its event: `null` once recorded, else the refusal. */
  record(clientId: string, name: string, text: string): (Refusal | null)!!
  /** Starts the reply flow of the oldest post with no reply, unless one runs. */
  dispatch(): void!!
}

/** Posts by outcome: `accepted` or the refusal. */
export const posts = Metric.counter("vibelang_posts", {
  description: "Person posts, by outcome",
  incremental: true,
})

/** A Post's body: record the post; once recorded, dispatch its reply. The answer is the record step's. */
export effect function posted(payload: { readonly clientId: string; readonly name: string; readonly text: string }) {
  const sequencer = try Posts
  const answer = try Action.make({
    name: "vibelang/post/record",
    success: PostAnswer,
    execute: sequencer.record(payload.clientId, payload.name, payload.text),
  })
  if (dispatches(answer)) try Action.make({ name: "vibelang/post/dispatch", execute: sequencer.dispatch() })
  const outcome = answer ?? "accepted"
  try Metric.update(Metric.withAttributes(posts, { outcome }), 1)
  // The outcome only: never the post's text, its client id or its author's name.
  try Effect.logInfo("vibelang.post").pipe(Effect.annotateLogs({ outcome }))
  return answer
}

/** Registers `Post` with the engine; its steps reach the sequencer through `Posts`. */
export const postRegistration = Layer.effectDiscard(effect {
  const engine = try FlowRuntime.FlowRuntime
  try engine.register(Post, (payload) => withSpan(posted(payload), "vibelang.post"))
})

// ── the tour (wiki/decisions/0014-agent-tour.md) ─────────────────────────────────────────────────────────────────

/** VibeLang's docs, the only site the tour's pane shows. */
export const DOCS_ORIGIN = "https://vibelang.sh"

/** The docs page at `path`, such as `/setup`, or `undefined` when `path` is not a page of the docs site. */
export function docsPage(path: string): string | undefined {
  return /^\/[a-z0-9\-\/]*$/.test(path) && !path.includes("//") ? DOCS_ORIGIN + path : undefined
}

/** One stop of the tour: the docs page the agent opens, and what it says about it there. */
export interface Stop {
  readonly path: string
  readonly topic: string
}

/** The tour's stops, in order. The live agent's instruction names them; the mock speaks a script for each. */
export const STOPS: ReadonlyArray<Stop> = [
  { path: "/", topic: "what VibeLang is: Effect as its own language, in TypeScript syntax" },
  { path: "/getting-started/002-why-effect", topic: "why Effect: typed errors, services and layers, structured concurrency" },
  { path: "/vibelang-features/115-cheat-sheet", topic: "the syntax, each form beside the Effect TypeScript it compiles to" },
  { path: "/setup", topic: "how to start a project" },
  { path: "/vips", topic: "how the language changes, through VIPs, and this site: VibeLang's open-source coding factory" },
]

/** The conversation's sequencer, as the tour's steps reach it. */
export service Tours {
  /** Runs `decide` and `apply` on a new tour and stores its event: `null` once recorded, else the refusal. */
  start(): (Refusal | null)!!
  /** Starts the running tour's `vibelang/Tour` flow, unless it runs. */
  dispatch(): void!!
  /** Ends the running tour: `null` once recorded, else the refusal (`not-replying` when none runs). */
  end(): (Refusal | null)!!
  /** Wakes a parked tour after its end was recorded. */
  wake(): void!!
  /** Whether this tour still owns the conversation. */
  running(tour: string): boolean!!
  /** Shows `url` in the docs pane, while `tour` runs. */
  open(tour: string, url: string): boolean!!
  /** Adds `text` to what `tour` said, while it runs. */
  say(tour: string, text: string): boolean!!
  /** Settles `tour` as finished, or as failed with `reason` when it isn't `""`. */
  finish(tour: string, reason: string): void!!
  /** Completes once `tour` no longer runs: it finished, failed, or the person ended it. */
  ended(tour: string): void!!
}

/** Whether `event` stops the tour `tour`: it finished, failed, or the person ended it. */
export function endsTour(event: Event, tour: string): boolean {
  return endsTourEvent(event.type, event.id, tour)
}

/** The running tour of `conversation`: its id, `""` when none runs. */
export function touring(conversation: Conversation): string {
  return conversation.agent === "working" && isTour(conversation.entries, conversation.replying) ? conversation.replying : ""
}

export const StartTour = Flow.make("vibelang/StartTour", {
  description: "Starts the agent's tour of VibeLang in its conversation, then makes sure it runs.",
  modelInvocable: false,
  payload: {},
  success: PostAnswer,
  body: () => Node.succeed(null),
})

export const Tour = Flow.make("vibelang/Tour", {
  description: "The VibeLang agent tours VibeLang's docs: it opens each page in the docs pane and says what it is.",
  modelInvocable: false,
  payload: { tour: Schema.String },
  success: Schema.Null,
  body: () => Node.succeed(null),
})

export const EndTour = Flow.make("vibelang/EndTour", {
  description: "Ends the agent's tour at once; the person keeps the conversation and the docs pane.",
  modelInvocable: false,
  payload: {},
  success: PostAnswer,
  body: () => Node.succeed(null),
})

/** Tour steps, by step (`start`, `end`, `wake`, `open`, `say`, `hold`, `run`) and outcome. */
export const tourSteps = Metric.counter("vibelang_tour_steps", {
  description: "Tour steps, by step and outcome",
  incremental: true,
})

/** Logs and counts one tour step by its outcome only: never what the agent said or a person's words. */
effect function counted(step: string, outcome: string) {
  try Metric.update(Metric.withAttributes(tourSteps, { step, outcome }), 1)
  try Effect.logInfo(`vibelang.tour.${step}`).pipe(Effect.annotateLogs({ outcome }))
}

/** StartTour's body: record the tour; once recorded, dispatch it. The answer is the record step's. */
export effect function startTour() {
  const tours = try Tours
  const answer = try Action.make({ name: "vibelang/tour/record", success: PostAnswer, execute: tours.start() })
  if (dispatches(answer)) try Action.make({ name: "vibelang/tour/dispatch", execute: tours.dispatch() })
  try counted("start", answer ?? "accepted")
  return answer
}

/** EndTour's body: end the running tour. */
export effect function endTour() {
  const tours = try Tours
  const answer = try Action.make({ name: "vibelang/tour/end", success: PostAnswer, execute: tours.end() })
  if (answer === null) try Action.make({ name: "vibelang/tour/wake", execute: withSpan(effect { try tours.wake(); try counted("wake", "requested") }, "vibelang.tour.wake") })
  try counted("end", answer ?? "accepted")
  return answer
}

/** `vibelang/docs/open`'s body: shows the docs page at `path` in the pane while `tour` runs. */
export effect function openDocs(tour: string, path: string) {
  const tours = try Tours
  const page = docsPage(path)
  const opened = page === undefined ? false : try tours.open(tour, page)
  try counted("open", page === undefined ? "outside-docs" : opened ? "opened" : "ended")
  return opened
}

/** `vibelang/tour/say`'s body: adds `text` to what `tour` said while it runs. */
export effect function say(tour: string, text: string) {
  const tours = try Tours
  const words = text.trim().replace(/\s+/g, " ")
  const said = words === "" ? false : try tours.say(tour, words)
  try counted("say", words === "" ? "empty" : said ? "said" : "ended")
  return said
}

/** Whole-stop narration, shared by the mock and live speakers. */
export function readingMillis(text: string): number {
  const words = text.trim() === "" ? 0 : text.trim().split(/\s+/).length
  return readingHold(words)
}

/** A stop is a journaled paragraph followed by a durable reading hold, including the final stop. */
export effect function narrate(tour: string, text: string, stop = 0) {
  const said = try Action.make({ name: `vibelang/tour/say/${stop}`, success: Schema.Boolean, execute: say(tour, text) })
  if (!said) return false
  try withSpan(effect {
    try counted("hold", "started")
    try DurableClock.sleep({ name: `vibelang/tour/read/${stop}`, duration: readingMillis(text), inMemoryThreshold: 0 })
    try counted("hold", "finished")
  }, "vibelang.tour.hold")
  return true
}

/** The shared tour controller: only it advances pages, after each paragraph's reading hold. */
export effect function walk(tour: string, words: ReadonlyArray<string>) {
  const tours = try Tours
  for (let stop = 0; stop < STOPS.length; stop++) {
    const opened = try Action.make({ name: `vibelang/tour/open/${stop}`, success: Schema.Boolean, execute: openDocs(tour, STOPS[stop]!.path) })
    if (!opened || !(try narrate(tour, words[stop]!, stop))) return
  }
  try Action.make({ name: "vibelang/tour/finish", execute: tours.finish(tour, "") })
}

/**
 * The tour's body: `speak`, the agent, narrates until it is done or the person ends the tour, whichever comes first.
 * Ending it interrupts the agent where it is; what it said stays.
 */
export effect function toured<E, R>(tour: string, speak: void!E!R) {
  const tours = try Tours
  if (!(try tours.running(tour))) return null
  const outcome = try.race [Effect.as(speak, "finished"), Effect.as(tours.ended(tour), "ended")]
  try counted("run", outcome)
  return null
}

/** Registers StartTour and EndTour with the engine; their steps reach the sequencer through `Tours`. */
export const tourRegistration = Layer.effectDiscard(effect {
  const engine = try FlowRuntime.FlowRuntime
  try engine.register(StartTour, () => withSpan(startTour(), "vibelang.tour.start"))
  try engine.register(EndTour, () => withSpan(endTour(), "vibelang.tour.end"))
})
