/** The event line an edit adds to its issue's notes. */
function noteOf(request: IssueRequest): string {
  switch (request.op) {
    case "commit": return `committed this as a task and assigned ${request.assignee}`
    case "uncommit": return "uncommitted this task"
    case "link": return `linked this under #${request.parent}`
    case "accept": return "accepted this VIP"
    case "decline": return "declined this VIP"
    default: return ""
  }
}

export interface FixturePerson { readonly id: string; readonly login: string; readonly role: Role; readonly kind?: "person" | "agent" }
export type FixtureIdentity = Role | (() => FixturePerson!!)
effect function personOf(identity: FixtureIdentity): FixturePerson!! {
  if (typeof identity === "string") return { id: "fixture-" + identity, login: identity === "maintainer" ? "will" : "jun", role: identity }
  return try identity()
}

/** Local fixture mode's identity is selected by its host. Live requests never accept this argument. */
export interface FixtureStore { readonly state: Ref.Ref<typeof import("./issueSchemas.vibe").IssuesState.Type>; readonly lock: Semaphore.Semaphore }
export effect function makeIssueStore(): FixtureStore!! {
  return { state: try Ref.make<typeof import("./issueSchemas.vibe").IssuesState.Type>({ ...emptyIssues, items: fixtureIssues, specification: fixtureSpecification, specificationHistory: fixtureSpecificationHistory }), lock: try Semaphore.make(1) }
}

export effect function fixtureHost(identity: FixtureIdentity, state: Ref.Ref<typeof import("./issueSchemas.vibe").IssuesState.Type>, lock: Semaphore.Semaphore) {
  const host: IssueHost.Shape = {
    perform: (request) => lock.withPermit(effect {
      const person = try personOf(identity)
      const instance = try FlowRuntime.FlowInstance
      if (!instance.executionId.startsWith(`issues/${person.id || "public"}/`) || !issuePermission(person.role, request.op)) throw new IssueFailure({ reason: "forbidden" })
      const before = try Ref.get(state)
      if (request.op === "read") return before
      if (agentRefused(request.op, person.kind ?? "person")) throw new IssueFailure({ reason: "forbidden" })
      if (request.op === "spec-revise" || request.op === "spec-review") {
        const next = try performSpecification(before, request)
        try Ref.set(state, next)
        return next
      }
      if (request.key === "") throw new IssueFailure({ reason: "invalid", unwritten: true })
      if (request.op === "draft") return { ...before, draft: fixtureDraft(request.title.trim(), request.text.trim(), request.example.trim(), request.prior.trim()) }
      const index = fixtureIssueIndex(before.items, request.number)
      const issue = index < 0 ? undefined : before.items[index]
      const creating = issueCreates(request.op)
      const refused = fixtureFailure(request.op, creating, issue !== undefined, request.title.trim() === "",
        request.text.trim() === "" || request.example.trim() === "" || request.prior.trim() === "",
        request.op !== "link" || canLinkIssues(before.items, request.number, request.parent),
        issue?.state === "open", request.assignee.trim() === "", request.text.trim() === "", issue?.vip === "In review")
      if (refused !== "") throw new IssueFailure({ reason: refused, unwritten: true })
      const now = try Clock.currentTimeMillis
      const actor = person.login
      // The proved transition (issueGraphDecision.vibe): from a forest, these checked writes keep a forest.
      const selected = creating ? nextIssueNumber(before.items) : 0
      const vip = request.op === "propose"
      const created = creating ? item(selected, request.title.trim(), { body: vip ? vipIssueBody(request) : request.text, author: actor, age: "just now", vip: vip ? "In review" : "", path: vip ? `docs/design/vips/${selected}.md` : "", review: vip ? `https://github.com/smithersai/vibelang/pull/${selected}` : "" }) : issue!
      const items = issuesAfter(before.items, created, { op: request.op, number: request.number, parent: request.parent, assignee: request.assignee, text: request.op === "comment" ? request.text.trim() : "", note: noteOf(request), actor, role: person.role, kind: person.kind ?? "person", at: request.op === "accept" ? new Date(now).toISOString() : "" })
      const next = { ...before, ...applyIssues(before, { type: "IssuesObserved", seq: before.seq + 1, items }) }
      try Ref.set(state, next)
      return selected === 0 ? next : { ...next, selected }
    }),
  }
  return host
}

/** `engine` is the flow engine the issue flows run on; tests pass a faulty one to drive engine failures. */
export effect function makeIssueFactory(identity: FixtureIdentity = "maintainer", participated?: (id: string) => void!!, shared?: FixtureStore, engine: Layer.Layer<FlowRuntime.FlowRuntime> = FlowEngine.layerMemory): IssuesApi!!Scope.Scope {
  const store = shared ?? (try makeIssueStore())
  const host = try fixtureHost(identity, store.state, store.lock)
  const context = try Layer.build(issueRegistration.pipe(Layer.provideMerge(engine), Layer.provide(Layer.succeed(IssueHost, host)), Layer.provide(WebCrypto.layer)))
  const runtime = Context.get(context, FlowRuntime.FlowRuntime)
  const act = effect (request: IssueRequest) => {
    // The live Worker refuses this text at its wire schema; the mock answers with the same typed reason, never a defect.
    if (!Schema.is(IssueRequest)(request)) throw new IssueFailure({ reason: "invalid", unwritten: true })
    const person = try personOf(identity)
    const flow = issueFlow(request.op)
    try authorizeIssue(person.role, request.op)
    const { recovery: _recovery, ...payload } = request
    const executionId = try issueExecutionId(person.id || "public", request.op, request.key)
    // A reused key with a changed request is a typed conflict, never an engine defect: the engine refuses a held
    // identity with an ExecutionIdentityConflict defect, and the caller that chose the id receives it as a failure.
    const result = try runtime.execute(flow, { executionId, payload }).pipe(
      Effect.catchCause((cause): Effect.Effect<never, IssueFailure | FlowRuntime.ExecutionIdentityConflict | FlowRuntime.FlowCycleDetected> => {
        const reason = cause.reasons.length === 1 ? cause.reasons.find(Cause.isDieReason) : undefined
        return reason?.defect instanceof FlowRuntime.ExecutionIdentityConflict ? Effect.fail(reason.defect) : Effect.failCause(cause)
      }),
      Effect.mapError((error) => error._tag === "IssueFailure" ? error : new IssueFailure({ reason: fixtureErrorReason(error._tag), unwritten: true })),
    )
    if (participated !== undefined && fixtureParticipation(request.op)) try participated(person.id)
    return { ...result, reviewers: ["Will"], role: (try personOf(identity)).role }
  }

  let reads = 0
  return {
    read: () => { reads += 1; return act({ op: "read", number: 0, parent: 0, title: "", text: "", assignee: "", example: "", prior: "", key: `read-${reads}` }) },
    act,
  }
}
