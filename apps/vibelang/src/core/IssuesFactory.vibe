]

export interface FixturePerson { readonly id: string; readonly login: string; readonly role: Role }
export type FixtureIdentity = Role | (() => FixturePerson!!)
effect function personOf(identity: FixtureIdentity): FixturePerson!! {
  if (typeof identity === "string") return { id: "fixture-" + identity, login: identity === "maintainer" ? "will" : "jun", role: identity }
  return try identity()
}

/** Local fixture mode's identity is selected by its host. Live requests never accept this argument. */
export effect function fixtureHost(identity: FixtureIdentity, state: Ref.Ref<import("./conversation.vibe").IssuesState>) {
  const lock = try Semaphore.make(1)
  const host: IssueHost.Shape = {
    perform: (request) => lock.withPermit(effect {
      const person = try personOf(identity)
      const instance = try FlowRuntime.FlowInstance
      if (!instance.executionId.startsWith(`issues/${person.id || "public"}/`) || !issuePermission(person.role, request.op)) throw new IssueFailure({ reason: "forbidden" })
      const before = try Ref.get(state)
      if (request.op === "read") return before
      if (request.key === "") throw new IssueFailure({ reason: "invalid", unwritten: true })
      if (request.op === "draft") return { ...before, draft: { title: request.title.trim() || "Tuple patterns", summary: request.text.trim() || "Bind the elements of a tuple in one pattern.", example: request.example.trim() || "const pair = [1, 2]", prior: request.prior.trim() || "Rust tuple patterns\nTypeScript tuple types" } }
      const issue = before.items.find((i) => i.number === request.number)
      const creating = request.op === "new" || request.op === "propose" || request.op === "split"
      if (!creating && issue === undefined) throw new IssueFailure({ reason: "missing", unwritten: true })
      if (creating && request.title.trim() === "") throw new IssueFailure({ reason: "title", unwritten: true })
      if (request.op === "propose" && (request.text.trim() === "" || request.example.trim() === "" || request.prior.trim() === "")) throw new IssueFailure({ reason: "incomplete", unwritten: true })
      if (request.op === "split" && issue === undefined) throw new IssueFailure({ reason: "missing", unwritten: true })
      if (request.op === "link" && !canLinkIssues(before.items, request.number, request.parent)) throw new IssueFailure({ reason: "tree", unwritten: true })
      if (request.op === "commit" && (issue?.state !== "open" || request.assignee.trim() === "")) throw new IssueFailure({ reason: "assignee", unwritten: true })
      if (request.op === "comment" && request.text.trim() === "") throw new IssueFailure({ reason: "empty", unwritten: true })
      if ((request.op === "accept" || request.op === "decline") && issue?.vip !== "In review") throw new IssueFailure({ reason: "review", unwritten: true })
      const actor = person.login
      let selected = 0
      let items = before.items
      if (creating) {
        const number = Math.max(...items.map((i) => i.number)) + 1
        selected = number
        const vip = request.op === "propose"
        items = [item(number, request.title.trim(), { body: vip ? vipDocument(request) : request.text, author: actor, age: "just now", parent: request.op === "split" ? request.number : 0, vip: vip ? "In review" : "", path: vip ? `docs/design/vips/${number}.md` : "", review: vip ? `https://github.com/smithersai/vibelang/pull/${number}` : "" }), ...items]
      } else {
        items = items.map((i) => {
          if (i.number !== request.number) return i
          const event = (text: string, change: Partial<IssueRecord>): IssueRecord => ({ ...i, ...change, notes: [...i.notes, { author: actor, text, event: true }] })
          switch (request.op) {
            case "comment": return { ...i, comments: i.comments + 1, notes: [...i.notes, { author: actor, text: request.text.trim(), event: false }] }
            case "commit": return event(`committed this as a task and assigned ${request.assignee}`, setCommitment(i, request.assignee, true))
            case "uncommit": return event("uncommitted this task", setCommitment(i, "", false))
            case "link": return event(`linked this under #${request.parent}`, { parent: request.parent })
            case "accept": return event("accepted this VIP", setVipReview(i, true))
            case "decline": return event("declined this VIP", setVipReview(i, false))
            default: return i
          }
        })
      }
      const next = applyIssues(before, { type: "IssuesObserved", seq: before.seq + 1, items })
      try Ref.set(state, next)
      return selected === 0 ? next : { ...next, selected }
    }),
  }
  return host
}

export effect function makeIssueFactory(identity: FixtureIdentity = "maintainer", participated?: (id: string) => void!!): IssuesApi!!Scope.Scope {
  const state = try Ref.make({ ...emptyIssues, items: fixtureIssues })
  const host = try fixtureHost(identity, state)
  const context = try Layer.build(issueRegistration.pipe(Layer.provideMerge(FlowEngine.layerMemory), Layer.provide(Layer.succeed(IssueHost, host)), Layer.provide(WebCrypto.layer)))
  const engine = Context.get(context, FlowRuntime.FlowRuntime)
  const act = effect (request: IssueRequest) => {
    const person = try personOf(identity)
    const flow = issueFlows.find((f) => f._tag === `vibelang/issues/${request.op}`)
    if (flow === undefined) throw new IssueFailure({ reason: "invalid", unwritten: true })
    try authorizeIssue(person.role, request.op)
    const { recovery: _recovery, ...payload } = request
    const executionId = try issueExecutionId(person.id || "public", request.op, request.key)
    // A reused key with a changed request is a typed conflict, never an engine defect: the engine refuses a held
    // identity with an ExecutionIdentityConflict defect, and the caller that chose the id receives it as a failure.
    const result = try engine.execute(flow, { executionId, payload }).pipe(
      Effect.catchCause((cause): Effect.Effect<never, IssueFailure | FlowRuntime.ExecutionIdentityConflict | FlowRuntime.FlowCycleDetected> => {
        const reason = cause.reasons.length === 1 ? cause.reasons.find(Cause.isDieReason) : undefined
        return reason?.defect instanceof FlowRuntime.ExecutionIdentityConflict ? Effect.fail(reason.defect) : Effect.failCause(cause)
      }),
      Effect.mapError((error) => error._tag === "IssueFailure" ? error : new IssueFailure({ reason: error._tag.endsWith("ExecutionIdentityConflict") ? "conflict" : "failed", unwritten: true })),
    )
    if (participated !== undefined && (request.op === "new" || request.op === "comment")) try participated(person.id)
    return { ...result, reviewers: ["Will"], role: (try personOf(identity)).role }
  }

  let reads = 0
  return {
    read: () => { reads += 1; return act({ op: "read", number: 0, parent: 0, title: "", text: "", assignee: "", example: "", prior: "", key: `read-${reads}` }) },
    act,
  }
}
