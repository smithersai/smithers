// Product mock mode (VL-13). The real issue flows and state machine over local fixtures; no backend or model.
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { FlowRuntime } from "@smthrs/flow"
import { applyIssues, canLinkIssues, emptyIssues, issuePermission, setCommitment, setVipReview, type IssueRecord, type Role } from "./conversation.vibe"
import { IssueHost, issueFlows, issueRegistration, authorizeIssue, issueExecutionId } from "./issueFlows.vibe"
import { IssueFailure, type IssueRequest, type IssuesApi, vipDocument } from "./issueSchemas.vibe"

function item(number: number, title: string, extra: Partial<IssueRecord> = {}): IssueRecord {
  return { number, githubId: number + 1000, title, body: "Case branches on tuples should narrow each element without a cast.\n\n```vibe\nmatch (pair) {\n  when [let name, let count]: name\n}\n```", author: "jun", age: "2d", state: "open", labels: [], parent: 0, task: "", assignee: "", vip: "", review: "", path: "", comments: 0, notes: [], ...extra }
}
export const fixtureIssues: ReadonlyArray<IssueRecord> = [
  item(48, "Formatter can't resolve its shipped binary on Linux", { labels: ["bug", "cli"], task: "Queued", assignee: "VibeLang agent", comments: 4 }),
  item(46, "is stops matching a subclass of an error after --fix", { author: "maya", age: "3d", labels: ["bug", "compiler"], task: "Running", assignee: "VibeLang agent", comments: 6 }),
  item(45, "Pattern matching in case", { body: "Let case match on shapes, not just values: tuples, records and literals, with bindings inside the pattern.\n\n```vibe\ncase pair {\n  (0, rest) -> rest\n  (n, _)    -> n\n}\n```\n\nRust — match ergonomics\nScala — pattern matching\nTC39 — proposal-pattern-matching", notes: [{ author: "jun", text: "proposed this VIP", event: true }], vip: "In review", comments: 3, review: "https://github.com/smithersai/vibelang/pull/45", path: "docs/design/vips/0045-pattern-matching.md" }),
  item(44, "for-await over streams", { body: "Streams should work in `for await`: `for await (const chunk of stream)` reads to the end, typed errors included.", author: "maya", age: "5d", vip: "Accepted", comments: 8, notes: [{ author: "maya", text: "proposed this VIP", event: true }, { author: "will", text: "accepted this VIP", event: true }, { author: "will", text: "committed #47 as a task and assigned Will", event: true }], review: "https://github.com/smithersai/vibelang/pull/44", path: "docs/design/vips/0044-for-await.md" }),
  item(47, "Stream for-await in the compiler", { parent: 44, task: "Done", state: "closed", assignee: "Will", author: "will" }),
  item(42, "Case branches on tuples", { labels: ["compiler"], parent: 38, age: "3d", comments: 6, notes: [{ author: "will", text: "added the compiler label", event: true }, { author: "will", text: "linked this under #38", event: true }, { author: "VibeLang agent", text: "Related: #40 Cycle errors read like English.", event: false }] }),
  item(40, "Cycle errors read like English", { author: "noor", age: "4d", parent: 38, comments: 1 }),
  item(39, "Elide type-only imports", { author: "will", age: "4d", parent: 38, task: "Running", labels: ["compiler"], assignee: "VibeLang agent", comments: 5 }),
  item(38, "Effect-native modules", { author: "will", age: "1w", labels: ["language"], comments: 12 }),
  item(36, "Sandbox minutes show in the prompt footer", { author: "noor", age: "1w" }),
  item(49, "Narrow tuple elements", { parent: 42 }), item(50, "Tuple exhaustiveness", { parent: 42, task: "Queued", assignee: "VibeLang agent" }),
  item(43, "Labeled errors in A!E!R", { state: "closed", vip: "Declined", author: "noor", age: "1w", comments: 9, path: "docs/design/vips/0043-labeled-errors.md", review: "https://github.com/smithersai/vibelang/pull/43" }),
  item(41, "Package exports map", { state: "closed", task: "Done", assignee: "Will", author: "will", age: "6d", comments: 2, parent: 38 }),
  item(37, "Playground share links", { state: "closed", task: "Done", assignee: "VibeLang agent", author: "maya", age: "1w", comments: 3 }),
  item(35, "Watch mode rebuilds twice", { state: "closed", labels: ["bug", "cli"], age: "2w", comments: 2 }),
  item(34, "Docs search indexes headings", { state: "closed", author: "noor", age: "2w", comments: 1 }),
  item(33, "Install fails behind a proxy", { state: "closed", author: "maya", labels: ["bug"], age: "3w", comments: 4 }),
