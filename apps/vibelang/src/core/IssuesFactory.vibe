function item(number: number, title: string, extra: Partial<IssueRecord> = {}): IssueRecord {
  return { ...fixtureIdentity(number), title, body: "Case branches on tuples should narrow each element without a cast.\n\n```vibe\nmatch (pair) {\n  when [let name, let count]: name\n}\n```", author: "jun", age: "2d", state: "open", labels: [], parent: 0, task: "", assignee: "", vip: "", review: "", path: "", comments: 0, notes: [], ...extra }
}
