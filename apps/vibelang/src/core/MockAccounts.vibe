import { FlowEngine } from "@smthrs/engine"
import { Action, Flow, FlowRuntime } from "@smthrs/flow"
import { Node } from "@smthrs/plan"
import { WebCrypto } from "@smthrs/crypto"
import { Digest } from "effect/crypto"
import { apply, empty, leastRole, roleOf, type Event, type GrantMode, type Role } from "./conversation.vibe"
import { decide } from "./decide.vibe"
import { AccountUnavailable, Denied, type Policy, type Accounts, type Identity, viewer } from "./roles.vibe"

const Change = Flow.make("vibelang/GrantRole", {
  description: "Records a project role grant through the shared sequencer.",
  modelInvocable: false,
  payload: { id: Schema.String, by: Schema.String, role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]), mode: Schema.Literals(["person", "participation", "bootstrap"]) },
  success: Schema.NullOr(Schema.String),
  body: () => Node.succeed(null),
})

// The mock restores an existing fixture history; these grants are not new user actions.
const seeded: ReadonlyArray<Event> = [
  { type: "RoleGranted", seq: 1, id: "1", by: "", role: "maintainer", mode: "bootstrap" },
  { type: "RoleGranted", seq: 2, id: "3", by: "1", role: "community", mode: "person" },
  { type: "RoleGranted", seq: 3, id: "4", by: "1", role: "contributor", mode: "person" },
  { type: "RoleGranted", seq: 4, id: "5", by: "1", role: "maintainer", mode: "person" },
]

/** Product mock identities, grants and events; no network and no model. */
export effect function make() {
  const scope = try Scope.Scope
  const state = try Ref.make(seeded.reduce(apply, empty))
  const log = try Ref.make<ReadonlyArray<Event>>(seeded)
  const published = try acquireRelease(PubSub.unbounded<Event>(), PubSub.shutdown)
  const selected = try Ref.make("")
  // Whether the selection is the person's agent (the surfaces' mock sign-in, decision 0028), never the person.
  const agent = try Ref.make(false)
  const counter = try Ref.make(10)
  const people = try Ref.make<ReadonlyArray<{ readonly id: string; readonly login: string }>>([
    { id: "1", login: "will" }, { id: "2", login: "joss" }, { id: "3", login: "ada" }, { id: "4", login: "rira" }, { id: "5", login: "mina" },
  ])
  const lock = try Semaphore.make(1)
  const registration = Layer.effectDiscard(effect {
    const runtime = try FlowRuntime.FlowRuntime
    try runtime.register(Change, (payload) => withSpan(effect {
      return try Action.make({ name: "vibelang/role/record", success: Schema.NullOr(Schema.String), execute: Semaphore.withPermits(lock, 1)(effect {
        const current = try Ref.get(state)
        const decision = decide(current, { type: "GrantRole", ...payload })
        const outcome = decision.ok ? "accepted" : decision.refusal
        try Metric.update(Metric.withAttributes(Metric.counter("vibelang_role_grants", { incremental: true }), { outcome }), 1)
        try Effect.logInfo("vibelang.role").pipe(Effect.annotateLogs({ outcome }))
        if (!decision.ok) return decision.refusal
        try Ref.set(state, apply(current, decision.event))
        try Ref.update(log, events => [...events, decision.event])
        try PubSub.publish(published, decision.event)
        return null
      }) })
    }, "vibelang.role"))
  })
  const digest = try Effect.provide(Digest.Digest, WebCrypto.layer)
  const engine = try Effect.cached(effect {
    const context = try Layer.buildWithScope(registration.pipe(Layer.provideMerge(FlowEngine.layerMemory), Layer.provide(Layer.succeed(Digest.Digest, digest))), scope)
    return Context.get(context, FlowRuntime.FlowRuntime)
  })
  effect function change(id: string, by: string, role: Role, mode: GrantMode) {
    const executionId = "role/" + (try Ref.updateAndGet(counter, n => n + 1))
    return try Effect.orDie((try engine).execute(Change, { executionId, payload: { id, by, role, mode } }))
  }

  effect function current() {
    const id = try Ref.get(selected)
    if (id === "") return viewer
    const person = (try Ref.get(people)).find(p => p.id === id)!
    const ledger = try Ref.get(state)
    return { ...person, role: roleOf(ledger.roles, id), ...((try Ref.get(agent)) ? { agent: true as const } : {}), ledger } satisfies Identity
  }
  const policy: Policy.Shape = {
    authorize: effect (actor, action) => {
      const result = decide(try Ref.get(state), { type: "Authorize", id: "policy", by: actor, action })
      if (!result.ok) throw new Denied({ action, least: leastRole(action) })
    },
  }
  const accounts: Accounts.Shape & { readonly policy: Policy.Shape; readonly role: (id: string) => Role!! } = {
    policy,
    role: (id) => Ref.get(state).pipe(Effect.map(ledger => roleOf(ledger.roles, id))),
    current,
    members: effect () => {
      try policy.authorize((try current()).id, "people")
      const grants = (try Ref.get(state)).roles
      return (try Ref.get(people)).map(person => ({ ...person, role: roleOf(grants, person.id) }))
    },
    grant: effect (id, role) => {
      const actor = try current()
      if (actor.id !== id || actor.id === "") try policy.authorize(actor.id, "roles")
      if (roleOf((try Ref.get(state)).roles, id) === role) return
      const refused = try change(id, actor.id, role, "person")
      if (refused !== null) throw new Denied({ action: "roles", least: "maintainer" })
    },
    signOut: effect () => {
      try Ref.set(agent, false)
      try Ref.set(selected, "")
    },
    signInAgent: effect () => {
      const grants = (try Ref.get(state)).roles
      const maintainer = (try Ref.get(people)).find(person => roleOf(grants, person.id) === "maintainer")
      if (maintainer === undefined) throw new AccountUnavailable({ reason: "no fixture" })
      try Ref.set(selected, maintainer.id)
      try Ref.set(agent, true)
      return try current()
    },
    choose: effect (role) => {
      // Visit as is the person at a browser, never their agent.
      try Ref.set(agent, false)
      if (role === "viewer") { try Ref.set(selected, ""); return viewer }
      const grants = (try Ref.get(state)).roles
      const existing = (try Ref.get(people)).find(person => roleOf(grants, person.id) === role)
      let id = existing?.id
      if (id === undefined) {
        id = String(try Ref.updateAndGet(counter, n => n + 1))
        try Ref.update(people, all => [...all, { id: id!, login: (role === "new" ? "joss" : role) + id }])
        if (role !== "new") try change(id, grants.find(grant => roleOf(grants, grant.id) === "maintainer")!.id, role, "person")
      }
      try Ref.set(selected, id)
      return try current()
    },
    participated: effect (personId) => {
      const id = personId ?? (try current()).id
      if (id !== "") try change(id, id, "community", "participation")
    },
    events: (after) => Stream.unwrap(effect {
      const live = try PubSub.subscribe(published)
      const events = (try Ref.get(log)).filter(event => event.seq > after)
      const last = events[events.length - 1]?.seq ?? after
      return Stream.concat(Stream.fromIterable(events), Stream.fromSubscription(live).pipe(Stream.filter(event => event.seq > last)))
    }),
  }
  return accounts
}
