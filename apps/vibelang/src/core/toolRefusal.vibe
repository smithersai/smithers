// What an agent's refused tool call is told (FLOW-5: the agent acts on the reason). Every tool binding passes this as
// FlowBinding's `publicError`, so the cell reads "Flow vibelang/wiki/draft failed: forbidden", not an opaque failure.
// Only a product error's fixed refusal code crosses: a reason that is not code-shaped (an HTTP status, a transport
// detail, user text) stays opaque, and `Unavailable` says only "unavailable".
import { refusalCode, refusalField } from "./toolRefusalDecision.vibe"

/** The refusal code `error` carries for the agent, or `undefined` to keep the failure opaque. */
export function toolRefusal(error: unknown): string | undefined {
  if (typeof error !== "object" || error === null) return undefined
  const failure = error as { readonly _tag?: unknown; readonly reason?: unknown; readonly refusal?: unknown; readonly code?: unknown }
  const field = refusalField(typeof failure._tag === "string" ? failure._tag : "")
  const code = field === "unavailable" ? "unavailable" : field === "reason" ? failure.reason : field === "refusal" ? failure.refusal : field === "code" ? failure.code : undefined
  return typeof code === "string" && refusalCode(code) ? code : undefined
}
