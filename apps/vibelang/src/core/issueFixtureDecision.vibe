// Issue fixture decisions used by the actual memory flow host (0018, third-lane batch 16).
// Whitespace normalization, identity/role gates, creation (issueCreates), the graph predicate and every write
// (issueGraphDecision.vibe, fifth lane), storage and engine execution remain outside this module.
export interface FixtureNumber { readonly number: number }
//@ verify
//@ ensures -1 <= \result && \result < items.length
//@ ensures \result >= 0 ==> items[\result].number == wanted && forall(j, 0 <= j && j < \result ==> items[j].number != wanted)
//@ ensures \result == -1 ==> forall(j, 0 <= j && j < items.length ==> items[j].number != wanted)
export function fixtureIssueIndex(items: ReadonlyArray<FixtureNumber>, wanted: number): number {
  let i = 0
  while (i < items.length) {
    //@ invariant 0 <= i && i <= items.length
    //@ invariant forall(j, 0 <= j && j < i ==> items[j].number != wanted)
    //@ decreases items.length - i
    if (items[i]!.number === wanted) return i
    i += 1
  }
  return -1
}
export type FixtureRefusal = "" | "missing" | "title" | "incomplete" | "tree" | "assignee" | "empty" | "review"
//@ verify
//@ ensures \result == ((!creating && !known) ? "missing" : ((creating && titleBlank) ? "title" : ((op == "propose" && incomplete) ? "incomplete" : ((op == "split" && !known) ? "missing" : ((op == "link" && !linkAllowed) ? "tree" : ((op == "commit" && (!open || assigneeBlank)) ? "assignee" : ((op == "comment" && textBlank) ? "empty" : (((op == "accept" || op == "decline") && !reviewing) ? "review" : ""))))))))
//@ ensures !creating && !known ==> \result == "missing"
//@ ensures creating && titleBlank ==> \result == "title"
export function fixtureFailure(op: string, creating: boolean, known: boolean, titleBlank: boolean, incomplete: boolean, linkAllowed: boolean, open: boolean, assigneeBlank: boolean, textBlank: boolean, reviewing: boolean): FixtureRefusal {
  if (!creating && !known) return "missing"
  if (creating && titleBlank) return "title"
  if (op === "propose" && incomplete) return "incomplete"
  if (op === "split" && !known) return "missing"
  if (op === "link" && !linkAllowed) return "tree"
  if (op === "commit" && (!open || assigneeBlank)) return "assignee"
  if (op === "comment" && textBlank) return "empty"
  if ((op === "accept" || op === "decline") && !reviewing) return "review"
  return ""
}
export interface FixtureDraft { readonly title: string; readonly summary: string; readonly example: string; readonly prior: string }
//@ verify
//@ ensures \result.title == (title == "" ? "Tuple patterns" : title)
//@ ensures \result.summary == (summary == "" ? "Bind the elements of a tuple in one pattern." : summary)
//@ ensures \result.example == (example == "" ? "const pair = [1, 2]" : example)
//@ ensures \result.prior == (prior == "" ? "Rust tuple patterns\nTypeScript tuple types" : prior)
export function fixtureDraft(title: string, summary: string, example: string, prior: string): FixtureDraft {
  return { title: title || "Tuple patterns", summary: summary || "Bind the elements of a tuple in one pattern.", example: example || "const pair = [1, 2]", prior: prior || "Rust tuple patterns\nTypeScript tuple types" }
}
//@ verify
//@ ensures \result == (op == "new" || op == "comment")
export function fixtureParticipation(op: string): boolean {
  return op === "new" || op === "comment"
}
/** An engine that could not record the step is unavailable; a reused key is a conflict; anything else failed. */
//@ verify
//@ ensures \result == (tag == "@smthrs/flow/StoreUnavailable" ? "unavailable" : (tag.endsWith("ExecutionIdentityConflict") ? "conflict" : "failed"))
export function fixtureErrorReason(tag: string): "unavailable" | "conflict" | "failed" {
  return tag === "@smthrs/flow/StoreUnavailable" ? "unavailable" : tag.endsWith("ExecutionIdentityConflict") ? "conflict" : "failed"
}
/** An unrecordable step may already have written: only the engine's other refusals prove nothing was written. */
//@ verify
//@ ensures \result == (tag != "@smthrs/flow/StoreUnavailable")
export function fixtureErrorUnwritten(tag: string): boolean {
  return tag !== "@smthrs/flow/StoreUnavailable"
}

export interface FixtureIds { readonly number: number; readonly githubId: number }
/** A fixture issue's GitHub id is its number offset by 1000, so the two never coincide. */
//@ verify
//@ ensures \result.number == issue && \result.githubId == issue + 1000
export function fixtureIdentity(issue: number): FixtureIds {
  return { number: issue, githubId: issue + 1000 }
}

/** A fixture role's GitHub login: the maintainer is will, everyone else jun (0018 third-lane batch 34). */
//@ verify
//@ ensures \result == (role == "maintainer" ? "will" : "jun")
export function fixtureLogin(role: string): string {
  return role === "maintainer" ? "will" : "jun"
}

export type FixtureRoute = "forbidden" | "read" | "specification" | "invalid" | "draft" | "write"

/**
 * How the fixture host handles a request, in order: another caller's execution or a role without the permission is
 * forbidden; a read answers the state; an operation the agent may not take is forbidden; a specification request runs
 * the specification flow; a request without a key is invalid; a draft answers a draft; anything else writes.
 */
//@ verify
//@ ensures !(own && permitted) ==> \result == "forbidden"
//@ ensures own && permitted && op == "read" ==> \result == "read"
//@ ensures own && permitted && op != "read" && agentRefused ==> \result == "forbidden"
//@ ensures own && permitted && op != "read" && !agentRefused && (op == "spec-revise" || op == "spec-review") ==> \result == "specification"
//@ ensures own && permitted && op != "read" && !agentRefused && op != "spec-revise" && op != "spec-review" && keyless ==> \result == "invalid"
//@ ensures own && permitted && op != "read" && !agentRefused && op != "spec-revise" && op != "spec-review" && !keyless && op == "draft" ==> \result == "draft"
//@ ensures own && permitted && op != "read" && !agentRefused && op != "spec-revise" && op != "spec-review" && !keyless && op != "draft" ==> \result == "write"
export function fixtureRoute(own: boolean, permitted: boolean, op: string, agentRefused: boolean, keyless: boolean): FixtureRoute {
  if (!(own && permitted)) return "forbidden"
  if (op === "read") return "read"
  if (agentRefused) return "forbidden"
  if (op === "spec-revise" || op === "spec-review") return "specification"
  if (keyless) return "invalid"
  return op === "draft" ? "draft" : "write"
}

/** Whether a write proposes a VIP: only `propose` makes its issue a VIP in review with a document and a pull request. */
//@ verify
//@ ensures \result == (op == "propose")
export function proposes(op: string): boolean {
  return op === "propose"
}

/** Whether a write stamps its approval time: only `accept`. */
//@ verify
//@ ensures \result == (op == "accept")
export function stampsApproval(op: string): boolean {
  return op === "accept"
}

/** Whether a write carries its text as a comment: only `comment`. */
//@ verify
//@ ensures \result == (op == "comment")
export function carriesComment(op: string): boolean {
  return op === "comment"
}
