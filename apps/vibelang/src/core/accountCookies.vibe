import { cookieAccepted, localOrigin, sessionCookieOf } from "./accountCookieDecision.vibe"
export const SESSION = "__Host-vibelang-session"
export const sessionCookieName = sessionCookieOf

/** Local HTTP has no Secure cookie; production accepts only the host-prefixed cookie. */
export function validSessionCookie(origin: string, cookie: string): boolean {
  try {
    const url = new URL(origin)
    const local = localOrigin(url.protocol === "http:", url.hostname)
    return cookieAccepted(url.origin === origin, url.protocol === "https:", local,
      /^__Host-vibelang-session=[A-Za-z0-9_.:-]{1,4096}$/.test(cookie), /^vibelang-session=[A-Za-z0-9_.:-]{1,4096}$/.test(cookie))
  } catch { return false }
}
