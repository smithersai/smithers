// VL-13's product mock: a real in-memory filesystem, a deliberately small shell, and the SAME meter/flows as live.
// Unsupported commands say so; the mock never fabricates test, install, repository or network success.
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { SecureRandom } from "effect/crypto"
import { FlowRuntime } from "@smthrs/flow"
import { Factory, Unavailable } from "./Factory.vibe"
import { SandboxCommand, SandboxHost, SandboxMeter, SandboxStart, SandboxStop, sandboxRegistration } from "./flows.vibe"
import { makeSandboxHost, type Machines, type SandboxState, type Receipt } from "./sandboxHost.vibe"
import { mockPolicy, type SandboxPolicy } from "./sandboxPolicy.vibe"
import type { Role } from "./sandboxDecision.vibe"
import { currentLease, mockCommand } from "./sandboxMockDecision.vibe"

/**
 * `engine` is the flow engine the sandbox flows run on and `machines` the device they drive; tests pass faulty ones to
 * drive engine and machine failures.
 */
export effect function makeMockSandboxes(role: Role, policy: Layer.Layer<SandboxPolicy> = mockPolicy(role), engine: Layer.Layer<FlowRuntime.FlowRuntime> = FlowEngine.layerMemory, machines: Machines = memoryMachines()) {
  const random = try Effect.provide(SecureRandom.SecureRandom, WebCrypto.layer)
  effect function execution(prefix: string) { return `${prefix}/${try random.uuidV4()}` }
  const state = try Ref.make<SandboxState | undefined>(undefined)
  // The host arms an alarm only while a sandbox runs or an operation is pending (sandboxHost.vibe `arm`).
  const armed = try Ref.make<number | null>(null)
  const receipts = new Map<string, Receipt>()
  const host = try Effect.provide(makeSandboxHost({ read: () => Ref.get(state), receipt: (id) => succeed(receipts.get(id)), write: (next, receipt) => sync(() => { if (receipt) receipts.set(receipt.request.operationId, receipt) }).pipe(Effect.andThen(Ref.set(state, next))), alarm: (at) => Ref.set(armed, at) }, machines), policy)
  const registered = sandboxRegistration.pipe(
    Layer.provideMerge(engine),
    Layer.provide(Layer.succeed(SandboxHost, host)),
    Layer.provide(WebCrypto.layer),
  )
  const context = try Layer.build(registered)
  const runtime = Context.get(context, FlowRuntime.FlowRuntime)
  // The real clock's alarm is a scoped fiber in product mock mode, never a backend or model. It meters only when the
  // host's alarm is due, as the live object's storage alarm does, so an idle page runs no flow.
  let ticks = 0
  try Effect.forkScoped(Effect.forever(effect {
    try sleep("1 second")
    const at = try Ref.get(armed)
    if (at === null || at > (try Clock.currentTimeMillis)) return
    try Effect.ignore(runtime.execute(SandboxMeter, { executionId: `meter/${++ticks}`, payload: {} }))
  }))

  const service: Pick<Factory.Shape, "sandbox" | "startSandbox" | "stopSandbox" | "sandboxCommand"> = {
    sandbox: effect (conversation) => {
      try Effect.mapError(runtime.execute(SandboxMeter, { executionId: `read/${++ticks}`, payload: {} }), (error) => error._tag === "Refused" || error._tag === "Unavailable" ? error : new Unavailable({ reason: "sandbox-flow" }))
      return try host.snapshot(conversation)
    },
    startSandbox: effect (conversation, operationId) => { return try Effect.mapError(runtime.execute(SandboxStart, { executionId: try execution("start"), payload: { conversation, operationId } }), (error) => error._tag === "Refused" || error._tag === "Unavailable" ? error : new Unavailable({ reason: "sandbox-flow" })) },
    stopSandbox: effect (conversation, operationId, generation) => { return try Effect.mapError(runtime.execute(SandboxStop, { executionId: try execution("stop"), payload: { conversation, operationId, generation } }), (error) => error._tag === "Refused" || error._tag === "Unavailable" ? error : new Unavailable({ reason: "sandbox-flow" })) },
    sandboxCommand: effect (conversation, operationId, command, generation) => { return try Effect.mapError(runtime.execute(SandboxCommand, { executionId: try execution("command"), payload: { conversation, operationId, command, generation } }), (error) => error._tag === "Refused" || error._tag === "Unavailable" ? error : new Unavailable({ reason: "sandbox-flow" })) },
  }
  return service
}

/** The product mock device; retained across writer incarnations by recovery tests. */
export function memoryMachines(): Machines {
  const disk = new Map<string, Map<string, string>>()
  const active = new Map<string, number>()
  const outputs = new Map<string, string>()
  const machines: Machines = {
    start: (id, generation) => sync(() => { active.set(id, generation); if (!disk.has(id)) disk.set(id, new Map()) }),
    lease: (id, generation) => succeed(currentLease(active.has(id), active.get(id) ?? 0, generation)),
    stop: (id, generation) => sync(() => { if (currentLease(active.has(id), active.get(id) ?? 0, generation)) active.delete(id) }),
    command: effect (id, generation, operationId, command) => {
      if (!currentLease(active.has(id), active.get(id) ?? 0, generation)) throw new Unavailable({ reason: "stale-generation" })
      const key = `${id}/${generation}/${operationId}`
      if (outputs.has(key)) return outputs.get(key)!
      const files = disk.get(id)!
      const write = /^echo (.*?)\s*>\s*([a-zA-Z0-9._/-]+)$/.exec(command)
      const read = /^cat ([a-zA-Z0-9._/-]+)$/.exec(command)
      let output = ""
      const kind = mockCommand(write !== null, read !== null, command)
      if (kind === "write") files.set(write![2]!, write![1]!.replace(/^['"]|['"]$/g, "") + "\n")
      else if (kind === "read") output = files.get(read![1]!) ?? "cat: No such file"
      else if (kind === "pwd") output = "/workspace"
      else if (kind === "ls") output = [...files.keys()].join("  ")
      else if (kind === "echo") output = command.slice(5)
      else if (kind === "other") output = "Command unavailable in mock mode"
      outputs.set(key, output)
      return output
    },
  }
  return machines
}
