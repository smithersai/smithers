// The scripted agent's priority decision; the script content is data supplied by mockReplies.vibe.
export interface ScriptWords { readonly words: ReadonlyArray<string> }

/** Whether at least one script word occurs in the normalized prompt. */
//@ verify
//@ ensures \result == exists(i, 0 <= i && i < words.length && prompt.includes(words[i]))
export function matches(prompt: string, words: ReadonlyArray<string>): boolean {
  let i = 0
  while (i < words.length) {
    //@ invariant 0 <= i && i <= words.length
    //@ invariant forall(j, 0 <= j && j < i ==> !prompt.includes(words[j]))
    //@ decreases words.length - i
    if (prompt.includes(words[i]!)) return true
    i++
  }
  return false
}

/** The first matching script, or -1 only when none matches. */
//@ verify
//@ ensures -1 <= \result && \result < scripts.length
//@ ensures \result == -1 ==> forall(i, 0 <= i && i < scripts.length ==> forall(j, 0 <= j && j < scripts[i].words.length ==> !prompt.includes(scripts[i].words[j])))
//@ ensures \result >= 0 ==> exists(j, 0 <= j && j < scripts[\result].words.length && prompt.includes(scripts[\result].words[j]))
//@ ensures \result >= 0 ==> forall(i, 0 <= i && i < \result ==> forall(j, 0 <= j && j < scripts[i].words.length ==> !prompt.includes(scripts[i].words[j])))
export function scriptIndex(prompt: string, scripts: ReadonlyArray<ScriptWords>): number {
  let i = 0
  while (i < scripts.length) {
    //@ invariant 0 <= i && i <= scripts.length
    //@ invariant forall(j, 0 <= j && j < i ==> forall(k, 0 <= k && k < scripts[j].words.length ==> !prompt.includes(scripts[j].words[k])))
    //@ decreases scripts.length - i
    if (matches(prompt, scripts[i]!.words)) return i
    i++
  }
  return -1
}

/** Where the chunk of `text` that starts at `start` ends: `size` units on, or the end of the text. */
//@ verify
//@ requires 0 <= start && start <= text.length && 1 <= size
//@ ensures \result == (start + size <= text.length ? start + size : text.length)
//@ ensures start < \result || start == text.length
export function chunkEnd(text: string, start: number, size: number): number {
  return start + size <= text.length ? start + size : text.length
}

/**
 * `text` in the pieces the mock agent streams: piece `i` is units `i * size` up to `(i + 1) * size`, the last one up to
 * the end, so joined in order they are `text`, and none is empty.
 */
//@ verify
//@ requires 1 <= size
//@ ensures forall(i, 0 <= i && i < \result.length ==> 0 <= i * size && i * size < text.length && \result[i] == text.slice(i * size, chunkEnd(text, i * size, size)))
//@ ensures \result.length * size >= text.length
export function chunksOf(text: string, size: number): ReadonlyArray<string> {
  let pieces: ReadonlyArray<string> = []
  let start = 0
  while (start < text.length) {
    //@ invariant 0 <= start && start == pieces.length * size
    //@ invariant start <= text.length || pieces.length * size - size < text.length
    //@ invariant forall(i, 0 <= i && i < pieces.length ==> 0 <= i * size && i * size < text.length && pieces[i] == text.slice(i * size, chunkEnd(text, i * size, size)))
    //@ decreases text.length - start
    pieces = [...pieces, text.slice(start, chunkEnd(text, start, size))]
    start = start + size
  }
  return pieces
}
