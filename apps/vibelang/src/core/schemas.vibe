import { nonnegativeCursor } from "./protocolDecision.vibe"

// Schemas for the conversation machine's state (`conversation.vibe`), so a Foldkit Model, the wire and the tests can
// decode and encode it. Each one matches the TypeScript type of the same name in `conversation.vibe`.

/** A safe, nonnegative event cursor, shared by every wire/state/surface schema. */
export const Seq = Schema.Int.check(Schema.makeFilter(nonnegativeCursor, Schema.isGreaterThanOrEqualTo(0).annotations))

/** Why the sequencer refused an intent (`Refusal` in conversation.vibe). */
export const RefusalReason = Schema.Literals(["empty", "too-long", "duplicate", "busy", "not-replying", "forbidden", "full"])

export schema Entry {
  readonly id: string
  readonly seq: Seq
  readonly clientId: string
  readonly inReplyTo: string
  readonly author: "person" | "agent"
  readonly name: string
  readonly text: string
  readonly done: boolean
  readonly error: string
}

export schema RoleGrant { readonly id: string; readonly role: "viewer" | "new" | "community" | "contributor" | "maintainer"; readonly blocked: boolean }

export schema Conversation {
  readonly seq: Seq
  readonly entries: ReadonlyArray<Entry>
  readonly agent: "idle" | "working" | "failed"
  readonly replying: string
  readonly pane: string
  readonly roles: ReadonlyArray<RoleGrant>
}

export schema Pending {
  readonly clientId: string
  readonly text: string
  readonly error: string
}

export schema Client {
  readonly conversation: Conversation
  readonly pending: ReadonlyArray<Pending>
  readonly gap: boolean
}

/** The wire form of a conversation's events, as `conversation.vibe` defines them. */
export schema Posted {
  readonly type: "Posted"
  readonly seq: Seq
  readonly id: string
  readonly clientId: string
  readonly name: string
  readonly text: string
}
export schema ReplyStarted { readonly type: "ReplyStarted"; readonly seq: Seq; readonly id: string; readonly inReplyTo: string }
export schema ReplyDelta { readonly type: "ReplyDelta"; readonly seq: Seq; readonly id: string; readonly text: string }
export schema ReplyRestarted { readonly type: "ReplyRestarted"; readonly seq: Seq; readonly id: string }
export schema ReplyFinished { readonly type: "ReplyFinished"; readonly seq: Seq; readonly id: string }
export schema ReplyFailed { readonly type: "ReplyFailed"; readonly seq: Seq; readonly id: string; readonly reason: string }
export schema TourStarted { readonly type: "TourStarted"; readonly seq: Seq; readonly id: string }
export schema TourEnded { readonly type: "TourEnded"; readonly seq: Seq; readonly id: string }
export schema PaneOpened { readonly type: "PaneOpened"; readonly seq: Seq; readonly id: string; readonly url: string }

export schema RoleGranted { readonly type: "RoleGranted"; readonly seq: Seq; readonly id: string; readonly by: string; readonly role: "viewer" | "new" | "community" | "contributor" | "maintainer"; readonly mode: "person" | "participation" | "bootstrap" }
export schema ActionAuthorized { readonly type: "ActionAuthorized"; readonly seq: Seq; readonly id: string; readonly by: string; readonly action: "read" | "ask" | "tour" | "people" | "issue" | "comment" | "vip" | "action" | "sandbox" | "triage" | "merge" | "settings" | "roles" }

/** Decodes one event off the wire. */
export const EventSchema = Schema.Union([
  RoleGranted, ActionAuthorized, Posted, ReplyStarted, ReplyDelta, ReplyRestarted, ReplyFinished, ReplyFailed, TourStarted, TourEnded, PaneOpened,
])

/** A finite read: current copies of entries touched after `after`, and the event cursor. */
export schema ReadSnapshot { readonly seq: Seq; readonly entries: ReadonlyArray<Entry> }

