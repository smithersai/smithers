import { commandConversation } from "../core/protocolDecision.vibe"

// One command registry; CLI parameters, MCP tools and discovery all derive from it (decision 0009).
import { Argument, Flag, type Command } from "effect/cli"
import { IdGenerator, Tool } from "effect/ai"
import { Factory, SandboxSnapshot } from "../core/Factory.vibe"
import { Entry, Seq } from "../core/schemas.vibe"
import { Mythical } from "../history/MythicalHistory.vibe"
import type { CommitPage, Head, Outline } from "../history/pages.vibe"

export schema error CommandError { readonly message: string }

const Conversation = Schema.String.check(Schema.makeFilter(commandConversation, Schema.isMinLength(1).annotations))
const conversation = Conversation.pipe(Schema.withDecodingDefaultKey(succeed("home")))
const after = Seq.pipe(Schema.withDecodingDefaultKey(succeed(0)))
export schema AskInput { readonly text: string; readonly conversation: conversation }
export schema ReadInput { readonly conversation: conversation; readonly after: after }
export schema AskOutput {
  readonly conversation: string
  readonly text: string
  readonly events: ReadonlyArray<Seq>
}
export schema ReadOutput {
  readonly conversation: string
  readonly seq: Seq
  readonly entries: ReadonlyArray<Entry>
}

effect function ask(input: AskInput) {
  const factory = try Factory
  const clientId = try IdGenerator.defaultIdGenerator.generateId()
  try factory.post(input.conversation, clientId, "Factory CLI", input.text)
  // Correlate by post identity even when an agent skips or reorders prompts.
  let postId = ""
  const numbers: Array<number> = []
  let replyId = ""
  let text = ""
  let failure: string | undefined
  let finished = false
  try Stream.runForEachWhile(factory.events(input.conversation, 0), effect (event) => {
    if (event.type === "Posted") {
      if (event.clientId === clientId) { postId = event.id; numbers.push(event.seq) }
    } else if (event.type === "ReplyStarted") {
      if (postId !== "" && event.inReplyTo === postId) replyId = event.id
    }
    if (event.id !== replyId) return true
    numbers.push(event.seq)
    if (event.type === "ReplyDelta") text += event.text
    if (event.type === "ReplyRestarted") text = ""
    if (event.type === "ReplyFailed") failure = event.reason
    if (event.type === "ReplyFinished") finished = true
    return event.type !== "ReplyFinished" && event.type !== "ReplyFailed"
  })
  if (failure !== undefined) throw new CommandError({ message: `The agent's reply failed: ${failure}` })
  if (!finished) throw new CommandError({ message: "The conversation ended before the agent's reply finished." })
  return { conversation: input.conversation, text, events: numbers }
}

effect function read(input: ReadInput) {
  const factory = try Factory
  const snapshot = try factory.read(input.conversation, input.after)
  return { conversation: input.conversation, ...snapshot }
}

function define<const Name extends string, I extends Schema.ConstraintCodec<unknown>, O extends Schema.ConstraintCodec<unknown>, P extends Command.Command.Config, R extends Factory | Mythical>(
  name: Name,
  description: string,
  input: I,
  output: O,
  parameters: P,
  handler: (input: I["Type"]) => O["Type"]!(CommandError | import("../core/Factory.vibe").Unavailable | import("../core/Factory.vibe").Refused)!R,
  format: (output: O["Type"]) => string,
  refused = "The message was refused",
) {
  const invoke = effect (value: unknown) => {
    const decoded = try Schema.decodeUnknownEffect(input)(value)
    const result = try handler(decoded)
    return try Schema.decodeUnknownEffect(output)(result)
  }
  const run = effect (value: unknown) => {
    return invoke(value) catch effect (error) => {
      if (error._tag === "CommandError") throw error
      const message = error._tag === "Unavailable" ? error.reason
        : error._tag === "Refused" ? `${refused}: ${error.refusal}` : error.message
      throw new CommandError({ message })
    }
  }
  const tool = Tool.make(name, { description, parameters: input, success: output, failure: CommandError })
  const render = effect (value: unknown, json: boolean) => {
    const result = try run(value)
    return json ? JSON.stringify(result) : format(result)
  }
  return { name, description, input, output, parameters, run, render, tool }
}

export const Ask = define("ask", "Post a message and wait for the complete agent reply.", AskInput, AskOutput, {
  text: Argument.String("text"),
  conversation: Flag.String("conversation").pipe(Flag.withDefault("home"), Flag.withSchema(Conversation)),
}, ask, (output) => `${output.text}\n\nEvents: ${output.events.join(", ")}`)

export const Read = define("read", "Read current entries changed after an event number.", ReadInput, ReadOutput, {
  conversation: Flag.String("conversation").pipe(Flag.withDefault("home"), Flag.withSchema(Conversation)),
  after: Flag.Int("after").pipe(Flag.withDefault(0), Flag.withSchema(Seq)),
}, read, (output) => output.entries.length === 0 ? `No entries. Event: ${output.seq}`
  : `${output.entries.map((entry) => `${entry.name}: ${entry.text}`).join("\n\n")}\n\nEvent: ${output.seq}`)

// ── the mythical history (wiki/decisions/0020-mythical-history.md) ─────────────────────────────────────────────────

/** How a history command reports the sequencer's refusal, or `forbidden`. */
export const HISTORY_REFUSED = "The history refused it"

const Id = Schema.String.check(Schema.isMinLength(1))
const optional = Schema.String.pipe(Schema.withDecodingDefaultKey(succeed("")))

export schema HistoryInput {
  readonly commit: optional
  readonly epic: optional
  readonly from: after
  readonly search: optional
}
export schema HistoryEpic { readonly id: string; readonly title: string; readonly commits: number }
export schema HistoryCommit { readonly id: string; readonly state: string; readonly title: string }
export schema HistoryDetail {
  readonly id: string
  readonly state: string
  readonly title: string
  readonly task: string
  readonly lane: string
  readonly notes: ReadonlyArray<string>
  readonly real: ReadonlyArray<string>
}
export schema HistoryOutput {
  readonly seq: Seq
  readonly main: string
  readonly epics: ReadonlyArray<HistoryEpic>
  readonly open: ReadonlyArray<HistoryCommit>
  /** An epic's page (`--epic`, `--from`) or a search's matches (`--search`); `total` is how many there are in all. */
  readonly commits: ReadonlyArray<HistoryCommit>
  readonly total: number
  readonly commit: HistoryDetail | null
}
export schema PlanInput {
  readonly title: string
  readonly epic: optional
  readonly newEpic: optional
  readonly before: optional
  readonly amend: optional
  readonly task: optional
}
export schema StartInput { readonly id: Id; readonly lane: Id }
export schema NoteInput { readonly id: Id; readonly section: "tried" | "evidence" | "superseded"; readonly text: string }
export schema WrittenOutput { readonly id: string }

function brief(commit: Head) {
  return { id: commit.id, state: commit.state, title: commit.title }
}

/** The history as an agent reads it: the outline, an epic's page or a search's matches, and one commit in full. */
function summaryOf(outline: Outline, commits: ReadonlyArray<Head>, total: number, page: CommitPage | undefined) {
  const found = page?.commit ?? null
  return {
    seq: outline.seq,
    main: outline.main,
    epics: outline.epics.map((epic) => ({ id: epic.id, title: epic.title, commits: epic.commits })),
    open: outline.open.map(brief),
    commits: commits.map(brief),
    total,
    commit: found === null ? null : {
      id: found.id,
      state: found.state,
      title: found.title,
      task: found.task,
      lane: found.lane,
      notes: found.notes.map((each) => `${each.section}: ${each.text} (${each.by})`),
      real: page!.real.map((real) => real.sha),
    },
  }
}

/** Reads only what was asked: the outline, then an epic's page or a search, and a commit. */
effect function showHistory(input: HistoryInput) {
  const mythical = try Mythical
  const outline = try mythical.outline()
  if (input.epic !== "" && !outline.epics.some((each) => each.id === input.epic)) throw new CommandError({ message: `No epic ${input.epic}.` })
  const listed = input.epic === "" ? undefined : try mythical.epic(input.epic, input.from)
  const matched = input.epic !== "" || input.search === "" ? undefined : try mythical.search(input.search)
  const page = input.commit === "" ? undefined : try mythical.commit(input.commit)
  if (page !== undefined && page.commit === null) throw new CommandError({ message: `No mythical commit ${input.commit}.` })
  const commits = listed?.commits ?? matched?.commits ?? []
  return summaryOf(outline, commits, listed?.total ?? commits.length, page)
}

effect function plan(input: PlanInput) {
  const mythical = try Mythical
  const how = input.amend !== "" ? "amend" : input.before !== "" ? "insert" : "append"
  const id = try mythical.plan({
    how,
    epic: input.epic,
    newEpic: input.newEpic,
    target: how === "amend" ? input.amend : input.before,
    title: input.title,
    task: input.task,
  })
  return { id }
}

effect function start(input: StartInput) {
  try (try Mythical).start(input.id, input.lane)
  return { id: input.id }
}

effect function note(input: NoteInput) {
  try (try Mythical).note(input.id, input.section, input.text)
  return { id: input.id }
}

export const ShowHistory = define("history", "Read VibeLang's mythical history: epics, work not landed, an --epic's commits by page (--from), a --search, one --commit in full.", HistoryInput, HistoryOutput, {
  commit: Flag.String("commit").pipe(Flag.withDefault("")),
  epic: Flag.String("epic").pipe(Flag.withDefault("")),
  from: Flag.Int("from").pipe(Flag.withDefault(0), Flag.withSchema(Seq)),
  search: Flag.String("search").pipe(Flag.withDefault("")),
}, showHistory, (output) => [
  `Folded through ${output.main} (event ${output.seq}).`,
  ...output.epics.map((epic) => `${epic.id}  ${epic.title}  ${epic.commits}`),
  ...output.open.map((commit) => `${commit.id}  ${commit.state}  ${commit.title}`),
  ...(output.commits.length === 0 ? [] : ["", ...output.commits.map((commit) => `${commit.id}  ${commit.state}  ${commit.title}`), `${output.commits.length} of ${output.total}`]),
  ...(output.commit === null ? [] : [
    "", `${output.commit.id}  ${output.commit.state}  ${output.commit.title}`,
    ...output.commit.notes,
    ...output.commit.real.map((sha) => `real ${sha}`),
  ]),
].join("\n"))

export const PlanWork = define("plan", "Plan a task onto the mythical history: append to --epic (or a --new-epic), insert --before a commit, or --amend a landed one.", PlanInput, WrittenOutput, {
  title: Argument.String("title"),
  epic: Flag.String("epic").pipe(Flag.withDefault("")),
  newEpic: Flag.String("new-epic").pipe(Flag.withDefault("")),
  before: Flag.String("before").pipe(Flag.withDefault("")),
  amend: Flag.String("amend").pipe(Flag.withDefault("")),
  task: Flag.String("task").pipe(Flag.withDefault("")),
}, plan, (output) => `Planned ${output.id}.`, HISTORY_REFUSED)

export const StartWork = define("start", "Start work on a planned mythical commit in a lane.", StartInput, WrittenOutput, {
  id: Argument.String("id").pipe(Argument.withSchema(Id)),
  lane: Flag.String("lane").pipe(Flag.withSchema(Id)),
}, start, (output) => `Started ${output.id}.`, HISTORY_REFUSED)

export const AddNote = define("note", "Add a note to a mythical commit: tried, evidence or superseded.", NoteInput, WrittenOutput, {
  id: Argument.String("id").pipe(Argument.withSchema(Id)),
  section: Flag.ChoiceWithValue("section", [["tried", "tried"], ["evidence", "evidence"], ["superseded", "superseded"]] as const),
  text: Argument.String("text"),
}, note, (output) => `Noted ${output.id}.`, HISTORY_REFUSED)

const operationId = Schema.String.pipe(Schema.withDecodingDefaultKey(succeed("")))
export schema SandboxInput { readonly conversation: conversation; readonly operationId: operationId }
export schema SandboxGenerationInput { readonly conversation: conversation; readonly operationId: operationId; readonly generation: Seq }
export schema SandboxRunInput { readonly conversation: conversation; readonly operationId: operationId; readonly generation: Seq; readonly command: string }
export schema TerminalOutput { readonly output: string }
const sandboxFlags = { conversation: Flag.String("conversation").pipe(Flag.withDefault("home")), operationId: Flag.String("operation-id").pipe(Flag.withDefault("")) }
export const Sandboxes = define("sandboxes", "Read the sandbox and minutes in a conversation.", ReadInput, SandboxSnapshot, { conversation: sandboxFlags.conversation, after: Flag.Int("after").pipe(Flag.withSchema(Seq)).pipe(Flag.withDefault(0)) }, effect (input) => (try (try Factory).sandbox(input.conversation)), (s) => `${s.id || "Sandboxes"}  ${s.status}  ${s.remaining} min`)
export const StartSandbox = define("sandbox-start", "Start a sandbox through the shared allowance flow.", SandboxInput, SandboxSnapshot, sandboxFlags, effect (input) => {
  const id = input.operationId || (try IdGenerator.defaultIdGenerator.generateId())
  return try (try Factory).startSandbox(input.conversation, id)
}, (s) => `${s.id}  ${s.status}  ${s.remaining} min`)
export const StopSandbox = define("sandbox-stop", "Stop a sandbox generation and retain its files.", SandboxGenerationInput, SandboxSnapshot, { ...sandboxFlags, generation: Flag.Int("generation").pipe(Flag.withSchema(Seq)) }, effect (input) => {
  const id = input.operationId || (try IdGenerator.defaultIdGenerator.generateId())
  return try (try Factory).stopSandbox(input.conversation, id, input.generation)
}, (s) => `${s.id}  ${s.status}`)
export const RunSandbox = define("sandbox-run", "Run a terminal command in a sandbox generation.", SandboxRunInput, TerminalOutput, { ...sandboxFlags, generation: Flag.Int("generation").pipe(Flag.withSchema(Seq)), command: Argument.String("command") }, effect (input) => {
  const id = input.operationId || (try IdGenerator.defaultIdGenerator.generateId())
  return { output: try (try Factory).sandboxCommand(input.conversation, id, input.command, input.generation) }
}, (s) => s.output)
export const commands = [Ask, Read, ShowHistory, PlanWork, StartWork, AddNote, Sandboxes, StartSandbox, StopSandbox, RunSandbox] as const
