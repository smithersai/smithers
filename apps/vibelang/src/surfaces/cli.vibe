import { Command, Flag, GlobalFlag } from "effect/cli"
import { commands } from "./commands.vibe"
import { backend } from "./backend.vibe"
import { manifest } from "./manifest.vibe"

const Json = GlobalFlag.Setting("json")({ flag: Flag.Boolean("json").pipe(Flag.withDefault(false), Flag.withDescription("Print JSON.")) })
const Mock = GlobalFlag.Setting("mock")({ flag: Flag.Boolean("mock").pipe(Flag.withDefault(false), Flag.withDescription("Use the mock Factory.")) })
const Llms = GlobalFlag.Action({
  flag: Flag.Boolean("llms").pipe(Flag.withDescription("Print the command manifest for agents.")),
  run: () => Console.log(manifest),
})

function commandFor<D extends (typeof commands)[number]>(definition: D, environment: string | undefined) {
  return Command.make(definition.name, definition.parameters, effect (input) => {
    const json = try Json
    const mock = try Mock
    provide backend(mock, environment, definition.name !== "login" && definition.name !== "logout") {
      try Console.log(try definition.render(input, json))
    }
  }).pipe(Command.withDescription(definition.description))
}

export effect function cli(args: ReadonlyArray<string>, environment: string | undefined) {
  const root = Command.make("vibelang-factory").pipe(
    Command.withDescription("Talk to the VibeLang Factory."),
    Command.withSubcommands(commands.map((command) => commandFor(command, environment))),
    Command.withGlobalFlags([Json, Mock, Llms]),
  )
  const result = Command.runWith(root, { version: "0.0.0", renderErrors: true })(args) catch effect (error) => {
    if (error._tag === "ShowHelp" && error.errors.length === 0) return true
    if (error._tag !== "ShowHelp") try Console.error(error.message)
    return false
  }
  return result === false ? 1 : 0
}
