import { Factory } from "../core/Factory.vibe"
import { liveHealth, prefersMock } from "../core/protocolDecision.vibe"

import { FetchHttpClient, HttpClient, HttpClientRequest } from "effect/http"
import { health, LiveFactory } from "../core/LiveFactory.vibe"
import { mockFactoryFor, MockFactory } from "../core/MockFactory.vibe"
import { LiveActions } from "../actions/LiveActions.vibe"
import { MockActions } from "../actions/MockActions.vibe"
import { AgentActions } from "../actions/agent.vibe"
import { Actions } from "../actions/Actions.vibe"
import { LiveMythical } from "../history/LiveMythical.vibe"
import { MockMythical } from "../history/MockMythical.vibe"
import type { Principal } from "../history/roles.vibe"

/**
 * Who the mock history's CLI and MCP caller is: the agent, for a maintainer, as these surfaces are how agents work on
 * VibeLang (VL-26). The flows refuse it what they refuse any agent: approving and folding.
 */
export const SURFACE_PRINCIPAL: Principal = { role: "maintainer", name: "Factory CLI", agent: true }

export schema error LiveBackendNotDeployed { readonly message: string }

/** Where the live Factory runs unless `VIBELANG_FACTORY_URL` names another deployment, such as a local `alchemy dev`. */
export const DEFAULT_FACTORY_URL = "https://vibelang.smithers.sh"

/** `VIBELANG_FACTORY_URL`: the live Factory's origin. */
export const factoryUrl = Config.String("VIBELANG_FACTORY_URL").pipe(Config.withDefault(DEFAULT_FACTORY_URL))

export function notDeployed(origin: string): string {
  return `The live Factory backend is not deployed at ${origin}. Use --mock or VIBELANG_FACTORY=mock.`
}

export function unreachable(origin: string): string {
  return `The live Factory at ${origin} can't be reached. Use --mock or VIBELANG_FACTORY=mock.`
}

/** Carries an explicitly supplied app session only to its exact origin. It never contains a GitHub token. */
export effect function personClient(origin: string, session?: Redacted.Redacted<string>) {
  const client = try HttpClient.HttpClient
  if (session === undefined) return client
  const parsed = try Effect.try({ try: () => JSON.parse(Redacted.value(session)) as unknown, catch: () => new LiveBackendNotDeployed({ message: "Invalid VIBELANG_SESSION." }) })
  const decoded = Schema.decodeUnknownOption(Schema.Struct({ origin: Schema.String, cookie: Schema.String }))(parsed)
  if (Option.isNone(decoded) || decoded.value.origin !== origin || !/^__Host-vibelang-session=[A-Za-z0-9_.:-]{1,4096}$/.test(decoded.value.cookie)) throw new LiveBackendNotDeployed({ message: "Invalid VIBELANG_SESSION." })
  const credential = decoded.value
  return client.pipe(HttpClient.mapRequest((request) => request.url.startsWith(origin + "/")
    ? request.pipe(HttpClientRequest.setHeader("cookie", credential.cookie), HttpClientRequest.setHeader("origin", origin)) : request))
}

/** The live Factory, once its origin's health says it runs the live agent. */
const live = Layer.unwrap(effect {
  const origin = (try factoryUrl).replace(/\/+$/, "")
  const configured = try Config.option(Config.Redacted("VIBELANG_SESSION"))
  const client = try personClient(origin, Option.getOrUndefined(configured))
  const answer = health(origin).pipe(Effect.provideService(HttpClient.HttpClient, client)) catch effect () => {
    throw new LiveBackendNotDeployed({ message: unreachable(origin) })
  }
  if (!liveHealth(answer.agent)) throw new LiveBackendNotDeployed({ message: notDeployed(origin) })
  return Layer.mergeAll(LiveFactory(origin), LiveMythical(origin), LiveActions(origin)).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, client)))
}).pipe(Layer.provide(FetchHttpClient.layer.pipe(Layer.provide(Layer.succeed(FetchHttpClient.RequestInit, { redirect: "error" })))))

const mockFactory = mockFactoryFor(SURFACE_PRINCIPAL.role)
const chooseMaintainer = Layer.effectDiscard(effect {
  const factory = try Factory
  if (factory.accounts !== undefined) try Effect.orDie(factory.accounts.choose("maintainer"))
}).pipe(Layer.provide(mockFactory))
const mockBase = Layer.mergeAll(mockFactory, MockMythical(SURFACE_PRINCIPAL), MockActions({ role: SURFACE_PRINCIPAL.role, actor: "agent" }).pipe(Layer.provide(mockFactory)), chooseMaintainer)
const mock = Layer.effect(AgentActions, effect { return { actions: try Actions } }).pipe(Layer.provideMerge(mockBase))

/** Backend choice belongs to the host: `--mock` or `VIBELANG_FACTORY=mock` for the mock, else the live Factory. */
export function backend(useMock: boolean, environment: string | undefined) {
  return prefersMock(useMock, environment) ? mock : live
}
