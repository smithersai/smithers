// Native sign-in actions use the SDK's durable SQLite host. Only bounded statuses reach its journal;
// credentials remain in the private settings files or inside an action's transport, never in flow payloads/results.
import { Action, Flow, FlowRuntime, Interpreter, Poll, Sleep } from "@smthrs/flow"
import { NodeRuntime } from "@smthrs/platform-node"
import { Node } from "@smthrs/plan"
import { SecureRandom } from "effect/crypto"
import { privateSettings } from "./session.vibe"

export schema error SignInFailed { readonly message: string }
export const Status = Schema.Literals(["started", "pending", "signed-in", "signed-out", "declined", "expired", "failed"])
export type Status = typeof Status.Type

// One declared step per operation; the payload names which one a run takes.
const Login = Action.make("vibelang/session/login", { payload: {}, success: Status, error: SignInFailed })
const PollSession = Action.make("vibelang/session/poll", { payload: {}, success: Status, error: SignInFailed })
const Logout = Action.make("vibelang/session/logout", { payload: {}, success: Status, error: SignInFailed })
const Operation = Flow.make("vibelang/Session", {
  description: "Changes the CLI and MCP sign-in through a private journaled action.",
  payload: { step: Schema.Literals(["login", "poll", "logout"]) }, success: Status, error: SignInFailed,
  body: Node.capture({}, (payload) => Node.succeed(payload.step).pipe(Node.branch({
    if: Node.capture({}, (step) => step === "login"),
    then: () => Login.call({}),
    else: (step) => Node.succeed(step).pipe(Node.branch({
      if: Node.capture({}, (step) => step === "poll"),
      then: () => PollSession.call({}),
      else: () => Logout.call({}),
    })),
  }))),
})
const Check = Action.make("vibelang/session/check", { payload: {}, success: Poll.CheckResult(Status) })
const Wait = Poll.make("vibelang/SessionWait", {
  input: {}, result: Status, intervalMs: 1000, maxAttempts: 3600,
  check: () => Check.call({}),
})

effect function observe(step: string, program: Status!SignInFailed) {
  return try withSpan(onExit(program, result => effect {
    const outcome = Exit.isSuccess(result) ? result.value : "failed"
    try logInfo("vibelang.session").pipe(annotateLogs({ step, outcome }))
    try Metric.update(Metric.withAttributes(Metric.counter("vibelang_session_steps", { incremental: true }), { step, outcome }), 1)
  }), "vibelang.session." + step)
}

effect function runtime<R>(registration: Layer.Layer<never, never, R>) {
  const root = try privateSettings()
  return NodeRuntime.layerHost({ filename: (try Path.Path).join(root, "flows.db"), workspaceRoot: root, owner: { hostId: "vibelang-session" }, signals: [] }, registration)
}

/** A session mutation. The action's only result is its status; its error contains a safe product message. */
export effect function sessionOperation<R>(step: "login" | "poll" | "logout", body: Status!SignInFailed!R) {
  const captured = try context<R>()
  // This run executes only `step`'s action; each operation's implementation is the same observed body.
  const operation = () => observe(step, Effect.provide(body, captured))
  const registration = Interpreter.layerWithImplementations(Operation, Layer.mergeAll(Login.toLayer(operation), PollSession.toLayer(operation), Logout.toLayer(operation)))
  const id = try Effect.provide(effect { return try (try SecureRandom.SecureRandom).uuidV4() }, SecureRandom.layerWebCrypto)
  const host = try runtime(registration)
  return try scoped(Effect.provide(effect {
    return try (try FlowRuntime.FlowRuntime).execute(Operation, { payload: { step }, executionId: "session/" + id })
  }, host))
}

/** SDK polling owns repetitions and durable waits. GitHub's own interval/slow-down is enforced by the check. */
export effect function waitForSignIn<R>(check: Status!SignInFailed!R) {
  const captured = try context<R>()
  const implementations = Check.toLayer(() => effect {
    const output = observe("poll", Effect.provide(check, captured)) catch () => "failed" as const
    return { satisfied: output !== "pending", output }
  })
  const registration = Interpreter.layer(Wait).pipe(Layer.provideMerge(implementations), Layer.provideMerge(Poll.layer), Layer.provideMerge(Sleep.layer), Layer.provideMerge(Action.layerImplementations))
  const root = try privateSettings()
  const id = try Effect.provide(effect { return try (try SecureRandom.SecureRandom).uuidV4() }, SecureRandom.layerWebCrypto)
  const host = NodeRuntime.layerHost({ filename: (try Path.Path).join(root, "flows.db"), workspaceRoot: root, owner: { hostId: "vibelang-session" }, signals: [] }, registration)
  return try scoped(Effect.provide(Wait.execute({}, { executionId: "session-wait/" + id }), host))
}
