// The Factory core's registered workflows API. Person, slash and agent calls share this service and authorization.
import { commandCut } from "./actionHostDecision.vibe"
export type Role = "viewer" | "new" | "community" | "contributor" | "maintainer"
export type Door = "button" | "slash" | "agent"
export type Actor = "person" | "agent"
export schema Step {
  readonly key: string
  readonly name: string
  readonly attempt: number
  readonly state: "running" | "passed" | "failed" | "cancelled" | "waiting"
  readonly started: number
  readonly at: number
}
export schema Run {
  readonly id: string
  readonly flow: string
  readonly door: "button" | "slash" | "agent"
  readonly actor: "person" | "agent"
  readonly state: "queued" | "running" | "passed" | "failed" | "cancelled"
  readonly started: number
  readonly at: number
  readonly result: string
  readonly steps: ReadonlyArray<Step>
}
export schema Registered {
  readonly name: string
  readonly title: string
  readonly detail: string
  readonly command: string
  readonly runnable: boolean
  readonly least: "viewer" | "new" | "community" | "contributor" | "maintainer"
  readonly input: "none" | "text" | "path" | "json"
}
export schema error ActionFailure { code: string }

/**
 * A slash command's leading token and the rest of the text, verbatim: only the whitespace around the whole text and
 * the separator after the command go, so a post keeps its newlines and JSON keeps the spaces inside its strings.
 */
export function splitCommand(text: string): { readonly command: string; readonly rest: string } {
  const trimmed = text.trim()
  const cut = commandCut(trimmed, trimmed.search(/\s/))
  return { command: cut.command, rest: cut.rest.trimStart() }
}
export service Actions {
  list(): ReadonlyArray<Registered>!ActionFailure
  commands(): ReadonlyArray<Registered>!ActionFailure
  runs(flow: string): ReadonlyArray<Run>!ActionFailure
  read(id: string): Run!ActionFailure
  follow(id: string): Stream.Stream<Run, ActionFailure>
  start(flow: string, input: Schema.Json, door: Door): string!ActionFailure
  command(text: string, door?: Door): string!ActionFailure
  rerun(id: string): string!ActionFailure
  cancel(id: string): void!ActionFailure
}
