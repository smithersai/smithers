// Scalar policies used by the live directory and the mock action host (0018, third-lane batch 14).
// A run that settles itself passes or fails. A cancel interrupts the run's fiber before it can settle and records
// `cancelled` itself (MockActions.vibe `cancel`), so no settlement here is a cancellation.
export type MockState = "passed" | "failed"

//@ verify
//@ ensures succeeded && !refusal ==> \result == "passed"
//@ ensures !(succeeded && !refusal) ==> \result == "failed"
export function mockState(succeeded: boolean, refusal: boolean): MockState {
  return succeeded && !refusal ? "passed" : "failed"
}

//@ verify
//@ ensures \result == (least != "viewer" && owner != person)
export function ownerRefused(least: string, owner: string, person: string): boolean {
  return least !== "viewer" && owner !== person
}

//@ verify
//@ ensures \result == (door == "agent" ? "agent" : actor)
export function actionActor(door: string, actor: "person" | "agent"): "person" | "agent" {
  return door === "agent" ? "agent" : actor
}

//@ verify
//@ ensures \result == (filter == "" || flow == filter)
export function matchingFlow(filter: string, flow: string): boolean {
  return filter === "" || flow === filter
}

//@ verify
//@ ensures \result == (id == source || !indexed)
export function indexedRun(id: string, source: string | undefined, indexed: boolean): boolean {
  return id === source || !indexed
}

//@ verify
//@ ensures \result == (id == expected)
export function sameRun(id: string, expected: string): boolean {
  return id === expected
}
