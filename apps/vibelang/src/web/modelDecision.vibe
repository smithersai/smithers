// Decisions inside the web update: stale-response fences, account retries, the role gate and bounded menu movement.

export type AccountRetry = "sign-in" | "people" | "grant" | "sign-out" | "roles"
export type RetryPlan = "resume" | "sign-in" | "command"
export type PeoplePane = "closed" | "pane" | "max"

/** The failure text names the operation being retried; roles and sign-in share the sign-in text. */
//@ verify
//@ ensures retry == "grant" ==> \result == "Role change failed."
//@ ensures retry == "people" ==> \result == "People couldn’t load."
//@ ensures retry == "sign-out" ==> \result == "Sign out failed."
//@ ensures (retry == "sign-in" || retry == "roles") ==> \result == "Sign-in failed. GitHub didn’t answer."
export function accountFailureText(retry: AccountRetry): string {
  if (retry === "grant") return "Role change failed."
  if (retry === "people") return "People couldn’t load."
  if (retry === "sign-out") return "Sign out failed."
  return "Sign-in failed. GitHub didn’t answer."
}

/** Retry resumes the role stream, re-enters the sign-in guard, or repeats the one failed command. */
//@ verify
//@ ensures retry == "roles" ==> \result == "resume"
//@ ensures retry == "sign-in" ==> \result == "sign-in"
//@ ensures (retry == "people" || retry == "grant" || retry == "sign-out") ==> \result == "command"
export function accountRetryPlan(retry: AccountRetry): RetryPlan {
  if (retry === "roles") return "resume"
  if (retry === "sign-in") return "sign-in"
  return "command"
}

/** Live sign-in is refused only when the server said it is unavailable. */
//@ verify
//@ ensures \result == (live && reportedUnavailable)
export function signInRefused(live: boolean, reportedUnavailable: boolean): boolean {
  return live && reportedUnavailable
}

/** Only a maintainer can open the role dialog. */
//@ verify
//@ ensures \result == (role == "maintainer")
export function canSelectRole(role: string): boolean {
  return role === "maintainer"
}

/** People opens maximized only when it takes over a maximized docs page. */
//@ verify
//@ ensures docsMaximized ==> \result == "max"
//@ ensures !docsMaximized ==> \result == "pane"
export function peopleOpened(docsMaximized: boolean): PeoplePane {
  return docsMaximized ? "max" : "pane"
}

/** The size control flips max to pane and anything else to max. */
//@ verify
//@ ensures pane == "max" ==> \result == "pane"
//@ ensures pane != "max" ==> \result == "max"
export function peopleToggled(pane: PeoplePane): PeoplePane {
  return pane === "max" ? "pane" : "max"
}

/** A changed person or role drops role-scoped data. */
//@ verify
//@ ensures \result == (nextId != currentId || nextRole != currentRole)
export function accountChanged(nextId: string, currentId: string, nextRole: string, currentRole: string): boolean {
  return nextId !== currentId || nextRole !== currentRole
}

/** A grant counts only when the sequence advanced and the role table grew. */
//@ verify
//@ ensures \result == (nextSeq > currentSeq && nextRoles > currentRoles)
export function roleGrantApplied(nextSeq: number, currentSeq: number, nextRoles: number, currentRoles: number): boolean {
  return nextSeq > currentSeq && nextRoles > currentRoles
}

/** Losing maintainer closes an open role dialog. */
//@ verify
//@ ensures \result == (role != "maintainer" && target != "")
export function roleDialogCloses(role: string, target: string): boolean {
  return role !== "maintainer" && target !== ""
}

/** Absent epochs mean epoch zero. */
//@ verify
//@ ensures incoming == null && current == null ==> \result == true
//@ ensures incoming != null && current != null ==> \result == (incoming == current)
//@ ensures incoming == null && current != null ==> \result == (current == 0)
//@ ensures incoming != null && current == null ==> \result == (incoming == 0)
export function actionsEpochCurrent(incoming: number | null, current: number | null): boolean {
  const left = incoming === null ? 0 : incoming
  const right = current === null ? 0 : current
  return left === right
}

/** A failure with no epoch always applies; a tagged failure must match. */
//@ verify
//@ ensures incoming == null ==> \result == true
//@ ensures incoming != null && current != null ==> \result == (incoming == current)
//@ ensures incoming != null && current == null ==> \result == (incoming == 0)
export function actionsFailureApplies(incoming: number | null, current: number | null): boolean {
  if (incoming === null) return true
  return incoming === (current === null ? 0 : current)
}

/** The actions clock never moves backward. */
//@ verify
//@ ensures \result >= now && \result >= at
//@ ensures \result == now || \result == at
export function actionsClock(now: number, at: number): number {
  return at > now ? at : now
}

/** Arrow keys wrap inside the menu and stay in range even after the menu shrinks. */
//@ verify
//@ requires highlight >= 0 && -1 <= delta && delta <= 1 && length >= 0
//@ ensures length == 0 ==> \result == 0
//@ ensures length > 0 ==> 0 <= \result && \result < length
//@ ensures length > 0 && 0 <= highlight + delta && highlight + delta < length ==> \result == highlight + delta
//@ ensures length > 0 && highlight == 0 && delta == -1 ==> \result == length - 1
//@ ensures length > 0 && highlight == length - 1 && delta == 1 ==> \result == 0
export function slashHighlight(highlight: number, delta: number, length: number): number {
  return length === 0 ? 0 : (highlight + delta + length) % length
}

/** A mutating response is settled by its own retry, or by any response when nothing is retrying. */
//@ verify
//@ ensures retryOp == null ==> \result == true
//@ ensures retryOp != null ==> \result == (retryOp == op && retryKey == key)
export function issueResponseSettles(retryOp: string | null, retryKey: string | null, op: string | null, key: string | null): boolean {
  return retryOp === null || (retryOp === op && retryKey === key)
}

/** Details apply only to the selected issue and never move the sequence backward. */
//@ verify
//@ ensures \result == (selected == issue && incomingSeq >= currentSeq)
export function issueDetailsApply(selected: number, issue: number, incomingSeq: number, currentSeq: number): boolean {
  return selected === issue && !(incomingSeq < currentSeq)
}

/** A details failure shows only for the selected issue and never over a mutation's retry. */
//@ verify
//@ ensures \result == (selected == issue && !retrying)
export function issueDetailsFailureShows(selected: number, issue: number, retrying: boolean): boolean {
  return selected === issue && !retrying
}

/** Only the latest loading wiki request can fail the page. */
//@ verify
//@ ensures \result == (request == currentRequest && loading)
export function wikiFailureApplies(request: number, currentRequest: number, loading: boolean): boolean {
  return request === currentRequest && loading
}

/** A stopped real sandbox with no minutes left shows the zero notice. */
//@ verify
//@ ensures \result == (remaining == 0 && id != "" && status == "stopped")
export function sandboxOutOfMinutes(remaining: number, id: string, status: string): boolean {
  return remaining === 0 && id !== "" && status === "stopped"
}

/** The low-minutes notice shows once per reset month. */
//@ verify
//@ ensures \result == (remaining > 0 && remaining <= 10 && warnedMonth != resetAt)
export function sandboxLowMinutes(remaining: number, warnedMonth: number | null, resetAt: number): boolean {
  return remaining > 0 && remaining <= 10 && warnedMonth !== resetAt
}

/** The pane opens on the transition into running, and only then. */
//@ verify
//@ ensures \result == (status == "running" && previous != "running")
export function sandboxPaneOpens(status: string, previous: string | null): boolean {
  return status === "running" && previous !== "running"
}

// ACCOUNT UPDATE
// The account arms of `update` in main.vibe, on plain data: the state they touch, and commands main.vibe interprets.

export type GrantableRole = "new" | "community" | "contributor" | "maintainer"
export interface AccountScreen {
  readonly surface: "splash" | "chat"
  readonly docs: "pane" | "max"
  readonly menu: boolean
  readonly people: PeoplePane
  readonly pending: boolean
  readonly error: string
  readonly retry: AccountRetry
  readonly target: string
  readonly targetRole: GrantableRole
  readonly epoch: number
  readonly from: number
}
export type AccountCommand =
  | { readonly type: "FocusAccountMenu"; readonly open: boolean }
  | { readonly type: "SignIn"; readonly mock: boolean }
  | { readonly type: "SignOut" }
  | { readonly type: "LoadPeople" }
  | { readonly type: "ShowRoleDialog" }
  | { readonly type: "CloseRoleDialog" }
  | { readonly type: "GrantRole"; readonly id: string; readonly role: GrantableRole }
export interface AccountStep { readonly state: AccountScreen; readonly commands: ReadonlyArray<AccountCommand> }

/** The account button flips the menu and moves focus with it. */
//@ verify
//@ ensures \result.state == { ...state, menu: !state.menu }
//@ ensures \result.commands == [{ type: "FocusAccountMenu", open: !state.menu }]
export function clickedAccount(state: AccountScreen): AccountStep {
  return { state: { ...state, menu: !state.menu }, commands: [{ type: "FocusAccountMenu", open: !state.menu }] }
}

/** Sign-in starts unless the live server said it is unavailable; a refusal names itself and starts nothing. */
//@ verify
//@ ensures signInRefused(live, unavailable) ==> \result.state == { ...state, pending: false, retry: "sign-in", error: "Sign-in unavailable." }
//@ ensures signInRefused(live, unavailable) ==> \result.commands == []
//@ ensures !signInRefused(live, unavailable) ==> \result.state == { ...state, pending: true, error: "", retry: "sign-in" }
//@ ensures !signInRefused(live, unavailable) ==> \result.commands == [{ type: "SignIn", mock: mock }]
export function clickedSignIn(state: AccountScreen, live: boolean, unavailable: boolean, mock: boolean): AccountStep {
  if (signInRefused(live, unavailable)) return { state: { ...state, pending: false, retry: "sign-in", error: "Sign-in unavailable." }, commands: [] }
  return { state: { ...state, pending: true, error: "", retry: "sign-in" }, commands: [{ type: "SignIn", mock }] }
}

/** Sign-out records what a retry repeats. */
//@ verify
//@ ensures \result.state == { ...state, retry: "sign-out" }
//@ ensures \result.commands == [{ type: "SignOut" }]
export function clickedSignOut(state: AccountScreen): AccountStep {
  return { state: { ...state, retry: "sign-out" }, commands: [{ type: "SignOut" }] }
}

/** People shows the chat, takes over a maximized page, closes the menu and loads the list. */
//@ verify
//@ ensures \result.state == { ...state, surface: "chat", docs: "pane", menu: false, people: peopleOpened(state.docs == "max"), retry: "people" }
//@ ensures \result.commands == [{ type: "LoadPeople" }]
export function clickedPeople(state: AccountScreen): AccountStep {
  return { state: { ...state, surface: "chat", docs: "pane", menu: false, people: peopleOpened(state.docs === "max"), retry: "people" }, commands: [{ type: "LoadPeople" }] }
}

/** Closing People changes only the pane. */
//@ verify
//@ ensures \result.state == { ...state, people: "closed" }
//@ ensures \result.commands == []
export function closedPeople(state: AccountScreen): AccountStep {
  return { state: { ...state, people: "closed" }, commands: [] }
}

/** The size control changes only the pane. */
//@ verify
//@ ensures \result.state == { ...state, people: peopleToggled(state.people) }
//@ ensures \result.commands == []
export function toggledPeople(state: AccountScreen): AccountStep {
  return { state: { ...state, people: peopleToggled(state.people) }, commands: [] }
}

/** Choosing a person's role opens the dialog on that person, clearing an older failure. */
//@ verify
//@ ensures \result.state == { ...state, target: id, targetRole: role, error: "" }
//@ ensures \result.commands == [{ type: "ShowRoleDialog" }]
export function selectedRole(state: AccountScreen, id: string, role: GrantableRole): AccountStep {
  return { state: { ...state, target: id, targetRole: role, error: "" }, commands: [{ type: "ShowRoleDialog" }] }
}

/** Cancel closes the dialog and forgets its person. */
//@ verify
//@ ensures \result.state == { ...state, target: "", error: "" }
//@ ensures \result.commands == [{ type: "CloseRoleDialog" }]
export function cancelledRole(state: AccountScreen): AccountStep {
  return { state: { ...state, target: "", error: "" }, commands: [{ type: "CloseRoleDialog" }] }
}

/** Confirm sends exactly the chosen person and role, and records what a retry repeats. */
//@ verify
//@ ensures \result.state == { ...state, pending: true, retry: "grant" }
//@ ensures \result.commands == [{ type: "GrantRole", id: state.target, role: state.targetRole }]
export function confirmedRole(state: AccountScreen): AccountStep {
  return { state: { ...state, pending: true, retry: "grant" }, commands: [{ type: "GrantRole", id: state.target, role: state.targetRole }] }
}

/** A finished grant closes the dialog first, then reloads the list. */
//@ verify
//@ ensures \result.state == { ...state, target: "", pending: false }
//@ ensures \result.commands == [{ type: "CloseRoleDialog" }, { type: "LoadPeople" }]
export function grantedRole(state: AccountScreen): AccountStep {
  return { state: { ...state, target: "", pending: false }, commands: [{ type: "CloseRoleDialog" }, { type: "LoadPeople" }] }
}

/** A lost role stream stops waiting and offers its resume. */
//@ verify
//@ ensures \result.state == { ...state, error: "Connection lost.", retry: "roles", pending: false }
//@ ensures \result.commands == []
export function failedRoles(state: AccountScreen): AccountStep {
  return { state: { ...state, error: "Connection lost.", retry: "roles", pending: false }, commands: [] }
}

/** A failed request stops waiting and names the operation a retry repeats. */
//@ verify
//@ ensures \result.state == { ...state, pending: false, error: accountFailureText(state.retry) }
//@ ensures \result.commands == []
export function accountFailed(state: AccountScreen): AccountStep {
  return { state: { ...state, pending: false, error: accountFailureText(state.retry) }, commands: [] }
}

/** Dismiss clears only the failure. */
//@ verify
//@ ensures \result.state == { ...state, error: "" }
//@ ensures \result.commands == []
export function dismissedAccountError(state: AccountScreen): AccountStep {
  return { state: { ...state, error: "" }, commands: [] }
}

/** Retry resumes the role stream from the ledger, or repeats the one failed command. Sign-in re-enters its own guard in main.vibe. */
//@ verify
//@ requires state.retry != "sign-in"
//@ ensures state.retry == "roles" ==> \result.state == { ...state, error: "", pending: false, epoch: state.epoch + 1, from: ledgerSeq }
//@ ensures state.retry == "roles" ==> \result.commands == []
//@ ensures state.retry != "roles" ==> \result.state == { ...state, pending: true, error: "" }
//@ ensures state.retry == "grant" ==> \result.commands == [{ type: "GrantRole", id: state.target, role: state.targetRole }]
//@ ensures state.retry == "people" ==> \result.commands == [{ type: "LoadPeople" }]
//@ ensures state.retry == "sign-out" ==> \result.commands == [{ type: "SignOut" }]
export function retriedAccount(state: AccountScreen, ledgerSeq: number): AccountStep {
  if (accountRetryPlan(state.retry) === "resume") return { state: { ...state, error: "", pending: false, epoch: state.epoch + 1, from: ledgerSeq }, commands: [] }
  const waiting: AccountScreen = { ...state, pending: true, error: "" }
  if (state.retry === "grant") return { state: waiting, commands: [{ type: "GrantRole", id: state.target, role: state.targetRole }] }
  if (state.retry === "people") return { state: waiting, commands: [{ type: "LoadPeople" }] }
  return { state: waiting, commands: [{ type: "SignOut" }] }
}
