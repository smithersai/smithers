// Writing a proved step's state back over the page's Model (decision 0018). `update`'s account and actions arms
// decide a step in `modelDecision.vibe`; these state that the next Model is the old one with exactly that state written.
import type { AccountState, Model } from "./main.vibe"
import type { ActionView } from "./actionModel.vibe"
import type { AccountScreen, ActionScreen, RunSelection } from "./modelDecision.vibe"
import type { AfterUpdate, EscapeRoute, EscapeStep, EventPlan, WikiVisit } from "./updateDecision.vibe"
import type { SandboxPane, StreamScreen, TourEnd, TourKeep, TourStarted } from "./tourDecision.vibe"
import type { SandboxResult, SandboxScreen, WikiEditScreen } from "./paneDecision.vibe"
import { pressedEscape } from "./updateDecision.vibe"
import { escapeScreen, screenOf } from "./screenRead.vibe"
import type { ScreenState } from "./screenDecision.vibe"
import type { IssueScreen } from "./issueDecision.vibe"

type Issues = NonNullable<Model["issues"]>
type WikiEditing = NonNullable<Model["wikiEdit"]>

/** The Model after an account step: `surface` and `docs` from the step, the account's screen fields over `base` (the
 *  current account, or the signed-out one), and every other field of the Model and of `base` unchanged. */
//@ verify
//@ ensures \result == { ...model, surface: state.surface, docs: state.docs, account: { ...base, menu: state.menu, people: state.people, pending: state.pending, error: state.error, retry: state.retry, target: state.target, targetRole: state.targetRole, epoch: state.epoch, from: state.from } }
export function writeAccount(model: Model, base: AccountState, state: AccountScreen): Model {
  const account: AccountState = { ...base, menu: state.menu, people: state.people, pending: state.pending, error: state.error, retry: state.retry, target: state.target, targetRole: state.targetRole, epoch: state.epoch, from: state.from }
  return { ...model, surface: state.surface, docs: state.docs, account }
}

/** The Model after an actions step: the panel's screen fields over `base` (the current panel, or the initial one), and
 *  every other field of the Model and of `base` unchanged. */
//@ verify
//@ ensures \result == { ...model, actions: { ...base, open: state.open, maximized: state.maximized, selected: state.selected, run: state.run, loading: state.loading, starting: state.starting, error: state.error, input: state.input, highlight: state.highlight } }
export function writeActions(model: Model, base: ActionView, state: ActionScreen): Model {
  const actions: ActionView = { ...base, open: state.open, maximized: state.maximized, selected: state.selected, run: state.run, loading: state.loading, starting: state.starting, error: state.error, input: state.input, highlight: state.highlight }
  return { ...model, actions }
}

/** The Model after Escape closes one thing: exactly the field the step's kind closes, from the step's state, over the
 *  current account (`account`), panel (`actions`) and issues screen (`issues`). Escape's tour, palette and splash
 *  kinds end the tour, close the palette and shrink the splash through their own steps; for them, as for `none`, the
 *  Model is unchanged here. */
//@ verify
//@ ensures step.kind == "role" ==> \result == { ...model, account: { ...account, target: step.state.target, error: step.state.error } }
//@ ensures step.kind == "issue-dialog" ==> \result == { ...model, issues: { ...issues, dialog: step.state.dialog } }
//@ ensures step.kind == "slash" ==> \result == { ...model, actions: { ...actions, slash: step.state.slash } }
//@ ensures step.kind == "menu" ==> \result == { ...model, account: { ...account, menu: step.state.menu } }
//@ ensures step.kind == "issues" ==> \result == { ...model, issues: { ...issues, open: step.state.issuesOpen } }
//@ ensures step.kind == "actions" ==> \result == { ...model, actions: { ...actions, maximized: step.state.actionsMax } }
//@ ensures step.kind == "wiki" ==> \result == { ...model, wikiEdit: undefined }
//@ ensures step.kind == "sandbox" ==> \result == { ...model, sandboxPane: "pane" }
//@ ensures step.kind == "docs" ==> \result == { ...model, docs: step.state.docs }
//@ ensures step.kind == "tour" || step.kind == "palette" || step.kind == "splash" || step.kind == "none" ==> \result == model
export function escapeWrite(model: Model, account: AccountState, actions: ActionView, issues: NonNullable<Model["issues"]>, step: EscapeStep): Model {
  const { state } = step
  switch (step.kind) {
    case "role": return { ...model, account: { ...account, target: state.target, error: state.error } }
    case "issue-dialog": return { ...model, issues: { ...issues, dialog: state.dialog } }
    case "slash": return { ...model, actions: { ...actions, slash: state.slash } }
    case "menu": return { ...model, account: { ...account, menu: state.menu } }
    case "issues": return { ...model, issues: { ...issues, open: state.issuesOpen } }
    case "actions": return { ...model, actions: { ...actions, maximized: state.actionsMax } }
    case "wiki": return { ...model, wikiEdit: undefined }
    case "sandbox": return { ...model, sandboxPane: "pane" }
    case "docs": return { ...model, docs: state.docs }
    case "tour": return model
    case "palette": return model
    case "splash": return model
    case "none": return model
  }
}

/** Escape writes the issues screen only when the Model has one: it closes the issues dialog or list only when the
 *  screen it read shows them open, and an absent issues screen reads as closed. */
//@ verify
//@ ensures \result ==> model.issues !== undefined
export function escapeWritesIssues(model: Model, account: AccountState, actions: ActionView, route: EscapeRoute, wikiPane: boolean): boolean {
  const kind = pressedEscape(escapeScreen(model, account, actions), route, wikiPane).kind
  return kind === "issue-dialog" || kind === "issues"
}

/** The Model after a tour ends: the ended screen's tour flags, surface, palette, draft, docs and sandbox pane; the
 *  issues list's open flag over `issues`; the slash menu and panel size over `actions`; nothing else. */
//@ verify
//@ ensures \result == { ...model, tour: ended.tour, tourDismissed: ended.tourDismissed, surface: ended.surface, palette: ended.palette, draft: ended.draft, docs: ended.docs, sandboxPane: ended.sandboxPane, issues: { ...issues, open: ended.issuesOpen }, actions: { ...actions, slash: ended.slash, maximized: ended.maximized } }
export function tourEndWrite(model: Model, issues: NonNullable<Model["issues"]>, actions: ActionView, ended: TourEnd): Model {
  return { ...model, tour: ended.tour, tourDismissed: ended.tourDismissed, surface: ended.surface, palette: ended.palette, draft: ended.draft, docs: ended.docs, sandboxPane: ended.sandboxPane, issues: { ...issues, open: ended.issuesOpen }, actions: { ...actions, slash: ended.slash, maximized: ended.maximized } }
}

/** The Model after Learn more starts a tour: the started screen's fields; the theatre's step, pause and target; a
 *  fresh tour client; the conversation's client fresh exactly when the step resets it; nothing else. */
//@ verify
//@ ensures \result == { ...model, tour: step.state.tour, toured: step.state.toured, tourDismissed: step.state.tourDismissed, autoTour: step.state.autoTour, surface: step.state.surface, palette: step.state.palette, docs: step.state.docs, tourError: step.state.tourError, conversation: step.state.conversation, client: step.resetClient ? fresh : model.client, wikiAfter: step.state.wikiAfter, wikiStatus: step.state.wikiStatus, tourClient: fresh, theatre: { ...model.theatre, step: step.state.step, paused: step.state.paused, target: step.state.target }, epoch: step.state.epoch, from: step.state.from, stream: step.state.stream }
export function tourStartWrite(model: Model, step: TourStarted, fresh: Model["client"]): Model {
  const started = step.state
  return { ...model, tour: started.tour, toured: started.toured, tourDismissed: started.tourDismissed, autoTour: started.autoTour, surface: started.surface, palette: started.palette, docs: started.docs, tourError: started.tourError, conversation: started.conversation,
    client: step.resetClient ? fresh : model.client, wikiAfter: started.wikiAfter, wikiStatus: started.wikiStatus,
    tourClient: fresh, theatre: { ...model.theatre, step: started.step, paused: started.paused, target: started.target },
    epoch: started.epoch, from: started.from, stream: started.stream,
  }
}

/** The Model after a sandbox action starts: the screen's surface, palette and docs, and its pane, operation, busy flag,
 *  error, request number and terminal draft; nothing else. */
//@ verify
//@ ensures \result == { ...model, surface: state.surface, palette: state.palette, docs: state.docs, sandboxPane: state.pane, sandboxOperation: state.operation, sandboxBusy: state.busy, sandboxError: state.error, sandboxRequest: state.request, terminalDraft: state.draft }
export function sandboxWrite(model: Model, state: SandboxScreen): Model {
  return { ...model, surface: state.surface, palette: state.palette, docs: state.docs, sandboxPane: state.pane, sandboxOperation: state.operation, sandboxBusy: state.busy, sandboxError: state.error, sandboxRequest: state.request, terminalDraft: state.draft }
}

/** The Model after a sandbox answers: its pane, busy flag, operation and error; nothing else. */
//@ verify
//@ ensures \result == { ...model, sandboxPane: result.pane, sandboxBusy: result.busy, sandboxOperation: result.operation, sandboxError: result.error }
export function sandboxResultWrite(model: Model, result: SandboxResult): Model {
  return { ...model, sandboxPane: result.pane, sandboxBusy: result.busy, sandboxOperation: result.operation, sandboxError: result.error }
}

/** The Model after a sandbox fails: its busy flag and error; the pane and operation stay as they are, absent or not. */
//@ verify
//@ ensures \result == { ...model, sandboxBusy: result.busy, sandboxError: result.error }
export function sandboxFailureWrite(model: Model, result: SandboxResult): Model {
  return { ...model, sandboxBusy: result.busy, sandboxError: result.error }
}

/** The Model after a wiki page opens: the chat with the palette closed and the page loading, the visit's request number,
 *  docked panes and stream, an editor kept only while it saves, following paused, the search cleared; the account
 *  changes only when its People pane docks. */
//@ verify
//@ ensures visit.people == account.people ==> \result == { ...model, wikiEdit: visit.keepEdit ? model.wikiEdit : undefined, wikiRequest: visit.request, sandboxPane: visit.sandboxPane, surface: "chat", palette: false, wikiQuery: "", wikiRequested: page, wikiStatus: "loading", following: false, stream: "open", epoch: visit.epoch, from: visit.from }
//@ ensures visit.people != account.people ==> \result == { ...model, wikiEdit: visit.keepEdit ? model.wikiEdit : undefined, wikiRequest: visit.request, sandboxPane: visit.sandboxPane, surface: "chat", palette: false, wikiQuery: "", wikiRequested: page, wikiStatus: "loading", following: false, stream: "open", epoch: visit.epoch, from: visit.from, account: { ...account, people: visit.people } }
export function wikiVisitWrite(model: Model, account: AccountState, visit: WikiVisit, page: string): Model {
  const visited: Model = { ...model, wikiEdit: visit.keepEdit ? model.wikiEdit : undefined, wikiRequest: visit.request, sandboxPane: visit.sandboxPane, surface: "chat", palette: false, wikiQuery: "", wikiRequested: page, wikiStatus: "loading", following: false, stream: "open", epoch: visit.epoch, from: visit.from }
  return visit.people === account.people ? visited : { ...visited, account: { ...account, people: visit.people } }
}

/** The Model after a screen step: the screen's six fields, nothing else. */
//@ verify
//@ ensures \result == { ...model, surface: screen.surface, palette: screen.palette, tour: screen.tour, tourError: screen.tourError, docs: screen.docs, following: screen.following }
export function screenWrite(model: Model, screen: ScreenState): Model {
  return { ...model, surface: screen.surface, palette: screen.palette, tour: screen.tour, tourError: screen.tourError, docs: screen.docs, following: screen.following }
}

/** Writing back the screen just read changes nothing. */
//@ verify
//@ ensures \result == model
export function screenKept(model: Model): Model {
  return screenWrite(model, screenOf(model))
}

/** The Model after ⌘K switches mode: the draft cleared, the palette and the slash menu over `actions` closed; nothing
 *  else. */
//@ verify
//@ ensures \result == { ...model, draft: "", palette: false, actions: { ...actions, slash: false } }
export function modeSwitchWrite(model: Model, actions: ActionView): Model {
  return { ...model, draft: "", palette: false, actions: { ...actions, slash: false } }
}

/** The Model after an action launches: the draft cleared; over `actions`, the slash menu closed and the panel starting
 *  with no error; nothing else. */
//@ verify
//@ ensures \result == { ...model, draft: "", actions: { ...actions, slash: false, starting: true, error: "" } }
export function launchWrite(model: Model, actions: ActionView): Model {
  return { ...model, draft: "", actions: { ...actions, slash: false, starting: true, error: "" } }
}

/** The Model after a post: the chat shown with the palette closed and the draft cleared, the given client and sent
 *  count, following on; the issues list closed when the Model has one, and absent when it has none; nothing else. */
//@ verify
//@ ensures model.issues === undefined ==> \result == { ...model, surface: "chat", palette: false, draft: "", sent: sent, client: client, following: true }
//@ ensures model.issues !== undefined ==> \result == { ...model, surface: "chat", issues: { ...model.issues, open: false }, palette: false, draft: "", sent: sent, client: client, following: true }
export function postWrite(model: Model, client: Model["client"], sent: number): Model {
  const posted: Model = { ...model, surface: "chat", palette: false, draft: "", sent, client, following: true }
  return model.issues === undefined ? posted : { ...posted, issues: { ...model.issues, open: false } }
}

/** The Model before `/sandbox` starts one: the chat shown, the palette closed, the draft cleared, the sandbox pane
 *  docked; nothing else. */
//@ verify
//@ ensures \result == { ...model, surface: "chat", palette: false, draft: "", sandboxPane: "pane" }
export function sandboxSubmitWrite(model: Model): Model {
  return { ...model, surface: "chat", palette: false, draft: "", sandboxPane: "pane" }
}

/** The Model after the wiki editor opens: the editor and its request number; nothing else. */
//@ verify
//@ ensures \result == { ...model, wikiEdit: editing, wikiEditRequest: request }
export function wikiEditorWrite(model: Model, editing: NonNullable<Model["wikiEdit"]>, request: number): Model {
  return { ...model, wikiEdit: editing, wikiEditRequest: request }
}

/** The Model after a received tour event presents its step: the tour on, the theatre at the walkthrough's step,
 *  target and pause with the person's sound kept; nothing else. */
//@ verify
//@ ensures \result == { ...model, tour: true, theatre: { step: step, target: target, paused: paused, sound: model.theatre.sound } }
export function tourPresentWrite(model: Model, step: number, target: string, paused: boolean): Model {
  return { ...model, tour: true, theatre: { step, target, paused, sound: model.theatre.sound } }
}

/** The Model a walkthrough step is replayed over: the plan's surface, the palette closed, docs docked, the issues list
 *  closed over `issues`, the sandbox pane closed, and over `actions` the slash menu and panel closed and not
 *  maximized; nothing else. */
//@ verify
//@ ensures \result == { ...model, palette: false, docs: "pane", surface: surface, issues: { ...issues, open: false }, sandboxPane: "closed", actions: { ...actions, slash: false, open: false, maximized: false } }
export function walkthroughWrite(model: Model, issues: NonNullable<Model["issues"]>, actions: ActionView, surface: Model["surface"]): Model {
  return { ...model, palette: false, docs: "pane", surface, issues: { ...issues, open: false }, sandboxPane: "closed", actions: { ...actions, slash: false, open: false, maximized: false } }
}

/** The Model with its issues list closed: unchanged when it has no issues screen. */
//@ verify
//@ ensures model.issues === undefined ==> \result == model
//@ ensures model.issues !== undefined ==> \result == { ...model, issues: { ...model.issues, open: false } }
export function issuesClosedWrite(model: Model): Model {
  return model.issues === undefined ? model : { ...model, issues: { ...model.issues, open: false } }
}

/** The Model after the location leaves the wiki: the splash with docs docked and the issues list closed when there is
 *  one; nothing else. */
//@ verify
//@ ensures model.issues === undefined ==> \result == { ...model, surface: "splash", docs: "pane" }
//@ ensures model.issues !== undefined ==> \result == { ...model, surface: "splash", docs: "pane", issues: { ...model.issues, open: false } }
export function wikiLeaveWrite(model: Model): Model {
  return issuesClosedWrite({ ...model, surface: "splash", docs: "pane" })
}

/** The Model after the draft changes: the draft, and over `actions` the slash menu as decided with the first entry
 *  highlighted; nothing else. */
//@ verify
//@ ensures \result == { ...model, draft: value, actions: { ...actions, slash: slash, highlight: 0 } }
export function draftWrite(model: Model, actions: ActionView, value: string, slash: boolean): Model {
  return { ...model, draft: value, actions: { ...actions, slash, highlight: 0 } }
}

/** The Model after the slash highlight moves: the highlight over `actions`; nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, highlight: highlight } }
export function highlightWrite(model: Model, actions: ActionView, highlight: number): Model {
  return { ...model, actions: { ...actions, highlight } }
}

/** The Model after a scroll the follow rule accepts: following and the follow intent; nothing else. */
//@ verify
//@ ensures \result == { ...model, following: following, followIntent: followIntent }
export function followWrite(model: Model, following: boolean, followIntent: number): Model {
  return { ...model, following, followIntent }
}

/** The Model after a wiki page fails: the error when the proved `wikiFailureApplies` says the failure is the latest
 *  loading request's (`applies`); otherwise nothing changes. */
//@ verify
//@ ensures applies ==> \result == { ...model, wikiStatus: "error" }
//@ ensures !applies ==> \result == model
export function wikiFailureWrite(model: Model, applies: boolean): Model {
  return applies ? { ...model, wikiStatus: "error" } : model
}

/** The Model after the People list arrives: the members and the wait the proved `pendingAfterPeople` decides over
 *  `account`; nothing else. */
//@ verify
//@ ensures \result == { ...model, account: { ...account, members: members, pending: pending } }
export function peopleWrite(model: Model, account: AccountState, members: AccountState["members"], pending: boolean): Model {
  return { ...model, account: { ...account, members, pending } }
}

/** The Model after a changed person or role re-gates the issues screen: the new role; the dialog closed when the step
 *  closes it; the retry dropped and the screen idle when the person changed; nothing else. */
//@ verify
//@ ensures !step.clearRetry ==> \result == { ...model, issues: { ...issues, role: role, dialog: step.closeDialog ? "" : issues.dialog } }
//@ ensures step.clearRetry ==> \result == { ...model, issues: { ...issues, role: role, dialog: step.closeDialog ? "" : issues.dialog, retry: undefined, busy: false } }
export function afterIssuesWrite(model: Model, issues: NonNullable<Model["issues"]>, role: NonNullable<Model["issues"]>["role"], step: AfterUpdate): Model {
  const gated: NonNullable<Model["issues"]> = { ...issues, role, dialog: step.closeDialog ? "" : issues.dialog }
  return { ...model, issues: step.clearRetry ? { ...gated, retry: undefined, busy: false } : gated }
}

/** A change of person or role retires what was scoped to the old one: the sandbox snapshot and its busy flag, the wiki
 *  editor and its review, and the panel's commands, slash menu and starting run. The panel's epoch and the wiki and
 *  sandbox request numbers take the step's values, so a reply sent under the old ones no longer applies. An unchanged
 *  scope writes only the panel. Every other field is unchanged. */
//@ verify
//@ ensures !changed ==> \result == { ...model, actions: actions }
//@ ensures changed ==> \result == { ...model, sandbox: undefined, actions: { ...actions, epoch: actionsEpoch, commands: [], slash: false, starting: false }, wikiEdit: undefined, wikiReview: undefined, wikiEditRequest: wikiEditRequest, sandboxBusy: false, sandboxRequest: sandboxRequest }
export function scopeWrite(model: Model, actions: ActionView, changed: boolean, actionsEpoch: number, wikiEditRequest: number, sandboxRequest: number): Model {
  if (!changed) return { ...model, actions }
  const { sandbox: retired, ...kept } = model
  return { ...kept, actions: { ...actions, epoch: actionsEpoch, commands: [], slash: false, starting: false }, wikiEdit: undefined, wikiReview: undefined, wikiEditRequest, sandboxBusy: false, sandboxRequest }
}

/** The Model after the panel's list loads for the current epoch: its flows and commands, the merged runs (`runs`,
 *  from `mergeRuns`), not loading and no error; nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, entries: entries, commands: commands, runs: runs, loading: false, error: "" } }
export function actionsLoadedWrite(model: Model, actions: ActionView, entries: ActionView["entries"], commands: ActionView["commands"], runs: ActionView["runs"]): Model {
  return { ...model, actions: { ...actions, entries, commands, runs, loading: false, error: "" } }
}

/** The Model after a run starts for the current epoch: the chat with the stream open and the palette closed; the
 *  panel follows the run as decided (`selection`, from `followedRun`), is no longer starting, holds the merged runs
 *  and shows no error; nothing else. */
//@ verify
//@ ensures \result == { ...model, surface: "chat", stream: "open", palette: false, actions: { ...actions, step: selection.step, run: selection.run, selected: selection.selected, open: selection.open, maximized: selection.maximized, starting: false, runs: runs, error: "" } }
export function actionStartedWrite(model: Model, actions: ActionView, selection: RunSelection, runs: ActionView["runs"]): Model {
  return { ...model, surface: "chat", stream: "open", palette: false, actions: { ...actions, ...selection, starting: false, runs, error: "" } }
}

/** The Model after an issues-screen step (`openedIssueCard`, `issueDetailsFailed`): the step's screen fields over `ui`
 *  (the current issues screen, or the initial one); every other field of the Model and of `ui` unchanged. */
//@ verify
//@ ensures \result == { ...model, issues: { ...ui, open: state.open, screen: state.screen, kind: state.kind, state: state.state, query: state.query, selected: state.selected, dialog: state.dialog, status: state.status, busy: state.busy, title: state.title, summary: state.summary, example: state.example, prior: state.prior, comment: state.comment, parent: state.parent, assignee: state.assignee, step: state.step, error: state.error, serial: state.serial } }
export function issueScreenWrite(model: Model, ui: Issues, state: IssueScreen): Model {
  return { ...model, issues: { ...ui, ...state } }
}

/** The Model after an issues response (a list, a recovery read or a failure): the step's screen fields over `ui`, the
 *  data, role and key prefix written, and the saved retry cleared or kept (`kept`) as the step decided; nothing else. */
//@ verify
//@ ensures \result == { ...model, issues: { ...ui, open: state.open, screen: state.screen, kind: state.kind, state: state.state, query: state.query, selected: state.selected, dialog: state.dialog, status: state.status, busy: state.busy, title: state.title, summary: state.summary, example: state.example, prior: state.prior, comment: state.comment, parent: state.parent, assignee: state.assignee, step: state.step, error: state.error, serial: state.serial, data: data, role: role, keyPrefix: keyPrefix, retry: clearRetry ? undefined : kept } }
export function issueResponseWrite(model: Model, ui: Issues, state: IssueScreen, data: Issues["data"], role: Issues["role"], keyPrefix: string, clearRetry: boolean, kept: Issues["retry"]): Model {
  return { ...model, issues: { ...ui, ...state, data, role, keyPrefix, retry: clearRetry ? undefined : kept } }
}

/** The Model after a newer issues projection: its data, ready, and the role it names; nothing else. */
//@ verify
//@ ensures \result == { ...model, issues: { ...ui, data: data, status: "ready", role: role } }
export function issueProjectionWrite(model: Model, ui: Issues, data: Issues["data"], role: Issues["role"]): Model {
  return { ...model, issues: { ...ui, data, status: "ready", role } }
}

/** The Model with the issues list open over `ui`; nothing else. */
//@ verify
//@ ensures \result == { ...model, issues: { ...ui, open: true } }
export function issuesOpenedWrite(model: Model, ui: Issues): Model {
  return { ...model, issues: { ...ui, open: true } }
}

/** The Model after a selected issue's details load: their data over the issues screen; nothing else. */
//@ verify
//@ ensures \result == { ...model, issues: { ...issues, data: data } }
export function issueDetailsWrite(model: Model, issues: Issues, data: Issues["data"]): Model {
  return { ...model, issues: { ...issues, data } }
}

/** The Model after an issues-screen action: the screen `ui` the action produced, with the request serial `serial` when
 *  the action bumps it, and the chat when it moves there; nothing else. */
//@ verify
//@ ensures bumpSerial ==> \result.issues == { ...ui, serial: serial }
//@ ensures !bumpSerial ==> \result.issues == ui
//@ ensures \result.surface == (toChat ? "chat" : model.surface)
//@ ensures \result == { ...model, surface: \result.surface, issues: \result.issues }
export function issueUiWrite(model: Model, ui: Issues, bumpSerial: boolean, serial: number, toChat: boolean): Model {
  return { ...model, issues: bumpSerial ? { ...ui, serial } : ui, ...(toChat ? { surface: "chat" } : {}) }
}

/** The Model after an editor step that keeps the submission (typing, no changes): the step's screen over the editor;
 *  nothing else. */
//@ verify
//@ ensures \result == { ...model, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error } }
export function wikiEditWrite(model: Model, editing: WikiEditing, state: WikiEditScreen): Model {
  return { ...model, wikiEdit: { ...editing, ...state } }
}

/** The Model after the editor loads its page: the step's screen over the editor, and the stale count when the load
 *  reports one; nothing else. */
//@ verify
//@ ensures stale === undefined ==> \result == { ...model, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error } }
//@ ensures stale !== undefined ==> \result == { ...model, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error, stale: stale } }
export function wikiBeganWrite(model: Model, editing: WikiEditing, state: WikiEditScreen, stale: number | undefined): Model {
  return { ...model, wikiEdit: { ...editing, ...state, ...(stale === undefined ? {} : { stale }) } }
}

/** The Model after a save is sent: the next wiki serial, the submitting screen over the editor, and the request the
 *  editor now waits on; nothing else. */
//@ verify
//@ ensures \result == { ...model, wikiSerial: serial, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error, submission: request } }
export function wikiSubmittedWrite(model: Model, editing: WikiEditing, serial: number, state: WikiEditScreen, request: NonNullable<WikiEditing["submission"]>): Model {
  return { ...model, wikiSerial: serial, wikiEdit: { ...editing, ...state, submission: request } }
}

/** The Model after a save fails: the failure's screen over the editor, and the submission cleared when the failure
 *  says nothing was written; nothing else. */
//@ verify
//@ ensures !clear ==> \result == { ...model, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error } }
//@ ensures clear ==> \result == { ...model, wikiEdit: { ...editing, page: state.page, base: state.base, text: state.text, busy: state.busy, error: state.error, submission: undefined } }
export function wikiFailedWrite(model: Model, editing: WikiEditing, state: WikiEditScreen, clear: boolean): Model {
  return { ...model, wikiEdit: { ...editing, ...state, ...(clear ? { submission: undefined } : {}) } }
}

/** The Model with the editor closed; nothing else. */
//@ verify
//@ ensures \result == { ...model, wikiEdit: undefined }
export function wikiEditClosedWrite(model: Model): Model {
  return { ...model, wikiEdit: undefined }
}

/** The Model after a save completes: the editor closed, the saved pages, and the review link when the save opened one;
 *  nothing else. */
//@ verify
//@ ensures review === undefined ==> \result == { ...model, wikiEdit: undefined, wikiPages: pages }
//@ ensures review !== undefined ==> \result == { ...model, wikiEdit: undefined, wikiPages: pages, wikiReview: review }
export function wikiCompletedWrite(model: Model, pages: NonNullable<Model["wikiPages"]>, review: Model["wikiReview"]): Model {
  return { ...model, wikiEdit: undefined, wikiPages: pages, ...(review === undefined ? {} : { wikiReview: review }) }
}

/** The Model after a sandbox answers with its snapshot: the answer's pane, busy flag, operation and error, the
 *  snapshot, the minute notice and the month warned; nothing else. */
//@ verify
//@ ensures \result == { ...model, sandboxPane: result.pane, sandboxBusy: result.busy, sandboxOperation: result.operation, sandboxError: result.error, sandbox: snapshot, minuteNotice: notice, warnedMonth: warned }
export function sandboxLoadedWrite(model: Model, result: SandboxResult, snapshot: NonNullable<Model["sandbox"]>, notice: string, warned: number): Model {
  return { ...sandboxResultWrite(model, result), sandbox: snapshot, minuteNotice: notice, warnedMonth: warned }
}

/** The Model after an event is applied (the plan `eventReceived` decided, without a replay): the screen step over the
 *  Model, the client, the connection, the answer announced and the announced count; and as planned, the sandbox pane
 *  minimized (`sandboxPane`), a plain page ready, a wiki page ready and followed no more (`wikiAfter`), the editor
 *  closed, the People pane docked. Nothing else. */
//@ verify
//@ ensures \result.surface == screen.surface && \result.palette == screen.palette && \result.tour == screen.tour && \result.tourError == screen.tourError && \result.docs == screen.docs
//@ ensures \result.following == (plan.wikiPane ? false : screen.following)
//@ ensures \result.client == client && \result.connection == plan.connection && \result.answer == answer && \result.announced == plan.announced
//@ ensures \result.sandboxPane == (plan.pane ? sandboxPane : model.sandboxPane)
//@ ensures plan.wikiPane ==> \result.wikiStatus == "ready" && \result.wikiAfter == wikiAfter
//@ ensures !plan.wikiPane && plan.plainPane ==> \result.wikiStatus == "ready" && \result.wikiAfter == ""
//@ ensures !plan.wikiPane && !plan.plainPane ==> \result.wikiStatus == model.wikiStatus && \result.wikiAfter == model.wikiAfter
//@ ensures \result.wikiEdit == (plan.closeEditor ? undefined : model.wikiEdit)
//@ ensures \result.account == (plan.peoplePane ? { ...account, people: "pane" } : model.account)
//@ ensures \result == { ...model, surface: \result.surface, palette: \result.palette, tour: \result.tour, tourError: \result.tourError, docs: \result.docs, following: \result.following, client: client, connection: plan.connection, answer: answer, announced: plan.announced, sandboxPane: \result.sandboxPane, wikiStatus: \result.wikiStatus, wikiAfter: \result.wikiAfter, wikiEdit: \result.wikiEdit, account: \result.account }
export function eventWrite(model: Model, screen: ScreenState, client: Model["client"], answer: string, plan: EventPlan, sandboxPane: SandboxPane, wikiAfter: string, account: AccountState): Model {
  return {
    ...screenWrite(model, screen), client, connection: plan.connection, answer, announced: plan.announced,
    ...(plan.pane ? { sandboxPane } : {}),
    ...(plan.plainPane ? { wikiStatus: "ready" as const, wikiAfter: "" } : {}),
    ...(plan.wikiPane ? { following: false, wikiStatus: "ready" as const, wikiAfter } : {}),
    ...(plan.closeEditor ? { wikiEdit: undefined } : {}),
    ...(plan.peoplePane ? { account: { ...account, people: "pane" as const } } : {}),
  }
}

/** The Model after a run changes: the merged runs (`mergeRuns`), and the disconnected and stopped follows settled for
 *  it (`settled`); nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, runs: runs, disconnected: disconnected, stoppedFollows: stopped } }
export function actionChangedWrite(model: Model, actions: ActionView, runs: ActionView["runs"], disconnected: ReadonlyArray<string>, stopped: ReadonlyArray<string>): Model {
  return { ...model, actions: { ...actions, runs, disconnected, stoppedFollows: stopped } }
}

/** The Model after a followed run's answer for the current follow: the merged runs and the run no longer
 *  disconnected (`received`); nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, runs: runs, disconnected: disconnected } }
export function actionFollowedWrite(model: Model, actions: ActionView, runs: ActionView["runs"], disconnected: ReadonlyArray<string>): Model {
  return { ...model, actions: { ...actions, runs, disconnected } }
}

/** The Model after a follow fails for the current follow: the disconnected and stopped follows as `failed` decided;
 *  nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, disconnected: disconnected, stoppedFollows: stopped } }
export function actionFollowFailedWrite(model: Model, actions: ActionView, disconnected: ReadonlyArray<string>, stopped: ReadonlyArray<string>): Model {
  return { ...model, actions: { ...actions, disconnected, stoppedFollows: stopped } }
}

/** The Model after the actions stream reconnects: the next follow generation (`reconnected`) and no stopped follows;
 *  nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, followGeneration: generation, stoppedFollows: [] } }
export function actionsReconnectedWrite(model: Model, actions: ActionView, generation: number): Model {
  return { ...model, actions: { ...actions, followGeneration: generation, stoppedFollows: [] } }
}

/** The Model with a run's step selected; nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, step: step } }
export function actionStepWrite(model: Model, actions: ActionView, step: string): Model {
  return { ...model, actions: { ...actions, step } }
}

/** The Model with a run selected as `selectedRun` decided; nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, step: selection.step, run: selection.run, selected: selection.selected, open: selection.open, maximized: selection.maximized } }
export function actionSelectedWrite(model: Model, actions: ActionView, selection: RunSelection): Model {
  return { ...model, actions: { ...actions, ...selection } }
}

/** The Model with the actions clock at `now` (`actionsClock`); nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, now: now } }
export function actionClockWrite(model: Model, actions: ActionView, now: number): Model {
  return { ...model, actions: { ...actions, now } }
}

/** The Model when a cancel is asked: the panel's error cleared; nothing else. */
//@ verify
//@ ensures \result == { ...model, actions: { ...actions, error: "" } }
export function actionCancelWrite(model: Model, actions: ActionView): Model {
  return { ...model, actions: { ...actions, error: "" } }
}

/** The Model with the client a post step decided (`retryPost`, `failPost`); nothing else. */
//@ verify
//@ ensures \result == { ...model, client: client }
export function clientWrite(model: Model, client: Model["client"]): Model {
  return { ...model, client }
}

/** The Model with the media that failed to load (`failedMediaAfter`); nothing else. */
//@ verify
//@ ensures \result == { ...model, failedMedia: failed }
export function failedMediaWrite(model: Model, failed: ReadonlyArray<string>): Model {
  return { ...model, failedMedia: failed }
}

/** The Model with the mode the host resolved; nothing else. */
//@ verify
//@ ensures \result == { ...model, mode: mode }
export function modeWrite(model: Model, mode: Model["mode"]): Model {
  return { ...model, mode }
}

/** The Model after an account replay: the resumed ledger and the step's epoch and position over `account`; nothing
 *  else. */
//@ verify
//@ ensures \result == { ...model, account: { ...account, ledger: ledger, epoch: epoch, from: from } }
export function accountReplayWrite(model: Model, account: AccountState, ledger: AccountState["ledger"], epoch: number, from: number): Model {
  return { ...model, account: { ...account, ledger, epoch, from } }
}

/** The Model with the theatre's measured box; nothing else. */
//@ verify
//@ ensures \result == { ...model, theatreBox: box }
export function theatreBoxWrite(model: Model, box: { readonly x: number; readonly y: number; readonly width: number; readonly height: number }): Model {
  return { ...model, theatreBox: box }
}

/** The Model with the tour's sound as `toggledSound` decided; the rest of the theatre and the Model unchanged. */
//@ verify
//@ ensures \result == { ...model, theatre: { ...model.theatre, sound: sound } }
export function soundWrite(model: Model, sound: boolean): Model {
  return { ...model, theatre: { ...model.theatre, sound } }
}

/** The Model when the tour's events fail: a connection error; nothing else. */
//@ verify
//@ ensures \result == { ...model, tourError: "connection" }
export function tourEventsFailedWrite(model: Model): Model {
  return { ...model, tourError: "connection" }
}

/** The Model when a failed tour keeps control (`keptTour`); nothing else. */
//@ verify
//@ ensures \result == { ...model, tour: keep.tour, recoverTour: keep.recoverTour, tourError: keep.tourError }
export function keptTourWrite(model: Model, keep: TourKeep): Model {
  return { ...model, ...keep }
}

/** The Model with the sandbox pane as `toggleSandbox` or `maximizeSandbox` decided; nothing else. */
//@ verify
//@ ensures \result == { ...model, sandboxPane: pane }
export function sandboxPaneWrite(model: Model, pane: SandboxPane): Model {
  return { ...model, sandboxPane: pane }
}

/** The Model with the terminal's draft; nothing else. */
//@ verify
//@ ensures \result == { ...model, terminalDraft: value }
export function terminalDraftWrite(model: Model, value: string): Model {
  return { ...model, terminalDraft: value }
}

/** The Model with the wiki filter; nothing else. */
//@ verify
//@ ensures \result == { ...model, wikiQuery: value }
export function wikiQueryWrite(model: Model, value: string): Model {
  return { ...model, wikiQuery: value }
}

/** The Model after a replay plan: the resumed client and the plan's epoch and position; nothing else. */
//@ verify
//@ ensures \result == { ...model, client: client, epoch: epoch, from: from }
export function eventReplayWrite(model: Model, client: Model["client"], epoch: number, from: number): Model {
  return { ...model, client, epoch, from }
}

/** The Model with the stream step (`failedEvents`, `reconnected`); nothing else. */
//@ verify
//@ ensures \result == { ...model, stream: state.stream, connection: state.connection, epoch: state.epoch, from: state.from }
export function streamWrite(model: Model, state: StreamScreen): Model {
  return { ...model, ...state }
}
