// Observation state belongs to the page; it never changes the server's run or starts another action.
export interface ObservedRun { readonly id: string; readonly state: string }

/** Messages from a replaced subscription or identity cannot change this page's observation. */
//@ verify
//@ ensures \result == (epoch == currentEpoch && generation == currentGeneration)
export function current(epoch: number, generation: number, currentEpoch: number, currentGeneration: number): boolean {
  return epoch === currentEpoch && generation === currentGeneration
}

/** Only an unsettled known run becomes uncertain. Other runs and terminal receipts are preserved. */
//@ verify
//@ ensures !exists(i, 0 <= i && i < runs.length && runs[i].id == id && (runs[i].state == "queued" || runs[i].state == "running")) ==> \result == disconnected
//@ ensures exists(i, 0 <= i && i < runs.length && runs[i].id == id && (runs[i].state == "queued" || runs[i].state == "running")) ==> \result.includes(id)
export function failed<R extends ObservedRun>(disconnected: ReadonlyArray<string>, id: string, runs: ReadonlyArray<R>): ReadonlyArray<string> {
  if (!runs.some(run => run.id === id && (run.state === "queued" || run.state === "running"))) return disconnected
  return disconnected.includes(id) ? disconnected : [...disconnected, id]
}

/** A real snapshot restores this run only. */
//@ verify
//@ ensures forall(i, 0 <= i && i < \result.length ==> \result[i] != id)
//@ ensures forall(i, 0 <= i && i < disconnected.length && disconnected[i] != id ==> \result.includes(disconnected[i]))
export function received(disconnected: ReadonlyArray<string>, id: string): ReadonlyArray<string> {
  return disconnected.filter(value => value !== id)
}

/** Reconnect replaces the subscription even when the run ids have not changed. */
//@ verify
//@ ensures \result == generation + 1
export function reconnected(generation: number): number { return generation + 1 }

/** Do not present an unobserved live run as healthy or advance its clock. */
//@ verify
//@ ensures \result == (disconnected && (state == "queued" || state == "running") ? "disconnected" : state)
export function observedState(state: string, disconnected: boolean): string {
  return disconnected && (state === "queued" || state === "running") ? "disconnected" : state
}

/** A one-time read settles uncertainty only with a terminal receipt; a running read cannot repair a dead follow. */
//@ verify
//@ ensures forall(i, 0 <= i && i < \result.length ==> !exists(j, 0 <= j && j < runs.length && runs[j].id == \result[i] && runs[j].state != "queued" && runs[j].state != "running"))
export function settled<R extends ObservedRun>(disconnected: ReadonlyArray<string>, runs: ReadonlyArray<R>): ReadonlyArray<string> {
  return disconnected.filter(id => !runs.some(run => run.id === id && run.state !== "queued" && run.state !== "running"))
}

/** Ended follows stay paused across unrelated run changes until the person reconnects. */
//@ verify
//@ ensures \result.length <= runs.length
//@ ensures forall(i, 0 <= i && i < \result.length ==> !exists(j, 0 <= j && j < stopped.length && stopped[j] == \result[i]))
export function watching<R extends ObservedRun>(runs: ReadonlyArray<R>, stopped: ReadonlyArray<string>): ReadonlyArray<string> {
  return runs.filter(run => (run.state === "queued" || run.state === "running") && !stopped.includes(run.id)).map(run => run.id)
}

/** Every dependency replacement fences messages queued by the previous set of follows. */
//@ verify
//@ ensures \result == (left.length == right.length && forall(i, 0 <= i && i < left.length ==> left[i] == right[i]))
export function same(left: ReadonlyArray<string>, right: ReadonlyArray<string>): boolean {
  if (left.length !== right.length) return false
  let index = 0
  while (index < left.length) {
    //@ invariant 0 <= index && index <= left.length
    //@ invariant left.length == right.length
    //@ invariant forall(i, 0 <= i && i < index ==> left[i] == right[i])
    //@ decreases left.length - index
    if (left[index] !== right[index]) return false
    index++
  }
  return true
}
