// The designer's wiki pane (wiki/designs/wiki), including its edit-maintainer and propose-contributor screens:
// chrome and navigation stay in Foldkit; Markdown is compiled at build time, edits render through the same renderer.
import type { Html, HtmlBuilder } from "foldkit/html"
import { pages, wikiLink } from "../core/wiki.vibe"
import { toHtml } from "./markdown.vibe"
import * as W from "./wikiViewDecision.vibe"
import * as G from "./viewGateDecision.vibe"
import { wikiPermission } from "../core/conversation.vibe"
import { staleMark } from "./issuesView.vibe"
import { accountOf, Message, type Model } from "./main.vibe"
type H = HtmlBuilder<Message>
const max = "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
const min = "M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"
type WikiPage = (typeof pages)[number]
/** Render the built wiki corpus; callers can supply a corpus containing archived decisions too. */
export function wikiPane(model: Model, h: H, documents: ReadonlyArray<WikiPage> = pages): Html {
  const page = documents.find(page => `/wiki/${page.id}` === W.wikiPanePath(model.client.conversation.pane))
  const loading = model.wikiStatus === "loading"
  const error = model.wikiStatus === "error"
  const editing = model.wikiEdit !== undefined && page !== undefined && model.wikiEdit.page === page.id ? model.wikiEdit : undefined
  const role = accountOf(model).identity.role
  const canEdit = W.wikiEditable(page !== undefined, page?.id ?? "", wikiPermission(role, "save"), wikiPermission(role, "propose"))
  const review = model.wikiReview !== undefined && page !== undefined && model.wikiReview.page === page.id ? model.wikiReview : undefined
  const query = model.wikiQuery ?? ""
  const filtered = documents.filter(page => `${page.label} ${page.title}`.toLowerCase().includes(query.toLowerCase()))
  const regular = filtered.filter(page => W.wikiListed(page.decision, page.id, query)).sort((a, b) => W.wikiRank(a.id) - W.wikiRank(b.id))
  const decisions = filtered.filter(page => page.decision).sort((a, b) => b.id.localeCompare(a.id))
  const maximized = model.docs === "max"
  const content = W.wikiContent(loading, error, filtered.length !== 0, page !== undefined)
  const link = (id: string, label: string, decision = false) => h.a([
    h.Class("vl-wiki-page-link"), h.Href(`/wiki/${id}`), h.DataAttribute("kind", decision ? "decision" : "page"),
    ...(page?.id === id ? [h.AriaCurrent("page")] : []),
    h.OnClick(Message.ClickedWiki({ page: id }), { defaultAction: "Prevent" }),
  ], [label])
  const bar = W.wikiBar(page !== undefined, page?.id ?? "", page?.decision === true, !!model.tour, editing !== undefined, canEdit, loading, error)
  const crumb = (id: string, label: string) => h.button([h.Type("button"), h.OnClick(Message.ClickedWiki({ page: id }))], [label])
  return h.section([h.Class("vl-wiki"), h.Id("vl-wiki"), h.AriaLabel("Wiki"), h.Tabindex(-1), h.DataAttribute("maximized", String(maximized)), h.AriaBusy(loading)], [
    h.div([h.Class("vl-wiki-bar")], [
      h.div([h.Class("vl-wiki-crumb")], [
        ...(bar.crumb === "root" ? [h.b([], ["Wiki"])] : [crumb("index", "Wiki"), "/"]),
        ...(bar.crumb === "decision" && page ? [crumb("decisions", "Decisions"), "/", h.b([], [page.id.slice(10, 14)])] : bar.crumb === "page" && page ? [h.b([], [page.label])] : []),
        ...(editing === undefined ? [] : [h.span([h.Class("vl-wiki-editing")], ["· editing"]), ...staleMark(h, editing.stale)]),
      ]),
      ...(!bar.edit ? [] : [h.button([h.Class("vl-wiki-edit"), h.Type("button"), h.OnClick(Message.ClickedEditWiki())], ["Edit"])]),
      ...(!bar.toggle ? [] : [h.button([h.Class("vl-wiki-toggle"), h.Type("button"), h.Disabled(loading), h.AriaLabel(maximized ? "Minimize the wiki" : "Maximize the wiki"), h.OnClick(Message.ClickedDocs())], [
        h.svg([h.Class("vl-icon"), h.ViewBox("0 0 24 24"), h.AriaHidden(true)], [h.path([h.D(maximized ? min : max)], [])]),
      ])]),
    ]),
    ...(review === undefined ? [] : [h.div([h.Class("vl-wiki-note")], [
      h.span([], ["Proposed"]),
      h.a([h.Href(review.url), h.Target("_blank"), h.Rel("noreferrer")], ["Review", h.span([h.AriaHidden(true)], [" ↗"])]),
    ])]),
    ...(editing !== undefined ? [
      h.div([h.Class("vl-wiki-edit-body")], [
        h.textarea([h.Class("sui-textarea"), h.DataAttribute("code", "true"), h.Id("vl-wiki-editor"), h.AriaLabel(`Edit ${page!.label}`), h.Value(editing.text), h.Disabled(G.wikiEditorLocked(editing.busy, editing.submission !== undefined)), h.OnInput(value => Message.UpdatedWikiEdit({ value }))]),
        ...(editing.error === "" ? [] : [h.div([h.Role("alert"), h.Class("vl-wiki-edit-error")], [editing.error, ...(W.wikiErrorAction(editing.error) === "connect" ? [h.form([h.Method("post"), h.Action(`/api/auth/connect?wiki-page=${editing.page}`)], [h.button([h.Class("sui-button"), h.Type("submit")], ["Connect GitHub"])])] : W.wikiErrorAction(editing.error) === "fork" ? [h.a([h.Class("sui-button"), h.Href("https://github.com/smithersai/smithers/fork")], ["Fork"])] : W.wikiErrorAction(editing.error) === "install" ? [h.a([h.Class("sui-button"), h.Href("/api/auth/install")], ["Install"])] : [])])]),
        h.div([h.Class("vl-wiki-edit-footer")], [
          h.button([h.Class("sui-button"), h.Type("button"), h.Disabled(G.wikiEditorLocked(editing.busy, editing.submission !== undefined)), h.OnClick(Message.CanceledWikiEdit())], ["Cancel"]),
          h.button([h.Class("sui-button sui-button-solid"), h.Type("button"), h.Disabled(editing.busy), h.OnClick(Message.SubmittedWikiEdit())], [W.wikiSubmitLabel(editing.submission !== undefined, editing.busy, wikiPermission(role, "save"))]),
        ]),
      ]),
    ] : [h.div([h.Class("vl-wiki-body")], [
      h.nav([h.Class("vl-wiki-pages"), h.DataAttribute("scroll-surface", "true"), h.AriaLabel("Wiki pages")], [
        h.input([h.Class("sui-input vl-wiki-find"), h.Placeholder("Find a page"), h.AriaLabel("Find a page"), h.Value(query), h.OnInput(value => Message.FilteredWiki({ value }))]),
        ...(loading ? [h.div([h.Class("sui-skeleton")], [])] : [
          ...regular.map(page => link(page.id, page.label)),
          ...(decisions.length ? [h.div([h.Class("vl-wiki-pages-head")], ["Decisions"])] : []),
          ...decisions.map(page => link(page.id, page.label, true)),
        ]),
      ]),
      h.div([h.Class("vl-wiki-content"), h.DataAttribute("scroll-surface", "true"), h.Tabindex(0)], content === "loading" ? [h.div([h.Class("sui-skeleton")], [])] : content === "error" ? [
        h.div([h.Class("sui-empty")], [h.div([h.Class("sui-empty-title")], ["The wiki didn't load"]), h.button([h.Class("vl-link"), h.Type("button"), h.OnClick(Message.ClickedWiki({ page: model.wikiRequested ?? "index" }))], ["Retry"])]),
      ] : content === "empty" ? [h.div([h.Class("sui-empty")], [h.div([h.Class("sui-empty-title")], [`No pages match "${query}"`])])] : content === "page" && page ? [
        ...(page.decision ? [h.div([h.Class("vl-wiki-meta")], [
          h.span([h.Class(W.wikiStatusClass(page.status))], [page.status]),
          h.time([], [page.date]),
          ...page.rulings.map(ruling => h.button([h.Class("sui-badge sui-badge-outline"), h.Type("button"), h.OnClick(Message.ClickedWiki({ page: `rulings#${ruling.toLowerCase()}` }))], [ruling])),
        ])] : []),
        h.div([h.Class("sui-md"), h.InnerHTML(observedHtml(model, page, documents))], []),
      ] : []),
    ])]),
  ])
}

/** The page as observed in the repository, else the build's embedded rendering. */
function observedHtml(model: Model, page: WikiPage, documents: ReadonlyArray<WikiPage>): string {
  const observed = model.wikiPages?.find(entry => entry.id === page.id)
  return W.wikiUsesEmbedded(observed !== undefined, observed?.source ?? "", page.source) || observed === undefined ? page.html : toHtml(observed.source, href => wikiLink(page.id, href, documents.map(entry => entry.id)))
}
