// The web app's view. Chat parts use @smthrs/ui's classes (`sui-chat-*`, `sui-cmd-*`), so the conversation looks the
// way it does on smithers.sh; the splash and the frame are this app's (`vl-*`, styles.css).
import { Option } from "effect"
import type { Document, Html, HtmlBuilder } from "foldkit/html"
import type { Entry, Pending } from "../core/conversation.vibe"
import { CONTRIBUTE_URL, hasConversation, type Message as AppMessage, Message, type Model, tourConversation, PALETTE_ID, PALETTE_PROMPT_ID, PROMPT_ID } from "./main.vibe"
import { accountNotice, accountOverlays, identityNav, peoplePane } from "./roleView.vibe"
import { render } from "./markdown.vibe"
import { STOPS, type StopMedia } from "../core/tourStops.vibe"
import { sandboxPane } from "./sandboxView.vibe"

type H = HtmlBuilder<AppMessage>

export const DOCS_URL = "https://vibelang.sh"
export const SOURCE_URL = "https://github.com/smithersai/vibelang"
export const INSTALL = "npm create vibelang@latest my-app"

/** What a failed answer says: the agent's reason (a spent budget, no model), or that it failed when it gave none. */
export function failureOf(reason: string): string {
  return reason === "" || reason === "failed" ? "Answer failed" : reason
}

export function view(model: Model, h: H): Document {
  return {
    title: model.surface === "splash" ? "VibeLang" : "VibeLang · Chat",
    body: h.div(
      [h.Class("vl-app"), h.DataAttribute("surface", model.surface), h.DataAttribute("mode", model.mode), h.DataAttribute("tour", model.tour ? "on" : "off")],
      [
        top(model, h),
        model.surface === "splash" ? splash(model, h) : chat(model, h),
        ...(model.surface === "chat" && model.client.conversation.pane !== "" && (model.tour || model.docs === "max") ? [docsPane(model, h)] : []),
        palette(model, h),
        ...accountOverlays(model, h),
        ...(model.tour ? control(h) : []),
        h.div([h.Id("vl-announcements")], [
          h.div([h.Class("vl-sr-only"), h.Role("status"), h.AriaLabel("Answer"), h.AriaLive("polite"), h.AriaAtomic(true)], [
            h.span([h.Key(String(model.announced))], model.answer === "" ? [] : [`Answer ${model.announced}: ${model.answer}`]),
          ]),
          h.div([h.Class("vl-sr-only"), h.Role("status"), h.AriaLabel("Tour"), h.AriaLive("polite"), h.AriaAtomic(true)], [model.tour ? "Agent controlling. Escape to stop." : model.conversation === tourConversation(model.session) ? "Tour ended. You have control." : ""]),
          h.div([h.Class("vl-sr-only"), h.Role("status"), h.AriaLabel("Connection"), h.AriaLive("polite"), h.AriaAtomic(true)], [model.connection]),
        ]),
      ],
    ),
  }
}

/** The wordmark, light text for the dark page. */
function logo(h: H): Html {
  return h.span([h.Class("vl-logo")], [h.img([h.Src("/media/logo-dark.svg"), h.Alt("VibeLang")])])
}

function top(model: Model, h: H): Html {
  return h.header([h.Class("vl-top")], [
    h.button([h.Class("vl-home"), h.Type("button"), h.AriaLabel("Home"), h.OnClick(Message.ClickedSplash())], [logo(h)]),
    h.nav([h.Class("vl-nav")], [
      h.a([h.Class("vl-nav-link"), h.Href("/history")], ["History"]),
      h.a([h.Class("vl-nav-link vl-ext"), h.Href(DOCS_URL)], ["Docs", away(h)]),
      h.a([h.Class("vl-nav-link vl-ext"), h.Href(SOURCE_URL)], [githubMark(h), "GitHub", away(h)]),
      ...identityNav(model, h),
    ]),
  ])
}

/** The arrow vibelang.sh puts on a link that leaves the site. */
function away(h: H): Html {
  return h.span([h.Class("vl-away"), h.AriaHidden(true)], ["↗"])
}

/** Lucide's maximize-2 and minimize-2 (ISC): arrows out to maximize a pane, arrows in to minimize it. */
const MAXIMIZE = "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"
const MINIMIZE = "M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"

function paneIcon(h: H, d: string): Html {
  return h.svg([h.Class("vl-icon"), h.ViewBox("0 0 24 24"), h.AriaHidden(true)], [h.path([h.D(d)], [])])
}

/** The GitHub mark (Octicons mark-github, MIT). */
function githubMark(h: H): Html {
  return h.svg([h.Class("vl-mark"), h.ViewBox("0 0 16 16"), h.AriaHidden(true)], [
    h.path([h.D("M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z")], []),
  ])
}

// ── splash ───────────────────────────────────────────────────────────────────────────────────────────────────────

function splash(model: Model, h: H): Html {
  return h.main([h.Class("vl-splash"), h.Style({ viewTransitionName: "splash" })], [
    ...(hasConversation(model)
      ? [h.button([h.Class("vl-minimize"), h.Type("button"), h.AriaLabel("Minimize the VibeLang home page"), h.AriaKeyshortcuts("Escape"), h.OnClick(Message.ClickedChat())], [paneIcon(h, MINIMIZE)])]
      : []),
    h.section([h.Class("vl-hero")], [
      h.div([h.Class("vl-eyebrow")], ["Effect, as a language"]),
      h.h1([h.Class("vl-title")], [h.span([h.Class("vl-gradient")], ["Vibe"]), "Lang"]),
      h.p([h.Class("vl-tagline")], [
        "VibeLang gives Effect a simple, readable syntax that compiles to JavaScript with TypeScript declarations.",
      ]),
      h.div([h.Class("vl-actions")], [
        h.button([h.Class("vl-primary"), h.Type("button"), h.OnClick(Message.ClickedLearnMore())], ["Learn more"]),
        h.button([h.Class("vl-ask"), h.Type("button"), h.AriaLabel("Ask the agent"), h.AriaKeyshortcuts("Meta+K"), h.OnClick(Message.ClickedAsk())], [
          "Ask the agent",
          h.kbd([h.Class("vl-kbd"), h.AriaHidden(true)], ["⌘K"]),
        ]),
        h.a([h.Class("vl-ask"), h.Href(CONTRIBUTE_URL)], ["Contribute"]),
      ]),
      h.pre([h.Class("vl-install")], [h.code([], [INSTALL])]),
    ]),
    ...media(model, h, "vl-media", {
      src: "/media/contract.mp4", poster: "/media/contract-poster.jpg", loop: true,
      alt: "A!E!R: what a function returns, how it fails, what it needs",
    }, true),
  ])
}

/** The splash, shrunk to the chat's first pane; clicking it maximizes it again. */
function splashPane(h: H): Html {
  return h.button(
    [h.Class("vl-pane"), h.Type("button"), h.Style({ viewTransitionName: "splash" }), h.OnClick(Message.ClickedSplash()), h.AriaLabel("Expand the VibeLang home page")],
    [logo(h), h.span([h.Class("vl-pane-text")], ["Effect, as a language"]), h.span([h.Class("vl-pane-expand")], [paneIcon(h, MAXIMIZE)])],
  )
}

// ── the agent in control ─────────────────────────────────────────────────────────────────────────────────────────

/** While the agent drives: a glow around the whole screen, and Esc to take control back. */
function control(h: H): ReadonlyArray<Html> {
  return [
    h.div([h.Class("vl-glow"), h.AriaHidden(true)], []),
    h.button([h.Class("vl-esc"), h.Type("button"), h.AriaKeyshortcuts("Escape"), h.OnClick(Message.ClickedEndTour())], [h.kbd([], ["Esc"])]),
  ]
}

/** The page the agent opened, in a pane of the conversation that maximizes over it. */
function docsPane(model: Model, h: H): Html {
  const page = model.client.conversation.pane
  const maximized = model.tour || model.docs === "max"
  const tour = [...model.client.conversation.entries].reverse().find((entry) => entry.author === "agent" && entry.inReplyTo === "")
  const current = tour?.text.trim().split(/\n\s*\n/).at(-1) ?? ""
  return h.section(
    [h.Class("vl-docs"), h.AriaLabel("Docs"), h.DataAttribute("maximized", String(maximized)), h.DataAttribute("driving", String(model.tour))],
    [
      h.div([h.Class("vl-docs-bar")], [
        h.span([h.Class("vl-docs-page")], [page.replace(/^https:\/\//, "")]),
        ...(model.tour ? [] : [h.button(
          [h.Class("vl-docs-toggle"), h.Type("button"), h.AriaLabel(maximized ? "Minimize the docs" : "Maximize the docs"), h.OnClick(Message.ClickedDocs())],
          [paneIcon(h, maximized ? MINIMIZE : MAXIMIZE)],
        )]),
      ]),
      h.div([h.Class(model.tour ? "vl-docs-body" : "vl-docs-content")], [
        h.iframe([h.Class("vl-docs-frame"), h.Src(page), h.Title("VibeLang docs"), h.Inert(model.tour), h.Tabindex(model.tour ? -1 : 0)], []),
        ...(model.tour ? [h.div([h.Class("vl-tour-side")], [
          ...mediaForStop(model, h, page),
          h.div([h.Class("sui-chat-message-label")], ["VibeLang agent"]),
          h.section([h.Class("vl-tour-narration sui-chat-bubble"), h.AriaLabel("Current stop")], render(h, current)),
        ])] : []),
      ]),
    ],
  )
}

// ── chat ─────────────────────────────────────────────────────────────────────────────────────────────────────────

function chat(model: Model, h: H): Html {
  const { conversation, pending } = model.client
  return h.main([h.Class("vl-chat"), h.Inert(model.tour || model.docs === "max")], [
    h.div([h.Class("sui-chat-messages"), h.DataAttribute("following", String(model.following)), h.Role("log"), h.AriaLabel("Conversation"), h.AriaLive("off")], [
      splashPane(h),
      sandboxPane(model, h),
      ...peoplePane(model, h),
      ...accountNotice(model, h),
      ...(conversation.pane === "" || model.tour || model.docs === "max" ? [] : [docsPane(model, h)]),
      ...(conversation.entries.length === 0 && pending.length === 0 ? [h.div([h.Class("sui-chat-empty")], media(model, h, "vl-empty-media", {
        src: "/media/card-06-compiler.png", alt: "The compiler says what to write instead: VibeLang diagnostics with the fix to write",
      }))] : []),
      ...conversation.entries.map((entry) => entryView(entry, model.session, h)),
      ...pending.map((post) => pendingView(post, h)),
      ...(model.stream === "failed"
        ? [h.div([h.Class("sui-chat-message"), h.DataAttribute("role", "system")], [
          h.div([h.Class("sui-chat-bubble")], [
            h.button([h.Class("vl-link"), h.Type("button"), h.OnClick(Message.ClickedReconnect())], ["Reconnect"]),
          ]),
        ])]
        : []),
      h.div([h.Id("vl-newest"), h.AriaHidden(true)], []),
    ]),
    ...(!model.following ? [h.button([h.Class("sui-msg-scroller-jump vl-latest"), h.Type("button"), h.AriaLabel("Latest"), h.OnClick(Message.ClickedLatest())], ["↓"])] : []),
    composer(model, h),
  ])
}

function entryView(entry: Entry, session: string, h: H): Html {
  const role = entry.author === "person" ? "user" : "assistant"
  const body = entry.author === "agent" ? render(h, entry.text) : [entry.text]
  return h.article(
    [h.Class("sui-chat-message"), h.DataAttribute("role", role), h.DataAttribute("done", String(entry.done)), h.Key(entry.id), h.DataAttribute("in-reply-to", entry.inReplyTo)],
    [
      h.div([h.Class("sui-chat-message-label")], [entry.author === "person" && ownPost(entry.clientId, session) ? "You" : entry.name]),
      // A reply that failed before any text has nothing to show but its reason.
      ...(entry.text === "" && entry.done ? [] : [h.div(
        [h.Class(entry.text === "" && !entry.done ? "sui-chat-bubble vl-thinking" : "sui-chat-bubble")],
        entry.text === "" && !entry.done ? [h.span([h.Class("vl-dots"), h.Role("status"), h.AriaLabel("Thinking")], [])] : body,
      )]),
      ...(entry.error === "" ? [] : [h.div([h.Class("sui-chat-message-meta vl-error")], [failureOf(entry.error)])]),
    ],
  )
}

function pendingView(post: Pending, h: H): Html {
  return h.article(
    [h.Class("sui-chat-message"), h.DataAttribute("role", "user"), h.DataAttribute("pending", "true"), h.Key(post.clientId)],
    [
      h.div([h.Class("sui-chat-message-label")], ["You"]),
      h.div([h.Class("sui-chat-bubble")], [post.text]),
      ...(post.error === "" ? [] : [h.div([h.Class("sui-chat-message-meta vl-error")], [postFailure(post.error), h.button([h.Type("button"), h.Class("vl-link"), h.OnClick(Message.ClickedRetry({ clientId: post.clientId }))], ["Retry"])])]),
    ],
  )
}

/** Names on the wire remain neutral; only this tab calls its own posts You. */
function ownPost(clientId: string, session: string): boolean {
  const prefix = `${session}-`
  return clientId.startsWith(prefix) && /^[1-9]\d*$/.test(clientId.slice(prefix.length))
}

function postFailure(reason: string): string {
  switch (reason) {
    case "empty": return "Empty message"
    case "too-long": return "Message too long"
    case "duplicate": return "Already sent"
    case "busy": return "Agent busy"
    case "not-replying": return "Answer unavailable"
    default: return "Send failed"
  }
}

function promptInput(model: Model, h: H, placeholder: string, id = PROMPT_ID): Html {
  return h.textarea([
    h.Id(id),
    h.Class("sui-chat-composer-input"),
    h.Rows(1),
    h.Placeholder(placeholder),
    h.AriaLabel("Message"),
    h.Value(model.draft),
    h.OnInput((value) => Message.UpdatedDraft({ value })),
    h.OnKeyDownPreventDefault((key, modifiers) =>
      key === "Enter" && !modifiers.shiftKey ? Option.some(Message.SubmittedDraft()) : Option.none()
    ),
  ])
}

function composer(model: Model, h: H): Html {
  return h.form(
    [h.Class("sui-chat-composer"), h.DataAttribute("docked", "true"), h.Style({ viewTransitionName: model.palette ? "none" : "prompt" }), h.OnSubmit(Message.SubmittedDraft())],
    [
      promptInput(model, h, "Ask about VibeLang"),
      h.div([h.Class("sui-chat-composer-toolbar")], [
        h.span([h.Class("sui-chat-composer-status")], [statusText(model)]),
        h.div([h.Class("sui-chat-composer-actions")], [
          h.button([h.Class("vl-send sui-chat-composer-send"), h.Type("submit"), h.AriaLabel("Send"), h.Disabled(model.draft.trim() === "")], ["↑"]),
        ]),
      ]),
    ],
  )
}

function statusText(model: Model): string {
  const { conversation } = model.client
  if (model.stream === "failed") return "Disconnected"
  if (model.tourError !== "") return postFailure(model.tourError)
  if (conversation.agent === "working") return "Answering"
  return ""
}

// ── ⌘K ──────────────────────────────────────────────────────────────────────────────────────────────────────────

function palette(model: Model, h: H): Html {
  return h.dialog([h.Id(PALETTE_ID), h.Class("vl-palette-layer"), h.AriaLabel("Ask the agent"), h.AriaModal(true), h.DataAttribute("state", model.palette ? "open" : "closed"), h.OnCancelPreventDefault(Message.PressedEscape())], [
    h.div([h.Class("vl-palette-scrim"), h.OnClick(Message.PressedEscape())], []),
    h.form(
      [
        h.Class("vl-palette sui-chat-composer"),
        h.Style({ viewTransitionName: model.palette ? "prompt" : "none" }),
        h.OnSubmit(Message.SubmittedDraft()),
      ],
      [
        promptInput(model, h, "Ask about VibeLang, or describe what to change", PALETTE_PROMPT_ID),
        h.div([h.Class("sui-chat-composer-toolbar")], [
          h.span([h.Class("sui-chat-composer-status")], [h.kbd([h.Class("vl-kbd")], ["⏎"]), " to send · ", h.kbd([h.Class("vl-kbd")], ["esc"]), " to close"]),
          h.div([h.Class("sui-chat-composer-actions")], [
            h.button([h.Class("vl-send sui-chat-composer-send"), h.Type("submit"), h.AriaLabel("Send"), h.Disabled(model.draft.trim() === "")], ["↑"]),
          ]),
        ]),
      ],
    ),
  ])
}

/** Only the flow's catalog chooses media; narration cannot name a file. */
function mediaForStop(model: Model, h: H, page: string): ReadonlyArray<Html> {
  const stop = STOPS.find((stop) => page === DOCS_URL + stop.path)
  return stop === undefined ? [] : media(model, h, "vl-stop-media", stop.media)
}

/** Loading videos show their native poster. A failed image or video removes its whole figure. */
function media(model: Model, h: H, className: string, asset: StopMedia, controls = false): ReadonlyArray<Html> {
  if (model.failedMedia?.includes(asset.src)) return []
  const source = (src: string) => model.mediaSources?.[src] ?? src
  const video = asset.poster !== undefined
  const failed = Message.FailedMedia({ src: asset.src, kind: video ? "video" : "image" })
  const still = video && model.reducedMotion && !controls ? asset.poster! : asset.src
  return [h.figure([h.Class(className), h.Key(asset.src)], [
    ...(video && (!model.reducedMotion || controls) ? [h.video([
      h.Key(asset.src), h.Src(source(asset.src)), h.Poster(source(asset.poster!)),
      h.Autoplay(!model.reducedMotion), h.Muted(true), h.Playsinline(true), h.Loop(asset.loop ?? false), h.Controls(controls),
      h.AriaLabel(asset.alt), h.OnError(failed), h.OnPlay(Message.LoadedMedia({ kind: "video" })),
    ], [])] : [h.img([
      h.Key(still), h.Src(source(still)), h.Alt(asset.alt), h.OnError(failed), h.OnLoad(Message.LoadedMedia({ kind: "image" })),
    ])]),
  ])]
}
