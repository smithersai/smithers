import * as ModelDecision from "./modelDecision.vibe"
import * as ActionFollow from "./actionFollowDecision.vibe"
import * as ModelWrite from "./modelWrite.vibe"
import * as ScreenRead from "./screenRead.vibe"
import * as IssueDecision from "./issueDecision.vibe"
import * as TourDecision from "./tourDecision.vibe"
import { WALKTHROUGH, DEMO_QUESTION } from "../core/walkthroughSteps.vibe"
import { TourPresentation, presentation } from "./theatre.vibe"
import { surfaceTransition, toggleSandbox, maximizeSandbox, currentSandbox, canSandboxAction } from "./viewDecision.vibe"
import { IssuesUi, initialIssues, issueScreen, issuesUpdate } from "./issues.vibe"
import { IssueFailure, IssueRequest, IssuesState, IssueOperation } from "../core/issueSchemas.vibe"
// The web app's Foldkit program: Model, Messages, update, Commands and Subscriptions. The view is `view.vibe`. Every
// change to the conversation goes through the shared machine (`../core/conversation.vibe`); this file only adds what a
// screen needs on top of it (wiki/decisions/0003-one-state-machine.md).
//
//   splash (maximized) ──⌘K──▶ palette ──⏎──▶ chat (the splash shrinks into the first pane) ──pane──▶ splash
//   splash ──Learn more──▶ chat with the agent in control (glow, Esc) ──Escape / Esc / tour ends──▶ chat
//
// Learn more starts the agent's tour in this tab's own conversation (wiki/decisions/0014-agent-tour.md): the agent
// narrates and opens VibeLang's docs in a pane through the conversation's events, never through this file.
import { ExperimentalBrowserWindow, ExperimentalBrowserDocument } from "vibelang-runtime/experimental/platform-browser"
import { Command, Dom, Render, Subscription, type Runtime, type Update } from "foldkit"
import { defineMessageUnion } from "foldkit/message"
import * as Machine from "../core/conversation.vibe"
import { SandboxSnapshot, EventSchema, Factory } from "../core/Factory.vibe"
import { Client } from "../core/schemas.vibe"
import { escapeAction, hasContent, scrollFollow, follows, paletteChange, completedEvent, answerAnnouncement, screenKey, showSplash, setScreenPalette, failScreenTour, failedScreenEnd, completeScreenTour, latestScreen, toggleScreenDocs } from "./screenDecision.vibe"
import { MediaSources, observeMedia } from "./media.vibe"
import { Identity, viewer } from "../core/roles.vibe"
import { WikiFailure, WikiRequest } from "../core/wikiSchemas.vibe"
import { DurableText } from "../core/wire.vibe"
import * as PaneDecision from "./paneDecision.vibe"
import * as UpdateDecision from "./updateDecision.vibe"
import * as ArmDecision from "./armDecision.vibe"
import * as WikiEditorDecision from "./wikiEditorDecision.vibe"
import { pages, wikiEditable, wikiPage } from "../core/wiki.vibe"
import { Navigation } from "foldkit"
import { Actions, ActionFailure, Registered, Run, splitCommand } from "../actions/Actions.vibe"
import { ActionView, actionsOf, completions, mergeRuns, initial as initialActions } from "./actionModel.vibe"
import { transcriptViewport } from "./viewport.vibe"

// FLAGS

/** What the page knows when it starts: a random id for this tab's posts, the backend (pending until selected), and the name posts carry. */
export schema Flags {
  readonly tutorialSession?: string
  /** A fresh UUID at startup; every request, retry and recovery key starts with it, so it is durable text. */
  readonly session: DurableText
  readonly mode: "mock" | "live" | "pending"
  readonly name: string
  readonly mediaSources?: MediaSources
  readonly wiki?: string
  readonly reducedMotion?: boolean
  readonly signInFailed?: boolean
  readonly openIssues?: boolean
  readonly tourSound?: boolean
  readonly resumeTour?: boolean
  readonly autoTour?: boolean
  readonly resumeRecovery?: string
  readonly resumeOp?: string
  readonly resumeKey?: string
}

export schema AccountState {
  readonly identity: Identity
  readonly menu: boolean
  readonly people: "closed" | "pane" | "max"
  readonly members: ReadonlyArray<Identity>
  readonly target: string
  readonly targetRole: "new" | "community" | "contributor" | "maintainer"
  readonly pending: boolean
  readonly error: string
  readonly retry: "sign-in" | "people" | "grant" | "sign-out" | "roles"
  readonly notice: string
  readonly ledger: Client
  readonly epoch: number
  readonly from: number
}
export const signedOut: AccountState = { identity: viewer, menu: false, people: "closed", members: [], target: "", targetRole: "community", pending: false, error: "", retry: "sign-in", notice: "", ledger: Machine.newClient, epoch: 0, from: 0 }
export function accountOf(model: Model): AccountState { return model.account }
export function issueStateOf(model: Model): IssuesUi {
  const ui = model.issues ?? initialIssues
  return { ...ui, keyPrefix: model.session, role: accountOf(model).identity.role, connection: initialIssues.connection + (ui.retry === undefined ? "" : `?resume-op=${ui.retry.op}&resume-key=${ui.retry.key}` + (ui.retry.recovery === undefined ? "" : `&resume-recovery=${ui.retry.recovery}`)) }
}

// MODEL

export schema Model {
  readonly account: AccountState
  readonly issues?: IssuesUi

  /** `splash`: the home page fills the window. `chat`: the conversation, with the home page as its first pane. */
  readonly surface: "splash" | "chat"
  /** Whether the ⌘K prompt is open. */
  readonly palette: boolean
  readonly draft: string
  readonly tutorialSession?: string
  readonly session: DurableText
  readonly name: string
  readonly mediaSources?: MediaSources
  readonly failedMedia?: ReadonlyArray<string>
  readonly reducedMotion: boolean
  /** How many posts this tab has sent; the next one's client id is `<session>-<sent + 1>`. */
  readonly sent: number
  readonly conversation: string
  readonly client: Client
  readonly mode: "mock" | "live" | "pending"
  /**
   * The event stream: `open` while it follows, `failed` after it broke. The page follows its conversation from the
   * start, so a person sees everyone's posts, the agent's through the CLI or MCP server included, before posting (0007).
   */
  readonly stream: "open" | "failed"
  /** Bumped to start the event stream again from `from`. */
  readonly epoch: number
  readonly from: number
  /** Follow transcript growth until the reader scrolls away from the bottom. */
  readonly following: boolean
  /** Native input revision that authorized following; older scheduled work cannot scroll. */
  readonly followIntent: number
  /** Live regions change only for completed answers and connection transitions. */
  readonly answer: string
  readonly announced: number
  readonly connection: string
  /** Whether the agent is in control: the tour runs, the screen glows and Escape ends it. */
  readonly theatre: { readonly step: number; readonly paused: boolean; readonly sound: boolean; readonly target: string }
  readonly tourClient?: Client
  readonly recoverTour?: boolean
  readonly tourDismissed?: boolean
  readonly toured?: boolean
  readonly autoTour?: boolean
  readonly theatreBox?: { readonly x: number; readonly y: number; readonly width: number; readonly height: number }
  readonly tour: boolean
  /** Why the last Learn more didn't start a tour; `""` when it did. */
  readonly tourError: string
  /** Shared docs/wiki pane size: in the conversation, or maximized over it. */
  readonly docs: "pane" | "max"
  readonly sandboxPane?: "closed" | "pane" | "max"
  readonly sandbox?: SandboxSnapshot
  readonly sandboxOperation?: "start" | "stop" | "command" | ""
  readonly sandboxBusy?: boolean
  readonly sandboxRequest: number
  readonly sandboxError?: string
  readonly terminalDraft?: string
  readonly minuteNotice?: string
  readonly warnedMonth?: number
  readonly wikiQuery?: string
  readonly wikiRequested?: string
  readonly wikiStatus?: "loading" | "ready" | "error"
  readonly wikiAfter?: string
  readonly wikiRequest?: number
  /** The pane's editor: the page, the repository source it started from, and the person's text. */
  readonly wikiEdit?: { readonly page: string; readonly base: string; readonly text: string; readonly busy: boolean; readonly error: string; readonly submission?: WikiRequest | undefined; readonly stale?: number } | undefined
  /** The repository-observed sources overlaying the build's embedded pages. */
  readonly wikiPages?: ReadonlyArray<{ readonly id: string; readonly source: string; readonly revision: string }>
  /** The person's open review change for a page, linked until they navigate away. */
  readonly wikiReview?: { readonly page: string; readonly url: string } | undefined
  readonly wikiSerial: number
  readonly wikiEditRequest: number
  readonly actions?: ActionView
}

/** The conversation every visitor of the home page joins until conversations have their own pages. */
export const HOME_CONVERSATION = "home"

/** This tab's own conversation for the agent's tour, so a tour never takes the shared home conversation's agent. */
export function tourConversation(session: string): string {
  return `tour-${session}`
}

/** Where Contribute goes until the factory's own contribution features exist (roadmap bricks 2 to 4). */
export const CONTRIBUTE_URL = "https://github.com/smithersai/vibelang/blob/main/CONTRIBUTING.md"

// MESSAGE

export const Message = defineMessageUnion({
  ObservedMedia: {},
  LoadedMedia: { kind: Schema.Literals(["image", "video"]) },
  FailedMedia: { src: Schema.String, kind: Schema.Literals(["image", "video"]) },
  AccountLoaded: { identity: Identity },
  AccountFailed: {},
  ClickedAccount: {},
  ClickedSignIn: {},
  ClickedSignOut: {},
  ClickedPeople: {},
  LoadedPeople: { members: Schema.Array(Identity) },
  ClosedPeople: {},
  ToggledPeople: {},
  ChoseIdentity: { role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]) },
  SelectedRole: { id: Schema.String, role: Schema.Literals(["new", "community", "contributor", "maintainer"]) },
  CancelledRole: {},
  ConfirmedRole: {},
  GrantedRole: {},
  ReceivedRole: { event: EventSchema },
  FailedRoles: {},
  DismissedAccountError: {},
  RetriedAccount: {},
  ClickedIssues: {},
  IssueUi: { action: Schema.String, value: Schema.String },
  IssuesLoaded: { data: IssuesState, created: Schema.Boolean, op: Schema.optionalKey(IssueOperation), key: Schema.optionalKey(Schema.String), role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]) },
  IssuesFailed: { unwritten: Schema.optionalKey(Schema.Boolean), reason: Schema.String, op: Schema.optionalKey(IssueOperation), key: Schema.optionalKey(Schema.String) },
  IssueDialogFocused: {},
  OpenIssueCard: { number: Schema.Number },
  IssueProjectionLoaded: { data: IssuesState },
  IssueDetailsLoaded: { data: IssuesState, number: Schema.Number },
  IssueDetailsFailed: { number: Schema.Number },
  ResolvedMode: { mode: Schema.Literals(["mock", "live"]) },
  PressedCommandK: {},
  PressedEscape: {},
  ClickedAsk: {},
  ClickedSplash: {},
  ClickedChat: {},
  UpdatedDraft: { value: Schema.String },
  SubmittedDraft: {},
  SucceededPost: { clientId: Schema.String },
  FailedPost: { clientId: Schema.String, reason: Schema.String },
  ReceivedEvent: { event: EventSchema },
  FailedEvents: { reason: Schema.String },
  ClickedReconnect: {},
  ClickedRetry: { clientId: Schema.String },
  FocusedPrompt: {},
  ScrolledTranscript: { bottom: Schema.Boolean, intent: Schema.optionalKey(Schema.Number) },
  ClickedLatest: {},
  ClickedLearnMore: {},
  ClickedEndTour: {},
  AutoTour: {},
  ClickedPauseTour: {},
  ClickedBackStop: {},
  ClickedSkipStop: {},
  ToggledTourSound: {},
  ReceivedTourEvent: { event: EventSchema },
  FailedTourEvents: {},
  MeasuredTheatre: { x: Schema.Number, y: Schema.Number, width: Schema.Number, height: Schema.Number },
  RemeasureTheatre: {},
  MovedTourFocus: { backward: Schema.Boolean },
  SucceededTour: {},
  FailedTour: { reason: Schema.String },
  FailedEndTour: {},
  ClickedDocs: {},
  ClickedSandboxes: {},
  MaximizedSandboxes: {},
  StartedSandbox: {},
  StoppedSandbox: {},
  UpdatedTerminal: { value: Schema.String },
  SubmittedTerminal: {},
  // `polled`: the pane's periodic read, which never ends or clears an operation (PaneDecision.polledSandbox).
  LoadedSandbox: { conversation: Schema.String, request: Schema.Number, snapshot: SandboxSnapshot, polled: Schema.optionalKey(Schema.Boolean) },
  FailedSandbox: { conversation: Schema.String, request: Schema.Number, reason: Schema.String, polled: Schema.optionalKey(Schema.Boolean) },
  ClickedActions: {},
  MaximizedActions: {},
  SelectedAction: { name: Schema.String },
  SelectedActionStep: { key: Schema.String },
  SelectedRun: { id: Schema.String, flow: Schema.String },
  LoadedActions: { epoch: Schema.optionalKey(Schema.Number), entries: Schema.Array(Registered), commands: Schema.Array(Registered), runs: Schema.Array(Run) },
  FailedActions: { code: Schema.String, epoch: Schema.optionalKey(Schema.Number), op: Schema.optionalKey(Schema.Literals(["load", "run", "cancel"])) },
  UpdatedActionInput: { value: Schema.String },
  ClickedRunAction: {},
  StartedAction: { run: Run, epoch: Schema.optionalKey(Schema.Number) },
  ChangedAction: { run: Run },
  FollowedAction: { run: Run, epoch: Schema.Number, generation: Schema.Number, ids: Schema.Array(Schema.String) },
  FailedActionFollow: { id: Schema.String, epoch: Schema.Number, generation: Schema.Number, ids: Schema.Array(Schema.String) },
  ReconnectedActions: {},
  ClickedCancelAction: {},
  TickedActions: { at: Schema.Number },
  RetriedActions: {},
  MovedSlash: { delta: Schema.Number },
  PickedSlash: { name: Schema.String },
  ClickedWiki: { page: Schema.String },
  FilteredWiki: { value: Schema.String },
  WikiLocationChanged: { page: Schema.String },
  FailedWiki: { request: Schema.Number },
  SucceededWiki: {},
  ClickedEditWiki: {},
  ClickedWikiDraft: { page: Schema.String },
  UpdatedWikiEdit: { value: Schema.String },
  CanceledWikiEdit: {},
  SubmittedWikiEdit: {},
  BeganWikiEdit: { request: Schema.Number, page: Schema.String, source: Schema.String, draft: Schema.String, stale: Schema.optionalKey(Schema.Number) },
  CompletedWikiEdit: { request: Schema.Number, page: Schema.String, source: Schema.String, revision: Schema.String, review: Schema.String },
  FailedWikiEdit: { request: Schema.Number, reason: Schema.String, unwritten: Schema.optionalKey(Schema.Boolean) },
})
export type Message = typeof Message.Type

// INIT

export function init(flags: Flags): Update.Return<Model, Message, Factory | Actions> {
  const initialized: Update.Return<Model, Message, Factory | Actions> = {
    model: {
      account: flags.signInFailed ? { ...signedOut, error: "Sign-in failed. GitHub didn’t answer." } : signedOut,
      surface: "splash",
      palette: false,
      draft: "",
      session: flags.session,
      tutorialSession: flags.tutorialSession ?? flags.session,
      name: flags.name,
      reducedMotion: flags.reducedMotion ?? false,
      mediaSources: flags.mediaSources ?? {},
      failedMedia: [],
      sent: 0,
      conversation: HOME_CONVERSATION,
      client: Machine.newClient,
      mode: flags.mode,
      stream: "open",
      epoch: 0,
      from: 0,
      following: true,
      followIntent: 0,
      answer: "",
      announced: 0,
      connection: "",
      tour: false,
      theatre: { step: 1, paused: false, sound: flags.tourSound ?? false, target: "splash" },
      autoTour: flags.autoTour ?? false,
      recoverTour: flags.resumeTour ?? false,
      tourError: "",
      docs: "pane",
      sandboxRequest: 0,
      wikiSerial: 0,
      wikiEditRequest: 0,
      ...(flags.openIssues ? { issues: initialIssues } : {}),
      actions: initialActions,
    },
    ...(flags.openIssues ? { commands: [LoadIssues({ ...(flags.resumeRecovery === undefined ? {} : { resumeRecovery: flags.resumeRecovery }), ...(flags.resumeOp === undefined ? {} : { resumeOp: flags.resumeOp }), ...(flags.resumeKey === undefined ? {} : { resumeKey: flags.resumeKey }) })] } : {}),
  }
  if (flags.resumeTour) return learnMore(initialized.model)
  return flags.wiki ? visitWiki(initialized.model, flags.wiki) : initialized
}

// UPDATE

export function update(model: Model, message: Message): WithCommands<Update.Return<Model, Message, Factory | Actions>> {
  const next = withCommands(Message.match<Update.Return<Model, Message, Factory | Actions>>(message, {
    ObservedMedia: () => ({ model }),
    LoadedMedia: ({ kind }) => ({ model, commands: [ObserveMedia({ kind, outcome: "loaded" })] }),
    FailedMedia: ({ src, kind }) => ({ model: ModelWrite.failedMediaWrite(model, ArmDecision.failedMediaAfter(model.failedMedia ?? [], src)), commands: [ObserveMedia({ kind, outcome: "failed" })] }),

    ResolvedMode: ({ mode }) => ({ model: ModelWrite.modeWrite(model, mode), commands: [LoadAccount({})] }),
    AccountLoaded: ({ identity }) => {
      const { ledger: snapshot, ...person } = identity
      const ledger = { conversation: snapshot ?? Machine.empty, pending: [], gap: false }
      const account = accountOf(model)
      const step = ModelDecision.accountLoaded({ id: account.identity.id, role: account.identity.role, target: account.target, error: account.error, people: account.people, epoch: account.epoch, actionsEpoch: actionsOf(model).epoch ?? 0, wikiEditRequest: model.wikiEditRequest, sandboxRequest: model.sandboxRequest }, person.id, person.login, person.role, ledger.conversation.seq)
      const commands = [...(step.closeDialog ? [CloseRoleDialog({})] : []), ...(step.changedAccount ? [LoadActions({ flow: actionsOf(model).selected, epoch: step.actionsEpoch })] : [])]
      return {
        model: { ...ModelWrite.scopeWrite(model, actionsOf(model), step.changedAccount, step.actionsEpoch, step.wikiEditRequest, step.sandboxRequest), ...(step.changedPerson ? { terminalDraft: "", sandboxPane: "closed" as const } : {}), name: step.name, account: {
          ...account, identity: person, pending: false,
          error: step.error, menu: false, target: "",
          people: step.people,
          ledger, epoch: step.epoch, from: step.from,
          notice: step.notice,
        } },
        ...(commands.length > 0 ? { commands } : {}),
      }
    },
    AccountFailed: () => runAccount(model, ModelDecision.accountFailed(accountScreen(model))),
    ClickedAccount: () => runAccount(model, ModelDecision.clickedAccount(accountScreen(model))),
    ClickedSignIn: () => runAccount(model, ModelDecision.clickedSignIn(accountScreen(model), model.mode === "live", accountOf(model).identity.available === false, model.mode === "mock")),
    ClickedSignOut: () => runAccount(model, ModelDecision.clickedSignOut(accountScreen(model))),
    ChoseIdentity: ({ role }) => ({ model, commands: [ChooseIdentity({ role })] }),
    ClickedPeople: () => runAccount(model, ModelDecision.clickedPeople(accountScreen(model))),
    LoadedPeople: ({ members }) => ({ model: ModelWrite.peopleWrite(model, accountOf(model), members, ArmDecision.pendingAfterPeople(accountOf(model).retry, accountOf(model).pending)) }),
    ClosedPeople: () => runAccount(model, ModelDecision.closedPeople(accountScreen(model))),
    ToggledPeople: () => runAccount(model, ModelDecision.toggledPeople(accountScreen(model))),
    SelectedRole: ({ id, role }) => !ModelDecision.canSelectRole(accountOf(model).identity.role) ? { model } : runAccount(model, ModelDecision.selectedRole(accountScreen(model), id, role)),
    CancelledRole: () => runAccount(model, ModelDecision.cancelledRole(accountScreen(model))),
    ConfirmedRole: () => runAccount(model, ModelDecision.confirmedRole(accountScreen(model))),
    GrantedRole: () => runAccount(model, ModelDecision.grantedRole(accountScreen(model))),
    ReceivedRole: ({ event }) => {
      const account = accountOf(model)
      const ledger = Machine.receive(account.ledger, event)
      const grant = event.type === "RoleGranted" ? event : undefined
      const step = ModelDecision.roleReceived(
        { role: account.identity.role, target: account.target, pending: account.pending, notice: account.notice, epoch: account.epoch, from: account.from, actionsEpoch: actionsOf(model).epoch ?? 0, wikiEditRequest: model.wikiEditRequest, sandboxRequest: model.sandboxRequest },
        { gap: ledger.gap, granted: grant !== undefined, seq: ledger.conversation.seq, previousSeq: account.ledger.conversation.seq, roles: ledger.conversation.roles.length, previousRoles: account.ledger.conversation.roles.length, mine: event.id === account.identity.id, participation: grant?.mode === "participation", person: grant?.mode === "person", peopleOpen: account.people !== "closed", ledgerRole: Machine.roleOf(ledger.conversation.roles, account.identity.id), roleName: grant === undefined ? "" : roleLabel(grant.role), name: account.members.find(person => person.id === event.id)?.login ?? event.id },
      )
      if (step.replay) return { model: ModelWrite.accountReplayWrite(model, account, Machine.resume(ledger), step.state.epoch, step.state.from) }
      const identity = step.state.role === account.identity.role ? account.identity : { ...account.identity, role: step.state.role }
      const commands = [...(step.closeDialog ? [CloseRoleDialog({})] : []), ...(step.loadPeople ? [LoadPeople({})] : []), ...(step.changedRole ? [LoadActions({ flow: actionsOf(model).selected, epoch: step.state.actionsEpoch })] : [])]
      return { model: { ...ModelWrite.scopeWrite(model, actionsOf(model), step.changedRole, step.state.actionsEpoch, step.state.wikiEditRequest, step.state.sandboxRequest), account: { ...account, ledger, identity, notice: step.state.notice, target: step.state.target, pending: step.state.pending } }, ...(commands.length > 0 ? { commands } : {}) }
    },
    FailedRoles: () => runAccount(model, ModelDecision.failedRoles(accountScreen(model))),
    RetriedAccount: () => ModelDecision.accountRetryPlan(accountOf(model).retry) === "sign-in" ? update(model, Message.ClickedSignIn()) : runAccount(model, ModelDecision.retriedAccount(accountScreen(model), accountOf(model).ledger.conversation.seq)),
    DismissedAccountError: () => runAccount(model, ModelDecision.dismissedAccountError(accountScreen(model))),
    OpenIssueCard: ({ number }) => ({ model: ModelWrite.issueScreenWrite(model, model.issues ?? initialIssues, IssueDecision.openedIssueCard(issueScreen(model.issues ?? initialIssues), number)), commands: [LoadIssues({}), ...(IssueDecision.issueCardLoadsDetails(model.mode) ? [LoadIssueDetails({ number, key: `${model.session}-card-${number}-${(model.issues?.serial ?? 0) + 1}` })] : [])] }),
    IssueProjectionLoaded: ({ data }) => !IssueDecision.issueProjectionApplies(data.seq, model.issues?.data.seq ?? 0) ? { model } : { model: ModelWrite.issueProjectionWrite(model, model.issues ?? { ...initialIssues, open: false }, data, data.role ?? IssueDecision.issueDefaultRole(model.mode)) },
    ClickedIssues: () => ({ model: ModelWrite.issuesOpenedWrite(model, model.issues ?? initialIssues), commands: IssueDecision.clickedIssuesLoads(model.issues?.busy === true) ? [LoadIssues({})] : [] }),
    IssueUi: ({ action, value }) => {
      const before = issueStateOf(model)
      // An input's value may hold a lone surrogate; every request text is DurableText (as UpdatedWikiEdit guards).
      const text = value.toWellFormed()
      const result = issuesUpdate(before, action, text)
      const effects = IssueDecision.issueUiEffects(action, text, model.mode === "live", before.dialog, result.ui.dialog)
      return { model: ModelWrite.issueUiWrite(model, result.ui, effects.bumpSerial, before.serial + 1, effects.toChat), commands: [
        ...(effects.details ? [LoadIssueDetails({ number: Number(value), key: `${model.session}-detail-${before.serial + 1}` })] : []),
        ...(result.request === undefined ? [] : [ActOnIssue({ request: result.request })]),
        ...(effects.focus === "" ? [] : [FocusIssueControl({ id: effects.focus })]),
        ...(effects.showDialog ? [ShowIssueDialog({})] : []),
        ...(effects.closeDialog ? [CloseIssueDialog({})] : []),
      ] }
    },
    IssuesLoaded: ({ data, created, role, op, key }) => {
      const ui = model.issues ?? initialIssues
      if (data.saved !== undefined) {
        const { request, status, unwritten, selected } = data.saved
        const step = IssueDecision.issueRecovered(issueScreen(ui), request.op, status === "completed", unwritten, selected, request.title, request.text, request.example, request.prior, String(request.parent), request.assignee)
        // The recovery read returns the list; a restored detail view still needs its comments and timeline.
        const commands = step.state.screen === "detail" && selected > 0 && IssueDecision.issueCardLoadsDetails(model.mode)
          ? [LoadIssueDetails({ number: selected, key: `${model.session}-restored-${selected}` })] : []
        return { model: ModelWrite.issueResponseWrite(model, ui, step.state, data, role, model.session, step.clearRetry, request), commands }
      }
      const settled = ModelDecision.issueResponseSettles(ui.retry?.op ?? null, ui.retry?.key ?? null, op ?? null, key ?? null)
      const assignee = data.assignees === undefined ? ui.assignee : IssueDecision.issueAssigneeAfter(data.assignees.some((a) => a.login === ui.assignee), ui.assignee, data.assignees.find((a) => a.label === "VibeLang agent")?.login ?? "")
      const step = IssueDecision.issueLoaded(issueScreen(ui), settled, created, data.draft !== undefined, data.draft?.title ?? "", data.draft?.summary ?? "", data.draft?.example ?? "", data.draft?.prior ?? "", assignee, data.selected ?? newestIssue(data.items))
      return { model: ModelWrite.issueResponseWrite(model, ui, step.state, IssueDecision.issueDataApplies(data.draft !== undefined, data.seq, ui.data.seq) ? data : ui.data, role, ui.keyPrefix, step.clearRetry, ui.retry), commands: step.closeDialog ? [CloseIssueDialog({})] : [] }
    },
    IssuesFailed: ({ reason, op, key, unwritten }) => {
      const ui = model.issues ?? initialIssues
      const relevant = ModelDecision.issueResponseSettles(ui.retry?.op ?? null, ui.retry?.key ?? null, op ?? null, key ?? null)
      const step = IssueDecision.issueFailed(issueScreen(ui), ui.data.items.length === 0, relevant, unwritten === true, reason === "connect" ? "Connect GitHub." : reason === "fork" ? "Fork on GitHub." : reason === "install" ? "Install Smithers on your fork." : IssueDecision.issueFailureText(reason))
      return { model: ModelWrite.issueResponseWrite(model, ui, step.state, ui.data, ui.role, ui.keyPrefix, step.clearRetry, ui.retry) }
    },
    IssueDetailsLoaded: ({ data, number }) => model.issues === undefined || !ModelDecision.issueDetailsApply(model.issues.selected, number, data.seq, model.issues.data.seq) ? { model } : { model: ModelWrite.issueDetailsWrite(model, model.issues, data) },
    IssueDetailsFailed: ({ number }) => model.issues === undefined || !ModelDecision.issueDetailsFailureShows(model.issues.selected, number, model.issues.retry !== undefined) ? { model } : { model: ModelWrite.issueScreenWrite(model, model.issues, IssueDecision.issueDetailsFailed(issueScreen(model.issues))) },
    IssueDialogFocused: () => ({ model }),
    PressedCommandK: () => openPalette(model, !model.palette),
    ClickedAsk: () => openPalette(model, true),
    // Escape first takes control back from the agent, then closes what is open, innermost first.
    PressedEscape: () => runEscape(model, UpdateDecision.pressedEscape(escapeScreen(model), escapeAction(model.tour, touringHere(model), model.palette, model.surface, model.docs), model.client.conversation.pane.startsWith("/wiki/"))),
    MovedTourFocus: ({ backward }) => ({ model, commands: [FocusTourControl({ backward })] }),
    AutoTour: () => TourDecision.autoTourStarts(model.surface, model.palette, model.tour, model.issues?.open === true, hasConversation(model)) ? learnMore(model) : { model },
    MeasuredTheatre: (box) => ({ model: ModelWrite.theatreBoxWrite(model, box) }),
    RemeasureTheatre: () => ({ model, commands: TourDecision.remeasures(model.tour) ? [MeasureTheatre({ target: model.theatre.target })] : [] }),
    ClickedPauseTour: () => runTourControl(model, TourDecision.pauseTour(model.tour, model.theatre.paused)),
    ClickedBackStop: () => runTourControl(model, TourDecision.backTour(model.tour, model.theatre.step)),
    ClickedSkipStop: () => runTourControl(model, TourDecision.skipTour(model.tour, model.theatre.step)),
    ToggledTourSound: () => {
      const present = TourDecision.toggledSound({ step: model.theatre.step, sound: model.theatre.sound, active: model.tour, paused: model.theatre.paused })
      return { model: ModelWrite.soundWrite(model, present.sound), commands: [PresentTour(present)] }
    },
    ReceivedTourEvent: ({ event }) => receiveTour(model, event),
    FailedTourEvents: () => ({ model: ModelWrite.tourEventsFailedWrite(model) }),
    ClickedLearnMore: () => learnMore(model),
    ClickedEndTour: () => endTour(model),
    // Ended before the tour was even recorded: end it now that it is.
    // Only the person's end (a dismissal) ends a start that lands late: an earlier tour's recorded end, replayed while
    // this start was in flight, also leaves `tour` false and must not end the new tour.
    SucceededTour: () => TourDecision.endsLateTour(model.tour || model.tourDismissed !== true) ? { model, commands: [EndTourCommand({ conversation: tourConversation(walkthroughSession(model)) })] } : { model },
    // Busy while this tab's own tour runs (a Learn more racing an Escape): that tour keeps control.
    FailedTour: ({ reason }) => TourDecision.failedTourKeeps(touringHere(model), model.recoverTour === true, reason) ? { model: ModelWrite.keptTourWrite(model, TourDecision.keptTour()) } : {
      model: { ...ModelWrite.screenWrite(model, failScreenTour(ScreenRead.screenOf(model), reason, false)), surface: "chat", recoverTour: false },
      commands: [PresentTour({ step: model.theatre.step, sound: model.theatre.sound, active: false, paused: false }), FocusComposer({})],
    },
    // The end never reached the agent: it still drives, so Esc comes back.
    FailedEndTour: () => recoverEndTour(model),
    ClickedSandboxes: () => ({ model: ModelWrite.sandboxPaneWrite(model, toggleSandbox(model.sandboxPane ?? "closed")) }),
    MaximizedSandboxes: () => ({ model: ModelWrite.sandboxPaneWrite(model, maximizeSandbox(model.sandboxPane ?? "closed")) }),
    StartedSandbox: () => sandboxAction(model, "start"),
    StoppedSandbox: () => sandboxAction(model, "stop"),
    UpdatedTerminal: ({ value }) => ({ model: ModelWrite.terminalDraftWrite(model, value) }),
    SubmittedTerminal: () => sandboxAction(model, "command"),
    LoadedSandbox: ({ conversation, request, snapshot, polled }) => {
      if (!currentSandbox(conversation, model.conversation, request, model.sandboxRequest)) return { model }
      const zero = ModelDecision.sandboxOutOfMinutes(snapshot.remaining, snapshot.id, snapshot.status)
      const low = ModelDecision.sandboxLowMinutes(snapshot.remaining, model.warnedMonth ?? null, snapshot.resetAt)
      const opens = ModelDecision.sandboxPaneOpens(snapshot.status, model.sandbox?.status ?? null)
      const result = polled === true ? PaneDecision.polledSandbox(sandboxResult(model), opens) : PaneDecision.loadedSandbox(sandboxResult(model), opens)
      const notice = PaneDecision.sandboxNotice(zero, low, model.sandbox?.resetAt !== snapshot.resetAt)
      return { model: ModelWrite.sandboxLoadedWrite(model, result, snapshot, minuteNotice(notice, snapshot.id, snapshot.remaining, model.minuteNotice ?? ""), PaneDecision.warnedMonthAfter(low, snapshot.resetAt, model.warnedMonth ?? 0)) }
    },
    FailedSandbox: ({ conversation, request, reason, polled }) => !currentSandbox(conversation, model.conversation, request, model.sandboxRequest) ? { model } : (() => { const result = polled === true ? PaneDecision.polledFailure(sandboxResult(model), reason) : PaneDecision.failedSandbox(sandboxResult(model), reason); return { model: ModelWrite.sandboxFailureWrite(model, result) } })(),
    ClickedEditWiki: () => beginWikiEdit(model),
    ClickedWikiDraft: ({ page }) => beginWikiEdit(model, page),
    // The store keeps only well-formed text (DurableText): an unpaired surrogate becomes U+FFFD as it is typed, never at save.
    UpdatedWikiEdit: ({ value }) => model.wikiEdit === undefined || !PaneDecision.wikiEditTypes(model.wikiEdit.busy, model.wikiEdit.submission !== undefined) ? { model } : { model: ModelWrite.wikiEditWrite(model, model.wikiEdit, PaneDecision.updatedWikiEdit(wikiEditScreen(model.wikiEdit), value.toWellFormed())) },
    CanceledWikiEdit: () => WikiEditorDecision.wikiEditCloses(model.wikiEdit !== undefined, model.wikiEdit?.submission !== undefined) ? { model: ModelWrite.wikiEditClosedWrite(model) } : { model },
    SubmittedWikiEdit: () => {
      const editing = model.wikiEdit
      if (editing === undefined) return { model }
      const role = accountOf(model).identity.role
      const op = PaneDecision.wikiSubmitPlan(editing.busy, editing.text, editing.base, Machine.wikiPermission(role, "save"), Machine.wikiPermission(role, "propose"))
      if (op === "ignore" || op === "refuse") return { model }
      if (op === "no-changes") return { model: ModelWrite.wikiEditWrite(model, editing, PaneDecision.noWikiChanges(wikiEditScreen(editing))) }
      const serial = model.wikiSerial
      const step = WikiEditorDecision.submittedWikiEdit(wikiEditScreen(editing), op, serial, editing.submission !== undefined, wikiDraft(editing.submission), `${model.session}-wiki-${serial + 1}`, `${model.session}-wiki-retry-${serial + 1}`)
      const request = wikiRequest(step.submission)
      return { model: ModelWrite.wikiSubmittedWrite(model, editing, step.serial, step.editing, request), commands: [SubmitWikiEdit({ request, serial: model.wikiEditRequest })] }
    },
    BeganWikiEdit: ({ request, page, source, draft, stale }) => {
      const editing = model.wikiEdit
      if (editing === undefined || !PaneDecision.wikiBeginApplies(editing.busy, Machine.currentWikiEditor(page, request, editing.page, model.wikiEditRequest))) return { model }
      return { model: ModelWrite.wikiBeganWrite(model, editing, PaneDecision.beganWikiEdit(wikiEditScreen(editing), source, draft), stale), commands: [FocusWikiEditor({})] }
    },
    CompletedWikiEdit: ({ request, page, source, revision, review }) => model.wikiEdit === undefined || !Machine.currentWikiEditor(page, request, model.wikiEdit.page, model.wikiEditRequest) ? { model } : ({ model: ModelWrite.wikiCompletedWrite(model, WikiEditorDecision.savedWikiPages(model.wikiPages ?? [], page, source, revision), WikiEditorDecision.wikiReviewLinks(review) ? { page, url: review } : undefined) }),
    FailedWikiEdit: ({ request, reason, unwritten }) => {
      if (model.wikiEdit === undefined || !PaneDecision.wikiEditFailureApplies(request, model.wikiEditRequest)) return { model }
      const step = PaneDecision.failedWikiEdit(wikiEditScreen(model.wikiEdit), PaneDecision.wikiEditErrorText(reason), unwritten === true)
      return { model: ModelWrite.wikiFailedWrite(model, model.wikiEdit, step.state, step.submission === "clear") }
    },
    ClickedWiki: ({ page }) => visitWiki(model, page),
    WikiLocationChanged: ({ page }) => UpdateDecision.wikiLocationLeaves(page) ? { model: ModelWrite.wikiLeaveWrite(model) } : visitWiki(model, page),
    FilteredWiki: ({ value }) => ({ model: ModelWrite.wikiQueryWrite(model, value) }),
    FailedWiki: ({ request }) => ({ model: ModelWrite.wikiFailureWrite(model, model.wikiRequest !== undefined && ModelDecision.wikiFailureApplies(request, model.wikiRequest, model.wikiStatus === "loading")) }),
    SucceededWiki: () => ({ model }),
    ClickedDocs: () => ({ model: ModelWrite.screenWrite(model, toggleScreenDocs(ScreenRead.screenOf(model))), ...(UpdateDecision.docsRevealsWiki(model.docs, model.client.conversation.pane) ? { commands: [RevealWiki({})] } : {}) }),
    ClickedSplash: () => ({ model: ModelWrite.issuesClosedWrite(ModelWrite.screenWrite(model, showSplash(ScreenRead.screenOf(model)))) }),
    ClickedChat: () => minimizeSplash(model),
    UpdatedDraft: ({ value }) => {
      const menu = TourDecision.updatedDraftMenu(value, actionsOf(model).entries.length === 0)
      return {
        model: ModelWrite.draftWrite(model, actionsOf(model), value, menu.slash),
        ...(menu.load ? { commands: [LoadActions({ flow: "", ...(actionsOf(model).epoch === undefined ? {} : { epoch: actionsOf(model).epoch }) })] } : {}),
      }
    },
    ClickedActions: () => runActions(model, ModelDecision.clickedActions(actionScreen(model), actionsOf(model).entries.length !== 0, actionsOf(model).epoch ?? null)),
    MaximizedActions: () => runActions(model, ModelDecision.maximizedActions(actionScreen(model))),
    SelectedAction: ({ name }) => runActions(model, ModelDecision.selectedAction(actionScreen(model), name, actionsOf(model).epoch ?? null)),
    SelectedActionStep: ({ key }) => ({ model: ModelWrite.actionStepWrite(model, actionsOf(model), key) }),
    SelectedRun: ({ id, flow }) => ({ model: ModelWrite.actionSelectedWrite(model, actionsOf(model), ModelDecision.selectedRun(runSelection(model), id, flow)) }),
    LoadedActions: ({ entries, commands, runs, epoch }) => !ModelDecision.actionsEpochCurrent(epoch ?? null, actionsOf(model).epoch ?? null) ? { model } : ({ model: ModelWrite.actionsLoadedWrite(model, { ...actionsOf(model), disconnected: ActionFollow.settled(actionsOf(model).disconnected ?? [], runs), stoppedFollows: ActionFollow.settled(actionsOf(model).stoppedFollows ?? [], runs) }, entries, commands, mergeRuns(actionsOf(model).runs, runs)) }),
    FailedActions: ({ code, epoch, op }) => !ModelDecision.actionsFailureApplies(epoch ?? null, actionsOf(model).epoch ?? null) ? { model } : runActions(model, ModelDecision.failedActions(actionScreen(model), code, op ?? "load")),
    UpdatedActionInput: ({ value }) => runActions(model, ModelDecision.updatedActionInput(actionScreen(model), value)),
    ClickedRunAction: () => launchAction(model, actionsOf(model).selected, "button"),
    StartedAction: ({ run, epoch }) => !ModelDecision.actionsEpochCurrent(epoch ?? null, actionsOf(model).epoch ?? null) ? { model } : ({ model: ModelWrite.actionStartedWrite(model, actionsOf(model), ModelDecision.followedRun(runSelection(model), run.id, run.flow), mergeRuns(actionsOf(model).runs, [run])), commands: [ClosePalette({ dock: true })] }),
    ChangedAction: ({ run }) => ({ model: ModelWrite.actionChangedWrite(model, actionsOf(model), mergeRuns(actionsOf(model).runs, [run]), ActionFollow.settled(actionsOf(model).disconnected ?? [], [run]), ActionFollow.settled(actionsOf(model).stoppedFollows ?? [], [run])) }),
    FollowedAction: ({ run, epoch, generation, ids }) => !actionFollowCurrent(model, epoch, generation, ids) ? { model } : ({ model: ModelWrite.actionFollowedWrite(model, actionsOf(model), mergeRuns(actionsOf(model).runs, [run]), ActionFollow.received(actionsOf(model).disconnected ?? [], run.id)) }),
    FailedActionFollow: ({ id, epoch, generation, ids }) => !actionFollowCurrent(model, epoch, generation, ids) ? { model } : ({ model: ModelWrite.actionFollowFailedWrite(model, actionsOf(model), ActionFollow.failed(actionsOf(model).disconnected ?? [], id, actionsOf(model).runs), ActionFollow.failed(actionsOf(model).stoppedFollows ?? [], id, actionsOf(model).runs)) }),
    ReconnectedActions: () => ({ model: ModelWrite.actionsReconnectedWrite(model, actionsOf(model), ActionFollow.reconnected(actionsOf(model).followGeneration ?? 0)) }),
    TickedActions: ({ at }) => ({ model: ModelWrite.actionClockWrite(model, actionsOf(model), ModelDecision.actionsClock(actionsOf(model).now ?? 0, at)) }),
    ClickedCancelAction: () => ({ model: ModelWrite.actionCancelWrite(model, actionsOf(model)), commands: [CancelAction({ id: actionsOf(model).run })] }),
    RetriedActions: () => runActions(model, ModelDecision.retriedActions(actionScreen(model), actionsOf(model).epoch ?? null)),
    MovedSlash: ({ delta }) => {
      const menu = completions(model)
      return { model: ModelWrite.highlightWrite(model, actionsOf(model), ModelDecision.slashHighlight(actionsOf(model).highlight, delta, menu.length)) }
    },
    PickedSlash: ({ name }) => name.startsWith("mode/") ? switchMode(model, name.slice("mode/".length)) : launchAction(model, name, "slash"),
    SubmittedDraft: () => submit(model),
    SucceededPost: () => ({ model }),
    ClickedRetry: ({ clientId }) => {
      const index = UpdateDecision.retryIndex(model.client.pending, clientId)
      const waiting = model.client.pending[index]
      if (index < 0 || !waiting) return { model }
      return {
        model: ModelWrite.clientWrite(model, Machine.retryPost(model.client, clientId)),
        commands: [PostMessage({ conversation: model.conversation, clientId, name: model.name, text: waiting.text }), FocusComposer({})],
      }
    },
    FailedPost: ({ clientId, reason }) => ({ model: ModelWrite.clientWrite(model, Machine.failPost(model.client, clientId, reason)) }),
    ReceivedEvent: ({ event }) => {
      const client = Machine.receive(model.client, event)
      const completed = completedEvent(model.client.conversation.seq, client.conversation.seq, event.type)
      const paneUrl = event.type === "PaneOpened" ? event.url : ""
      const announcedAnswer = completed ? client.conversation.entries.find((entry) => entry.id === event.id) : undefined
      const plan = UpdateDecision.eventReceived({
        gap: client.gap, previousSeq: model.client.conversation.seq, seq: client.conversation.seq, type: event.type,
        wikiUrl: paneUrl.startsWith("/wiki/"), completed, linksIssue: /\]\(#issue-[1-9][0-9]*\)/.test(announcedAnswer?.text ?? ""),
        editing: model.wikiEdit !== undefined && model.wikiEdit.submission === undefined, samePage: paneUrl === `/wiki/${model.wikiEdit?.page ?? ""}`,
        peopleMax: accountOf(model).people === "max", streamOpen: model.stream === "open", connection: model.connection,
        epoch: model.epoch, from: model.from, announced: model.announced,
      })
      // A missed event: replay from the last one this copy applied.
      if (plan.replay) return { model: ModelWrite.eventReplayWrite(model, Machine.resume(client), plan.epoch, plan.from) }
      // The tour finished, failed or was ended: the agent no longer has control.
      const toured = completed && Machine.isTour(client.conversation.entries, event.id)
      const answer = announcedAnswer
      return {
        model: ModelWrite.eventWrite(model, completeScreenTour(model, toured, event.type), client,
          answerAnnouncement(answer !== undefined, answer?.error ?? "", answer?.text ?? "", model.answer), plan,
          TourDecision.minimizedSandbox(model.sandboxPane ?? "closed"),
          UpdateDecision.wikiAfterEvent(event.id, model.wikiAfter !== undefined && client.conversation.entries.some(entry => entry.id === model.wikiAfter), model.wikiAfter ?? ""),
          accountOf(model)),
        commands: [
          ...(plan.refreshIssues ? [RefreshIssueProjection({})] : []),
          ...(plan.wikiPane ? [WikiLocation({ url: paneUrl })] : []),
          ...(plan.readAction ? [ReadAction({ id: event.id })] : []),
        ],
      }
    },
    FailedEvents: () => ({ model: ModelWrite.streamWrite(model, TourDecision.failedEvents(streamScreen(model))) }),
    ClickedReconnect: () => ({ model: ModelWrite.streamWrite(model, TourDecision.reconnected(streamScreen(model), model.client.conversation.seq)), commands: [FocusComposer({})] }),
    FocusedPrompt: () => ({ model }),
    ScrolledTranscript: ({ bottom, intent = model.followIntent }) => {
      const next = scrollFollow(model.surface, model.palette, model.following, model.followIntent, bottom, intent)
      if (next.stale) return { model }
      return { model: ModelWrite.followWrite(model, next.following, next.followIntent) }
    },
    ClickedLatest: () => ({ model: ModelWrite.screenWrite(model, latestScreen(ScreenRead.screenOf(model))), commands: [FocusComposer({})] }),
  }))
  const before = accountOf(model).identity
  const after = accountOf(next.model).identity
  const issues = next.model.issues
  // The first session answer confirms startup identity; it must preserve a request already recovered for that session.
  // Once an account has been observed, changing people still drops the prior person's pending write.
  const after2 = UpdateDecision.afterUpdate(issues !== undefined, before.role !== after.role, (accountOf(model).epoch > 0 || before.id !== "") && before.id !== after.id, issues !== undefined && issues.dialog !== "", issues === undefined || issues.dialog === "" || Machine.issuePermission(after.role, issues.dialog), next.model.tour, message)
  if (after2.kind === "issues" && issues !== undefined) {
    return { ...next, model: ModelWrite.afterIssuesWrite(next.model, issues, after.role, after2), commands: [...next.commands, ...(after2.closeDialog ? [CloseIssueDialog({})] : [])] }
  }
  if (after2.kind === "measure") {
    return { ...next, commands: [...next.commands, MeasureTheatre({ target: next.model.theatre.target })] }
  }
  return next
}

/** The plain account state the proved arms in `modelDecision.vibe` read and return. */
function accountScreen(model: Model): ModelDecision.AccountScreen { return ScreenRead.accountScreen(model, accountOf(model)) }

function escapeScreen(model: Model): UpdateDecision.EscapeScreen { return ScreenRead.escapeScreen(model, accountOf(model), actionsOf(model)) }

/** Applies Escape's one proved change: its Model is the proved escapeWrite (modelWrite.vibe), which leaves the Model
 *  as it is for a tour, the palette and the splash, whose own steps then run; Escape writes the issues screen only when
 *  the Model has one (escapeWritesIssues), so the default never stands in for it. */
function runEscape(model: Model, step: UpdateDecision.EscapeStep): Update.Return<Model, Message, Factory | Actions> {
  const next = ModelWrite.escapeWrite(model, accountOf(model), actionsOf(model), model.issues ?? initialIssues, step)
  switch (step.kind) {
    case "tour": return endTour(next)
    case "palette": return openPalette(next, false)
    case "splash": return minimizeSplash(next)
    case "role": return { model: next, commands: [CloseRoleDialog({})] }
    case "issue-dialog": return { model: next, commands: [CloseIssueDialog({})] }
    case "menu": return { model: next, commands: [FocusAccountMenu({ open: false })] }
    case "docs": return { model: next, ...(step.reveal ? { commands: [RevealWiki({})] } : {}) }
    default: return { model: next }
  }
}

function accountCommand(command: ModelDecision.AccountCommand) {
  switch (command.type) {
    case "FocusAccountMenu": return FocusAccountMenu({ open: command.open })
    case "SignIn": return SignInAccount({ mock: command.mock })
    case "SignOut": return SignOutAccount({})
    case "LoadPeople": return LoadPeople({})
    case "ShowRoleDialog": return ShowRoleDialog({})
    case "CloseRoleDialog": return CloseRoleDialog({})
    case "GrantRole": return GrantRole({ id: command.id, role: command.role })
  }
}

/** Applies a proved account step: its state over the model, its commands as Foldkit Commands. */
function runAccount(model: Model, step: ModelDecision.AccountStep): Update.Return<Model, Message, Factory | Actions> {
  const next = ModelWrite.writeAccount(model, accountOf(model), step.state)
  return step.commands.length === 0 ? { model: next } : { model: next, commands: step.commands.map(accountCommand) }
}

function actionScreen(model: Model): ModelDecision.ActionScreen { return ScreenRead.actionScreen(actionsOf(model)) }

function runSelection(model: Model): ModelDecision.RunSelection { return ScreenRead.runSelection(actionsOf(model)) }
function actionFollowCurrent(model: Model, epoch: number, generation: number, ids: ReadonlyArray<string>): boolean {
  const actions = actionsOf(model)
  return ActionFollow.current(epoch, generation, actions.epoch ?? 0, actions.followGeneration ?? 0)
    && ActionFollow.same(ids, ActionFollow.watching(actions.runs, actions.stoppedFollows ?? []))
}


function actionCommand(command: ModelDecision.ActionCommand) {
  switch (command.type) {
    case "FocusComposer": return FocusComposer({})
    case "LoadActions": return LoadActions({ flow: command.flow, ...(command.epoch === null ? {} : { epoch: command.epoch }) })
  }
}

/** Applies a proved actions step: its state over the panel, its commands as Foldkit Commands. */
function runActions(model: Model, step: ModelDecision.ActionStep): Update.Return<Model, Message, Factory | Actions> {
  const next = ModelWrite.writeActions(model, actionsOf(model), step.state)
  return step.commands.length === 0 ? { model: next } : { model: next, commands: step.commands.map(actionCommand) }
}

/** An update the function always gives commands, so its callers need no empty default. */
type WithCommands<R extends { readonly commands?: unknown }> = R & { readonly commands: NonNullable<R["commands"]> }
/** Every message answers with its commands, an empty list when it has none. */
function withCommands(result: Update.Return<Model, Message, Factory | Actions>): WithCommands<Update.Return<Model, Message, Factory | Actions>> {
  return { ...result, commands: result.commands ?? [] }
}
/** A click and a browser deep link request the same durable wiki flow; the event alone moves the pane. */
function visitWiki(model: Model, page: string): WithCommands<Update.Return<Model, Message, Factory>> {
  const account = accountOf(model)
  const visit = UpdateDecision.visitedWiki(ScreenRead.wikiVisitScreen(model, account))
  return { model: ModelWrite.wikiVisitWrite(model, account, visit, page), commands: [OpenWikiCommand({ conversation: model.conversation, page, request: visit.request })] }
}

/**
 * Learn more: the page becomes this tab's tour conversation and the agent takes control. A second Learn more while the
 * tour runs does nothing new.
 */
export function walkthroughSession(model: Model) { return model.tutorialSession ?? model.session }
function learnMore(model: Model): Update.Return<Model, Message, Factory | Actions> {
  const conversation = `demo-${walkthroughSession(model)}`
  const step = TourDecision.startedTour(ScreenRead.tourStartScreen(model), conversation)
  if (!step.started) return { model }
  return {
    model: ModelWrite.tourStartWrite(model, step, Machine.newClient),
    commands: [...(model.palette ? [ClosePalette({ dock: false })] : []), StartTourCommand({ conversation: tourConversation(walkthroughSession(model)) }), PresentTour({ step: 1, sound: model.theatre.sound, active: true, paused: false })],
  }
}
function runTourControl(model: Model, control: TourDecision.TourControl): Update.Return<Model, Message, Factory | Actions> {
  // A new control clears the last one's failure; it shows again if this one fails too.
  return control.action === "none" ? { model } : { model: model.tourError === "" ? model : { ...model, tourError: "" }, commands: [ControlTourCommand({ conversation: tourConversation(walkthroughSession(model)), action: control.action, step: control.step })] }
}
function streamScreen(model: Model): TourDecision.StreamScreen { return ScreenRead.streamScreen(model) }
function touringHere(model: Model): boolean {
  const conversation = (model.tourClient ?? model.client).conversation
  return Machine.isTouring(conversation, conversation.replying)
}
/**
 * Gives the screen back. A person's end (`recorded` false) dismisses this tab's tour and asks the sequencer to end it.
 * An end the sequencer already recorded (the tour finished, failed or was ended) sends nothing and dismisses nothing:
 * the page follows its tour conversation from the first event, so an earlier tour's end arrives before a later tour
 * of the same session starts, and ending or dismissing then would stop the later one.
 */
function endTour(model: Model, recorded = false): Update.Return<Model, Message, Factory | Actions> {
  const issues = issueStateOf(model)
  const actions = actionsOf(model)
  const ended = TourDecision.endedTour(ScreenRead.tourEndScreen(model, issues, actions))
  const screen = recorded ? { ...ended, tourDismissed: model.tourDismissed === true } : ended
  const presentation = [ClosePalette({ dock: true }), PresentTour({ step: model.theatre.step, sound: model.theatre.sound, active: false, paused: false }), FocusComposer({})]
  return { model: ModelWrite.tourEndWrite(model, issues, actions, screen), commands: recorded ? presentation : [EndTourCommand({ conversation: tourConversation(walkthroughSession(model)) }), ...presentation] }
}
function receiveTour(model: Model, event: Machine.Event): Update.Return<Model, Message, Factory | Actions> {
  const previous = model.tourClient ?? Machine.newClient
  const tourClient = Machine.receive(previous, event)
  const state = tourClient.conversation.walkthrough
  // Only a running tour's walkthrough presents: an ended tour keeps its last one, and a refused move of it must not show it again.
  const running = state !== undefined && Machine.isTouring(tourClient.conversation, event.id)
  const receipt = TourDecision.tourReceived(tourClient.gap, tourClient.conversation.seq === previous.conversation.seq, model.tourDismissed === true, running, Machine.isTour(tourClient.conversation.entries, event.id), event.type)
  if (receipt.kind === "replay") return { model: { ...model, tourClient: Machine.newClient, epoch: model.epoch + 1 } }
  if (receipt.kind === "ignore") return { model }
  let next: Update.Return<Model, Message, Factory | Actions> = { model: { ...model, tourClient } }
  if (receipt.present && state !== undefined) {
    const presented: WithCommands<Update.Return<Model, Message, Factory | Actions>> = { model: ModelWrite.tourPresentWrite(next.model, state.step, TourDecision.tourTarget(state.target, model.theatre.target), state.paused), commands: [PresentTour({ step: state.step, sound: model.theatre.sound, active: true, paused: TourDecision.presentedPaused(state.paused, event.type) })] }
    next = receipt.drive ? driveWalkthrough(presented, state) : presented
  }
  if (receipt.end) return endTour(next.model, true)
  return next
}

/** Reapplying the numbered destination is shared by replay and recovery of an unavailable end. */
function driveWalkthrough(next: WithCommands<Update.Return<Model, Message, Factory | Actions>>, state: Machine.Walkthrough): Update.Return<Model, Message, Factory | Actions> {
  const model = next.model
  // Replay invokes exactly the messages attached to the person's controls. No parsed narration directives.
  const plan = TourDecision.walkthroughPlan(state.step, model.client.conversation.entries.some(entry => entry.clientId === `${walkthroughSession(model)}-walkthrough`))
  let driven: Model = ModelWrite.walkthroughWrite(next.model, issueStateOf(model), actionsOf(model), plan.surface)
  const commands = plan.keepsCommands ? [...next.commands] : []
  const send = (message: Message) => { const result = update(driven, message); driven = result.model; commands.push(...result.commands) }
  if (plan.ask) {
    driven = update(driven, Message.PressedCommandK()).model
    send(Message.UpdatedDraft({ value: DEMO_QUESTION }))
    // SubmittedDraft keeps the stable tutorial post identity through the normal Post flow.
    send(Message.SubmittedDraft())
  }
  if (plan.clickIssues) send(Message.ClickedIssues())
  if (plan.list) driven = { ...driven, issues: { ...issueStateOf(driven), screen: "list", kind: "All" } }
  if (plan.vips) send(Message.IssueUi({ action: "kind", value: "VIPs" }))
  if (plan.card !== 0) send(Message.OpenIssueCard({ number: plan.card }))
  if (plan.wiki) { send(Message.ClickedWiki({ page: "index" })); driven = { ...driven, docs: "max" } }
  if (plan.slash) { send(Message.UpdatedDraft({ value: "/" })); commands.push(FocusComposer({})) }
  if (plan.sandbox) { send(Message.ClickedSandboxes()); send(Message.MaximizedSandboxes()) }
  if (plan.finish) { driven = { ...driven, tour: false, draft: "" }; commands.push(PresentTour({ step: 10, sound: model.theatre.sound, active: false, paused: false, finish: true }), FocusComposer({})) }
  return { model: driven, commands }
}
function recoverEndTour(model: Model): Update.Return<Model, Message, Factory | Actions> {
  const active = touringHere(model)
  const state = model.tourClient?.conversation.walkthrough
  const next: Update.Return<Model, Message, Factory | Actions> = { model: { ...ModelWrite.screenWrite(model, failedScreenEnd(ScreenRead.screenOf(model), active)), tourDismissed: !active } }
  if (!active || state === undefined || state.step > WALKTHROUGH.length) return next
  const theatre = { ...model.theatre, step: state.step, target: state.target || WALKTHROUGH[state.step - 1]!.target, paused: state.paused }
  return driveWalkthrough({ model: { ...next.model, theatre }, commands: [PresentTour({ step: state.step, sound: theatre.sound, active: true, paused: state.paused })] }, state)
}

function openPalette(model: Model, open: boolean): Update.Return<Model, Message, Factory | Actions> {
  const next = paletteChange(open)
  return { model: ModelWrite.screenWrite(model, setScreenPalette(ScreenRead.screenOf(model), next.palette)), commands: [next.focus === "palette" ? ShowPalette({}) : ClosePalette({ dock: false })] }
}

/** Shrink the maximized splash back into the chat's first pane and focus the composer; otherwise nothing changes. */
function minimizeSplash(model: Model): Update.Return<Model, Message, Factory | Actions> {
  const step = ArmDecision.clickedChat(model, model.client.conversation.entries.length, model.client.pending.length, model.client.conversation.pane)
  return step.focus ? { model: { ...model, ...step.state }, commands: [FocusComposer({})] } : { model }
}

/** Whether there is a conversation to go back to. */
export function hasConversation(model: Model): boolean {
  return hasContent(model.client.conversation.entries.length, model.client.pending.length, model.client.conversation.pane)
}

/** ⌘K's /mock and /live load the page in that mode, the way the nav's switch does (startup.vibe saves it). */
function switchMode(model: Model, to: string): Update.Return<Model, Message, Factory | Actions> {
  if (!UpdateDecision.switchesMode(to)) return { model }
  return { model: ModelWrite.modeSwitchWrite(model, actionsOf(model)), commands: [SwitchMode({ to })] }
}

function submit(model: Model): Update.Return<Model, Message, Factory | Actions> {
  const text = model.draft.trim()
  const selected = completions(model)[actionsOf(model).highlight]
  const kind = UpdateDecision.submitKind({ mode: text === "/mock" || text === "/live", sandbox: text === "/sandbox", slashed: text.startsWith("/"), selected: selected !== undefined, empty: text === "" })
  if (kind === "mode") return switchMode(model, text.slice(1))
  if (kind === "sandbox") {
    const next = sandboxAction(ModelWrite.sandboxSubmitWrite(model), "start")
    return { ...next, commands: [...(next.commands ?? []), ClosePalette({ dock: true })] }
  }
  if (kind === "ignore") return { model }
  if (kind === "slash") return launchAction(model, selected!.name, "slash")
  const demonstration = UpdateDecision.demonstrates(model.tour, model.theatre.step, text === DEMO_QUESTION)
  const clientId = demonstration ? `${walkthroughSession(model)}-walkthrough` : `${model.session}-${model.sent + 1}`
  return {
    // Sending shows the new post and its answer, wherever the reader had scrolled.
    model: ModelWrite.postWrite(model, Machine.post(model.client, clientId, text), UpdateDecision.sentAfter(demonstration, model.sent)),
    commands: [PostMessage({ conversation: model.conversation, clientId, name: model.name, text }), ClosePalette({ dock: true })],
  }
}

/** Dispatch never awaits the job. Follow subscriptions settle the shared run card and trace. */
function launchAction(model: Model, name: string, door: "button" | "slash"): Update.Return<Model, Message, Factory | Actions> {
  const actions = actionsOf(model)
  const launch = UpdateDecision.launchKind(actions.starting, actions.commands.some((entry) => entry.name === name), name === "vibelang/Tour", door === "slash")
  if (launch === "ignore") return { model }
  if (launch === "tour") return learnMore(model)
  const text = door === "slash" ? splitCommand(model.draft).rest : actions.input
  return {
    model: ModelWrite.launchWrite(model, actions),
    commands: [RunAction({ name, text, door, ...(actions.epoch === undefined ? {} : { epoch: actions.epoch }), format: actions.commands.find((entry) => entry.name === name)!.input, ...(UpdateDecision.launchRetries(door === "button", actions.run) ? { retry: actions.run } : {}) })],
  }
}

// COMMAND

/** A native media observation is presentation state, independent of the durable conversation. */
export const ObserveMedia = Command.define("ObserveMedia", {
  args: { kind: Schema.Literals(["image", "video"]), outcome: Schema.Literals(["loaded", "failed"]) },
  messages: [Message.ObservedMedia],
  execute: effect ({ kind, outcome }) => {
    try observeMedia(outcome, kind)
    return try message(() => Message.ObservedMedia())
  },
})

/** A Message from its constructor, in a Command. Constructors validate with Schema, so a bad payload is a defect. */
effect function message<A>(make: () => A) {
  return try orDie(Effect.try(make))
}

/** Stable inputs let the dialog restore its opener in chat as well as on the splash. */
export const PROMPT_ID = "vl-prompt"

export const PALETTE_ID = "vl-palette"
export const PALETTE_PROMPT_ID = "vl-palette-prompt"

export const ShowPalette = Command.define("ShowPalette", {
  args: {},
  messages: [Message.FocusedPrompt],
  execute: effect () => {
    const opened = Dom.showDialog(`#${PALETTE_ID}`, { isModal: true, allowedOutsideSelectors: ["#vl-announcements"], focusSelector: `#${PALETTE_PROMPT_ID}` }) catch () => false
    if (opened) try Dom.lockScroll
    return try message(() => Message.FocusedPrompt())
  },
})

/** Ephemeral actions return keyboard focus to the stable composer when they disappear. */
export const FocusComposer = Command.define("FocusComposer", {
  args: {},
  messages: [Message.FocusedPrompt],
  execute: effect () => {
    // After the render: minimizing the splash creates the composer this focuses.
    try Render.afterCommit
    Dom.focus(`#${PROMPT_ID}`, { preventScroll: true }) catch () => undefined
    return try message(() => Message.FocusedPrompt())
  },
})

/** Close after the render so the docked composer exists, then restore focus before accepting another keystroke. */
export const ClosePalette = Command.define("ClosePalette", {
  args: { dock: Schema.Boolean },
  messages: [Message.FocusedPrompt],
  execute: effect ({ dock }) => {
    try Render.afterCommit
    const closed = Dom.closeDialog(`#${PALETTE_ID}`) catch () => false
    if (closed) try Dom.unlockScroll
    if (dock) Dom.focus(`#${PROMPT_ID}`, { preventScroll: true }) catch () => undefined
    return try message(() => Message.FocusedPrompt())
  },
})

export const PostMessage = Command.define("PostMessage", {
  args: { conversation: Schema.String, clientId: Schema.String, name: Schema.String, text: Schema.String },
  messages: [Message.SucceededPost, Message.FailedPost],
  execute: effect ({ conversation, clientId, name, text }) => {
    const factory = try Factory
    const posted = effect {
      try factory.post(conversation, clientId, name, text)
      return ""
    } catch (error) => error._tag === "Refused" ? error.refusal : error.reason
    return try message(() => posted === "" ? Message.SucceededPost({ clientId }) : Message.FailedPost({ clientId, reason: posted }))
  },
})

/** Learn more: ask the agent for its tour. */
export const StartTourCommand = Command.define("StartTour", {
  args: { conversation: Schema.String },
  messages: [Message.SucceededTour, Message.FailedTour],
  execute: effect ({ conversation }) => {
    const factory = try Factory
    const started = effect {
      try factory.tour(conversation)
      return ""
    } catch (error) => error._tag === "Refused" ? error.refusal : error.reason
    return try message(() => started === "" ? Message.SucceededTour() : Message.FailedTour({ reason: started }))
  },
})

/**
 * Escape: end the tour. The page already took control back, so a refusal (it had ended) changes nothing; an end that
 * never reached the agent gives Esc back.
 */
export const EndTourCommand = Command.define("EndTour", {
  args: { conversation: Schema.String },
  messages: [Message.FocusedPrompt, Message.FailedEndTour],
  execute: effect ({ conversation }) => {
    const factory = try Factory
    const reached = effect {
      try factory.endTour(conversation)
      return true
    } catch (error) => error._tag === "Refused"
    return try message(() => reached ? Message.FocusedPrompt() : Message.FailedEndTour())
  },
})

/**
 * The editor's starting source: the repository-observed overlay, else the build's embedded copy. An editor opens only on
 * a page `wikiEditable` admits, which is proved to be one of the build's pages (`editable`), so the copy exists.
 */
function knownWikiSource(model: Model, page: string): string {
  return WikiEditorDecision.knownSource(model.wikiPages ?? [], page, pages.find((entry) => entry.id === page)!.source)
}

/** Minimal failure text; the request and its flow carry the detail. */
/** Edit by role (0019, 0021): the editor opens on the shown page; a chat draft review opens its page first. */
function beginWikiEdit(model: Model, draft?: string): Update.Return<Model, Message, Factory> {
  const role = accountOf(model).identity.role
  const page = draft ?? wikiPage(model.client.conversation.pane)?.id
  const plan = WikiEditorDecision.wikiBeginPlan(model.wikiEdit?.submission !== undefined, page !== undefined, draft !== undefined, Machine.wikiPermission(role, "save"), Machine.wikiPermission(role, "propose"), Machine.wikiPermission(role, "draft"), page !== undefined && wikiEditable(page))
  if (plan === "reopen") return visitWiki(model, model.wikiEdit!.page)
  if (plan === "none" || page === undefined) return { model }
  const { editing, request } = WikiEditorDecision.openedWikiEditor(page, knownWikiSource(model, page), model.wikiEditRequest)
  if (plan === "open") return { model: ModelWrite.wikiEditorWrite(model, editing, request), commands: [OpenWikiEditor({ page, request })] }
  const visit = visitWiki(model, page)
  return { model: ModelWrite.wikiEditorWrite(visit.model, editing, request), commands: [...visit.commands, OpenWikiEditor({ page, request })] }
}

/** The editor's fresh read: the repository's current source for the page and the person's stored draft. */
export const OpenWikiEditor = Command.define("OpenWikiEditor", {
  args: { page: Schema.String, request: Schema.Number },
  messages: [Message.BeganWikiEdit, Message.FailedWikiEdit],
  execute: effect ({ page, request }) => {
    const factory = try Factory
    const result = try Effect.result(factory.wiki === undefined ? Effect.fail(new WikiFailure({ reason: "unavailable" })) : factory.wiki.read(page))
    return try message(() => {
      if (result._tag === "Failure") return Message.FailedWikiEdit({ request, reason: result.failure.reason })
      const observed = result.success.pages.find((entry) => entry.id === page)
      const draft = result.success.draft !== undefined && result.success.draft.page === page ? result.success.draft.text : ""
      return observed === undefined ? Message.FailedWikiEdit({ request, reason: "missing" }) : Message.BeganWikiEdit({ request, page, source: observed.source, draft, ...(result.success.stale === undefined ? {} : { stale: result.success.stale }) })
    })
  },
})

/** The person's own write: a maintainer's save or a contributor's proposal, through the durable flow. */
export const SubmitWikiEdit = Command.define("SubmitWikiEdit", {
  args: { request: WikiRequest, serial: Schema.Number }, messages: [Message.CompletedWikiEdit, Message.FailedWikiEdit],
  execute: effect ({ request, serial }) => {
    const factory = try Factory
    const result = try Effect.result(factory.wiki === undefined ? Effect.fail(new WikiFailure({ reason: "unavailable" })) : factory.wiki.act(request))
    return try message(() => result._tag === "Success"
      ? Message.CompletedWikiEdit({ request: serial, page: request.page, source: request.base, revision: result.success.pages.find((entry) => entry.id === request.page)?.revision ?? "", review: result.success.review ?? "" })
      : Message.FailedWikiEdit({ request: serial, reason: result.failure.reason, ...(result.failure.unwritten === undefined ? {} : { unwritten: result.failure.unwritten }) }))
  },
})

/** The freshly opened editor takes focus. */
export const FocusWikiEditor = Command.define("FocusWikiEditor", {
  args: {}, messages: [Message.FocusedPrompt],
  execute: effect () => {
    try Render.afterCommit
    Dom.focus("#vl-wiki-editor", { preventScroll: true }) catch () => undefined
    return try message(() => Message.FocusedPrompt())
  },
})

export const LoadActions = Command.define("LoadActions", {
  args: { flow: Schema.String, epoch: Schema.optionalKey(Schema.Number) }, messages: [Message.LoadedActions, Message.FailedActions],
  execute: effect ({ flow, epoch }) => {
    const actions = try Actions
    return (effect {
      const entries = try actions.list()
      const commands = try actions.commands()
      const runs = try actions.runs(flow)
      return try message(() => Message.LoadedActions({ entries, commands, runs, ...(epoch === undefined ? {} : { epoch }) }))
    }) catch effect (error) => try message(() => Message.FailedActions({ code: error.code, ...(epoch === undefined ? {} : { epoch }) }))
  },
})
export const RunAction = Command.define("RunAction", {
  args: { name: Schema.String, text: Schema.String, epoch: Schema.optionalKey(Schema.Number), door: Schema.Literals(["button", "slash"]), retry: Schema.optionalKey(Schema.String), format: Schema.optionalKey(Schema.Literals(["none", "text", "path", "json"])) }, messages: [Message.StartedAction, Message.FailedActions],
  execute: effect ({ name, text, door, retry, format, epoch }) => {
    const actions = try Actions
    return (effect {
      const input = format === "json" ? (text.trim() === "" ? {} : try Effect.mapError(Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Json))(text), () => new ActionFailure({ code: "input" }))) : { text }
      const id = try (retry === undefined ? actions.start(name, input, door) : actions.rerun(retry))
      const run = try actions.read(id)
      return try message(() => Message.StartedAction({ run, ...(epoch === undefined ? {} : { epoch }) }))
    }) catch effect (error) => try message(() => Message.FailedActions({ code: error.code, op: "run", ...(epoch === undefined ? {} : { epoch }) }))
  },
})
export const ReadAction = Command.define("ReadAction", {
  args: { id: Schema.String }, messages: [Message.ChangedAction, Message.FailedActions],
  execute: effect ({ id }) => {
    const actions = try Actions
    return (effect { const run = try actions.read(id); return try message(() => Message.ChangedAction({ run })) }) catch effect (error) => try message(() => Message.FailedActions({ code: error.code }))
  },
})
export const CancelAction = Command.define("CancelAction", {
  args: { id: Schema.String }, messages: [Message.ChangedAction, Message.FailedActions],
  execute: effect ({ id }) => {
    const actions = try Actions
    return (effect {
      try actions.cancel(id)
      const run = try actions.read(id)
      return try message(() => Message.ChangedAction({ run }))
    }) catch effect (error) => try message(() => Message.FailedActions({ code: error.code, op: "cancel" }))
  },
})

export const OpenWikiCommand = Command.define("OpenWiki", {
  args: { conversation: Schema.String, page: Schema.String, request: Schema.Number },
  messages: [Message.SucceededWiki, Message.FailedWiki],
  execute: effect ({ conversation, page, request }) => {
    const factory = try Factory
    const opened = effect { try factory.openWiki(conversation, page); return true } catch () => false
    return try message(() => opened ? Message.SucceededWiki() : Message.FailedWiki({ request }))
  },
})

/** Resizing puts the inline pane back above the composer without changing its address or explicitly resetting content scroll. */
export const RevealWiki = Command.define("RevealWiki", {
  args: {}, messages: [Message.FocusedPrompt],
  execute: effect () => {
    provide ExperimentalBrowserDocument.layer {
      try Render.afterCommit
      const document = try (try Experimental.Document.Document).current
      try orDie(Effect.try(() => {
        const pane = document.getElementById("vl-wiki")
        if (pane?.getAttribute("data-maximized") === "false") pane.scrollIntoView({ block: "end" })
      }))
      return try message(() => Message.FocusedPrompt())
    }
  },
})

/** Keep shareable links and back/forward on the same flow, then reveal the heading or ruling within the pane. */
export const WikiLocation = Command.define("WikiLocation", {
  args: { url: Schema.String }, messages: [Message.FocusedPrompt],
  execute: effect ({ url }) => {
    provide ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer {
      const window = try (try Experimental.Window.Window).current
      const document = try (try Experimental.Document.Document).current
      try orDie(Effect.try(() => {
        if (window.location.pathname + window.location.hash !== url) {
          const [pathname, hash] = url.split("#")
          window.history.pushState(null, "", `${pathname}${window.location.search}${hash ? `#${hash}` : ""}`)
        }
      }))
      try Render.afterCommit
      const hash = url.split("#")[1]
      try orDie(Effect.try(() => {
        const content = document.querySelector<HTMLElement>(".vl-wiki-content")
        if (hash) document.getElementById(hash)?.scrollIntoView({ block: "start" })
        else if (content) content.scrollTop = 0
        const pane = document.getElementById("vl-wiki")
        if (pane?.getAttribute("data-maximized") === "false") pane.scrollIntoView({ block: "end" })
      }))
      return try message(() => Message.FocusedPrompt())
    }
  },
})

// SUBSCRIPTION

/** The key a keydown means to the app, if any: ⌘K or Ctrl+K toggles the prompt, Escape closes it. */
export function keyMessage(key: string, meta: boolean, control: boolean): Option.Option<Message> {
  const action = screenKey(key.toLowerCase(), key === "Escape", meta, control)
  if (action === "palette") return Option.some(Message.PressedCommandK())
  if (action === "escape") return Option.some(Message.PressedEscape())
  return Option.none()
}

/** The app's subscriptions: the keyboard on `keys` (the document, in a browser) and the conversation's events. */
export function subscriptions(keys: EventTarget, page?: Document) {
  const viewport = transcriptViewport(page)
  const scrolled = (value: { bottom: boolean; intent: number } | undefined) =>
    value ? Option.some(Message.ScrolledTranscript(value)) : Option.none()
  return Subscription.make<Model, Message, Factory | Actions>()((entry) => ({
    actionTime: entry({ active: Schema.Boolean }, {
      modelToDependencies: (model: Model) => ({ active: actionsOf(model).runs.some((run) => (run.state === "queued" || run.state === "running") && !(actionsOf(model).disconnected ?? []).includes(run.id)) }),
      dependenciesToStream: ({ active }) => active ? Stream.tick("1 second").pipe(Stream.mapEffect(effect () => { const at = try Clock.currentTimeMillis; return try message(() => Message.TickedActions({ at })) })) : Stream.empty,
    }),
    actionRuns: entry({ ids: Schema.Array(Schema.String), epoch: Schema.Number, generation: Schema.Number }, {
      modelToDependencies: (model: Model) => ({ ids: ActionFollow.watching(actionsOf(model).runs, actionsOf(model).stoppedFollows ?? []), epoch: actionsOf(model).epoch ?? 0, generation: actionsOf(model).followGeneration ?? 0 }),
      dependenciesToStream: ({ ids, epoch, generation }) => ids.length === 0 ? Stream.empty : Stream.unwrap(effect {
        const actions = try Actions
        return Stream.mergeAll(ids.map((id) => actions.follow(id).pipe(
          Stream.map((run) => Message.FollowedAction({ run, epoch, generation, ids })),
          // A clean close before settlement is just as uncertain as a transport failure.
          Stream.concat(Stream.make(Message.FailedActionFollow({ id, epoch, generation, ids }))),
          Stream.catch(() => Stream.make(Message.FailedActionFollow({ id, epoch, generation, ids }))),
          Stream.tap((answer) => answer._tag === "FailedActionFollow" ? Effect.logWarning("Action follow ended", { runId: id, epoch, generation }) : Effect.void),
        )), { concurrency: "unbounded" })
      }),
    }),
    wikiLinks: Subscription.persistentEntry(Dom.streamFromEventFilterMapPreventDefault({
      target: keys, type: "click",
      filterMapEvent: (event: Event) => {
        const mouse = event as MouseEvent
        if (mouse.button !== 0 || mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.altKey) return Option.none()
        const element = event.target as Element | null
        const link = element?.closest?.(".vl-wiki-content a")
        const href = link?.getAttribute("href")
        return href?.startsWith("/wiki/") ? Option.some(Message.ClickedWiki({ page: href })) : Option.none()
      },
    })),
    wikiDraftLinks: Subscription.persistentEntry(Dom.streamFromEventFilterMapPreventDefault({
      target: keys, type: "click",
      filterMapEvent: (event: Event) => {
        const mouse = event as MouseEvent
        if (mouse.button !== 0 || mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.altKey) return Option.none()
        const link = (event.target as Element | null)?.closest?.(".sui-chat-bubble a")
        const href = link?.getAttribute("href")
        const page = href?.startsWith("#wiki-draft-") ? href.slice("#wiki-draft-".length) : undefined
        return page !== undefined && wikiPage(`/wiki/${page}`) !== undefined ? Option.some(Message.ClickedWikiDraft({ page })) : Option.none()
      },
    })),
    wikiHistory: Subscription.persistentEntry(Dom.streamFromEventFilterMap({
      target: page?.defaultView ?? keys, type: "popstate",
      filterMapEvent: () => {
        const location = page?.defaultView?.location
        return location && (location.pathname.startsWith("/wiki/") || location.pathname === "/") ? Option.some(Message.WikiLocationChanged({ page: location.pathname + location.hash })) : Option.none()
      },
    })),
    keyboard: Subscription.persistentEntry(
      Dom.streamFromEventFilterMapPreventDefault({
        target: keys,
        type: "keydown",
        filterMapEvent: (event: Event) => {
          const keyboard = event as KeyboardEvent
          return keyboard.defaultPrevented ? Option.none() : keyMessage(keyboard.key, keyboard.metaKey, keyboard.ctrlKey)
        },
      }),
    ),
    // Pause on upward wheel intent before the compositor starts scrolling: a pending reply render must not race it.
    wheel: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: keys,
        type: "wheel",
        // Let the browser dispatch intent before its default scroll. A passive wheel listener can arrive after
        // the compositor has applied an offset computed before a pending follow write.
        options: { passive: false, capture: true },
        filterMapEvent: (event: Event) => scrolled(viewport.wheel(event as WheelEvent)),
      }),
    ),
    pageKeys: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: keys, type: "keydown", options: { capture: true },
        filterMapEvent: (event: Event) => scrolled(viewport.key(event as KeyboardEvent)),
      }),
    ),
    touchStart: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: keys, type: "touchstart", options: { passive: true },
        filterMapEvent: (event: Event) => { viewport.touchStart(event as TouchEvent); return Option.none() },
      }),
    ),
    touchMove: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: keys, type: "touchmove", options: { passive: false, capture: true },
        filterMapEvent: (event: Event) => scrolled(viewport.touchMove(event as TouchEvent)),
      }),
    ),
    touchEnd: Subscription.persistentEntry(
      Stream.merge(
        Dom.streamFromEventFilterMap({ target: keys, type: "touchend", filterMapEvent: () => { viewport.touchEnd(); return Option.none() } }),
        Dom.streamFromEventFilterMap({ target: keys, type: "touchcancel", filterMapEvent: () => { viewport.touchEnd(); return Option.none() } }),
      ),
    ),
    scroll: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: keys, type: "scroll", filterMapEvent: () => scrolled(viewport.scrolled()),
      }),
    ),
    // Dependency cancellation removes obsolete work; the native intent revision also vetoes already-resumed work.
    follow: entry(
      { active: Schema.Boolean, intent: Schema.Number, seq: Schema.Number, sent: Schema.Number, stream: Schema.String },
      {
        modelToDependencies: (model: Model) => ({
          active: follows(model.surface, model.following, model.palette),
          intent: model.followIntent,
          seq: model.client.conversation.seq,
          sent: model.sent,
          stream: model.stream,
        }),
        dependenciesToStream: ({ active, intent }) => Stream.when(
          Stream.drain(Stream.fromEffect(effect {
            try Render.afterCommit
            try sync(() => viewport.follow(intent))
          })),
          sync(() => active),
        ),
      },
    ),
    // Read every second only while a sandbox runs or its pane is open; otherwise once per finished post or reply, so an
    // idle chat sends no request each second and a sandbox the agent starts is still seen.
    sandbox: entry(
      { conversation: Schema.String, request: Schema.Number, active: Schema.Boolean, live: Schema.Boolean, finished: Schema.Number },
      {
        modelToDependencies: (model: Model) => ({
          conversation: model.conversation,
          request: model.sandboxRequest,
          active: model.surface === "chat" && !model.sandboxBusy,
          live: model.sandbox?.status === "running" || (model.sandboxPane !== undefined && model.sandboxPane !== "closed"),
          finished: model.client.conversation.entries.filter((entry) => entry.done).length,
        }),
        dependenciesToStream: ({ conversation, request, active, live }) => {
          const read = Stream.fromEffect(effect {
            const factory = try Factory
            return effect {
              const snapshot = try factory.sandbox(conversation)
              return try message(() => Message.LoadedSandbox({ conversation, request, snapshot, polled: true }))
            } catch effect (e) => { return try message(() => Message.FailedSandbox({ conversation, request, reason: e._tag === "Refused" ? e.refusal : e.reason, polled: true })) }
          })
          return Stream.when(live ? read.pipe(Stream.repeat(Schedule.spaced("1 second"))) : read, sync(() => active))
        },
      },
    ),
    issueCount: entry(
      { active: Schema.Boolean },
      {
        modelToDependencies: (model: Model) => ({ active: model.mode !== "pending" && model.surface === "chat" && model.issues === undefined }),
        dependenciesToStream: ({ active }) => active ? Stream.fromEffect(effect {
          const api = (try Factory).issues
          const result = try Effect.result(api === undefined ? Effect.fail(new IssueFailure({ reason: "unavailable" })) : api.read())
          return try message(() => result._tag === "Success" ? Message.IssueProjectionLoaded({ data: result.success }) : Message.IssueDialogFocused())
        }) : Stream.empty,
      },
    ),
    roles: entry(
      { person: Schema.String, epoch: Schema.Number, from: Schema.Number },
      {
        modelToDependencies: (model: Model) => ({ person: accountOf(model).identity.id, epoch: accountOf(model).epoch, from: accountOf(model).from }),
        dependenciesToStream: ({ person, from }) => person === "" ? Stream.empty : Stream.unwrap(effect {
          const factory = try Factory
          if (factory.accounts === undefined) return Stream.empty
          return factory.accounts.events(from).pipe(
            Stream.map(event => Message.ReceivedRole({ event })),
            Stream.concat(Stream.fromEffect(message(() => Message.FailedRoles()))),
            Stream.catch(() => Stream.succeed(Message.FailedRoles())),
          )
        }),
      },
    ),
    autoTour: entry({ active: Schema.Boolean }, {
      modelToDependencies: (model: Model) => ({ active: model.autoTour === true }),
      dependenciesToStream: ({ active }) => active ? Stream.fromEffect(effect { try sleep("1200 millis"); return try message(() => Message.AutoTour()) }) : Stream.empty,
    }),
    tourEvents: entry({ active: Schema.Boolean, session: Schema.String, epoch: Schema.Number }, {
      modelToDependencies: (model: Model) => ({ active: model.tourClient !== undefined, session: walkthroughSession(model), epoch: model.epoch }),
      dependenciesToStream: ({ active, session }) => !active ? Stream.empty : Stream.unwrap(effect {
        const factory = try Factory
        // A lost stream follows again 2 seconds later from the start; events the tour already has change nothing.
        const follow = (): Stream.Stream<Machine.Event> => factory.events(tourConversation(session), 0).pipe(Stream.catch(() => Stream.concat(
          Stream.fromEffect(Effect.andThen(Effect.logWarning("tour events lost; following again"), Effect.sleep("2 seconds"))).pipe(Stream.drain),
          Stream.suspend(follow),
        )))
        return follow().pipe(Stream.map(event => Message.ReceivedTourEvent({ event })))
      }),
    }),
    theatreKeys: entry({ active: Schema.Boolean }, {
      modelToDependencies: (model: Model) => ({ active: model.tour }),
      dependenciesToStream: ({ active }) => !active ? Stream.empty : Dom.streamFromEventFilterMapPreventDefault({ target: keys, type: "keydown", options: { capture: true }, filterMapEvent: event => {
        const key = (event as KeyboardEvent).key
        if ((event as KeyboardEvent).metaKey || (event as KeyboardEvent).ctrlKey) return key.toLowerCase() === "k" ? Option.some(Message.FocusedPrompt()) : Option.none()
        return key === "Tab" ? Option.some(Message.MovedTourFocus({ backward: (event as KeyboardEvent).shiftKey })) : key === " " ? Option.some(Message.ClickedPauseTour()) : key === "ArrowLeft" ? Option.some(Message.ClickedBackStop()) : key === "ArrowRight" ? Option.some(Message.ClickedSkipStop()) : Option.none()
      } }),
    }),
    theatreWindow: Subscription.persistentEntry(Stream.merge(
      Dom.streamFromEventFilterMap({ target: page?.defaultView ?? keys, type: "resize", filterMapEvent: () => Option.some(Message.RemeasureTheatre()) }),
      Dom.streamFromEventFilterMap({ target: page?.defaultView ?? keys, type: "orientationchange", filterMapEvent: () => Option.some(Message.RemeasureTheatre()) }),
    )),
    theatreResize: Subscription.persistentEntry(Dom.streamFromEventFilterMap({ target: keys, type: "scroll", options: { capture: true }, filterMapEvent: () => Option.some(Message.RemeasureTheatre()) })),
    events: entry(
      { conversation: Schema.String, epoch: Schema.Number, from: Schema.Number, open: Schema.Boolean },
      {
        modelToDependencies: (model: Model) => ({
          conversation: model.conversation,
          epoch: model.epoch,
          from: model.from,
          open: model.stream === "open",
        }),
        dependenciesToStream: ({ conversation, from, open }) =>
          Stream.when(
            Stream.unwrap(effect {
              const factory = try Factory
              const ended = try message(() => Message.FailedEvents({ reason: "ended" }))
              return factory.events(conversation, from).pipe(
                Stream.map((event) => Message.ReceivedEvent({ event })),
                Stream.concat(Stream.make(ended)),
                Stream.catchTag("Unavailable", (error) => Stream.make(Message.FailedEvents({ reason: error.reason }))),
              )
            }),
            sync(() => open),
          ),
      },
    ),
  }))
}

// VIEW TRANSITION

/**
 * Moving between the splash and the chat morphs the splash into its pane and the prompt into the composer. Nothing
 * else animates: the ⌘K prompt opens at once, and a view transition would swallow clicks while it runs.
 */
export const viewTransition: Runtime.ViewTransitionConfig<Model, Message> = ({ previousModel, model }) => {
  if (!!previousModel.issues?.open !== !!model.issues?.open) return { types: [model.issues?.open ? "to-issues" : "from-issues"] }
  const transition = surfaceTransition(previousModel.surface, model.surface)
  return transition === "none" ? false : { types: [transition] }
}

function sandboxAction(model: Model, kind: "start" | "stop" | "command"): Update.Return<Model, Message, Factory> {
  if (!canSandboxAction(model.sandboxBusy ?? false, kind, model.terminalDraft ?? "")) return { model }
  const step = PaneDecision.startSandboxAction(sandboxScreen(model), kind, model.sandbox?.generation ?? 0)
  return { model: ModelWrite.sandboxWrite(model, step.state), commands: step.commands.map((command) => SandboxAction({ conversation: model.conversation, operationId: `${model.session}/sandbox/${command.request}`, request: command.request, kind: command.kind, generation: command.generation, command: command.command })) }
}

function sandboxScreen(model: Model): PaneDecision.SandboxScreen { return ScreenRead.sandboxScreen(model) }

function sandboxResult(model: Model): PaneDecision.SandboxResult { return ScreenRead.sandboxResult(model) }

function wikiEditScreen(editing: NonNullable<Model["wikiEdit"]>): PaneDecision.WikiEditScreen {
  const { page, base, text, busy, error } = editing
  return { page, base, text, busy, error }
}

/** A waiting submission as plain data for the proved submit step, and back (proved in `screenRead.vibe`). */
function wikiDraft(request: WikiRequest | undefined): WikiEditorDecision.WikiDraft { return ScreenRead.wikiDraft(request) }
function wikiRequest(draft: WikiEditorDecision.WikiDraft): WikiRequest { return ScreenRead.wikiRequest(draft) }

function minuteNotice(notice: PaneDecision.SandboxNotice, id: string, remaining: number, kept: string): string {
  switch (notice) {
    case "out": return `Out of minutes — ${id} stopped`
    case "low": return `${remaining} minutes left`
    case "clear": return ""
    case "keep": return kept
  }
}
export const SandboxAction = Command.define("SandboxAction", {
  args: { conversation: Schema.String, operationId: Schema.String, request: Schema.Number, kind: Schema.Literals(["start", "stop", "command"]), generation: Schema.Number, command: Schema.String },
  messages: [Message.LoadedSandbox, Message.FailedSandbox],
  execute: effect ({ conversation, operationId, request, kind, generation, command }) => {
    const factory = try Factory
    return effect {
      if (kind === "start") { const snapshot = try factory.startSandbox(conversation, operationId); return try message(() => Message.LoadedSandbox({ conversation, request, snapshot })) }
      if (kind === "stop") { const snapshot = try factory.stopSandbox(conversation, operationId, generation); return try message(() => Message.LoadedSandbox({ conversation, request, snapshot })) }
      try factory.sandboxCommand(conversation, operationId, command, generation)
      const snapshot = try factory.sandbox(conversation)
      return try message(() => Message.LoadedSandbox({ conversation, request, snapshot }))
    } catch effect (e) => { return try message(() => Message.FailedSandbox({ conversation, request, reason: e._tag === "Refused" ? e.refusal : e.reason })) }
  },
})

export function roleLabel(role: Machine.Role): string { return role.slice(0, 1).toUpperCase() + role.slice(1) }

export const LoadAccount = Command.define("LoadAccount", { args: {}, messages: [Message.AccountLoaded, Message.AccountFailed], execute: effect () => {
  const factory = try Factory
  const identity = factory.accounts === undefined ? viewer : (factory.accounts.current() catch () => undefined)
  return try message(() => identity === undefined ? Message.AccountFailed() : Message.AccountLoaded({ identity }))
} })
export const ChooseIdentity = Command.define("ChooseIdentity", {
  args: { role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]) },
  messages: [Message.AccountLoaded, Message.AccountFailed], execute: effect ({ role }) => {
    const factory = try Factory
    const identity = factory.accounts === undefined ? viewer : (factory.accounts.choose(role) catch () => undefined)
    return try message(() => identity === undefined ? Message.AccountFailed() : Message.AccountLoaded({ identity }))
  },
})
export const SwitchMode = Command.define("SwitchMode", {
  args: { to: Schema.Literals(["mock", "live"]) }, messages: [Message.FocusedPrompt], execute: effect ({ to }) => {
    try Navigation.load(`?agent=${to}`)
    return try message(() => Message.FocusedPrompt())
  },
})
export const SignInAccount = Command.define("SignInAccount", {
  args: { mock: Schema.Boolean }, messages: [Message.AccountLoaded, Message.AccountFailed, Message.FocusedPrompt], execute: effect ({ mock }) => {
    if (!mock) { try Navigation.load("/api/auth/sign-in"); return try message(() => Message.FocusedPrompt()) }
    const factory = try Factory
    const identity = factory.accounts === undefined ? viewer : (factory.accounts.choose("new") catch () => undefined)
    return try message(() => identity === undefined ? Message.AccountFailed() : Message.AccountLoaded({ identity }))
  },
})
export const SignOutAccount = Command.define("SignOutAccount", { args: {}, messages: [Message.AccountLoaded, Message.AccountFailed], execute: effect () => {
  const factory = try Factory
  if (factory.accounts !== undefined) {
    const failed = factory.accounts.signOut().pipe(Effect.as(false)) catch () => true
    if (failed) return try message(() => Message.AccountFailed())
  }
  return try message(() => Message.AccountLoaded({ identity: viewer }))
} })
export const LoadPeople = Command.define("LoadPeople", { args: {}, messages: [Message.LoadedPeople, Message.AccountFailed], execute: effect () => {
  const factory = try Factory
  const members = factory.accounts === undefined ? [] : (factory.accounts.members() catch () => undefined)
  return try message(() => members === undefined ? Message.AccountFailed() : Message.LoadedPeople({ members: Array.from(members) }))
} })
export const GrantRole = Command.define("GrantRole", {
  args: { id: Schema.String, role: Schema.Literals(["new", "community", "contributor", "maintainer"]) },
  messages: [Message.GrantedRole, Message.AccountFailed], execute: effect ({ id, role }) => {
    const factory = try Factory
    const failed = factory.accounts === undefined ? true : (factory.accounts.grant(id, role).pipe(Effect.as(false)) catch () => true)
    return try message(() => failed ? Message.AccountFailed() : Message.GrantedRole())
  },
})
export const ShowRoleDialog = Command.define("ShowRoleDialog", { args: {}, messages: [Message.FocusedPrompt], execute: effect () => {
  try Render.afterCommit
  Dom.showDialog("#vl-role-dialog", { isModal: true, focusSelector: "#vl-role-cancel" }) catch () => false
  return try message(() => Message.FocusedPrompt())
} })
export const CloseRoleDialog = Command.define("CloseRoleDialog", { args: {}, messages: [Message.FocusedPrompt], execute: effect () => {
  try Render.afterCommit
  Dom.closeDialog("#vl-role-dialog") catch () => false
  return try message(() => Message.FocusedPrompt())
} })

export const FocusAccountMenu = Command.define("FocusAccountMenu", { args: { open: Schema.Boolean }, messages: [Message.FocusedPrompt], execute: effect ({ open }) => {
  try Render.afterCommit
  Dom.focus(open ? "#vl-account-people" : "#vl-account", { preventScroll: true }) catch () => undefined
  return try message(() => Message.FocusedPrompt())
} })


/** The highest issue number an answer lists, or 0 (no issue) when it lists none; `Math.max()` of nothing is -Infinity. */
function newestIssue(items: ReadonlyArray<{ readonly number: number }>): number {
  return items.reduce((newest, item) => Math.max(newest, item.number), 0)
}

export const LoadIssues = Command.define("LoadIssues", {
  args: { resumeRecovery: Schema.optionalKey(Schema.String), resumeOp: Schema.optionalKey(Schema.String), resumeKey: Schema.optionalKey(Schema.String) }, messages: [Message.IssuesLoaded, Message.IssuesFailed],
  execute: effect ({ resumeRecovery, resumeOp, resumeKey }) => {
    const factory = try Factory
    const result = try Effect.result(effect {
      if (factory.issues === undefined) throw new IssueFailure({ reason: "unavailable" })
      return resumeOp === undefined || resumeKey === undefined ? try factory.issues.read() : try factory.issues.act({ op: "read", number: 0, parent: 0, title: "", text: "", assignee: "", example: "", prior: "", key: `resume-${try Clock.currentTimeMillis}`, resumeOp, resumeKey, ...(resumeRecovery === undefined ? {} : { resumeRecovery }) })
    })
    if (factory.mode === "live" && result._tag === "Success" && result.success.saved?.status === "completed") try Navigation.replaceUrl("/?issues=1")
    return try message(() => result._tag === "Success" ? Message.IssuesLoaded({ data: result.success, created: false, role: result.success.role ?? IssueDecision.issueDefaultRole(factory.mode) }) : Message.IssuesFailed({ reason: result.failure.reason }))
  },
})
export const ActOnIssue = Command.define("ActOnIssue", {
  args: { request: IssueRequest }, messages: [Message.IssuesLoaded, Message.IssuesFailed],
  execute: effect ({ request }) => {
    const factory = try Factory
    if (factory.mode === "live" && request.op !== "read" && request.op !== "draft") try Navigation.replaceUrl(`/?issues=1&resume-op=${request.op}&resume-key=${request.key}` + (request.recovery === undefined ? "" : `&resume-recovery=${request.recovery}`))
    const result = try Effect.result(effect {
      if (factory.issues === undefined) throw new IssueFailure({ reason: "unavailable" })
      return try factory.issues.act(request)
    })
    if (factory.mode === "live" && request.op !== "read" && request.op !== "draft" && (result._tag === "Success" || result.failure.unwritten === true)) try Navigation.replaceUrl("/?issues=1")
    return try message(() => result._tag === "Success" ? Message.IssuesLoaded({ data: result.success, created: ["new", "split", "propose"].includes(request.op), op: request.op, key: request.key, role: result.success.role ?? IssueDecision.issueDefaultRole(factory.mode) }) : Message.IssuesFailed({ reason: result.failure.reason, op: request.op, key: request.key, ...(result.failure.unwritten === undefined ? {} : { unwritten: result.failure.unwritten }) }))
  },
})
