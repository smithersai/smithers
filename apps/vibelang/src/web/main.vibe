export const LoadIssueDetails = Command.define("LoadIssueDetails", {
  args: { number: Schema.Number, key: Schema.String }, messages: [Message.IssueDetailsLoaded, Message.IssueDetailsFailed],
  execute: effect ({ number, key }) => {
    const api = (try Factory).issues
    const result = try Effect.result(api === undefined ? Effect.fail(new IssueFailure({ reason: "unavailable" })) : api.act({ op: "read", number, key, parent: 0, title: "", text: "", assignee: "", example: "", prior: "" }))
    return try message(() => result._tag === "Success" ? Message.IssueDetailsLoaded({ number, data: result.success }) : Message.IssueDetailsFailed({ number }))
  },
})

export const RefreshIssueProjection = Command.define("RefreshIssueProjection", {
  args: {}, messages: [Message.IssueProjectionLoaded, Message.IssueDialogFocused],
  execute: effect () => {
    const api = (try Factory).issues
    if (api === undefined) return try message(() => Message.IssueDialogFocused())
    const result = try Effect.result(api.read())
    return try message(() => result._tag === "Success" ? Message.IssueProjectionLoaded({ data: result.success }) : Message.IssueDialogFocused())
  },
})

export const ControlTourCommand = Command.define("ControlTour", {
  args: { conversation: Schema.String, action: Schema.Literals(["pause", "resume", "seek"]), step: Schema.Number }, messages: [Message.FocusedPrompt, Message.FailedTourEvents],
  execute: effect ({ conversation, action, step }) => {
    const factory = try Factory
    // A refusal (a pause before the walkthrough's first step, or after the tour ended) leaves the controls showing the
    // tour as it is; only an unreachable agent or a backend without controls loses the tour's connection.
    const ok = effect { if (factory.controlTour) try factory.controlTour(conversation, action, step); return factory.controlTour !== undefined } catch (error) => error._tag === "Refused"
    return try message(() => ok ? Message.FocusedPrompt() : Message.FailedTourEvents())
  },
})
export const PresentTour = Command.define("PresentTour", {
  args: { step: Schema.Number, sound: Schema.Boolean, active: Schema.Boolean, paused: Schema.Boolean, finish: Schema.optionalKey(Schema.Boolean) }, messages: [Message.FocusedPrompt],
  execute: effect (args) => {
    provide presentation { try (try TourPresentation).present(args) }
    return try message(() => Message.FocusedPrompt())
  },
})
export const MeasureTheatre = Command.define("MeasureTheatre", {
  args: { target: Schema.String }, messages: [Message.MeasuredTheatre],
  execute: effect ({ target }) => {
    try Render.afterCommit
    provide presentation { const box = try (try TourPresentation).measure(target); return try message(() => Message.MeasuredTheatre(box)) }
  },
})

export const FocusTourControl = Command.define("FocusTourControl", {
  args: { backward: Schema.Boolean }, messages: [Message.FocusedPrompt],
  execute: effect ({ backward }) => {
    provide presentation { try (try TourPresentation).focus(backward) }
    return try message(() => Message.FocusedPrompt())
  },
})
