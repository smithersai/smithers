// Browser boundary. The startup program is shared with the runtime and injected-fault browser tests.
import { FetchHttpClient } from "effect/http"
import { Runtime } from "foldkit"
import { main, page } from "./startup.vibe"

const { application, flags } = await runPromise(Effect.provide(main(), Layer.merge(page, FetchHttpClient.layer)) |> Effect.orDie(%))
Runtime.run(application, { flags: succeed(flags) })
