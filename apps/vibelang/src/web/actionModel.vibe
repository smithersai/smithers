import * as ModelDecision from "./modelDecision.vibe"
import { modeCommandTarget, modeCommandTitle, selectedStepIndex } from "./actionViewDecision.vibe"
import { Registered, Run } from "../actions/Actions.vibe"
import { historyRefusal } from "../history/flowMachine.vibe"
import { HistoryAnswer, Note, Start } from "../history/flows.vibe"
export schema ActionView {
  readonly epoch: number
  readonly followGeneration: number
  readonly disconnected: ReadonlyArray<string>
  readonly stoppedFollows: ReadonlyArray<string>
  readonly step?: string
  readonly now?: number
  readonly open: boolean
  readonly maximized: boolean
  readonly selected: string
  readonly run: string
  readonly loading: boolean
  readonly starting: boolean
  readonly error: string
  readonly input: string
  readonly highlight: number
  readonly slash: boolean
  readonly entries: ReadonlyArray<Registered>
  readonly commands: ReadonlyArray<Registered>
  readonly runs: ReadonlyArray<Run>
}
export const initial: ActionView = { epoch: 0, followGeneration: 0, disconnected: [], stoppedFollows: [], open: false, maximized: false, selected: "", run: "", loading: false, starting: false, error: "", input: "", highlight: 0, slash: false, entries: [], commands: [], runs: [] }
/**
 * A refused write's result is its answer as JSON; a person reads the reason. Only the agent's door reaches a blank
 * lane or note (the history page disables Start and Add note while they are blank), so `empty` names the field.
 */
export function resultText(result: string, flow: string): string {
  const answer = Schema.decodeUnknownOption(Schema.fromJsonString(HistoryAnswer))(result)
  if (Option.isNone(answer) || answer.value.refusal === null) return result
  if (answer.value.refusal !== "empty") return historyRefusal(answer.value.refusal)
  return flow === Start._tag ? "Needs a lane." : flow === Note._tag ? "Needs text." : historyRefusal("empty")
}
export function actionsOf(model: { readonly actions?: ActionView }): ActionView { return model.actions ?? initial }
/** The page's own commands: switching between the live agent and the mock (VL-13). Not flows: a page load. */
export function modeCommands(mode: string | undefined): ReadonlyArray<Registered> {
  const to = modeCommandTarget(mode ?? "")
  return to === "" ? [] : [{ name: `mode/${to}`, title: modeCommandTitle(to), detail: modeCommandTitle(to), command: `/${to}`, runnable: true, least: "viewer", input: "none" }]
}

export function completions(model: { readonly actions?: ActionView; readonly draft: string; readonly mode?: string }) {
  const actions = actionsOf(model)
  const query = model.draft.trim().replace(/\s.*$/s, "")
  return ModelDecision.slashMatches(actions.slash, query, [...actions.commands, ...modeCommands(model.mode)])
}

/** A slower list/read response cannot roll back a live card or a terminal receipt. */
export function mergeRuns(current: ReadonlyArray<Run>, incoming: ReadonlyArray<Run>): ReadonlyArray<Run> {
  return ModelDecision.mergeRuns(current, incoming)
}

/** A failed step opens first; a running or parked step follows, then the last completed one. */
export function selectedStep(run: Run, chosen = "") {
  const index = selectedStepIndex(run.steps, chosen)
  return index < 0 ? undefined : run.steps[index]
}
