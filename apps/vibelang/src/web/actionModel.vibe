import * as ModelDecision from "./modelDecision.vibe"
import { Registered, Run } from "../actions/Actions.vibe"
import { historyRefusal } from "../history/flowMachine.vibe"
import { HistoryAnswer } from "../history/flows.vibe"
export schema ActionView {
  readonly epoch?: number
  readonly step?: string
  readonly now?: number
  readonly open: boolean
  readonly maximized: boolean
  readonly selected: string
  readonly run: string
  readonly loading: boolean
  readonly starting: boolean
  readonly error: string
  readonly input: string
  readonly highlight: number
  readonly slash: boolean
  readonly entries: ReadonlyArray<Registered>
  readonly commands: ReadonlyArray<Registered>
  readonly runs: ReadonlyArray<Run>
}
export const initial: ActionView = { open: false, maximized: false, selected: "", run: "", loading: false, starting: false, error: "", input: "", highlight: 0, slash: false, entries: [], commands: [], runs: [] }
/** A refused write's result is its answer as JSON; a person reads the reason. */
export function resultText(result: string): string {
  const answer = Schema.decodeUnknownOption(Schema.fromJsonString(HistoryAnswer))(result)
  return Option.isSome(answer) && answer.value.refusal !== null ? historyRefusal(answer.value.refusal) : result
}
export function actionsOf(model: { readonly actions?: ActionView }): ActionView { return model.actions ?? initial }
/** The page's own commands: switching between the live agent and the mock (VL-13). Not flows: a page load. */
export function modeCommands(mode: string | undefined): ReadonlyArray<Registered> {
  const entry = (to: "mock" | "live"): Registered => ({ name: `mode/${to}`, title: to === "mock" ? "Mock mode" : "Live mode", detail: to === "mock" ? "Mock mode" : "Live mode", command: `/${to}`, runnable: true, least: "viewer", input: "none" })
  return mode === "live" ? [entry("mock")] : mode === "mock" ? [entry("live")] : []
}

export function completions(model: { readonly actions?: ActionView; readonly draft: string; readonly mode?: string }) {
  const actions = actionsOf(model)
  const query = model.draft.trim().replace(/\s.*$/s, "")
  return actions.slash && query.startsWith("/") ? [...actions.commands, ...modeCommands(model.mode)].filter((entry) => entry.command.startsWith(query)) : []
}

/** A slower list/read response cannot roll back a live card or a terminal receipt. */
export function mergeRuns(current: ReadonlyArray<Run>, incoming: ReadonlyArray<Run>): ReadonlyArray<Run> {
  let result = current
  for (const next of incoming) result = ModelDecision.mergeRunAt(result, ModelDecision.runIndex(result, next.id), next)
  return ModelDecision.newestFirst(result)
}

/** A failed step opens first; a running or parked step follows, then the last completed one. */
export function selectedStep(run: Run, chosen = "") {
  return run.steps.find(step => `${step.key}/${step.attempt}` === chosen)
    ?? run.steps.find(step => step.state === "failed")
    ?? run.steps.find(step => step.state === "running" || step.state === "waiting")
    ?? run.steps.at(-1)
}
