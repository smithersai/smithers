import { theatreSelector, speechAction, audioIdentity, theatreOutcome, theatreFocusIndex, measuresMenu, theatreBox, type Edges } from "./theatreDecision.vibe"
// Browser presentation is an injected Effect service. No speech or storage host globals enter the flow or view.
import { ExperimentalBrowserDocument, ExperimentalBrowserWindow } from "vibelang-runtime/experimental/platform-browser"
import { WALKTHROUGH, walkthroughStop } from "../core/walkthroughSteps.vibe"
export interface Box { readonly x: number; readonly y: number; readonly width: number; readonly height: number }
export service TourPresentation {
  present(state: { readonly step: number; readonly sound: boolean; readonly active: boolean; readonly paused: boolean; readonly finish?: boolean }): void!!
  focus(backward: boolean): void!!
  measure(target: string): Box!!
}
export { theatreSelector } from "./theatreDecision.vibe"

/** Edges for an element that is not on the page; `theatreBox` reads them only when told the element exists. */
const NO_EDGES: Edges = { top: 0, left: 0, right: 0, bottom: 0 }

const AudioStep = Schema.Int.check(Schema.isGreaterThanOrEqualTo(0), Schema.isLessThanOrEqualTo(WALKTHROUGH.length))
schema StoredAudio {
  readonly step: AudioStep
  readonly sound: boolean
  readonly active: boolean
  readonly paused: boolean
}
export const presentationFromHost = Layer.effect(TourPresentation, effect {
  const window = try (try Experimental.Window.Window).current
  const document = try (try Experimental.Document.Document).current
  return {
    present: state => withSpan(effect {
      try sync(() => {
        try {
          window.localStorage.setItem("vibelang:tour-sound", state.sound ? "on" : "off")
          window.localStorage.setItem("vibelang:toured", "yes")
          window.sessionStorage.setItem("vibelang:tour-active", state.active ? "yes" : "no")
        } catch { /* Private storage does not prevent control. */ }
        const speech = window.speechSynthesis
        let previous = { step: 0, sound: false, active: false, paused: false }
        try {
          const raw = window.sessionStorage.getItem("vibelang:tour-audio")
          if (raw) {
            const restored: unknown = JSON.parse(raw)
            if (Schema.is(StoredAudio)(restored)) previous = restored
          }
          // A seek cancels the old line; retain a different identity so the new drive speaks rather than resuming it.
          window.sessionStorage.setItem("vibelang:tour-audio", JSON.stringify({ ...state, step: audioIdentity(state.step, state.paused, previous.step, previous.active, previous.sound) }))
        } catch { /* Unavailable storage never prevents sound-off control. */ }
        const action = speechAction(state.step, state.sound, state.active, state.paused, state.finish === true, previous.step, previous.sound, previous.active, previous.paused)
        if (action === "cancel") speech?.cancel()
        else if (action === "pause") speech?.pause()
        else if (action === "resume") speech?.resume()
        else if (action === "speak") {
          speech?.cancel()
          const Constructor = (window as Window & { SpeechSynthesisUtterance: new (text: string) => SpeechSynthesisUtterance }).SpeechSynthesisUtterance
          if (Constructor && speech) speech.speak(new Constructor(walkthroughStop(state.step).voice))
        }
      })
      const outcome = theatreOutcome(state.active, state.paused, state.sound)
      try Metric.update(Metric.withAttributes(Metric.counter("vibelang_theatre_presentations"), { outcome }), 1)
      try Effect.logInfo("vibelang.theatre.present").pipe(Effect.annotateLogs({ step: state.step, outcome }))
    }, "vibelang.theatre.present"),
    focus: backward => sync(() => {
      const controls = Array.from(document.querySelectorAll<HTMLButtonElement>(".vl-theatre-controls button:not(:disabled)"))
      const index = controls.findIndex(control => control === document.activeElement)
      const next = theatreFocusIndex(controls.length, index, backward)
      controls[next]?.focus()
    }),
    measure: target => sync(() => {
      const rect = document.querySelector(theatreSelector(target))?.getBoundingClientRect()
      const menu = measuresMenu(target) ? document.querySelector(".sui-completion-list")?.getBoundingClientRect() : undefined
      return theatreBox(rect ?? NO_EDGES, rect !== undefined, menu ?? NO_EDGES, menu !== undefined, window.innerWidth, window.innerHeight)
    }),
  }
})

/** Native default; tests supply faulty browser services to the same implementation. */
export const presentation = presentationFromHost.pipe(Layer.provide(Layer.merge(ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer)))
