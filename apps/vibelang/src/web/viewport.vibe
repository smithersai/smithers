import { nearBottom, pauseViewport, scrolledViewport, followViewport, keyGesture, wheelPauses, touchPauses, type Viewport } from "./screenDecision.vibe"

/** A scroll event measures the reader's position, independently of later transcript growth. */
export function atBottom(document: Document): boolean {
  const viewport = document.documentElement
  return nearBottom(viewport.scrollHeight, viewport.clientHeight, document.defaultView?.scrollY ?? 0)
}

/** One subscription host owns this permission. Invalidate it on the native input stack, before queued messages,
 * renders or afterCommit continuations can run. A model carrying an older intent can never authorize a scroll.
 * The proved `screenDecision` steps choose every transition; this host only reads and writes the DOM. */
export function transcriptViewport(page?: Document) {
  let viewport: Viewport = { intent: 0, paused: false, previousY: page?.defaultView?.scrollY ?? 0 }
  let touch: { id: number; y: number } | undefined
  const active = () => !page || (
    page.querySelector(".vl-app[data-surface='chat']") !== null &&
    page.querySelector("#vl-palette[data-state='open']") === null
  )
  const position = () => page?.defaultView?.scrollY ?? 0
  // An upward gesture on a page too short to scroll moves nothing, so it is no reason to stop following.
  const scrollable = () => !page || page.documentElement.scrollHeight > page.documentElement.clientHeight
  const pause = () => {
    const step = pauseViewport(viewport, active(), scrollable(), position())
    viewport = step.viewport
    return step.emit ? { bottom: false, intent: viewport.intent } : undefined
  }
  return {
    wheel: (event: WheelEvent) => wheelPauses(event.deltaY, event.ctrlKey) ? pause() : undefined,
    key: (event: KeyboardEvent) => {
      const target = event.target as Element | null
      // Cursor navigation and scrolling inside an editor or a nested scroll surface belong to that control.
      const editor = target?.closest?.("input, textarea, select, [contenteditable]:not([contenteditable='false']), [role='textbox'], [data-scroll-surface]") != null
      const gesture = keyGesture(event.key, event.altKey, event.ctrlKey, event.metaKey, event.defaultPrevented, editor)
      if (gesture === "browser") return undefined
      const position = pause()
      // Own this page scroll once it has paused following. Native keyboard animations can otherwise continue after
      // Latest and pull the reader away again. Editors and inactive surfaces keep their browser default behavior.
      if (position !== undefined && page?.defaultView) {
        event.preventDefault()
        if (gesture === "top") page.defaultView.scrollTo({ top: 0, behavior: "instant" })
        else page.defaultView.scrollBy({ top: gesture === "page" ? -Math.max(40, Math.floor(page.documentElement.clientHeight * 0.875)) : -40, behavior: "instant" })
      }
      return position
    },
    touchStart: (event: TouchEvent) => {
      const first = event.touches[0]
      touch = active() && first ? { id: first.identifier, y: first.clientY } : undefined
    },
    touchMove: (event: TouchEvent) => {
      const current = Array.from(event.touches).find(item => item.identifier === touch?.id)
      if (!touch || !current) return undefined
      const upward = touchPauses(current.clientY, touch.y)
      touch = { id: current.identifier, y: current.clientY }
      return upward ? pause() : undefined
    },
    touchEnd: () => { touch = undefined },
    scrolled: () => {
      const step = scrolledViewport(viewport, active(), page !== undefined, !page || atBottom(page), position())
      viewport = step.viewport
      // Repeated position-only pauses cannot overwrite Latest while its follow is waiting to commit.
      return step.emit ? { bottom: step.bottom, intent: viewport.intent } : undefined
    },
    follow: (authorizedIntent: number) => {
      // Check permission and perform the native write in one synchronous body: no fiber yield between them.
      const newest = page?.querySelector<HTMLElement>("[data-following='true'] #vl-newest")
      const step = followViewport(viewport, authorizedIntent, active(), newest != null)
      viewport = step.viewport
      if (step.scroll) newest?.scrollIntoView({ block: "end" })
    },
  }
}
