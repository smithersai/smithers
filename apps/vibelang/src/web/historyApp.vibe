// The mythical history's page (wiki/decisions/0020-mythical-history.md; design: wiki/designs/mythical/): a Foldkit
// program at /history, the history as a maximized pane whose − returns to the chat (VL-17). It reads only what it shows
// (pages.vibe): the outline first, an epic's commits a page at a time, a commit in full when it is opened, a filter's
// matches. It follows the history's events from the outline's `seq`; each event reads again what is shown. Each button
// runs one of the history's flows through `Mythical`. Where you are is the URL's hash: `#e4` an epic, `#m12` a commit.
import { Command, Dom, Subscription, type Update } from "foldkit"
import { defineMessageUnion } from "foldkit/message"
import { Mythical } from "../history/MythicalHistory.vibe"
import type { Refused, Unavailable } from "../history/MythicalHistory.vibe"
import { resolvedRole, signedRole, toggleEpic, planFields, initialEpic, validPlanField } from "../history/flowMachine.vibe"
import { MAX_QUERY, PAGE } from "../history/pages.vibe"
import { clipQuery } from "../history/pageDecision.vibe"
import { epicIndex, commitShown, failureReason, wroteCleanly, closesDialog, mergedPages, readOffsets, outlineArrival, commitApplies, matchesApply, eventArrival, hashRead, epicOpenReads, filterSearches,
  outlineFrame, failedLoadFrame, failedReadFrame, retryFrame, navigatedFrame, planFrame, escapedFrame, laneFrame, noteFrame, writingFrame,
  wroteFrame, failedWriteFrame, latestFrame, type HistoryFrame } from "./historyDecision.vibe"
import { type Role, atLeast } from "../history/roles.vibe"
import { CommitPage, EpicPage, HistoryEvent, Matches, Outline } from "../history/schemas.vibe"
export { PAGE } from "../history/pages.vibe"

// FLAGS

export schema HistoryFlags {
  readonly mode: "mock" | "live" | "pending"
  readonly role: "viewer" | "new" | "community" | "contributor" | "maintainer"
  readonly hash: string
}

// MODEL

export schema PlanForm {
  readonly how: "append" | "insert" | "amend"
  readonly title: string
  readonly epic: string
  /** The title of a new epic, when `epic` is `NEW_EPIC`. */
  readonly newEpic: string
  readonly target: string
  readonly task: string
}

/** A read can be retried without restarting the page or its event connection. */
export schema HistoryRead {
  readonly kind: "outline" | "epic" | "commit" | "matches"
  readonly id: string
  readonly from: number
}

export schema HistoryReadFailure {
  readonly read: HistoryRead
  readonly reason: string
}

export schema HistoryModel {
  readonly mode: "mock" | "live" | "pending"
  readonly role: "viewer" | "new" | "community" | "contributor" | "maintainer"
  readonly status: "loading" | "ready" | "failed"
  /** The first view: epics with their counts and the work not landed. */
  readonly outline: Outline
  /** Each epic read so far: its commits from the first, as many pages as were read. */
  readonly pages: ReadonlyArray<EpicPage>
  /** The commit `#m<n>` names, once read; `commitId` is the one it was read for. */
  readonly commit: CommitPage
  readonly commitId: string
  /** The commits matching `filter`, once read. */
  readonly matches: Matches
  /** Where the reader is: the list, an epic (`e<n>`) or a commit (`m<n>`). */
  readonly hash: string
  /** Epics shown open on the list. */
  readonly open: ReadonlyArray<string>
  readonly filter: string
  readonly dialog: boolean
  readonly form: PlanForm
  readonly lane: string
  readonly noteSection: "tried" | "evidence" | "superseded"
  readonly noteText: string
  /** Why the last write or read failed, or `""`. */
  readonly error: string
  readonly readFailures: ReadonlyArray<HistoryReadFailure>
  readonly disconnected: boolean
  readonly busy: boolean
  /** Bumped to read the history and follow its events again. */
  readonly epoch: number
  /** The last event seen; above the outline's `seq` while a read of it is under way. */
  readonly latest: number
  /** The `mythical` bookmark's tip the last export from this page published, or `""`. */
  readonly exported: string
}

/** The Epic choice that opens a new epic. */
export const NEW_EPIC = "new"

/** The repository the history tells, for links to its real commits. */
export const REPOSITORY_URL = "https://github.com/smithersai/vibelang"

const emptyForm: PlanForm = { how: "append", title: "", epic: "", newEpic: "", target: "", task: "" }

// MESSAGE

export const HistoryMessage = defineMessageUnion({
  ResolvedMode: { mode: Schema.Literals(["mock", "live"]) },
  ResolvedRole: { role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]) },
  GotOutline: { outline: Outline },
  GotEpic: { page: EpicPage },
  GotCommit: { id: Schema.String, page: CommitPage },
  GotMatches: { matches: Matches },
  FailedLoad: { reason: Schema.String },
  FailedRead: { reason: Schema.String, read: Schema.optionalKey(HistoryRead) },
  RetriedRead: { read: HistoryRead },
  FailedEvents: {},
  ClickedReconnect: {},
  ClickedRetry: {},
  Navigated: { hash: Schema.String },
  ToggledEpic: { id: Schema.String },
  ClickedMore: { id: Schema.String },
  UpdatedFilter: { value: Schema.String },
  OpenedPlan: { how: Schema.Literals(["append", "insert", "amend"]), target: Schema.String },
  ClosedPlan: {},
  UpdatedForm: { field: Schema.Literals(["title", "epic", "newEpic", "target", "task", "how"]), value: Schema.String },
  SubmittedPlan: {},
  UpdatedLane: { value: Schema.String },
  ClickedStart: { id: Schema.String },
  ClickedApprove: { id: Schema.String },
  ClickedFold: {},
  ClickedExport: {},
  Exported: { mythical: Schema.String },
  UpdatedNoteSection: { value: Schema.Literals(["tried", "evidence", "superseded"]) },
  UpdatedNote: { value: Schema.String },
  SubmittedNote: { id: Schema.String },
  Wrote: { hash: Schema.String },
  FailedWrite: { reason: Schema.String },
  ReceivedEvent: { event: HistoryEvent },
  PressedEscape: {},
  /** A command that only acts on the page: nothing changes. */
  Settled: {},
})
export type HistoryMessage = typeof HistoryMessage.Type

/** What the page's commands need: the history, and the window whose hash they move. */
export type Needs = Mythical | Experimental.Window.Window

type Return = Update.Return<HistoryModel, HistoryMessage, Needs>

// INIT

/** An outline before the first read. */
export const noOutline: Outline = { seq: 0, main: "", epics: [], open: [] }

const noCommit: CommitPage = { seq: 0, commit: null, real: [] }

export function init(flags: HistoryFlags): Return {
  return {
    model: {
      mode: flags.mode,
      role: flags.role,
      status: "loading",
      outline: noOutline,
      pages: [],
      commit: noCommit,
      commitId: "",
      matches: { seq: 0, query: "", commits: [] },
      hash: flags.hash,
      open: [],
      filter: "",
      dialog: false,
      form: emptyForm,
      lane: "",
      noteSection: "tried",
      noteText: "",
      error: "",
      readFailures: [],
      disconnected: false,
      busy: false,
      epoch: 1,
      latest: 0,
      exported: "",
    },
  }
}

// QUERIES

/** Whether `role` may take what needs `least`. */
export function allowed(role: Role, least: Role): boolean {
  return atLeast(role, least)
}

const COMMIT_HASH = /^m\d+$/
const EPIC_HASH = /^e\d+$/

/** The epic's commits read so far, `undefined` before its first page. */
export function pageOf(model: HistoryModel, epic: string): EpicPage | undefined {
  const at = epicIndex(model.pages, epic)
  return at < 0 ? undefined : model.pages[at]
}

/** The commit the hash names, once read for it; `undefined` while it is read or when the hash names none. */
export function shownCommit(model: HistoryModel): CommitPage | undefined {
  return commitShown(COMMIT_HASH.test(model.hash), model.commitId, model.hash) ? model.commit : undefined
}

/** `pages` with `page` read in: its commits replace those from its `from`; an older or detached page changes nothing.
 * Proved in historyDecision, including one page per epic. */
export function merged(pages: ReadonlyArray<EpicPage>, page: EpicPage): ReadonlyArray<EpicPage> {
  return mergedPages(pages, page)
}

/** The read the hash needs: its commit, or its epic before that epic's first page. */
function hashReads(model: HistoryModel, hash: string): ReadonlyArray<Command.Command<HistoryMessage, never, Needs>> {
  const read = hashRead(COMMIT_HASH.test(hash), EPIC_HASH.test(hash), pageOf(model, hash) !== undefined)
  return read === "commit" ? [ReadCommit({ id: hash })] : read === "epic" ? [ReadEpic({ id: hash, from: 0 })] : []
}

/** The reads that bring what the page shows up to date: the commit or epic in the hash, every epic read, the filter. */
export function shownReads(model: HistoryModel): ReadonlyArray<Command.Command<HistoryMessage, never, Needs>> {
  const reads: Array<Command.Command<HistoryMessage, never, Needs>> = [...hashReads(model, model.hash)]
  for (const page of model.pages) {
    for (const from of readOffsets(page.commits.length, PAGE)) reads.push(ReadEpic({ id: page.epic, from }))
  }
  if (filterSearches(model.filter)) reads.push(ReadMatches({ query: model.filter }))
  return reads
}

/** Identity includes the epic offset and the search text, so one result never clears another failed read. */
export function sameRead(a: HistoryRead, b: HistoryRead): boolean {
  return a.kind === b.kind && a.id === b.id && a.from === b.from
}

function withoutFailure(model: HistoryModel, read: HistoryRead): ReadonlyArray<HistoryReadFailure> {
  return model.readFailures.filter((failure) => !sameRead(failure.read, read))
}

function readCommand(read: HistoryRead): Command.Command<HistoryMessage, never, Needs> {
  switch (read.kind) {
    case "outline": return ReadOutline({})
    case "epic": return ReadEpic({ id: read.id, from: read.from })
    case "commit": return ReadCommit({ id: read.id })
    case "matches": return ReadMatches({ query: read.id })
  }
}

// UPDATE

/** The scalar fields the proved frames in historyDecision set; each arm spreads its frame back over the model. */
function frameOf(model: HistoryModel): HistoryFrame {
  const { status, hash, error, busy, dialog, lane, noteText, epoch, latest } = model
  return { status, hash, error, busy, dialog, lane, noteText, epoch, latest }
}

function write(model: HistoryModel, command: Command.Command<HistoryMessage, never, Needs>): Return {
  return { model: { ...model, ...writingFrame(frameOf(model)) }, commands: [command] }
}

export function update(model: HistoryModel, message: HistoryMessage): Return {
  return HistoryMessage.match<Return>(message, {
    // Live, the server decides who you are (decision 0019): a viewer until the session answers, then the session's role.
    ResolvedMode: ({ mode }) => ({ model: { ...model, mode, role: resolvedRole(mode, model.role) } }),
    ResolvedRole: ({ role }) => ({ model: { ...model, role: signedRole(model.mode, model.role, role) } }),
    // A newer outline reads again what the page shows; an older one, arriving late, changes nothing.
    GotOutline: ({ outline }) => {
      const arrival = outlineArrival(model.status === "ready", model.outline.seq, outline.seq, model.latest)
      if (!arrival.accept) return { model }
      const next = { ...model, ...outlineFrame(frameOf(model), arrival.latest), outline, readFailures: withoutFailure(model, { kind: "outline", id: "", from: 0 }) }
      // Events that arrived while this read was under way read once more.
      return { model: next, commands: [...shownReads(next), ...(arrival.reread ? [ReadOutline({})] : [])] }
    },
    GotEpic: ({ page }) => ({ model: { ...model, pages: merged(model.pages, page), readFailures: withoutFailure(model, { kind: "epic", id: page.epic, from: page.from }) } }),
    GotCommit: ({ id, page }) => {
      if (!commitApplies(id, model.hash, model.commitId, page.seq, model.commit.seq)) return { model }
      return { model: { ...model, commit: page, commitId: id, readFailures: withoutFailure(model, { kind: "commit", id, from: 0 }) } }
    },
    GotMatches: ({ matches }) => matchesApply(matches.query, clipQuery(model.filter, MAX_QUERY)) ? { model: { ...model, matches, readFailures: withoutFailure(model, { kind: "matches", id: matches.query, from: 0 }) } } : { model },
    FailedLoad: () => ({ model: { ...model, ...failedLoadFrame(frameOf(model)) } }),
    // The next event may read again; a person can also retry precisely the failed read.
    FailedRead: ({ reason, read }) => ({
      model: read === undefined
        ? { ...model, ...failedReadFrame(frameOf(model), reason, model.outline.seq) }
        : { ...model, latest: model.outline.seq, readFailures: [...withoutFailure(model, read), { read, reason }] },
    }),
    RetriedRead: ({ read }) => ({
      model: { ...model, readFailures: withoutFailure(model, read) },
      commands: [readCommand(read)],
    }),
    FailedEvents: () => ({ model: { ...model, disconnected: true } }),
    ClickedReconnect: () => ({ model: { ...model, ...retryFrame(frameOf(model)), disconnected: false } }),
    ClickedRetry: () => ({ model: { ...model, ...retryFrame(frameOf(model)) } }),
    Navigated: ({ hash }) => {
      const next = { ...model, ...navigatedFrame(frameOf(model), hash) }
      const commands = hashReads(model, hash)
      return commands.length === 0 ? { model: next } : { model: next, commands }
    },
    ToggledEpic: ({ id }) => {
      const next = { ...model, open: toggleEpic(model.open, id) }
      return epicOpenReads(model.open.includes(id), pageOf(model, id) !== undefined) ? { model: next, commands: [ReadEpic({ id, from: 0 })] } : { model: next }
    },
    ClickedMore: ({ id }) => ({ model, commands: [ReadEpic({ id, from: pageOf(model, id)?.commits.length ?? 0 })] }),
    UpdatedFilter: ({ value }) => ({ model: { ...model, filter: value }, commands: filterSearches(value) ? [ReadMatches({ query: value })] : [] }),
    OpenedPlan: ({ how, target }) => {
      const epic = initialEpic(how, model.outline.epics[0]?.id)
      return {
        model: { ...model, ...planFrame(frameOf(model), true), form: { ...emptyForm, how, target, epic } },
        commands: [ShowPlan({})],
      }
    },
    ClosedPlan: () => ({ model: { ...model, ...planFrame(frameOf(model), false) }, commands: [ClosePlan({})] }),
    UpdatedForm: ({ field, value }) => {
      if (!validPlanField(field, value)) return { model }
      return { model: { ...model, form: { ...model.form, [field]: value } } }
    },
    SubmittedPlan: () => {
      const { form } = model
      return write(model, PlanCommand({
        ...planFields(form.how, form.epic, form.newEpic),
        target: form.target,
        title: form.title,
        task: form.task,
      }))
    },
    UpdatedLane: ({ value }) => ({ model: { ...model, ...laneFrame(frameOf(model), value) } }),
    ClickedStart: ({ id }) => write(model, StartCommand({ id, lane: model.lane })),
    ClickedApprove: ({ id }) => write(model, ApproveCommand({ id })),
    ClickedFold: () => write(model, FoldCommand({})),
    ClickedExport: () => write(model, ExportCommand({})),
    Exported: ({ mythical }) => ({ model: { ...model, ...wroteFrame(frameOf(model), ""), exported: mythical } }),
    UpdatedNoteSection: ({ value }) => ({ model: { ...model, noteSection: value } }),
    UpdatedNote: ({ value }) => ({ model: { ...model, ...noteFrame(frameOf(model), value) } }),
    SubmittedNote: ({ id }) => write(model, NoteCommand({ id, section: model.noteSection, text: model.noteText })),
    // A plan opens its new commit; every write clears its inputs.
    Wrote: ({ hash }) => ({
      model: { ...model, ...wroteFrame(frameOf(model), hash) },
      commands: [ClosePlan({}), ...(hash === "" ? [] : [SetHash({ hash })])],
    }),
    FailedWrite: ({ reason }) => ({ model: { ...model, ...failedWriteFrame(frameOf(model), reason) } }),
    // The history moved: read the outline again from the server, and with it what the page shows.
    // One read at a time: events during it are read by the next.
    ReceivedEvent: ({ event }) => {
      const arrival = eventArrival(event.seq, model.outline.seq, model.latest)
      if (!arrival.accept) return { model }
      return { model: { ...model, ...latestFrame(frameOf(model), event.seq) }, commands: arrival.read ? [ReadOutline({})] : [] }
    },
    PressedEscape: () => model.dialog ? { model: { ...model, ...escapedFrame(frameOf(model)) }, commands: [ClosePlan({})] } : { model },
    Settled: () => ({ model }),
  })
}

// COMMAND

/** A Message from its constructor, in a Command. Constructors validate with Schema, so a bad payload is a defect. */
effect function message<A>(make: () => A) {
  return try orDie(Effect.try(make))
}

/** Why a write failed, in the words the page shows: the refusal, or that the history can't be reached. */
function reasonOf(error: Refused | Unavailable): string {
  return failureReason(error._tag === "Refused", error._tag === "Refused" ? error.refusal : "")
}

/** A failed read in the page's words. */
function failedRead(read: HistoryRead) {
  return HistoryMessage.FailedRead({ reason: "unavailable", read })
}

export const ReadOutline = Command.define("ReadOutline", {
  args: {},
  messages: [HistoryMessage.GotOutline, HistoryMessage.FailedRead],
  execute: effect () => {
    const outline = (try Mythical).outline() catch () => undefined
    return try message(() => outline === undefined ? failedRead({ kind: "outline", id: "", from: 0 }) : HistoryMessage.GotOutline({ outline }))
  },
})

export const ReadEpic = Command.define("ReadEpic", {
  args: { id: Schema.String, from: Schema.Number },
  messages: [HistoryMessage.GotEpic, HistoryMessage.FailedRead],
  execute: effect ({ id, from }) => {
    const page = (try Mythical).epic(id, from) catch () => undefined
    return try message(() => page === undefined ? failedRead({ kind: "epic", id, from }) : HistoryMessage.GotEpic({ page }))
  },
})

export const ReadCommit = Command.define("ReadCommit", {
  args: { id: Schema.String },
  messages: [HistoryMessage.GotCommit, HistoryMessage.FailedRead],
  execute: effect ({ id }) => {
    const page = (try Mythical).commit(id) catch () => undefined
    return try message(() => page === undefined ? failedRead({ kind: "commit", id, from: 0 }) : HistoryMessage.GotCommit({ id, page }))
  },
})

export const ReadMatches = Command.define("ReadMatches", {
  args: { query: Schema.String },
  messages: [HistoryMessage.GotMatches, HistoryMessage.FailedRead],
  execute: effect ({ query }) => {
    const matches = (try Mythical).search(query) catch () => undefined
    return try message(() => matches === undefined ? failedRead({ kind: "matches", id: clipQuery(query, MAX_QUERY), from: 0 }) : HistoryMessage.GotMatches({ matches }))
  },
})

export const PLAN_ID = "mh-plan"

export const ShowPlan = Command.define("ShowPlan", {
  args: {},
  messages: [HistoryMessage.Settled],
  execute: effect () => {
    Dom.showDialog(`#${PLAN_ID}`, { isModal: true, focusSelector: "#mh-plan-title, #mh-plan-task" }) catch () => false
    return try message(() => HistoryMessage.Settled())
  },
})

export const ClosePlan = Command.define("ClosePlan", {
  args: {},
  messages: [HistoryMessage.Settled],
  execute: effect () => {
    Dom.closeDialog(`#${PLAN_ID}`) catch () => false
    return try message(() => HistoryMessage.Settled())
  },
})

/** Moves the page to `hash`, so the address and Back follow the reader. */
export const SetHash = Command.define("SetHash", {
  args: { hash: Schema.String },
  messages: [HistoryMessage.Settled],
  execute: effect ({ hash }) => {
    const window = try (try Experimental.Window.Window).current
    try sync(() => { window.location.hash = hash })
    return try message(() => HistoryMessage.Settled())
  },
})

export const PlanCommand = Command.define("Plan", {
  args: { how: Schema.Literals(["append", "insert", "amend"]), epic: Schema.String, newEpic: Schema.String, target: Schema.String, title: Schema.String, task: Schema.String },
  messages: [HistoryMessage.Wrote, HistoryMessage.FailedWrite],
  execute: effect (request) => {
    const mythical = try Mythical
    const written = effect {
      return { id: try mythical.plan(request), reason: "" }
    } catch (error) => ({ id: "", reason: reasonOf(error) })
    return try message(() => wroteCleanly(written.reason) ? HistoryMessage.Wrote({ hash: written.id }) : HistoryMessage.FailedWrite({ reason: written.reason }))
  },
})

/** A write that answers nothing: done, or its reason. */
function settledMessage(reason: string) {
  return wroteCleanly(reason) ? HistoryMessage.Wrote({ hash: "" }) : HistoryMessage.FailedWrite({ reason })
}

export const StartCommand = Command.define("Start", {
  args: { id: Schema.String, lane: Schema.String },
  messages: [HistoryMessage.Wrote, HistoryMessage.FailedWrite],
  execute: effect ({ id, lane }) => {
    const mythical = try Mythical
    const reason = effect {
      try mythical.start(id, lane)
      return ""
    } catch (error) => reasonOf(error)
    return try message(() => settledMessage(reason))
  },
})

export const ApproveCommand = Command.define("Approve", {
  args: { id: Schema.String },
  messages: [HistoryMessage.Wrote, HistoryMessage.FailedWrite],
  execute: effect ({ id }) => {
    const mythical = try Mythical
    const reason = effect {
      try mythical.approve(id)
      return ""
    } catch (error) => reasonOf(error)
    return try message(() => settledMessage(reason))
  },
})

export const NoteCommand = Command.define("Note", {
  args: { id: Schema.String, section: Schema.Literals(["tried", "evidence", "superseded"]), text: Schema.String },
  messages: [HistoryMessage.Wrote, HistoryMessage.FailedWrite],
  execute: effect ({ id, section, text }) => {
    const mythical = try Mythical
    const reason = effect {
      try mythical.note(id, section, text)
      return ""
    } catch (error) => reasonOf(error)
    return try message(() => settledMessage(reason))
  },
})

export const FoldCommand = Command.define("Fold", {
  args: {},
  messages: [HistoryMessage.Wrote, HistoryMessage.FailedWrite],
  execute: effect () => {
    const mythical = try Mythical
    const reason = effect {
      try mythical.fold()
      return ""
    } catch (error) => reasonOf(error)
    return try message(() => settledMessage(reason))
  },
})

export const ExportCommand = Command.define("Export", {
  args: {},
  messages: [HistoryMessage.Exported, HistoryMessage.FailedWrite],
  execute: effect () => {
    const mythical = try Mythical
    const published = effect {
      return { mythical: (try mythical.publish()).mythical, reason: "" }
    } catch (error) => ({ mythical: "", reason: reasonOf(error) })
    return try message(() => published.reason === "" ? HistoryMessage.Exported({ mythical: published.mythical }) : HistoryMessage.FailedWrite({ reason: published.reason }))
  },
})

// SUBSCRIPTION

/** The page's subscriptions: Escape and the hash on `window`, and the history: its outline, then its events followed. */
export function subscriptions(window: Window) {
  return Subscription.make<HistoryModel, HistoryMessage, Needs>()((entry) => ({
    keyboard: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: window,
        type: "keydown",
        filterMapEvent: (event: Event) =>
          closesDialog((event as KeyboardEvent).key) ? Option.some(HistoryMessage.PressedEscape()) : Option.none(),
      }),
    ),
    hash: Subscription.persistentEntry(
      Dom.streamFromEventFilterMap({
        target: window,
        type: "hashchange",
        filterMapEvent: () => Option.some(HistoryMessage.Navigated({ hash: window.location.hash.slice(1) })),
      }),
    ),
    history: entry(
      { epoch: Schema.Number },
      {
        modelToDependencies: (model: HistoryModel) => ({ epoch: model.epoch }),
        dependenciesToStream: () =>
          Stream.unwrap(effect {
            const mythical = try Mythical
            const outline = mythical.outline() catch () => undefined
            if (outline === undefined) {
              const failed: Stream.Stream<HistoryMessage> = Stream.make(try message(() => HistoryMessage.FailedLoad({ reason: "unavailable" })))
              return failed
            }
            const loaded = try message(() => HistoryMessage.GotOutline({ outline }))
            const ended = try message(() => HistoryMessage.FailedEvents())
            const disconnected = Stream.fromEffect(Effect.as(Effect.logWarning("history event connection closed"), ended))
            const followed: Stream.Stream<HistoryMessage> = Stream.concat(
              Stream.make(loaded),
              mythical.events(outline.seq).pipe(
                Stream.map((event) => HistoryMessage.ReceivedEvent({ event })),
                Stream.concat(disconnected),
                Stream.catchTag("Unavailable", () => disconnected),
              ),
            )
            return followed
          }),
      },
    ),
  }))
}
