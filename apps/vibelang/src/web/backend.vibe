import { liveHealth } from "../core/protocolDecision.vibe"

// The browser's Factory is available immediately. Only backend operations wait for the one scoped selection.
import { HttpClient } from "effect/http"
import { Factory, type Mode } from "../core/Factory.vibe"
import { health, LiveFactory } from "../core/LiveFactory.vibe"

/** The chosen mode becomes a Foldkit message, independently of any post or event subscription. */
export service AgentBackend {
  readonly ready: Mode!!
}

export function BrowserFactory(origin: string, forceMock: boolean, role: import("../core/sandboxDecision.vibe").Role = "viewer") {
  return Layer.effectContext(effect {
    const scope = try Scope.Scope
    const client = try HttpClient.HttpClient
    let current: Mode | "pending" = "pending"
    const selected = try forkIn(Effect.interruptible(effect {
      const answer = forceMock ? undefined : ((health(origin) |> timeout(%, "3 seconds")) catch () => undefined)
      const mode: Mode = liveHealth(answer?.agent ?? "") ? "live" : "mock"
      // The mock carries the flow engine (0011). Live pages never load that module.
      const layer = mode === "live"
        ? LiveFactory(origin)
        : (try promise(() => import("../core/MockFactory.vibe"))).mockFactoryFor(forceMock ? role : "viewer")
      const context = try Layer.buildWithScope(layer.pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, client))), scope)
      const factory = Context.get(context, Factory)
      current = mode
      return { mode, factory }
    }), scope)
    const ready = Fiber.join(selected)
    const factory: Factory.Shape = {
      get mode() { return current },
      accounts: {
        current: effect () => { return try (try ready).factory.accounts!.current() },
        members: effect () => { return try (try ready).factory.accounts!.members() },
        grant: effect (id, role) => { try (try ready).factory.accounts!.grant(id, role) },
        signOut: effect () => { try (try ready).factory.accounts!.signOut() },
        choose: effect (role) => { return try (try ready).factory.accounts!.choose(role) },
        participated: effect (id) => { try (try ready).factory.accounts!.participated(id) },
        events: (after) => Stream.unwrap(effect { return (try ready).factory.accounts!.events(after) }),
      },
      post: effect (conversation, clientId, name, text) => {
        const { factory } = try ready
        return try factory.post(conversation, clientId, name, text)
      },
      read: effect (conversation, after) => {
        const { factory } = try ready
        return try factory.read(conversation, after)
      },
      events: (conversation, after) => Stream.unwrap(effect {
        const { factory } = try ready
        return factory.events(conversation, after)
      }),
      tour: effect (conversation) => {
        const { factory } = try ready
        return try factory.tour(conversation)
      },
      endTour: effect (conversation) => {
        const { factory } = try ready
        return try factory.endTour(conversation)
      },
      sandbox: effect (conversation) => { const { factory } = try ready; return try factory.sandbox(conversation) },
      startSandbox: effect (conversation, operationId) => { const { factory } = try ready; return try factory.startSandbox(conversation, operationId) },
      stopSandbox: effect (conversation, operationId, generation) => { const { factory } = try ready; return try factory.stopSandbox(conversation, operationId, generation) },
      sandboxCommand: effect (conversation, operationId, command, generation) => { const { factory } = try ready; return try factory.sandboxCommand(conversation, operationId, command, generation) },
    }
    return Context.make(Factory, factory).pipe(Context.add(AgentBackend, { ready: map(ready, (choice) => choice.mode) }))
  })
}
