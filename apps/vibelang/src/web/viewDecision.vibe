//@ safe-slice
// Pure presentation choices shared by the view and the screen update.

//@ verify
//@ ensures (reason == "" || reason == "failed") ==> \result == "Answer failed"
//@ ensures reason != "" && reason != "failed" ==> \result == reason
export function failureOf(reason: string): string {
  return reason === "" || reason === "failed" ? "Answer failed" : reason
}

//@ verify
//@ ensures reason == "empty" ==> \result == "Empty message"
//@ ensures reason == "too-long" ==> \result == "Message too long"
//@ ensures reason == "duplicate" ==> \result == "Already sent"
//@ ensures reason == "busy" ==> \result == "Agent busy"
//@ ensures reason == "not-replying" ==> \result == "Answer unavailable"
//@ ensures reason == "full" ==> \result == "Conversation full"
//@ ensures reason == "connection" ==> \result == "Connection lost"
//@ ensures reason != "empty" && reason != "too-long" && reason != "duplicate" && reason != "busy" && reason != "not-replying" && reason != "full" && reason != "connection" ==> \result == "Send failed"
export function postFailure(reason: string): string {
  if (reason === "empty") return "Empty message"
  if (reason === "too-long") return "Message too long"
  if (reason === "duplicate") return "Already sent"
  if (reason === "busy") return "Agent busy"
  if (reason === "not-replying") return "Answer unavailable"
  if (reason === "full") return "Conversation full"
  if (reason === "connection") return "Connection lost"
  return "Send failed"
}

//@ verify
//@ ensures stream == "failed" ==> \result == "Disconnected"
//@ ensures stream != "failed" && tourError != "" ==> \result == postFailure(tourError)
//@ ensures stream != "failed" && tourError == "" && agent == "working" ==> \result == "Answering"
//@ ensures stream != "failed" && tourError == "" && agent != "working" ==> \result == ""
export function statusLabel(stream: string, tourError: string, agent: string): string {
  if (stream === "failed") return "Disconnected"
  if (tourError !== "") return postFailure(tourError)
  if (agent === "working") return "Answering"
  return ""
}

//@ verify
//@ ensures \result == (key == "Enter" && !shift)
export function sendKey(key: string, shift: boolean): boolean {
  return key === "Enter" && !shift
}

//@ verify
//@ ensures \result == (draft.trim() != "")
export function canSend(draft: string): boolean {
  return draft.trim() !== ""
}

export interface EntryDisplay {
  readonly role: "user" | "assistant"
  readonly markdown: boolean
  readonly showBody: boolean
  readonly thinking: boolean
  readonly failed: boolean
}
//@ verify
//@ ensures (\result.role == "user") == (author == "person")
//@ ensures \result.markdown == (author == "agent")
//@ ensures \result.showBody == (text != "" || !done)
//@ ensures \result.thinking == (text == "" && !done)
//@ ensures \result.failed == (error != "")
export function entryDisplay(author: "person" | "agent", text: string, done: boolean, error: string): EntryDisplay {
  return { role: author === "person" ? "user" : "assistant", markdown: author === "agent", showBody: text !== "" || !done, thinking: text === "" && !done, failed: error !== "" }
}

//@ verify
//@ ensures previous == current ==> \result == "none"
//@ ensures previous != current && current == "chat" ==> \result == "to-chat"
//@ ensures previous != current && current != "chat" ==> \result == "to-splash"
export function surfaceTransition(previous: "splash" | "chat", current: "splash" | "chat"): "none" | "to-chat" | "to-splash" {
  return previous === current ? "none" : current === "chat" ? "to-chat" : "to-splash"
}


export type SandboxPane = "closed" | "pane" | "max"
export type SandboxAction = "start" | "stop" | "command"

//@ verify
//@ ensures pane == "closed" ==> \result == "pane"
//@ ensures pane != "closed" ==> \result == "closed"
export function toggleSandbox(pane: SandboxPane): SandboxPane {
  return pane === "closed" ? "pane" : "closed"
}

//@ verify
//@ ensures pane == "max" ==> \result == "pane"
//@ ensures pane != "max" ==> \result == "max"
export function maximizeSandbox(pane: SandboxPane): SandboxPane {
  return pane === "max" ? "pane" : "max"
}

//@ verify
//@ ensures \result == (conversation == currentConversation && request == currentRequest)
export function currentSandbox(conversation: string, currentConversation: string, request: number, currentRequest: number): boolean {
  return conversation === currentConversation && request === currentRequest
}

//@ verify
//@ ensures \result == ((!busy || kind == "stop") && (kind != "command" || draft.trim() != ""))
export function canSandboxAction(busy: boolean, kind: SandboxAction, draft: string): boolean {
  return (!busy || kind === "stop") && (kind !== "command" || draft.trim() !== "")
}

//@ verify
//@ ensures \result == !exists(i, 0 <= i && i < failed.length && failed[i] == source)
export function showMedia(failed: ReadonlyArray<string>, source: string): boolean {
  return !failed.includes(source)
}

export interface MediaDecision {
  readonly video: boolean
  readonly poster: boolean
  readonly autoplay: boolean
  readonly kind: "video" | "image"
}
//@ verify
//@ ensures \result.video == (hasPoster && (!reduced || controls))
//@ ensures \result.poster == (hasPoster && reduced && !controls)
//@ ensures \result.autoplay == !reduced
//@ ensures (\result.kind == "video") == hasPoster
//@ ensures \result.video ==> !\result.poster
export function mediaDecision(hasPoster: boolean, reduced: boolean, controls: boolean): MediaDecision {
  return { video: hasPoster && (!reduced || controls), poster: hasPoster && reduced && !controls, autoplay: !reduced, kind: hasPoster ? "video" : "image" }
}

/** The minutes badge: none left is destructive, ten or fewer a warning. */
//@ verify
//@ ensures left == 0 ==> \result == "destructive"
//@ ensures left != 0 && left <= 10 ==> \result == "warning"
//@ ensures left > 10 ==> \result == "default"
export function minutesTone(left: number): "destructive" | "warning" | "default" {
  return left === 0 ? "destructive" : left <= 10 ? "warning" : "default"
}

/** What the Sandboxes pane shows for one state. */
export interface SandboxPaneView {
  readonly open: boolean
  readonly starting: boolean
  readonly status: "Starting" | "Running" | "Stopped"
  readonly gate: "ok" | "sign-in" | "contributor"
  readonly stopDisabled: boolean
  readonly startDisabled: boolean
  readonly error: string
  readonly retry: "none" | "start" | "stop"
}
//@ verify
//@ ensures \result.open == (pane != "" && pane != "closed")
//@ ensures \result.starting == (busy && !running)
//@ ensures \result.status == (busy && !running ? "Starting" : running ? "Running" : "Stopped")
//@ ensures \result.gate == (permitted ? "ok" : role == "viewer" ? "sign-in" : "contributor")
//@ ensures \result.stopDisabled == (busy && operation != "command")
//@ ensures \result.startDisabled == (busy || empty)
//@ ensures operation == "stop" ==> \result.error == "Couldn't stop the sandbox"
//@ ensures operation == "command" ==> \result.error == "Command failed"
//@ ensures operation == "start" ==> \result.error == "Couldn't start a sandbox"
//@ ensures operation != "stop" && operation != "command" && operation != "start" ==> \result.error == "Couldn't load the sandbox"
//@ ensures \result.retry == (operation == "stop" ? "stop" : operation == "start" ? "start" : "none")
export function sandboxPaneView(pane: string, running: boolean, busy: boolean, permitted: boolean, role: string, operation: string, empty: boolean): SandboxPaneView {
  const starting = busy && !running
  return {
    open: pane !== "" && pane !== "closed",
    starting,
    status: starting ? "Starting" : running ? "Running" : "Stopped",
    gate: permitted ? "ok" : role === "viewer" ? "sign-in" : "contributor",
    stopDisabled: busy && operation !== "command",
    startDisabled: busy || empty,
    error: operation === "stop" ? "Couldn't stop the sandbox" : operation === "command" ? "Command failed" : operation === "start" ? "Couldn't start a sandbox" : "Couldn't load the sandbox",
    retry: operation === "stop" ? "stop" : operation === "start" ? "start" : "none",
  }
}

/** The chat page's document title. */
//@ verify
//@ ensures \result == (surface == "splash" ? "VibeLang" : "VibeLang · Chat")
export function documentTitle(surface: string): string {
  return surface === "splash" ? "VibeLang" : "VibeLang · Chat"
}

/** What fills the page under the header: open issues win, then the splash, else the chat. */
//@ verify
//@ ensures \result == (issuesOpen ? "issues" : surface == "splash" ? "splash" : "chat")
export function mainSurface(issuesOpen: boolean, surface: string): "issues" | "splash" | "chat" {
  return issuesOpen ? "issues" : surface === "splash" ? "splash" : "chat"
}

/** The wiki holds the pane slot while a wiki page is open, loading or failed. */
//@ verify
//@ ensures \result == (pane.startsWith("/wiki/") || wikiStatus == "loading" || wikiStatus == "error")
export function showsWiki(pane: string, wikiStatus: string): boolean {
  return pane.startsWith("/wiki/") || wikiStatus === "loading" || wikiStatus === "error"
}

/** Where the chat's panes go: a maximized docs or wiki pane and a maximized Actions pane cover the chat; otherwise
 * the wiki or docs pane sits inline (the wiki before the entry it follows, if any), the empty media only in an empty
 * conversation without the wiki, the Actions pane inline unless maximized, and the chat is inert under any cover or
 * a tour. */
export interface ChatLayout {
  readonly paneOver: boolean
  readonly actionsOver: boolean
  readonly inert: boolean
  readonly wikiFirst: boolean
  readonly docsInline: boolean
  readonly empty: boolean
  readonly actionsInline: boolean
}
//@ verify
//@ ensures \result.paneOver == (surface == "chat" && (pane != "" || wiki) && docs == "max")
//@ ensures \result.actionsOver == (surface == "chat" && actionsOpen && actionsMax)
//@ ensures \result.inert == (tour || docs == "max" || actionsMax)
//@ ensures \result.wikiFirst == (wiki && !wikiAfter && docs != "max")
//@ ensures \result.docsInline == (pane != "" && !wiki && docs != "max")
//@ ensures \result.empty == (entries == 0 && pending == 0 && !wiki)
//@ ensures \result.actionsInline == !actionsMax
export function chatLayout(surface: string, pane: string, wiki: boolean, docs: string, actionsOpen: boolean, actionsMax: boolean, tour: boolean, wikiAfter: boolean, entries: number, pending: number): ChatLayout {
  return {
    paneOver: surface === "chat" && (pane !== "" || wiki) && docs === "max",
    actionsOver: surface === "chat" && actionsOpen && actionsMax,
    inert: tour || docs === "max" || actionsMax,
    wikiFirst: wiki && !wikiAfter && docs !== "max",
    docsInline: pane !== "" && !wiki && docs !== "max",
    empty: entries === 0 && pending === 0 && !wiki,
    actionsInline: !actionsMax,
  }
}

/** The wiki follows an entry only when it was opened after that entry. */
//@ verify
//@ ensures \result == (wiki && after == entry && docs != "max")
export function wikiAfterEntry(wiki: boolean, after: string, entry: string, docs: string): boolean {
  return wiki && after === entry && docs !== "max"
}

/** Latest shows when the reader paused following a conversation that has entries. */
//@ verify
//@ ensures \result == (!following && conversation && entries > 0)
export function latestShown(following: boolean, conversation: boolean, entries: number): boolean {
  return !following && conversation && entries > 0
}

/** What the tour's live region says: the step while touring, that it ended after a tour, else nothing. */
//@ verify
//@ ensures \result == (tour ? "step" : toured ? "ended" : "none")
export function tourAnnouncement(tour: boolean, toured: boolean): "step" | "ended" | "none" {
  return tour ? "step" : toured ? "ended" : "none"
}

/** A tour progress mark: steps before the current one are done. */
//@ verify
//@ ensures index + 1 < step ==> \result == "done"
//@ ensures index + 1 == step ==> \result == "current"
//@ ensures index + 1 > step ==> \result == ""
export function progressClass(index: number, step: number): string {
  return index + 1 < step ? "done" : index + 1 === step ? "current" : ""
}

/** The docs pane's address without its `https://`. */
//@ verify
//@ ensures page.startsWith("https://") ==> \result == page.slice(8)
//@ ensures !page.startsWith("https://") ==> \result == page
export function docsAddress(page: string): string {
  return page.startsWith("https://") ? page.slice(8) : page
}

/** Text that is a positive decimal integer with no leading zero. */
//@ verify
//@ ensures \result == (text.length > 0 && 49 <= text.charCodeAt(0) && text.charCodeAt(0) <= 57 && forall(i, 1 <= i && i < text.length ==> 48 <= text.charCodeAt(i) && text.charCodeAt(i) <= 57))
export function positiveDecimal(text: string): boolean {
  if (text.length === 0) return false
  if (text.charCodeAt(0) < 49 || text.charCodeAt(0) > 57) return false
  let i = 1
  while (i < text.length) {
    //@ invariant 1 <= i && i <= text.length
    //@ invariant forall(j, 1 <= j && j < i ==> 48 <= text.charCodeAt(j) && text.charCodeAt(j) <= 57)
    //@ decreases text.length - i
    if (text.charCodeAt(i) < 48 || text.charCodeAt(i) > 57) return false
    i++
  }
  return true
}

/** Names on the wire stay neutral; this tab's own posts carry its session and a serial. */
//@ verify
//@ ensures \result == (clientId.startsWith(session + "-") && clientId.length > session.length + 1 && 49 <= clientId.charCodeAt(session.length + 1) && clientId.charCodeAt(session.length + 1) <= 57 && forall(i, session.length + 2 <= i && i < clientId.length ==> 48 <= clientId.charCodeAt(i) && clientId.charCodeAt(i) <= 57))
export function ownPost(clientId: string, session: string): boolean {
  if (!clientId.startsWith(session + "-")) return false
  const serial = positiveDecimal(clientId.slice(session.length + 1))
  return serial
}

/** The prompt's keys: arrows move through an open slash menu; the send key sends. */
//@ verify
//@ ensures key == "ArrowDown" && menu ==> \result == "down"
//@ ensures !(key == "ArrowDown" && menu) && key == "ArrowUp" && menu ==> \result == "up"
//@ ensures !((key == "ArrowDown" || key == "ArrowUp") && menu) && sendKey(key, shift) ==> \result == "send"
//@ ensures !((key == "ArrowDown" || key == "ArrowUp") && menu) && !sendKey(key, shift) ==> \result == "none"
export function promptKey(key: string, shift: boolean, menu: boolean): "down" | "up" | "send" | "none" {
  if (key === "ArrowDown" && menu) return "down"
  if (key === "ArrowUp" && menu) return "up"
  return sendKey(key, shift) ? "send" : "none"
}
