// The supplied Sandboxes design in wiki/designs/sandboxes, rendered with Foldkit and the shared Smithers CSS.
import type { Html, HtmlBuilder } from "foldkit/html"
import { ALLOWANCES, mayStart } from "../core/sandboxDecision.vibe"
import { Message, type Message as AppMessage, type Model } from "./main.vibe"
type H = HtmlBuilder<AppMessage>

function icon(h: H, max = false): Html {
  return h.svg([h.Class("vl-icon"), h.ViewBox("0 0 24 24"), h.AriaHidden(true)], [h.path([h.D(max ? "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" : "M4 5l6 6-6 6M12 19h8")], [])])
}
function minutes(model: Model, h: H, suffix = ""): Html {
  const left = model.sandbox?.remaining ?? 0
  return h.span([h.Class(`sui-badge sui-badge-${left === 0 ? "destructive" : left <= 10 ? "warning" : "default"}`)], [h.span([h.Class("sui-status-dot")], []), `${left} min${suffix}`])
}
export function sandboxPane(model: Model, h: H): Html {
  const snapshot = model.sandbox
  const open = model.sandboxPane !== undefined && model.sandboxPane !== "closed"
  if (!open) return h.button([h.Class("vl-pane"), h.Type("button"), h.AriaLabel("Sandboxes"), h.OnClick(Message.ClickedSandboxes())], [icon(h), h.span([h.Class("vl-pane-text")], ["Sandboxes"]), ...(snapshot ? [minutes(model, h)] : []), icon(h, true)])
  const running = snapshot?.status === "running"
  const starting = model.sandboxBusy && !running
  const permitted = mayStart(snapshot?.role ?? "viewer")
  const failed = model.sandboxOperation
  const errorText = failed === "stop" ? "Couldn't stop the sandbox" : failed === "command" ? "Command failed" : failed === "start" ? "Couldn't start a sandbox" : "Couldn't load the sandbox"
  const max = model.sandboxPane === "max"
  const status = starting ? "Starting" : running ? "Running" : "Stopped"
  const button = (label: string, message: AppMessage, extra = "", disabled = false) => h.button([h.Type("button"), h.Class(`sui-button sui-button-sm ${extra}`), h.Disabled(disabled), h.OnClick(message)], [label])
  return h.section([h.Class("vl-docs vl-sandboxes"), h.AriaLabel("Sandboxes"), h.DataAttribute("maximized", String(max))], [
    h.div([h.Class("vl-docs-bar")], [
      h.span([h.Class("vl-docs-page")], [icon(h), running ? snapshot!.id : "Sandboxes"]),
      h.div([h.Class("vl-sb-controls")], [
        minutes(model, h, running ? " left" : ""),
        ...(running ? [button("Stop", Message.StoppedSandbox(), "sui-button-destructive", !!model.sandboxBusy && model.sandboxOperation !== "command")] : []),
        h.button([h.Type("button"), h.Class("vl-docs-toggle"), h.AriaLabel(max ? "Minimize Sandboxes" : "Maximize Sandboxes"), h.OnClick(Message.MaximizedSandboxes())], [icon(h, true)]),
      ]),
    ]),
    ...(!permitted ? [h.div([h.Class("sui-empty")], [h.div([h.Class("sui-empty-title")], [snapshot?.role === "viewer" ? "Sign in to start a sandbox" : "Contributor required"]), ...(snapshot?.role === "viewer" ? [h.a([h.Class("sui-button sui-empty-action"), h.Href("/api/auth/sign-in")], ["Sign in"])] : [])])] : [
      ...(!running ? [h.div([h.Class("vl-sb-body")], [
        h.div([h.Class("vl-sb-head")], [
          h.div([h.Class("sui-kpi vl-sb-kpi")], [h.span([h.Class("sui-kpi-value")], [String(snapshot?.remaining ?? 0)]), h.span([h.Class("sui-kpi-label")], [`min left of ${snapshot?.allowance ?? 0}`]),
            h.div([h.Class("sui-progress"), h.Role("progressbar"), h.AriaLabel("Minutes left"), h.AriaValuemin(0), h.AriaValuemax(snapshot?.allowance ?? 0), h.AriaValuenow(snapshot?.remaining ?? 0)], [h.div([h.Class("sui-progress-indicator"), h.Style({ width: `${snapshot?.allowance ? (snapshot.remaining / snapshot.allowance) * 100 : 0}%` })], [])]),
            h.span([h.Class("sui-kpi-hint")], ["Resets monthly"])]),
          ...(snapshot?.id ? [] : [button("New sandbox", Message.StartedSandbox(), "sui-button-default vl-sb-new", !!model.sandboxBusy || snapshot?.remaining === 0)]),
        ]),
        ...(snapshot?.id ? [h.div([h.Class("sui-row-button vl-sb")], [h.span([h.Class("vl-dot")], []), h.span([h.Class("vl-sb-name")], [snapshot.id]), button("Start", Message.StartedSandbox(), "sui-button-ghost", !!model.sandboxBusy || snapshot.remaining === 0)])] : []),
      ])] : []),
      h.span([h.Class("vl-sr-only"), h.Role("status"), h.AriaLabel("Sandbox")], [status]),
      ...(starting ? [h.div([h.Class("vl-sb-starting")], ["Starting", h.div([h.Class("sui-progress")], [h.div([h.Class("vl-ind")], [])])])] : []),
      ...(snapshot?.id ? [h.div([h.Class(`vl-term${running ? "" : " vl-term-off"}`)], [
        h.pre([h.Class("vl-term-body"), h.Tabindex(0), h.AriaLabel("Terminal output")], [snapshot.output]),
        h.form([h.Class("vl-term-prompt"), h.OnSubmit(Message.SubmittedTerminal())], [h.span([h.Class("vl-term-p"), h.AriaHidden(true)], ["$"]), h.input([h.Class("vl-term-input"), h.Type("text"), h.AriaLabel("Terminal command"), h.Value(model.terminalDraft ?? ""), h.Disabled(!running || !!model.sandboxBusy), h.OnInput((value) => Message.UpdatedTerminal({ value }))])]),
      ])] : []),
    ]),
    ...(model.sandboxError ? [h.div([h.Class("sui-alert sui-alert-destructive"), h.Role("alert")], [errorText, ...(failed === "start" || failed === "stop" ? [button("Retry", failed === "stop" ? Message.StoppedSandbox() : Message.StartedSandbox())] : [])])] : []),
    ...(model.minuteNotice ? [h.div([h.Class("sui-chat-message"), h.DataAttribute("role", "system"), h.Role("status"), h.AriaLabel("Sandbox minutes")], [h.div([h.Class("sui-chat-bubble")], [model.minuteNotice])])] : []),
    ...(max ? [h.div([h.Class("sui-table-container"), h.DataAttribute("variant", "card")], [h.table([h.Class("sui-table"), h.AriaLabel("Minutes by role")], [
      h.thead([], [h.tr([], [h.th([], ["Role"]), h.th([], ["Minutes"])])]),
      h.tbody([], Object.entries(ALLOWANCES).map(([role, allowance]) => h.tr([], [h.td([], [role[0]!.toUpperCase() + role.slice(1)]), h.td([], [allowance ? allowance.toLocaleString("en-US") : "—"])]))),
      h.caption([], ["Minutes reset monthly"]),
    ])])] : []),
  ])
}
