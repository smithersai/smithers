// Foldkit rendering of wiki/designs/issues. Smithers owns the component CSS; ix-* is the designer's extension.
import type { Html, HtmlBuilder } from "foldkit/html"
import { issuePermission, may, type IssueRecord, type IssueOperation, type Role } from "../core/conversation.vibe"
import type { Message } from "./main.vibe"
import type { IssuesUi } from "./issues.vibe"
import { blocks, inline as codeParts } from "./markdown.vibe"

type H = HtmlBuilder<Message>
type Send = (action: string, value?: string) => Message
function button(h: H, send: Send, text: string, action: string, primary = false): Html {
  return h.button([h.Class(`sui-button sui-button-sm${primary ? " sui-button-solid" : ""}`), h.Type("button"), h.OnClick(send(action))], [text])
}
function icon(h: H, i: IssueRecord): Html {
  const done = i.task === "Done" || i.state === "closed" || i.vip === "Accepted"
  const kind = i.task === "Running" ? "running" : i.task === "Queued" ? "queued" : i.task === "Done" || i.vip === "Accepted" ? "merged" : i.vip === "In review" ? "in_review" : i.state === "open" ? "open" : ""
  return h.svg([h.Class("sui-state-icon"), h.Width("16"), h.Height("16"), h.DataAttribute("kind", kind), ...(kind === "running" ? [h.DataAttribute("live", "")] : []), h.ViewBox("0 0 16 16"), h.AriaHidden(true)], [
    h.circle([h.Cx("8"), h.Cy("8"), h.R("6.75"), h.Fill("none"), h.Stroke("currentColor"), h.StrokeWidth("1.5"), ...(kind === "queued" ? [h.StrokeDasharray("2.6 2.4")] : [])], []),
    ...(done ? [h.path([h.D("M5.3 8.3l1.8 1.8 3.6-3.8"), h.Fill("none"), h.Stroke("currentColor"), h.StrokeWidth("1.5"), h.StrokeLinecap("round"), h.StrokeLinejoin("round")], [])] : kind === "running" ? [h.path([h.D("M8 1.25A6.75 6.75 0 0 1 8 14.75Z"), h.Fill("currentColor")], [])] : kind === "queued" ? [] : [h.circle([h.Cx("8"), h.Cy("8"), h.R("2.5"), h.Fill("currentColor")], [])]),
  ])
}
function commentIcon(h: H): Html {
  return h.svg([h.ViewBox("0 0 16 16"), h.Width("14"), h.Height("14"), h.AriaHidden(true), h.Style({ width: "14px", height: "14px", fill: "none", stroke: "currentColor", strokeWidth: "1.4", strokeLinecap: "round", strokeLinejoin: "round" })], [h.path([h.D("M2.5 2.5h11a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7.2L4 14.7a.3.3 0 0 1-.5-.2V12H2.5a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z")], [])])
}

function badges(h: H, i: IssueRecord, labels = true): ReadonlyArray<Html> {
  return [
    ...(i.task === "" ? [] : [h.span([h.Class("sui-badge sui-badge-default")], [`Task · ${i.task}`])]),
    ...(i.vip === "" ? [] : [h.span([h.Class(`sui-badge sui-badge-${i.vip === "In review" ? "warning" : i.vip === "Accepted" ? "success" : "destructive"}`)], [`VIP · ${i.vip}`])]),
    ...(labels ? i.labels : []).filter((l) => !l.startsWith("vibelang:")).map((l) => h.span([h.Class("sui-badge sui-badge-secondary")], [l])),
  ]
}

function when(absolute: boolean, age: string, long = false): string {
  if (age === "" || absolute || age === "just now") return age
  const parts = long ? /^([0-9]+)(d|w)$/.exec(age) : null
  const readable = parts === null ? age : `${parts[1]} ${parts[2] === "d" ? "day" : "week"}${parts[1] === "1" ? "" : "s"}`
  return `${readable} ago`
}
function references(ui: IssuesUi, h: H, send: Send, text: string) {
  return text.split(/(#[1-9][0-9]*)/).map(part => {
    const item = /^#[1-9][0-9]*$/.test(part) ? ui.data.items.find(item => item.number === Number(part.slice(1))) : undefined
    return item === undefined ? part : h.a([h.Class("sui-item-conv-meta-link"), h.Href(`#issue-${item.number}`), h.OnClick(send("select", String(item.number)), { defaultAction: "Prevent" })], [part])
  })
}
function issueBody(ui: IssuesUi, h: H, send: Send, text: string): ReadonlyArray<Html> {
  return blocks(text).map(block => block.kind === "code"
    ? h.pre([h.Class("vl-code")], [h.code([], [block.text])])
    : h.p([h.Style({ margin: "0", whiteSpace: "pre-line" })], codeParts(block.text).flatMap(part => part.code ? [h.code([], [part.text])] : references(ui, h, send, part.text))))
}
function eventText(ui: IssuesUi, h: H, send: Send, text: string) {
  const label = /^(added|removed) the (.+) label$/.exec(text)
  return label === null ? references(ui, h, send, text) : [`${label[1]} the `, h.span([h.Class("sui-badge sui-badge-secondary")], [label[2]!]), " label"]
}
function avatar(h: H, name: string): Html {
  return h.span([h.Class("ix-avatar"), h.DataAttribute("agent", String(name === "VibeLang agent")), h.Title(name)], [name.slice(0, 1).toUpperCase()])
}
export function issueChatCard(h: H, issue: IssueRecord, items: ReadonlyArray<IssueRecord>, label: string, absolute: boolean, open: (number: number) => Message): Html {
  const children = items.filter(child => child.parent === issue.number)
  return h.div([h.Class("sui-card ix-chat-card")], [
    h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], [issue.title]), h.span([h.Class("sui-card-action")], [h.span([h.Class(`sui-badge sui-badge-${children.length === 0 && issue.state === "open" ? "success" : "secondary"}`)], [children.length === 0 ? issue.state === "open" ? "Open" : "Closed" : `#${issue.number} · ${children.length} ${children.length === 1 ? "child" : "children"}`])])]),
    h.div([h.Class("sui-card-content")], children.length === 0 ? [h.div([h.Class("sui-card-description")], [`#${issue.number} · opened ${when(absolute, issue.age)}${issue.labels.length === 0 ? "" : ` · ${issue.labels.join(", ")}`}`])] : children.map(child => h.div([h.Class("ix-mini")], [icon(h, child), h.a([h.Href(`#issue-${child.number}`), h.OnClick(open(child.number), { defaultAction: "Prevent" })], [`#${child.number} ${child.title}`]), h.span([h.Class("ix-tree-meta")], badges(h, child, false))]))),
    h.div([h.Class("sui-card-footer")], [h.button([h.Type("button"), h.Class("sui-button sui-button-sm"), h.OnClick(open(issue.number))], [label])]),
  ])
}

function issueLink(h: H, send: Send, i: IssueRecord, full = true): Html {
  return h.a([h.Id(`ix-issue-${i.number}`), h.Href(`#issue-${i.number}`), h.Class(full ? "sui-button-link" : "sui-issues-link sui-issues-title"), h.OnClick(send("select", String(i.number)), { defaultAction: "Prevent" })], [full ? `#${i.number} ${i.title}` : i.title])
}
function header(h: H, send: Send, name: string, back = "‹ Chat", actions: ReadonlyArray<Html> = []): Html {
  return h.header([h.Class("sui-page-header")], [h.div([h.Class("sui-page-header-inner")], [
    h.div([h.Class("sui-page-header-back")], [h.a([h.Href("#issues"), h.OnClick(send(back === "‹ Chat" ? "close" : "list"), { defaultAction: "Prevent" })], [back])]),
    h.h1([h.Class("sui-page-header-title")], [name]),
    h.div([h.Class("sui-page-header-actions")], actions),
  ])])
}
function titleOf(ui: IssuesUi): string { return ui.kind === "All" || ui.kind === "Issues" ? "Issues" : ui.kind }
export function issuesView(ui: IssuesUi, h: H, send: Send): Html {
  return h.section([h.Class("ix-surface"), h.AriaLabel("Issues pane"), h.Style({ viewTransitionName: "issues" })], [
    ...(ui.screen === "roles" ? rolesView(h, send) : ui.screen === "detail" ? detail(ui, h, send) : ui.screen === "vip" || ui.screen === "new" ? form(ui, h, send) : list(ui, h, send)),
    dialog(ui, h, send),
  ])
}
function connected(ui: IssuesUi): boolean { return ui.data.connected !== false }
function connect(h: H, ui: IssuesUi): Html { return h.a([h.Class("sui-button sui-button-sm"), h.Href(ui.connection ?? "/api/auth/github")], ["Connect GitHub"]) }
function rolesView(h: H, send: Send): ReadonlyArray<Html> {
  const roles: ReadonlyArray<Role> = ["viewer", "new", "community", "contributor", "maintainer"]
  const rows: ReadonlyArray<{ readonly label: string; readonly op: IssueOperation | "roles" }> = [
    { label: "Read issues, tasks, VIPs", op: "read" }, { label: "Comment", op: "comment" },
    { label: "File an issue", op: "new" }, { label: "Propose a VIP", op: "propose" },
    { label: "Link issues", op: "link" }, { label: "Split an issue", op: "split" },
    { label: "Commit a task", op: "commit" }, { label: "Review a VIP", op: "accept" },
    { label: "Promote a role", op: "roles" },
  ]
  return [header(h, send, "Roles"), h.div([h.Class("sui-page-body"), h.DataAttribute("width", "narrow")], [
    h.div([h.Class("sui-table-container"), h.DataAttribute("variant", "card")], [h.table([h.Class("sui-table ix-roles")], [
      h.thead([], [h.tr([], [h.th([], ["Action"]), ...roles.map(role => h.th([], [role.slice(0, 1).toUpperCase() + role.slice(1)]))])]),
      h.tbody([], rows.map(row => h.tr([], [h.td([], [row.label]), ...roles.map(role => {
        const allowed = row.op === "roles" ? may(role, "roles") : issuePermission(role, row.op)
        return h.td([h.Class(allowed ? "ix-yes" : "ix-no")], [allowed ? "✓" : "—"])
      })]))),
      h.caption([], ["People review VIPs and grant roles; the agent uses the same flows."]),
    ])]),
  ])]
}
function list(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const filtered = ui.data.items.filter((i) => ui.kind === "Tasks" ? i.task !== "" : ui.kind === "VIPs" ? i.vip !== "" : ui.kind === "Issues" ? i.task === "" && i.vip === "" : true)
  const rows = filtered.filter((i) => i.state === ui.state && `${i.title} #${i.number} ${i.labels.join(" ")}`.toLowerCase().includes(ui.query.toLowerCase()))
  const propose = ui.kind === "VIPs"
  const action = propose ? "Propose a VIP" : "New issue"
  const connection = ui.role !== "viewer" && !connected(ui) ? [connect(h, ui)] : []
  const controls = connected(ui) && issuePermission(ui.role, propose ? "propose" : "new") ? [h.button([h.Class("sui-button sui-button-sm sui-button-default"), h.Type("button"), h.OnClick(send(propose ? "vip-form" : "new-form"))], [action])] : []
  return [header(h, send, titleOf(ui), "‹ Chat", [button(h, send, "Roles", "roles"), ...connection, ...controls]), ...(ui.error === "" || ui.status === "error" ? [] : [h.div([h.Role("alert"), h.Class("sui-issue-form-error")], [ui.error, ...(ui.retry === undefined ? ui.error === "Couldn't load comments. Retry." ? [button(h, send, "Retry", "read")] : [] : !issuePermission(ui.role, ui.retry.op) ? [] : [button(h, send, "Retry", "retry", true)])])]), h.div([h.Class("sui-page-body")], [h.div([h.Class("sui-issues-view")], [
    h.div([h.Class("sui-issues-header")], [
      h.div([h.Class("sui-issues-filters")], (["open", "closed"] as const).map((state) => h.a([h.Class("sui-issues-filter"), h.Href(`#${state}`), ...(state === ui.state ? [h.AriaCurrent("page")] : []), h.OnClick(send("state", state), { defaultAction: "Prevent" })], [state === "open" ? "◉ Open " : "✓ Closed ", h.span([h.Class("sui-issues-filter-count")], [String(filtered.filter((i) => i.state === state).length)])]))),
      h.div([h.Class("sui-segmented"), h.DataAttribute("size", "sm"), h.Role("radiogroup"), h.AriaLabel("Kind")], (["All", "Issues", "Tasks", "VIPs"] as const).map((kind, index, kinds) => h.button([h.Id(`ix-kind-${kind}`), h.Class("sui-segmented-item"), h.Type("button"), h.Role("radio"), h.AriaChecked(ui.kind === kind), h.Tabindex(ui.kind === kind ? 0 : -1), h.OnClick(send("kind", kind)), h.OnKeyDownPreventDefault((key) => key === "ArrowRight" || key === "ArrowLeft" ? Option.some(send("kind-key", kinds[(index + (key === "ArrowRight" ? 1 : 3)) % 4]!)) : Option.none())], [kind]))),
      h.div([h.Class("sui-issues-actions")], [h.input([h.Class("sui-input"), h.Type("search"), h.Placeholder("Search"), h.AriaLabel("Search issues"), h.Value(ui.query), h.OnInput((value) => send("query", value)), h.Style({ width: "180px" })])]),
    ]),
    ...(ui.status === "loading" ? [h.div([h.Class("sui-issues-loading"), h.Role("status"), h.AriaLabel("Loading issues")], [1, 2, 3, 4, 5].map(() => h.span([h.Class("sui-skeleton sui-issues-skeleton")], [])))] : ui.status === "error" ? [h.div([h.Class("ix-error"), h.Role("alert")], [h.div([h.Class("sui-alert sui-alert-destructive")], ["Couldn't load issues"]), button(h, send, "Retry", "read")])] : rows.length === 0 ? [h.div([h.Class("sui-empty")], [h.div([h.Class("sui-empty-title")], [ui.query !== "" ? "No matches" : ui.kind === "Tasks" ? "No tasks committed" : ui.kind === "VIPs" ? "No VIPs in review" : `No ${ui.state} issues`]), h.div([h.Class("sui-empty-action")], controls)])] : [h.ul([h.Class("sui-issues-list"), h.AriaLabel(titleOf(ui))], rows.map((i, index) => h.li([h.Class("sui-issues-row"), h.Key(String(i.number)), h.OnKeyDownPreventDefault((key) => key === "j" || key === "k" ? Option.some(send("focus", `ix-issue-${rows[Math.max(0, Math.min(rows.length - 1, index + (key === "j" ? 1 : -1)))]!.number}`)) : Option.none())], [
      h.div([h.Class("sui-issues-state")], [icon(h, i)]),
      h.div([h.Class("sui-issues-main")], [h.div([h.Class("sui-issues-title-line")], [issueLink(h, send, i, false), ...badges(h, i)]), h.div([h.Class("sui-issues-meta")], [`#${i.number} · ${ui.data.absoluteDates || i.state === "open" ? "opened" : "closed"} ${when(ui.data.absoluteDates === true, i.age)} by ${i.author}${i.parent === 0 ? "" : ` · child of #${i.parent}`}${ui.data.items.some((c) => c.parent === i.number) ? ` · ${ui.data.items.filter((c) => c.parent === i.number).length} ${ui.data.items.filter((c) => c.parent === i.number).length === 1 ? "child" : "children"}` : ""}${i.assignee === "" ? "" : ` · → ${i.assignee}`}`])]),
      h.span([h.Class("sui-issues-comments"), h.AriaLabel(`${i.comments} comments`)], i.comments === 0 ? [] : [commentIcon(h), String(i.comments)]),
    ])))]),
  ])])]
}
