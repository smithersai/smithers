      ...(ui.error === "" ? [] : [h.div([h.Role("alert"), h.Class("sui-issue-form-error")], [ui.error, ...(ui.error === "Connect GitHub." ? [connect(h, ui)] : []), ...(ui.retry === undefined ? ui.error === "Couldn't load comments. Retry." ? [button(h, send, "Retry", "read")] : [] : !issuePermission(ui.role, ui.retry.op) ? [] : [button(h, send, "Retry", "retry", true)])])]),
