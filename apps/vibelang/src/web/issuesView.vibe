    ...(ui.role !== "viewer" && !connected(ui) ? [connect(h, ui)] : []),
    ...(connected(ui) && issuePermission(ui.role, "split") ? [button(h, send, "Split", "split-dialog"), button(h, send, "Link", "link-dialog")] : []),
    ...(connected(ui) && issuePermission(ui.role, "commit") && i.vip === "" && (i.state === "open" || i.task !== "") ? [h.button([h.Id("ix-commit"), h.Type("button"), h.Class(`sui-button sui-button-sm${i.task === "" ? " sui-button-default" : ""}`), h.OnClick(send(i.task === "" ? "commit-dialog" : "uncommit")), h.Disabled(ui.busy)], [i.task === "" ? "Commit" : "Uncommit"])] : []),
    ...(connected(ui) && issuePermission(ui.role, "accept") && i.vip === "In review" ? [h.button([h.Type("button"), h.Class("sui-button sui-button-sm sui-button-destructive"), h.OnClick(send("decline"))], ["Decline"]), button(h, send, "Accept", "accept", true)] : []),
  ]
  const aside = (name: string, content: ReadonlyArray<Html>) => h.div([h.Class("ix-aside-section")], [h.span([h.Class("sui-label")], [name]), ...content])
  return [header(h, send, `#${i.number}`, "‹ Issues"), h.div([h.Class("sui-page-body")], [h.div([h.Class("sui-item-conv"), h.DataAttribute("aside", "")], [
    h.div([h.Class("sui-item-conv-header")], [h.h1([h.Class("sui-item-conv-title")], [i.title, " ", h.span([h.Class("sui-item-conv-number")], [`#${i.number}`])]), h.div([h.Class("sui-item-conv-meta")], [h.span([h.Class("sui-item-conv-state sui-badge sui-badge-success")], [icon(h, i), i.state === "open" ? "Open" : "Closed"]), ...badges(h, i, false), h.span([], [`${i.author} opened ${when(ui.data.absoluteDates === true, i.age, true)} · ${i.comments} comments`]), h.span([h.Class("sui-item-conv-header-actions")], actions)])]),
    h.div([h.Class("sui-item-conv-main")], [
      h.div([h.Class("sui-item-conv-post")], [h.div([h.Class("sui-item-conv-comment-meta")], [avatar(h, i.author), h.span([h.Class("sui-item-conv-author")], [i.author]), h.span([], [when(ui.data.absoluteDates === true, i.age, true)])]), ...issueBody(ui, h, send, i.body)]),
      ...(i.vip !== "" || (parent === undefined && children.length === 0) ? [] : [
      h.div([h.Class("sui-card")], [h.div([h.Class("sui-card-header")], [h.div([h.Class("sui-card-title")], ["Tree"]), h.span([h.Class("sui-card-action sui-badge sui-badge-secondary")], [`${children.length} children`])]), h.div([h.Class("sui-card-content ix-tree")], [
        ...(parent === undefined ? [] : [h.div([h.Class("ix-tree-parent")], ["Part of ", issueLink(h, send, parent)])]),
        h.ul([h.Class("ix-tree-list")], children.map((child) => h.li([h.Class("ix-tree-row")], [icon(h, child), issueLink(h, send, child), h.span([h.Class("ix-tree-meta")], [...badges(h, child, false), ...(child.assignee === "" ? [] : [avatar(h, child.assignee)])])]))),
      ])])
      ]),
      h.ol([h.Class("sui-item-conv-events")], i.notes.filter(n => n.event).map(n => h.li([h.Class("sui-item-conv-event")], [h.span([h.Class("sui-item-conv-event-icon")], [n.text.startsWith("added ") ? "+" : n.text.startsWith("accepted ") ? "✓" : n.text.startsWith("proposed ") ? "◦" : "↳"]), h.span([h.Class("sui-item-conv-event-text")], [h.b([], [n.author]), " ", ...eventText(ui, h, send, n.text), ...(n.age === "" ? [] : [` · ${n.age}`])])]))),
      h.ol([h.Class("sui-item-conv-comments")], i.notes.filter(n => !n.event).map(n => h.li([h.Class("sui-item-conv-comment")], [h.div([h.Class("sui-item-conv-comment-meta")], [avatar(h, n.author), h.span([h.Class("sui-item-conv-author")], [n.author]), ...(n.author === "VibeLang agent" ? [h.span([h.Class("sui-badge sui-badge-secondary")], ["agent"])] : []), ...(n.age === "" ? [] : [h.span([], [when(ui.data.absoluteDates === true, n.age, true)])])]), ...issueBody(ui, h, send, n.text)]))),
