function field(h: H, send: Send, label: string, action: string, value: string, placeholder = "", code = false, advance = false, locked = false): Html {
  return h.div([h.Class("sui-field")], [h.label([h.Class("sui-label"), h.For(`ix-${action}`)], [label]), action === "title" ? h.input([h.Id(`ix-${action}`), h.Disabled(locked), h.Class("sui-input"), h.AriaLabel(label), h.Placeholder(placeholder), h.Value(value), h.OnInput((v) => send(action, v)), h.OnKeyDownPreventDefault((key) => S.enterActs(key, advance) ? Option.some(send("continue")) : Option.none())]) : h.textarea([h.Id(`ix-${action}`), h.Disabled(locked), h.Class(`sui-textarea${code ? " vl-code" : ""}`), ...(code ? [h.DataAttribute("code", ""), h.Rows(5)] : []), h.AriaLabel(label), h.Placeholder(placeholder), h.Value(value), h.OnInput((v) => send(action, v))])])
