    h.form([h.Class("sui-issue-form"), h.OnSubmit(send(shape.submit))], [
    ...(shape.fields === "title" ? [field(h, send, "Title", "title", ui.title, vip ? "One language feature" : "Title", false, vip, G.issueLocked(ui.busy, ui.retry !== undefined)), field(h, send, "Summary", "summary", ui.summary, "", false, false, G.issueLocked(ui.busy, ui.retry !== undefined))] : shape.fields === "example" ? [field(h, send, "Example", "example", ui.example, "", true, false, G.issueLocked(ui.busy, ui.retry !== undefined))] : shape.fields === "prior" ? [field(h, send, "Prior art", "prior", ui.prior, "One per line", false, false, G.issueLocked(ui.busy, ui.retry !== undefined))] : [h.div([h.Class("sui-card")], [
      h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], [ui.title]), h.span([h.Class("sui-card-action")], [h.span([h.Class("sui-badge sui-badge-outline")], ["VIP"])])]),
      h.div([h.Class("sui-card-content")], [
        h.div([], [h.span([h.Class("sui-label")], ["Summary"]), h.p([h.Style({ margin: "4px 0 0", fontSize: "13px" })], [ui.summary])]),
        h.div([], [h.span([h.Class("sui-label")], ["Example"]), h.pre([h.Class("vl-code")], [h.code([], [ui.example])])]),
        h.div([], [h.span([h.Class("sui-label")], ["Prior art"]), h.p([h.Style({ margin: "4px 0 0", fontSize: "13px", whiteSpace: "pre-line" })], [ui.prior])]),
      ]),
    ])]),
    ...(ui.error === "" ? [] : [h.div([h.Role("alert"), h.Class("sui-issue-form-error")], [ui.error, ...failureAction(h, ui), ...retryButton(ui, h, send)])]),
    h.div([h.Class("sui-issue-form-actions")], [...(shape.draft ? [button(h, send, "Draft with agent", "draft")] : []), ...(shape.back ? [button(h, send, "Back", "back")] : []), h.button([h.Class("sui-button sui-button-sm sui-button-solid"), h.Type("button"), h.Disabled(G.issueLocked(ui.busy, ui.retry !== undefined)), h.OnClick(send(shape.submit))], [shape.label])]),
  ])])]
}
function dialog(ui: IssuesUi, h: H, send: Send): Html {
  if (ui.dialog === "") return h.dialog([h.Id("ix-dialog"), h.Class("sui-dialog-content ix-dialog"), h.DataAttribute("state", "closed")], [])
  const name = V.dialogTitle(ui.dialog, String(ui.selected))
  const body = S.dialogBody(ui.dialog)
  return h.dialog([h.Id("ix-dialog"), h.Class("sui-dialog-content ix-dialog"), h.AriaLabel(name), h.AriaModal(true), h.DataAttribute("state", "open"), h.OnCancelPreventDefault(send("cancel"))], [
    h.div([h.Class("sui-dialog-header")], [h.h2([h.Class("sui-dialog-title")], [name])]),
    ...(body === "assignee" ? [h.div([h.Class("sui-field")], [h.span([h.Class("sui-label")], ["Assignee"]), h.div([h.Class("ix-pick"), h.Role("radiogroup"), h.AriaLabel("Assignee"), h.OnKeyDownPreventDefault((key) => S.enterActs(key, true) ? Option.some(send("commit")) : Option.none())], (ui.data.assignees ?? ["VibeLang agent", "Will", "Maya"].map((name) => ({ login: name, label: name }))).map((choice) => ({ ...choice, display: V.assigneeName(choice.label, choice.login) })).filter((choice) => S.choiceOffered(choice.display.trim())).map((choice) => h.label([], [h.input([h.Type("radio"), h.AriaLabel(choice.display), h.Disabled(G.issueLocked(ui.busy, ui.retry !== undefined)), h.Name("assignee"), h.Checked(ui.assignee === choice.login), h.Value(choice.login), h.OnClick(send("assignee", choice.login))]), h.span([h.Class("ix-avatar"), h.DataAttribute("agent", String(isAgent(choice.display)))], [choice.display.slice(0, 1)]), choice.display])))])] : body === "split" ? [field(h, send, "Title", "title", ui.title), field(h, send, "Summary", "summary", ui.summary, "", false, false, G.issueLocked(ui.busy, ui.retry !== undefined))] : [field(h, send, "Parent", "parent", ui.parent)]),
    ...(ui.error === "" ? [] : [h.div([h.Role("alert"), h.Class("sui-issue-form-error")], [ui.error, ...failureAction(h, ui), ...retryButton(ui, h, send)])]),
    h.div([h.Class("sui-dialog-footer")], [button(h, send, "Cancel", "cancel"), h.button([h.Class("sui-button sui-button-sm sui-button-solid"), h.Type("button"), h.Disabled(G.issueLocked(ui.busy, ui.retry !== undefined)), h.OnClick(send(ui.dialog))], [V.dialogSubmit(ui.dialog)])]),
  ])
}


function specificationView(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const spec = ui.data.specification ?? emptySpecification
  const accepted = specificationAccepted(spec)
  const history = ui.data.specificationHistory ?? []
  return [header(h, send, "Specification", "‹ VIPs"), h.div([h.Class("sui-page-body"), h.DataAttribute("width", "narrow")], [
    h.div([h.Class("sui-card")], [
      h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], [`Revision ${spec.revision}`]), h.span([h.Role("status"), h.AriaLabel("Specification gate"), h.Class(`sui-badge sui-badge-${accepted ? "success" : "warning"}`)], [accepted ? "Accepted" : "In review"])]),
      h.div([h.Class("sui-table-container")], [h.table([h.Class("sui-table ix-spec-reviews"), h.AriaLabel("Specification reviews")], [
        h.thead([], [h.tr([], ["Reviewer", "Verdict", "Grade", "Rev", ""].map(label => h.th([], [label])))]),
        h.tbody([], reviewers.map(({ id, name }) => {
          const review = spec[id]
          return h.tr([], [h.td([], [name]), h.td([], review.link === "" ? [V.cellText(review.verdict, "—")] : [h.a([h.Href(review.link)], [V.cellText(review.verdict, "Review")])]), h.td([], [V.cellText(review.grade, "—")]), h.td([], [review.revision === 0 ? "—" : String(review.revision)]), h.td([], issuePermission(ui.role, "spec-review") ? [h.button([h.Class("sui-button sui-button-sm"), h.Type("button"), h.Disabled(ui.busy), h.AriaLabel("Request review"), h.OnClick(send("spec-review", id))], ["Review"])] : [])])
        })),
      ])]),
      h.div([h.Class("sui-card-content")], [
        ...(issuePermission(ui.role, "spec-revise") ? [h.textarea([h.Class("sui-textarea vl-code"), h.Rows(8), h.AriaLabel("Specification text"), h.Value(ui.summary), h.Disabled(ui.busy), h.OnInput(v => send("summary", v))]), h.button([h.Class("sui-button sui-button-sm"), h.Type("button"), h.Disabled(V.revisionDisabled(ui.busy, ui.summary, spec.text)), h.OnClick(send("spec-revise"))], ["Save revision"])] : [h.pre([h.Class("vl-code"), h.Style({ whiteSpace: "pre-wrap" })], [spec.text])]),
        ...(ui.error === "" ? [] : [h.div([h.Role("alert")], [ui.error, ...(ui.retry === undefined ? [] : [button(h, send, "Retry", "retry")])])]),
      ]),
    ]),
    ...(accepted ? [h.div([h.Class("sui-card")], [h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], ["Self-consistency"])]), h.div([h.Class("sui-card-content")], verificationSuites.map(suite => h.a([h.Class("sui-badge sui-badge-outline"), h.Href(suite.href)], [`${suite.label} · ${suite.state}`])))])] : []),
    h.details([], [h.summary([], ["History"]), h.ol([h.Class("sui-item-conv-events")], history.map((event, index) => h.li([h.Id(`spec-review-${index + 1}`), h.Class("sui-item-conv-event")], [h.details([], [h.summary([], [`r${event.revision} · ${V.specEventName(event.event) !== "" ? V.specEventName(event.event) : `${reviewers.find(r => r.id === event.reviewer)?.name ?? event.reviewer} · ${event.verdict} · ${event.grade}`} · ${event.at}`]), ...(event.review === undefined ? [] : [h.p([], [event.review])])])])))]),
  ])]
}
