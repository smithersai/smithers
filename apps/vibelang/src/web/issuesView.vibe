import { verificationSuites } from "../assets/wiki.generated.vibe"
// Foldkit rendering of wiki/designs/issues. Smithers owns the component CSS; ix-* is the designer's extension.
import { reviewers, emptySpecification } from "../core/specification.vibe"
import type { Html, HtmlBuilder } from "foldkit/html"
import { issuePermission, may, specificationAccepted, type IssueRecord, type IssueOperation, type Role } from "../core/conversation.vibe"
import type { Message } from "./main.vibe"
import type { IssuesUi } from "./issues.vibe"
import { blocks, inline as codeParts } from "./markdown.vibe"
import * as V from "./issuesViewDecision.vibe"
import * as G from "./viewGateDecision.vibe"
import * as S from "./viewStateDecision.vibe"
import { wikiErrorAction } from "./wikiViewDecision.vibe"
import { roleName } from "./accountViewDecision.vibe"

type H = HtmlBuilder<Message>
type Send = (action: string, value?: string) => Message
function button(h: H, send: Send, text: string, action: string, primary = false): Html {
  return h.button([h.Class(`sui-button sui-button-sm${primary ? " sui-button-solid" : ""}`), h.Type("button"), h.OnClick(send(action))], [text])
}
function icon(h: H, i: IssueRecord): Html {
  const { done, kind } = V.issueIcon(i.task, i.state, i.vip)
  return h.svg([h.Class("sui-state-icon"), h.Width("16"), h.Height("16"), h.DataAttribute("kind", kind), ...(kind === "running" ? [h.DataAttribute("live", "")] : []), h.ViewBox("0 0 16 16"), h.AriaHidden(true)], [
    h.circle([h.Cx("8"), h.Cy("8"), h.R("6.75"), h.Fill("none"), h.Stroke("currentColor"), h.StrokeWidth("1.5"), ...(kind === "queued" ? [h.StrokeDasharray("2.6 2.4")] : [])], []),
    ...(done ? [h.path([h.D("M5.3 8.3l1.8 1.8 3.6-3.8"), h.Fill("none"), h.Stroke("currentColor"), h.StrokeWidth("1.5"), h.StrokeLinecap("round"), h.StrokeLinejoin("round")], [])] : kind === "running" ? [h.path([h.D("M8 1.25A6.75 6.75 0 0 1 8 14.75Z"), h.Fill("currentColor")], [])] : kind === "queued" ? [] : [h.circle([h.Cx("8"), h.Cy("8"), h.R("2.5"), h.Fill("currentColor")], [])]),
  ])
}
function commentIcon(h: H): Html {
  return h.svg([h.ViewBox("0 0 16 16"), h.Width("14"), h.Height("14"), h.AriaHidden(true), h.Style({ width: "14px", height: "14px", fill: "none", stroke: "currentColor", strokeWidth: "1.4", strokeLinecap: "round", strokeLinejoin: "round" })], [h.path([h.D("M2.5 2.5h11a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7.2L4 14.7a.3.3 0 0 1-.5-.2V12H2.5a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1Z")], [])])
}

function badges(h: H, i: IssueRecord, labels = true): ReadonlyArray<Html> {
  return [
    ...(i.task === "" ? [] : [h.span([h.Class("sui-badge sui-badge-default")], [`Task · ${i.task}`])]),
    ...(i.vip === "" ? [] : [h.span([h.Class(`sui-badge sui-badge-${V.vipBadge(i.vip)}`)], [`VIP · ${i.vip}`])]),
    ...(labels ? i.labels : []).filter((l) => V.labelShown(l)).map((l) => h.span([h.Class("sui-badge sui-badge-secondary")], [l])),
  ]
}

function when(absolute: boolean, age: string, long = false): string {
  return V.ageText(absolute, age, long)
}
function references(ui: IssuesUi, h: H, send: Send, text: string) {
  return text.split(/(#[1-9][0-9]*)/).map(part => {
    const item = /^#[1-9][0-9]*$/.test(part) ? ui.data.items.find(item => item.number === Number(part.slice(1))) : undefined
    return item === undefined ? part : h.a([h.Class("sui-item-conv-meta-link"), h.Href(`#issue-${item.number}`), h.OnClick(send("select", String(item.number)), { defaultAction: "Prevent" })], [part])
  })
}
function issueBody(ui: IssuesUi, h: H, send: Send, text: string): ReadonlyArray<Html> {
  return blocks(text).map(block => block.kind === "code"
    ? h.pre([h.Class("vl-code")], [h.code([], [block.text])])
    : h.p([h.Style({ margin: "0", whiteSpace: "pre-line" })], codeParts(block.text).flatMap(part => part.code ? [h.code([], [part.text])] : references(ui, h, send, part.text))))
}
function eventText(ui: IssuesUi, h: H, send: Send, text: string) {
  const label = /^(added|removed) the (.+) label$/.exec(text)
  return label === null ? references(ui, h, send, text) : [`${label[1]} the `, h.span([h.Class("sui-badge sui-badge-secondary")], [label[2]!]), " label"]
}
function avatar(h: H, name: string): Html {
  return h.span([h.Class("ix-avatar"), h.DataAttribute("agent", String(isAgent(name))), h.Title(name)], [name.slice(0, 1).toUpperCase()])
}
export function issueChatCard(h: H, issue: IssueRecord, items: ReadonlyArray<IssueRecord>, label: string, absolute: boolean, open: (number: number) => Message): Html {
  const children = items.filter(child => child.parent === issue.number)
  return h.div([h.Class("sui-card ix-chat-card")], [
    h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], [issue.title]), h.span([h.Class("sui-card-action")], [h.span([h.Class(`sui-badge sui-badge-${children.length === 0 && issue.state === "open" ? "success" : "secondary"}`)], [children.length === 0 ? issue.state === "open" ? "Open" : "Closed" : `#${issue.number} · ${children.length} ${V.childrenWord(children.length)}`])])]),
    h.div([h.Class("sui-card-content")], children.length === 0 ? [h.div([h.Class("sui-card-description")], [`#${issue.number} · opened ${when(absolute, issue.age)}${issue.labels.length === 0 ? "" : ` · ${issue.labels.join(", ")}`}`])] : children.map(child => h.div([h.Class("ix-mini")], [icon(h, child), h.a([h.Href(`#issue-${child.number}`), h.OnClick(open(child.number), { defaultAction: "Prevent" })], [`#${child.number} ${child.title}`]), h.span([h.Class("ix-tree-meta")], badges(h, child, false))]))),
    // The label is the agent's link text; a blank one would leave the button without a name.
    h.div([h.Class("sui-card-footer")], [h.button([h.Type("button"), h.Class("sui-button sui-button-sm"), h.OnClick(open(issue.number))], [label.trim() === "" ? `Open #${issue.number}` : label])]),
  ])
}

function issueLink(h: H, send: Send, i: IssueRecord, full = true): Html {
  return h.a([h.Id(`ix-issue-${i.number}`), h.Href(`#issue-${i.number}`), h.Class(full ? "sui-button-link" : "sui-issues-link sui-issues-title"), h.OnClick(send("select", String(i.number)), { defaultAction: "Prevent" })], [V.issueLinkText(full, String(i.number), i.title)])
}
function header(h: H, send: Send, name: string, back = "‹ Chat", actions: ReadonlyArray<Html> = []): Html {
  return h.header([h.Class("sui-page-header")], [h.div([h.Class("sui-page-header-inner")], [
    h.div([h.Class("sui-page-header-back")], [h.a([h.Href("#issues"), h.OnClick(send(S.backAction(back)), { defaultAction: "Prevent" })], [back])]),
    h.h1([h.Class("sui-page-header-title")], [name]),
    h.div([h.Class("sui-page-header-actions")], actions),
  ])])
}
/** A copy GitHub refused to refresh (decision 0031): one word, and when GitHub last confirmed it, unless that time is
 * past the last valid Date (a safe cursor can be). */
export function staleMark<M>(h: HtmlBuilder<M>, stale: number | undefined): ReadonlyArray<Html> {
  if (stale === undefined) return []
  const at = new Date(stale)
  const title = Number.isNaN(at.getTime()) ? [] : [h.Title(`As of ${at.toISOString().slice(0, 16).replace("T", " ")} UTC`)]
  return [h.span([h.Class("sui-badge sui-badge-outline vl-stale"), ...title], ["Stale"])]
}
function titleOf(ui: IssuesUi): string { return V.issuesTitle(ui.kind) }
export function issuesView(ui: IssuesUi, h: H, send: Send): Html {
  return h.section([h.Class("ix-surface"), h.AriaLabel("Issues pane"), h.Style({ viewTransitionName: "issues" })], [
    ...screenOf(ui, h, send),
    dialog(ui, h, send),
  ])
}
function screenOf(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const screen = V.issuesScreen(ui.screen)
  return screen === "specification" ? specificationView(ui, h, send) : screen === "roles" ? rolesView(h, send) : screen === "detail" ? detail(ui, h, send) : screen === "form" ? form(ui, h, send) : list(ui, h, send)
}
function connected(ui: IssuesUi): boolean { return ui.data.connected !== false }
function connection(ui: IssuesUi): "yes" | "no" | "unknown" { return S.connectionOf(ui.data.connected === true, ui.data.connected === false) }
function isAgent(name: string): boolean { return name === "VibeLang agent" }
/** A failure's Retry (retryAction): the kept request when still permitted, else a comments read. */
function retryButton(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const action = V.retryAction(ui.retry !== undefined, ui.retry !== undefined && issuePermission(ui.role, ui.retry.op), ui.error)
  return action === "retry" ? [button(h, send, "Retry", "retry", true)] : action === "read" ? [button(h, send, "Retry", "read")] : []
}
function connect(h: H, ui: IssuesUi): Html { return h.form([h.Method("post"), h.Action(ui.connection)], [h.button([h.Class("sui-button sui-button-sm"), h.Type("submit")], ["Connect GitHub"])]) }
function disconnect(h: H): Html { return h.form([h.Method("post"), h.Action("/api/auth/disconnect")], [h.button([h.Class("sui-button sui-button-sm"), h.Type("submit")], ["Disconnect"])]) }
/** The one action a failure offers: connecting, forking, or installing the App on the fork. */
function failureAction(h: H, ui: IssuesUi): ReadonlyArray<Html> {
  const action = wikiErrorAction(ui.error)
  if (action === "connect") return [connect(h, ui)]
  if (action === "fork") return [h.a([h.Class("sui-button sui-button-sm"), h.Href("https://github.com/smithersai/vibelang/fork")], ["Fork"])]
  if (action === "install") return [h.a([h.Class("sui-button sui-button-sm"), h.Href("/api/auth/install")], ["Install"])]
  return []
}
function rolesView(h: H, send: Send): ReadonlyArray<Html> {
  const roles: ReadonlyArray<Role> = ["viewer", "new", "community", "contributor", "maintainer"]
  // Each row's cell is its issue permission; Promote's is the role policy's own (may "roles").
  const rows: ReadonlyArray<{ readonly label: string; readonly allowed: (role: Role) => boolean }> = [
    ...([
      { label: "Read issues, tasks, VIPs", op: "read" }, { label: "Comment", op: "comment" },
      { label: "File an issue", op: "new" }, { label: "Propose a VIP", op: "propose" },
      { label: "Link issues", op: "link" }, { label: "Split an issue", op: "split" },
      { label: "Commit a task", op: "commit" }, { label: "Review a VIP", op: "accept" },
    ] as const).map(({ label, op }) => ({ label, allowed: (role: Role) => issuePermission(role, op) })),
    { label: "Promote a role", allowed: (role: Role) => may(role, "roles") },
  ]
  return [header(h, send, "Roles"), h.div([h.Class("sui-page-body"), h.DataAttribute("width", "narrow")], [
    h.div([h.Class("sui-table-container"), h.DataAttribute("variant", "card")], [h.table([h.Class("sui-table ix-roles")], [
      h.thead([], [h.tr([], [h.th([], ["Action"]), ...roles.map(role => h.th([], [roleName(role)]))])]),
      h.tbody([], rows.map(row => h.tr([], [h.td([], [row.label]), ...roles.map(role => {
        const allowed = row.allowed(role)
        return h.td([h.Class(allowed ? "ix-yes" : "ix-no")], [allowed ? "✓" : "—"])
      })]))),
      h.caption([], ["People review VIPs and grant roles; the agent uses the same flows."]),
    ])]),
  ])]
}
function list(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const filtered = ui.data.items.filter((i) => V.kindIncludes(ui.kind, i.task, i.vip))
  const rows = filtered.filter((i) => S.issueListed(i.state, ui.state, `${i.title} #${i.number} ${i.labels.join(" ")}`.toLowerCase().includes(ui.query.toLowerCase())))
  const add = G.newIssueControl(ui.kind, connected(ui), issuePermission(ui.role, "propose"), issuePermission(ui.role, "new"))
  const control = V.connectionControl(ui.role, connection(ui))
  const connectionControls = control === "connect" ? [connect(h, ui)] : control === "disconnect" ? [disconnect(h)] : []
  const controls = add.shown ? [h.button([h.Class("sui-button sui-button-sm sui-button-default"), h.Type("button"), h.OnClick(send(add.action))], [add.label])] : []
  return [header(h, send, titleOf(ui), "‹ Chat", [...staleMark(h, ui.data.stale), button(h, send, "Specification", "specification"), button(h, send, "Roles", "roles"), ...connectionControls, ...controls]), ...(!S.listErrorShown(ui.error, ui.status) ? [] : [h.div([h.Role("alert"), h.Class("sui-issue-form-error")], [ui.error, ...retryButton(ui, h, send)])]), h.div([h.Class("sui-page-body")], [h.div([h.Class("sui-issues-view")], [
    h.div([h.Class("sui-issues-header")], [
      h.div([h.Class("sui-issues-filters")], (["open", "closed"] as const).map((state) => h.a([h.Class("sui-issues-filter"), h.Href(`#${state}`), ...(state === ui.state ? [h.AriaCurrent("page")] : []), h.OnClick(send("state", state), { defaultAction: "Prevent" })], [state === "open" ? "◉ Open " : "✓ Closed ", h.span([h.Class("sui-issues-filter-count")], [String(filtered.filter((i) => i.state === state).length)])]))),
      h.div([h.Class("sui-segmented"), h.DataAttribute("size", "sm"), h.Role("radiogroup"), h.AriaLabel("Kind")], (["All", "Issues", "Tasks", "VIPs"] as const).map((kind, index, kinds) => h.button([h.Id(`ix-kind-${kind}`), h.Class("sui-segmented-item"), h.Type("button"), h.Role("radio"), h.AriaChecked(ui.kind === kind), h.Tabindex(ui.kind === kind ? 0 : -1), h.OnClick(send("kind", kind)), h.OnKeyDownPreventDefault((key) => V.kindKey(index, key) < 0 ? Option.none() : Option.some(send("kind-key", kinds[V.kindKey(index, key)]!)))], [kind]))),
      h.div([h.Class("sui-issues-actions")], [h.input([h.Class("sui-input"), h.Type("search"), h.Placeholder("Search"), h.AriaLabel("Search issues"), h.Value(ui.query), h.OnInput((value) => send("query", value)), h.Style({ width: "180px" })])]),
    ]),
    ...(V.listBody(ui.status, rows.length) === "loading" ? [h.div([h.Class("sui-issues-loading"), h.Role("status"), h.AriaLabel("Loading issues")], [1, 2, 3, 4, 5].map(() => h.span([h.Class("sui-skeleton sui-issues-skeleton")], [])))] : V.listBody(ui.status, rows.length) === "error" ? [h.div([h.Class("ix-error"), h.Role("alert")], [h.div([h.Class("sui-alert sui-alert-destructive")], ["Couldn't load issues"]), button(h, send, "Retry", "read")])] : V.listBody(ui.status, rows.length) === "empty" ? [h.div([h.Class("sui-empty")], [h.div([h.Class("sui-empty-title")], [V.emptyTitle(ui.query, ui.kind, ui.state)]), h.div([h.Class("sui-empty-action")], controls)])] : [h.ul([h.Class("sui-issues-list"), h.AriaLabel(titleOf(ui))], rows.map((i, index) => h.li([h.Class("sui-issues-row"), h.Key(String(i.number)), h.OnKeyDownPreventDefault((key) => V.rowFocus(index, rows.length, key) < 0 ? Option.none() : Option.some(send("focus", `ix-issue-${rows[V.rowFocus(index, rows.length, key)]!.number}`)))], [
      h.div([h.Class("sui-issues-state")], [icon(h, i)]),
      h.div([h.Class("sui-issues-main")], [h.div([h.Class("sui-issues-title-line")], [issueLink(h, send, i, false), ...badges(h, i)]), h.div([h.Class("sui-issues-meta")], [`#${i.number} · ${V.openedWord(ui.data.absoluteDates === true, i.state)} ${when(ui.data.absoluteDates === true, i.age)} by ${i.author}${i.parent === 0 ? "" : ` · child of #${i.parent}`}${ui.data.items.some((c) => c.parent === i.number) ? ` · ${ui.data.items.filter((c) => c.parent === i.number).length} ${V.childrenWord(ui.data.items.filter((c) => c.parent === i.number).length)}` : ""}${i.assignee === "" ? "" : ` · → ${i.assignee}`}`])]),
      h.span([h.Class("sui-issues-comments"), h.AriaLabel(`${i.comments} comments`)], i.comments === 0 ? [] : [commentIcon(h), String(i.comments)]),
    ])))]),
  ])])]
}
function detail(ui: IssuesUi, h: H, send: Send): ReadonlyArray<Html> {
  const i = ui.data.items.find((i) => i.number === ui.selected)
  if (i === undefined) return [header(h, send, "Issue", "‹ Issues"), h.div([h.Class("sui-empty")], ["Issue unavailable"])]
  const parent = ui.data.items.find((p) => p.number === i.parent)
  const children = ui.data.items.filter((c) => c.parent === i.number)
  const allowed = V.detailActions(ui.role, connected(ui), issuePermission(ui.role, "split"), issuePermission(ui.role, "commit"), issuePermission(ui.role, "accept"), issuePermission(ui.role, "comment"), i.vip, i.state, i.task)
  const actions = [
    ...(allowed.connect ? [connect(h, ui)] : []),
    ...(allowed.split ? [button(h, send, "Split", "split-dialog"), button(h, send, "Link", "link-dialog")] : []),
    ...(allowed.commit === "none" ? [] : [h.button([h.Id("ix-commit"), h.Type("button"), h.Class(`sui-button sui-button-sm${allowed.commit === "commit" ? " sui-button-default" : ""}`), h.OnClick(send(allowed.commit === "commit" ? "commit-dialog" : "uncommit")), h.Disabled(ui.busy)], [allowed.commit === "commit" ? "Commit" : "Uncommit"])]),
    ...(allowed.review ? [h.button([h.Type("button"), h.Class("sui-button sui-button-sm sui-button-destructive"), h.OnClick(send("decline"))], ["Decline"]), button(h, send, "Accept", "accept", true)] : []),
  ]
  const aside = (name: string, content: ReadonlyArray<Html>) => h.div([h.Class("ix-aside-section")], [h.span([h.Class("sui-label")], [name]), ...content])
  return [header(h, send, `#${i.number}`, "‹ Issues", staleMark(h, ui.data.stale)), h.div([h.Class("sui-page-body")], [h.div([h.Class("sui-item-conv"), h.DataAttribute("aside", "")], [
    h.div([h.Class("sui-item-conv-header")], [h.h1([h.Class("sui-item-conv-title")], [i.title, " ", h.span([h.Class("sui-item-conv-number")], [`#${i.number}`])]), h.div([h.Class("sui-item-conv-meta")], [h.span([h.Class("sui-item-conv-state sui-badge sui-badge-success")], [icon(h, i), i.state === "open" ? "Open" : "Closed"]), ...badges(h, i, false), h.span([], [`${i.author} opened ${when(ui.data.absoluteDates === true, i.age, true)} · ${i.comments} comments`]), h.span([h.Class("sui-item-conv-header-actions")], actions)])]),
    h.div([h.Class("sui-item-conv-main")], [
      h.div([h.Class("sui-item-conv-post")], [h.div([h.Class("sui-item-conv-comment-meta")], [avatar(h, i.author), h.span([h.Class("sui-item-conv-author")], [i.author]), h.span([], [when(ui.data.absoluteDates === true, i.age, true)])]), ...issueBody(ui, h, send, i.body)]),
      ...(!S.treeShown(i.vip, parent !== undefined, children.length) ? [] : [
      h.div([h.Class("sui-card")], [h.div([h.Class("sui-card-header")], [h.div([h.Class("sui-card-title")], ["Tree"]), h.span([h.Class("sui-card-action sui-badge sui-badge-secondary")], [`${children.length} ${V.childrenWord(children.length)}`])]), h.div([h.Class("sui-card-content ix-tree")], [
        ...(parent === undefined ? [] : [h.div([h.Class("ix-tree-parent")], ["Part of ", issueLink(h, send, parent)])]),
        h.ul([h.Class("ix-tree-list")], children.map((child) => h.li([h.Class("ix-tree-row")], [icon(h, child), issueLink(h, send, child), h.span([h.Class("ix-tree-meta")], [...badges(h, child, false), ...(child.assignee === "" ? [] : [avatar(h, child.assignee)])])]))),
      ])])
      ]),
      ...(i.vip === "" ? [] : [h.section([h.AriaLabel("Proposal gate"), h.Class("sui-card")], [
        h.div([h.Class("sui-card-header")], [h.span([h.Class("sui-card-title")], ["Proposal"]), h.span([h.Class("sui-badge sui-badge-outline")], [i.vip])]),
        h.div([h.Class("sui-card-content")], [h.span([h.Class("sui-label")], ["Maintainer · person"]), ...(i.approvedBy === undefined ? [] : [h.div([], [i.approvedBy, " · ", h.time([h.Datetime(i.approvedAt ?? "")], [i.approvedAt ?? ""])])])]),
      ])]),
      h.ol([h.Class("sui-item-conv-events")], i.notes.filter(n => n.event).map(n => h.li([h.Class("sui-item-conv-event")], [h.span([h.Class("sui-item-conv-event-icon")], [V.eventIcon(n.text)]), h.span([h.Class("sui-item-conv-event-text")], [h.b([], [n.author]), " ", ...eventText(ui, h, send, n.text), ...(n.age === "" ? [] : [` · ${n.age}`])])]))),
      h.ol([h.Class("sui-item-conv-comments")], i.notes.filter(n => !n.event).map(n => h.li([h.Class("sui-item-conv-comment")], [h.div([h.Class("sui-item-conv-comment-meta")], [avatar(h, n.author), h.span([h.Class("sui-item-conv-author")], [n.author]), ...(isAgent(n.author) ? [h.span([h.Class("sui-badge sui-badge-secondary")], ["agent"])] : []), ...(n.age === "" ? [] : [h.span([], [when(ui.data.absoluteDates === true, n.age, true)])])]), ...issueBody(ui, h, send, n.text)]))),
