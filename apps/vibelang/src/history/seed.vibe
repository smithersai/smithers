/** The epic for commits no area names: the project's first steps and anything without a scope. */
export const FOUNDATIONS = "Foundations"

const CONVENTIONAL = /^([a-z]+)(?:\(([^)]*)\))?!?:\s/
const PREFIX = /^([A-Za-z][\w./-]*):\s/

/** The scope a commit title names: `type(scope):`'s first scope, else a bare `scope:` prefix, else `""`. */
export function scopeOf(title: string): string {
  const conventional = CONVENTIONAL.exec(title)
  if (conventional !== null) {
    const scope = (conventional[2] ?? "").split(",")[0]!.trim()
    return scope !== "" ? scope : conventional[1]!
  }
  const prefix = PREFIX.exec(title)
  return prefix === null ? "" : prefix[1]!.toLowerCase()
}

/** The title of the epic a commit with `title` belongs to. */
export function areaOf(title: string): string {
  const scope = scopeOf(title)
  if (scope === "") return FOUNDATIONS
  for (const area of AREAS) {
    if (area.scopes.includes(scope)) return area.title
  }
  return FOUNDATIONS
}

/**
 * Text safe to publish in a note: no local paths or host names, one line of whole sentences. It keeps as many whole
 * sentences as fit in `max` characters; a first sentence longer than that is kept whole up to `MAX_NOTE`, and a
 * longer one is dropped (`""`), never cut.
 */
export function sanitize(text: string, max = MAX_SEED_NOTE): string {
  const clean = text
    .replace(/(?:~|\/home|\/Users|\/tmp|\/private|\/var)\/[^\s'"`),;]*/g, "<path>")
    .replace(/\bnyc-\d+\b/g, "<host>")
    .replace(/\s+/g, " ")
    .trim()
  return wholeSentences(clean, max)
}

/** Text ends a sentence: `.`, `!` or `?`, then any closing quotes, brackets or backticks. */
const ENDED = /[.!?]["'`)\]]*$/

/** A sentence's end inside text: its punctuation and closers, then a space and what starts a sentence. */
const BOUNDARY = /[.!?]["'`)\]]*(?=\s+["'`(\[]?[A-Z0-9])/g

/** Whether `text` ends a sentence, so a note never stops mid-sentence. */
export function endsSentence(text: string): boolean {
  return ENDED.test(text)
}

/**
 * `text` as whole sentences, at most `max` characters: ended with a period when its last sentence has no end of its
 * own, cut only after a sentence's end. A first sentence longer than `max` is kept up to `MAX_NOTE`; past that, `""`.
 */
export function wholeSentences(text: string, max: number): string {
  const trimmed = text.trim().replace(/[\s,;:]+$/, "")
  if (trimmed === "") return ""
  const ended = endsSentence(trimmed) ? trimmed : `${trimmed}.`
  if (ended.length <= max) return ended
  const ends = [...ended.matchAll(BOUNDARY)].map((match) => match.index + match[0].length)
  const fits = ends.filter((end) => end <= max)
  if (fits.length > 0) return ended.slice(0, fits[fits.length - 1])
  const first = ended.slice(0, ends[0] ?? ended.length)
  return first.length <= MAX_NOTE ? first : ""
}

/** The title of a commit with no description. */
export const UNTITLED = "(no description)"

/** A description's first line, `UNTITLED` when it is empty. */
export function titleOf(description: string): string {
  const title = (description.split("\n")[0] ?? "").trim()
  return title === "" ? UNTITLED : title
}

const TRAILERS = /^(Validation|Tests?|Regression|Before|After):\s*(.+)$/

/** A line that starts something of its own: another `Key:` line or a list item. */
const OWN_LINE = /^(?:[A-Z][\w-]*:\s|[-*•]\s|\d+[.)]\s)/

/**
 * Evidence a commit's message states: its `Validation`, `Tests`, `Regression`, `Before` and `After` paragraphs, each
 * with the lines it wraps onto (up to a blank line or a line of its own), as whole sentences.
 */
export function evidenceOf(description: string): ReadonlyArray<string> {
  const paragraphs: Array<string> = []
  let open = false
  for (const raw of description.split("\n")) {
    const line = raw.trim()
    const match = TRAILERS.exec(line)
    if (match !== null) {
      paragraphs.push(`${match[1]}: ${match[2]}`)
      open = true
    } else if (open && line !== "" && !OWN_LINE.test(line)) {
      paragraphs[paragraphs.length - 1] += ` ${line}`
    } else {
      open = false
    }
  }
  return paragraphs.map((paragraph) => sanitize(paragraph)).filter((line) => line !== "")
}

const REGENERATED = /^chore\(docs\): regenerate\b/

/** The queue states a note tells: how a change landed, or how an attempt at it ended. */
const COUNTED: ReadonlyArray<string> = ["landed", "rejected", "superseded", "withdrawn"]
const REVERT = /^Revert "(.+)"$/

/** One mythical commit while grouping: its real commits and the queue entry it came from. */
interface Group {
  readonly title: string
  readonly entry: string
  readonly real: Array<RawCommit>
  readonly tried: Array<string>
  readonly evidence: Array<string>
}

function pushOnce(lines: Array<string>, line: string) {
  if (line !== "" && !lines.includes(line) && lines.length < MAX_SEED_NOTES) lines.push(line)
}

/**
 * The seed for `repository` from every commit reachable from main (`commits`, parents first, the tip last) and the
 * merge queue's `entries`, oldest first. Each first-parent step of main is grouped; a merge's side commits fold into
 * the merge's mythical commit, so every reachable commit maps to exactly one. A commit claims the oldest unclaimed landed entry with its title, and every other entry with its title is an
 * attempt (`tried`). The commits one landed entry carried form one mythical commit; a `chore(docs): regenerate` commit folds into the one
 * before it; `Revert "X"` folds into X's, noting it; every other commit is its own. Epics follow `AREAS`, in the order
 * the project first touched them; inside an epic, commits keep main's order.
 */
export function seedOf(repository: string, commits: ReadonlyArray<RawCommit>, entries: ReadonlyArray<QueueEntry>): Seed {
  // Landed entries by title, oldest first, each claimed by one commit on main; attempts by title.
  const landed = new Map<string, Array<QueueEntry>>()
  const attempts = new Map<string, Array<QueueEntry>>()
  for (const entry of entries) {
    for (const title of entry.titles) {
      if (REGENERATED.test(title) || !COUNTED.includes(entry.state)) continue
      const into = entry.state === "landed" ? landed : attempts
      const list = into.get(title) ?? []
      if (!list.includes(entry)) list.push(entry)
      into.set(title, list)
    }
  }

  const groups: Array<Group> = []
  const byEntry = new Map<string, Group>()
  const byTitle = new Map<string, Group>()
  const groupOf = new Map<string, Group>()
  const buckets = bucketsOf(commits)
  for (const { commit, step } of buckets) {
    // A merge's side commits fold into the merge's mythical commit (below), not into commits of their own.
    if (step !== commit.sha) continue
    const title = titleOf(commit.description)
    const entry = landed.get(title)?.shift()
    const reverted = REVERT.exec(title)
    const previous = groups[groups.length - 1]
    let group: Group | undefined
    if (REGENERATED.test(title) && previous !== undefined) group = previous
    else if (reverted !== null && byTitle.has(reverted[1]!)) {
      group = byTitle.get(reverted[1]!)!
      pushOnce(group.tried, `Reverted in ${commit.sha.slice(0, SHA_LENGTH)}.`)
    } else if (entry !== undefined && byEntry.has(entry.id)) group = byEntry.get(entry.id)!
    if (group === undefined) {
      group = { title, entry: entry?.id ?? "", real: [], tried: [], evidence: [] }
      groups.push(group)
      if (entry !== undefined) byEntry.set(entry.id, group)
    }
    group.real.push(commit)
    if (entry !== undefined) {
      pushOnce(group.evidence, sanitize(`Landed by the merge queue from lane ${entry.lane}${entry.gate === "" ? "" : ` through ${entry.gate}`} (matched by title).`))
    }
    for (const attempt of attempts.get(title) ?? []) {
      pushOnce(group.tried, sanitize(`${attempt.state[0]!.toUpperCase()}${attempt.state.slice(1)} in the merge queue (${attempt.lane})${attempt.reason === "" ? "." : `: ${attempt.reason}`}`))
    }
    groupOf.set(commit.sha, group)
    if (!byTitle.has(title)) byTitle.set(title, group)
  }

  // Epics in the order the project first touched them; commits keep main's order inside each.
  const order: Array<string> = []
  const members = new Map<string, Array<Group>>()
  for (const group of groups) {
    const area = areaOf(group.title)
    if (!members.has(area)) {
      order.push(area)
      members.set(area, [])
    }
    members.get(area)!.push(group)
  }

  const ids = new Map<Group, string>()
  let next = 1
  const epics = order.map((area, index) => {
    const seeded = members.get(area)!.map((group) => {
      const id = `m${next++}`
      ids.set(group, id)
      return { id, title: clip(group.title, MAX_TITLE), notes: notesOf(group) }
    })
    return { id: `e${index + 1}`, title: area, commits: seeded }
  })

  const real = buckets.map(({ commit, step }) => {
    const group = groupOf.get(step)!
    const title = titleOf(commit.description)
    return {
      sha: commit.sha.slice(0, SHA_LENGTH),
      change: commit.change.slice(0, CHANGE_LENGTH),
      title: title === group.title ? "" : clip(title, MAX_TITLE),
      into: ids.get(group)!,
    }
  })
  const last = commits[commits.length - 1]
  return { repository, main: last === undefined ? "" : last.sha.slice(0, SHA_LENGTH), epics, real }
}

/** `text` in at most `max` units, cut short with "…" and never inside a surrogate pair (stackDecision, proved). */
function clip(text: string, max: number): string {
  return text.length <= max ? text : text.slice(0, pairCut(text, max - 1)).trimEnd() + "…"
}

/** A group's notes: what the queue refused or replaced (tried), how it landed and what its messages state (evidence). */
function notesOf(group: Group): ReadonlyArray<SeedNote> {
  const evidence = [...group.evidence]
  for (const commit of group.real) {
    for (const line of evidenceOf(commit.description)) pushOnce(evidence, line)
  }
  return [
    ...group.tried.map((text) => ({ section: "tried" as const, text: clip(text, MAX_NOTE) })),
    ...evidence.map((text) => ({ section: "evidence" as const, text: clip(text, MAX_NOTE) })),
  ]
}

/** The author of every seeded note. */
export const BOOTSTRAP = "bootstrap"

/**
 * The intents that record `seed` in an empty history, in order: open each epic and append its commits, fold main's
 * commits in main's order, then add the notes. Every one is accepted by `decide` on the history they build.
 */
export function intentsOf(seed: Seed): ReadonlyArray<Intent> {
  const intents: Array<Intent> = []
  const titles = new Map<string, string>()
  for (const epic of seed.epics) {
    intents.push({ type: "OpenEpic", id: epic.id, title: epic.title })
    for (const commit of epic.commits) {
      titles.set(commit.id, commit.title)
      intents.push({ type: "Plan", id: commit.id, epic: epic.id, before: "", title: commit.title, task: "" })
    }
  }
  for (const real of seed.real) {
    intents.push({ type: "Fold", sha: real.sha, change: real.change, title: real.title === "" ? titles.get(real.into) ?? "" : real.title, into: real.into })
  }
  for (const epic of seed.epics) {
    for (const commit of epic.commits) {
      for (const note of commit.notes) intents.push({ type: "AddNote", id: commit.id, section: note.section, text: note.text, by: BOOTSTRAP })
    }
  }
  return intents
}

/** A history replayed from intents, and the intents the sequencer refused (none, for a seed's). */
export interface Replayed {
  readonly history: History
  readonly refused: ReadonlyArray<Intent>
}

/** Records `intents` in order through `decide` and `apply`, from `from`. */
export function replay(intents: ReadonlyArray<Intent>, from: History = empty): Replayed {
  let history = from
  const refused: Array<Intent> = []
  for (const intent of intents) {
    const decision = decideWithinCapacity(history, intent)
    if (decision.ok) history = apply(history, decision.event)
    else refused.push(intent)
  }
  return { history, refused }
}

/**
 * The seed a bootstrapped `history` was recorded from: its epics with their commits in rank order and their notes,
 * and main's commits in order. `replay(intentsOf(seedFrom(h))).history` is `h` again for every bootstrapped `h`.
 */
export function seedFrom(repository: string, history: History): Seed {
  const titles = new Map(history.commits.map((commit) => [commit.id, commit.title]))
  return {
    repository,
    main: history.main,
    epics: history.epics.map((epic) => ({
      id: epic.id,
      title: epic.title,
      commits: history.commits
        .filter((commit) => commit.epic === epic.id)
        .sort((a, b) => a.rank - b.rank)
        .map((commit) => ({ id: commit.id, title: commit.title, notes: commit.notes.map((note) => ({ section: note.section, text: note.text })) })),
    })),
    real: history.real.map((real) => ({
      sha: real.sha,
      change: real.change,
      title: real.title === titles.get(real.mythical) ? "" : real.title,
      into: real.mythical,
    })),
  }
}
