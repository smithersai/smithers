// The bootstrap of a mythical history from a project's real history (wiki/decisions/0020-mythical-history.md): main's
// first-parent commits and the merge queue's entries become epics, mythical commits and their notes. Pure and
// deterministic, so the generator (scripts/mythical-seed.vibe) and the tests run the same grouping.
//
//   real commits ──group──▶ mythical commits ──areaOf──▶ epics         one landed queue entry is one mythical commit;
//   queue entries ──notes──▶ tried / evidence                          regenerated docs and reverts fold into theirs
//
// `intentsOf` turns a seed into the history machine's intents (mythical.vibe), which the Bootstrap flow records.
import { apply, decideWithinCapacity, empty, type History, type Intent, MAX_NOTE, MAX_TITLE, type Section } from "./mythical.vibe"
import { pairCut } from "./stackDecision.vibe"

/** A commit reachable from main, as the generator reads it; `parents` first parent first. */
export interface RawCommit {
  readonly sha: string
  readonly change: string
  readonly description: string
  readonly parents: ReadonlyArray<string>
}

/** A reachable commit and the first-parent commit of main that brought it in: itself, or the merge that did. */
export interface Bucketed {
  readonly commit: RawCommit
  readonly step: string
}

/**
 * Every commit reachable from main's tip, each with the first-parent step that introduced it (Sol's buckets): a
 * merge's side commits belong to the merge. Oldest step first; inside a step, its side commits (oldest first) and then
 * the step itself. `commits` is every reachable commit, the tip last, parents before children.
 */
export function bucketsOf(commits: ReadonlyArray<RawCommit>): ReadonlyArray<Bucketed> {
  const tip = commits[commits.length - 1]
  if (tip === undefined) return []
  const bySha = new Map(commits.map((commit) => [commit.sha, commit]))
  const index = new Map(commits.map((commit, at) => [commit.sha, at]))
  const spine: Array<RawCommit> = []
  for (let at: RawCommit | undefined = tip; at !== undefined; at = bySha.get(at.parents[0] ?? "")) spine.push(at)
  spine.reverse()
  const seen = new Set<string>()
  const buckets: Array<Bucketed> = []
  for (const step of spine) {
    // The commits this step brought in: its side ancestry not already reachable from an earlier step.
    const side: Array<RawCommit> = []
    const stack = step.parents.slice(1)
    while (stack.length > 0) {
      const sha = stack.pop()!
      const commit = bySha.get(sha)
      if (commit === undefined || seen.has(sha) || spine.includes(commit)) continue
      seen.add(sha)
      side.push(commit)
      stack.push(...commit.parents)
    }
    side.sort((a, b) => index.get(a.sha)! - index.get(b.sha)!)
    for (const commit of side) buckets.push({ commit, step: step.sha })
    seen.add(step.sha)
    buckets.push({ commit: step, step: step.sha })
  }
  return buckets
}

/**
 * A merge queue entry, as the generator reads it: the titles of the commits it carried and what became of them. The
 * queue lands copies under new change ids, so a commit on main finds its entries by title.
 */
export interface QueueEntry {
  readonly id: string
  readonly lane: string
  readonly state: string
  readonly reason: string
  readonly gate: string
  readonly titles: ReadonlyArray<string>
}

/** One note line of a seeded commit. */
export interface SeedNote {
  readonly section: Section
  readonly text: string
}

/** A seeded mythical commit. */
export interface SeedCommit {
  readonly id: string
  readonly title: string
  readonly notes: ReadonlyArray<SeedNote>
}

/** A seeded epic and its commits, in stack order. */
export interface SeedEpic {
  readonly id: string
  readonly title: string
  readonly commits: ReadonlyArray<SeedCommit>
}

/** A real commit and the mythical commit it folds into; `title` is `""` when it is the mythical commit's own. */
export interface SeedReal {
  readonly sha: string
  readonly change: string
  readonly title: string
  readonly into: string
}

/** A whole bootstrap: the epics in stack order and main's commits in main's order. */
export interface Seed {
  readonly repository: string
  readonly main: string
  readonly epics: ReadonlyArray<SeedEpic>
  readonly real: ReadonlyArray<SeedReal>
}

/** How many hex digits of a commit id the history keeps, as the merge queue does. */
export const SHA_LENGTH = 12

/** How many letters of a jj change id the history keeps. */
export const CHANGE_LENGTH = 12

/** The most note lines of each kind a seeded commit gets. */
export const MAX_SEED_NOTES = 4

/** The most characters a seeded note line holds. */
export const MAX_SEED_NOTE = 300

/** An epic of the bootstrap and the scopes (`type(scope):` or `scope:`) whose commits it tells. */
export interface Area {
  readonly title: string
  readonly scopes: ReadonlyArray<string>
}

/** The epics, by what part of VibeLang they tell. A commit whose scope none names goes to `Foundations`. */
