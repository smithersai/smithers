//@ ensures history.seq < 0 || history.seq >= 9007199254740991 ==> !\result.ok && \result.refusal == "full"
export function decideWithinCapacity(history: History, intent: Intent): Decision {
  if (history.seq < 0 || history.seq >= 9007199254740991) return refused("full")
  //@ assert 0 <= history.seq && history.seq < 9007199254740991
  return decide(history, intent)
}

/** Replay accepts a full safe snapshot; every validated event is then stale and leaves it unchanged.
 */
//@ verify
//@ requires 0 <= event.seq && event.seq <= 9007199254740991
//@ requires 0 <= history.seq && history.seq <= 9007199254740991
//@ ensures \result.seq == history.seq || \result.seq == history.seq + 1
//@ ensures event.seq != history.seq + 1 ==> \result == history
//@ ensures event.seq == history.seq + 1 ==> \result.seq == event.seq
//@ ensures \result.epics.length >= history.epics.length && forall(i, 0 <= i && i < history.epics.length ==> \result.epics[i] == history.epics[i])
