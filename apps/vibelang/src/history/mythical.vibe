//@ ensures 0 <= history.seq && history.seq < 9007199254740991 ==> (intent.type == "AddNote" && !(intent.text.trim() == "" || intent.by == "") && (intent.text.trim().length > MAX_NOTE || intent.by.length > MAX_TITLE) ==> !\result.ok && \result.refusal == "too-long")
//@ ensures 0 <= history.seq && history.seq < 9007199254740991 ==> (intent.type == "AddNote" && !(intent.text.trim() == "" || intent.by == "") && !(intent.text.trim().length > MAX_NOTE || intent.by.length > MAX_TITLE) && (intent.id == "" || !(exists(i, 0 <= i && i < history.commits.length && history.commits[i].id == intent.id))) ==> !\result.ok && \result.refusal == "unknown")
