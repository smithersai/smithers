// The live mythical history: `Mythical` over the API Worker's History object (wire.vibe;
// wiki/decisions/0020-mythical-history.md), through Effect's `HttpClient`, so the browser, the CLI and the MCP server
// share it. Who asks is the server's to know from the request; nothing here says it.
import * as Sse from "effect/encoding/Sse"
import { HttpClient, HttpClientRequest, type HttpClientResponse } from "effect/http"
import type { Mode } from "../core/Factory.vibe"
import { historyResponse } from "./flowMachine.vibe"
import { Mythical, Refused, Unavailable } from "./MythicalHistory.vibe"
import type { PageRequest } from "./pages.vibe"
import { CommitPage, EpicPage, HistoryEvent, Matches, Outline } from "./schemas.vibe"
import { HISTORY_PATH, HistoryRefusal, pathOf, Written } from "./wire.vibe"

const decodeEvent = Schema.decodeUnknownEffect(Schema.fromJsonString(HistoryEvent))
const decodeWritten = Schema.decodeUnknownEffect(Written)
const decodeRefusal = Schema.decodeUnknownEffect(HistoryRefusal)

/** `Unavailable`, naming what failed; never a response body. */
function unavailable(what: string) {
  return () => new Unavailable({ reason: what })
}

/** The history at `origin`, such as `https://vibelang.smithers.sh`. Each call is one request. */
export function LiveMythical(origin: string) {
  return Layer.effect(Mythical, effect {
    const client = try HttpClient.HttpClient

    /** Posts `body` to the write `write`: what it wrote, or its refusal as `Refused`. */
    effect function write(name: string, body: object, operation?: string) {
      // Trusted agent replay uses HistoryObject.readerOver; public HTTP does not accept its private identity.
      if (operation !== undefined) throw new Unavailable({ reason: "history replay unavailable" })
      const request = HttpClientRequest.post(`${origin}${HISTORY_PATH}/${name}`).pipe(HttpClientRequest.bodyJsonUnsafe(body))
      const response: HttpClientResponse.HttpClientResponse = try Effect.mapError(client.execute(request), unavailable(`${name} unreachable`))
      const json = try Effect.mapError(response.json, unavailable(`${name} is not JSON`))
      const outcome = historyResponse(response.status)
      if (outcome === "accepted") return try Effect.mapError(decodeWritten(json), unavailable(`${name} is not the protocol`))
      if (outcome === "refused") {
        const refused = try Effect.mapError(decodeRefusal(json), unavailable(`${name} refusal is not the protocol`))
        throw new Refused({ refusal: refused.refusal })
      }
      throw new Unavailable({ reason: `${name} answered ${response.status}` })
    }

    /** Reads the page `request` names, decoded by `schema`. */
    effect function page<S extends Schema.Top>(request: PageRequest, schema: S) {
      const what = `history ${request.what}`
      const path = pathOf(request)
      if (path === undefined) throw new Unavailable({ reason: "history path invalid" })
      const response = try Effect.mapError(client.get(origin + path), unavailable(`${what} unreachable`))
      if (response.status !== 200) throw new Unavailable({ reason: `${what} answered ${response.status}` })
      const body = try Effect.mapError(response.json, unavailable(`${what} is not JSON`))
      return try Effect.mapError(Schema.decodeUnknownEffect(schema)(body), unavailable(`${what} is not the protocol`))
    }

    const mode: Mode = "live"
    const service: Mythical.Shape = {
      mode,
      outline: () => page({ what: "outline" }, Outline),
      epic: (id, from) => page({ what: "epic", id, from }, EpicPage),
      commit: (id) => page({ what: "commit", id }, CommitPage),
      search: (query) => page({ what: "search", query }, Matches),
      events: (after) =>
        Stream.unwrap(effect {
          const request = HttpClientRequest.get(`${origin}${HISTORY_PATH}/events?after=${after}`).pipe(
            HttpClientRequest.setHeader("accept", "text/event-stream"),
          )
          const response = try Effect.mapError(client.execute(request), unavailable("history events unreachable"))
          if (response.status !== 200) throw new Unavailable({ reason: `history events answered ${response.status}` })
          return response.stream.pipe(
            Stream.decodeText(),
            Stream.pipeThroughChannel(Sse.decode()),
            Stream.mapEffect((message) => decodeEvent(message.data)),
            Stream.mapError(unavailable("history events interrupted")),
          )
        }),
      plan: effect (request, operation?: string) => (try write("plan", request, operation)).id,
      start: effect (id, lane, operation?: string) => {
        try write("start", { id, lane }, operation)
      },
      note: effect (id, section, text, operation?: string) => {
        try write("note", { id, section, text }, operation)
      },
      approve: effect (id) => {
        try write("approve", { id })
      },
      fold: effect () => (try write("fold", {})).folded,
    }
    return service
  })
}
