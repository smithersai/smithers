anded\",\"task\":\"\",\"lane\":\"\",\"notes\":[{\"section\":\"evidence\",\"text\":\"Landed by the merge queue from lane fix-rev-ts-shim through mq-11061435-14 (matched by title).\",\"by\":\"bootstrap\"},{\"section\":\"evidence\",\"text\":\"Before: effect functions fail with the stock parser in all four native extensions. After: seven buffer tests and thirteen LSP formatter tests pass, including twenty generated twin/idempotence checks, JSX, unsaved changes, and unmarked TypeScript controls.\",\"by\":\"bootstrap\"}]},{\"id\":\"m2949\",\"epic\":\"e4\",\"rank\":1917,\"title\":\"test(sourcemaps): reject missing mappings for written tokens\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[{\"section\":\"evidence\",\"text\":\"Landed by the merge queue from lane fuzz-fix-rev-sourcemaps through mq-11061530-18 (matched by title).\",\"by\":\"bootstrap\"}]},{\"id\":\"m2950\",\"epic\":\"e4\",\"rank\":1918,\"title\":\"fix(compiler): use project Effect for concurrent traversal\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[{\"section\":\"evidence\",\"text\":\"Landed by the merge queue from lane impl-hunt-run through mq-11061530-18 (matched by title).\",\"by\":\"bootstrap\"}]},{\"id\":\"m2951\",\"epic\":\"e4\",\"rank\":1919,\"title\":\"fix(parser): accept line breaks inside try operations\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[{\"section\":\"evidence\",\"text\":\"Landed by the merge queue from lane impl-hunt-run through mq-11061530-18 (matched by title).\",\"by\":\"bootstrap\"}]},{\"id\":\"m2952\",\"epic\":\"e4\",\"rank\":1920,\"title\":\"fix(parser): compile array pattern holes in lowered binding heads\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[{\"section\":\"evidence\",\"text\":\"Landed by the merge queue from lane impl-hunt-admission through mq-11061553-19 (matched by title).\",\"by\":\"bootstrap\"}]},{\"id\":\"m2953\",\"epic\":\"e4\",\"rank\":1921,\"title\":\"fix(compiler): narrow by built-in extractors and r