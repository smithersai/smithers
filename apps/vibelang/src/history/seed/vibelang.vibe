ne\":\"\",\"notes\":[]},{\"id\":\"m1608\",\"epic\":\"e4\",\"rank\":576,\"title\":\"fix(compiler): give tagged templates their tag's trusted failures\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1609\",\"epic\":\"e4\",\"rank\":577,\"title\":\"fix(compiler): read each part of a match subject once\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1610\",\"epic\":\"e4\",\"rank\":578,\"title\":\"fix(compiler): keep code an exhaustive last arm's pattern runs\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1611\",\"epic\":\"e4\",\"rank\":579,\"title\":\"fix(compiler): plan wire calls by their resolved callee and listed spreads\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1612\",\"epic\":\"e4\",\"rank\":580,\"title\":\"test(checker): more service default cases\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1613\",\"epic\":\"e4\",\"rank\":581,\"title\":\"fix(compiler): declare services inside namespaces with their key type\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1614\",\"epic\":\"e4\",\"rank\":582,\"title\":\"fix(compiler): recognize Effect pipe by its resolved symbol\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1615\",\"epic\":\"e4\",\"rank\":583,\"title\":\"fix(compiler): choose a hatch's sync or promise form only when the type proves it\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1616\",\"epic\":\"e4\",\"rank\":584,\"title\":\"fix(compiler): recognize built-in pattern matchers by resolved symbol\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1617\",\"epic\":\"e4\",\"rank\":585,\"title\":\"fix(compiler): count catch-binding defaults in the try statement's contract\",\"state\":\"landed\",\"task\":\"\",\"lane\":\"\",\"notes\":[]},{\"id\":\"m1618\",\"epic\":\"e4\",\"rank\":586,\"title\":\"fix(compiler): join