// The mythical history with no backend and no model (wiki/decisions/0020-mythical-history.md, 0004): the real sequencer
// over a store in memory, the same flows on `@smthrs/engine`'s engine in memory, bootstrapped from the same snapshot
// the live History object loads (seed/vibelang.vibe, downloaded only when the mock is built). Its main is the merge
// queue played by the mock: every approved commit lands on main as a real commit whose message names it, after the real
// commits that reached VibeLang's main from outside the queue since the snapshot (`AFTER_SEED`). Its repository
// is `@smthrs/jj`'s memory repository, holding each commit of that main with a tree of its own, so an export runs
// whole with no backend.
import { WebCrypto } from "@smthrs/crypto"
import { FlowEngine } from "@smthrs/engine"
import { FlowRuntime } from "@smthrs/flow"
import { Repository } from "@smthrs/jj"
import { Digest } from "effect/crypto"
import type { Mode } from "../core/Factory.vibe"
import { REF_NAMES } from "./export.vibe"
import { Approve, Bootstrap, Export, exportRegistration, ExportTarget, Fold, historyRegistration, MainLog, Note, Plan, Stack, Start } from "./flows.vibe"
import { History as HistorySchema } from "./schemas.vibe"
import type { History, Real } from "./mythical.vibe"
import { Mythical, settled } from "./MythicalHistory.vibe"
import { commitPageOf, epicPageOf, matchesOf, outlineOf } from "./pages.vibe"
import { Caller, type Principal } from "./roles.vibe"
import { make, memoryStore, type MainCommit, type Sequencer, stackOf } from "./Sequencer.vibe"
import { approvedIndices, commitSource, executionKey, landedCommit, madeMessage, mainFile } from "./mockMainDecision.vibe"

/** The bootstrapped history the live History object loads, decoded. */
export effect function seeded() {
  const { HISTORY_JSON } = try promise(() => import("./seed/vibelang.vibe"))
  return try Effect.orDie(Schema.decodeUnknownEffect(Schema.fromJsonString(HistorySchema))(HISTORY_JSON))
}

/** The id the mock's merge queue gives the real commit that lands mythical commit `id` (proved in mockMainDecision). */
export { landedSha } from "./mockMainDecision.vibe"

/**
 * Real commits of VibeLang's main after the seed's snapshot that carry no `Mythical:` trailer, as most of its history
 * does (0020), in main's order, oldest first, as `MainLog.since` reads them: a Fold files each under the epic its
 * title's scope names (`areaOf`), or `Foundations`. Each is recorded whole from github.com/smithersai/vibelang's main
 * with `jj log -r <sha> -T description` (2026-11-13), so a Fold reads every title shape main holds after the snapshot
 * (`type(scope):`, `type(scope, more):`, a bare `type:` and an emoji first) and every last paragraph: prose, a trailer,
 * and prose whose first line reads as a trailer key.
 */
export const AFTER_SEED: ReadonlyArray<MainCommit> = [
  { sha: "0c6cea2cde78", change: "omuptzumoqml", title: "📝 docs(vips): add VIP-43, theorem and spec, as open", message: "📝 docs(vips): add VIP-43, theorem and spec, as open\n\nLists a proposal for a decision. It changes no compiler behavior and no existing code. Each sentence has a pending witness, because nothing is implemented.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n" },
  { sha: "0c40c2c6e9a0", change: "snpryryqvkrx", title: "docs(terminal): distinguish line input from raw key events", message: "docs(terminal): distinguish line input from raw key events\n" },
  { sha: "0121839c9be7", change: "zwmwmsyukorp", title: "fix(cli): fail compilation when interrupted", message: "fix(cli): fail compilation when interrupted\n\nA cancelled command context could still produce a successful status after\nchecking, emission or build mode finished. Keep existing failure statuses\nand reject success after cancellation, with an explicit diagnostic.\n\nAdd a synchronized native-CLI regression and fuzz seeds for checking,\nemission, fixes and build mode under SIGINT and SIGTERM. The regression\nreproduces six false-success outcomes before the fix. Stock tsc passes the\noriginal TypeScript source and terminates with SIGTERM when interrupted.\n\nUpdate the CLI guide, release notes and generated site pages.\n\nValidation: synchronized CLI cases and fuzz seeds pass; a short campaign\ncompleted 75 executions. Vet, forms regeneration, the install end-to-end\ntest, and two clean migrations with all 58 upstream tests pass.\n" },
  { sha: "301689a33565", change: "nqvmoolynsxq", title: "fix(compiler): preserve reverse-mapped declaration cycle structure", message: "fix(compiler): preserve reverse-mapped declaration cycle structure\n\nVIP-27 retains TypeScript 5.9/7.0 anonymous cycle serialization. Detect cycles in reconstructed reverse mappings before printing them, preserving historical property placeholders and traversal. Finite mappings, including a cyclic input whose recursive key is excluded, retain current TypeScript output. Cache entries distinguish the paths; existing expansion bounds are unchanged.\n\nThe unchanged TypeScript twin compiled with TypeScript 7.0.2 exits 0 and emits complete declarations with /*elided*/ any. Pinned TypeScript 7.1.0-beta reports TS5088 for the inferred make and entry declarations.\n\nAdd exact TS/Vibe declaration fixtures, exported/local wrapper fuzz seeds and keyed corpus, eleven finite mapping controls, and baseline receipts identifying output sizes and mismatched emit guards.\n" },
  { sha: "ba26e8a1ade9", change: "mzrmptwprsnk", title: "fix(docs,release): documented dprint.json passes on a built starter", message: "fix(docs,release): documented dprint.json passes on a built starter\n\nThe dprint.json in docs/user/src/setup/formatting.md failed `dprint check`\n(exit 20) on any project after its first build: the compiler writes\nx.d.vibe.ts and a forwarding x.d.ts beside each .vibe source in\nTypeScript's declaration style, and the config formatted them. The\nguide's config and the vibelang README's copy now exclude **/*.d.ts,\n**/*.d.vibe.ts and **/*.d.vibex.ts, and the guide says why.\n\nEmitting declarations already in the formatter's style is not possible:\nthe style is the project's dprint settings (semicolons, quotes, width),\nwhich the compiler does not read, and every build rewrites the files.\n\nThe release rehearsal hid the defect: scripts/release/check-app.sh wrote\nits own dprint.json (src/**/*.{vibe,vibex} only, TypeScript plugin\n0.93.4) and ran it before the first build. It now extracts the guide's\njson block byte for byte and runs `dprint check` after build and test, on\nevery package manager it rehearses.\n\nTest: scripts/release/check-app-format.test.mjs gains, per manager, a\ncheck that dprint runs the guide's config after `run build` and\n`run test`, and a check that a guide without the block fails the\nrehearsal. Without the check-app.sh change 5 of 27 fail; with it 27 pass.\nOn a built starter the guide's old config exits 20 with 6 generated\nfiles; the new config exits 0.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n" },
  { sha: "47422f47d257", change: "upuoqwuuskmu", title: "docs: clarify experimental opt-in support boundary", message: "docs: clarify experimental opt-in support boundary\n\nState the support boundary and bound EK3013 guarantees to observed direct forms. Document union and namespace-derived value aliases, asserted keys and inline TypeScript module bridges, including Durable-engine execution; retain erased type and foreign bridge examples.\n\nDescribe 0.0.13 tarball behavior under VIP-30 and VIP-40 without changing compiler semantics. Preserve whole-namespace enumeration in the future-release wording. Add source and generated-page assertions for the boundary and observed routes.\n" },
]

/** The mock's main: the `outside` commits, then each approved commit, oldest first, its message naming it. */
export function mockMain(sequencer: Sequencer, outside: ReadonlyArray<MainCommit> = []): MainLog.Shape {
  return {
    since: () => Effect.map(sequencer.read(), (history): ReadonlyArray<MainCommit> => [
      ...outside,
      ...approvedIndices(history.commits).map((index) => landedCommit(history.commits[index]!.id, history.commits[index]!.title)),
    ]),
  }
}

/**
 * The mock's repository: memory, where each commit of the mock's main resolves by its id to a commit whose tree holds
 * one file naming it, so every real commit has a tree of its own and an export can check it.
 */
export function mockRepository(sequencer: Sequencer): Repository.Repository {
  const memory = Repository.makeMemory()
  const indexed = new WeakMap<History, Map<string, Real>>()
  const made = new Map<string, Repository.CommitHeader>()
  effect function readCommit(revision: string) {
    const history = try sequencer.read()
    const known = indexed.get(history) ?? new Map(history.real.map((real) => [real.sha, real]))
    indexed.set(history, known)
    const real = known.get(revision)
    const kept = real === undefined ? undefined : made.get(real.sha)
    const source = commitSource(real !== undefined, kept !== undefined)
    if (source === "memory" || real === undefined) return try memory.readCommit(revision)
    if (source === "kept" && kept !== undefined) return kept
    const blob = try memory.writeBlob(mainFile(real.sha, real.title))
    const tree = try memory.writeTree([{ name: "MAIN", mode: "100644", oid: blob }])
    const header: Repository.CommitHeader = { oid: real.sha, tree, parents: [], message: madeMessage(real.title) }
    made.set(real.sha, header)
    return header
  }
  return Repository.make({ ...memory, readCommit })
}

effect function digestOf() {
  provide WebCrypto.layer {
    return try Digest.Digest
  }
}

/** The services the mock's flows run on: its sequencer, its main, its repository and where an export writes. */
export interface MockWiring {
  readonly stack: Stack.Shape
  readonly main: MainLog.Shape
  readonly repository: Repository.Repository
  readonly target: ExportTarget.Shape
}

/**
 * The mock history for `principal`, bootstrapped from `seed` (the real one by default). Its main holds `outside`
 * before the approved commits: `AFTER_SEED` with the real seed, none with another. `wire` answers the services its
 * flows run on from the mock's own; a test injects a faulty one there (test/support/FaultyMockHistory.vibe).
 */
export function MockMythical(principal: Principal, seed: () => History!! = seeded, current?: () => Principal!!, outside: ReadonlyArray<MainCommit> = seed === seeded ? AFTER_SEED : [], wire: (mock: MockWiring) => MockWiring = (mock) => mock) {
  return Layer.effect(Mythical, effect {
    const sequencer = try make(try memoryStore())
    const digest = try digestOf()
    const executions = try Ref.make(0)
    const wired = wire({ stack: stackOf(sequencer, seed), main: mockMain(sequencer, outside), repository: mockRepository(sequencer), target: { names: REF_NAMES } })
    const flows = Layer.mergeAll(historyRegistration, exportRegistration).pipe(
      Layer.provideMerge(FlowEngine.layerMemory),
      Layer.provide(Layer.mergeAll(
        Layer.succeed(Stack, wired.stack),
        Layer.succeed(MainLog, wired.main),
        Layer.succeed(Caller, { principal, ...(current === undefined ? {} : { current }) }),
        Layer.succeed(Repository.Repository, wired.repository),
        Layer.succeed(ExportTarget, wired.target),
      )),
      Layer.provide(Layer.succeed(Digest.Digest, digest)),
    )
    const engine = Context.get(try Layer.build(flows), FlowRuntime.FlowRuntime)

    effect function executionId(prefix: string, operation?: string) {
      // Only an operation's id reads the digest, and only a counted one advances the count.
      const hex = operation === undefined ? "" : try digest.digestHex(Digest.sha256, new TextEncoder().encode(JSON.stringify([prefix, operation])))
      const count = operation === undefined ? `${try Ref.updateAndGet(executions, (value) => value + 1)}` : ""
      return executionKey(prefix, operation, hex, count)
    }

    // The first start loads the bootstrapped history, as the live object's does.
    try Effect.orDie(engine.execute(Bootstrap, { executionId: try executionId("bootstrap"), payload: {} }))

    /** A page of the history now, computed where it lives, as the History object does. */
    function paged<A>(page: (history: History) => A) {
      return Effect.map(sequencer.read(), page)
    }

    const mode: Mode = "mock"
    const service: Mythical.Shape = {
      mode,
      outline: () => paged(outlineOf),
      epic: (id, from) => paged((history) => epicPageOf(history, id, from)),
      commit: (id) => paged((history) => commitPageOf(history, id)),
      search: (query) => paged((history) => matchesOf(history, query)),
      events: (after) => sequencer.follow(after),
      plan: effect (request, operation?: string) => {
        return try settled(try Effect.orDie(engine.execute(Plan, { executionId: try executionId("plan", operation), payload: request })))
      },
      start: effect (id, lane, operation?: string) => {
        try settled(try Effect.orDie(engine.execute(Start, { executionId: try executionId("start", operation), payload: { id, lane } })))
      },
      note: effect (id, section, text, operation?: string) => {
        try settled(try Effect.orDie(engine.execute(Note, { executionId: try executionId("note", operation), payload: { id, section, text } })))
      },
      approve: effect (id) => {
        try settled(try Effect.orDie(engine.execute(Approve, { executionId: try executionId("approve"), payload: { id } })))
      },
      fold: effect () => {
        const answer = try Effect.orDie(engine.execute(Fold, { executionId: try executionId("fold"), payload: {} }))
        try settled({ id: "", refusal: answer.refusal })
        return answer.folded
      },
      publish: effect () => {
        const answer = try Effect.orDie(engine.execute(Export, { executionId: try executionId("export"), payload: {} }))
        try settled({ id: "", refusal: answer.refusal })
        return { mythical: answer.mythical, written: answer.written }
      },
    }
    return service
  })
}
