// Which paragraph of a commit message is its trailer and which mythical commit it names (0018, third-lane batches 24
// and 25). `Sequencer.vibe` trailerOf calls trailerName on the message's lines trimmed at the end; the split into lines
// and the trim stay outside the proof.

/** A trailer line: a `Key:` line, or after the first one a line continuing the one before (a space or a tab). */
//@ verify
//@ ensures \result == (\matches("^[A-Za-z0-9][A-Za-z0-9-]*:", line) || (at > 0 && \matches("^[ \\t]", line)))
//@ ensures line == "" ==> !\result
export function trailerLine(line: string, at: number): boolean {
  return /^[A-Za-z0-9][A-Za-z0-9-]*:/.test(line) || (at > 0 && /^[ \t]/.test(line))
}

/** Every line of the paragraph is a trailer line: the message's trailer, if it is its last paragraph. */
//@ verify
//@ ensures \result == forall(i, 0 <= i && i < lines.length ==> trailerLine(lines[i], i))
export function trailerParagraph(lines: ReadonlyArray<string>): boolean {
  let i = 0
  while (i < lines.length) {
    //@ invariant 0 <= i && i <= lines.length
    //@ invariant forall(k, 0 <= k && k < i ==> trailerLine(lines[k], k))
    //@ decreases lines.length - i
    if (!trailerLine(lines[i]!, i)) return false
    i += 1
  }
  return true
}

/** A decimal digit's UTF-16 code unit. */
//@ verify
//@ ensures \result == (48 <= unit && unit <= 57)
export function digitUnit(unit: number): boolean {
  return 48 <= unit && unit <= 57
}

/** Where the digits that end the first `end` units of `line` start: `end` when the unit before it is no digit. */
//@ verify
//@ requires 0 <= end && end <= line.length
//@ decreases end
//@ ensures 0 <= \result && \result <= end
//@ ensures forall(i, \result <= i && i < end ==> digitUnit(line.charCodeAt(i)))
//@ ensures \result == 0 || !digitUnit(line.charCodeAt(\result - 1))
export function digitsStart(line: string, end: number): number {
  if (end === 0 || !digitUnit(line.charCodeAt(end - 1))) return end
  return digitsStart(line, end - 1)
}

/**
 * The mythical commit a trailer line names: the line is `Mythical:`, spaces and `m<digits>`, whole, and the name is
 * the `m` and the digits that end it (no other suffix of the line has that form); `""` for any other line.
 */
//@ verify
//@ ensures \result != "" ==> \matches("^Mythical:\\s*m\\d+$", line)
//@ ensures \result != "" ==> \result.length >= 2 && \result.charCodeAt(0) == 109 && line.endsWith(\result)
//@ ensures \result != "" ==> forall(i, 1 <= i && i < \result.length ==> digitUnit(\result.charCodeAt(i)))
//@ ensures !\matches("^Mythical:\\s*m\\d+$", line) ==> \result == ""
export function mythicalNameSpec(line: string): string {
  // The name's shape first: every line the pattern matches has it, but the proof does not read the pattern.
  const at = digitsStart(line, line.length)
  if (at < 1 || at === line.length || line.charCodeAt(at - 1) !== 109 || !/^Mythical:\s*m\d+$/.test(line)) return ""
  return line.slice(at - 1)
}

/** Where the text of the first `end` lines ends: after the last nonblank one, 0 when all are blank. */
//@ verify
//@ requires 0 <= end && end <= lines.length
//@ decreases end
//@ ensures 0 <= \result && \result <= end
//@ ensures \result == 0 || lines[\result - 1] != ""
//@ ensures forall(i, \result <= i && i < end ==> lines[i] == "")
export function textEnd(lines: ReadonlyArray<string>, end: number): number {
  if (end === 0 || lines[end - 1] !== "") return end
  return textEnd(lines, end - 1)
}

/**
 * Where the last paragraph up to line `from` starts, looking down to line 2: the last nonblank line after a blank line
 * that has a line before it (two line breaks in a row). -1 when there is none: one paragraph.
 */
//@ verify
//@ decreases from + 1
//@ ensures \result == -1 || (2 <= \result && \result <= from && \result < lines.length && lines[\result - 1] == "" && lines[\result] != "")
//@ ensures from < lines.length ==> forall(s, 2 <= s && s <= from && s > \result ==> !(lines[s - 1] == "" && lines[s] != ""))
export function paragraphStart(lines: ReadonlyArray<string>, from: number): number {
  if (from < 2 || from >= lines.length) return -1
  if (lines[from - 1] === "" && lines[from] !== "") return from
  return paragraphStart(lines, from - 1)
}

/** The first line from `at` before `end` that names a mythical commit, or -1. */
//@ verify
//@ decreases end - at
//@ ensures \result == -1 || (at <= \result && \result < end && 0 <= \result && \result < lines.length && mythicalNameSpec(lines[\result]) != "")
//@ ensures 0 <= at && end <= lines.length ==> forall(i, at <= i && i < end && (\result == -1 || i < \result) ==> mythicalNameSpec(lines[i]) == "")
export function firstNamed(lines: ReadonlyArray<string>, at: number, end: number): number {
  if (at < 0 || at >= end || at >= lines.length) return -1
  if (mythicalNameSpec(lines[at]!) !== "") return at
  return firstNamed(lines, at + 1, end)
}

/** The name line `at` gives, `""` past the lines. */
//@ verify
//@ ensures \result == (0 <= at && at < lines.length ? mythicalNameSpec(lines[at]) : "")
export function nameAt(lines: ReadonlyArray<string>, at: number): string {
  return 0 <= at && at < lines.length ? mythicalNameSpec(lines[at]!) : ""
}

/** Where the last paragraph of a message's lines starts, -1 when it has one paragraph. */
//@ verify
//@ ensures \result == paragraphStart(lines, textEnd(lines, lines.length) - 1)
//@ ensures \result == -1 || (2 <= \result && \result < textEnd(lines, lines.length))
export function lastParagraph(lines: ReadonlyArray<string>): number {
  return paragraphStart(lines, textEnd(lines, lines.length) - 1)
}

/**
 * The mythical commit a message names, from its lines trimmed at the end: the first `Mythical:` line of its last
 * paragraph, when a paragraph comes before that one and every line of it is a trailer line; else `""`.
 */
//@ verify
//@ ensures lastParagraph(lines) == -1 ==> \result == ""
//@ ensures lastParagraph(lines) >= 0 && !forall(i, lastParagraph(lines) <= i && i < textEnd(lines, lines.length) && i < lines.length ==> trailerLine(lines[i], i - lastParagraph(lines))) ==> \result == ""
//@ ensures lastParagraph(lines) >= 0 && forall(i, lastParagraph(lines) <= i && i < textEnd(lines, lines.length) && i < lines.length ==> trailerLine(lines[i], i - lastParagraph(lines))) ==> \result == nameAt(lines, firstNamed(lines, lastParagraph(lines), textEnd(lines, lines.length)))
export function trailerName(lines: ReadonlyArray<string>): string {
  const start = findLastParagraph(lines)
  if (start < 0) return ""
  const end = findTextEnd(lines, lines.length)
  if (!trailerParagraph(lines.slice(start, end))) return ""
  return readNameAt(lines, findFirstNamed(lines, start, end))
}


/** The trailing-digit specification executed as a loop. */
//@ verify
//@ requires 0 <= end && end <= line.length
//@ ensures \result == digitsStart(line, end)
//@ ensures 0 <= \result && \result <= end
//@ ensures forall(i, \result <= i && i < end ==> digitUnit(line.charCodeAt(i)))
//@ ensures \result == 0 || !digitUnit(line.charCodeAt(\result - 1))
export function findDigitsStart(line: string, end: number): number {
  let i = end
  while (i > 0 && digitUnit(line.charCodeAt(i - 1))) {
    //@ invariant 0 <= i && i <= end
    //@ invariant digitsStart(line, end) == digitsStart(line, i)
    //@ invariant forall(k, i <= k && k < end ==> digitUnit(line.charCodeAt(k)))
    //@ decreases i
    i = i - 1
  }
  return i
}

/** The native capture with its unbounded digit run executed as a loop. */
//@ verify
//@ ensures \result == mythicalNameSpec(line)
//@ ensures \result != "" ==> \matches("^Mythical:\\s*m\\d+$", line)
//@ ensures \result != "" ==> \result.length >= 2 && \result.charCodeAt(0) == 109 && line.endsWith(\result)
//@ ensures \result != "" ==> forall(i, 1 <= i && i < \result.length ==> digitUnit(\result.charCodeAt(i)))
export function mythicalName(line: string): string {
  // The name's shape first: every line the pattern matches has it, but the proof does not read the pattern.
  const at = findDigitsStart(line, line.length)
  if (at < 1 || at === line.length || line.charCodeAt(at - 1) !== 109 || !/^Mythical:\s*m\d+$/.test(line)) return ""
  return line.slice(at - 1)
}

/** The trailing-blank specification executed as a loop. */
//@ verify
//@ requires 0 <= end && end <= lines.length
//@ ensures \result == textEnd(lines, end)
//@ ensures 0 <= \result && \result <= end
export function findTextEnd(lines: ReadonlyArray<string>, end: number): number {
  let i = end
  while (i > 0 && lines[i - 1] === "") {
    //@ invariant 0 <= i && i <= end
    //@ invariant textEnd(lines, end) == textEnd(lines, i)
    //@ decreases i
    i = i - 1
  }
  return i
}

/** The last paragraph start executed as a loop. */
//@ verify
//@ ensures \result == paragraphStart(lines, from)
//@ ensures \result == -1 || (2 <= \result && \result <= from && \result < lines.length)
export function findParagraphStart(lines: ReadonlyArray<string>, from: number): number {
  if (from < 2 || from >= lines.length) return -1
  let i = from
  while (i >= 2) {
    //@ invariant 1 <= i && i <= from && from < lines.length
    //@ invariant paragraphStart(lines, from) == paragraphStart(lines, i)
    //@ decreases i
    if (lines[i - 1] === "" && lines[i] !== "") return i
    i = i - 1
  }
  return -1
}

/** The last paragraph with both scans executed as loops. */
//@ verify
//@ ensures \result == lastParagraph(lines)
//@ ensures \result == -1 || (2 <= \result && \result < textEnd(lines, lines.length))
export function findLastParagraph(lines: ReadonlyArray<string>): number {
  const end = findTextEnd(lines, lines.length)
  return findParagraphStart(lines, end - 1)
}

/** The first name scan executed as a loop; each capture also uses its loop. */
//@ verify
//@ ensures \result == firstNamed(lines, at, end)
//@ ensures \result == -1 || (at <= \result && \result < end && 0 <= \result && \result < lines.length)
export function findFirstNamed(lines: ReadonlyArray<string>, at: number, end: number): number {
  if (at < 0 || at >= end || at >= lines.length) return -1
  let i = at
  while (i < end && i < lines.length) {
    //@ invariant 0 <= at && at <= i && i <= end && i <= lines.length
    //@ invariant firstNamed(lines, at, end) == firstNamed(lines, i, end)
    //@ decreases end - i
    if (mythicalName(lines[i]!) !== "") return i
    i = i + 1
  }
  return -1
}

/** The selected line's name with no recursive runtime scan. */
//@ verify
//@ ensures \result == nameAt(lines, at)
export function readNameAt(lines: ReadonlyArray<string>, at: number): string {
  return 0 <= at && at < lines.length ? mythicalName(lines[at]!) : ""
}
