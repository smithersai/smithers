// The mythical history's git export (wiki/decisions/0020-mythical-history.md, "The git export"): a strictly linear
// `mythical` bookmark, `refs/notes/mythical` and a manifest bookmark, derived from the history and written through
// `@smthrs/jj`'s `Repository` service, never a git command. `flows.vibe`'s `vibelang/history/Export` runs these four as
// journaled steps.
//
//   prepare  read the three refs and the last manifest; plan every commit; write the ones not yet written,
//            each note, the notes commit and the manifest                                    (objects only)
//   check    read back each new commit: one parent, the one before it; its tree the tree of its last folded
//            real commit, read from the repository, or its parent's for a reservation; a note for every commit
//   publish  one compare-and-swap of all three refs, each from the value prepare read          (refs)
//   confirm  read the refs: the candidate landed, nothing moved, or another writer won
//
// A planned, working or approved commit with nothing folded into it is an empty reservation: its tree is its
// parent's, so the bookmark's tree is always the tree of the last real commit it folds. The commits' author, committer
// and date are fixed, so the same history is the same commits, and preparing again writes nothing new.
import { Repository } from "@smthrs/jj"
import { chainEnds, commitVerdict, headerAgrees, kept, lastFolds, linkedTo, manifestChanged, moves, pacedOut, parentsOf, rewritesMythical, treeOrigin, type RefNames, type Refs, treeSource, waitsForTrees, writable, writesChange } from "./exportDecision.vibe"
import type { Commit, History, Real } from "./mythical.vibe"
import { stacked } from "./pages.vibe"

// Git's empty tree, read once at load. Vitest maps no coverage statement to a named import's member read inside a
// function, so another runtime's never-run copy of that read would count as the only, uncovered one.
const EMPTY_TREE = Repository.EMPTY_TREE

/** Where VibeLang's export lives in its repository. */
export const REF_NAMES: RefNames = {
  mythical: "refs/heads/mythical",
  notes: "refs/notes/mythical",
  manifest: "refs/heads/smithers/history",
}

/** Who every exported commit names as author and committer, and when: 2026-11-07, the day of decision 0020. */
export const EXPORTER: Repository.Person = { name: "VibeLang mythical history", email: "history@vibelang.smithers.sh", seconds: 1794009600 }

/** The manifest's one file. */
export const MANIFEST_FILE = "manifest.json"

/**
 * How an export spends a repository's write budget: at most `writes` objects and `reads` real commits' trees per batch,
 * and `pauseMs` between batches. `UNPACED` is one batch; the History object paces GitHub with `GITHUB_PACE`.
 */
export interface Pace {
  readonly writes: number
  readonly reads: number
  readonly pauseMs: number
}

/** Everything in one batch, with no pause: the memory repository's pace. */
export const UNPACED: Pace = { writes: Number.POSITIVE_INFINITY, reads: Number.POSITIVE_INFINITY, pauseMs: 0 }

/**
 * GitHub's pace: 60 content-creating requests, then 9 minutes, is 400 an hour and 60 a minute, under the secondary
 * limits GitHub documents (500 an hour, 80 a minute, no concurrent writes), leaving room for the token's other writes.
 * 300 tree reads a batch is 2,000 an hour, under the 5,000 primary limit.
 */
export const GITHUB_PACE: Pace = { writes: 60, reads: 300, pauseMs: 9 * 60_000 }

/** No ref: the value of a ref that does not exist. */
export const NONE: Refs = { mythical: "", notes: "", manifest: "" }

/**
 * The manifest a publication carries on its own bookmark: main as of the export, the two tips it names, and each
 * mythical commit in stack order as `[id, commit, real commit whose tree it takes or "", tree]`.
 */
export schema Manifest {
  readonly schema: 1
  readonly main: string
  readonly mythical: string
  readonly notes: string
  readonly commits: ReadonlyArray<readonly [string, string, string, string]>
}

const decodeManifest = Schema.decodeUnknownEffect(Schema.fromJsonString(Manifest))

/** A commit's message: its title, then the trailers that name it and its epic. */
export function messageOf(commit: Commit): string {
  return `${commit.title}\n\nMythical: ${commit.id}\nEpic: ${commit.epic}\n`
}

/** One section of a note: its heading, then a line per entry, or `(none)`. */
function section(heading: string, lines: ReadonlyArray<string>): string {
  return `${heading}\n${lines.length === 0 ? "(none)\n" : lines.map((line) => `- ${line}\n`).join("")}`
}

/** A commit's note: its state, then its four sections, as the view shows them; Folded lists the real commits it folds. */
export function noteOf(commit: Commit, folded: ReadonlyArray<Real>): string {
  const of = (kind: string) => commit.notes.filter((note) => note.section === kind).map((note) => `${note.text} (${note.by})`)
  return [
    `${commit.id} ${commit.state}\n`,
    section("Tried", of("tried")),
    section("Evidence", of("evidence")),
    section("Folded", folded.map((real) => `${real.sha} ${real.title}`)),
    section("Superseded", of("superseded")),
  ].join("\n")
}

/** One planned commit of the chain. */
interface Link {
  readonly commit: Commit
  readonly object: Repository.CommitObject
  readonly oid: string
  readonly source: string
}

/** The manifest the bookmark `oid` points at. */
export effect function readManifest(repository: Repository.Repository, oid: string) {
  const commit = try repository.readCommit(oid)
  const entry = (try repository.readTree(commit.tree)).find((each) => each.name === MANIFEST_FILE)
  const text = entry === undefined ? "" : try repository.readBlob(entry.oid)
  return try Effect.mapError(decodeManifest(text), () => Repository.repositoryError("invalid", "readManifest", "the manifest bookmark holds no manifest"))
}

/** The three refs' values now. */
export effect function readRefs(repository: Repository.Repository, names: RefNames) {
  const [mythical, notes, manifest] = try repository.readRefs([names.mythical, names.notes, names.manifest])
  const refs: Refs = { mythical: mythical?.oid ?? "", notes: notes?.oid ?? "", manifest: manifest?.oid ?? "" }
  return refs
}

/** What `prepare` answers: the refs it read, the refs a publication would set, and how many commits it wrote. */
export interface Prepared {
  readonly published: Refs
  readonly candidate: Refs
  readonly written: number
}

/** What an export reads of the last publication: its refs, its manifest, and the notes tree and the notes it holds. */
export interface Published {
  readonly refs: Refs
  readonly previous: Manifest | undefined
  readonly notesTree: string
  readonly noted: ReadonlyMap<string, string>
}

/** The last publication, as the refs `refs` name it. */
export effect function readPublished(repository: Repository.Repository, refs: Refs) {
  const previous = refs.manifest === "" ? undefined : try readManifest(repository, refs.manifest)
  const notesTree = refs.notes === "" ? "" : (try repository.readCommit(refs.notes)).tree
  const noted = new Map((notesTree === "" ? [] : try repository.readTree(notesTree)).map((entry) => [entry.name, entry.oid]))
  const published: Published = { refs, previous, notesTree, noted }
  return published
}

/** One object an export writes, by the id git gives it, and the write that makes it, made only when it runs. */
export interface Pending {
  readonly oid: string
  readonly write: () => string!Repository.RepositoryError
}

/**
 * An export of a history planned over the last publication. `needs` lists the real commits whose trees it must read
 * first; when none, `pending` is every object to write, in an order that writes each object after the objects it
 * names, and `candidate` the refs a publication sets.
 */
export interface Planned {
  readonly needs: ReadonlyArray<string>
  readonly pending: ReadonlyArray<Pending>
  readonly candidate: Refs
  readonly written: number
}

/**
 * Plans the export of `history` over `published`, writing nothing. A real commit's tree comes from `trees` or the last
 * manifest; any other is in `needs`, and then nothing else is planned. A commit the last export already wrote at the
 * same place (`kept`, proved) is not written again; a note blob, the notes commit and the manifest only when they
 * changed.
 */
export effect function planned(repository: Repository.Repository, history: History, published: Published, trees: ReadonlyMap<string, string>) {
  const { previous, notesTree, noted } = published
  const known = new Map<string, string>((previous?.commits ?? []).filter((entry) => entry[2] !== "").map((entry) => [entry[2], entry[3]]))
  for (const [source, tree] of trees) known.set(source, tree)
  const commits = stacked(history)
  // One pass over the real commits finds every commit's last fold (`lastFolds`, proved).
  const folds = lastFolds(history.real)
  const needs = [...new Set(commits.map((commit) => treeSource(history.real, folds, commit.id)).filter((source) => source !== "" && !known.has(source)))]
  if (waitsForTrees(needs.length)) {
    const waiting: Planned = { needs, pending: [], candidate: NONE, written: 0 }
    return waiting
  }
  const chain: Array<Link> = []
  let parent = ""
  let parentTree = EMPTY_TREE
  for (const commit of commits) {
    const source = treeSource(history.real, folds, commit.id)
    // `needs` is empty, so every source's tree is known.
    const tree = source === "" ? parentTree : known.get(source) as string
    const object: Repository.CommitObject = { tree, parents: parentsOf(parent), author: EXPORTER, committer: EXPORTER, message: messageOf(commit) }
    const oid = try Repository.hashCommit(object)
    chain.push({ commit, object, oid, source })
    parent = oid
    parentTree = tree
  }
  const keep = kept((previous?.commits ?? []).map((entry) => entry[1]), chain.map((link) => link.oid))
  const pending: Array<Pending> = chain.slice(keep).map((link) => ({ oid: link.oid, write: () => repository.writeCommit(link.object) }))

  // Notes: a blob per commit, written only when the last notes tree lacks it; one tree; a commit only when it changed.
  const folded = new Map<string, Array<Real>>()
  for (const real of history.real) {
    const into = folded.get(real.mythical)
    if (into === undefined) folded.set(real.mythical, [real])
    else into.push(real)
  }
  const entries: Array<Repository.TreeEntry> = []
  for (const link of chain) {
    const text = noteOf(link.commit, folded.get(link.commit.id) ?? [])
    const blob = try Repository.hashBlob(text)
    if (writesChange(noted.get(link.oid) ?? "", blob)) pending.push({ oid: blob, write: () => repository.writeBlob(text) })
    entries.push({ name: link.oid, mode: "100644", oid: blob })
  }
  let notes = published.refs.notes
  const tree = try Repository.hashTree(entries)
  if (writesChange(notesTree, tree)) {
    const object: Repository.CommitObject = { tree, parents: parentsOf(published.refs.notes), author: EXPORTER, committer: EXPORTER, message: "Notes for the mythical history\n" }
    notes = try Repository.hashCommit(object)
    pending.push({ oid: tree, write: () => repository.writeTree(entries) }, { oid: notes, write: () => repository.writeCommit(object) })
  }

  const mythical = parent
  const manifest: Manifest = {
    schema: 1,
    main: history.main,
    mythical,
    notes,
    commits: chain.map((link) => [link.commit.id, link.oid, link.source, link.object.tree] as const),
  }
  let manifestTip = published.refs.manifest
  if (manifestChanged(previous !== undefined, previous === undefined ? "" : JSON.stringify(previous), JSON.stringify(manifest))) {
    const text = `${JSON.stringify(manifest)}\n`
    const blob = try Repository.hashBlob(text)
    const files: ReadonlyArray<Repository.TreeEntry> = [{ name: MANIFEST_FILE, mode: "100644", oid: blob }]
    const filesTree = try Repository.hashTree(files)
    // The last manifest, and a bookmark the new one rewrote rather than extended, stay reachable from the new manifest:
    // a rewrite loses no commit.
    const rewritten = rewritesMythical(published.refs.mythical, chain.some((link) => link.oid === published.refs.mythical))
    const parents = [published.refs.manifest, rewritten ? published.refs.mythical : ""].filter((oid) => oid !== "")
    const object: Repository.CommitObject = { tree: filesTree, parents, author: EXPORTER, committer: EXPORTER, message: `Mythical history through ${history.main === "" ? "nothing" : history.main}\n` }
    manifestTip = try Repository.hashCommit(object)
    pending.push({ oid: blob, write: () => repository.writeBlob(text) }, { oid: filesTree, write: () => repository.writeTree(files) }, { oid: manifestTip, write: () => repository.writeCommit(object) })
  }
  const plan: Planned = { needs: [], pending, candidate: { mythical, notes, manifest: manifestTip }, written: chain.length - keep }
  return plan
}

/**
 * Plans the export of `history` and writes every object it needs, moving no ref: `planned`, with each real commit's
 * tree it needs read from the repository first, then every pending write in order.
 */
export effect function prepare(history: History, names: RefNames, pace: Pace = UNPACED) {
  const repository = try Repository.Repository
  const refs = try readRefs(repository, names)
  const published = try readPublished(repository, refs)
  const trees = new Map<string, string>()
  let plan = try planned(repository, history, published, trees)
  // More than one batch of `pace` is the publisher's work, paced across hours: nothing is read or written here.
  if (pacedOut(plan.needs.length, pace.reads)) return undefined
  if (waitsForTrees(plan.needs.length)) {
    for (const source of plan.needs) trees.set(source, (try repository.readCommit(source)).tree)
    plan = try planned(repository, history, published, trees)
  }
  if (pacedOut(plan.pending.length, pace.writes)) return undefined
  for (const each of plan.pending) try each.write()
  const prepared: Prepared = { published: refs, candidate: plan.candidate, written: plan.written }
  return prepared
}

/** Why a check refused: a commit that is not the one before it's only child, a tree that is not main's, or a missing note. */
export type CheckRefusal = "linear" | "tree" | "notes"

/** What `check` answers: how many new commits it read back, or why it refused. */
export interface Checked {
  readonly checked: number
  readonly refusal: string | null
}

/**
 * Checks, by reading the repository, every commit the candidate manifest names that the published one does not: its
 * only parent is the commit before it; its tree is the tree of the real commit it folds, or its parent's tree for an
 * empty reservation; and the candidate notes hold a note for it. Answers how many it checked, or why it refused.
 */
export effect function check(published: Refs, candidate: Refs) {
  const repository = try Repository.Repository
  const manifest = try readManifest(repository, candidate.manifest)
  const old = new Set(published.manifest === "" ? [] : (try readManifest(repository, published.manifest)).commits.map((entry) => entry[1]))
  let parent = ""
  let checked = 0
  let refusal: CheckRefusal | null = headerAgrees(manifest.mythical, manifest.notes, candidate.mythical, candidate.notes) ? null : "linear"
  for (const [, oid, source] of manifest.commits) {
    if (refusal !== null) break
    if (!old.has(oid)) {
      const commit = try repository.readCommit(oid)
      const origin = treeOrigin(source, parent)
      const tree = origin === "source" ? (try repository.readCommit(source)).tree
        : origin === "parent" ? (try repository.readCommit(parent)).tree : EMPTY_TREE
      const verdict = commitVerdict(linkedTo(commit.parents, parent), commit.tree === tree)
      if (verdict !== "ok") refusal = verdict
      checked++
    }
    parent = oid
  }
  if (refusal === null && !chainEnds(parent, candidate.mythical)) refusal = "linear"
  if (refusal === null) {
    const noted = new Set((try repository.readTree((try repository.readCommit(candidate.notes)).tree)).map((entry) => entry.name))
    if (!manifest.commits.every((entry) => noted.has(entry[1]))) refusal = "notes"
  }
  const result: Checked = { checked, refusal }
  return result
}

/** Moves all three refs in one compare-and-swap, each from its published value (`moves`, proved). */
export effect function publish(names: RefNames, published: Refs, candidate: Refs) {
  const repository = try Repository.Repository
  const updates = moves(names, published, candidate).map((move): Repository.RefUpdate => ({
    ref: move.ref,
    before: move.before === "" ? null : move.before,
    // A candidate always names all three: an export with nothing to publish is refused before this.
    after: move.after,
  }))
  try repository.updateRefs({ operation: `vibelang-history-export/${candidate.manifest.slice(0, 12)}`, updates })
}

/** Ref updates the guard refused before they reached the repository. */
export const guardRefusals = Metric.counter("vibelang_history_export_guard", { description: "Ref updates the export refused outside its three refs", incremental: true })

/**
 * `repository` as an export may use it: `updateRefs` refuses `invalid`, naming the refs, before it reaches the
 * repository when any ref is not one `names` names, or is `main` or the `vibe` branch (`writable`, proved). Every other
 * call passes through.
 */
export function guarded(repository: Repository.Repository, names: RefNames): Repository.Repository {
  return {
    ...repository,
    updateRefs: (transaction) => {
      const refused = transaction.updates.map((update) => update.ref).filter((ref) => !writable(names, ref))
      if (refused.length === 0) return repository.updateRefs(transaction)
      return Effect.logWarning("vibelang.history.export.guard").pipe(
        Effect.annotateLogs({ outcome: "refused", refs: refused.length }),
        Effect.andThen(Metric.update(Metric.withAttributes(guardRefusals, { outcome: "refused" }), 1)),
        Effect.andThen(Effect.fail(Repository.repositoryError("invalid", "updateRefs", "the export moves only its own three refs", refused))),
      )
    },
  }
}
