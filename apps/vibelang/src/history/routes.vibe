// The history API's routing in the API Worker (wiki/decisions/0020-mythical-history.md): which route a request names
// and the status a refusal answers with. Only the Worker routes, so this is apart from wire.vibe, whose paths and
// schemas the browser's live client also loads (decision 0016, browser gate scope).
import { historyStatus } from "./flowMachine.vibe"
import type { PageRequest } from "./pages.vibe"
import { HISTORY_PATH, type Write } from "./wire.vibe"
import { digitsFrom, idAfter, pageKind, routeKind, writeOf } from "./wireDecision.vibe"

/** A route of the history API. A read's kind names its page, so each is counted on its own. */
export type HistoryRoute =
  | { readonly kind: "history-outline" | "history-epic" | "history-commit" | "history-search"; readonly page: PageRequest }
  | { readonly kind: "history-events" }
  | { readonly kind: "history-write"; readonly write: Write }

/** The page a read asks for, from what follows `HISTORY_PATH` and the query: `undefined` when it names none. */
export function pageRequestOf(rest: string, params: URLSearchParams): PageRequest | undefined {
  const commit = idAfter(rest, "/commits/", 109)
  const epic = idAfter(rest, "/epics/", 101)
  const from = params.get("from") ?? "0"
  switch (pageKind(rest, commit, epic, digitsFrom(from, 0))) {
    case "outline": return { what: "outline" }
    case "search": return { what: "search", query: params.get("q") ?? "" }
    case "commit": return { what: "commit", id: commit }
    case "epic": return { what: "epic", id: epic, from: Number(from) }
    case "": return undefined
  }
}

/** The history route `method`, `pathname` and the query name, or `undefined`. */
export function historyRouteOf(method: string, pathname: string, params: URLSearchParams = new URLSearchParams()): HistoryRoute | undefined {
  const kind = routeKind(method, pathname)
  if (kind === "events") return { kind: "history-events" }
  const write = writeOf(pathname)
  if (kind === "write" && write !== "") return { kind: "history-write", write }
  if (kind !== "read") return undefined
  const page = pageRequestOf(pathname.slice(HISTORY_PATH.length), params)
  return page === undefined ? undefined : { kind: `history-${page.what}`, page }
}

/** The HTTP status a write's refusal answers with. */
export function statusOf(refusal: string): number {
  return historyStatus(refusal)
}
