// Who may run each mythical-history flow (wiki/decisions/0020-mythical-history.md; roles VL-21, decision 0019). The
// roles lane's policy interface replaces `Caller`'s source when it lands; every flow already reads its least role from
// `HISTORY_ROLES` and the caller from `Caller`, so switching is one change here.

/** The project's roles, least first (VL-21). */
export type Role = "viewer" | "new" | "community" | "contributor" | "maintainer"

/** The roles in order, least first. */
export const ROLES: ReadonlyArray<Role> = ["viewer", "new", "community", "contributor", "maintainer"]

/**
 * What a person or the agent can do with the mythical history. The bootstrap is no one's: its host runs it once, on
 * first start, and no request reaches it.
 */
export type Action = "show" | "append" | "retell" | "start" | "note" | "approve" | "fold"

/**
 * Each action's least role. Appending adds to the story; retelling (an insert or an amend) changes where others'
 * work sits or what it says, so it is a maintainer's.
 */
export const HISTORY_ROLES: Readonly<Record<Action, Role>> = {
  show: "viewer",
  append: "contributor",
  retell: "maintainer",
  start: "contributor",
  note: "contributor",
  approve: "maintainer",
  fold: "maintainer",
}

/** Actions only a person takes: people approve; the agent never does, and never folds what landed. */
export const PEOPLE_ONLY: ReadonlyArray<Action> = ["approve", "fold"]

/** Whether `role` is `least` or above. */
export function atLeast(role: Role, least: Role): boolean {
  return ROLES.indexOf(role) >= ROLES.indexOf(least)
}

/** Who asks: their role, the name notes carry, and whether the agent acts for them. */
export interface Principal {
  readonly role: Role
  readonly name: string
  readonly agent: boolean
}

/** Whether `principal` may take `action`. */
export function may(principal: Principal, action: Action): boolean {
  if (principal.agent && PEOPLE_ONLY.includes(action)) return false
  return atLeast(principal.role, HISTORY_ROLES[action])
}

/** The one place a flow learns who runs it. */
export service Caller {
  readonly principal: Principal
}

/** Someone who may only read. */
export const VIEWER: Principal = { role: "viewer", name: "Guest", agent: false }
