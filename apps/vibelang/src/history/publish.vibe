// The History object's publisher (wiki/decisions/0020-mythical-history.md, "Publishing and following main"):
// `vibelang/history/Publish`, one lineage that folds main's new commits and exports what changed at the repository's
// pace. Only the Worker registers it (worker/HistoryObject.vibe). It is apart from flows.vibe, whose Plan, Start, Note,
// Approve, Fold and Export the browser's mock history runs, so the browser loads none of it (decision 0016).
import { Action as Step, DurableClock, Flow, Interpreter, RetryPolicy, Sleep } from "@smthrs/flow"
import { Repository } from "@smthrs/jj"
import { Node } from "@smthrs/plan"
import { NONE, type Pace, type Pending, planned, readPublished, readRefs } from "./export.vibe"
import { pacedOut, type Refs, same, waitsForTrees } from "./exportDecision.vibe"
import { counted, exported, ExportTarget, exportStep, finish, foldCommits, MainCommitSchema, paceOf, readMain, refusing, RefsSchema, Stack } from "./flows.vibe"
import type { History } from "./mythical.vibe"

/** A publisher round's answer: how many commits of main it folded, and its export's answer. */
export const PublishAnswer = Schema.Struct({ folded: Schema.Number, mythical: Schema.String, written: Schema.Number, refusal: Schema.NullOr(Schema.String) })

const Begun = Schema.Struct({ refs: RefsSchema, refusal: Schema.NullOr(Schema.String) })
const BatchSchema = Schema.Struct({
  trees: Schema.Array(Schema.Tuple([Schema.String, Schema.String])),
  wrote: Schema.Array(Schema.String),
  needs: Schema.Number,
  remaining: Schema.Number,
  candidate: RefsSchema,
  written: Schema.Number,
  empty: Schema.Boolean,
})

/** A publisher round's run: the fold's steps, then the paced export's, each journaled. */
export const RunPublish = Step.make("vibelang/history/publish/run", { payload: {}, success: PublishAnswer })

/**
 * A batch GitHub refused for now is tried again at least as long after as it asked (`retryAfterMillis`: its
 * `Retry-After`, or `x-ratelimit-reset`), doubling from a minute to five, for at most a day. Only `unavailable` is
 * tried again; a refusal (`invalid`, `not_found`, `unsupported`) ends the round's export. Five minutes is the longest
 * wait: the engine waits out a retry inside the alarm that drives the step, and an alarm's drive has ten minutes
 * (`ExecutionObject.defaultDriveBudgetMs`); a longer limit is tried again every five minutes until it lifts.
 */
export const BATCH_RETRY = RetryPolicy.make({
  initialMs: 60_000,
  factor: 2,
  maxMs: 300_000,
  expirationMs: 86_400_000,
  retryable: [{ tag: "@smthrs/jj/RepositoryError", code: "unavailable" }],
})

/** How long a publisher's round waits after its export before it reads main again: ten minutes. */
export const FOLLOW_MS = 10 * 60_000

type PublishFlow = Flow.Flow<"vibelang/history/Publish", Schema.Struct<{}>, typeof PublishAnswer, typeof Sleep.SleepRequestInvalid, Step.Requirement<"vibelang/history/publish/run">>

/**
 * The History object's publisher, one lineage forever: each round folds main's new commits, exports what changed at the
 * repository's pace, waits `FOLLOW_MS`, and hands off to the next round, which the object keeps
 * (`ExecutionObject` `continueHere`). A main that moves during a round is folded by the next one; nothing runs twice.
 */
export const Publish: PublishFlow = Flow.make("vibelang/history/Publish", {
  description: "Follows main: folds its new commits into the mythical history and publishes what changed, paced to the repository's limits.",
  modelInvocable: false,
  payload: {},
  success: PublishAnswer,
  error: Sleep.SleepRequestInvalid,
  body: Node.capture({}, () => RunPublish.call({}).pipe(
    Node.andThen(Sleep.action.call({ millis: FOLLOW_MS })),
    Node.andThen(Publish.to({})),
  )),
})

/** One batch of a paced export: the trees it read, the objects it wrote, and what is left. */
export interface Batch {
  readonly trees: ReadonlyArray<readonly [string, string]>
  readonly wrote: ReadonlyArray<string>
  /** Real commits whose trees are still to read. */
  readonly needs: number
  /** Objects still to write once every tree is known. */
  readonly remaining: number
  readonly candidate: Refs
  readonly written: number
  /** The history has no commits: nothing to export. */
  readonly empty: boolean
}

/**
 * One batch of the export of `history` over the publication `refs` names, within `pace`: reads up to `pace.reads` trees
 * `trees` lacks, then, once every tree is known, writes up to `pace.writes` of the objects not in `done`, in order. The
 * same history planned again is the same objects, so a batch after a crash or a retry writes only what is missing;
 * a history that changed between batches plans the objects it now needs.
 */
export effect function batch(history: History, refs: Refs, trees: ReadonlyArray<readonly [string, string]>, done: ReadonlyArray<string>, pace: Pace) {
  const nothing: Batch = { trees: [], wrote: [], needs: 0, remaining: 0, candidate: NONE, written: 0, empty: true }
  if (history.commits.length === 0) return nothing
  const repository = try Repository.Repository
  const published = try readPublished(repository, refs)
  const known = new Map(trees)
  let plan = try planned(repository, history, published, known)
  const read: Array<readonly [string, string]> = []
  for (const source of plan.needs.slice(0, pace.reads)) {
    const tree = (try repository.readCommit(source)).tree
    read.push([source, tree])
    known.set(source, tree)
  }
  if (pacedOut(plan.needs.length, read.length)) {
    const reading: Batch = { ...nothing, trees: read, needs: plan.needs.length - read.length, empty: false }
    return reading
  }
  if (waitsForTrees(read.length)) plan = try planned(repository, history, published, known)
  const skip = new Set(done)
  const todo: Array<Pending> = []
  for (const each of plan.pending) {
    if (skip.has(each.oid)) continue
    skip.add(each.oid)
    todo.push(each)
  }
  const wrote: Array<string> = []
  for (const each of todo.slice(0, pace.writes)) {
    try each.write()
    wrote.push(each.oid)
  }
  const written: Batch = { trees: read, wrote, needs: 0, remaining: todo.length - wrote.length, candidate: plan.candidate, written: plan.written, empty: false }
  return written
}

/** A paced batch: its step fails with the repository's error, so `BATCH_RETRY` tries it again; counted by outcome. */
function batchStep<R>(at: number, body: typeof BatchSchema.Type!Repository.RepositoryError!R) {
  return Step.make({
    name: `vibelang/history/export/batch/${at}`,
    success: BatchSchema,
    error: Repository.RepositoryError,
    retryPolicy: BATCH_RETRY,
    execute: withSpan(effect {
      const answer = body catch effect (error) => {
        // A rate limit's wait is counted, never its message: the step's retry policy waits it out.
        try counted("export.batch", error.retryAfterMillis === undefined ? error.code : "limited")
        throw error
      }
      try counted("export.batch", answer.needs > 0 ? "read" : answer.remaining > 0 ? "wrote" : "done")
      try Metric.update(Metric.withAttributes(exportObjects, { kind: "write" }), answer.wrote.length)
      try Metric.update(Metric.withAttributes(exportObjects, { kind: "read" }), answer.trees.length)
      return answer
    }, "vibelang.history.export.batch"),
  })
}

/** Objects a paced export wrote and real commits' trees it read, by kind. */
export const exportObjects = Metric.counter("vibelang_history_export_objects", {
  description: "Objects the paced export wrote and trees it read",
  incremental: true,
})

/**
 * The publisher's export, paced: reads the published refs once (`export/begin`), then runs batches of `pace`
 * (`export/batch/<n>`, each retried by `BATCH_RETRY`) with a durable pause between them (`export/pause/<n>`), until
 * every tree is read and every object written; then checks, publishes and confirms as a person's export does. No ref
 * moves before that last compare-and-swap, from the refs `begin` read, so a partial run publishes nothing.
 */
effect function pacedExport() {
  const target = try ExportTarget
  const names = target.names
  const pace = paceOf(target)
  const begun = try exportStep("begin", Begun, refusing(Effect.map(readRefs(try Repository.Repository, names), (refs): typeof Begun.Type => ({ refs, refusal: null })), (refusal): typeof Begun.Type => ({ refs: NONE, refusal })), (answer) => answer.refusal ?? "read")
  if (begun.refusal !== null) return exported("", 0, begun.refusal)
  const trees: Array<readonly [string, string]> = []
  const done: Array<string> = []
  for (let at = 0; ; at++) {
    const known = [...trees]
    const wrote = [...done]
    const step = batchStep(at, effect { return try batch(try (try Stack).read(), begun.refs, known, wrote, pace) })
    const answered = step catch (error) => error.code
    if (typeof answered === "string") return exported(begun.refs.mythical, 0, answered)
    trees.push(...answered.trees)
    done.push(...answered.wrote)
    if (answered.empty) return exported("", 0, "nothing")
    if (answered.needs === 0 && answered.remaining === 0) {
      if (same(begun.refs, answered.candidate)) return exported(answered.candidate.mythical, 0, null)
      return try finish(names, begun.refs, answered.candidate, answered.written)
    }
    try counted("export.pause", "waiting")
    // Always a durable timer, never a sleep held in the alarm: the object rests between batches.
    try DurableClock.sleep({ name: `vibelang/history/export/pause/${at}`, duration: Duration.millis(pace.pauseMs), inMemoryThreshold: 0 })
  }
}

/** A publisher round: fold main's new commits (as Fold's steps do), then the paced export. */
effect function runPublish() {
  const stack = try Stack
  const main = try Step.make({ name: "vibelang/history/publish/fold/main", success: Schema.String, execute: Effect.map(stack.read(), (history) => history.main) })
  const read = try Step.make({
    name: "vibelang/history/publish/fold/read",
    success: Schema.Struct({ available: Schema.Boolean, commits: Schema.Array(MainCommitSchema) }),
    execute: readMain(main),
  })
  const folded = read.available ? (try foldCommits(read.commits)).folded : 0
  const answer = try pacedExport()
  try counted("publish", answer.refusal ?? (answer.written > 0 ? "published" : "current"))
  return { folded, ...answer }
}

/**
 * Registers `vibelang/history/Publish`, the History object's publisher: its steps reach the sequencer through `Stack`,
 * main through `MainLog`, the repository through `Repository` and its refs and pace through `ExportTarget`.
 */
export const publishRegistration = Interpreter.layerWithImplementations(Publish, RunPublish.toLayer(() => withSpan(runPublish(), "vibelang.history.publish.run")))

