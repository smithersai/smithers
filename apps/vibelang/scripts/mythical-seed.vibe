// The seed CLI boundary; the program takes its destination here and its host services from Effect.
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { main } from "./mythical-seed-program.vibe"

NodeRuntime.runMain(Effect.provide(main(new URL("../src/history/seed/vibelang.vibe", import.meta.url)), NodeServices.layer))
