// Writes worker/agentContext.vibe: the agent's system context, VibeLang's own skill (the installed
// `vibelang/skills/vibelang/SKILL.md`, frontmatter removed) under the agent's instructions. The Worker bundles the
// text; test/agentContext.test.vibe fails when the installed skill changes and this file wasn't regenerated.
//   pnpm agent-context           write
//   pnpm agent-context --check   exit 1 when the file is stale
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { contextStep } from "./scriptDecision.vibe"

/** The generated file differs from what the installed skill gives; the message is already on stderr. */
error Stale {
  get [Runtime.errorReported]() { return false }
}

const InstalledPackage = Schema.fromJsonString(Schema.Struct({ version: Schema.String }))

/** The generated module's text for the installed `vibelang`. */
effect function generated() {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  // The package the app installs (its exports name no skill file), read where pnpm links it.
  const vibelang = try path.fromFileUrl(new URL("../node_modules/vibelang/", import.meta.url))
  const skill = (try fs.readFileString(path.join(vibelang, "skills/vibelang/SKILL.md"))).replace(/^---\n[\s\S]*?\n---\n+/, "").trim()
  const { version } = try Schema.decodeUnknownEffect(InstalledPackage)(try fs.readFileString(path.join(vibelang, "package.json")))

  const instructions = `You are the VibeLang agent on vibelang.smithers.sh, the factory where people build VibeLang together.
Answer questions about VibeLang, the language for Effect: how to write it, how it maps to Effect TypeScript, and how
to fix code that doesn't compile. Be brief: a sentence or two, then code. Put VibeLang in \`\`\`vibe fences and shell
commands in \`\`\`sh fences. Use only the syntax in the reference below, VibeLang ${version}; when you don't know,
say so instead of inventing syntax. You can open the project's wiki through the supplied tool. You can't see the person's files.`

  const text = `${instructions}\n\n# VibeLang ${version} reference\n\n${skill}\n`
  return `// Generated by scripts/agent-context.vibe from vibelang ${version}'s skills/vibelang/SKILL.md. Do not edit.\n` +
    `export const AGENT_CONTEXT = ${try Effect.try(() => JSON.stringify(text))}\n`
}

export effect function main() {
  const fs = try FileSystem.FileSystem
  const source = try generated()
  const target = try (try Path.Path).fromFileUrl(new URL("../worker/agentContext.vibe", import.meta.url))
  const check = (try (try Stdio.Stdio).args).includes("--check")
  let current = ""
  if (check) current = fs.readFileString(target) catch () => ""
  const step = contextStep(check, current, source)
  if (step === "stale") {
    try Console.error("worker/agentContext.vibe is stale: run pnpm agent-context")
    throw new Stale()
  }
  if (step === "write") try fs.writeFileString(target, source)
}

NodeRuntime.runMain(Effect.provide(main(), NodeServices.layer))
