// Compiles the checked-in wiki Markdown with chat's renderer before every dev/build/test. No Markdown ships as a copy.
import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { toHtml } from "../src/web/markdown.vibe"
import { wikiLink } from "../src/core/wikiLinks.vibe"
import { decisionFile, pageFields, pageId, suiteState } from "../src/core/wikiPage.vibe"

export effect function generate() {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const root = try path.fromFileUrl(new URL("../wiki/", import.meta.url))
  const files: Array<string> = []
  effect function collect(directory: string) {
    for (const name of try fs.readDirectory(path.join(root, directory))) {
      const relative = path.join(directory, name)
      const stat = try fs.stat(path.join(root, relative))
      if (stat.type === "Directory") try collect(relative)
      else if (name.endsWith(".md")) files.push(relative)
    }
  }
  try collect("")
  files.push("decisions.md")
  const ids = new Set(files.map(file => pageId(file)))
  const pages: Array<{ id: string; title: string; label: string; decision: boolean; status: string; date: string; rulings: string[]; source: string; html: string }> = []
  for (const file of files.sort()) {
    const markdown = file === "decisions.md" ? "# Decisions\n\n" + files.filter(file => decisionFile(file)).sort().reverse().map(file => `- [${file.slice(10, -3)}](${file})`).join("\n") : try fs.readFileString(path.join(root, file))
    const { id, title, decision, rulings, label, status, date } = pageFields(file, markdown)
    const resolve = (href: string): string => wikiLink(id, href, [...ids])
    pages.push({ id, title, label: label ?? ({ index: "Home", rulings: "Rulings", roadmap: "Roadmap", decisions: "Decisions", "designs/index": "Designs" }[id] ?? title), decision,
      status, date, rulings: [...rulings],
      source: markdown, html: toHtml(markdown, resolve) })
  }
  // Published suite receipts already live in the wiki. Preserve their current state and source links in the gate.
  const suites: Array<{ label: string; state: string; href: string }> = []
  for (const [label, id] of [["Fuzz", "decisions/0015-fuzzing"], ["Coverage", "decisions/0016-coverage"], ["Proofs", "decisions/0018-proofs"]]) {
    const markdown = try fs.readFileString(path.join(root, id + ".md"))
    suites.push({ label: label!, state: suiteState(markdown), href: "/wiki/" + id })
  }
  const target = try path.fromFileUrl(new URL("../src/assets/wiki.generated.vibe", import.meta.url))
  try fs.writeFileString(target, `// Generated by scripts/wiki.vibe at build time; never commit.\nexport const pages = ${try Effect.try(() => JSON.stringify(pages))}\nexport const verificationSuites = ${try Effect.try(() => JSON.stringify(suites))}\n`)
  // The pages without their Markdown and HTML, for the Workers: parsing the bodies at startup cost the API Worker
  // most of Cloudflare's startup limit (wiki/decisions/0033-worker-startup.md).
  const index = pages.map(({ source: _source, html: _html, ...entry }) => entry)
  try fs.writeFileString(path.join(path.dirname(target), "wikiIndex.generated.vibe"), `// Generated by scripts/wiki.vibe at build time; never commit.\nexport const pages = ${try Effect.try(() => JSON.stringify(index))}\n`)
  try Console.log(`wiki: ${pages.length} pages`)
}
NodeRuntime.runMain(Effect.provide(generate(), NodeServices.layer))
