import * as NodeRuntime from "@effect/platform-node/NodeRuntime"
import * as NodeServices from "@effect/platform-node/NodeServices"
import { serveLiveSite } from "../test/support/liveSite.vibe"
import { recordingPath } from "../test/support/github.vibe"
import { MARKDOWN_PROMPT, serveRecordedProvider } from "../test/support/recordedProvider.vibe"
import { serveApi, serveAuthBroker, serveLiveIssues, type Served } from "../test/support/workerd.vibe"
// Every browser project gets its own hosts, so durable state never leaks between projects: the auth broker
// (authbroker.spec.ts), a live site whose issue routes run on workerd (live-issues.spec.ts) beside the preview server,
// and, once the real model's Markdown reply is recorded (`pnpm record:model`), a live site whose API Worker replays it
// (chat-markdown.spec.ts), and a live site whose API Worker has sign-in configured and runs the production sandbox
// gateway, account and machine objects on an in-memory Container (core-live.spec.ts).
NodeRuntime.runMain(scoped(effect {
  const site = `http://127.0.0.1:${try Config.String("E2E_PORT")}`
  const origins: Record<string, string> = {}
  const live: Record<string, string> = {}
  const replies: Record<string, string> = {}
  const core: Record<string, string> = {}
  const markdown = try recordingPath("model-markdown")
  const recorded = try Effect.provide(Effect.flatMap(FileSystem.FileSystem, (fs) => fs.exists(markdown)), NodeServices.layer)
  for (const project of ["dark", "light", "phone"]) {
    const host = try acquireRelease(serveAuthBroker(), host => promise(() => host.dispose()))
    origins[project] = host.origin
    const api = try acquireRelease(serveLiveIssues(), api => promise(() => api.dispose()))
    live[project] = (try serveLiveSite(api, site)).origin
    if (recorded) {
      const provider = try serveRecordedProvider("markdown", { mode: "replay" })
      const replying = try acquireRelease(serveApi(provider.bindings), api => promise(() => api.dispose()))
      replies[project] = (try serveLiveSite(replying, site)).origin
    }
    // The site's origin is the Worker's VIBELANG_ORIGIN, so the site is served first and reaches the Worker once it runs.
    let worker: Served | undefined
    const coreSite = try serveLiveSite({ fetch: (request: Request) => worker!.fetch(request) } as Served, site)
    worker = try acquireRelease(serveApi({
      VIBELANG_ORIGIN: coreSite.origin, VIBELANG_INITIAL_MAINTAINER_ID: "1",
      GITHUB_CLIENT_ID: "Iv1.fixture", GITHUB_CLIENT_SECRET: "fixture-only",
      SESSION_SECRET: "fixture-only-signing-secret-32-chars",
      SESSION_ENCRYPTION_KEY: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
    }), api => promise(() => api.dispose()))
    core[project] = coreSite.origin
  }
  try Console.log("LIVE_CORE_READY " + JSON.stringify(core))
  try Console.log("LIVE_REPLY_READY " + JSON.stringify({ prompt: MARKDOWN_PROMPT, origins: replies }))
  try Console.log("LIVE_ISSUES_READY " + JSON.stringify(live))
  try Console.log("AUTH_BROKER_READY " + JSON.stringify(origins))
  try Effect.never
}))
