// Built only in e2e mode. It runs the real app with a faulty transport layer and exposes read-only observations.
import { Runtime } from "foldkit"
import { ExperimentalBrowserDocument, ExperimentalBrowserMediaQuery, ExperimentalBrowserWindow } from "vibelang-runtime/experimental/platform-browser"
import { faultyFactory, trace } from "../../test/support/FaultyFactory.vibe"
import { application } from "../../test/support/application.vibe"
import { MediaAssets } from "../../src/web/media.vibe"
import { init } from "../../src/web/main.vibe"
import { stylesheet } from "../../src/web/styles.vibe"
import { main as startup, page as startupPage } from "../../src/web/startup.vibe"
import { heldHealth } from "../../test/support/heldHealth.vibe"
import { canonical } from "./probe.vibe"

/** The fault this page's `?fault=` names; a missing or unknown one drops an event. */
function faultOf(search: string) {
  const requested = new URLSearchParams(search).get("fault")
  if (requested === "thinking" || requested === "streaming" || requested === "tour-refuse" || requested === "tour-unavailable" || requested === "end-tour-unavailable" || requested === "live-header") return requested
  return requested === "refuse" ? "refuse" : requested === "end" ? "end" : requested === "disconnect" ? "disconnect" : "drop"
}

/** The app over the faulty Factory, with `window.recovery` reading the rendered model and the transport's trace. */
export effect function main() {
  const window = try (try Experimental.Window.Window).current
  const document = try (try Experimental.Document.Document).current
  const css = try stylesheet()
  const root = try Effect.try(() => {
    const style = document.createElement("style")
    style.textContent = css
    document.head.append(style)
    return document.getElementById("root")!
  })
  const observation = trace()
  let model = init({ session: "browser", mode: faultOf(window.location.search) === "live-header" ? "live" : "mock", name: "Guest" }).model
  const empty = new URLSearchParams(window.location.search).get("fault") === "media-empty" || new URLSearchParams(window.location.search).get("fault") === "media-image"
  const program = application(root, faultyFactory(faultOf(window.location.search), observation), (value) => { model = value },
    (flags) => { const started = init(flags); return empty ? { ...started, model: { ...started.model, surface: "chat" as const } } : started })
  window.recovery = {
    snapshot: () => ({ client: model.client, subscriptions: observation.subscriptions, delivered: observation.delivered.map((event) => event.seq) }),
    canonical: () => runPromise(canonical(observation)),
    release: () => runPromise(observation.release!()),
  }
  return program
}

const page = Layer.mergeAll(ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer, ExperimentalBrowserMediaQuery.layer)

const window = await runPromise(effect {
  provide page { return try (try Experimental.Window.Window).current }
})
const mediaSources = await runPromise(Effect.provide(effect { return try (try MediaAssets).sources }, Layer.succeed(MediaAssets, {
  // Valid image bytes sent to the real video decoder: a native decode failure, without request interception.
  sources: succeed(new URLSearchParams(window.location.search).get("fault") === "media-video" ? { "/media/magic-move.mp4": "/media/card-01-contract.png" } : new URLSearchParams(window.location.search).get("fault") === "media-image" ? { "/media/card-06-compiler.png": "/media/not-an-image.png" } : {}),
})))
const reducedMotion = await runPromise(effect {
  provide page { return try (try Experimental.MediaQuery.MediaQuery).matches("(prefers-reduced-motion: reduce)") }
})
if (new URLSearchParams(window.location.search).get("fault") === "health") {
  // Finish loading the fault host while the production startup program is waiting, so the browser can send keys.
  runFork(Effect.provide(effect {
    const health = try heldHealth()
    window.startup = { snapshot: health.snapshot, release: () => runPromise(health.release("mock")) }
    const { application, flags } = try Effect.provide(startup(), Layer.merge(health.layer, Layer.succeed(Clock.Clock, health.deadlineClock)))
    try Effect.try(() => Runtime.run(application, { flags: succeed(flags) }))
  }, startupPage) |> Effect.orDie(%))
} else {
  Runtime.run(await runPromise(Effect.provide(main(), page) |> Effect.orDie(%)), {
    flags: succeed({ session: "browser", mode: faultOf(window.location.search) === "live-header" ? "live" as const : "mock" as const, name: "Guest", reducedMotion, mediaSources }),
  })
}
