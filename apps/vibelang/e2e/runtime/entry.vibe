// Built only in e2e mode. It runs the real app with a faulty transport layer and exposes read-only observations.
import { Runtime } from "foldkit"
import { ExperimentalBrowserDocument, ExperimentalBrowserWindow } from "vibelang-runtime/experimental/platform-browser"
import { faultyFactory, trace } from "../../test/support/FaultyFactory.vibe"
import { application } from "../../test/support/application.vibe"
import { init } from "../../src/web/main.vibe"
import { stylesheet } from "../../src/web/styles.vibe"
import { main as startup, page as startupPage } from "../../src/web/startup.vibe"
import { heldHealth } from "../../test/support/heldHealth.vibe"
import { canonical } from "./probe.vibe"

/** The fault this page's `?fault=` names; a missing or unknown one drops an event. */
function faultOf(search: string) {
  const requested = new URLSearchParams(search).get("fault")
  return requested === "refuse" ? "refuse" : requested === "end" ? "end" : requested === "disconnect" ? "disconnect" : "drop"
}

/** The app over the faulty Factory, with `window.recovery` reading the rendered model and the transport's trace. */
export effect function main() {
  const window = try (try Experimental.Window.Window).current
  const document = try (try Experimental.Document.Document).current
  const css = try stylesheet()
  const root = try Effect.try(() => {
    const style = document.createElement("style")
    style.textContent = css
    document.head.append(style)
    return document.getElementById("root")!
  })
  const observation = trace()
  let model = init({ session: "browser", mode: "mock", name: "Guest" }).model
  const program = application(root, faultyFactory(faultOf(window.location.search), observation), (value) => { model = value })
  window.recovery = {
    snapshot: () => ({ client: model.client, subscriptions: observation.subscriptions, delivered: observation.delivered.map((event) => event.seq) }),
    canonical: () => runPromise(canonical(observation)),
  }
  return program
}

const page = Layer.merge(ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer)

const window = await runPromise(Effect.provide(effect { return try (try Experimental.Window.Window).current }, page))
if (new URLSearchParams(window.location.search).get("fault") === "health") {
  // Finish loading the fault host while the production startup program is waiting, so the browser can send keys.
  runFork(Effect.provide(effect {
    const health = try heldHealth()
    window.startup = { snapshot: health.snapshot, release: () => runPromise(health.release("mock")) }
    const { application, flags } = try Effect.provide(startup(), health.layer)
    try Effect.try(() => Runtime.run(application, { flags: succeed(flags) }))
  }, startupPage) |> Effect.orDie(%))
} else {
  Runtime.run(await runPromise(Effect.provide(main(), page) |> Effect.orDie(%)), {
    flags: succeed({ session: "browser", mode: "mock" as const, name: "Guest" }),
  })
}
