/** Rolldown prints no source-map segment where these two initializers start (decision 0016). */
export function scrolled(page: { readonly scrollY?: number } | undefined, serial: number | undefined) {
  const position = () => page?.scrollY ?? 0
  const next = (serial ?? 0) + 1
  return position() + next
}

/** Deliberately tree-shaken from a partially used source file. */
export function dropped() {
  return 13
}

/** Nested code removed while its enclosing function remains in the bundle. */
export function result() {
  const unused = () => 1
  const droppedChoice = true ? 3 : 4
  return 2
}

/** Rolldown inlines each `const` read once into the statement that reads it (decision 0016). */
export function linked(event: { readonly target: { readonly closest?: (selector: string) => { readonly id: string } | null } | null }) {
  const element = event.target
  const link = element?.closest?.("a")
  const id = link?.id
  return id ?? "none"
}
