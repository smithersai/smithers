// Screens built the way a person reaches them, then the update branches and Commands that only those screens reach.
import { it } from "@effect/vitest"
import { Model, Message, accountOf, roleLabel, update, viewTransition, RunAction, ReadAction, CancelAction, LoadActions, SandboxAction, LoadPeople, GrantRole, LoadIssues, ActOnIssue, LoadIssueDetails, RefreshIssueProjection, OpenWikiEditor, SubmitWikiEdit } from "../src/web/main.vibe"
import { Factory, SandboxSnapshot } from "../src/core/Factory.vibe"
import { Actions } from "../src/actions/Actions.vibe"
import { IssueOperation, IssueRequest } from "../src/core/issueSchemas.vibe"
import { WikiRequest } from "../src/core/wikiSchemas.vibe"
import { pages } from "../src/core/wiki.vibe"
import { actionsOf } from "../src/web/actionModel.vibe"
import { backend, backendWithFailingPosts, backendWithWiki, Backend, Role, WikiFault } from "./web-backends.vibe"
import { run, Finding, Int, Text, TextOrBoundary } from "./run.vibe"
import { gesture, GRANTS, pump, tab, tourEnded, tourStop } from "./web-tab.vibe"

/** A tab in mock mode, signed in with `role`, every startup Command settled. */
effect function signedIn(id: string, role: typeof Role.Type) {
  const session = tab({ session: id, mode: "mock", name: "Guest" })
  try session.settle
  try session.send(try Effect.try(() => Message.ResolvedMode({ mode: "mock" })))
  try session.send(try Effect.try(() => Message.ChoseIdentity({ role })))
  return session
}

const Stop = Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 10 }))
const Stops = Schema.Struct({ session: Int, role: Role, stops: Schema.Array(Stop).check(Schema.isMinLength(1), Schema.isMaxLength(10)), end: Schema.Literals(["none", "event", "click", "failed-end", "escape"]), sound: Schema.Boolean })

/** Where each stop leaves the screen, as the walkthrough's own controls would. */
function showsStop(model: Model, step: number): boolean {
  if (model.theatre?.step !== step) return false
  if (step === 10) return !model.tour
  if (!model.tour) return false
  switch (step) {
    case 1: return model.surface === "splash"
    case 3: return model.issues?.open === true && model.issues.screen === "list" && model.issues.kind === "All"
    case 5: return model.issues?.open === true && model.issues.kind === "VIPs"
    case 6: return model.docs === "max"
    case 8: return model.draft === "/"
    case 9: return model.sandboxPane === "max"
    default: return model.surface === "chat"
  }
}

/** The agent drives the walkthrough to any stop in any order; each stop shows its screen, and every way out ends the tour. */
it.live("web/walkthrough-stops", () => run("web/walkthrough-stops", Stops, ({ session: id, role, stops, end, sound }) => Effect.provide(effect {
  const session = try signedIn(`w${id}`, role)
  try session.send(try Effect.try(() => Message.ClickedLearnMore()))
  if (sound) try session.send(try Effect.try(() => Message.ToggledTourSound()))
  for (const step of stops) {
    for (const message of tourStop(session.model(), step)) try session.send(message)
    if (!showsStop(session.model(), step)) return false
  }
  const last = stops.at(-1)!
  switch (end) {
    case "none": return true
    case "event": for (const message of tourEnded(session.model())) try session.send(message); break
    case "click": try session.send(try Effect.try(() => Message.ClickedEndTour())); break
    case "escape": try session.send(try Effect.try(() => Message.PressedEscape())); break
    // The end could not be delivered: the tour is still the agent's, so the screen returns to the current stop.
    case "failed-end": try session.send(try Effect.try(() => Message.FailedEndTour())); return session.model().theatre?.step === last && showsStop(session.model(), last)
  }
  const after = session.model()
  return !after.tour && after.surface === "chat" && after.issues?.open !== true && after.sandboxPane !== "max"
}, backend("mock", role))))

const LAYERS = ["role", "issue-dialog", "slash", "palette", "menu", "issues", "actions-max", "wiki-edit", "sandbox-max", "docs"] as const
type Layer = typeof LAYERS[number]

function opened(model: Model): ReadonlyArray<Layer> {
  const account = accountOf(model)
  const actions = actionsOf(model)
  const open: Record<Layer, boolean> = {
    "role": account.target !== "",
    "issue-dialog": model.issues?.open === true && model.issues.dialog !== "",
    "slash": actions.slash,
    "palette": model.palette,
    "menu": account.menu,
    "issues": model.issues?.open === true,
    "actions-max": actions.maximized,
    "wiki-edit": model.wikiEdit !== undefined,
    "sandbox-max": model.sandboxPane === "max",
    "docs": model.surface === "chat" && model.docs === "max",
  }
  return LAYERS.filter((layer) => open[layer])
}

const Opener = Schema.Literals(["issue-dialog", "people", "select-role", "issues", "issue-ui", "move-slash", "palette", "account", "actions", "maximize-actions", "edit-wiki", "wiki-save", "sandboxes", "maximize-sandboxes", "docs", "chat", "wiki"])
/** The gestures that open `step.op`'s layer; an issue dialog opens on the issues screen. */
function opener(model: Model, step: typeof Layers.Type["steps"][number]): ReadonlyArray<Message> {
  if (step.op === "issue-dialog") return [Message.ClickedIssues(), Message.IssueUi({ action: (["commit-dialog", "split-dialog", "link-dialog"] as const)[step.n % 3]!, value: "" })]
  return gesture(model, { op: step.op, n: step.n, text: step.text })
}

const Layers = Schema.Struct({ session: Int, role: Role, wiki: WikiFault, steps: Schema.Array(Schema.Struct({ op: Opener, n: Int, text: TextOrBoundary })).check(Schema.isMinLength(1), Schema.isMaxLength(12)) })

/**
 * Escape closes the innermost open layer and only it: the role dialog, an issue dialog, slash completions, the palette,
 * the account menu, issues, maximized actions, the wiki editor, maximized sandboxes, then maximized docs. A wiki edit
 * being saved stays open.
 */
it.live("web/escape-layers", () => run("web/escape-layers", Layers, ({ session: id, role, wiki, steps }) => Effect.provide(effect {
  const session = try signedIn(`e${id}`, role)
  for (const step of steps) {
    // The wiki pane arrives as a conversation event; the editor opens on the page it shows.
    if (step.op === "edit-wiki" || step.op === "wiki-save") {
      try session.send((try Effect.try(() => opener(session.model(), step)))[0]!)
      try pump(session)
    }
    const model = session.model()
    for (const message of try Effect.try(() => opener(model, step))) try session.send(message)
    if (step.op === "wiki") try pump(session)
  }
  for (let press = 0; press < LAYERS.length + 1; press++) {
    const before = session.model()
    const layers = opened(before)
    if (layers.length === 0) return true
    try session.send(try Effect.try(() => Message.PressedEscape()))
    const after = opened(session.model())
    const innermost = layers[0]!
    if (innermost === "wiki-edit" && before.wikiEdit?.submission !== undefined) return after.join() === layers.join()
    const expected = layers.filter((layer) => layer !== innermost)
    if (after.join() !== expected.join()) return false
  }
  return false
}, backendWithWiki(role, wiki))))

const Grant = Schema.Struct({ who: Schema.Literals(["self", "member", "stranger", "nobody"]), role: Role, mode: Schema.Literals(["person", "participation", "bootstrap"]), gap: Schema.Boolean, n: Int })
const Grants = Schema.Struct({ session: Int, role: Role, people: Schema.Boolean, dialog: Schema.Boolean, grants: Schema.Array(Grant).check(Schema.isMinLength(1), Schema.isMaxLength(6)) })

/**
 * Role grants arriving on the account stream: the person's own grant changes their role and says so, a listed member's
 * grant is announced while people are shown, a gap resumes the stream, and losing maintainer closes the role dialog.
 */
it.live("web/role-events", () => run("web/role-events", Grants, ({ session: id, role, people, dialog, grants }) => Effect.provide(effect {
  const session = try signedIn(`r${id}`, role)
  if (people) try session.send(try Effect.try(() => Message.ClickedPeople()))
  const members = accountOf(session.model()).members
  if (dialog && members.length > 0) try session.send(try Effect.try(() => Message.SelectedRole({ id: members[0]!.id, role: "contributor" })))
  for (const grant of grants) {
    const before = accountOf(session.model())
    const member = members[grant.n % Math.max(1, members.length)]
    const target = grant.who === "self" ? before.identity.id : grant.who === "member" ? member?.id ?? "" : grant.who === "stranger" ? `stranger-${grant.n}` : ""
    const seq = before.ledger.conversation.seq + (grant.gap ? 2 : 1)
    try session.send(try Effect.try(() => Message.ReceivedRole({ event: { type: "RoleGranted", seq, id: target, by: "fuzz", role: grant.role, mode: grant.mode } })))
    const model = session.model()
    const after = accountOf(model)
    if (grant.gap) {
      if (after.epoch !== before.epoch + 1 || after.identity.role !== before.identity.role) return false
      continue
    }
    const applies = target !== "" && grant.role !== "viewer"
    const own = applies && target === before.identity.id && before.identity.id !== ""
    if (own && after.identity.role !== grant.role) return false
    if (!own && after.identity.role !== before.identity.role) return false
    const notice = own ? (grant.mode === "participation" ? "You're now Community." : `You're now ${roleLabel(grant.role)}.`)
      : applies && grant.mode === "person" && before.people !== "closed" ? `${members.find((person) => person.id === target)?.login ?? target} is now ${roleLabel(grant.role)}.`
      : before.notice
    if (after.notice !== notice) return false
    if (after.identity.role !== before.identity.role && (model.wikiEdit !== undefined || after.target !== "" && after.identity.role !== "maintainer")) return false
  }
  return true
}, backend("mock", role))))

const Name = Schema.Literals(["vibelang/Post", "vibelang/Tour", "vibelang/Reply", "vibelang/nope"])
const JsonText = Schema.Union([TextOrBoundary, Schema.Literals(["{\"a\":1}", "[1,2", "{}", "\"x\"", "  "])])
const RunId = Schema.Literals(["started", "unknown"])
const Epoch = Schema.optionalKey(Int)
const Body = Schema.Union([
  Schema.Struct({ command: Schema.Literal("RunAction"), name: Name, text: JsonText, epoch: Epoch, door: Schema.Literals(["button", "slash"]), retry: Schema.optionalKey(RunId), format: Schema.optionalKey(Schema.Literals(["none", "text", "path", "json"])) }),
  Schema.Struct({ command: Schema.Literals(["ReadAction", "CancelAction"]), id: RunId }),
  Schema.Struct({ command: Schema.Literal("LoadActions"), flow: Schema.Literals(["", "vibelang/Post", "vibelang/nope"]), epoch: Epoch }),
  Schema.Struct({ command: Schema.Literal("SandboxAction"), kind: Schema.Literals(["start", "stop", "command"]), operationId: Text, request: Int, generation: Int, text: TextOrBoundary }),
  Schema.Struct({ command: Schema.Literal("LoadPeople") }),
  Schema.Struct({ command: Schema.Literal("GrantRole"), who: Schema.Literals(["member", "nobody"]), role: Schema.Literals(GRANTS) }),
  Schema.Struct({ command: Schema.Literal("LoadIssues"), resumeRecovery: Schema.optionalKey(Text), resumeOp: Schema.optionalKey(Schema.Literals(["new", "comment", "close", "split", "propose", "read", "nope"])), resumeKey: Schema.optionalKey(Text) }),
  Schema.Struct({ command: Schema.Literal("ActOnIssue"), request: IssueRequest }),
  Schema.Struct({ command: Schema.Literal("LoadIssueDetails"), number: Int, key: Text }),
  Schema.Struct({ command: Schema.Literal("RefreshIssueProjection") }),
  Schema.Struct({ command: Schema.Literal("OpenWikiEditor"), page: Schema.Literals([...pages.map((page) => page.id), "nope"]), request: Int }),
  Schema.Struct({ command: Schema.Literal("SubmitWikiEdit"), request: WikiRequest, serial: Int }),
])
const Bodies = Schema.Struct({ backend: Backend, wiki: WikiFault, role: Role, body: Body })

/** The Messages each Command declares, by the tag a missing or failing service must answer with. */
const ANSWERS: Record<typeof Body.Type["command"], { readonly ok: ReadonlyArray<string>; readonly failed: string }> = {
  RunAction: { ok: ["StartedAction"], failed: "FailedActions" },
  ReadAction: { ok: ["ChangedAction"], failed: "FailedActions" },
  CancelAction: { ok: ["ChangedAction"], failed: "FailedActions" },
  LoadActions: { ok: ["LoadedActions"], failed: "FailedActions" },
  SandboxAction: { ok: ["LoadedSandbox"], failed: "FailedSandbox" },
  LoadPeople: { ok: ["LoadedPeople"], failed: "AccountFailed" },
  GrantRole: { ok: ["GrantedRole"], failed: "AccountFailed" },
  LoadIssues: { ok: ["IssuesLoaded"], failed: "IssuesFailed" },
  ActOnIssue: { ok: ["IssuesLoaded"], failed: "IssuesFailed" },
  LoadIssueDetails: { ok: ["IssueDetailsLoaded"], failed: "IssueDetailsFailed" },
  RefreshIssueProjection: { ok: ["IssueProjectionLoaded"], failed: "IssueDialogFocused" },
  OpenWikiEditor: { ok: ["BeganWikiEdit"], failed: "FailedWikiEdit" },
  SubmitWikiEdit: { ok: ["CompletedWikiEdit"], failed: "FailedWikiEdit" },
}

/** A started run's id, when the body asks for one, and a listed member, when there is one. */
effect function fixtures(body: typeof Body.Type) {
  const wantsRun = body.command === "RunAction" && body.retry === "started" || (body.command === "ReadAction" || body.command === "CancelAction") && body.id === "started"
  const run = wantsRun ? Option.getOrElse(Exit.getSuccess(try exit((try Actions).start("vibelang/Post", { text: "q" }, "button"))), () => "absent") : "unknown"
  const factory = try Factory
  const members = body.command !== "GrantRole" || factory.accounts === undefined ? [] : Option.getOrElse(Exit.getSuccess(try exit(factory.accounts.members())), () => [])
  return { run, member: members[0]?.id ?? "nobody" }
}

function commandOf(body: typeof Body.Type, { run, member }: { readonly run: string; readonly member: string }) {
  switch (body.command) {
    case "RunAction": return RunAction({ name: body.name, text: body.text, door: body.door, ...(body.epoch === undefined ? {} : { epoch: body.epoch }), ...(body.format === undefined ? {} : { format: body.format }), ...(body.retry === undefined ? {} : { retry: run }) })
    case "ReadAction": return ReadAction({ id: run })
    case "CancelAction": return CancelAction({ id: run })
    case "LoadActions": return LoadActions({ flow: body.flow, ...(body.epoch === undefined ? {} : { epoch: body.epoch }) })
    case "SandboxAction": return SandboxAction({ conversation: "fuzz-sandbox", operationId: body.operationId, request: body.request, kind: body.kind, generation: body.generation, command: body.text })
    case "LoadPeople": return LoadPeople({})
    case "GrantRole": return GrantRole({ id: body.who === "member" ? member : "nobody", role: body.role })
    case "LoadIssues": return LoadIssues({ ...(body.resumeRecovery === undefined ? {} : { resumeRecovery: body.resumeRecovery }), ...(body.resumeOp === undefined ? {} : { resumeOp: body.resumeOp }), ...(body.resumeKey === undefined ? {} : { resumeKey: body.resumeKey }) })
    case "ActOnIssue": return ActOnIssue({ request: body.request })
    case "LoadIssueDetails": return LoadIssueDetails({ number: body.number, key: body.key })
    case "RefreshIssueProjection": return RefreshIssueProjection({})
    case "OpenWikiEditor": return OpenWikiEditor({ page: body.page, request: body.request })
    case "SubmitWikiEdit": return SubmitWikiEdit({ request: body.request, serial: body.serial })
  }
}

/** What a backend without the service, or with every service failing, must answer. */
function mustFail(kind: typeof Backend.Type, wiki: typeof WikiFault.Type, command: typeof Body.Type["command"]): boolean {
  // Wiki faults are injected only into the mock backend.
  if (kind === "mock" && command === "OpenWikiEditor" && (wiki === "read-fails" || wiki === "missing")) return true
  if (kind === "mock" && command === "SubmitWikiEdit" && (wiki === "unwritten" || wiki === "kept")) return true
  if (kind === "faulty") return true
  if (kind !== "bare") return false
  return command === "GrantRole" || command === "LoadIssues" || command === "ActOnIssue" || command === "LoadIssueDetails" || command === "RefreshIssueProjection" || command === "OpenWikiEditor" || command === "SubmitWikiEdit"
}

/**
 * Every Command, from any args its Message can carry, answers one of its declared Messages: the failure Message when its
 * service is missing or failing, JSON input that does not parse is refused before anything starts, and an epoch is echoed.
 */
it.live("web/command-bodies", () => run("web/command-bodies", Bodies, ({ backend: kind, wiki, role, body }) => Effect.provide(effect {
  const made = try fixtures(body)
  const command = try Effect.try(() => commandOf(body, made))
  // Each definition has its own Message union; all are Messages of this program.
  const answered = command.effect as Effect<Message, unknown, Factory | Actions>
  const result = try exit(timeout(answered, "5 seconds"))
  if (result._tag === "Failure") throw new Finding({ report: `${command.name}: ${Cause.pretty(result.cause)}` })
  const answer = result.value
  const expected = ANSWERS[body.command]
  if (answer._tag !== expected.failed && !expected.ok.includes(answer._tag)) return false
  if (mustFail(kind, wiki, body.command) && answer._tag !== expected.failed) return false
  if (kind === "bare" && body.command === "LoadPeople") return answer._tag === "LoadedPeople" && answer.members.length === 0
  // An issue answer without a role takes the mock's default, maintainer (IssueDecision.issueDefaultRole).
  if (kind === "roleless" && answer._tag === "IssuesLoaded" && answer.role !== "maintainer") return false
  if (body.command === "RunAction" && body.format === "json" && body.text.trim() !== "" && Exit.isFailure(Schema.decodeUnknownExit(Schema.fromJsonString(Schema.Json))(body.text))) {
    if (answer._tag !== "FailedActions" || answer.code !== "input") return false
  }
  if ((body.command === "RunAction" || body.command === "LoadActions") && "epoch" in answer && (answer as { epoch?: number }).epoch !== body.epoch) return false
  if (body.command === "SandboxAction" && answer._tag === "FailedSandbox" && kind === "faulty") return answer.reason === (body.kind === "stop" ? "fault" : "busy")
  return true
}, Layer.merge(kind === "mock" && wiki !== "none" ? backendWithWiki(role, wiki) : backend(kind, role), Layer.empty))))

const Happening = Schema.Struct({ kind: Schema.Literals(["answer", "answer-issue", "pane-wiki", "pane-other", "action", "gap"]), n: Int, text: Text, sandbox: Schema.Boolean, edit: Schema.Boolean })
const Happenings = Schema.Struct({ session: Int, role: Role, happenings: Schema.Array(Happening).check(Schema.isMinLength(1), Schema.isMaxLength(8)) })

/** The sequencer's next events for this tab's conversation, numbered after what the tab has. */
function eventsOf(model: Model, { kind, n, text }: typeof Happening.Type) {
  const seq = model.client.conversation.seq
  const post = `fuzz-post-${seq}`
  const reply = `fuzz-reply-${seq}`
  switch (kind) {
    case "answer": case "answer-issue": return [
      { type: "Posted" as const, seq: seq + 1, id: post, clientId: `c-${seq}`, name: "Guest", text: "question" },
      { type: "ReplyStarted" as const, seq: seq + 2, id: reply, inReplyTo: post },
      { type: "ReplyDelta" as const, seq: seq + 3, id: reply, text: kind === "answer-issue" ? `See [#${n + 1}](#issue-${n + 1}).` : text },
      { type: "ReplyFinished" as const, seq: seq + 4, id: reply },
    ]
    case "pane-wiki": return [{ type: "PaneOpened" as const, seq: seq + 1, id: n % 2 === 0 ? "" : post, url: `/wiki/${pages[n % pages.length]!.id}` }]
    case "pane-other": return [{ type: "PaneOpened" as const, seq: seq + 1, id: "", url: "/sandbox" }]
    case "action": return [{ type: "ActionRequested" as const, seq: seq + 1, id: `run-${seq}`, flow: "vibelang/Post", door: "agent", actor: "agent", at: n }]
    case "gap": return [{ type: "PaneOpened" as const, seq: seq + 2, id: "", url: "/sandbox" }]
  }
}

/**
 * Conversation events arriving on the stream: an answer that links an issue refreshes the issues projection and no other
 * answer does, a wiki pane follows the page and shrinks maximized sandboxes, a pane elsewhere closes an unsaved editor on
 * another page, an agent's action request is read, and a gap resumes the stream.
 */
it.live("web/conversation-events", () => run("web/conversation-events", Happenings, ({ session: id, role, happenings }) => Effect.provide(effect {
  const session = try signedIn(`v${id}`, role)
  for (const happening of happenings) {
    if (happening.sandbox) for (const message of try Effect.try(() => [Message.ClickedSandboxes(), Message.MaximizedSandboxes()])) try session.send(message)
    if (happening.edit) for (const message of gesture(session.model(), { op: "edit-wiki", n: happening.n, text: "" })) try session.send(message)
    const events = eventsOf(session.model(), happening)
    for (const [index, event] of events.entries()) {
      const before = session.model()
      const answer = try Effect.try(() => update(before, Message.ReceivedEvent({ event })))
      const names = (answer.commands ?? []).map((command) => command.name)
      const last = index === events.length - 1
      if (happening.kind === "gap") {
        if (answer.model.epoch !== before.epoch + 1 || answer.model.client.conversation.seq !== before.client.conversation.seq) return false
      }
      if (last && (happening.kind === "answer" || happening.kind === "answer-issue")) {
        if (names.includes("RefreshIssueProjection") !== (happening.kind === "answer-issue")) return false
      }
      if (happening.kind === "pane-wiki") {
        if (!names.includes("WikiLocation") || before.sandboxPane === "max" && answer.model.sandboxPane !== "pane") return false
        const page = event.type === "PaneOpened" ? event.url.slice("/wiki/".length) : ""
        if (before.wikiEdit !== undefined && before.wikiEdit.submission === undefined && before.wikiEdit.page !== page && answer.model.wikiEdit !== undefined) return false
      }
      if (happening.kind === "pane-other" && (answer.model.wikiStatus !== "ready" || answer.model.wikiAfter !== "")) return false
      if (happening.kind === "action" && !names.includes("ReadAction")) return false
      try session.send(try Effect.try(() => Message.ReceivedEvent({ event })))
    }
  }
  return true
}, backend("mock", role))))

const AT = ["current", "stale", "next"] as const
const Answer = Schema.Union([
  Schema.Struct({ kind: Schema.Literals(["wiki-began", "wiki-completed", "wiki-failed"]), at: Schema.Literals(AT), otherPage: Schema.Boolean, text: TextOrBoundary, reason: Schema.Literals(["unavailable", "conflict", "connect", "forbidden", "unknown", "nope"]), flag: Schema.Boolean }),
  Schema.Struct({ kind: Schema.Literals(["submit-wiki", "edit-base", "clicked-issues", "escape", "retry-post", "edit-wiki", "wiki-opened", "post-failed"]) }),
  Schema.Struct({ kind: Schema.Literal("open-wiki"), page: Schema.Literals(pages.map((page) => page.id)) }),
  Schema.Struct({ kind: Schema.Literal("wiki-open-failed"), at: Schema.Literals(AT) }),
  Schema.Struct({ kind: Schema.Literal("type-wiki"), text: TextOrBoundary }),
  Schema.Struct({ kind: Schema.Literal("draft-editor"), page: Schema.Literals(pages.map((page) => page.id)) }),
  Schema.Struct({ kind: Schema.Literal("post"), text: TextOrBoundary }),
  Schema.Struct({ kind: Schema.Literal("forget") }),
  Schema.Struct({ kind: Schema.Literal("issues-failed"), reason: Schema.Literals(["connect", "fork", "install", "unavailable", "forbidden", "nope"]), op: Schema.optionalKey(IssueOperation), retryKey: Schema.Boolean, flag: Schema.Boolean }),
  Schema.Struct({ kind: Schema.Literals(["issue-details-failed", "issue-details-loaded"]), selected: Schema.Boolean, older: Schema.Boolean }),
  Schema.Struct({ kind: Schema.Literal("failed-media"), src: TextOrBoundary, video: Schema.Boolean }),
  Schema.Struct({ kind: Schema.Literal("wiki-location"), page: Schema.Union([Schema.Literals(["/", "/docs", "/wiki/nope"]), Schema.Literals(pages.map((page) => `/wiki/${page.id}`))]) }),
  Schema.Struct({ kind: Schema.Literal("slash"), pick: Schema.Literals(["mode/live", "mode/mock", "mode/nope", "first", "vibelang/Tour", "submit"]), text: TextOrBoundary }),
])
type Answer = typeof Answer.Type
/** Optional Model fields a saved or older Model may lack; update must read their absence as their initial value. */
const OPTIONAL = ["failedMedia", "wikiPages", "wikiSerial", "wikiEditRequest", "wikiRequest", "sandboxRequest", "actions", "issues", "tourClient", "wikiStatus"] as const
const Answers = Schema.Struct({ session: Int, role: Role, wiki: WikiFault, strip: Schema.Array(Schema.Literals(OPTIONAL)).check(Schema.isMaxLength(4)), steps: Schema.Array(Schema.Struct({ op: Opener, n: Int, text: TextOrBoundary })).check(Schema.isMaxLength(8)), answers: Schema.Array(Answer).check(Schema.isMinLength(1), Schema.isMaxLength(16)) })

/** The answer a Command would send back to this screen: for the request it is waiting on, an older one, or a newer one. */
function answerOf(model: Model, answer: Answer): ReadonlyArray<Message> {
  const editing = model.wikiEdit
  const current = model.wikiEditRequest ?? 0
  switch (answer.kind) {
    case "wiki-began": case "wiki-completed": case "wiki-failed": {
      const request = answer.at === "current" ? current : answer.at === "stale" ? current - 1 : current + 1
      const page = editing === undefined || answer.otherPage ? "fuzz-other" : editing.page
      if (answer.kind === "wiki-began") return [Message.BeganWikiEdit({ request, page, source: answer.text, draft: answer.flag ? answer.text : "" })]
      if (answer.kind === "wiki-completed") return [Message.CompletedWikiEdit({ request, page, source: answer.text, revision: "r", review: answer.flag ? "https://github.invalid/pull/1" : "" })]
      return [Message.FailedWikiEdit({ request, reason: answer.reason, ...(answer.flag ? { unwritten: true } : {}) })]
    }
    case "submit-wiki": return [Message.SubmittedWikiEdit()]
    case "edit-wiki": return [Message.ClickedEditWiki()]
    case "wiki-opened": return [Message.SucceededWiki()]
    case "open-wiki": return [Message.ClickedWiki({ page: answer.page })]
    case "type-wiki": return [Message.UpdatedWikiEdit({ value: answer.text })]
    case "draft-editor": return [Message.ClickedWikiDraft({ page: answer.page })]
    case "post": return [Message.UpdatedDraft({ value: answer.text }), Message.SubmittedDraft()]
    case "forget": return []
    case "wiki-open-failed": {
      const latest = model.wikiRequest ?? 0
      return [Message.FailedWiki({ request: answer.at === "current" ? latest : answer.at === "stale" ? latest - 1 : latest + 1 })]
    }
    case "edit-base": return editing === undefined ? [] : [Message.UpdatedWikiEdit({ value: editing.base })]
    case "clicked-issues": return [Message.ClickedIssues()]
    case "escape": return [Message.PressedEscape()]
    case "retry-post": return [Message.ClickedRetry({ clientId: model.client.pending[0]?.clientId ?? "fuzz-none" })]
    case "post-failed": return [Message.FailedPost({ clientId: model.client.pending[0]?.clientId ?? "fuzz-none", reason: "unavailable" })]
    case "issues-failed": {
      const retry = model.issues?.retry
      return [Message.IssuesFailed({ reason: answer.reason, ...(answer.op === undefined ? {} : { op: answer.retryKey && retry !== undefined ? retry.op : answer.op }), ...(answer.retryKey && retry !== undefined ? { key: retry.key } : {}), ...(answer.flag ? { unwritten: true } : {}) })]
    }
    case "issue-details-failed": case "issue-details-loaded": {
      const issues = model.issues
      const number = issues === undefined ? 1 : answer.selected ? issues.selected : issues.selected + 1
      if (answer.kind === "issue-details-failed") return [Message.IssueDetailsFailed({ number })]
      const data = issues?.data
      // Issue states number from 0 (`Seq`): at 0 there is no older state to answer with.
      return data === undefined || answer.older && data.seq === 0 ? [] : [Message.IssueDetailsLoaded({ number, data: { ...data, seq: answer.older ? data.seq - 1 : data.seq } })]
    }
    case "failed-media": return [Message.FailedMedia({ src: answer.src, kind: answer.video ? "video" : "image" })]
    case "wiki-location": return [Message.WikiLocationChanged({ page: answer.page })]
    case "slash": {
      const first = actionsOf(model).commands[0]?.name ?? "vibelang/Post"
      const typed = answer.pick === "first" ? `/${first} ${answer.text}` : answer.pick.startsWith("mode/") ? `/${answer.pick.slice(5)}` : `/${answer.text}`
      return [Message.UpdatedDraft({ value: typed }), answer.pick === "submit" ? Message.SubmittedDraft() : Message.PickedSlash({ name: answer.pick === "first" ? first : answer.pick })]
    }
  }
}

/** A chat draft's review opens the editor, then its load answers: one gesture and the answer its Command sends. */
function expanded(answer: Answer): ReadonlyArray<Answer> {
  if (answer.kind !== "draft-editor") return [answer]
  return [answer, { kind: "wiki-began", at: "current", otherPage: false, text: "Source.", reason: "nope", flag: true }]
}

/** `model` without the `strip` fields whose absence the Model schema allows. */
function stripped(model: Model, strip: ReadonlyArray<typeof OPTIONAL[number]>): Model {
  let result = model
  for (const key of strip) {
    const { [key]: _, ...rest } = result
    if (Schema.is(Model)(rest)) result = rest as Model
  }
  return result
}

/** Answers that must leave the screen exactly as it was: a reply to a request the screen is no longer waiting on. */
function stale(model: Model, answer: Answer): boolean {
  switch (answer.kind) {
    case "wiki-began": case "wiki-completed": case "wiki-failed": return model.wikiEdit === undefined || answer.at !== "current" || answer.kind !== "wiki-failed" && answer.otherPage
    case "issue-details-failed": return model.issues === undefined || !answer.selected
    case "issue-details-loaded": return model.issues === undefined || !answer.selected || answer.older
    default: return false
  }
}

/**
 * Screens built the way a person reaches them, then the answers their Commands send back, in any order and while
 * other Commands are still outstanding (update alone, nothing settles), from a Model that may lack its optional fields.
 * An answer to a request the screen no longer waits on (an older or newer wiki request, another page, another issue,
 * older details) changes nothing; every answer leaves a valid Model and a view transition the runtime can apply.
 */
it.live("web/screen-answers", () => run("web/screen-answers", Answers, ({ session: id, role, wiki, strip, steps, answers }) => Effect.provide(effect {
  const session = try signedIn(`a${id}`, role)
  for (const step of steps) {
    if (step.op === "edit-wiki" || step.op === "wiki-save") {
      try session.send((try Effect.try(() => opener(session.model(), step)))[0]!)
      try pump(session)
    }
    for (const message of try Effect.try(() => opener(session.model(), step))) try session.send(message)
    if (step.op === "wiki") try pump(session)
  }
  let model = stripped(session.model(), strip)
  for (const answer of answers.flatMap(expanded)) {
    if (answer.kind === "forget") model = stripped(model, OPTIONAL)
    for (const message of try Effect.try(() => answerOf(model, answer))) {
      const before = model
      const next = try Effect.try(() => update(before, message))
      if (stale(before, answer) && next.model !== before) throw new Finding({ report: `${message._tag}: an answer for another request changed the screen` })
      if (!Schema.is(Model)(next.model)) throw new Finding({ report: `${message._tag}: left an invalid Model` })
      try Effect.try(() => viewTransition({ previousModel: before, model: next.model, message }))
      model = next.model
    }
  }
  return true
}, backendWithWiki(role, wiki))))

const Count = (maximum: number) => Schema.Int.check(Schema.isBetween({ minimum: 0, maximum }))
const PostRetries = Schema.Struct({ session: Int, role: Role, texts: Schema.Array(Text).check(Schema.isMinLength(1), Schema.isMaxLength(3)), failures: Count(4), lost: Schema.Boolean, rounds: Count(4), stray: Schema.Boolean })

/**
 * Posts whose first answers fail, some after the server stored them, then retried by the person. Retry clears the
 * post's error at once and resends the same text; a Retry for no failed post changes nothing; no post is lost; and no
 * post is received twice.
 */
it.live("web/post-retry", () => run("web/post-retry", PostRetries, ({ session: id, role, texts, failures, lost, rounds, stray }) => Effect.provide(effect {
  const session = try signedIn(`p${id}`, role)
  const sent: Array<string> = []
  for (const text of texts) {
    try session.send(try Effect.try(() => Message.UpdatedDraft({ value: text })))
    const known = new Set(session.model().client.pending.map((waiting) => waiting.clientId))
    try session.send(try Effect.try(() => Message.SubmittedDraft()))
    for (const waiting of session.model().client.pending) if (!known.has(waiting.clientId)) sent.push(waiting.clientId)
  }
  for (let round = 0; round <= rounds; round++) {
    if (stray) {
      const before = session.model()
      try session.send(try Effect.try(() => Message.ClickedRetry({ clientId: "fuzz-no-post" })))
      if (session.model() !== before) throw new Finding({ report: "a Retry for no failed post changed the screen" })
    }
    for (const waiting of session.model().client.pending.filter((post) => post.error !== "")) {
      try session.hold(try Effect.try(() => Message.ClickedRetry({ clientId: waiting.clientId })))
      const retried = session.model().client.pending.find((post) => post.clientId === waiting.clientId)
      if (retried === undefined || retried.error !== "" || retried.text !== waiting.text) throw new Finding({ report: "Retry did not resend the failed post as it was" })
      try session.settle
    }
    try pump(session)
  }
  const model = session.model()
  const received = model.client.conversation.entries.map((entry) => entry.clientId).filter((clientId) => sent.includes(clientId))
  if (new Set(received).size !== received.length) throw new Finding({ report: "a retried post was received twice" })
  for (const clientId of sent) {
    if (!received.includes(clientId) && !model.client.pending.some((post) => post.clientId === clientId)) throw new Finding({ report: "a post was lost" })
  }
  return true
}, backendWithFailingPosts(role, failures, lost))))

/** Reset months move forward: an answer keeps the month or starts the next one. */
const MONTHS = [Date.UTC(2026, 10, 1), Date.UTC(2026, 11, 1), Date.UTC(2027, 0, 1), Date.UTC(2027, 1, 1)]
const MinuteAnswer = Schema.Struct({
  snapshot: Schema.Struct({ ...SandboxSnapshot.fields, id: Schema.Literals(["", "fuzz-sandbox"]), remaining: Count(12) }),
  nextMonth: Schema.Boolean, stale: Schema.Boolean,
})
const MinuteAnswers = Schema.Struct({ session: Int, role: Role, answers: Schema.Array(MinuteAnswer).check(Schema.isMinLength(1), Schema.isMaxLength(10)) })

/**
 * Sandbox answers near the end of the month's minutes, while a sandbox request is out. A sandbox stopped with no minutes
 * says so and names itself; minutes first running low in a month show how many are left, once; a new month with
 * minutes to spare clears the notice; an answer for another request changes nothing.
 */
it.live("web/sandbox-minutes", () => run("web/sandbox-minutes", MinuteAnswers, ({ session: id, role, answers }) => Effect.provide(effect {
  const session = try signedIn(`m${id}`, role)
  try session.hold(try Effect.try(() => Message.StartedSandbox()))
  let model = session.model()
  let month = 0
  const lows = new Set<number>()
  for (const answer of answers) {
    if (answer.nextMonth) month = Math.min(month + 1, MONTHS.length - 1)
    const snapshot = { ...answer.snapshot, resetAt: MONTHS[month]! }
    const before = model
    const request = (before.sandboxRequest ?? 0) + (answer.stale ? 1 : 0)
    const next = try Effect.try(() => update(before, Message.LoadedSandbox({ conversation: before.conversation, request, snapshot })))
    if (answer.stale) {
      if (next.model !== before) throw new Finding({ report: "a sandbox answer for another request changed the screen" })
      continue
    }
    model = next.model
    if (!Schema.is(Model)(model)) throw new Finding({ report: "LoadedSandbox left an invalid Model" })
    const notice = model.minuteNotice ?? ""
    const out = snapshot.remaining === 0 && snapshot.id !== "" && snapshot.status === "stopped"
    if (out && !(notice.startsWith("Out of minutes") && notice.includes(snapshot.id))) throw new Finding({ report: "a sandbox stopped out of minutes did not say so" })
    const low = !out && snapshot.remaining > 0 && snapshot.remaining <= 10
    if (low && !lows.has(snapshot.resetAt)) {
      if (notice !== `${snapshot.remaining} minutes left`) throw new Finding({ report: "minutes ran low and no notice said how many were left" })
      lows.add(snapshot.resetAt)
    } else if (!out && notice !== "" && notice !== (before.minuteNotice ?? "")) throw new Finding({ report: "a minutes notice appeared without minutes newly running low" })
    if (!out && snapshot.remaining > 10 && before.sandbox !== undefined && before.sandbox.resetAt !== snapshot.resetAt && notice !== "") throw new Finding({ report: "a new month with minutes to spare kept the notice" })
  }
  return true
}, backend("mock", role))))
