// src/web/main.vibe's arms that only a particular backend answer, page or message order reaches: Commands answered by
// a missing, failing, reversed or role-less service; update over the tour, sandbox and actions states those answers
// leave; and the DOM Commands over a real happy-dom page. Each scenario is chosen, not drawn from a large union, so a
// short budget runs every one (0015, fifteenth session).
import { it } from "@effect/vitest"
import { ExperimentalBrowserWindow, ExperimentalBrowserDocument } from "vibelang-runtime/experimental/platform-browser"
import { Factory, Refused, Unavailable } from "../src/core/Factory.vibe"
import { IssueFailure, IssueRequest } from "../src/core/issueSchemas.vibe"
import { WALKTHROUGH } from "../src/core/walkthroughSteps.vibe"
import { pages, wikiEditable } from "../src/core/wiki.vibe"
import { Actions, ActionFailure } from "../src/actions/Actions.vibe"
import { actionsOf } from "../src/web/actionModel.vibe"
import {
  accountOf, ActOnIssue, ControlTourCommand, Flags, GrantRole, init, issueStateOf, LoadActions, LoadIssues, LoadPeople, Message, Model, OpenWikiCommand, OpenWikiEditor,
  EndTourCommand, LoadIssueDetails, ReadAction, RefreshIssueProjection, RevealWiki, RunAction, SandboxAction, SignInAccount, SignOutAccount, StartTourCommand, SubmitWikiEdit, subscriptions, update,
  walkthroughSession, WikiLocation,
} from "../src/web/main.vibe"
import { backend, backendChanged, backendWithWiki, Role } from "./web-backends.vibe"
import { TOUR_ID, tourStop } from "./web-tab.vibe"
import { run, same, stepped, Finding, Int, REPLAY_FLOOR, Text } from "./run.vibe"

const fault = (reason: string) => fail(new Unavailable({ reason }))
const refuse = (refusal: string) => fail(new Refused({ refusal }))

/** The mock backend with each failing member answering the other typed failure than `faulty` does. */
function reversed(role: typeof Role.Type) {
  return backendChanged(role, () => ({ tour: () => fault("fault"), sandbox: () => refuse("busy"), startSandbox: () => fault("fault"), stopSandbox: () => refuse("busy"), sandboxCommand: () => fault("fault") }))
}
/** The mock seen as live, its issue writes failing without being unwritten: the resume address stays. */
function liveKept(role: typeof Role.Type) {
  return backendChanged(role, (factory) => ({ mode: "live", issues: Object.assign(Object.create(factory.issues!), { act: () => fail(new IssueFailure({ reason: "unavailable" })) }) }))
}
/** The mock whose wiki holds the person's draft of another page. */
function otherDraft(role: typeof Role.Type) {
  return backendChanged(role, (factory) => ({ wiki: Object.assign(Object.create(factory.wiki!), { read: (page: string) => map(factory.wiki!.read(page), (snapshot) => ({ ...snapshot, draft: { page: `${page}-other`, text: "# Other" } })) }) }))
}

/** The page's address, as the Commands read and write it. */
effect function location() {
  const window = try (try Experimental.Window.Window).current
  return window.location.pathname + window.location.search + window.location.hash
}
effect function goTo(url: string) {
  const window = try (try Experimental.Window.Window).current
  try Effect.try(() => window.history.replaceState(null, "", url))
}

/** A real issue number from the backend's own records, or 0 when it has none. */
effect function issueNumber(pick: number) {
  const loaded = try answer(() => LoadIssues({}))
  const items = loaded._tag === "IssuesLoaded" ? loaded.data.items : []
  return items[pick % Math.max(1, items.length)]?.number ?? 0
}

type AnyCommand = { readonly name: string; readonly effect: Effect.Effect<unknown, unknown, Factory | Actions> }

/** Builds a Command and runs it once: it must answer one of the program's Messages. */
effect function answer(make: () => AnyCommand) {
  const command = try Effect.try(make)
  const result = try exit(timeout(command.effect, "5 seconds"))
  if (result._tag === "Failure") throw new Finding({ report: `${command.name}: ${Cause.pretty(result.cause)}` })
  if (!Schema.is(Message)(result.value)) throw new Finding({ report: `${command.name}: answered with an undeclared Message` })
  return result.value as Message
}

const SCENARIOS = [
  "load-bare", "load-faulty", "load-roleless", "load-resumed", "act-live-kept", "act-live", "act-bare", "refresh-bare", "refresh-faulty", "grant",
  "sign-out-bare", "sign-out-faulty", "tour-unreachable", "tour-refused", "sandbox-poll-refused", "sandbox-start-unreachable", "editor-other-draft", "roles-bare", "roles-faulty", "roles-closing", "follow-lost", "sign-in-live",
  "control-tour", "read-action", "actions-faulty-epoch", "act-roleless", "draft-link", "theatre-keys", "auto-tour", "tour-events",
  "wiki-bare", "wiki-unlisted", "details-bare", "sign-in-mock", "wiki-link",
  "end-tour", "run-without-epoch", "issue-count", "details-mock",
  "sandbox-poll-unreachable", "open-wiki", "grant-bare", "run-json-blank", "people-bare", "people-faulty",
] as const

type Entries = Record<string, {
  readonly modelToDependencies: (model: Model) => unknown
  readonly dependenciesToStream: (dependencies: unknown, read: () => unknown) => Stream.Stream<Message, never, Factory | Actions>
}>

/** One subscription's stream for `dependencies`, as the runtime starts it over this page. */
effect function subscription(name: string, dependencies: unknown) {
  const document = try (try Experimental.Document.Document).current
  const entry = (subscriptions(document, document) as unknown as Entries)[name]!
  return entry.dependenciesToStream(dependencies, () => dependencies)
}
/** A subscription's stream as the runtime starts it for `model`. */
effect function subscriptionOf(name: string, model: Model) {
  const document = try (try Experimental.Document.Document).current
  const entry = (subscriptions(document, document) as unknown as Entries)[name]!
  const dependencies = entry.modelToDependencies(model)
  return entry.dependenciesToStream(dependencies, () => dependencies)
}

/** The stream's first Message while `fire` runs every millisecond: firing until it answers outlasts the listener's attach. */
effect function firstWhileFiring(stream: Stream.Stream<Message, never, never>, fire: () => void) {
  const fiber = fork Stream.runHead(stream)
  const got = try Effect.timeoutOption(effect {
    while (fiber.pollUnsafe() === undefined) {
      try Effect.try(fire)
      try sleep("1 millis")
    }
    return try Fiber.join(fiber)
  }, "5 seconds")
  if (Option.isNone(got)) {
    try Fiber.interrupt(fiber)
    throw new Finding({ report: "a subscription answered nothing within 5 seconds" })
  }
  return got.value
}

const FLAGS: typeof Flags.Type = { session: "00000000-0000-4000-8000-000000000000", mode: "mock", name: "fuzz" }

type DomConstructors = Record<"KeyboardEvent" | "MouseEvent", new (type: string, init?: object) => Event>

const CommandArms = Schema.Struct({ role: Role, number: Int, key: Schema.Literals(["k-1", "k-2", "resume-k"]), recovery: Schema.Literals(["r-1", "s-9"]), text: Text })

/**
 * Each scenario runs one Command against the backend it names and checks its answer: a missing or failing issues service
 * answers IssuesFailed (or IssueDialogFocused for a refresh); a role-less answer takes the mock's default role; a live
 * write that completes leaves the address at `/?issues=1`, and one kept unwritten leaves the resume address with its
 * recovery; a resumed load of a completed write does the same; a maintainer's grant to a member answers GrantedRole;
 * signing out without accounts answers the viewer; signing in live goes to the sign-in route; an unreachable tour
 * names its reason and a refused one its refusal; a refused sandbox read names its refusal; another page's draft
 * never fills the editor; a role stream without an accounts service sends nothing, and a failing or ended one sends
 * FailedRoles once; a lost action follow reports disconnection; explicit reconnect delivers the run. A tour control that is
 * done or refused keeps the tour's connection, and one unreachable or without controls loses it; reading a started run
 * answers it; a failing actions load names its epoch; an issue write answered without a role takes the mode's default.
 * Over the page: a left click on a chat draft link of a built page reviews that draft, and one of another page does
 * nothing; during a tour Tab, Space and the arrows move, pause and step it and Command-K focuses the prompt, while
 * other keys do nothing; the automatic tour starts after its delay; a lost tour stream follows again two seconds later.
 * Without a wiki service the editor's read and write fail unavailable; a write answered without its page or a review
 * completes with neither; issue details without an issues service fail; a mock sign-in without accounts is the viewer
 * and with failing accounts fails; a left click on a wiki link opens its page and one elsewhere does nothing. A start
 * answered for an earlier actions epoch changes nothing. An end of the tour that is done or refused gives the prompt
 * back and one that never reached the agent fails; a run started without an epoch answers without one and one with an epoch names it; the issue count
 * without an issues service focuses the dialog and with one loads the projection; issue details of a real issue load.
 * An unreachable sandbox read names its reason; opening a wiki page succeeds over the mock and fails with its request
 * number over a failing backend; a grant without accounts fails; a blank JSON action input starts the run with an empty
 * object, and unreadable JSON fails as input.
 */
effect function commandHolds(scenario: typeof SCENARIOS[number], input: typeof CommandArms.Type) {
  const role = input.role
  try goTo("/")
  switch (scenario) {
    case "load-bare": case "load-faulty": case "load-roleless": {
      const layer = scenario === "load-bare" ? backend("bare", role) : scenario === "load-faulty" ? backend("faulty", role) : backend("roleless", role)
      const got = try Effect.provide(answer(() => LoadIssues({})), layer)
      if (scenario === "load-roleless") return got._tag === "IssuesLoaded" && got.role === "maintainer"
      return got._tag === "IssuesFailed" && got.reason === "unavailable"
    }
    case "load-resumed": {
      // A reload resumes a write by its key. The live server answers with that write's saved state (the mock keeps
      // none, so this backend answers as the server does): a completed write returns the address to the issues list.
      const status = input.key === "k-1" ? "completed" as const : input.key === "k-2" ? "running" as const : "failed" as const
      const resumed = backendChanged("maintainer", (factory) => ({
        mode: "live",
        issues: Object.assign(Object.create(factory.issues!), {
          act: (request: typeof IssueRequest.Type) => request.resumeKey === undefined ? factory.issues!.act(request) : map(factory.issues!.read(), (state) => ({
            ...state, saved: { request: { ...request, op: "comment" as const, key: request.resumeKey! }, status, unwritten: false, selected: input.number },
          })),
        }),
      }))
      try goTo(`/?issues=1&resume-op=comment&resume-key=${input.key}`)
      const got = try Effect.provide(answer(() => LoadIssues({ resumeOp: "comment", resumeKey: input.key, ...(input.recovery === "r-1" ? { resumeRecovery: input.recovery } : {}) })), resumed)
      if (got._tag !== "IssuesLoaded" || got.data.saved?.status !== status) return false
      return (status === "completed") === ((try location()) === "/?issues=1")
    }
    case "act-live-kept": case "act-live": {
      const layer = scenario === "act-live-kept" ? liveKept("maintainer") : backendChanged("maintainer", () => ({ mode: "live" }))
      const got = try Effect.provide(effect {
        const request = { op: "comment" as const, number: try issueNumber(input.number), parent: 0, title: "", text: "Looks right.", assignee: "", example: "", prior: "", key: input.key, recovery: input.recovery }
        return try answer(() => ActOnIssue({ request }))
      }, layer)
      const at = try location()
      if (scenario === "act-live") return got._tag === "IssuesLoaded" && at === "/?issues=1"
      return got._tag === "IssuesFailed" && at === `/?issues=1&resume-op=comment&resume-key=${input.key}&resume-recovery=${input.recovery}`
    }
    case "act-bare": {
      const request = { op: "comment" as const, number: 1, parent: 0, title: "", text: "x", assignee: "", example: "", prior: "", key: input.key }
      const got = try Effect.provide(answer(() => ActOnIssue({ request })), backend("bare", role))
      return got._tag === "IssuesFailed" && got.reason === "unavailable"
    }
    case "refresh-bare": case "refresh-faulty": {
      const got = try Effect.provide(answer(() => RefreshIssueProjection({})), backend(scenario === "refresh-bare" ? "bare" : "faulty", role))
      return got._tag === "IssueDialogFocused"
    }
    case "grant": {
      provide backend("mock", "maintainer") {
        const people = try answer(() => LoadPeople({}))
        if (people._tag !== "LoadedPeople") return false
        const member = people.members[input.number % Math.max(1, people.members.length)]
        if (member === undefined) return true
        const got = try answer(() => GrantRole({ id: member.id, role: role === "viewer" ? "community" : role }))
        return got._tag === "GrantedRole"
      }
    }
    case "people-bare": case "people-faulty": {
      // Without an accounts service there is nobody to list: People loads empty, not as a failure. A service that
      // fails to list makes People fail.
      const got = try Effect.provide(answer(() => LoadPeople({})), backend(scenario === "people-bare" ? "bare" : "faulty", role))
      return scenario === "people-bare" ? got._tag === "LoadedPeople" && got.members.length === 0 : got._tag === "AccountFailed"
    }
    case "sign-out-bare": case "sign-out-faulty": {
      const got = try Effect.provide(answer(() => SignOutAccount({})), backend(scenario === "sign-out-bare" ? "bare" : "faulty", role))
      return scenario === "sign-out-bare" ? got._tag === "AccountLoaded" && got.identity.id === "" && got.identity.role === "viewer" : got._tag === "AccountFailed"
    }
    case "sign-in-live": {
      // Live sign-in leaves the page for the server's sign-in route; the mock signs in without leaving.
      const got = try Effect.provide(answer(() => SignInAccount({ mock: false })), backend("live", role))
      return got._tag === "FocusedPrompt" && (try location()) === "/api/auth/sign-in"
    }
    case "tour-unreachable": case "tour-refused": {
      const got = try Effect.provide(answer(() => StartTourCommand({ conversation: "fuzz-tour" })), scenario === "tour-unreachable" ? reversed(role) : backend("faulty", role))
      return got._tag === "FailedTour" && got.reason === (scenario === "tour-unreachable" ? "fault" : "busy")
    }
    case "sandbox-poll-refused": {
      provide reversed(role) {
        const got = try Stream.runHead(try subscription("sandbox", { conversation: "fuzz-sandbox", request: input.number, active: true, live: false, finished: 0 }))
        return Option.isSome(got) && got.value._tag === "FailedSandbox" && got.value.reason === "busy" && got.value.request === input.number
      }
    }
    case "sandbox-start-unreachable": {
      const got = try Effect.provide(answer(() => SandboxAction({ conversation: "fuzz-sandbox", operationId: "op-1", request: input.number, kind: "start", generation: 0, command: "" })), reversed(role))
      return got._tag === "FailedSandbox" && got.reason === "fault"
    }
    case "roles-bare": case "roles-faulty": case "roles-closing": {
      // A signed-in person's role stream: none without an accounts service; a failing or ended stream says so once.
      const layer = backend(scenario === "roles-bare" ? "bare" : scenario === "roles-faulty" ? "faulty" : "closing", role)
      const got = try Effect.provide(effect { return Array.from(try Stream.runCollect(try subscription("roles", { person: `p${input.number}`, epoch: 0, from: input.number }))) }, layer)
      return scenario === "roles-bare" ? got.length === 0 : got.length === 1 && got[0]!._tag === "FailedRoles"
    }
    case "follow-lost": {
      // A lost follow reports its run; reconnect replaces the generation and reads the real run.
      // A maintainer starts the run; the mock refuses to start one for a role below it.
      provide backend("mock", "maintainer") {
        const actions = try Actions
        const id = try actions.start("vibelang/Tour", {}, "button")
        let follows = 0
        const flaky = Object.assign(Object.create(actions) as Actions.Shape, { follow: (run: string) => follows++ === 0 ? Stream.fail(new ActionFailure({ code: "fault" })) : actions.follow(run) })
        const services = Layer.merge(Layer.succeed(Actions, flaky), Layer.succeed(Factory, try Factory))
        const run = try actions.read(id)
        const home = init(FLAGS).model
        const model: Model = { ...home, actions: { ...actionsOf(home), runs: [run] } }
        const stream = try subscriptionOf("actionRuns", model)
        const got = try Effect.provide(Stream.runHead(stream), services)
        if (Option.isNone(got) || got.value._tag !== "FailedActionFollow") return false
        const lost = update(model, got.value).model
        if (!actionsOf(lost).disconnected?.includes(id)) return false
        const again = try Effect.try(() => update(lost, Message.ReconnectedActions()).model)
        const recovered = try Effect.provide(Stream.runHead(try subscriptionOf("actionRuns", again)), services)
        if (Option.isNone(recovered) || recovered.value._tag !== "FollowedAction" || recovered.value.run.id !== id) return false
        return follows === 2 && actionsOf(update(again, recovered.value).model).disconnected?.length === 0
      }
    }
    case "control-tour": {
      const action = (["pause", "resume", "seek"] as const)[input.number % 3]!
      const answers: Array<string> = []
      for (const control of [() => Effect.void, () => refuse("busy"), () => fault("fault"), undefined]) {
        const got = try Effect.provide(answer(() => ControlTourCommand({ conversation: "fuzz-tour", action, step: input.number % 10 + 1 })), backendChanged(role, () => ({ controlTour: control })))
        answers.push(got._tag)
      }
      return same(answers, ["FocusedPrompt", "FocusedPrompt", "FailedTourEvents", "FailedTourEvents"])
    }
    case "read-action": {
      provide backend("mock", "maintainer") {
        const id = try (try Actions).start("vibelang/Post", { text: "q" }, "button")
        const got = try answer(() => ReadAction({ id }))
        if (got._tag !== "ChangedAction" || got.run.id !== id) return false
        const base = init(FLAGS).model
        const model: Model = { ...base, actions: { ...actionsOf(base), epoch: input.number + 1 } }
        const late = try Effect.try(() => update(model, Message.StartedAction({ run: got.run, epoch: input.number })))
        return late.model === model && names(late).length === 0
      }
    }
    case "actions-faulty-epoch": {
      const got = try Effect.provide(answer(() => LoadActions({ flow: "", epoch: input.number })), backend("faulty", role))
      return got._tag === "FailedActions" && got.code === "fault" && got.epoch === input.number
    }
    case "act-roleless": {
      provide backend("roleless", "maintainer") {
        const request = { op: "comment" as const, number: try issueNumber(input.number), parent: 0, title: "", text: "Looks right.", assignee: "", example: "", prior: "", key: input.key }
        const got = try answer(() => ActOnIssue({ request }))
        return got._tag === "IssuesLoaded" && got.role === "maintainer"
      }
    }
    case "draft-link": {
      const document = try (try Experimental.Document.Document).current
      const window = try (try Experimental.Window.Window).current
      const editable = pages.filter((entry) => wikiEditable(entry.id))
      const page = editable[input.number % editable.length]!.id
      const links = try acquireRelease(Effect.try(() => {
        const bubble = document.createElement("div")
        bubble.className = "sui-chat-bubble"
        bubble.innerHTML = `<a href="#wiki-draft-not-a-page">n</a><a href="#wiki-draft-${page}">d</a>`
        document.body.append(bubble)
        return { bubble, other: bubble.querySelectorAll("a")[0]!, draft: bubble.querySelectorAll("a")[1]! }
      }), (links) => sync(() => links.bubble.remove()))
      const dom = window as unknown as DomConstructors
      const stream = Stream.provide(try subscriptionOf("wikiDraftLinks", init(FLAGS).model), backend("mock", role))
      const got = try firstWhileFiring(stream, () => {
        links.other.dispatchEvent(new dom.MouseEvent("click", { button: 0, bubbles: true, cancelable: true }))
        links.draft.dispatchEvent(new dom.MouseEvent("click", { button: 0, bubbles: true, cancelable: true }))
      })
      return Option.isSome(got) && got.value._tag === "ClickedWikiDraft" && got.value.page === page
    }
    case "theatre-keys": {
      const document = try (try Experimental.Document.Document).current
      const window = try (try Experimental.Window.Window).current
      const dom = window as unknown as DomConstructors
      const backward = input.number % 2 === 1
      const presses = [
        [{ key: "Tab", shiftKey: backward }, "MovedTourFocus"], [{ key: " " }, "ClickedPauseTour"], [{ key: "ArrowLeft" }, "ClickedBackStop"],
        [{ key: "ArrowRight" }, "ClickedSkipStop"], [{ key: "k", metaKey: true }, "FocusedPrompt"],
      ] as const
      const touring: Model = { ...init(FLAGS).model, tour: true }
      for (const [press, expected] of presses) {
        const stream = Stream.provide(try subscriptionOf("theatreKeys", touring), backend("mock", role))
        const key = (init: object) => document.dispatchEvent(new dom.KeyboardEvent("keydown", { ...init, bubbles: true, cancelable: true }))
        // Control-A and a plain letter come first each time; only the press itself may answer.
        const got = try firstWhileFiring(stream, () => { key({ key: "a", ctrlKey: true }); key({ key: "a" }); key(press) })
        if (Option.isNone(got) || got.value._tag !== expected) return false
        if (got.value._tag === "MovedTourFocus" && got.value.backward !== backward) return false
      }
      return true
    }
    case "auto-tour": {
      const stream = try subscription("autoTour", { active: true })
      const got = try stepped(Effect.provide(Stream.runHead(stream), backend("mock", role)), 3)
      return Option.isSome(got) && got.value._tag === "AutoTour"
    }
    case "tour-events": {
      let follows = 0
      const event = { type: "TourStarted" as const, seq: 1, id: TOUR_ID }
      const lostOnce = backendChanged(role, () => ({ events: () => follows++ === 0 ? Stream.fail(new Unavailable({ reason: "fault" })) : Stream.make(event) }))
      const stream = try subscription("tourEvents", { active: true, session: `s${input.number}`, epoch: 0 })
      const got = try stepped(Effect.provide(Stream.runHead(stream), lostOnce), 5)
      return follows === 2 && Option.isSome(got) && got.value._tag === "ReceivedTourEvent" && same(got.value.event, event)
    }
    case "wiki-bare": {
      const page = pages.filter((entry) => wikiEditable(entry.id))[input.number % 2]!.id
      const request = { op: "save" as const, page, base: "# A", text: `# B${input.text}`, key: input.key }
      provide backend("bare", role) {
        const read = try answer(() => OpenWikiEditor({ page, request: input.number }))
        const write = try answer(() => SubmitWikiEdit({ request, serial: input.number }))
        return read._tag === "FailedWikiEdit" && read.reason === "unavailable" && write._tag === "FailedWikiEdit" && write.reason === "unavailable"
      }
    }
    case "wiki-unlisted": {
      const page = pages.filter((entry) => wikiEditable(entry.id))[input.number % 2]!.id
      provide backendWithWiki("maintainer", "unlisted") {
        const opened = try answer(() => OpenWikiEditor({ page, request: input.number }))
        if (opened._tag !== "BeganWikiEdit") return false
        const got = try answer(() => SubmitWikiEdit({ request: { op: "save", page, base: opened.source, text: `${opened.source}\n${input.text.toWellFormed()}x`, key: `${input.key}-${input.number}` }, serial: input.number }))
        return got._tag === "CompletedWikiEdit" && got.revision === "" && got.review === ""
      }
    }
    case "details-bare": {
      const got = try Effect.provide(answer(() => LoadIssueDetails({ number: input.number + 1, key: input.key })), backend("bare", role))
      return got._tag === "IssueDetailsFailed" && got.number === input.number + 1
    }
    case "sign-in-mock": {
      const bare = try Effect.provide(answer(() => SignInAccount({ mock: true })), backend("bare", role))
      const failing = try Effect.provide(answer(() => SignInAccount({ mock: true })), backend("faulty", role))
      return bare._tag === "AccountLoaded" && bare.identity.id === "" && bare.identity.role === "viewer" && failing._tag === "AccountFailed"
    }
    case "wiki-link": {
      const document = try (try Experimental.Document.Document).current
      const window = try (try Experimental.Window.Window).current
      const page = `/wiki/${pages[input.number % pages.length]!.id}`
      const links = try acquireRelease(Effect.try(() => {
        const content = document.createElement("div")
        content.className = "vl-wiki-content"
        content.innerHTML = `<a href="https://example.com/">e</a><a href="${page}">w</a>`
        document.body.append(content)
        return { content, other: content.querySelectorAll("a")[0]!, wiki: content.querySelectorAll("a")[1]! }
      }), (links) => sync(() => links.content.remove()))
      const dom = window as unknown as DomConstructors
      const stream = Stream.provide(try subscriptionOf("wikiLinks", init(FLAGS).model), backend("mock", role))
      const got = try firstWhileFiring(stream, () => {
        links.other.dispatchEvent(new dom.MouseEvent("click", { button: 0, bubbles: true, cancelable: true }))
        links.wiki.dispatchEvent(new dom.MouseEvent("click", { button: 0, bubbles: true, cancelable: true }))
      })
      return Option.isSome(got) && got.value._tag === "ClickedWiki" && got.value.page === page
    }
    case "end-tour": {
      const answers: Array<string> = []
      for (const end of [() => Effect.void, () => refuse("busy"), () => fault("fault")]) {
        const got = try Effect.provide(answer(() => EndTourCommand({ conversation: "fuzz-tour" })), backendChanged(role, () => ({ endTour: end })))
        answers.push(got._tag)
      }
      return same(answers, ["FocusedPrompt", "FocusedPrompt", "FailedEndTour"])
    }
    case "run-without-epoch": {
      provide backend("mock", "maintainer") {
        const got = try answer(() => RunAction({ name: "vibelang/Post", text: "q", door: "button" }))
        const epoched = try answer(() => RunAction({ name: "vibelang/Post", text: "q", door: "button", epoch: input.number }))
        return got._tag === "StartedAction" && !("epoch" in got) && epoched._tag === "StartedAction" && epoched.epoch === input.number
      }
    }
    case "issue-count": {
      const bare = try Effect.provide(effect { return try Stream.runHead(try subscription("issueCount", { active: true })) }, backend("bare", role))
      const mock = try Effect.provide(effect { return try Stream.runHead(try subscription("issueCount", { active: true })) }, backend("mock", role))
      return Option.isSome(bare) && bare.value._tag === "IssueDialogFocused" && Option.isSome(mock) && mock.value._tag === "IssueProjectionLoaded"
    }
    case "details-mock": {
      provide backend("mock", "maintainer") {
        const number = try issueNumber(input.number)
        if (number === 0) return false
        const got = try answer(() => LoadIssueDetails({ number, key: `${input.key}-details` }))
        return got._tag === "IssueDetailsLoaded" && got.number === number
      }
    }
    case "sandbox-poll-unreachable": {
      provide backend("faulty", role) {
        const got = try Stream.runHead(try subscription("sandbox", { conversation: "fuzz-sandbox", request: input.number, active: true, live: false, finished: 0 }))
        return Option.isSome(got) && got.value._tag === "FailedSandbox" && got.value.reason === "fault" && got.value.request === input.number && got.value.polled === true
      }
    }
    case "open-wiki": {
      const page = pages[input.number % pages.length]!.id
      const opened = try Effect.provide(answer(() => OpenWikiCommand({ conversation: "fuzz-wiki", page, request: input.number })), backend("mock", role))
      const failed = try Effect.provide(answer(() => OpenWikiCommand({ conversation: "fuzz-wiki", page, request: input.number })), backend("faulty", role))
      return opened._tag === "SucceededWiki" && failed._tag === "FailedWiki" && failed.request === input.number
    }
    case "grant-bare": {
      const got = try Effect.provide(answer(() => GrantRole({ id: "1", role: "community" })), backend("bare", role))
      return got._tag === "AccountFailed"
    }
    case "run-json-blank": {
      provide backend("mock", "maintainer") {
        const blank = try answer(() => RunAction({ name: "vibelang/Post", text: " \n", door: "button", format: "json" }))
        const broken = try answer(() => RunAction({ name: "vibelang/Post", text: "{", door: "button", format: "json" }))
        return blank._tag === "StartedAction" && broken._tag === "FailedActions" && broken.code === "input"
      }
    }
    case "editor-other-draft": {
      // Only an editable page has a source to edit (the decisions index is built, not stored).
      const editable = pages.filter((entry) => wikiEditable(entry.id))
      const page = editable[input.number % editable.length]!.id
      const got = try Effect.provide(answer(() => OpenWikiEditor({ page, request: input.number })), otherDraft(role))
      return got._tag === "BeganWikiEdit" && got.draft === ""
    }
  }
}

/**
 * Every scenario runs in every execution, so no arm depends on what a short budget happens to draw. One execution runs
 * 45 scenarios (Commands and subscriptions) and takes about a second under coverage, hence the floor.
 */
it.live("web/command-arms", () => run("web/command-arms", CommandArms, (input) => Effect.provide(effect {
  for (const scenario of SCENARIOS) if (!(try commandHolds(scenario, input))) throw new Finding({ report: `${scenario} does not hold` })
  return true
}, Layer.merge(ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer)), undefined, { minimum: REPLAY_FLOOR }))

const UPDATES = [
  "sandbox-busy", "retry-run", "people-max", "tour-repeat", "tour-sought-end-fails", "draft-outside-build",
  "assignees-without-agent", "submit-without-request", "began-stale", "walkthrough-posted", "learn-more-palette", "control-clears-error",
  "pane-closes-editor", "scroll-stale", "tour-gap", "sandbox-polled-failure", "chat-from-splash",
  "account-retries", "sign-in-unavailable", "action-failures", "learn-more-same-conversation",
] as const
const UpdateArms = Schema.Struct({ flags: Flags, step: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 10 })), seek: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 10 })), overlay: Schema.Boolean, text: Text })

function names(result: { readonly commands?: ReadonlyArray<{ readonly name: string }> }): ReadonlyArray<string> {
  return (result.commands ?? []).map((command) => command.name)
}

/**
 * update over the states those answers leave: "/sandbox" while a sandbox action is in flight closes the palette and
 * starts nothing; Run on screen retries the shown run; a wiki pane opening over maximized people shrinks them to the
 * pane; a tour event already applied changes nothing; an end that never reached the agent while a sought stop shows
 * presents that stop at its own target; a draft review for a page outside the build opens no editor, even when the
 * repository's overlay holds the page. A load whose assignees hold neither the saved assignee nor the agent assigns
 * nobody; a submission from an editor whose request number is gone submits under request 0; an editor's fresh read
 * that names a confirmation time keeps it and focuses the editor; the walkthrough's second stop asks the agent unless
 * the walkthrough's own message is already in the conversation; Learn more over the open palette closes it first; a
 * tour control clears the last control's failure. A pane opening another page closes the open editor and one opening
 * its own page keeps it; a scroll older than the last one changes nothing and one as new applies; a tour event past a missed one replays the
 * tour from its start under the next epoch. A polled sandbox read that fails names its reason when no operation waits
 * and changes nothing while one does; Chat on the splash shrinks it and focuses the composer once the conversation
 * has a message, and does nothing before. Retry repeats the failed account command (people, a grant, sign-out) and
 * resumes a lost role stream under the next epoch, and each failure names its own words; live sign-in the server calls
 * unavailable is refused without a command; a failed action names its input, permission or operation. Learn more in the
 * tour's own conversation keeps its messages; from another conversation it starts with none.
 */
function updateHolds(scenario: typeof UPDATES[number], input: typeof UpdateArms.Type): boolean {
  const base: Model = { ...init(input.flags).model, mode: "mock", surface: "chat" }
  const valid = (model: Model) => Schema.is(Model)(model)
  switch (scenario) {
    case "sandbox-busy": {
      const next = update({ ...base, sandboxBusy: true, draft: "/sandbox" }, Message.SubmittedDraft())
      return valid(next.model) && !names(next).includes("SandboxAction") && names(next).includes("ClosePalette")
    }
    case "retry-run": {
      const command = { name: "vibelang/Post", title: "Post", detail: "Post", command: "/post", runnable: true, least: "viewer" as const, input: "text" as const }
      const model: Model = { ...base, actions: { ...actionsOf(base), open: true, selected: command.name, run: "run-1", input: input.text, commands: [command], entries: [command] } }
      const next = update(model, Message.ClickedRunAction())
      const runs = (next.commands ?? []).filter((entry) => entry.name === "RunAction")
      return valid(next.model) && runs.length === 1 && (runs[0]!.args as { retry?: string }).retry === "run-1"
    }
    case "people-max": {
      const account = accountOf(base)
      const model: Model = { ...base, account: { ...account, people: "max" } }
      const seq = model.client.conversation.seq
      const next = update(model, Message.ReceivedEvent({ event: { type: "PaneOpened", seq: seq + 1, id: "", url: `/wiki/${pages[input.step % pages.length]!.id}` } }))
      return valid(next.model) && accountOf(next.model).people === "pane" && names(next).includes("WikiLocation")
    }
    case "tour-repeat": {
      let model = base
      for (const message of tourStop(model, input.step)) model = update(model, message).model
      const seq = model.tourClient?.conversation.seq ?? 0
      const again = update(model, Message.ReceivedTourEvent({ event: { type: "WalkthroughDriven", seq, id: TOUR_ID, step: input.step, target: WALKTHROUGH[input.step - 1]!.target, at: 1, duration: 1 } }))
      // An active tour re-measures its stage after any message; nothing else happens.
      return JSON.stringify(again.model) === JSON.stringify(model) && names(again).every((name) => name === "MeasureTheatre")
    }
    case "tour-sought-end-fails": {
      let model = base
      for (const message of tourStop(model, input.step)) model = update(model, message).model
      const seq = model.tourClient?.conversation.seq ?? 0
      model = update(model, Message.ReceivedTourEvent({ event: { type: "TourSought", seq: seq + 1, id: TOUR_ID, at: 2, step: input.seek } })).model
      const state = model.tourClient?.conversation.walkthrough
      const next = update(model, Message.FailedEndTour())
      if (!valid(next.model)) return false
      // Only a sought stop leaves the walkthrough without a target; then the stop's own target shows.
      if (state === undefined || state.target !== "") return true
      const presents = (next.commands ?? []).filter((entry) => entry.name === "PresentTour")
      return next.model.theatre.target === WALKTHROUGH[state.step - 1]!.target && presents.length === 1 && (presents[0]!.args as { step?: number }).step === state.step
    }
    case "draft-outside-build": {
      const page = "not-in-this-build"
      const account = accountOf(base)
      const model: Model = { ...base, account: { ...account, identity: { ...account.identity, id: "p1", role: "maintainer" } }, ...(input.overlay ? { wikiPages: [{ id: page, source: `# ${input.text}`, revision: "r1" }] } : {}) }
      const next = update(model, Message.ClickedWikiDraft({ page }))
      if (!valid(next.model)) return false
      // Only a page the build holds is editable, even when the repository's overlay has the page.
      return next.model.wikiEdit === undefined && names(next).every((name) => name === "MeasureTheatre")
    }
    case "assignees-without-agent": {
      const model: Model = { ...base, issues: { ...issueStateOf(base), open: true, assignee: "gone" } }
      const next = update(model, Message.IssuesLoaded({ data: { seq: 1, items: [], assignees: [{ login: "maya", label: "Maya" }] }, created: false, role: "maintainer" }))
      return valid(next.model) && next.model.issues?.assignee === ""
    }
    case "pane-closes-editor": {
      const editable = pages.filter((entry) => wikiEditable(entry.id))
      const page = editable[input.step % 2]!.id
      const account = accountOf(base)
      const model: Model = { ...base, account: { ...account, identity: { ...account.identity, id: "p1", role: "maintainer" } }, client: { ...base.client, conversation: { ...base.client.conversation, pane: `/wiki/${page}` } } }
      const opened = update(model, Message.ClickedEditWiki())
      const open = (opened.commands ?? []).find((entry) => entry.name === "OpenWikiEditor")
      if (open === undefined) return false
      const editing = update(opened.model, Message.BeganWikiEdit({ request: (open.args as { request: number }).request, page, source: "# A", draft: "" })).model
      if (editing.wikiEdit === undefined) return false
      const seq = editing.client.conversation.seq
      const pane = (target: string) => update(editing, Message.ReceivedEvent({ event: { type: "PaneOpened", seq: seq + 1, id: "", url: `/wiki/${target}` } })).model
      const other = pane(editable[(input.step + 1) % 2]!.id)
      const own = pane(page)
      return valid(other) && valid(own) && other.wikiEdit === undefined && own.wikiEdit?.page === page
    }
    case "scroll-stale": {
      const model: Model = { ...base, followIntent: input.seek + 1 }
      const next = update(model, Message.ScrolledTranscript({ bottom: input.overlay, intent: input.seek }))
      const fresh = update(model, Message.ScrolledTranscript({ bottom: input.overlay, intent: input.seek + 1 }))
      if (!valid(fresh.model) || fresh.model.followIntent !== input.seek + 1) return false
      return JSON.stringify(next.model) === JSON.stringify(model) && names(next).every((name) => name === "MeasureTheatre")
    }
    case "tour-gap": {
      let model = base
      for (const message of tourStop(model, input.step)) model = update(model, message).model
      const seq = model.tourClient?.conversation.seq ?? 0
      const next = update(model, Message.ReceivedTourEvent({ event: { type: "WalkthroughDriven", seq: seq + 2, id: TOUR_ID, step: input.step, target: WALKTHROUGH[input.step - 1]!.target, at: 1, duration: 1 } }))
      return valid(next.model) && next.model.epoch === model.epoch + 1 && next.model.tourClient?.conversation.seq === 0 && names(next).every((name) => name === "MeasureTheatre")
    }
    case "submit-without-request": case "began-stale": {
      const page = pages.filter((entry) => wikiEditable(entry.id))[input.step % 2]!.id
      const account = accountOf(base)
      let model: Model = { ...base, account: { ...account, identity: { ...account.identity, id: "p1", role: "maintainer" } }, client: { ...base.client, conversation: { ...base.client.conversation, pane: `/wiki/${page}` } } }
      const opened = update(model, Message.ClickedEditWiki())
      const open = (opened.commands ?? []).find((entry) => entry.name === "OpenWikiEditor")
      if (open === undefined) return false
      const request = (open.args as { request: number }).request
      const stale = 1_762_782_000_000 + input.seek
      const began = update(opened.model, Message.BeganWikiEdit({ request, page, source: "# A", draft: "", ...(scenario === "began-stale" ? { stale } : {}) }))
      if (scenario === "began-stale") return valid(began.model) && began.model.wikiEdit?.stale === stale && names(began).includes("FocusWikiEditor")
      // The page's first wiki-edit request: a submit names serial 0.
      model = { ...update(began.model, Message.UpdatedWikiEdit({ value: `# B${input.text}` })).model, wikiEditRequest: 0 }
      const next = update(model, Message.SubmittedWikiEdit())
      const submits = (next.commands ?? []).filter((entry) => entry.name === "SubmitWikiEdit")
      return valid(next.model) && submits.length === 1 && (submits[0]!.args as { serial?: number }).serial === 0
    }
    case "learn-more-palette": {
      const next = update({ ...base, palette: true }, Message.ClickedLearnMore())
      // A tour that does not start (one already runs for this page) closes nothing.
      if (!names(next).includes("StartTour")) return valid(next.model) && !names(next).includes("ClosePalette")
      return valid(next.model) && names(next)[0] === "ClosePalette" && ((next.commands ?? [])[0]!.args as { dock?: boolean }).dock === false
    }
    case "control-clears-error": {
      let model = base
      for (const message of tourStop(model, input.step)) model = update(model, message).model
      const next = update({ ...model, tourError: "lost" }, input.overlay ? Message.ClickedSkipStop() : Message.ClickedPauseTour())
      if (!names(next).includes("ControlTour")) return valid(next.model)
      return valid(next.model) && next.model.tourError === ""
    }
    case "sandbox-polled-failure": {
      const model: Model = { ...base, sandboxRequest: input.step, sandboxError: "" }
      const failed = (state: Model) => update(state, Message.FailedSandbox({ conversation: state.conversation, request: input.step, reason: "busy", polled: true })).model
      const idle = failed(model)
      const waiting = failed({ ...model, sandboxOperation: "start", sandboxBusy: true })
      return valid(idle) && idle.sandboxError === "busy" && idle.sandboxBusy === false && waiting.sandboxError === "" && waiting.sandboxBusy === true
    }
    case "chat-from-splash": {
      const splash: Model = { ...base, surface: "splash" }
      const empty = update(splash, Message.ClickedChat())
      const seq = base.client.conversation.seq
      const posted = update(splash, Message.ReceivedEvent({ event: { type: "Posted", seq: seq + 1, id: "e-1", clientId: "fuzz-other", name: "You", text: "hi" } })).model
      const full = update({ ...posted, surface: "splash" }, Message.ClickedChat())
      // An active tour re-measures its stage after any message (tour-repeat); nothing else happens before a message.
      return valid(full.model) && full.model.surface === "chat" && names(full).includes("FocusComposer") && names(empty).every((name) => name === "MeasureTheatre") && empty.model.surface === "splash"
    }
    case "account-retries": {
      const account = { ...accountOf(base), target: "7", targetRole: "community" as const, error: "x", pending: true }
      const retried = (retry: "people" | "grant" | "sign-out" | "roles") => update({ ...base, account: { ...account, retry } }, Message.RetriedAccount())
      const failed = (retry: "people" | "grant" | "sign-out" | "roles" | "sign-in") => accountOf(update({ ...base, account: { ...account, retry } }, Message.AccountFailed()).model).error
      const others = (result: { readonly commands?: ReadonlyArray<{ readonly name: string }> }) => names(result).filter((name) => name !== "MeasureTheatre")
      const roles = retried("roles")
      const grant = retried("grant")
      const grantArgs = (grant.commands ?? []).find((command) => command.name === "GrantRole")?.args as { id?: string; role?: string } | undefined
      return valid(roles.model) && others(roles).length === 0 && accountOf(roles.model).epoch === account.epoch + 1 && accountOf(roles.model).error === ""
        && same(others(retried("people")), ["LoadPeople"]) && same(others(grant), ["GrantRole"]) && grantArgs?.id === "7" && grantArgs?.role === "community"
        && same(others(retried("sign-out")), ["SignOutAccount"])
        && failed("grant") === "Role change failed." && failed("people") === "People couldn’t load." && failed("sign-out") === "Sign out failed." && failed("roles") === "Sign-in failed. GitHub didn’t answer."
    }
    case "sign-in-unavailable": {
      const account = accountOf(base)
      const live: Model = { ...base, mode: "live", account: { ...account, identity: { ...account.identity, available: false } } }
      const next = update(live, Message.ClickedSignIn())
      return valid(next.model) && !names(next).includes("SignInAccount") && accountOf(next.model).error === "Sign-in unavailable." && !accountOf(next.model).pending
    }
    case "action-failures": {
      const text = (code: string, op?: "load" | "run" | "cancel") => actionsOf(update(base, Message.FailedActions({ code, ...(op === undefined ? {} : { op }) })).model).error
      return text("input", "run") === "Input isn't valid." && text("forbidden", "cancel") === "Not allowed." && text("fault", "run") === "Couldn't start the run."
        && text("fault", "cancel") === "Couldn't cancel the run." && text("fault") === "Couldn't load runs"
    }
    case "learn-more-same-conversation": {
      const seq = base.client.conversation.seq
      const posted = update({ ...base, conversation: `demo-${walkthroughSession(base)}`, tour: false }, Message.ReceivedEvent({ event: { type: "Posted", seq: seq + 1, id: "e-1", clientId: "fuzz-other", name: "You", text: "hi" } })).model
      const again = update({ ...posted, tour: false }, Message.ClickedLearnMore())
      const elsewhere = update({ ...posted, tour: false, conversation: "fuzz-other" }, Message.ClickedLearnMore())
      const kept = posted.client.conversation.entries.length
      return valid(again.model) && again.model.tour === true && kept > 0 && again.model.client.conversation.entries.length === kept && elsewhere.model.client.conversation.entries.length === 0
    }
    case "walkthrough-posted": {
      const seq = base.client.conversation.seq
      const clientId = input.overlay ? `${walkthroughSession(base)}-walkthrough` : "fuzz-other"
      let model = update(base, Message.ReceivedEvent({ event: { type: "Posted", seq: seq + 1, id: "e-1", clientId, name: "You", text: "hi" } })).model
      let last: ReadonlyArray<string> = []
      for (const message of tourStop(model, 2)) { const next = update(model, message); model = next.model; last = names(next) }
      return valid(model) && last.includes("PostMessage") === !input.overlay
    }
  }
}

it.live("web/update-arms", () => run("web/update-arms", UpdateArms, (input) => effect {
  for (const scenario of UPDATES) if (!updateHolds(scenario, input)) throw new Finding({ report: `${scenario} does not hold` })
  return true
}))

const DomArms = Schema.Struct({
  command: Schema.Literals(["reveal", "location"]),
  maximized: Schema.Literals(["false", "true", "absent"]),
  content: Schema.Boolean,
  page: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 63 })),
  hash: Schema.Literals(["", "intro", "missing"]),
  here: Schema.Boolean,
})

/**
 * RevealWiki and WikiLocation over a happy-dom page holding the wiki pane: the inline pane (data-maximized "false") is
 * scrolled into view and a maximized or absent one is not; WikiLocation pushes the address unless the page is already
 * there, keeps the query, then scrolls to the heading the hash names, or else the content to its top.
 */
it.live("web/dom-commands", () => run("web/dom-commands", DomArms, (input) => Effect.provide(effect {
  const document = try (try Experimental.Document.Document).current
  const window = try (try Experimental.Window.Window).current
  const scrolled: Array<string> = []
  const made = try acquireRelease(Effect.try(() => {
    const pane = document.createElement("section")
    pane.id = "vl-wiki"
    if (input.maximized !== "absent") pane.setAttribute("data-maximized", input.maximized)
    const content = document.createElement("div")
    if (input.content) content.className = "vl-wiki-content"
    content.scrollTop = 40
    const heading = document.createElement("h2")
    heading.id = "intro"
    content.append(heading)
    pane.append(content)
    document.body.append(pane)
    pane.scrollIntoView = () => { scrolled.push("pane") }
    heading.scrollIntoView = () => { scrolled.push("heading") }
    return { pane, content }
  }), (made) => sync(() => made.pane.remove()))
  const page = `/wiki/${pages[input.page % pages.length]!.id}`
  const url = input.hash === "" ? page : `${page}#${input.hash}`
  try goTo(input.here ? `${url}` : "/?q=1")
  const before = try location()
  const got = try answer(() => (input.command === "reveal" ? RevealWiki({}) : WikiLocation({ url })) as AnyCommand)
  if (got._tag !== "FocusedPrompt") return false
  const paneShown = input.maximized === "false"
  if (input.command === "reveal") return (scrolled.includes("pane") === paneShown) && !scrolled.includes("heading") && (try location()) === before
  const after = try location()
  const search = input.here ? "" : "?q=1"
  if (after !== (input.here ? url : `${page}${search}${input.hash === "" ? "" : `#${input.hash}`}`)) return false
  if (scrolled.includes("pane") !== paneShown) return false
  if (scrolled.includes("heading") !== (input.hash === "intro")) return false
  return input.hash !== "" || !input.content || made.content.scrollTop === 0
}, Layer.mergeAll(backend("mock", "viewer"), ExperimentalBrowserWindow.layer, ExperimentalBrowserDocument.layer))))
