import { it } from "@effect/vitest"
import { Factory } from "../src/core/Factory.vibe"
import { mockFactoryFor } from "../src/core/MockFactory.vibe"
import * as Decision from "../src/core/sandboxDecision.vibe"
import { meter, monthOf } from "../src/core/sandboxMeter.vibe"
import { run, Int, same } from "./run.vibe"

const Role = Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])
const Delta = Schema.Int.check(Schema.isBetween({ minimum: -120, maximum: 120 }))
const MeterInput = Schema.Struct({ deltas: Schema.Array(Delta).check(Schema.isMaxLength(30)), count: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 3 })) })

/** The sandbox lane's independent millisecond-by-millisecond oracle, under this suite's own budget and corpus. */
it.live("sandbox/utc-meter-oracle", () => run("sandbox/utc-meter-oracle", MeterInput, ({ deltas, count }) => effect {
  let high = Date.UTC(2026, 10, 30, 23, 59, 59, 990)
  let now = high
  let ledger = { ...Decision.emptySandboxLedger("u", "contributor", 36000, monthOf(high), high), sandboxes: Array.from({ length: count }, (_, n) => ({ id: `s${n}`, conversation: `c${n}`, running: true })) }
  let months: Readonly<Record<string, number>> = {}
  const expected: Record<string, number> = { [monthOf(high)]: 0 }
  for (const delta of deltas) {
    now += delta
    const end = Math.max(high, now)
    for (let instant = high; instant < end; instant++) expected[String(monthOf(instant))] = (expected[String(monthOf(instant))] ?? 0) + count
    high = end
    const next = try meter(ledger, months, now, 36000)
    ledger = { ...next.ledger, sandboxes: [...next.ledger.sandboxes] }
    months = next.months
    if (ledger.lastMeteredAt !== high || ledger.usedMilliseconds < 0) return false
    for (const [month, used] of Object.entries(months)) if (used !== (expected[month] ?? 0)) return false
  }
  return true
}))

const CorruptInput = Schema.Struct({ delta: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 120 })), count: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 3 })), prior: Schema.Literals([-1, 0.5, "NaN", 0, 7]) })

/**
 * A stored month bucket an older or broken writer left: metering into a month whose bucket is negative, fractional or
 * not a number fails as `meter-domain`, never a defect and never a charge; a valid bucket accrues each running sandbox's
 * milliseconds in that month on top of what it held.
 */
it.live("sandbox/meter-corrupt-bucket", () => run("sandbox/meter-corrupt-bucket", CorruptInput, ({ delta, count, prior }) => effect {
  const high = Date.UTC(2026, 10, 30, 23, 59, 59, 990)
  const december = String(monthOf(high + 10))
  const ledger = { ...Decision.emptySandboxLedger("u", "contributor", 36000, monthOf(high), high), sandboxes: Array.from({ length: count }, (_, n) => ({ id: `s${n}`, conversation: `c${n}`, running: true })) }
  const held = prior === "NaN" ? Number.NaN : prior
  const answer = try exit(meter(ledger, { [december]: held }, high + delta, 36000))
  const valid = Number.isSafeInteger(held) && held >= 0
  if (!valid) return answer._tag === "Failure" && !Cause.hasDies(answer.cause) && Cause.findError(answer.cause)._tag === "Success" && (Cause.findError(answer.cause) as { readonly success: { readonly reason?: string } }).success.reason === "meter-domain"
  // Only crossing into December reads its bucket: 10 ms of November remain.
  if (answer._tag === "Failure") return false
  return answer.value.months[december] === (delta > 10 ? held + count * (delta - 10) : held)
}))

it.live("sandbox/factory-role-replay-and-files", () => run("sandbox/factory-role-replay-and-files", Schema.Struct({ role: Role, value: Schema.Int }), ({ role, value }) => effect {
  provide mockFactoryFor(role) {
    const factory = try Factory
    const started = try exit(factory.startSandbox("fuzz", "start"))
    if (role !== "contributor" && role !== "maintainer") return started._tag === "Failure" && !Cause.hasDies(started.cause)
    if (started._tag === "Failure") return false
    const first = started.value
    try factory.sandboxCommand("fuzz", "write", `echo ${value} > keep`, first.generation)
    try factory.stopSandbox("fuzz", "stop", first.generation)
    const second = try factory.startSandbox("fuzz", "restart")
    try factory.stopSandbox("fuzz", "stop", first.generation)
    const bytes = try factory.sandboxCommand("fuzz", "read", "cat keep", second.generation)
    const snapshot = try factory.sandbox("fuzz")
    return bytes === `${value}\n` && snapshot.generation === first.generation + 1 && snapshot.status === "running" && snapshot.remaining > 0
  }
}))

// Starts and stops on a ledger the meter has already charged (`used`); the meter's own sequences are above.
const Step = Schema.Struct({ type: Schema.Literals(["start", "stop"]), id: Int, duplicate: Schema.Boolean })
const Sequence = Schema.Struct({ role: Role, used: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 500 })), steps: Schema.Array(Step).check(Schema.isMaxLength(48)) })
it.live("sandbox/decision-sequences", () => run("sandbox/decision-sequences", Sequence, ({ role, used, steps }) => {
  let ledger = { ...Decision.emptySandboxLedger("owner", role, 500, 0, 0), usedMilliseconds: used }
  let replay = ledger
  for (const [at, step] of steps.entries()) {
    const intent = { type: step.type, conversation: `c${step.id}`, sandboxId: `s${step.id}`, operationId: step.duplicate ? ledger.lastOperationId : `op${at}` }
    const result = Decision.decideSandbox(ledger, intent)
    if (result.ok) {
      if (result.event.sequence !== ledger.sequence + 1 || result.event.state.usedMilliseconds !== used) return false
      ledger = Decision.applySandbox(ledger, result.event)
      replay = Decision.applySandbox(replay, result.event)
      if (!same(Decision.applySandbox(ledger, result.event), ledger)) return false
    } else if (!same(result.state, ledger)) return false
    if (!same(ledger, replay) || ledger.owner !== "owner" || ledger.usedMilliseconds < 0 || !Decision.validSandboxes(ledger.sandboxes)) return false
    if (Decision.remainingMilliseconds(ledger.allowanceMilliseconds, ledger.usedMilliseconds) < 0) return false
    if (Decision.runningCount(ledger.sandboxes) !== ledger.sandboxes.filter((box) => box.running).length) return false
  }
  return true
}))
