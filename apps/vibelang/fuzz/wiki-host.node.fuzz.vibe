// The wiki's GitHub host through its journaled writes, by people, agents, demoted and disconnected callers, with an
// authority that may refuse, writing through smithers.sh's delegation; and the HTTP boundary over a host that fails
// with each reason, journaled and recovered.
import { it } from "@effect/vitest"
import { HttpClient, HttpClientRequest, HttpServerRequest, HttpServerResponse } from "effect/http"
import { GitHub } from "@smthrs/integrations"
import { WebCrypto } from "@smthrs/crypto"
import { TestNodeRuntime } from "@smthrs/platform-node"
import { wikiPermission } from "../src/core/conversation.vibe"
import { wikiSubmissionAllowed } from "../src/core/wikiDecision.vibe"
import { pages } from "../src/core/wiki.vibe"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import { WikiHost } from "../src/core/wikiFlows.vibe"
import { WikiFailure, WikiState, type WikiRequest } from "../src/core/wikiSchemas.vibe"
import { executeWiki, githubWikiHost, serveWiki, wikiFailureOf, WikiAuthority, type WikiRepository } from "../worker/Wiki.vibe"
import { GitHubDelegate } from "../worker/GitHubDelegate.vibe"
import { PublicReads } from "../worker/PublicReads.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { API, fakeClient, forked, seed } from "./issues-node-fake.vibe"
import { delegated, reach, reached } from "./delegated.vibe"
import { run, stepped, Finding, REPLAY_FLOOR } from "./run.vibe"
import { faultyStore } from "./faulty-store.ts"

const repo: WikiRepository = { owner: "o", name: "r", api: API, agent: "", root: "wiki" }
const page = pages[0]!.id
const SOURCE = "# Page\n\nThe repository text.\n"
const Role = Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])
const REASONS = ["forbidden", "sign-in", "connect", "fork", "install", "missing", "invalid", "conflict", "empty", "unknown", "partial", "rate-limited", "unavailable"]

const Call = Schema.Struct({
  op: Schema.Literals(["read", "save", "propose", "draft"]),
  role: Role,
  caller: Schema.Literals(["person", "agent", "signed-out", "no-token", "demoted", "disconnected", "blank-key"]),
  authorize: Schema.Literals(["absent", "allows", "refuses"]),
  writer: Schema.Boolean,
  stored: Schema.Boolean,
  fresh: Schema.Boolean,
  base: Schema.Literals(["current", "stale"]),
  text: Schema.Literals(["", "  ", SOURCE, "Edited text."]),
  main: Schema.Literals(["present", "missing", "advanced", "error"]),
  // Optional so saved regressions from before it still decode: absent, the person has forked.
  fork: Schema.optionalKey(Schema.Boolean),
})

/** The host's refusals come before any write, a draft survives a missing credential, a read returns the page and a write its review. */
const calls = reach()
const hostCalls = (input: typeof Call.Type) => effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const storage = raw as unknown as Storage
  const fake = seed()
  if (input.fork !== false) forked(fake)
  const site = try delegated(fakeClient(fake), calls)
  fake.files[`wiki/${page}.md`] = SOURCE
  fake.noMain = input.main === "missing"
  fake.pinnedText = input.main === "advanced" ? "Main advanced." : undefined
  // GitHub answering the page's contents with a server error.
  fake.contentStatus = input.main === "error" ? 500 : 200
  // A text the person reviewed earlier, kept for them across a credential connection.
  if (input.stored && input.op === "read") try promise(() => storage.put(`wiki/draft/7/${page}`, { page, text: "Kept." }))
  const asked = try Ref.make(0)
  const person = (role: typeof Role.Type, later: boolean) => ({ id: "7", login: "fuzz", role, ...(input.caller === "no-token" || (input.caller === "disconnected" && later) ? {} : { connection: site.connection }), kind: input.caller === "agent" ? "agent" as const : "person" as const })
  const authority: WikiAuthority.Shape = {
    current: () => Effect.map(Ref.updateAndGet(asked, (n) => n + 1), (n) => input.caller === "signed-out" ? undefined : person(input.caller === "demoted" && n > 1 ? "viewer" : input.role, n > 1)),
    ...(input.authorize === "absent" ? {} : { authorize: () => input.authorize === "refuses" ? Effect.fail(new WikiFailure({ reason: "forbidden" })) : Effect.void }),
  }
  const client = site.http
  const host = try githubWikiHost(repo, input.stored ? storage : undefined, () => input.fresh).pipe(
    Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, client), Effect.provideService(GitHubDelegate, site.delegate),
    Effect.provide(input.writer ? Layer.succeed(WikiWriter, { draft: (request) => succeed({ page: request.page, text: `${request.source}\n${request.ask}` }) }) : Layer.empty),
  )
  const request: WikiRequest = { op: input.op, page, base: input.base === "current" ? SOURCE : "Stale.", text: input.text, key: input.caller === "blank-key" ? "" : "k1" }
  // A write runs this host on the durable engine; a GitHub 5xx stays off it, whose retries wait on the real clock.
  const write = ["save", "propose"].includes(input.op) && request.key !== "" && input.main !== "error"
  const performed = write
    ? executeWiki("host-calls", storage, request, repo).pipe(Effect.provideService(WikiHost, host), Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, client))
    : host.perform(request)
  const pullsBefore = fake.pulls.length
  const result = try exit(performed.pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
  const signedIn = input.caller !== "signed-out"
  const allowed = wikiPermission(signedIn ? input.role : "viewer", input.op) && wikiSubmissionAllowed(input.op, input.caller === "agent" ? "agent" : "person") && input.authorize !== "refuses"
  if (result._tag === "Failure") {
    const failure = Option.getOrUndefined(Cause.findErrorOption(result.cause))
    if (failure === undefined) throw new Finding({ report: `${input.op} died` })
    if (fake.pulls.length !== pullsBefore) throw new Finding({ report: `a failed ${input.op} opened a review` })
    if (!REASONS.includes(failure.reason)) throw new Finding({ report: `${input.op} failed with ${failure.reason}` })
    if (!allowed && failure.reason !== "forbidden") throw new Finding({ report: `a refused ${input.op} answered ${failure.reason}` })
    if (failure.reason === "connect" && input.stored && ["save", "propose"].includes(input.op)) {
      const kept = try promise(() => storage.get(`wiki/draft/7/${page}`))
      if (!Schema.is(Schema.Struct({ page: Schema.String, text: Schema.String }))(kept) || kept.text !== input.text) throw new Finding({ report: "a reviewed text was lost on connect" })
      // A host that never wrote marks the refusal unwritten for a fresh request.
      if (input.fresh !== (failure.unwritten === true)) throw new Finding({ report: "connect's unwritten mark is wrong" })
    }
    return true
  }
  if (!allowed) throw new Finding({ report: `a refused ${input.op} succeeded` })
  if (input.op === "read" && !result.value.pages.some((entry) => entry.id === page && entry.source === SOURCE)) throw new Finding({ report: "a read lost its page" })
  if (input.op === "read" && input.stored && signedIn && result.value.draft?.text !== "Kept.") throw new Finding({ report: "a read lost the person's kept text" })
  if (input.op === "draft" && result.value.draft?.page !== page) throw new Finding({ report: "a draft named another page" })
  // The branch is cut from main's current commit: a base main has moved past is a conflict, never a review.
  if (write && input.main === "advanced") throw new Finding({ report: `a ${input.op} behind an advanced main opened a review` })
  if (write && (!(result.value.review ?? "").startsWith("https://github.com/o/r/pull/") || fake.pulls.length !== pullsBefore + 1 || input.fork === false)) throw new Finding({ report: `a ${input.op} answered without one review on the person's fork` })
  return true
}
it.live("wiki/host-calls", () => Effect.andThen(run("wiki/host-calls", Call, hostCalls), reached("wiki/host-calls", calls, hostCalls, {
  op: "propose", role: "maintainer", caller: "person", authorize: "absent", writer: false, stored: false, fresh: false, base: "current", text: "Edited text.", main: "present", fork: true,
})))

const Served = Schema.Struct({
  reason: Schema.Literals(["ok", ...REASONS]),
  unwritten: Schema.Boolean,
  untyped: Schema.Boolean,
  authorize: Schema.Boolean,
  recovery: Schema.Literals(["none", "r1", "bad recovery!"]),
  op: Schema.Literals(["read", "propose"]),
})
const STATUS: Record<string, number> = { forbidden: 403, "sign-in": 401, connect: 401, missing: 404, unknown: 409, conflict: 409, empty: 400, invalid: 400, fork: 400, install: 400 }

/** Over a host that fails with any reason, HTTP answers that reason's status, twice, and a recovery reruns it once. */
it.live("wiki/served-failures", () => run("wiki/served-failures", Served, (input) => effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const storage = raw as unknown as Storage
  const performed = try Ref.make(0)
  const failing: WikiHost.Shape = {
    perform: () => Effect.flatMap(Ref.update(performed, (n) => n + 1), () =>
      input.reason === "ok" ? succeed({ seq: 1, pages: [] })
      : input.untyped ? Effect.die(new Error("host defect"))
      : fail(new WikiFailure({ reason: input.reason, ...(input.unwritten ? { unwritten: true } : {}) }))),
  }
  const authority: WikiAuthority.Shape = { current: () => succeed({ id: "7", login: "fuzz", role: "maintainer" as const }), ...(input.authorize ? { authorize: () => Effect.void } : {}) }
  const body = { op: input.op, page, base: SOURCE, text: "Edited.", key: "served-1", ...(input.recovery === "none" ? {} : { recovery: input.recovery }) }
  const serve = effect {
    const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/wiki"), JSON.stringify(body)))
    const response = try Effect.provideService(serveWiki("served", storage, repo).pipe(
      Effect.provideService(WikiAuthority, authority), Effect.provideService(WikiHost, failing),
      Effect.provideService(HttpClient.HttpClient, fakeClient(seed())), Effect.provide(WebCrypto.layer),
    ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
    const text = try promise(() => HttpServerResponse.toWeb(response).text())
    return { status: response.status, parsed: try Effect.try(() => JSON.parse(text)) }
  }
  if (input.untyped && input.reason !== "ok" && input.recovery !== "bad recovery!") {
    // A defect in the host is a bug, outside its typed contract: it stays a defect, never an answer.
    const died = try exit(serve)
    if (died._tag !== "Failure" || !died.cause.reasons.every((r) => r._tag === "Die")) throw new Finding({ report: "a host defect became an answer" })
    return true
  }
  const first = try serve
  const second = try serve
  if (input.recovery === "bad recovery!") {
    if (first.status !== 400 || first.parsed.reason !== "invalid" || (try Ref.get(performed)) !== 0) throw new Finding({ report: "a malformed recovery reached the host" })
    return true
  }
  const reason = input.reason
  const expected = reason === "ok" ? 200 : STATUS[reason] ?? 503
  if (first.status !== expected || second.status !== first.status) throw new Finding({ report: `${reason} answered ${first.status} then ${second.status}` })
  if (expected !== 200 && first.parsed.reason !== reason) throw new Finding({ report: `${reason} was reported as ${first.parsed.reason}` })
  if (expected !== 200 && (first.parsed.unwritten === true) !== input.unwritten) throw new Finding({ report: "unwritten was not carried" })
  const performedCount = try Ref.get(performed)
  // A settled execution is joined, never redone, unless an explicit recovery of a failure asks for one more.
  if (reason === "ok" && performedCount !== 1) throw new Finding({ report: `a successful edit ran ${performedCount} times` })
  return true
}))

const WIKI_SCENARIOS = ["recover", "changed-payload", "missing-page", "lost", "default-host", "served-reasons", "refusals", "connected", "store", "delegated", "signed-out", "deadline"] as const
const Steered = Schema.Struct({
  pick: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 31 })),
  text: Schema.Literals(["Edited text.", "Another edit.", "# Page\n\nNew words.\n"]),
})
const REFUSALS = ["connect", "install", "fork", "forbidden", "unavailable", "unknown", "key_conflict"] as const

/**
 * Preludes that reach the wiki's journal in one execution instead of waiting for random sequences: a settled failure
 * recovered through `retryFrom` and joined, a changed payload under a used key, an unknown page on a fresh execution,
 * a lost delegation, the host's defaults, the broker refusals' statuses, and a connected person with no delegate. No
 * GitHub write happens (decision 0165).
 */
const steeredScenario = (scenario: typeof WIKI_SCENARIOS[number], pick: number, text: typeof Steered.Type["text"]) => scoped(effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const store = faultyStore(raw as unknown as Storage)
  const storage = store.storage
  const fake = seed()
  fake.files[`wiki/${page}.md`] = SOURCE
  const lost = try Ref.make(0)
  const authority: WikiAuthority.Shape = { current: () => succeed({ id: "7", login: "fuzz", role: "maintainer" as const }), lost: () => Ref.update(lost, (n) => n + 1) }
  const execute = (request: WikiRequest) => Effect.result(executeWiki("wiki-steered", storage, request, repo).pipe(
    Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
    // A storage error is no typed answer; its tag fails every expectation below.
    Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
  ))
  const reasonOf = (result: Result.Result<unknown, WikiFailure>) => result._tag === "Failure" ? result.failure.reason : "ok"
  const proposal: WikiRequest = { op: "propose", page, base: SOURCE, text, key: `steered-${pick}` }
  switch (scenario) {
    case "recover": {
      // No connection: the proposal settles as a failure, which only an explicit recovery runs again.
      const first = try execute(proposal)
      if (first._tag !== "Failure" || first.failure.reason !== "connect" || first.failure.unwritten !== true) throw new Finding({ report: `a fresh unconnected proposal answered ${reasonOf(first)}` })
      for (const label of ["recovered", "joined"]) {
        const again = try execute({ ...proposal, recovery: "r1" })
        if (reasonOf(again) !== "connect") throw new Finding({ report: `the ${label} recovery answered ${reasonOf(again)}` })
      }
      const changed = try execute({ ...proposal, text: `${text} More.`, recovery: "r2" })
      if (reasonOf(changed) !== "invalid") throw new Finding({ report: `a recovery with another text answered ${reasonOf(changed)}` })
      const kept = try promise(() => storage.get(`wiki/draft/7/${page}`))
      if ((kept as { text?: string } | undefined)?.text !== text) throw new Finding({ report: "the reviewed text was not kept for the person" })
      break
    }
    case "changed-payload": {
      try execute(proposal)
      const changed = try execute({ ...proposal, text: `${text} More.` })
      if (reasonOf(changed) !== "invalid") throw new Finding({ report: `a used key with another text answered ${reasonOf(changed)}` })
      const same = try execute(proposal)
      if (reasonOf(same) !== "connect") throw new Finding({ report: `the same proposal joined as ${reasonOf(same)}` })
      break
    }
    case "missing-page": {
      const first = try execute({ op: "read", page: "no-such-page", base: "", text: "", key: `read-${pick}` })
      if (first._tag !== "Failure" || first.failure.reason !== "missing" || first.failure.unwritten !== true) throw new Finding({ report: `a fresh unknown page answered ${reasonOf(first)}` })
      break
    }
    case "lost": {
      const answer = try execute(proposal)
      if (reasonOf(answer) !== "connect" || (try Ref.get(lost)) !== 1) throw new Finding({ report: `connect told the authority ${try Ref.get(lost)} times` })
      break
    }
    case "default-host": {
      // The production repository and the default freshness: refusals that precede every GitHub call.
      const host = try githubWikiHost().pipe(Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)))
      const drafted = try Effect.result(host.perform({ op: "draft", page, base: SOURCE, text: " ", key: "k1" }).pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
      if (reasonOf(drafted) !== "empty") throw new Finding({ report: `a blank draft answered ${reasonOf(drafted)}` })
      const stored = try githubWikiHost(repo, storage).pipe(Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)))
      const unknown = try Effect.result(stored.perform({ op: "read", page: "no-such-page", base: "", text: "", key: "k1" }).pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
      if (unknown._tag !== "Failure" || unknown.failure.reason !== "missing" || unknown.failure.unwritten === true) throw new Finding({ report: `an unknown page answered ${reasonOf(unknown)}` })
      // A connected person on a host with no storage: nothing to keep the text in, and still no write.
      const connected: WikiAuthority.Shape = { current: () => succeed({ id: "7", login: "fuzz", role: "maintainer" as const, connection: { person: 1, delegation: "fixture-delegation" } }) }
      const bare = try githubWikiHost(repo).pipe(Effect.provideService(WikiAuthority, connected), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)))
      const proposed = try Effect.result(bare.perform(proposal).pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
      if (reasonOf(proposed) !== "connect") throw new Finding({ report: `a connected proposal with no storage answered ${reasonOf(proposed)}` })
      // A write without a key cannot be journaled: the host asks the person to sign in before it reads anything.
      const keyless = try Effect.result(bare.perform({ ...proposal, key: "" }).pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
      if (reasonOf(keyless) !== "sign-in") throw new Finding({ report: `a keyless proposal answered ${reasonOf(keyless)}` })
      // An unconnected person on a host with no storage: nothing keeps the text, and the host asks to connect.
      const unconnected = try githubWikiHost(repo).pipe(Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)))
      const asked = try Effect.result(unconnected.perform(proposal).pipe(Effect.provide(WebCrypto.layer)) as typeof WikiState.Type!WikiFailure)
      if (reasonOf(asked) !== "connect") throw new Finding({ report: `an unconnected proposal with no storage answered ${reasonOf(asked)}` })
      break
    }
    case "served-reasons": {
      for (const [reason, status] of [["fork", 400], ["install", 400], ["sign-in", 401], ["connect", 401]] as const) {
        const failing: WikiHost.Shape = { perform: () => fail(new WikiFailure({ reason })) }
        const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/wiki"), JSON.stringify({ ...proposal, key: `${reason}-${pick}` })))
        const response = try Effect.provideService(serveWiki("served", storage, repo).pipe(
          Effect.provideService(WikiAuthority, authority), Effect.provideService(WikiHost, failing),
          Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
        ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
        const text = try promise(() => HttpServerResponse.toWeb(response).text())
        const body = try Effect.try(() => JSON.parse(text) as { reason?: string })
        if (response.status !== status || body.reason !== reason) throw new Finding({ report: `${reason} answered ${response.status}` })
      }
      break
    }
    case "refusals": {
      // A broker refusal keeps its reason; a key conflict is the caller's invalid request.
      for (const reason of REFUSALS) {
        const failure = wikiFailureOf({ _tag: "@smthrs/integrations/DelegationRefused", reason })
        if (failure.reason !== (reason === "key_conflict" ? "invalid" : reason)) throw new Finding({ report: `${reason} became ${failure.reason}` })
        if ((failure.code !== undefined) !== (reason === "unknown" || reason === "unavailable")) throw new Finding({ report: `${reason} carried the wrong code` })
      }
      break
    }
    case "connected": {
      // Connected, but this host has no delegate: each step re-reads the person, keeps the text, and asks to connect.
      const connected = { id: "7", login: "fuzz", role: "maintainer" as const, connection: { person: 1, delegation: "fixture-delegation" } }
      const queue = try Ref.make<Array<typeof connected | { id: string; login: string; role: "viewer" }>>([])
      const scripted: WikiAuthority.Shape = { current: () => Ref.modify(queue, (all) => all.length > 1 ? [all[0], all.slice(1)] : [all[0], all]) }
      const as = (people: ReadonlyArray<typeof connected | { id: string; login: string; role: "viewer" }>, request: WikiRequest) => effect {
        try Ref.set(queue, [...people])
        return try Effect.result(executeWiki("wiki-connected", storage, request, repo).pipe(
          Effect.provideService(WikiAuthority, scripted), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
          Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
        ))
      }
      // A connected read with no delegate falls back to the public page.
      const public_ = try as([connected], { op: "read", page, base: "", text: "", key: `public-${pick}` })
      if (public_._tag !== "Success" || !public_.success.pages.some((entry) => entry.source.includes("repository text"))) throw new Finding({ report: `a connected read without a delegate answered ${reasonOf(public_)}` })
      const asked = try as([connected], proposal)
      if (reasonOf(asked) !== "connect") throw new Finding({ report: `a connected proposal without a delegate answered ${reasonOf(asked)}` })
      const kept = try promise(() => storage.get(`wiki/draft/7/${page}`))
      if ((kept as { text?: string } | undefined)?.text !== text) throw new Finding({ report: "the connected person's text was not kept" })
      // Demoted after the host's own check, before its first step as the person.
      const demoted = try as([connected, connected, { id: "7", login: "fuzz", role: "viewer" }], { ...proposal, key: `demoted-${pick}` })
      if (reasonOf(demoted) !== "forbidden") throw new Finding({ report: `a demoted proposal answered ${reasonOf(demoted)}` })
      fake.contentStatus = 404
      const read = try as([connected], { op: "read", page, base: "", text: "", key: `read-${pick}` })
      if (reasonOf(read) !== "missing") throw new Finding({ report: `a connected read of a removed page answered ${reasonOf(read)}` })
      break
    }
    case "delegated": {
      // Connected through smithers.sh's real delegation: the person's proposal opens their review.
      forked(fake)
      const site = try delegated(fakeClient(fake), reach())
      const person = { id: "7", login: "fuzz", role: "maintainer" as const, connection: site.connection }
      const authorized = try Ref.make(0)
      const scripted: WikiAuthority.Shape = { current: () => succeed(person), authorize: () => Ref.update(authorized, (n) => n + 1), lost: () => Ref.update(lost, (n) => n + 1) }
      const via = (request: WikiRequest) => Effect.result(executeWiki("wiki-delegated", storage, request, repo).pipe(
        Effect.provideService(WikiAuthority, scripted), Effect.provideService(HttpClient.HttpClient, site.http), Effect.provideService(GitHubDelegate, site.delegate),
        Effect.provide(WebCrypto.layer), Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
      ))
      // Each refusal comes before any write: a stale base, an unchanged text, and main advanced past the base.
      const pullsBefore = fake.pulls.length
      const refusals: ReadonlyArray<readonly [string, WikiRequest]> = [
        ["conflict", { ...proposal, base: "Stale.", key: `stale-${pick}` }],
        ["empty", { ...proposal, text: SOURCE, key: `same-${pick}` }],
      ]
      for (const [wanted, request] of refusals) {
        const refused = try via(request)
        if (reasonOf(refused) !== wanted) throw new Finding({ report: `a delegated ${wanted} proposal answered ${reasonOf(refused)}` })
      }
      fake.pinnedText = "Main advanced."
      const advanced = try via({ ...proposal, key: `advanced-${pick}` })
      fake.pinnedText = undefined
      if (reasonOf(advanced) !== "conflict") throw new Finding({ report: `a proposal behind an advanced main answered ${reasonOf(advanced)}` })
      // A blank text, a repository without its base branch, and a branch read GitHub refuses: each stops before a write.
      const blank = try via({ ...proposal, text: "  ", key: `blank-${pick}` })
      if (reasonOf(blank) !== "empty") throw new Finding({ report: `a blank delegated proposal answered ${reasonOf(blank)}` })
      fake.noMain = true
      const headless = try via({ ...proposal, key: `headless-${pick}` })
      fake.noMain = false
      if (reasonOf(headless) !== "missing") throw new Finding({ report: `a proposal with no base branch answered ${reasonOf(headless)}` })
      fake.refStatus = 403
      const unread = try via({ ...proposal, key: `unread-${pick}` })
      fake.refStatus = 200
      if (reasonOf(unread) !== "forbidden") throw new Finding({ report: `a proposal whose branch read GitHub refused answered ${reasonOf(unread)}` })
      if (fake.pulls.length !== pullsBefore) throw new Finding({ report: "a refused proposal opened a review" })
      // The person's kept text is the one proposed, so the review replaces it.
      try promise(() => storage.put(`wiki/draft/7/${page}`, { page, text }))
      // A read by the person returns the kept text beside the page.
      const reread = try via({ op: "read", page, base: "", text: "", key: `kept-${pick}` })
      if (reread._tag !== "Success" || reread.success.draft?.text !== text) throw new Finding({ report: `a read with a kept text answered ${reasonOf(reread)}` })
      const proposed = try via({ ...proposal, key: `delegated-${pick}` })
      if ((try promise(() => storage.get(`wiki/draft/7/${page}`))) !== undefined) throw new Finding({ report: "a proposed text stayed kept after its review opened" })
      if ((try Ref.get(authorized)) === 0) throw new Finding({ report: "a delegated proposal skipped its authority" })
      if (proposed._tag !== "Success" || proposed.success.review === undefined || !fake.pulls.some((pull) => proposed.success.review!.endsWith(`/pull/${pull.number}`))) throw new Finding({ report: `a delegated proposal answered ${reasonOf(proposed)}` })
      // GitHub reports the review under another person: no evidence of this person's proposal. The flow retries until
      // its window closes, in virtual time, and the person gets unavailable.
      const stranger: WikiAuthority.Shape = { current: () => succeed({ ...person, id: "99" }) }
      const foreign = try stepped(Effect.result(executeWiki("wiki-delegated", storage, { ...proposal, key: `foreign-${pick}` }, repo).pipe(
        Effect.provideService(WikiAuthority, stranger), Effect.provideService(HttpClient.HttpClient, site.http), Effect.provideService(GitHubDelegate, site.delegate),
        Effect.provide(WebCrypto.layer), Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
      )), 150)
      if (reasonOf(foreign) !== "unavailable") throw new Finding({ report: `a review under another author answered ${reasonOf(foreign)}` })
      // The delegation ends at smithers.sh: the read falls back to the public page and reports the loss.
      try site.end()
      const lostBefore = try Ref.get(lost)
      const read = try via({ op: "read", page, base: "", text: "", key: `ended-${pick}` })
      if (read._tag !== "Success" || !read.success.pages.some((entry) => entry.source.includes("repository text")) || (try Ref.get(lost)) === lostBefore) throw new Finding({ report: `a read after the delegation ended answered ${reasonOf(read)}` })
      if (reasonOf(try via({ ...proposal, key: `after-${pick}` })) !== "connect") throw new Finding({ report: "a proposal after the delegation ended did not ask to connect" })
      break
    }
    case "store": {
      // A read served whole: the page, the person's role, no caching.
      const serve = effect (body: unknown) => {
        const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/wiki"), JSON.stringify(body)))
        const response = try Effect.provideService(serveWiki("wiki-steered", storage, repo).pipe(
          Effect.provideService(WikiAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
        ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
        return { status: response.status, text: try promise(() => HttpServerResponse.toWeb(response).text()) }
      }
      const read: WikiRequest = { op: "read", page, base: "", text: "", key: `store-${pick}` }
      const served = try serve(read)
      const answer = try Effect.try(() => JSON.parse(served.text) as { pages?: ReadonlyArray<{ source: string }>; role?: string })
      if (served.status !== 200 || answer.role !== "maintainer" || answer.pages?.some((entry) => entry.source.includes("repository text")) !== true) throw new Finding({ report: `a served read answered ${served.status}` })
      // Input the schema refuses, and a key it accepts but the execution id cannot use, are invalid and unwritten.
      const garbage = try execute({ ...read, op: "bogus" } as unknown as WikiRequest)
      if (garbage._tag !== "Failure" || garbage.failure.reason !== "invalid" || garbage.failure.unwritten !== true) throw new Finding({ report: `an unknown operation answered ${reasonOf(garbage)}` })
      if (reasonOf(try execute({ ...read, key: "bad key!" })) !== "invalid") throw new Finding({ report: "a malformed key was accepted" })
      // The engine's store refuses to open: a typed failure, served as 503 unavailable, never a defect.
      store.fail(/./)
      const broken = try execute({ ...read, key: `broken-${pick}` })
      if (broken._tag !== "Failure" || ["unavailable", "invalid", "connect", "missing"].includes(broken.failure.reason)) throw new Finding({ report: `a store that cannot open answered ${reasonOf(broken)}` })
      const refused = try serve({ ...read, key: `broken-${pick}` })
      if (refused.status !== 503 || refused.text !== JSON.stringify({ reason: "unavailable" })) throw new Finding({ report: `a store that cannot open was served as ${refused.status}` })
      // Healed and migrated, a request opens the engine twice; the second open alone fails, and that is unavailable.
      store.fail()
      try execute({ ...read, key: `healed-${pick}` })
      const mark = store.log.length
      try execute({ ...read, key: `migrated-${pick}` })
      const opens = store.log.slice(mark).filter((query) => query.includes("flows_migrations")).length
      if (opens === 0 || opens % 2 !== 0) throw new Finding({ report: `a request opened the store with ${opens} migration statements` })
      store.fail(/flows_migrations/, opens / 2)
      if (reasonOf(try execute({ ...read, key: `second-${pick}` })) !== "unavailable") throw new Finding({ report: "a run that cannot open the store was not unavailable" })
      // A failed proposal's join and recovery read its recorded payload and steps; either failing is unavailable.
      store.fail()
      if (reasonOf(try execute(proposal)) !== "connect") throw new Finding({ report: "an unconnected proposal did not ask to connect" })
      const reads: ReadonlyArray<readonly [string, RegExp, WikiRequest]> = [
        ["a join whose payload cannot be read", /FROM flows_runs r WHERE r\.run_id/, proposal],
        ["a recovery whose payload cannot be read", /FROM flows_runs r WHERE r\.run_id/, { ...proposal, recovery: "r1" }],
        ["a recovery whose steps cannot be read", /SELECT step_key_digest, attempt, state/, { ...proposal, recovery: "r1" }],
      ]
      for (const [label, pattern, request] of reads) {
        store.fail(pattern)
        const failed = try execute(request)
        if (reasonOf(failed) !== "unavailable") throw new Finding({ report: `${label} answered ${reasonOf(failed)}` })
      }
      store.fail()
      if (reasonOf(try execute({ ...proposal, recovery: "r1" })) !== "connect") throw new Finding({ report: "the healed recovery did not retry the proposal" })
      break
    }
    case "signed-out": {
      // A visitor reads through the site's cached public client. When GitHub then refuses, the last good copy answers,
      // marked with when GitHub confirmed it; through HTTP the visitor is a viewer, and a proposal is forbidden.
      const cache = try GitHub.ReadCache.make({ store: try GitHub.ReadCache.memoryStore(), upstream: fakeClient(fake), freshFor: 0 })
      const visitor: WikiAuthority.Shape = { current: () => succeed(undefined) }
      const visiting = <A, E, R>(program: A!E!R) => program.pipe(
        Effect.provideService(WikiAuthority, visitor), Effect.provideService(PublicReads, { client: cache }),
        Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
      )
      const readAs = (key: string) => Effect.result(visiting(executeWiki("wiki-visitor", storage, { op: "read", page, base: "", text: "", key }, repo)).pipe(
        Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
      ))
      const fresh = try readAs(`fresh-${pick}`)
      if (fresh._tag !== "Success" || fresh.success.stale !== undefined || fresh.success.role !== "viewer") throw new Finding({ report: `a visitor's read answered ${reasonOf(fresh)}` })
      fake.contentStatus = 503
      const kept = try readAs(`kept-${pick}`)
      fake.contentStatus = 200
      if (kept._tag !== "Success" || kept.success.stale === undefined || !kept.success.pages.some((entry) => entry.source.includes("repository text"))) throw new Finding({ report: `a visitor's read while GitHub refused answered ${reasonOf(kept)}` })
      const serve = effect (body: unknown) => {
        const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/wiki"), JSON.stringify(body)))
        const response = try Effect.provideService(visiting(serveWiki("wiki-visitor", storage, repo)), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
        return { status: response.status, text: try promise(() => HttpServerResponse.toWeb(response).text()) }
      }
      const served = try serve({ op: "read", page, base: "", text: "", key: `served-${pick}` })
      if (served.status !== 200 || (try Effect.try(() => JSON.parse(served.text) as { role?: string })).role !== "viewer") throw new Finding({ report: `a visitor's served read answered ${served.status}` })
      const refused = try serve({ ...proposal, key: `visitor-${pick}` })
      if (refused.status !== 403 || (try Effect.try(() => JSON.parse(refused.text) as { reason?: string })).reason !== "forbidden") throw new Finding({ report: `a visitor's proposal was served as ${refused.status}` })
      break
    }
    case "deadline": {
      // GitHub never answers a read: the read flow's engine deadline settles it, and the person gets unavailable.
      const silent: WikiHost.Shape = { perform: () => Effect.never }
      const deadline = try stepped(Effect.result(executeWiki("wiki-deadline", storage, { op: "read", page, base: "", text: "", key: `deadline-${pick}` }, repo).pipe(
        Effect.provideService(WikiAuthority, authority), Effect.provideService(WikiHost, silent), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
        Effect.mapError((error) => error._tag === "WikiFailure" ? error : new WikiFailure({ reason: error._tag })),
      )), 30)
      if (reasonOf(deadline) !== "unavailable") throw new Finding({ report: `a read past its deadline answered ${reasonOf(deadline)}` })
      break
    }
  }
  return true
})

// Every execution runs every scenario on fresh storage, so one execution reaches them all whatever the host load.
it.live("wiki/steered-host", () => run("wiki/steered-host", Steered, ({ pick, text }) => effect {
  for (const scenario of WIKI_SCENARIOS) try steeredScenario(scenario, pick, text)
  return true
}, undefined, { minimum: REPLAY_FLOOR }))
