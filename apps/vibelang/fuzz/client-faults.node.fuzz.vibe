import { it } from "@effect/vitest"
import { HttpClient, HttpClientError, HttpClientResponse, HttpServerResponse } from "effect/http"
import { ConversationRead, Factory } from "../src/core/Factory.vibe"
import { health, LiveFactory } from "../src/core/LiveFactory.vibe"
import { LiveRead } from "../src/core/LiveRead.vibe"
import { Mythical } from "../src/history/MythicalHistory.vibe"
import { LiveMythical } from "../src/history/LiveMythical.vibe"
import { BrowserFactory, AgentBackend } from "../src/web/backend.vibe"
import { BrowserMythical, HistoryBackend } from "../src/web/historyBackend.vibe"
import { chatModel, dailyTokens, DEFAULT_DAILY_TOKENS } from "../worker/AgentModel.vibe"
import { run, Finding, Int, REPLAY_FLOOR, Text, TextOrBoundary } from "./run.vibe"
import { Actions } from "../src/actions/Actions.vibe"
import { MockJournal } from "../src/core/MockJournal.vibe"
import { liveIssues } from "../src/core/LiveIssues.vibe"
import { liveWiki } from "../src/core/LiveWiki.vibe"
import { IssueRecord, IssueRequest, IssuesState, Specification, SpecificationEvent, SpecificationReview } from "../src/core/issueSchemas.vibe"
import { WikiRequest, WikiState } from "../src/core/wikiSchemas.vibe"

const Input = Schema.Struct({ operation: Int, fault: Schema.Literals(["transport", "json", "schema", "refusal", "status", "stream"]), text: Text })

/** A deliberately faulty Effect transport; no network interception or replacement global. */
function faulty(fault: typeof Input.Type["fault"], text: string) {
  return HttpClient.make((request) => {
    if (fault === "transport") return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request }) }))
    const status = fault === "status" ? 502 : fault === "refusal" ? 409 : 200
    let body = fault === "json" ? "{" : fault === "refusal" ? JSON.stringify({ refusal: "busy" })
      : fault === "stream" ? "data: {\n\n" : JSON.stringify({ unexpected: text })
    if (status === 200 && request.headers["accept"] === "text/event-stream") body = "data: " + (fault === "json" || fault === "stream" ? "{" : JSON.stringify({ unexpected: text })) + "\n\n"
    return succeed(HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.text(body, { status }))))
  })
}

function typed(result: Exit.Exit<unknown, unknown>, expectedSuccess = false): boolean {
  return result._tag === "Success" ? expectedSuccess : !Cause.hasDies(result.cause) && !Cause.hasInterrupts(result.cause)
}

it.live("clients/conversation-faults", () => run("clients/conversation-faults", Input, ({ operation, fault, text }) => effect {
  const client = Layer.succeed(HttpClient.HttpClient, faulty(fault, text))
  const h = try exit(Effect.provide(health("http://fault.invalid"), client))
  if (!typed(h)) return false
  provide Layer.merge(LiveFactory("http://fault.invalid"), LiveRead("http://fault.invalid")).pipe(Layer.provide(client)) {
    const factory = try Factory
    const reader = try ConversationRead
    const op = operation % 5
    const result = try exit(op === 0 ? factory.post("fuzz", "c", "Guest", text) : op === 1 ? factory.tour("fuzz") : op === 2 ? factory.endTour("fuzz") : op === 3 ? reader.read("fuzz", 0) : Stream.runDrain(factory.events("fuzz", 0)))
    return typed(result, op < 3 && fault !== "transport" && fault !== "status" && fault !== "refusal")
  }
}))

it.live("clients/history-faults", () => run("clients/history-faults", Input, ({ operation, fault, text }) => effect {
  provide LiveMythical("http://fault.invalid").pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, faulty(fault, text)))) {
    const history = try Mythical
    const result = try exit(effect {
      switch (operation % 10) {
        case 0: return try history.outline()
        case 1: return try history.plan({ how: "append", epic: "", newEpic: "Epic", target: "", title: text, task: "" })
        case 2: return try history.start("m1", "lane")
        case 3: return try history.note("m1", "tried", text)
        case 4: return try history.approve("m1")
        case 5: return try history.fold()
        case 6: return try Stream.runDrain(history.events(0))
        case 7: return try history.epic(text, operation)
        case 8: return try history.commit(text)
        default: return try history.search(text)
      }
    })
    return typed(result)
  }
}))

it.live("clients/browser-fallback", () => run("clients/browser-fallback", Schema.Struct({ forced: Schema.Boolean, id: Int }), ({ forced, id }) => effect {
  const client = Layer.succeed(HttpClient.HttpClient, faulty("transport", ""))
  provide BrowserFactory("http://fault.invalid", forced).pipe(Layer.provide(client)) {
    const factory = try Factory
    if (factory.mode !== "pending" && factory.mode !== "mock") return false
    if ((try (try AgentBackend).ready) !== "mock" || factory.mode !== "mock") return false
    const room = `f${id}`
    try factory.post(room, "c", "Guest", "install")
    const events = try Stream.runCollect(factory.events(room, 0).pipe(Stream.take(1)))
    if (events.length !== 1) return false
    try exit(factory.tour(room))
    try exit(factory.endTour(room))
  }
  provide BrowserMythical("http://fault.invalid", forced, { role: "maintainer", name: "Fuzz", agent: false }).pipe(Layer.provide(client)) {
    const history = try Mythical
    if (history.mode !== "pending" && history.mode !== "mock") return false
    if ((try (try HistoryBackend).ready) !== "mock" || history.mode !== "mock") return false
    const before = try history.outline()
    const listening = fork Stream.runCollect(history.events(before.seq).pipe(Stream.take(1)))
    const id = try history.plan({ how: "append", epic: "", newEpic: "Fuzz", target: "", title: "Fuzz", task: "" })
    try history.start(id, "fuzz")
    try history.note(id, "tried", "Fuzz")
    try history.approve(id)
    try history.fold()
    const seen = join listening
    return seen.length === 1 && (try history.commit(id)).commit?.id === id
  }
}))

it.live("config/model-records", () => run("config/model-records", Schema.Struct({ kind: Int, amount: Int }), ({ kind, amount }) => effect {
  const mode = kind % 5
  const record = mode === 1 ? "{" : JSON.stringify({ protocol: mode === 2 ? "unknown" : "openai-chat", baseUrl: "https://fuzz.invalid", modelId: "fuzz", credential: "FUZZ" })
  const values = mode === 0 ? {} : { CHAT_MODEL: record, CHAT_DAILY_TOKENS: String(amount), ...(mode === 4 ? { SMITHERS_MODEL_KEY_FUZZ: "synthetic-test-credential", SMITHERS_MODEL_KEY_FUZZ_ORIGIN: "https://fuzz.invalid" } : {}) }
  provide ConfigProvider.layer(ConfigProvider.fromUnknown(values)) {
    const result = try exit(chatModel())
    if (mode === 1) return typed(result)
    if (result._tag === "Failure" || (mode === 4 && result.value.model === undefined) || (mode !== 4 && result.value.model !== undefined)) return false
    const limit = try dailyTokens
    return typeof result.value.unusable === "string" && limit === (mode === 0 ? DEFAULT_DAILY_TOKENS : amount)
  }
}))

it.live("clients/history-agent-identity-boundary", () => run("clients/history-agent-identity-boundary", Text, (operation) => effect {
  const unreachable = HttpClient.make(() => Effect.die("an internal replay identity escaped to public HTTP"))
  provide LiveMythical("https://api.invalid").pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, unreachable))) {
    const history = try Mythical
    const answers = [
      try exit(history.plan({ how: "append", epic: "e1", newEpic: "", target: "", title: "Change", task: "" }, operation)),
      try exit(history.start("m1", "fuzz", operation)),
      try exit(history.note("m1", "tried", "Attempt.", operation)),
    ]
    return answers.every((answer) => {
      if (answer._tag === "Success" || Cause.hasDies(answer.cause)) return false
      const failure = Cause.findError(answer.cause)
      return failure._tag === "Success" && failure.success._tag === "Unavailable" && failure.success.reason === "history replay unavailable"
    })
  }
}))

/** Refusal reasons both the issues and the wiki protocol carry; a refusal outside the protocol is prefixed so it never names one. */
const SHARED_REASONS = ["forbidden", "budget", "invalid", "unavailable", "rate-limited", "no-model", "draft", "empty"] as const
// Preserve the original broad number domain for saved inputs: a state whose numbers JSON cannot carry (NaN, the
// infinities) or that are not counts must now be refused as `protocol` (0015, twelfth session).
const RawIssueRecord = Schema.Struct({ ...IssueRecord.fields, number: Schema.Number, githubId: Schema.Number, parent: Schema.Number, comments: Schema.Number })
const RawIssueRequest = Schema.Struct({ ...IssueRequest.fields, revision: Schema.optionalKey(Schema.Number), number: Schema.Number, parent: Schema.Number })
const RawReview = Schema.Struct({ ...SpecificationReview.fields, revision: Schema.Number })
const RawSpecification = Schema.Struct({ ...Specification.fields, revision: Schema.Number, astra: RawReview, sol: RawReview, fable: RawReview, opus: RawReview })
const RawSpecificationEvent = Schema.Struct({ ...SpecificationEvent.fields, revision: Schema.Number })
const RawSaved = Schema.Struct({ request: RawIssueRequest, status: Schema.Literals(["running", "failed", "completed"]), unwritten: Schema.Boolean, selected: Schema.Number })
const RawIssuesState = Schema.Struct({
  ...IssuesState.fields, seq: Schema.Number, selected: Schema.optionalKey(Schema.Number), stale: Schema.optionalKey(Schema.Number), items: Schema.Array(RawIssueRecord),
  specification: Schema.optionalKey(RawSpecification), specificationHistory: Schema.optionalKey(Schema.Array(RawSpecificationEvent)), saved: Schema.optionalKey(RawSaved),
})
const RawWikiState = Schema.Struct({ ...WikiState.fields, seq: Schema.Number, stale: Schema.optionalKey(Schema.Number) })
const Replies = Schema.Struct({
  op: Int, transport: Schema.Boolean, status: Schema.Literals([200, 400, 403, 409, 429, 500, 502]),
  body: Schema.Literals(["state", "refusal", "foreign-refusal", "other-json", "not-json"]),
  reason: Schema.Literals(SHARED_REASONS), foreign: Text, unwritten: Schema.optionalKey(Schema.Boolean),
  issues: RawIssuesState, wiki: RawWikiState, request: RawIssueRequest, change: WikiRequest, page: TextOrBoundary,
})

/**
 * The issues and wiki clients against any reply: a state the server sends decodes; a protocol refusal keeps its reason and
 * `unwritten`; anything else is `unavailable` (not 200) or `protocol` (200), and no reply makes the client die.
 */
function issuesWikiReplies(input: typeof Replies.Type) {
  return effect {
    const { op, transport, status, body, reason, foreign, unwritten, issues, wiki, request, change, page } = input
    const wikiOp = op % 4 >= 2
    const state = wikiOp ? wiki : issues
    const valid = wikiOp ? Schema.is(WikiState)(wiki) : Schema.is(IssuesState)(issues)
    const text = body === "state" ? JSON.stringify(state) : body === "refusal" ? JSON.stringify({ reason, ...(unwritten === undefined ? {} : { unwritten }) })
      : body === "foreign-refusal" ? JSON.stringify({ reason: `x-${foreign}` }) : body === "other-json" ? JSON.stringify({ unexpected: foreign }) : `{${foreign}`
    let sent = 0
    const client = HttpClient.make((wire) => {
      sent++
      if (transport) return fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request: wire }) }))
      return succeed(HttpClientResponse.fromWeb(wire, HttpServerResponse.toWeb(HttpServerResponse.text(text, { status, contentType: "application/json" }))))
    })
    provide Layer.succeed(HttpClient.HttpClient, client) {
      const result = try exit(effect {
        switch (op % 4) {
          case 0: return try (try liveIssues("http://fault.invalid")).read()
          case 1: return try (try liveIssues("http://fault.invalid")).act(request)
          case 2: return try (try liveWiki("http://fault.invalid")).read(page)
          default: return try (try liveWiki("http://fault.invalid")).act(change)
        }
      })
      if (result._tag === "Success") return !transport && status === 200 && body === "state" && valid
      if (Cause.hasDies(result.cause) || Cause.hasInterrupts(result.cause)) return false
      const failure = Cause.squash(result.cause) as { readonly reason?: string; readonly unwritten?: boolean }
      // A page that is not durable text is refused before any request.
      if (sent === 0) return op % 4 === 2 && failure.reason === "invalid" && failure.unwritten === true
      if (transport) return failure.reason === "unavailable"
      if (status === 200) return (body !== "state" || !valid) && failure.reason === "protocol"
      if (body === "refusal") return failure.reason === reason && failure.unwritten === unwritten
      return failure.reason === "unavailable" && failure.unwritten === undefined
    }
  }
}

it.live("clients/issues-wiki-replies", () => run("clients/issues-wiki-replies", Replies, (input) => effect {
  // Every execution: each call over a 200 whose body is not JSON, and one that is JSON but not a state, is `protocol`.
  for (const op of [0, 1, 2, 3]) for (const body of ["not-json", "other-json"] as const) {
    if (!(try issuesWikiReplies({ ...input, op, transport: false, status: 200, body }))) return false
  }
  return try issuesWikiReplies(input)
}))

/** Health answers that the live agent is up; every other request fails in transport: a faulty live backend. */
const liveDown = HttpClient.make((request) => request.url.endsWith("/api/health")
  ? succeed(HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.text(JSON.stringify({ ok: true, agent: "live" }), { status: 200, contentType: "application/json" }))))
  : fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request }) })))

/** Every member of the page's Factory and Actions, once each, as the app calls them. */
effect function everyDelegate(room: string, text: string) {
  const factory = try Factory
  const actions = try Actions
  const accounts = factory.accounts
  const page = "rulings"
  const calls: ReadonlyArray<readonly [string, Effect.Effect<unknown, unknown, never>]> = [
    ["current", accounts.current()], ["members", accounts.members()], ["grant", accounts.grant("4", "contributor")], ["granted", accounts.members()], ["choose", accounts.choose("new")],
    ["participated", accounts.participated("4")], ["signInAgent", accounts.signInAgent()], ["signOut", accounts.signOut()],
    ["accountEvents", Effect.timeoutOption(Stream.runHead(accounts.events(0)), "50 millis")],
    ["issuesRead", factory.issues.read()], ["issuesAct", factory.issues.act({ op: "read", number: 1, key: `k-${room}`, parent: 0, title: "", text: "", assignee: "", example: "", prior: "" })],
    ["wikiRead", factory.wiki.read(page)], ["wikiAct", factory.wiki.act({ op: "save", page, base: "# A", text: `# B ${text.toWellFormed()}`, key: `w-${room}` })],
    ["post", factory.post(room, `c-${room}`, "Guest", "install")], ["tour", factory.tour(room)], ["endTour", factory.endTour(room)],
    ["openWiki", factory.openWiki(room, page)], ["controlTour", factory.controlTour!(room, "pause", 1)],
    ["sandbox", factory.sandbox(room)], ["startSandbox", factory.startSandbox(room, `op-${room}`)], ["stopSandbox", factory.stopSandbox(room, `op2-${room}`, 1)],
    ["sandboxCommand", factory.sandboxCommand(room, `op3-${room}`, "pwd", 1)],
    ["actionsList", actions.list()], ["actionsCommands", actions.commands()], ["actionsRuns", actions.runs("vibelang/Post")],
  ]
  const results: Record<string, Exit.Exit<unknown, unknown>> = {}
  // Runs first: signing out below leaves a viewer, whom the mock refuses a run.
  const started = try exit(actions.start("vibelang/Post", { text: "q" }, "button"))
  results["start"] = started
  const id = started._tag === "Success" ? started.value : "none"
  results["readRun"] = try exit(actions.read(id))
  results["command"] = try exit(actions.command("/post q", "slash"))
  results["rerun"] = try exit(actions.rerun(id))
  results["cancel"] = try exit(actions.cancel(id))
  results["follow"] = try exit(Effect.timeoutOption(Stream.runHead(actions.follow(id)), "2 seconds"))
  for (const [name, call] of calls) results[name] = try exit(call)
  return { results, id, mode: factory.mode }
}

/**
 * The page's backend forwards every Factory and Actions member to the backend it selected. Over the mock (forced, as a
 * maintainer) each member answers as the mock does: members include the granted contributor, the issues and wiki
 * read, a started run reads and follows back as itself, and no member dies. Over a live backend whose server is
 * unreachable after health, the page selects live and every member fails with its typed failure, none dies, and the
 * history page's export fails typed. A second
 * forced mock over the same journal restores the conversation; unforced with health unreachable, the mock is a viewer.
 */
it.live("clients/browser-delegates", () => run("clients/browser-delegates", Schema.Struct({ id: Int, text: Text }), ({ id, text }) => scoped(effect {
  const room = `d${id}`
  const down = Layer.succeed(HttpClient.HttpClient, faulty("transport", ""))
  // The page's journal: the forced mock restores its conversations from it.
  const kept = new Map<string, ReadonlyArray<unknown>>()
  const journal = {
    read: (conversation: string) => sync(() => kept.get(conversation) ?? []),
    write: (conversation: string, events: ReadonlyArray<unknown>) => sync(() => { kept.set(conversation, events) }),
  } as unknown as MockJournal.Shape
  const mock = try scoped(Effect.provide(effect {
    const ready = try (try AgentBackend).ready
    const got = try everyDelegate(room, text)
    return { ...got, ready }
  }, BrowserFactory("http://fault.invalid", true, "maintainer", journal).pipe(Layer.provide(down))))
  if (mock.ready !== "mock" || mock.mode !== "mock") throw new Finding({ report: `forced mock selected ${mock.ready}, reads ${mock.mode}` })
  const restored = try scoped(Effect.provide(effect { return Array.from(try Stream.runCollect((try Factory).events(room, 0).pipe(Stream.take(1)))) }, BrowserFactory("http://fault.invalid", true, "maintainer", journal).pipe(Layer.provide(down))))
  if (restored.length !== 1) throw new Finding({ report: "the journal restored nothing" })
  // Unforced, with health unreachable: the mock, as a viewer.
  const fallback = try scoped(Effect.provide(effect {
    const ready = try (try AgentBackend).ready
    return { ready, identity: try (try Factory).accounts.current() }
  }, BrowserFactory("http://fault.invalid", false).pipe(Layer.provide(down))))
  if (fallback.ready !== "mock" || fallback.identity.role !== "viewer") throw new Finding({ report: `unreachable health selected ${fallback.ready} as ${fallback.identity.role}` })
  for (const [name, result] of Object.entries(mock.results)) if (!typed(result, true) && !typed(result)) throw new Finding({ report: `mock ${name} died` })
  const granted = mock.results["granted"]!
  if (granted._tag !== "Success" || (granted.value as ReadonlyArray<{ readonly id: string; readonly role: string }>).find((person) => person.id === "4")?.role !== "contributor") throw new Finding({ report: "the grant did not reach the mock" })
  for (const name of ["issuesRead", "wikiRead", "actionsList", "actionsCommands", "start", "readRun", "post"]) if (mock.results[name]!._tag !== "Success") throw new Finding({ report: `mock ${name} failed` })
  const read = mock.results["readRun"]!
  if (read._tag !== "Success" || (read.value as { readonly id: string }).id !== mock.id) throw new Finding({ report: "the started run reads as another" })
  const follow = mock.results["follow"]!
  if (follow._tag !== "Success" || Option.isNone(follow.value as Option.Option<unknown>)) throw new Finding({ report: "the started run follows nothing" })
  const live = try scoped(Effect.provide(effect {
    const ready = try (try AgentBackend).ready
    return { ...(try everyDelegate(room, text)), ready }
  }, BrowserFactory("http://fault.invalid", false).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, liveDown)))))
  if (live.ready !== "live" || live.mode !== "live") throw new Finding({ report: `health live selected ${live.ready}` })
  for (const [name, result] of Object.entries(live.results)) {
    // Streams that end or time out without an answer succeed with nothing; every request fails typed.
    // Live participation is recorded by the server itself; the page's call does nothing.
    const quiet = result._tag === "Success" && (name === "participated" || Option.isOption(result.value) && Option.isNone(result.value))
    if (!quiet && !typed(result)) throw new Finding({ report: `live ${name} did not fail typed` })
  }
  // The history page's backend over the same live page: the export it forwards fails typed.
  const published = try scoped(Effect.provide(effect {
    const ready = try (try HistoryBackend).ready
    return { ready, result: try exit((try Mythical).publish()) }
  }, BrowserMythical("http://fault.invalid", false, { role: "maintainer", name: "Fuzz", agent: false }).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, liveDown)))))
  if (published.ready !== "live" || !typed(published.result)) throw new Finding({ report: `live publish selected ${published.ready} or did not fail typed` })
  return true
// Four backends and every member of each: about two seconds per execution, hence the floor.
}), undefined, { minimum: REPLAY_FLOOR }))
