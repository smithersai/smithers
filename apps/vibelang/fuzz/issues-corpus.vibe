// Persisted counterexamples from before IssuesUi gained `connection`, and from before 8315745b made the eleven
// fields `init` and the actions panel's `initial` always set required.
// The saved files stay as found; the public Fuzz codec alone upgrades their JSON on replay.
import { Fuzz } from "@smthrs/fuzz"
import { initialIssues } from "../src/web/issues.vibe"
import { initial as initialActions } from "../src/web/actionModel.vibe"

function upgrade(value: unknown): unknown {
  if (Array.isArray(value)) return value.map(upgrade)
  if (typeof value !== "object" || value === null) return value
  const upgraded = Object.fromEntries(Object.entries(value).map(([key, item]) => [key, upgrade(item)]))
  if ("keyPrefix" in upgraded && "screen" in upgraded && !("connection" in upgraded)) return { ...upgraded, connection: initialIssues.connection }
  // A saved Model gets init's values for the fields it may lack; init names the tutorial after the session.
  if ("account" in upgraded && "surface" in upgraded && "session" in upgraded) {
    return { tutorialSession: upgraded.session, failedMedia: [], sandboxPane: "closed", sandboxOperation: "", sandboxBusy: false, sandboxError: "", terminalDraft: "", ...upgraded }
  }
  // A saved actions panel gets the panel's initial epoch, follow generation and follow lists.
  if ("runs" in upgraded && "entries" in upgraded && "commands" in upgraded) {
    const { epoch, followGeneration, disconnected, stoppedFollows } = initialActions
    return { epoch, followGeneration, disconnected, stoppedFollows, ...upgraded }
  }
  return upgraded
}

const parseJson = Schema.decodeSync(Schema.fromJsonString(Schema.Unknown))

/** The JSON codec Fuzz derives by default, reading saved values from before `connection` existed or 8315745b. */
export function issuesCorpusCodec<S extends Schema.Top>(schema: S): Fuzz.Codec<S["Type"]> {
  const codec: any = Schema.toCodecJson(schema as any)
  const encode: (value: unknown) => unknown = Schema.encodeSync(codec)
  const decode: (value: unknown) => S["Type"] = Schema.decodeSync(codec)
  return { id: "json", encode: (value) => JSON.stringify(encode(value)), decode: (text) => decode(upgrade(parseJson(text))) }
}
