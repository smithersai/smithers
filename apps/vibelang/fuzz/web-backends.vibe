// The backends a web target runs its Commands and subscriptions against: real mock services, or typed faults.
import { Factory, Unavailable, Refused } from "../src/core/Factory.vibe"
import { mockFactoryFor } from "../src/core/MockFactory.vibe"
import { AccountUnavailable } from "../src/core/roles.vibe"
import { IssueFailure, IssuesState, type IssueRequest } from "../src/core/issueSchemas.vibe"
import { WikiFailure } from "../src/core/wikiSchemas.vibe"
import { Actions, ActionFailure } from "../src/actions/Actions.vibe"
import { MockActions } from "../src/actions/MockActions.vibe"

export const Backend = Schema.Literals(["mock", "live", "bare", "faulty", "closing", "roleless"])
export const Role = Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])
export type Backend = typeof Backend.Type

const unavailable = fail(new Unavailable({ reason: "fault" }))
const refused = fail(new Refused({ refusal: "busy" }))
const noAccount = fail(new AccountUnavailable({ reason: "fault" }))

/** A backend whose every operation answers with its typed failure. */
const faulty: Factory.Shape = {
  mode: "mock",
  accounts: {
    current: () => noAccount, members: () => noAccount, grant: () => noAccount, signOut: () => noAccount,
    signInAgent: () => noAccount, choose: () => noAccount, participated: () => noAccount, events: () => Stream.fail(new AccountUnavailable({ reason: "fault" })),
  },
  issues: { read: () => fail(new IssueFailure({ reason: "unavailable" })), act: () => fail(new IssueFailure({ reason: "conflict", unwritten: true })) },
  wiki: { read: () => fail(new WikiFailure({ reason: "unavailable" })), act: () => fail(new WikiFailure({ reason: "conflict", unwritten: true })) },
  post: () => refused,
  read: () => unavailable,
  events: () => Stream.fail(new Unavailable({ reason: "fault" })),
  tour: () => refused,
  openWiki: () => unavailable,
  controlTour: () => unavailable,
  endTour: () => unavailable,
  sandbox: () => unavailable,
  startSandbox: () => refused,
  stopSandbox: () => unavailable,
  sandboxCommand: () => refused,
}

const noActions: Actions.Shape = {
  list: () => fail(new ActionFailure({ code: "fault" })), commands: () => fail(new ActionFailure({ code: "fault" })), runs: () => fail(new ActionFailure({ code: "fault" })),
  read: () => fail(new ActionFailure({ code: "fault" })), start: () => fail(new ActionFailure({ code: "fault" })), command: () => fail(new ActionFailure({ code: "fault" })),
  rerun: () => fail(new ActionFailure({ code: "fault" })), cancel: () => fail(new ActionFailure({ code: "fault" })), follow: () => Stream.fail(new ActionFailure({ code: "fault" })),
}

/** Accounts whose role stream ends at once, as when the server closes it. */
function closingRoles(accounts: NonNullable<Factory.Shape["accounts"]>): NonNullable<Factory.Shape["accounts"]> {
  return Object.assign(Object.create(accounts), { events: () => Stream.empty })
}

/** Issues whose answers carry no role, as a server that omits it: the client falls back to its mode's default. */
function rolelessIssues(issues: NonNullable<Factory.Shape["issues"]>): NonNullable<Factory.Shape["issues"]> {
  const strip = (state: typeof IssuesState.Type) => { const { role: _, ...rest } = state; return rest }
  return Object.assign(Object.create(issues), { read: () => map(issues.read(), strip), act: (request: IssueRequest) => map(issues.act(request), strip) })
}

/** The same service object with some members replaced; a service's methods do not survive an object spread. */
function changedFactory(factory: Factory.Shape, change: Record<string, unknown>): Factory.Shape {
  return Object.assign(Object.create(factory) as Factory.Shape, change)
}

/** The real mock Factory and Actions, the same seen as live, without optional services, failing everywhere, with a role stream the server closes, or with role-less issue answers. */
export function backend(kind: Backend, role: typeof Role.Type) {
  if (kind === "faulty") return Layer.merge(Layer.succeed(Factory, faulty), Layer.succeed(Actions, noActions))
  const mock = mockFactoryFor(role)
  const changed = Layer.effect(Factory, map(Factory, (factory) => kind === "live" ? changedFactory(factory, { mode: "live" }) : kind === "bare" ? changedFactory(factory, { accounts: undefined, issues: undefined, wiki: undefined, controlTour: undefined }) : kind === "closing" ? changedFactory(factory, { accounts: closingRoles(factory.accounts!) }) : kind === "roleless" ? changedFactory(factory, { issues: rolelessIssues(factory.issues!) }) : factory)).pipe(Layer.provide(mock))
  return Layer.provideMerge(MockActions({ actor: "person" }), changed)
}

/** The real mock backend with some Factory members replaced, as `change` builds them from the mock's own. */
export function backendChanged(role: typeof Role.Type, change: (factory: Factory.Shape) => Record<string, unknown>) {
  const changed = Layer.effect(Factory, map(Factory, (factory) => changedFactory(factory, change(factory)))).pipe(Layer.provide(mockFactoryFor(role)))
  return Layer.provideMerge(MockActions({ actor: "person" }), changed)
}

/** What the wiki answers in an otherwise working mock: its own pages, or one injected fault. */
export const WikiFault = Schema.Literals(["none", "read-fails", "missing", "draft", "unwritten", "kept", "stale", "unlisted"])

/** The confirmation time the `stale` wiki answers with. */
export const WIKI_STALE = 1_762_782_000_000

function faultyWiki(wiki: NonNullable<Factory.Shape["wiki"]>, fault: typeof WikiFault.Type): NonNullable<Factory.Shape["wiki"]> {
  switch (fault) {
    case "none": return wiki
    case "read-fails": return Object.assign(Object.create(wiki), { read: () => fail(new WikiFailure({ reason: "unavailable" })) })
    case "missing": return Object.assign(Object.create(wiki), { read: (page: string) => map(wiki.read(page), (snapshot) => ({ ...snapshot, pages: snapshot.pages.filter((entry) => entry.id !== page) })) })
    case "draft": return Object.assign(Object.create(wiki), { read: (page: string) => map(wiki.read(page), (snapshot) => ({ ...snapshot, draft: { page, text: "# Draft" } })) })
    case "unwritten": return Object.assign(Object.create(wiki), { act: () => fail(new WikiFailure({ reason: "conflict", unwritten: true })) })
    case "kept": return Object.assign(Object.create(wiki), { act: () => fail(new WikiFailure({ reason: "unavailable" })) })
    case "stale": return Object.assign(Object.create(wiki), { read: (page: string) => map(wiki.read(page), (snapshot) => ({ ...snapshot, stale: WIKI_STALE })) })
    case "unlisted": return Object.assign(Object.create(wiki), { act: (request: Parameters<typeof wiki.act>[0]) => map(wiki.act(request), (snapshot) => { const { review: _, ...rest } = snapshot; return { ...rest, pages: rest.pages.filter((entry) => entry.id !== request.page) } }) })
  }
}

/** The real mock backend with its wiki answering `fault`. */
export function backendWithWiki(role: typeof Role.Type, fault: typeof WikiFault.Type) {
  const changed = Layer.effect(Factory, map(Factory, (factory) => changedFactory(factory, { wiki: faultyWiki(factory.wiki!, fault) }))).pipe(Layer.provide(mockFactoryFor(role)))
  return Layer.provideMerge(MockActions({ actor: "person" }), changed)
}

/**
 * The real mock backend whose first `failures` posts answer unreachable. With `lost`, each of those posts is stored
 * first and only its answer is lost, as when a connection drops after the server accepted it.
 */
export function backendWithFailingPosts(role: typeof Role.Type, failures: number, lost: boolean) {
  let calls = 0
  const changed = Layer.effect(Factory, map(Factory, (factory) => changedFactory(factory, {
    post: (conversation: string, clientId: string, name: string, text: string) => effect {
      calls++
      if (calls > failures) return try factory.post(conversation, clientId, name, text)
      if (lost) try factory.post(conversation, clientId, name, text)
      try unavailable
    },
  }))).pipe(Layer.provide(mockFactoryFor(role)))
  return Layer.provideMerge(MockActions({ actor: "person" }), changed)
}
