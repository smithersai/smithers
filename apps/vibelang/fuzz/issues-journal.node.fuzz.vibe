// Journaled issue writes through the durable engine on real SQLite: a replay of the same key joins its receipt and
// writes nothing, a changed payload under it is refused, a resumed read reports the original's outcome, and an
// explicit recovery retries only a failed write. Every write goes through smithers.sh's delegation, and a run in which
// none reached GitHub fails.
import { it } from "@effect/vitest"
import { HttpClient, HttpClientRequest, HttpServerRequest, HttpServerResponse } from "effect/http"
import { TestNodeRuntime } from "@smthrs/platform-node"
import { IssueFailure, type IssueRequest } from "../src/core/issueSchemas.vibe"
import { executeIssues, serveIssues, IssueAuthority } from "../worker/Issues.vibe"
import { GitHubDelegate } from "../worker/GitHubDelegate.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { fakeClient, forked, repo, seed } from "./issues-node-fake.vibe"
import { delegated, reach, reached } from "./delegated.vibe"
import { run, Finding } from "./run.vibe"

const Words = Schema.Literals(["", " ", "word", "A longer body"])
const Write = Schema.Struct({
  op: Schema.Literals(["new", "split", "comment", "propose", "commit", "accept"]),
  number: Schema.Literals([1, 2, 3, 4, 9999]),
  title: Words, text: Words, example: Words, prior: Words,
  forbidden: Schema.Boolean,
  agent: Schema.Boolean,
  then: Schema.Literals(["replay", "change", "resume", "resume-recovered", "recover", "bad-recovery", "signed-out-resume", "bad-resume", "http"]),
})

const counter = reach()
const journaledWrites = (input: typeof Write.Type) => effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const storage = raw as unknown as Storage
  const fake = seed()
  forked(fake)
  const site = try delegated(fakeClient(fake), counter)
  const signedIn = try Ref.make(true)
  const authority: IssueAuthority.Shape = { current: () => Effect.map(Ref.get(signedIn), (on) => on ? { id: "7", login: "fuzz", role: "maintainer" as const, connection: site.connection, kind: input.agent ? "agent" as const : "person" as const } : undefined) }
  const client = site.http
  const execute = (request: IssueRequest) => Effect.result(executeIssues("journal", storage, request, repo).pipe(Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, client), Effect.provideService(GitHubDelegate, site.delegate)))
  /** The engine's store failures stay untyped by reason; a refusal is an IssueFailure's reason. */
  const reasonOf = (result: Effect.Success<ReturnType<typeof execute>>) => result._tag === "Success" ? "ok" : result.failure._tag === "IssueFailure" ? result.failure.reason : result.failure._tag
  fake.forbiddenNext = input.forbidden
  const request: IssueRequest = { op: input.op, number: input.number, parent: 0, title: input.title, text: input.text, example: input.example, prior: input.prior, assignee: "fuzz", key: "journal-1" }
  const first = try execute(request)
  if (first._tag === "Failure" && first.failure._tag !== "IssueFailure") throw new Finding({ report: "a write failed untyped" })
  const writes = fake.writes
  switch (input.then) {
    case "replay": {
      const again = try execute(request)
      if (again._tag !== first._tag || fake.writes !== writes) throw new Finding({ report: "a replayed write did something new" })
      break
    }
    case "change": {
      const changed = try execute({ ...request, text: `${request.text} changed` })
      if (reasonOf(changed) !== (input.agent && input.op === "accept" ? "forbidden" : "invalid") || fake.writes !== writes) throw new Finding({ report: "a changed payload under a used key was not refused" })
      break
    }
    case "resume":
    case "resume-recovered":
    case "signed-out-resume":
    case "bad-resume": {
      if (input.then === "resume-recovered" && first._tag === "Failure") try execute({ ...request, recovery: "r1" })
      if (input.then === "signed-out-resume") try Ref.set(signedIn, false)
      const resumed = try execute({ op: "read", number: 0, parent: 0, title: "", text: "", example: "", prior: "", assignee: "", key: "journal-read", resumeOp: input.then === "bad-resume" ? "read" : request.op, resumeKey: request.key, ...(input.then === "resume-recovered" ? { resumeRecovery: "r1" } : {}) })
      if (input.then === "signed-out-resume") { if (reasonOf(resumed) !== "sign-in") throw new Finding({ report: "a signed-out resume was not refused" }); break }
      if (input.then === "bad-resume") { if (reasonOf(resumed) !== "invalid") throw new Finding({ report: "a resume of a read was not refused" }); break }
      if (resumed._tag === "Failure") break
      const saved = resumed.success.saved
      if (saved === undefined || saved.request.key !== request.key || saved.request.op !== request.op) throw new Finding({ report: "a resumed read lost its request" })
      if (input.then === "resume" && saved.status !== (first._tag === "Success" ? "completed" : "failed")) throw new Finding({ report: `a resumed read reported ${saved.status}` })
      break
    }
    case "recover": {
      const recovered = try execute({ ...request, recovery: "r1" })
      if (first._tag === "Success" && (recovered._tag !== "Success" || fake.writes !== writes)) throw new Finding({ report: "recovering a completed write wrote again" })
      if (recovered._tag === "Failure" && recovered.failure._tag !== "IssueFailure") throw new Finding({ report: "a recovery failed untyped" })
      break
    }
    case "bad-recovery": {
      const refused = try execute({ ...request, recovery: "bad recovery!" })
      // An agent's review is refused before its input is read.
      const refusedAs = input.agent && (input.op === "accept") ? "forbidden" : "invalid"
      if (reasonOf(refused) !== refusedAs) throw new Finding({ report: `a malformed recovery key answered ${reasonOf(refused)}` })
      break
    }
    default: {
      // The same request over HTTP: a refusal's status names its reason, and a success answers the state.
      const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/issues"), JSON.stringify({ ...request, key: "journal-http" })))
      const response = try Effect.provideService(serveIssues("journal", storage, repo, () => Effect.void).pipe(Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, client), Effect.provideService(GitHubDelegate, site.delegate)), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
      const text = try promise(() => HttpServerResponse.toWeb(response).text())
      const parsed = try Effect.try(() => JSON.parse(text))
      const expected: Record<string, number> = { forbidden: 403, "sign-in": 401, connect: 401, missing: 404, unknown: 409, title: 400, incomplete: 400, assignee: 400, empty: 400, tree: 400, invalid: 400, review: 400, closed: 400, fork: 400, install: 400 }
      if (response.status === 200 ? !Array.isArray(parsed.items) : response.status !== (expected[parsed.reason] ?? 503)) throw new Finding({ report: `HTTP answered ${response.status} for ${parsed.reason}` })
    }
  }
  return true
}
it.live("issues/journaled-writes", () => Effect.andThen(run("issues/journaled-writes", Write, journaledWrites), reached("issues/journaled-writes", counter, journaledWrites, { op: "comment", number: 1, title: "word", text: "word", example: "", prior: "", forbidden: false, agent: false, then: "replay" })))
