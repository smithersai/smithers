// The issues pane rendered over the mock Factory's real records (parents, children, notes, VIPs, tasks) under every
// screen, role, filter, failure and connection state. screens/issues-view-names-controls generates whole records, which
// rarely link to each other, so the detail screen, its tree, notes and actions stayed unrendered.
import { it } from "@effect/vitest"
import { all, attr, click, Command as SceneCommand, expectHandled, expectIgnored, find, getAllByRole, findAll, given, keydown, nth, role as locate, scene, tap, textContent, type as typeInto, type Locator, type SceneSimulation } from "foldkit/scene"
import { Actions } from "../src/actions/Actions.vibe"
import { backend, Backend } from "./web-backends.vibe"
import { Factory } from "../src/core/Factory.vibe"
import { mockFactoryFor } from "../src/core/MockFactory.vibe"
import { issuePermission, specificationAccepted } from "../src/core/conversation.vibe"
import { IssuesUi, initialIssues } from "../src/web/issues.vibe"
import { Specification, SpecificationEvent } from "../src/core/issueSchemas.vibe"
import { emptySpecification, fixtureSpecification } from "../src/core/specification.vibe"
import { accountOf, Flags, init, Message, Model, update } from "../src/web/main.vibe"
import { view } from "../src/web/view.vibe"
import { run, Finding, Int, Text } from "./run.vibe"

const ROLES = ["button", "link", "textbox", "combobox", "checkbox", "radio", "switch", "slider", "searchbox", "spinbutton", "option", "tab", "menuitem", "treeitem"]
const ROLE = Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])
const OP = Schema.Literals(["new", "comment", "link", "split", "commit", "uncommit", "propose", "accept", "decline", "read"])
const NoteText = Schema.Union([Text, Schema.Literals(["added the language label", "removed the  label", "accepted the proposal", "proposed #1", "See #1 and #2, not #0", "```vibe\nconst x = 1\n```", "a `code` #3 part", ""])])
const Note = Schema.Struct({ author: Schema.Literals(["VibeLang agent", "ada", "Will", ""]), text: NoteText, event: Schema.Boolean, age: Schema.Literals(["", "2d", "1d", "3w", "1w", "just now", "yesterday"]) })

const Input = Schema.Struct({
  flags: Flags,
  /** Screen, status and dialog are weighted toward a ready list or issue with no dialog, where most of the pane is. */
  screen: Int,
  kind: Schema.Literals(["All", "Issues", "Tasks", "VIPs"]),
  state: Schema.Literals(["open", "closed"]),
  /** 0 to 15 no query; 16 to 23 a cased slice of the selected record's title; 24 to 27 its number; else the text. */
  queryKind: Int,
  queryText: Schema.Union([Text, Schema.Literals(["zzzz", "#1", "vip", "LANGUAGE"])]),
  role: ROLE,
  /** An index into the records, wrapping; one slot past the last selects a number no record has. */
  pick: Int,
  dialog: Int,
  status: Int,
  busy: Schema.Boolean,
  step: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 4 })),
  error: Schema.Literals(["", "Connect GitHub.", "Fork on GitHub.", "Install Smithers on your fork.", "Couldn't load comments. Retry.", "That issue changed."]),
  retry: Schema.optionalKey(OP),
  connected: Schema.optionalKey(Schema.Boolean),
  absoluteDates: Schema.optionalKey(Schema.Boolean),
  stale: Schema.optionalKey(Schema.Literals([0, 1_762_782_000_000, 8_640_000_000_000_001])),
  reviewers: Schema.optionalKey(Schema.Array(Schema.Literals(["Will", "Maya", ""])).check(Schema.isMaxLength(3))),
  assignees: Schema.optionalKey(Schema.Array(Schema.Struct({ login: Schema.Literals(["will", "maya", "a"]), label: Schema.Literals(["", " ", "Maya", "Will"]) })).check(Schema.isMaxLength(3))),
  /** Overrides on the selected record, so its tree, proposal gate, notes and aside take every form. */
  vip: Schema.optionalKey(Schema.Literals(["", "In review", "Accepted", "Declined"])),
  task: Schema.optionalKey(Schema.Literals(["", "Queued", "Running", "Done"])),
  recordState: Schema.optionalKey(Schema.Literals(["open", "closed"])),
  approved: Schema.Boolean,
  assignee: Schema.Literals(["", "VibeLang agent", "maya"]),
  notes: Schema.optionalKey(Schema.Array(Note).check(Schema.isMaxLength(6))),
  specification: Schema.optionalKey(Specification),
  /** Every reviewer's LGTM on the specification's own revision: the accepted gate, which random reviews rarely reach. */
  accepted: Schema.Boolean,
  history: Schema.optionalKey(Schema.Array(SpecificationEvent).check(Schema.isMaxLength(4))),
  body: Schema.optionalKey(NoteText),
  age: Schema.Literals(["", "2d", "1d", "3w", "1w", "just now"]),
})
type Input = typeof Input.Type
type Item = IssuesUi["data"]["items"][number]

/** The mock Factory's issue records, as a maintainer sees them. */
effect function mockItems() {
  provide mockFactoryFor("maintainer") {
    return (try (try Factory).issues.read()).items
  }
}

const SCREENS = ["list", "detail", "new", "vip", "roles", "specification"] as const
function screenOf(n: number): IssuesUi["screen"] { return n < 12 ? "list" : n < 22 ? "detail" : SCREENS[n % SCREENS.length]! }
function statusOf(n: number): IssuesUi["status"] { return n < 24 ? "ready" : n < 28 ? "loading" : "error" }
function dialogOf(n: number): IssuesUi["dialog"] { return n < 24 ? "" : n < 27 ? "commit" : n < 30 ? "split" : "link" }

function uiOf(input: Input, records: ReadonlyArray<Item>): IssuesUi {
  const chosen = records[input.pick % (records.length + 1)]
  const selected = chosen?.number ?? 9_999
  const items = records.map(item => item.number !== selected ? item : {
    ...item,
    ...(input.vip === undefined ? {} : { vip: input.vip }),
    ...(input.task === undefined ? {} : { task: input.task }),
    ...(input.recordState === undefined ? {} : { state: input.recordState }),
    ...(input.approved ? { approvedBy: "Will", approvedAt: "2026-11-10" } : {}),
    ...(input.notes === undefined ? {} : { notes: input.notes }),
    ...(input.body === undefined ? {} : { body: input.body }),
    assignee: input.assignee, age: input.age,
  })
  const title = chosen?.title ?? ""
  const query = input.queryKind < 16 ? "" : input.queryKind < 24 ? title.slice(input.queryKind % 3, input.queryKind % 3 + 6).toUpperCase() : input.queryKind < 28 ? `#${selected}` : input.queryText
  const base = input.specification
  const lgtm = (review: typeof Specification.Type["astra"]) => ({ ...review, verdict: "LGTM" as const, revision: base?.revision ?? 0 })
  const specification = base === undefined ? {} : { specification: input.accepted ? { ...base, astra: lgtm(base.astra), sol: lgtm(base.sol), fable: lgtm(base.fable), opus: lgtm(base.opus) } : base }
  const retry = input.retry === undefined ? {} : { retry: { op: input.retry, number: selected, parent: 0, title: "T", text: "S", assignee: "", example: "", prior: "", key: "k-1" } }
  return {
    ...initialIssues, open: true, screen: screenOf(input.screen), kind: input.kind, state: input.state, query, role: input.role, selected,
    dialog: dialogOf(input.dialog), status: statusOf(input.status), busy: input.busy, step: input.step, error: input.error, title: "T", summary: "S", ...retry,
    data: {
      seq: 1, items, ...specification,
      ...(input.history === undefined ? {} : { specificationHistory: input.history }),
      ...(input.connected === undefined ? {} : { connected: input.connected }),
      ...(input.absoluteDates === undefined ? {} : { absoluteDates: input.absoluteDates }),
      ...(input.stale === undefined ? {} : { stale: input.stale }),
      ...(input.reviewers === undefined ? {} : { reviewers: input.reviewers }),
      ...(input.assignees === undefined ? {} : { assignees: input.assignees }),
    },
  }
}

function count(html: SceneSimulation<Model, Message>["html"], role: string, name: string | RegExp): number {
  return getAllByRole(role, { name })(html).length
}

/**
 * Every control keeps a name and no script is emitted. On an issue: its title heads the page, or "Issue unavailable"
 * shows for a number no record has; the comment box shows exactly when the role may comment on a connected tracker;
 * Commit or Uncommit exactly when the role may commit a non-VIP that is open or a task; Accept and Decline exactly when
 * the role may accept a VIP in review. An open dialog names its action and issue. On the specification, the four review requests and the editor follow the role, and the suites show exactly when the
 * gate accepts. On the list, the New issue or Propose a VIP control shows only when the role may.
 */
it.live("screens/issues-records", () => scoped(effect {
  const records = try mockItems()
  try run("screens/issues-records", Input, (input) => {
    const ui = uiOf(input, records)
    const base = init(input.flags).model
    // The pane reads the role from the account (issueStateOf), so both carry the generated role.
    const model: Model = { ...base, surface: "chat", issues: ui, account: { ...accountOf(base), identity: { ...accountOf(base).identity, role: input.role } } }
    const issue = ui.data.items.find(item => item.number === ui.selected)
    const connected = ui.data.connected !== false
    let holds = true
    scene({ update, view }, given(model), (simulation: SceneSimulation<Model, Message>) => {
      const html = simulation.html
      for (const role of ROLES) if (getAllByRole(role)(html).length !== getAllByRole(role, { name: /\S/ })(html).length) holds = false
      if (findAll(html, "script").length !== 0) holds = false
      // An open dialog names the action and the issue it acts on; no other dialog does.
      if (count(html, "dialog", new RegExp(`^(Commit|Split|Link) #${ui.selected}`)) !== (ui.dialog === "" ? 0 : 1)) holds = false
      if (ui.screen === "detail") {
        if (issue === undefined) {
          if (count(html, "heading", "Issue") !== 1 || count(html, "textbox", "Comment") !== 0) holds = false
          return simulation
        }
        if (count(html, "heading", new RegExp(`#${issue.number}$`)) < 1) holds = false
        if (count(html, "textbox", "Comment") !== (connected && issuePermission(ui.role, "comment") ? 1 : 0)) holds = false
        const commit = connected && issuePermission(ui.role, "commit") && issue.vip === "" && (issue.state === "open" || issue.task !== "")
        // The commit dialog's own submit button is also named Commit.
        if (ui.dialog === "" && count(html, "button", /^(Commit|Uncommit)$/) !== (commit ? 1 : 0)) holds = false
        const accept = connected && issuePermission(ui.role, "accept") && issue.vip === "In review"
        if (count(html, "button", /^(Accept|Decline)$/) !== (accept ? 2 : 0)) holds = false
      }
      if (ui.screen === "specification") {
        if (count(html, "button", "Request review") !== (issuePermission(ui.role, "spec-review") ? 4 : 0)) holds = false
        if (count(html, "textbox", "Specification text") !== (issuePermission(ui.role, "spec-revise") ? 1 : 0)) holds = false
        // The suites' self-consistency shows exactly when the specification gate reads Accepted.
        if (count(html, "status", "Specification gate") !== 1) holds = false
        if (findAll(html, ".sui-card-title").some(node => textContent(node) === "Self-consistency") !== specificationAccepted(ui.data.specification ?? emptySpecification)) holds = false
      }
      if (ui.screen === "list" && !(connected && issuePermission(ui.role, ui.kind === "VIPs" ? "propose" : "new"))) {
        if (count(html, "button", /^(New issue|Propose a VIP)$/) !== 0) holds = false
      }
      return simulation
    })
    return holds
  })
}))

const KEY_TARGETS = ["kind", "row", "comment", "title", "assignee"] as const
const Keyed = Schema.Struct({
  /** The control the key goes to; the pane is put on the screen that shows it. */
  target: Schema.Literals(KEY_TARGETS),
  /** Which key, from the control's own keys and one it ignores (KEYS). */
  press: Int,
  meta: Schema.Boolean,
  control: Schema.Boolean,
  /** Which kind radio or list row takes the key. */
  index: Int,
  comment: Schema.Union([Text, Schema.Literals(["", " ", "Looks right."])]),
  vip: Schema.Boolean,
  backend: Backend,
})
/** Each control's handled keys, weighted, then keys it must ignore. */
const KEYS: Record<typeof KEY_TARGETS[number], ReadonlyArray<string>> = {
  kind: ["ArrowRight", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowDown", "Enter"],
  row: ["j", "k", "j", "k", "ArrowDown", "J"],
  comment: ["Enter", "Enter", "Enter", "a", "Escape"],
  title: ["Enter", "Enter", "a", "Tab"],
  assignee: ["Enter", "Enter", " ", "ArrowDown"],
}
function keyOf(k: { readonly target: typeof KEY_TARGETS[number]; readonly press: number }): string {
  const keys = KEYS[k.target]
  return keys[k.press % keys.length]!
}
const KeysInput = Schema.Struct({ ...Input.fields, keyed: Keyed })
type KeysInput = typeof KeysInput.Type

type Html = SceneSimulation<Model, Message>["html"]
type Step = (simulation: SceneSimulation<Model, Message>) => SceneSimulation<Model, Message>
interface Pending { readonly name: string; readonly args?: Record<string, unknown>; readonly effect: Effect<Message, unknown, Factory | Actions> }

const MAX_ROUNDS = 12

// Scene's step builders are plain functions; effect code calls them through these.
function resolveStep(answers: ReadonlyArray<readonly [Pending, Message]>): Step {
  return (SceneCommand.resolveAll as unknown as (...resolvers: ReadonlyArray<readonly [Pending, Message]>) => Step)(...answers)
}
function pressSteps(plan: { readonly target: string | Locator; readonly handled: boolean; readonly mods?: { readonly metaKey: boolean; readonly ctrlKey: boolean } }, key: string): ReadonlyArray<Step> {
  return [keydown(plan.target, key, plan.mods ?? {}) as unknown as Step, (plan.handled ? expectHandled() : expectIgnored()) as unknown as Step]
}
function clickStep(target: string): Step { return click(target) as unknown as Step }
function findOne(html: Html, target: string): Option.Option<Html> { return find(html, target) }

/**
 * The issues pane as data: every tag, attribute and text, without the handlers, so two paths can be compared. Only the
 * pane: any Message also lets `update` re-measure the splash, which is not the key's doing.
 */
function shape(html: Html): string {
  const pane = find(html, "section.ix-surface")
  return Option.isNone(pane) ? "no pane" : JSON.stringify(pane.value, (_key, value) => typeof value === "function" ? undefined : value)
}

function disabled(node: Html): boolean {
  const data = (node as { data?: { attrs?: Record<string, unknown>; props?: Record<string, unknown> } }).data
  return data?.attrs?.["disabled"] === true || data?.attrs?.["disabled"] === "" || data?.props?.["disabled"] === true
}

/**
 * Runs `steps` from `model` the way the runtime would: every Command a step or an answer dispatches runs once against
 * the provided backend and its Message goes back through `update`, until none is pending. Returns the settled view,
 * the Commands that ran, and the Commands the first step dispatched.
 */
effect function settle(model: Model, steps: ReadonlyArray<Step>) {
  const answers: Array<readonly [Pending, Message]> = []
  const ran: Array<Pending> = []
  let first: ReadonlyArray<Pending> | undefined
  for (let round = 0; round < MAX_ROUNDS; round++) {
    let pending: ReadonlyArray<Pending> = []
    let html: Html | undefined
    const resolve = resolveStep(answers)
    const outcome = try Effect.result(Effect.try(() => scene({ update, view }, given(model), ...steps, resolve, tap((simulation: SceneSimulation<Model, Message>) => {
      pending = simulation.commands as unknown as ReadonlyArray<Pending>
      html = simulation.html
    }))))
    first ??= pending
    if (pending.length === 0) {
      if (outcome._tag === "Failure") throw new Finding({ report: `scene: ${String(outcome.failure.cause)}` })
      return { html: html!, ran, first }
    }
    for (const command of pending) {
      const result = try exit(timeout(command.effect, "5 seconds"))
      if (result._tag === "Failure") throw new Finding({ report: `${command.name}: ${Cause.pretty(result.cause)}` })
      if (!Schema.is(Message)(result.value)) throw new Finding({ report: `${command.name}: answered with an undeclared Message` })
      answers.push([command, result.value])
      ran.push(command)
    }
  }
  throw new Finding({ report: `Commands still pending after ${MAX_ROUNDS} rounds` })
}

/** `settle` against a fresh backend of the generated kind, so each path starts from the same records. */
effect function settledOn(input: KeysInput, model: Model, steps: ReadonlyArray<Step>) {
  provide backend(input.keyed.backend, input.role) {
    return try settle(model, steps)
  }
}

/** The pane put on the screen that shows the keyed control, over the generated state. */
function keyedUi(input: KeysInput, records: ReadonlyArray<Item>): IssuesUi {
  const ui = uiOf(input, records)
  const k = input.keyed
  const selected = records[input.pick % records.length]!.number
  // Three times in four the control is enabled: not busy and no request waiting to be retried.
  const calm = (pane: IssuesUi): IssuesUi => { if (k.index % 4 === 0) return pane; const { retry: _, ...rest } = pane; return { ...rest, busy: false } }
  switch (k.target) {
    case "kind": return { ...ui, screen: "list", status: "ready", dialog: "" }
    case "row": return { ...ui, screen: "list", status: "ready", dialog: "", query: "" }
    case "comment": return calm({ ...uiOf({ ...input, pick: input.pick % records.length }, records), screen: "detail", selected, dialog: "", comment: k.comment })
    case "title": return calm({ ...ui, screen: k.vip ? "vip" : "new", step: 1, dialog: "" })
    case "assignee": return calm({ ...uiOf({ ...input, pick: input.pick % records.length }, records), screen: "detail", selected, dialog: "commit" })
  }
}

/** The control the key goes to, and the click that must do what a handled key does. */
function keyPlan(ui: IssuesUi, k: KeysInput["keyed"], html: Html) {
  const key = keyOf(k)
  const kinds = ["All", "Issues", "Tasks", "VIPs"] as const
  const mods = { metaKey: k.meta, ctrlKey: k.control }
  switch (k.target) {
    case "kind": {
      const index = k.index % 4
      const next = kinds[(index + (key === "ArrowRight" ? 1 : 3)) % 4]!
      const handled = key === "ArrowRight" || key === "ArrowLeft"
      return { target: `#ix-kind-${kinds[index]}`, handled, click: handled ? `#ix-kind-${next}` : undefined, focus: handled ? `ix-kind-${next}` : undefined }
    }
    case "row": {
      const rows = findAll(html, "li.sui-issues-row").map(row => findAll(row, "a").map(link => Option.getOrElse(attr(link, "id"), () => "")).find(id => id.startsWith("ix-issue-")) ?? "")
      if (rows.length === 0) return undefined
      const index = k.index % rows.length
      const handled = key === "j" || key === "k"
      return { target: nth(all.selector("li.sui-issues-row"), index), handled, click: undefined, focus: handled ? rows[Math.max(0, Math.min(rows.length - 1, index + (key === "j" ? 1 : -1)))] : undefined }
    }
    case "comment": {
      const box = find(html, "textarea[aria-label=\"Comment\"]")
      if (Option.isNone(box) || disabled(box.value)) return undefined
      const handled = key === "Enter" && (k.meta || k.control)
      return { target: "textarea[aria-label=\"Comment\"]", handled, click: handled ? ".sui-item-conv-composer-actions button" : undefined, focus: undefined, mods }
    }
    case "title": {
      const input = find(html, "#ix-title")
      if (Option.isNone(input) || disabled(input.value)) return undefined
      const handled = key === "Enter" && ui.screen === "vip"
      return { target: "#ix-title", handled, click: handled ? ".sui-issue-form-actions button.sui-button-solid" : undefined, focus: undefined }
    }
    case "assignee": {
      if (Option.isNone(find(html, "[aria-label=\"Assignee\"]"))) return undefined
      const handled = key === "Enter"
      return { target: "[aria-label=\"Assignee\"]", handled, click: handled ? ".sui-dialog-footer button.sui-button-solid" : undefined, focus: undefined }
    }
  }
}

/**
 * One key on one of the pane's keyboard handlers, every Command it causes answered by the generated backend. A handled
 * key does exactly what its control's click does: the settled views are equal (kind arrows and the clicked kind; Enter
 * with ⌘ or Ctrl in the comment box and Comment; Enter in a VIP's title and Continue; Enter on the assignees and the
 * dialog's Commit). While that button is disabled, Enter sends no request. Arrows and j or k move focus to the
 * neighbouring kind or row and change nothing else. Any other key falls through and changes nothing.
 */
it.live("screens/issues-keys", () => scoped(effect {
  const records = try mockItems()
  try run("screens/issues-keys", KeysInput, (input) => effect {
    const ui = keyedUi(input, records)
    const base = init(input.flags).model
    const model: Model = { ...base, surface: "chat", issues: ui, account: { ...accountOf(base), identity: { ...accountOf(base).identity, role: input.role } } }
    const before = try settledOn(input, model, [])
    const plan = keyPlan(ui, input.keyed, before.html)
    if (plan === undefined) return true
    const after = try settledOn(input, model, pressSteps(plan, keyOf(input.keyed)))
    const focused = after.first.filter(command => command.name === "FocusIssueControl").map(command => command.args?.["id"])
    if (plan.focus !== undefined && (focused.length !== 1 || focused[0] !== plan.focus)) return false
    if (plan.focus === undefined && focused.length !== 0) return false
    if (!plan.handled || plan.focus?.startsWith("ix-issue-") === true) return shape(after.html) === shape(before.html)
    if (plan.click === undefined) return true
    const button = findOne(before.html, plan.click)
    if (Option.isNone(button)) return false
    if (disabled(button.value)) return !after.ran.some(command => command.name === "ActOnIssue")
    const clicked = try settledOn(input, model, [clickStep(plan.click)])
    return shape(after.html) === shape(clicked.html)
  })
}))

/** The value an input or text area holds as rendered. */
function valueOf(node: Html): unknown {
  const data = (node as { data?: { attrs?: Record<string, unknown>; props?: Record<string, unknown> } }).data
  return data?.props?.["value"] ?? data?.attrs?.["value"]
}

type Chosen = {
  readonly name: string
  readonly input: Partial<Input>
  /** A change to the selected record after it is built. */
  readonly record?: (item: Item) => Item
  /** A control to type into, by role and name. */
  readonly type?: readonly [string, string]
  readonly holds: (html: Html, ui: IssuesUi) => boolean
}

const DETAIL = 12
const NEW = 26
const VIP = 27
const SPECIFICATION = 23
const note = { author: "ada" as const, text: "added the language label" as const, event: true, age: "" as const }

/**
 * The pane's arms that only a particular record or screen reaches, each run in every execution: Commit for an open
 * issue and Uncommit for a task; a VIP's approval named without a time; an event note without an age; the VIP form's prior
 * art step while busy, while a write waits for a retry, and idle; an accepted specification with its suites; and each
 * field's typed text becoming its value (search, comment, title, prior art, specification text).
 */
const CHOSEN: ReadonlyArray<Chosen> = [
  { name: "commit", input: { screen: DETAIL, role: "maintainer", connected: true, vip: "", task: "", recordState: "open" }, type: ["textbox", "Comment"], holds: (html) => count(html, "button", "Commit") === 1 && count(html, "button", "Uncommit") === 0 },
  { name: "uncommit", input: { screen: DETAIL, role: "maintainer", connected: true, vip: "", task: "Queued", recordState: "closed" }, holds: (html) => count(html, "button", "Uncommit") === 1 && count(html, "button", "Commit") === 0 },
  {
    name: "approved-undated", input: { screen: DETAIL, role: "viewer", approved: true, vip: "Accepted" },
    record: (item) => { const { approvedAt: _, ...rest } = item; return rest },
    holds: (html) => findAll(html, "time").some((node) => textContent(node) === ""),
  },
  { name: "event-undated", input: { screen: DETAIL, role: "viewer", notes: [note] }, holds: (html) => findAll(html, ".sui-item-conv-event-text").map(textContent).join("|") === "ada added the language label" || (shownText = findAll(html, ".sui-item-conv-event-text").map(textContent).join("|")) === null },
  { name: "prior-busy", input: { screen: VIP, step: 3, busy: true, role: "maintainer" }, holds: (html) => getAllByRole("textbox", { name: "Prior art" })(html).length === 1 && disabledNode(getAllByRole("textbox", { name: "Prior art" })(html)[0]!) },
  { name: "prior-retry", input: { screen: VIP, step: 3, busy: false, retry: "propose", role: "maintainer" }, holds: (html) => getAllByRole("textbox", { name: "Prior art" })(html).some(disabledNode) },
  { name: "prior-idle", input: { screen: VIP, step: 3, busy: false, role: "maintainer" }, type: ["textbox", "Prior art"], holds: (html) => getAllByRole("textbox", { name: "Prior art" })(html).length === 1 },
  { name: "title", input: { screen: NEW, step: 1, busy: false, role: "maintainer" }, type: ["textbox", "Title"], holds: (html) => getAllByRole("textbox", { name: "Title" })(html).length === 1 },
  { name: "search", input: { screen: 0, role: "viewer" }, type: ["searchbox", "Search issues"], holds: () => true },
  {
    name: "accepted", input: { screen: SPECIFICATION, role: "maintainer", specification: fixtureSpecification, accepted: true }, type: ["textbox", "Specification text"],
    holds: (html) => findAll(html, ".sui-card-title").some((node) => textContent(node) === "Self-consistency") && getAllByRole("status", { name: "Specification gate" })(html).some((node) => textContent(node) === "Accepted") && findAll(html, "a.sui-badge-outline").length > 0,
  },
]

function disabledNode(node: Html): boolean {
  const data = (node as { data?: { attrs?: Record<string, unknown>; props?: Record<string, unknown> } }).data
  return data?.attrs?.["disabled"] === true || data?.attrs?.["disabled"] === "" || data?.props?.["disabled"] === true
}

/** What a failing case rendered, for its report. */
let shownText = ""

const FLAGS: typeof Flags.Type = { session: "00000000-0000-4000-8000-000000000000", mode: "mock", name: "fuzz" }

const ChosenInput = Schema.Struct({ ...Input.fields, typed: Text })

it.live("screens/issues-chosen", () => scoped(effect {
  const records = try mockItems()
  // A parent and its children, and a record with no labels, for the chat's issue cards.
  const parent = records.find((item) => records.some((child) => child.parent === item.number))
  if (parent === undefined) throw new Finding({ report: "the mock has no issue with children" })
  const children = records.filter((child) => child.parent === parent.number)
  try run("screens/issues-chosen", ChosenInput, (drawn) => effect {
    for (const chosen of CHOSEN) {
      // Fixed flags: a drawn tour would add theatre Commands the scene does not resolve.
      // Idle, with no write waiting for a retry, unless the case says otherwise.
      const { retry: _, typed: _typed, ...rest } = drawn
      const input: Input = { ...rest, flags: FLAGS, dialog: 0, status: 0, error: "", pick: 0, busy: false, ...chosen.input }
      const built = uiOf(input, records)
      const ui: IssuesUi = chosen.record === undefined ? built : { ...built, data: { ...built.data, items: built.data.items.map((item) => item.number === built.selected ? chosen.record!(item) : item) } }
      const base = init(input.flags).model
      const model: Model = { ...base, surface: "chat", issues: ui, account: { ...accountOf(base), identity: { ...accountOf(base).identity, role: input.role } } }
      const typed = `t${drawn.typed}`
      const why: Array<string> = []
      const check = (simulation: SceneSimulation<Model, Message>) => {
        const html = simulation.html
        for (const role of ROLES) if (getAllByRole(role)(html).length !== getAllByRole(role, { name: /\S/ })(html).length) why.push(`unnamed ${role}`)
        if (!chosen.holds(html, ui)) why.push("oracle")
        if (chosen.type !== undefined && !getAllByRole(chosen.type[0], { name: chosen.type[1] })(html).some((node) => valueOf(node) === typed.toWellFormed())) why.push(`typed value ${JSON.stringify(getAllByRole(chosen.type[0], { name: chosen.type[1] })(html).map(valueOf))}`)
        return simulation
      }
      try Effect.try(() => chosen.type === undefined ? scene({ update, view }, given(model), check) : scene({ update, view }, given(model), typeInto(locate(chosen.type[0], { name: chosen.type[1] }), typed), check))
      if (why.length > 0) throw new Finding({ report: `${chosen.name} does not hold: ${why.join(", ")} ${shownText}` })
    }
    // The chat's issue card: a parent lists its children; a record without labels names only its number and age.
    for (const [issue, expected] of [[parent, children.length], [{ ...children[0]!, labels: [] }, 0]] as const) {
      const base = init(FLAGS).model
      const items = records.map((item) => item.number === issue.number ? issue : item)
      const entry = { id: "e-1", seq: 1, clientId: "", inReplyTo: "", author: "agent" as const, name: "VibeLang agent", text: `See [this](#issue-${issue.number})`, done: true, error: "" }
      const model: Model = { ...base, surface: "chat", issues: { ...initialIssues, open: false, data: { seq: 1, items } }, client: { ...base.client, conversation: { ...base.client.conversation, entries: [entry] } } }
      let holds = true
      try Effect.try(() => scene({ update, view }, given(model), (simulation: SceneSimulation<Model, Message>) => {
        const cards = findAll(simulation.html, ".ix-chat-card")
        if (cards.length !== 1) { holds = false; return simulation }
        if (findAll(cards[0]!, ".ix-mini").length !== expected) holds = false
        if (expected === 0 && findAll(cards[0]!, ".sui-card-description").some((node) => textContent(node).split(" · ").length !== 2)) holds = false
        return simulation
      }))
      if (!holds) throw new Finding({ report: `the chat card for #${issue.number} does not hold` })
    }
    return true
  })
}))

/**
 * Arms of the issues view that runs 20261286 and 20261287 reached in one seed or neither (0015, twentieth session): an
 * issue with a parent names it in its tree and one without does not; the specification's failure offers Retry exactly
 * when a request is saved; the kind control ignores a key that is not an arrow.
 */
it.live("screens/issue-arms", () => scoped(effect {
  const records = try mockItems()
  const child = records.find(item => item.parent !== 0 && item.vip === "")
  const parent = records.find(item => item.parent === 0 && item.vip === "" && records.some(other => other.parent === item.number))
  if (child === undefined || parent === undefined) throw new Finding({ report: "the mock records have no parent and child" })
  try run("screens/issue-arms", Schema.Struct({ error: Text }), ({ error }) => effect {
    const base = init({ session: "00000000-0000-4000-8000-000000000000", mode: "mock", name: "fuzz" }).model
    const as = (ui: Partial<IssuesUi>): Model => ({ ...base, surface: "chat", issues: { ...initialIssues, open: true, status: "ready", role: "maintainer", data: { seq: 1, items: records }, ...ui }, account: { ...accountOf(base), identity: { ...accountOf(base).identity, role: "maintainer" } } })
    const failure = `e${error}`
    const saved = { op: "spec-revise" as const, number: 0, parent: 0, title: "", text: "S", assignee: "", example: "", prior: "", key: "k-1", revision: 0 }
    const cases: ReadonlyArray<readonly [string, Model, (html: Html) => boolean]> = [
      ["a child names its parent", as({ screen: "detail", selected: child.number }), html => findAll(html, ".ix-tree-parent").length === 1],
      ["a parent names none", as({ screen: "detail", selected: parent.number }), html => findAll(html, ".ix-tree-parent").length === 0 && findAll(html, ".ix-tree-row").length > 0],
      ["a failed revision without a saved request", as({ screen: "specification", error: failure }), html => count(html, "alert", /./) === 1 && count(html, "button", "Retry") === 0],
      ["a failed revision with one", as({ screen: "specification", error: failure, retry: saved }), html => count(html, "alert", /./) === 1 && count(html, "button", "Retry") === 1],
    ]
    for (const [name, model, holds] of cases) {
      let shown = false
      try Effect.try(() => scene({ update, view }, given(model), (simulation: SceneSimulation<Model, Message>) => { shown = holds(simulation.html); return simulation }))
      if (!shown) throw new Finding({ report: name })
    }
    try Effect.try(() => scene({ update, view }, given(as({ screen: "list" })), ...pressSteps({ target: "#ix-kind-All", handled: false }, "x")))
    return true
  })
}))
