      fake.hideVip = true
      try stepped(via("a proposal GitHub never showed as a VIP", "unavailable", { ...complete }), 150)
      fake.hideVip = false
      // The delegation ends at smithers.sh: the person's read falls back to public issues, and a write asks to connect.
      try site.end()
      const lostBefore = try Ref.get(lost)
      const read = try via("a read after the delegation ended", "ok", { op: "read" })
      if (read._tag !== "Success" || !read.success.items.some((item) => item.number === 1) || (try Ref.get(lost)) === lostBefore) throw new Finding({ report: "an ended delegation hid public issues or was not reported lost" })
      try via("a write after the delegation ended", "connect", { op: "new" })
      break
    }
    case "public": {
      // A visitor reads through the site's cached public client. While GitHub is down, the last good copy answers,
      // marked with when GitHub confirmed it.
      const cache = try GitHub.ReadCache.make({ store: try GitHub.ReadCache.memoryStore(), upstream: fakeClient(fake), freshFor: 0 })
      const visitor: IssueAuthority.Shape = { current: () => succeed(undefined) }
      const readAs = (key: string) => Effect.result(executeIssues("issues-visitor", storage, { ...base, key }, repo).pipe(
        Effect.provideService(IssueAuthority, visitor), Effect.provideService(PublicReads, { client: cache }),
        Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
        Effect.mapError((error) => error._tag === "IssueFailure" ? error : new IssueFailure({ reason: error._tag })),
      ))
      const first = try readAs(`fresh-${pick}`)
      // publicIssues serves the product's own repository, so its first read fills the cache for that address.
      const servedFresh = try serveGet(publicIssues("issues-public", storage, cache), "GET", undefined)
      if (servedFresh.status !== 200) throw new Finding({ report: `a served visitor's read answered ${servedFresh.status}` })
      if (first._tag !== "Success" || first.success.stale !== undefined || first.success.items.length === 0) throw new Finding({ report: `a visitor's read answered ${reasonOf(first)}` })
      fake.outage = 503
      const kept = try readAs(`kept-${pick}`)
      const servedKept = try serveGet(publicIssues("issues-public", storage, cache), "GET", undefined)
      fake.outage = 200
      if (kept._tag !== "Success" || kept.success.stale === undefined || kept.success.items.length !== first.success.items.length) throw new Finding({ report: `a visitor's read while GitHub was down answered ${reasonOf(kept)}` })
      if (servedKept.status !== 200 || (try Effect.try(() => JSON.parse(servedKept.text) as { stale?: number })).stale === undefined) throw new Finding({ report: `a served read while GitHub was down answered ${servedKept.status}` })
      // Without the site's client the public tracker still serves; a request whose key is not a key is invalid.
      const quiet: IssueHost.Shape = { perform: () => succeed({ seq: 1, items: [] }) }
      const direct = publicIssues("issues-public-direct", storage).pipe(Effect.provideService(IssueHost, quiet))
      const plain = try serveGet(direct, "GET", undefined)
      if (plain.status !== 200) throw new Finding({ report: `a public read without the site's client answered ${plain.status}` })
      const malformed = try serveGet(direct, "POST", JSON.stringify({ ...base, key: "not a key" }))
      if (malformed.status !== 400 || (try Effect.try(() => JSON.parse(malformed.text) as { reason?: string })).reason !== "invalid") throw new Finding({ report: `a request with a malformed key answered ${malformed.status}` })
      // GitHub never answers a read: the read flow's engine deadline settles it, in virtual time, as unavailable.
      const silent: IssueHost.Shape = { perform: () => Effect.never }
      const late = try stepped(execute({ op: "read" }, [maintainer], false, silent), 30)
      if (reasonOf(late) !== "unavailable") throw new Finding({ report: `a read past its deadline answered ${reasonOf(late)}` })
      // An issue whose comments never end is read as partial, never as a short thread.
      fake.endlessComments = true
      try expect("a read of an issue whose comments never end", "partial", { op: "read", number: 1 })
      fake.endlessComments = false
      break
    }
    case "draft": {
      const drafted = try execute({ op: "draft", title: "A proposal", text: "Why", example: "e", prior: "p" }, [maintainer], true)
      if (drafted._tag !== "Success" || drafted.success.draft?.title !== "A proposal") throw new Finding({ report: `a draft answered ${reasonOf(drafted)}` })
      break
    }
  }
  // Only the delegated scenario's person has a delegate; every other scenario writes nothing to GitHub.
  if (scenario !== "delegated" && fake.writes !== writesBefore) throw new Finding({ report: "a maintainer with no delegate wrote to GitHub" })
  return true
})

// Every execution runs every scenario on fresh storage, so one execution reaches them all whatever the host load.
// That makes one execution long: with coverage on an idle 4-vCPU box, replaying the saved value and one fresh
// execution took the whole 15 s REPLAY_FLOOR (1 execution, then 0 on the next run), so it takes the 60 s floor.
it.live("issues/steered-host", () => run("issues/steered-host", SteeredIssues, ({ pick, title }) => effect {
  for (const scenario of ISSUE_SCENARIOS) try steeredIssuesScenario(scenario, pick, title)
  return true
}, undefined, { minimum: "60 seconds" }), 300000)
