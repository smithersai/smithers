import { it } from "@effect/vitest"
import { HttpClient, HttpClientRequest, HttpServerRequest, HttpServerResponse } from "effect/http"
import { WebCrypto } from "@smthrs/crypto"
import { TestNodeRuntime } from "@smthrs/platform-node"
import { GitHub } from "@smthrs/integrations"
import { issuePermission } from "../src/core/conversation.vibe"
import { IssueFailure, IssueRequest, IssuesState } from "../src/core/issueSchemas.vibe"
import { IssueHost } from "../src/core/issueFlows.vibe"
import { executeIssues, githubHost, issueFailureOf, publicIssues, serveIssues, verifiedVip, IssueAuthority, type Principal, type Repository } from "../worker/Issues.vibe"
import { GitHubDelegate } from "../worker/GitHubDelegate.vibe"
import { PublicReads } from "../worker/PublicReads.vibe"
import { agentLayer, DraftAgent, writer } from "../worker/VipDraft.vibe"
import { ChatModel, Spend } from "../worker/Reply.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { fakeClient, forked, repo, seed, type Fake } from "./issues-node-fake.vibe"
import { delegated, reach, reached } from "./delegated.vibe"
import { run, stepped, Finding, Int } from "./run.vibe"
import { faultyStore } from "./faulty-store.ts"

// The durable payload contract (DurableText) refuses lone surrogates; direct flow calls hold it.
const Clean = Schema.String.check(Schema.isMaxLength(120), Schema.isPattern(/^[^\uD800-\uDFFF]*$/))
const Words = Schema.Union([Schema.Literals(["", "word", "A longer body"]), Clean])
const Role = Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"])
const Op = Schema.Struct({
  op: Schema.Literals(["read", "new", "comment", "link", "split", "commit", "uncommit", "propose", "accept", "decline", "draft"]),
  role: Role,
  signedOut: Schema.Boolean,
  noToken: Schema.Boolean,
  number: Schema.Literals([0, 1, 2, 3, 4, 100, 9999]),
  parent: Schema.Literals([0, 1, 2, 3, 4, 9999]),
  title: Words,
  text: Words,
  example: Words,
  prior: Words,
  assignee: Schema.Literals(["", "fuzz", "vibe-agent", "VibeLang agent", "ghost"]),
  key: Int,
  salt: Int,
})
const Input = Schema.Array(Op).check(Schema.isMaxLength(10))

const reasons = ["forbidden", "sign-in", "connect", "fork", "install", "missing", "invalid", "title", "incomplete", "empty", "tree", "assignee", "closed", "review", "unsupported", "unavailable", "partial", "rate-limited", "unknown", "protocol", "no-model", "budget", "draft"]

const writerLayer = (drafts: boolean, budget: boolean) => {
  const agent: DraftAgent.Shape = { available: drafts, run: (request) => succeed({ title: request.title, summary: request.text, example: request.example, prior: request.prior }) }
  const spending: Spend.Shape = { admit: () => succeed(budget), spend: () => Effect.void }
  return writer.pipe(Layer.provide(Layer.succeed(DraftAgent, agent)), Layer.provide(Layer.succeed(Spend, spending)))
}
const noModelWriter = writer.pipe(
  Layer.provide(agentLayer),
  Layer.provide(Layer.succeed(Spend, { admit: () => succeed(true), spend: () => Effect.void })),
  Layer.provide(Layer.succeed(ChatModel, { model: undefined, unusable: "unset" })),
)

/** The durable issues flow over a stateful in-memory GitHub: typed outcomes, idempotent replays, no write without authority. */
const operations = reach()
const hostOperations = (ops: typeof Input.Type) => effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const storage = raw as unknown as Storage
  const fake = seed()
  forked(fake)
  const site = try delegated(fakeClient(fake), operations)
  const principal = try Ref.make<Principal | undefined>(undefined)
  const forbidNext = try Ref.make(false)
  const authority: IssueAuthority.Shape = {
    current: () => Ref.get(principal),
    authorize: () => Effect.flatMap(Ref.get(forbidNext), (forbid) => forbid ? Effect.fail(new IssueFailure({ reason: "forbidden" })) : Effect.void),
  }
  const client = site.http
  const seen = new Map<string, { tag: "Success" | "Failure"; payload: string }>()
  const writes = new Map<string, IssueRequest>()
  const failedWrites = new Map<string, IssueRequest>()
  const recovered = new Set<string>()
  for (const op of ops) {
    fake.forbiddenNext = op.salt % 8 === 7 && op.op !== "read" && op.op !== "draft"
    fake.endlessIssues = op.salt % 32 === 15
    fake.endlessTimeline = op.salt % 32 === 31
    fake.endlessReviews = op.salt % 32 === 7 && op.op === "read" && op.number === 4
    fake.malformedIssues = op.salt % 32 === 9
    try Ref.set(forbidNext, op.salt % 16 === 5)
    const actor: Principal | undefined = op.signedOut ? undefined : { id: "7", login: "fuzz", role: op.role, ...(op.noToken ? {} : { connection: site.connection }) }
    try Ref.set(principal, actor)
    const badKey = op.salt % 32 === 17
    const prior = writes.get(`${op.key % 4}`)
    const failedPrior = failedWrites.get(`${op.key % 4}`)
    const recovery = !badKey && failedPrior !== undefined && op.salt % 16 === 11 && !recovered.has(`${failedPrior.op}/${failedPrior.key}`)
    if (recovery) recovered.add(`${failedPrior.op}/${failedPrior.key}`)
    const resume = prior !== undefined && op.salt % 8 === 3
    const base: IssueRequest = { op: op.op, number: op.number, parent: op.parent, title: op.title, text: op.text, example: op.example, prior: op.prior, assignee: op.assignee, key: `k${op.key}` }
    const request: IssueRequest = recovery
      ? { ...failedPrior!, recovery: op.salt % 64 === 43 ? "bad!" : "r1" }
      : resume
      ? {
        ...base,
        op: "read",
        number: 0,
        resumeOp: prior!.op,
        resumeKey: op.salt % 32 === 19 ? "bad key!" : prior!.key,
        ...(recovered.size > 0 && op.salt % 32 === 3 ? { resumeRecovery: "r1" } : {}),
      }
      : { ...base, ...(badKey ? { key: "bad key!" } : {}) }
    const issuesBefore = fake.issues.length
    const writesBefore = fake.writes
    const program = executeIssues("issues-fuzz", storage, request, repo).pipe(
      Effect.provideService(IssueAuthority, authority),
      Effect.provideService(HttpClient.HttpClient, client),
      Effect.provideService(GitHubDelegate, site.delegate),
    )
    const result = try Effect.result(op.salt % 8 === 3 ? program : Effect.provide(program, op.salt % 8 === 1 ? noModelWriter : writerLayer(op.salt % 4 !== 2, op.salt % 4 !== 1)))
    const permitted = issuePermission(op.signedOut ? "viewer" : op.role, request.op)
    const identity = `${actor?.id ?? "out"}/${request.op}/${request.key}`
    const payloadJson = JSON.stringify({ ...request, recovery: undefined })
    const seenBefore = recovery ? undefined : seen.get(identity)
    if (result._tag === "Failure") {
      const failure = result.failure
      if (failure._tag !== "IssueFailure" || !reasons.includes(failure.reason)) return false
      if (!permitted && !["forbidden", "sign-in", "invalid"].includes(failure.reason)) return false
      if (["forbidden", "sign-in", "connect", "invalid", "title", "incomplete", "empty", "missing"].includes(failure.reason) && fake.writes !== writesBefore) return false
      if (!recovery && !badKey && !["read", "draft"].includes(request.op)) failedWrites.set(`${op.key % 4}`, request)
    } else {
      if (!permitted) return false
      if (!Schema.is(IssuesState)(result.success)) return false
      // GitHub lists a pull request among the issues; a proposal opens its review pull request and then its issue.
      const opened = fake.issues.slice(issuesBefore).filter((issue) => !issue.node_id.startsWith("pull-")).length
      if (["new", "split", "propose"].includes(request.op) && (recovery ? opened > 1 : opened !== 1)) return false
      if (request.op === "propose" && seenBefore === undefined && fake.issues.length - issuesBefore !== 2) return false
      if (request.op === "new" && seenBefore === undefined && !result.success.items.some((item) => item.title === request.title.trim())) return false
      if (request.op === "propose" && seenBefore === undefined && !result.success.items.some((item) => item.vip !== "")) return false
      if (!recovery && !badKey && !["read", "draft"].includes(request.op)) writes.set(`${op.key % 4}`, request)
    }
    if (seenBefore !== undefined && seenBefore.payload === payloadJson && seenBefore.tag !== result._tag) return false
    if (seenBefore !== undefined && seenBefore.payload === payloadJson && fake.writes !== writesBefore) return false
    if (!recovery) seen.set(identity, { tag: result._tag, payload: payloadJson })
  }
  return true
}
it.live("issues/github-host-operations", () => Effect.andThen(run("issues/github-host-operations", Input, hostOperations), reached("issues/github-host-operations", operations, hostOperations, [{ op: "comment", role: "maintainer", signedOut: false, noToken: false, number: 1, parent: 0, title: "word", text: "word", example: "", prior: "", assignee: "", key: 1, salt: 0 }])))


const Direct = Schema.Struct({
  // The specification operations reach githubHost only from a direct caller: executeIssues answers them itself.
  op: Schema.Literals(["read", "new", "comment", "link", "split", "commit", "uncommit", "accept", "decline", "draft", "spec-revise", "spec-review"]),
  role: Role,
  signedOut: Schema.Boolean,
  noToken: Schema.Boolean,
  number: Schema.Literals([0, 1, 2, 3, 4, 9999]),
  parent: Schema.Literals([0, 1, 2, 3, 4, 9999]),
  blank: Schema.Boolean,
  blankKey: Schema.Boolean,
  bogus: Schema.Boolean,
  demote: Schema.Boolean,
  assignee: Schema.Literals(["", "fuzz", "vibe-agent", "VibeLang agent", "ghost"]),
  withWriter: Schema.Boolean,
  authorizeFails: Schema.Boolean,
  // A device sign-in (decision 0028); optional, so the saved values from before it still decode.
  agent: Schema.optionalKey(Schema.Boolean),
})

/** The host itself, without the engine: every refusal is typed before any write, and unjournaled writes complete. */
const boundary = reach()
const performBoundary = (input: typeof Direct.Type) => effect {
  const fake = seed()
  const site = try delegated(fakeClient(fake), boundary)
  fake.endlessComments = input.number === 1 && input.op === "read" && input.blank
  fake.dropAssignees = input.blankKey
  fake.noMain = input.bogus
  const authorizeFails = try Ref.make(input.authorizeFails)
  const calls = try Ref.make(0)
  const authority: IssueAuthority.Shape = {
    current: () => Effect.flatMap(Ref.updateAndGet(calls, (n) => n + 1), (n) =>
      Ref.get(authorizeFails).pipe(Effect.as(
        input.signedOut ? undefined : { id: "7", login: "fuzz", role: (input.demote && n > 1 ? "viewer" : input.role) as typeof Role.Type, ...(input.noToken ? {} : { connection: site.connection }), ...(input.agent === true ? { kind: "agent" as const } : {}) },
      ))),
    authorize: () => Effect.flatMap(Ref.get(authorizeFails), (forbid) => forbid ? Effect.fail(new IssueFailure({ reason: "forbidden" })) : Effect.void),
  }
  const host = try githubHost(repo).pipe(
    Effect.provideService(IssueAuthority, authority),
    Effect.provideService(HttpClient.HttpClient, site.http),
    Effect.provideService(GitHubDelegate, site.delegate),
  )
  const journaled = ["new", "comment", "split", "propose"].includes(input.op)
  // A signed-out caller acts with the viewer role (worker/Issues.vibe: `actor?.role ?? "viewer"`).
  // A device sign-in never accepts or declines a VIP, whatever its role.
  const agentReview = input.agent === true && !input.signedOut && !input.bogus && (input.op === "accept" || input.op === "decline")
  const permitted = !input.bogus && issuePermission(input.signedOut ? "viewer" : input.role, input.op) && !input.authorizeFails && !(input.demote && !issuePermission("viewer", input.op)) && !agentReview
  const proceeds = permitted && !input.noToken && !input.blankKey
  // Journaled creations need the durable engine; here they only run up to their first typed refusal.
  if ((journaled && proceeds && !(input.blank && ["new", "split", "propose"].includes(input.op)) && !(input.number === 9999 && ["split", "comment"].includes(input.op))) || (input.op === "draft" && input.withWriter && proceeds)) return true
  const request: IssueRequest = {
    op: (input.bogus ? "bogus" : input.op) as IssueRequest["op"], number: input.number, parent: input.parent, title: input.blank ? "  " : "T", text: input.blank ? "" : "body",
    example: input.blank ? "" : "e", prior: input.blank ? " " : "p", assignee: input.assignee, key: input.blankKey ? "" : "direct-1",
  }
  // The journaled creation paths are excluded above, so the engine services perform declares are never read.
  const call = host.perform as (request: IssueRequest) => typeof IssuesState.Type!IssueFailure
  const performed = call(request).pipe(
    Effect.provideService(IssueAuthority, authority),
    Effect.provideService(HttpClient.HttpClient, site.http),
  )
  // The Worker's host provides these at worker/Objects.vibe; a role demoted mid-call reaches the write key first.
  const hosted = Effect.provide(performed, WebCrypto.layer)
  const writesBefore = fake.writes
  const result = try Effect.result(input.withWriter ? Effect.provide(hosted, writerLayer(true, true)) : hosted)
  if (input.op === "spec-revise" || input.op === "spec-review") {
    // GitHub holds no specification: the host refuses it, after its read, before any write.
    if (result._tag === "Success" || fake.writes !== writesBefore) throw new Finding({ report: `githubHost answered ${input.op}` })
    if (proceeds && [1, 2, 3, 4].includes(input.number) && result.failure.reason !== "unsupported") throw new Finding({ report: `${input.op} on an issue answered ${result.failure.reason}` })
  }
  if (agentReview && (result._tag === "Success" || result.failure.reason !== "forbidden" || fake.writes !== writesBefore)) throw new Finding({ report: `an agent's ${input.op} was not refused` })
  if (result._tag === "Failure") {
    if (result.failure._tag !== "IssueFailure" || !reasons.includes(result.failure.reason)) return false
    if (result.failure.reason === "forbidden" && permitted) return false
    return true
  }
  if (!permitted) return false
  if (input.op === "read") return Schema.is(IssuesState)(result.success)
  // Issue 4 is a VIP in review: a decision labels it, and a decline also closes it.
  const reviewed = fake.issues.find((issue) => issue.number === 4)!
  if (input.op === "decline" && input.number === 4 && (!reviewed.labels.some((label) => label.name === "vibelang:declined") || reviewed.state !== "closed")) throw new Finding({ report: "a declined VIP was not labeled and closed" })
  return ["link", "commit", "uncommit", "accept", "decline"].includes(input.op)
}
const directWitness: typeof Direct.Type = { op: "commit", role: "maintainer", signedOut: false, noToken: false, number: 1, parent: 0, blank: false, blankKey: false, bogus: false, demote: false, assignee: "fuzz", withWriter: false, authorizeFails: false }
/** A maintainer declines the VIP in review; a device signed in as a maintainer tries to accept and decline it. */
const directChosen: ReadonlyArray<typeof Direct.Type> = [
  { ...directWitness, op: "decline", number: 4 },
  { ...directWitness, op: "accept", number: 4, agent: true },
  { ...directWitness, op: "decline", number: 4, agent: true },
]
/** Random inputs rarely permit a specification operation on an existing issue; each runs once per execution. */
const specificationWitnesses = Effect.forEach(["spec-revise", "spec-review"] as const, (op) => effect {
  if (!(try scoped(performBoundary({ ...directWitness, op })))) throw new Finding({ report: `issues/host-perform-boundary: the ${op} witness failed` })
})
it.live("issues/host-perform-boundary", () => run("issues/host-perform-boundary", Direct, performBoundary, undefined, { chosen: directChosen }).pipe(
  Effect.andThen(reached("issues/host-perform-boundary", boundary, performBoundary, directWitness)),
  Effect.andThen(specificationWitnesses),
))

const BODIES = ["empty", "garbage", "valid", "bad-key", "oversized", "recovery"] as const
const HttpOp = Schema.Struct({
  method: Schema.Literals(["GET", "POST", "PUT", "DELETE"]),
  path: Schema.Literals(["/api/issues", "/api/issues/more", "/other"]),
  body: Schema.Literals(BODIES),
  role: Role,
  signedOut: Schema.Boolean,
  key: Int,
})

/** The issues HTTP boundary answers every shape with a typed status; failures name their reason. */
const surface = reach()
/** Every body posted to the tracker, then the drawn request. */
const httpSurface = (input: typeof HttpOp.Type) => effect {
  for (const body of BODIES) if (!(try scoped(httpOne({ ...input, method: "POST", path: "/api/issues", body })))) return false
  return try httpOne(input)
}
const httpOne = (input: typeof HttpOp.Type) => effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const storage = raw as unknown as Storage
  const fake = seed()
  const site = try delegated(fakeClient(fake), surface)
  const authority: IssueAuthority.Shape = { current: () => succeed(input.signedOut ? undefined : { id: "7", login: "fuzz", role: input.role, connection: site.connection }) }
  const validBody = { op: "comment", number: 1, parent: 0, title: "T", text: "body", example: "", prior: "", assignee: "", key: `k${input.key}` }
  const body = input.body === "empty" ? undefined
    : input.body === "garbage" ? "{not json"
    : input.body === "bad-key" ? JSON.stringify({ ...validBody, key: "bad key!" })
    : input.body === "recovery" ? JSON.stringify({ ...validBody, recovery: "r1" })
    : JSON.stringify(validBody)
  let request = HttpClientRequest.make(input.method)(`https://fuzz.invalid${input.path}`)
  if (body !== undefined) request = HttpClientRequest.bodyText(request, body)
  if (input.body === "oversized") request = HttpClientRequest.setHeader(request, "content-length", "40000")
  const web = try HttpClientRequest.toWeb(request)
  if (input.body === "empty" && input.method === "GET" && input.path === "/other") {
    const publicResponse = try Effect.provideService(publicIssues("issues-public", storage), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
    if (publicResponse.status !== 404) return false
  }
  const counted = try Ref.make(0)
  const response = try Effect.provideService(serveIssues("issues-http", storage, repo, (person) => Ref.update(counted, (n) => n + 1).pipe(Effect.asVoid)).pipe(
    Effect.provideService(IssueAuthority, authority),
    Effect.provideService(HttpClient.HttpClient, site.http),
    Effect.provideService(GitHubDelegate, site.delegate),
    Effect.provide(writerLayer(true, true)),
  ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))

  const text = try promise(() => HttpServerResponse.toWeb(response).text())
  if (![200, 400, 401, 403, 404, 405, 409, 413, 503].includes(response.status)) return false
  // The tracker serves GET and POST only; any other method on its path is refused before its body is read.
  if (input.path !== "/other" && input.method !== "GET" && input.method !== "POST" && response.status !== 405) throw new Finding({ report: `${input.method} ${input.path} answered ${response.status}` })
  if (response.status === 200) {
    const parsed = try Effect.try(() => JSON.parse(text))
    return Schema.is(Schema.Unknown)(parsed) && typeof parsed === "object" && parsed !== null && "items" in parsed
  }
  if (response.status === 404 || response.status === 405) return text === ""
  const parsed = try Effect.try(() => JSON.parse(text))
  return typeof parsed.reason === "string"
}
/** Methods the tracker does not serve, which a draw reaches only when it picks them. */
const httpChosen: ReadonlyArray<typeof HttpOp.Type> = [
  { method: "PUT", path: "/api/issues", body: "valid", role: "maintainer", signedOut: false, key: 1 },
  { method: "DELETE", path: "/api/issues", body: "empty", role: "viewer", signedOut: true, key: 2 },
]
it.live("issues/http-surface", () => Effect.andThen(run("issues/http-surface", HttpOp, httpSurface, undefined, { chosen: httpChosen }), reached("issues/http-surface", surface, httpSurface, { method: "POST", path: "/api/issues", body: "valid", role: "maintainer", signedOut: false, key: 1 })))

const Evidence = Schema.Struct({
  body: Schema.Literals(["plain", "marked", "bad-path", "bad-review", "foreign-review", "two-markers", "bad-number"] as const),
  author: Schema.Literals([0, -1, 7, 8, 1.5] as const),
  pullMissing: Schema.Boolean,
  filesShifted: Schema.Boolean,
  errorKind: Schema.Literals(["none", "401", "403", "404", "429", "500", "unknown", "incomplete", "rate-limited", "no-details"] as const),
})

/** VIP evidence verifies only against native pull data; provider errors map to their documented reasons. */
it.live("issues/vip-evidence-and-failure-mapping", () => run("issues/vip-evidence-and-failure-mapping", Evidence, (input) => effect {
  const fake = seed()
  if (input.pullMissing) fake.pulls.length = 0
  if (input.filesShifted) fake.pulls.forEach((pull) => { pull.files = [{ filename: "docs/design/vips/other.md", status: "added" }]; pull.changed_files = 1 })
  const marker = (path: string, review: string) => `Proposal\n\n<!-- vibelang:vip path=${path} review=${review} -->`
  const body = input.body === "plain" ? "No marker here"
    : input.body === "marked" ? marker("docs/design/vips/proposal-seed.md", "https://github.com/o/r/pull/500")
    : input.body === "bad-path" ? marker("docs/design/other.md", "https://github.com/o/r/pull/500")
    : input.body === "bad-review" ? marker("docs/design/vips/proposal-seed.md", "https://github.com/o/r/issues/500")
    : input.body === "foreign-review" ? marker("docs/design/vips/proposal-seed.md", "https://github.com/evil/r/pull/500")
    : input.body === "bad-number" ? marker("docs/design/vips/proposal-seed.md", "https://github.com/o/r/pull/0")
    : `${marker("docs/design/vips/proposal-seed.md", "https://github.com/o/r/pull/500")} ${marker("docs/design/vips/proposal-seed.md", "https://github.com/o/r/pull/501")}`
  const observed = try GitHub.Calls.withToken(Redacted.make("t"), repo.api)(verifiedVip(repo, body, input.author)).pipe(Effect.provideService(HttpClient.HttpClient, fakeClient(fake)))
  if (observed !== undefined) {
    if (!observed.review.startsWith("https://github.com/o/r/pull/")) return false
    if (input.author !== 7 || input.pullMissing || input.filesShifted || (input.body !== "marked" && input.body !== "two-markers")) return false
    if (input.body === "two-markers" && observed.review !== "https://github.com/o/r/pull/501") return false
  } else if (input.body === "marked" && input.author === 7 && !input.pullMissing && !input.filesShifted) return false

  const details: Record<string, unknown> = input.errorKind === "no-details" ? {} : input.errorKind === "none" ? {} : input.errorKind === "unknown" ? { outcomeUnknown: true } : input.errorKind === "incomplete" ? { incomplete: true } : input.errorKind === "rate-limited" ? { rateLimited: true, retryAfterMillis: 5000 } : { status: Number(input.errorKind) }
  const failure = issueFailureOf({ details })
  const expected = input.errorKind === "unknown" ? "unknown" : input.errorKind === "incomplete" ? "partial" : input.errorKind === "rate-limited" ? "rate-limited" : input.errorKind === "401" ? "sign-in" : input.errorKind === "403" ? "forbidden" : input.errorKind === "404" ? "missing" : "unavailable"
  if (failure.reason !== expected) return false
  if (input.errorKind === "rate-limited" && failure.retryAfterMillis !== 5000) return false
  return ["unknown", "rate-limited", "unavailable"].includes(expected) ? failure.code === expected : true
}))

const ISSUE_SCENARIOS = ["validations", "reviews", "resume", "spec", "shapes", "served", "demoted", "refusals", "draft", "store", "running", "delegated", "public"] as const
const SteeredIssues = Schema.Struct({
  pick: Int,
  title: Schema.Literals(["T", "A title", "Fix the parser"]),
})
type Person = { readonly id: string; readonly login: string; readonly role: typeof Role.Type; readonly kind?: "person" | "agent"; readonly connection?: { readonly person: number; readonly delegation: string } }
const REFUSALS = ["connect", "install", "fork", "forbidden", "unavailable", "unknown", "key_conflict"] as const
const SERVED: Record<string, number> = { forbidden: 403, "sign-in": 401, connect: 401, missing: 404, unknown: 409, title: 400, fork: 400, install: 400, unavailable: 503, partial: 503 }

/**
 * Preludes that reach the issue host's validations, reads and journal in one execution instead of waiting for random
 * sequences. The maintainer is connected, but no delegate is provided (decision 0165): every validation runs on a
 * real read, and the first GitHub write answers `connect`.
 */
const steeredIssuesScenario = (scenario: typeof ISSUE_SCENARIOS[number], pick: number, title: typeof SteeredIssues.Type["title"]) => scoped(effect {
  const raw = try acquireRelease(Effect.try(() => TestNodeRuntime.sqliteObjectStorage()), (store) => Effect.sync(() => store.close()))
  const store = faultyStore(raw as unknown as Storage)
  const storage = store.storage
  const fake = seed()
  // Issue 1 is already issue 3's child, so linking it there again writes nothing.
  fake.issues.find((issue) => issue.number === 1)!.parent_issue_url = `${repo.api}/repos/o/r/issues/3`
  const maintainer: Person = { id: "7", login: "fuzz", role: "maintainer", connection: { person: 1, delegation: "fixture-delegation" } }
  const principal = try Ref.make<Array<Person | undefined>>([])
  const lost = try Ref.make(0)
  const authority: IssueAuthority.Shape = {
    // Each call takes the next scripted principal, then stays on the last one: a role can change mid-request.
    current: () => Ref.modify(principal, (queue) => queue.length > 1 ? [queue[0], queue.slice(1)] : [queue[0], queue]),
    lost: () => Ref.update(lost, (n) => n + 1),
  }
  const base: IssueRequest = { op: "read", number: 0, parent: 0, title, text: "body", example: "e", prior: "p", assignee: "", key: "" }
  let count = 0
  const execute = (patch: Partial<IssueRequest>, as: ReadonlyArray<Person | undefined> = [maintainer], drafts = false, host?: IssueHost.Shape) => effect {
    count += 1
    try Ref.set(principal, [...as])
    const issues = executeIssues("issues-steered", storage, { ...base, key: `s${pick}-${count}`, ...patch } as IssueRequest, repo)
    const program = (host === undefined ? issues : Effect.provideService(issues, IssueHost, host)).pipe(
      Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
      Effect.mapError((error) => error._tag === "IssueFailure" ? error : new IssueFailure({ reason: error._tag })),
    )
    return try Effect.result(drafts ? Effect.provide(program, writerLayer(true, true)) : program)
  }
  const reasonOf = (result: Result.Result<unknown, IssueFailure>) => result._tag === "Failure" ? result.failure.reason : "ok"
  /** One request to a served tracker: its status and body text. */
  const serveGet = effect (served: HttpServerResponse.HttpServerResponse!unknown!HttpServerRequest.HttpServerRequest, method: "GET" | "POST", body: string | undefined) => {
    const request = method === "GET" ? HttpClientRequest.get("https://fuzz.invalid/api/issues") : HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/issues"), body ?? "")
    const web = try HttpClientRequest.toWeb(request)
    const response = try Effect.provideService(served, HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
    return { status: response.status, text: try promise(() => HttpServerResponse.toWeb(response).text()) }
  }
  const expect = effect (label: string, wanted: string, patch: Partial<IssueRequest>, as: ReadonlyArray<Person | undefined> = [maintainer], host?: IssueHost.Shape) => {
    const result = try execute(patch, as, false, host)
    if (reasonOf(result) !== wanted) throw new Finding({ report: `${label} answered ${reasonOf(result)}, not ${wanted}` })
    return result
  }
  const complete: Partial<IssueRequest> = { op: "propose", text: "A summary", example: "e", prior: "p" }
  const writesBefore = fake.writes
  switch (scenario) {
    case "validations": {
      const table: ReadonlyArray<readonly [string, string, Partial<IssueRequest>]> = [
        ["a blank title", "title", { op: "new", title: "  " }],
        ["a new issue", "connect", { op: "new" }],
        ["a split of an unknown issue", "missing", { op: "split", number: 9999 }],
        ["a split", "connect", { op: "split", number: 1 }],
        ["an incomplete proposal", "incomplete", { op: "propose", example: " " }],
        ["a proposal", "connect", complete],
        ["a comment on an unknown issue", "missing", { op: "comment", number: 9999 }],
        ["a blank comment", "empty", { op: "comment", number: 1, text: " " }],
        ["a comment", "connect", { op: "comment", number: 1, text: "A note" }],
        ["a link to itself", "tree", { op: "link", number: 1, parent: 1 }],
        ["a link to the current parent", "ok", { op: "link", number: 1, parent: 3 }],
        ["a new link", "connect", { op: "link", number: 1, parent: 2 }],
        ["a commitment to a closed issue", "closed", { op: "commit", number: 2, assignee: "fuzz" }],
        ["a commitment to a stranger", "assignee", { op: "commit", number: 1, assignee: "ghost" }],
        ["a commitment to the agent", "connect", { op: "commit", number: 1, assignee: "VibeLang agent" }],
        ["a release", "connect", { op: "uncommit", number: 3 }],
        ["a decline of a plain issue", "review", { op: "decline", number: 1 }],
        ["an acceptance in review", "connect", { op: "accept", number: 4 }],
        ["a decline in review", "connect", { op: "decline", number: 4 }],
      ]
      for (const [label, wanted, patch] of table) {
        const result = try expect(label, wanted, patch)
        // A refusal before any write marks itself unwritten on a fresh execution, so the person may edit and resend.
        if (["title", "incomplete", "empty", "tree", "assignee", "closed", "review"].includes(wanted) && (result._tag !== "Failure" || result.failure.unwritten !== true)) throw new Finding({ report: `${label} was not marked unwritten` })
      }
      // Every `connect` told the authority the delegation is gone.
      const connects = table.filter(([, wanted]) => wanted === "connect").length
      if ((try Ref.get(lost)) !== connects) throw new Finding({ report: `${connects} connect answers told the authority ${try Ref.get(lost)} times` })
      // An approval needs a named maintainer; a blank login approves nothing.
      try expect("an acceptance with no login", "forbidden", { op: "accept", number: 4 }, [{ ...maintainer, login: "" }])
      fake.noMain = true
      try expect("a proposal with no default branch", "missing", complete)
      break
    }
    case "reviews": {
      const proposal = fake.issues.find((issue) => issue.number === 4)!
      proposal.labels = [{ name: "vibelang:accepted" }]
      // A label alone is no approval: before any maintainer accepts it here, the proposal reads as in review.
      const unapproved = try expect("a read of a proposal accepted only on GitHub", "ok", { op: "read" })
      if (unapproved._tag === "Success" && unapproved.success.items.find((entry) => entry.number === 4)?.vip !== "In review") throw new Finding({ report: "a GitHub label alone approved a proposal" })
      // Accepted on GitHub, unapproved here: accepting writes nothing and records this maintainer's approval.
      const accepted = try expect("an acceptance of an accepted proposal", "ok", { op: "accept", number: 4 })
      const item = accepted._tag === "Success" ? accepted.success.items.find((entry) => entry.number === 4) : undefined
      if (item?.vip !== "Accepted" || item.approvedBy !== "fuzz") throw new Finding({ report: "the acceptance recorded no approval" })
      // The recorded approval, not the label, keeps the proposal accepted on the next read.
      const reread = try expect("a read after the approval", "ok", { op: "read" })
      const kept = reread._tag === "Success" ? reread.success.items.find((entry) => entry.number === 4) : undefined
      if (kept?.vip !== "Accepted" || kept.approvedBy !== "fuzz" || kept.approvedAt !== item.approvedAt) throw new Finding({ report: "the approval receipt was lost on a read" })
      // An approval stored without its time (another writer, or a hand edit) keeps its approver and still decodes.
      const stored = (try promise(() => storage.get("gates/state"))) as typeof IssuesState.Type
      try promise(() => storage.put("gates/state", { ...stored, items: stored.items.map((entry) => {
        if (entry.number !== 4) return entry
        const { approvedAt: _approvedAt, ...withoutTime } = entry
        return withoutTime
      }) }))
      const handEdited = try expect("a read of an approval stored without its time", "ok", { op: "read" })
      const edited = handEdited._tag === "Success" ? handEdited.success.items.find((entry) => entry.number === 4) : undefined
      if (edited?.approvedBy !== "fuzz" || edited.approvedAt !== undefined) throw new Finding({ report: "an approval stored without its time was dropped or given one" })
      proposal.labels = [{ name: "vibelang:declined" }]
      try expect("a decline of a declined open proposal", "connect", { op: "decline", number: 4 })
      proposal.state = "closed"
      try expect("a decline of a declined closed proposal", "ok", { op: "decline", number: 4 })
      break
    }
    case "resume": {
      const key = `w${pick}`
      const write: Partial<IssueRequest> = { op: "new", key }
      try expect("a new issue", "connect", write)
      const resume = (patch: Partial<IssueRequest>) => ({ op: "read" as const, resumeOp: "new", resumeKey: key, ...patch })
      for (const [label, patch] of [["the root", {}], ["an absent recovery", { resumeRecovery: "r1" }]] as const) {
        const read = try expect(`resuming ${label}`, "ok", resume(patch))
        const saved = read._tag === "Success" ? read.success.saved : undefined
        if (saved?.status !== "failed" || saved.request.key !== key || saved.unwritten) throw new Finding({ report: `resuming ${label} saw ${saved?.status}` })
      }
      try expect("a changed payload under a used key", "invalid", { ...write, title: `${title}!` })
      try expect("the recovery", "connect", { ...write, recovery: "r1" })
      try expect("the joined recovery", "connect", { ...write, recovery: "r1" })
      try expect("a recovery with a changed payload", "invalid", { ...write, title: `${title}!`, recovery: "r2" })
      const recovered = try expect("resuming the recovery", "ok", resume({ resumeRecovery: "r1" }))
      if (recovered._tag !== "Success" || recovered.success.saved?.status !== "failed") throw new Finding({ report: "the recovery's receipt was lost" })
      try expect("resuming a key never used", "missing", resume({ resumeKey: `never${pick}` }))
      try expect("resuming a malformed key", "invalid", resume({ resumeKey: "bad key!" }))
      try expect("resuming an unknown operation", "invalid", resume({ resumeOp: "bogus" }))
      try expect("resuming a malformed recovery", "invalid", resume({ resumeRecovery: "bad!" }))
      try expect("a signed-out resume", "sign-in", resume({}), [undefined])
      // A write that completed with nothing to change resumes as completed, on the issue it named.
      try expect("a link to the current parent", "ok", { op: "link", number: 1, parent: 3, key: `l${pick}` })
      const linked = try expect("resuming the link", "ok", resume({ resumeOp: "link", resumeKey: `l${pick}` }))
      const saved = linked._tag === "Success" ? linked.success.saved : undefined
      if (saved?.status !== "completed" || saved.selected !== 1) throw new Finding({ report: `the completed link resumed as ${saved?.status}` })
      break
    }
    case "spec": {
      const revised = try expect("a specification revision", "ok", { op: "spec-revise", revision: 0, text: `Spec ${pick}.` })
      if (revised._tag !== "Success" || revised.success.specification?.revision !== 1) throw new Finding({ report: "the revision was not recorded" })
      try expect("a review with no reviewer model", "no-model", { op: "spec-review", revision: 1, reviewer: "astra" })
      break
    }
    case "shapes": {
      // GitHub data a read must survive: deleted users, null bodies and assignees, out-of-range parents, task states.
      fake.issues.push({
        id: 50, node_id: "node-5", number: 5, title: "Running", body: null, state: "open", state_reason: null, user: null,
        labels: [{ name: "vibelang:task" }, { name: "vibelang:running" }], comments: 0, created_at: "2026-01-01T00:00:00Z",
        updated_at: "2026-01-01T00:00:00Z", closed_at: null, assignees: [null, { id: 8, login: "vibe-agent" }],
        parent_issue_url: `${repo.api}/repos/o/r/issues/99999999999999999999`,
      }, {
        id: 60, node_id: "node-6", number: 6, title: "Done", body: "", state: "closed", state_reason: null, user: { id: 7, login: "fuzz" },
        labels: [{ name: "vibelang:task" }], comments: 0, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z",
        closed_at: "2026-01-02T00:00:00Z", assignees: [{ id: 7, login: "fuzz" }],
      })
      fake.comments[1]!.push({ id: 901, node_id: "comment-901", body: null, user: null, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", issue_url: `${repo.api}/repos/o/r/issues/1` })
      fake.assignable.push({ id: 9, login: "zed" }, { id: 10, login: "abe" })
      // A project object stored before specifications existed.
      try promise(() => storage.put("gates/state", { seq: 0, items: [] }))
      const read = try expect("a read of odd data", "ok", { op: "read", number: 1 })
      if (read._tag !== "Success") break
      const state = read.success
      const running = state.items.find((item) => item.number === 5)
      const done = state.items.find((item) => item.number === 6)
      const notes = state.items.find((item) => item.number === 1)?.notes ?? []
      if (running?.author !== "deleted" || running.body !== "" || running.task !== "Running" || running.assignee !== "vibe-agent" || running.parent !== 0) throw new Finding({ report: "an issue with deleted and null fields read wrongly" })
      if (done?.task !== "Done") throw new Finding({ report: "a closed task did not read as done" })
      if (!notes.some((note) => note.event && note.text === "unassigned vibe-agent") || !notes.some((note) => !note.event && note.author === "deleted" && note.text === "")) throw new Finding({ report: "the timeline or a deleted comment was lost" })
      if ((state.assignees ?? []).map((choice) => choice.login).join(",") !== "vibe-agent,abe,fuzz,zed") throw new Finding({ report: "the agent is not the first assignee choice" })
      if (state.specification?.revision !== 0) throw new Finding({ report: "a stored state without a specification read one" })
      fake.endlessReviews = true
      try expect("a proposal with endless reviews", "partial", { op: "read", number: 4 })
      fake.endlessReviews = false
      fake.endlessIssues = true
      try expect("a connected read of endless issues", "partial", { op: "read" })
      fake.endlessIssues = false
      fake.malformedIssues = true
      try expect("a list with a malformed issue", "protocol", { op: "read" })
      fake.malformedIssues = false
      // GitHub's list trails a write: the selected issue, not listed yet, is read by itself and shown.
      fake.tick = 0
      fake.issueVisibleAt = { ...fake.issueVisibleAt, 3: 1 }
      const trailing = try expect("a selected issue the list does not show yet", "ok", { op: "read", number: 3 })
      if (trailing._tag === "Success" && !trailing.success.items.some((item) => item.number === 3)) throw new Finding({ report: "a selected issue missing from the list was not shown" })
      // Its own read refused is the answer, not a list without it.
      fake.issueStatus = { 3: 403 }
      try expect("a selected issue whose own read is refused", "forbidden", { op: "read", number: 3 })
      delete fake.issueStatus
      delete fake.tick
      // The project object's saved gates and GitHub's revision are checked before they are used.
      const gates = try promise(() => storage.get("gates/state"))
      try promise(() => storage.put("gates/state", { seq: "x" }))
      try expect("saved gates that are not the protocol", "protocol", { op: "read" })
      try promise(() => storage.put("gates/state", { seq: 9007199254740991, items: [] }))
      try expect("saved gates with no revision left", "protocol", { op: "read" })
      if (gates === undefined) try promise(() => storage.delete("gates/state"))
      else try promise(() => storage.put("gates/state", gates))
      const outOfRange: IssueHost.Shape = { perform: () => succeed({ seq: -1, items: [] } as never) }
      try expect("a host answering a revision out of range", "protocol", { op: "read" }, [maintainer], outOfRange)
      break
    }
    case "served": {
      const accepted = try Ref.make(0)
      for (const [index, reason] of Object.keys(SERVED).entries()) for (const outcome of ["failure", "success"] as const) {
        const unwritten = (pick + index) % 2 === 0
        const host: IssueHost.Shape = { perform: () => outcome === "success" ? succeed({ seq: 1, items: [] }) : fail(new IssueFailure({ reason, ...(unwritten ? { unwritten: true } : {}) })) }
        const body = JSON.stringify({ ...base, op: pick % 4 < 2 ? "new" : "comment", number: 1, key: `served-${outcome}-${index}-${pick}` })
        const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/issues"), body))
        try Ref.set(principal, [maintainer])
        const response = try Effect.provideService(serveIssues("issues-served", storage, repo, () => Ref.update(accepted, (n) => n + 1)).pipe(
          Effect.provideService(IssueAuthority, authority), Effect.provideService(IssueHost, host),
          Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
        ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
        const text = try promise(() => HttpServerResponse.toWeb(response).text())
        const answer = try Effect.try(() => JSON.parse(text) as { reason?: string; unwritten?: boolean })
        if (outcome === "failure" && (response.status !== SERVED[reason] || answer.reason !== reason || (answer.unwritten === true) !== unwritten)) throw new Finding({ report: `${reason} was served as ${response.status}` })
        if (outcome === "success" && (response.status !== 200 || (try Ref.get(accepted)) !== index + 1)) throw new Finding({ report: "an accepted write did not reach the person's callback once" })
      }
      break
    }
    case "demoted": {
      // The principal changes between the flow's authorization and the project's own gate.
      try expect("an acceptance by a person who became an agent", "forbidden", { op: "accept", number: 4 }, [maintainer, { ...maintainer, kind: "agent" }])
      try expect("a revision by a person who signed out", "forbidden", { op: "spec-revise", revision: 0, text: "Spec." }, [maintainer, undefined])
      try expect("a revision by a person who became a viewer", "forbidden", { op: "spec-revise", revision: 0, text: "Spec." }, [maintainer, { id: "7", login: "fuzz", role: "viewer" }])
