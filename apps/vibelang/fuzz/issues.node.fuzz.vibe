      for (const reason of REFUSALS) {
        const failure = issueFailureOf({ _tag: "@smthrs/integrations/DelegationRefused", reason })
        if (failure.reason !== (reason === "key_conflict" ? "invalid" : reason)) throw new Finding({ report: `${reason} became ${failure.reason}` })
