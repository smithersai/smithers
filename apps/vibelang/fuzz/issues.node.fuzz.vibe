      break
    }
    case "store": {
      // The engine's store refuses to open: the typed failure is served as 503 unavailable, never as a defect.
      store.fail(/./)
      const broken = try execute({ op: "read" })
      if (broken._tag !== "Failure" || reasons.includes(broken.failure.reason)) throw new Finding({ report: `a store that cannot open answered ${reasonOf(broken)}` })
      const web = try HttpClientRequest.toWeb(HttpClientRequest.bodyText(HttpClientRequest.post("https://fuzz.invalid/api/issues"), JSON.stringify({ ...base, key: `store-${pick}` })))
      try Ref.set(principal, [maintainer])
      const response = try Effect.provideService(serveIssues("issues-steered", storage, repo).pipe(
        Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, fakeClient(fake)), Effect.provide(WebCrypto.layer),
      ), HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web))
      const served = try promise(() => HttpServerResponse.toWeb(response).text())
      if (response.status !== 503 || served !== JSON.stringify({ reason: "unavailable" })) throw new Finding({ report: `a store that cannot open was served as ${response.status}` })
      // A request opens the engine twice: to poll its key, then to run. Counted on a healthy request, the second open
      // alone fails, and the flow's own failure is unavailable.
      store.fail()
      try expect("a read on a healed store", "ok", { op: "read" })
      // The healed request migrated the store; the next one only checks its migrations.
      const mark = store.log.length
      try expect("a read on a migrated store", "ok", { op: "read" })
      const opens = store.log.slice(mark).filter((query) => query.includes("flows_migrations")).length
      if (opens === 0 || opens % 2 !== 0) throw new Finding({ report: `a request opened the store with ${opens} migration statements` })
      store.fail(/flows_migrations/, opens / 2)
      try expect("a read whose run cannot open the store", "unavailable", { op: "read" })
      // The store refuses the run's row: a defect, as Objects.post's store failure is, and nothing is left behind.
      const key = `store-${pick}`
      store.fail(/INSERT INTO flows_runs/)
      const died = try Effect.exit(execute({ op: "read", key }))
      if (died._tag !== "Failure" || !Cause.hasDies(died.cause)) throw new Finding({ report: "a refused run row was not a defect" })
      store.fail()
      try expect("the same read after the store heals", "ok", { op: "read", key })
      try expect("the same read again, joined", "ok", { op: "read", key })
      // A failed write's join and recovery read the run's recorded payload and its steps; either read failing is
      // unavailable, and the healed recovery still retries the write.
      const write: Partial<IssueRequest> = { op: "new", key: `w-${key}` }
      try expect("a new issue", "connect", write)
      const reads: ReadonlyArray<readonly [string, RegExp, Partial<IssueRequest>]> = [
        ["a join whose payload cannot be read", /FROM flows_runs r WHERE r\.run_id/, write],
        ["a recovery whose payload cannot be read", /FROM flows_runs r WHERE r\.run_id/, { ...write, recovery: "r1" }],
        ["a recovery whose steps cannot be read", /SELECT step_key_digest, attempt, state/, { ...write, recovery: "r1" }],
      ]
      for (const [label, pattern, patch] of reads) {
        store.fail(pattern)
        try expect(label, "unavailable", patch)
      }
      store.fail()
      // The store lost the run's step events: no write step to retry from, and the recovery is unavailable.
      store.lose(/WHERE run_id = \? AND event_type IN/)
      try expect("a recovery whose steps were lost", "unavailable", { ...write, recovery: "r1" })
      store.lose()
      try expect("the healed recovery", "connect", { ...write, recovery: "r1" })
      break
    }
    case "running": {
      // A latch holds the write inside GitHub; the person's resume meanwhile sees it running, then completed.
      const entered = try Deferred.make<void>()
      const release = try Deferred.make<void>()
      const created = { seq: 1, items: [], selected: 7 }
      const host: IssueHost.Shape = {
        perform: (request) => request.op !== "new" ? succeed({ seq: 1, items: [] }) : Deferred.succeed(entered, undefined).pipe(Effect.andThen(Deferred.await(release)), Effect.as(created)),
      }
      const key = `r${pick}`
      const writing = try Effect.forkScoped(expect("a held new issue", "ok", { op: "new", key }, [maintainer], host))
      try Deferred.await(entered)
      const resume = { op: "read" as const, resumeOp: "new", resumeKey: key }
      const during = try expect("resuming a held write", "ok", resume, [maintainer], host)
      if (during._tag !== "Success" || during.success.saved?.status !== "running" || during.success.saved.request.key !== key) throw new Finding({ report: `a held write resumed as ${during._tag === "Success" ? during.success.saved?.status : reasonOf(during)}` })
      try Deferred.succeed(release, undefined)
      try Fiber.join(writing)
      const after = try expect("resuming the released write", "ok", resume, [maintainer], host)
      if (after._tag !== "Success" || after.success.saved?.status !== "completed" || after.success.saved.selected !== 7) throw new Finding({ report: `the released write resumed as ${after._tag === "Success" ? after.success.saved?.status : reasonOf(after)}` })
      break
    }
    case "delegated": {
      // Connected through smithers.sh's real delegation: the person's own writes reach GitHub and complete.
      forked(fake)
      const site = try delegated(fakeClient(fake), reach())
      const connected: Person = { ...maintainer, connection: site.connection }
      const via = effect (label: string, wanted: string, patch: Partial<IssueRequest>) => {
        count += 1
        try Ref.set(principal, [connected])
        const result = try Effect.result(executeIssues("issues-steered", storage, { ...base, key: `d${pick}-${count}`, ...patch } as IssueRequest, repo).pipe(
          Effect.provideService(IssueAuthority, authority), Effect.provideService(HttpClient.HttpClient, site.http), Effect.provideService(GitHubDelegate, site.delegate),
          Effect.provide(WebCrypto.layer), Effect.mapError((error) => error._tag === "IssueFailure" ? error : new IssueFailure({ reason: error._tag })),
        ))
        if (reasonOf(result) !== wanted) throw new Finding({ report: `${label} answered ${reasonOf(result)}, not ${wanted}` })
        return result
      }
      const selected = (result: Result.Result<typeof IssuesState.Type, IssueFailure>) => result._tag === "Success" ? result.success.selected : undefined
      // A draft needs the writer this host was built without.
      try via("a delegated draft with no writer", "unavailable", { op: "draft" })
      const made = try via("a delegated new issue", "ok", { op: "new" })
      const created = fake.issues.find((issue) => issue.number === selected(made))
      if (created?.title !== title.trim()) throw new Finding({ report: "a delegated new issue was not selected on GitHub" })
      const split = try via("a delegated split", "ok", { op: "split", number: 1 })
      const child = fake.issues.find((issue) => issue.number === selected(split))
      if (child?.parent_issue_url !== `${repo.api}/repos/o/r/issues/1`) throw new Finding({ report: "a delegated split was not linked under its issue" })
      // GitHub writes the link, then fails the reads after it: the retried split adopts its issue, sees the link, and
      // writes no second one.
      const linksBefore = fake.writes
      fake.dropAfterLink = 3
      const relinked = try stepped(via("a split whose reads failed after its link", "ok", { op: "split", number: 1 }), 60)
      fake.dropAfterLink = 0
      fake.dropping = 0
      const relinkedChild = fake.issues.find((issue) => issue.number === selected(relinked))
      if (relinkedChild?.parent_issue_url !== `${repo.api}/repos/o/r/issues/1` || fake.writes - linksBefore !== 2) throw new Finding({ report: `a retried split made ${fake.writes - linksBefore} writes` })
