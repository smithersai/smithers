// The mock Factory's room edges (src/core/MockFactory.vibe) that the scripted targets reach only by chance: a journal
// retained mid-reply or with an unanswered post, tour controls outside the protocol, with no tour and on a running one,
// a post behind a running tour, a tour asked for right after a post, calls after the Factory's scope closed, and a
// journal numbered out of order.
// Oracle: a known wiki page opens and an unknown one is refused as empty; a reply cut off by a reload fails in words and the next post is answered; a retained post is answered; a
// malformed control is Unavailable and a control with no tour is Refused, both writing nothing; every control on a
// driven walkthrough answers; a post behind a tour, or contended by one, is answered once the tour ends; a closed
// Factory answers Unavailable.
import { it } from "@effect/vitest"
import type { Event } from "../src/core/conversation.vibe"
import { Factory, Refused, Unavailable } from "../src/core/Factory.vibe"
import { mockFactoryFor } from "../src/core/MockFactory.vibe"
import { MockJournal } from "../src/core/MockJournal.vibe"
import { replyIdOf } from "../src/core/flows.vibe"
import { run, Int, Text } from "./run.vibe"

const Input = Schema.Struct({ text: Text, step: Int, action: Schema.Literals(["pause", "resume", "seek", "jump"]) })

/** A refuted check names itself, never a value. */
error Refuted {
  check: number
  get message() { return `check ${this.check}` }
}

/** A page's journal: what it retained, and what the Factory writes back. */
function journal(retained: Record<string, ReadonlyArray<Event>>) {
  const kept = new Map(Object.entries(retained))
  return Layer.succeed(MockJournal, {
    read: (conversation: string) => sync(() => kept.get(conversation) ?? []),
    write: (conversation: string, events: ReadonlyArray<Event>) => sync(() => { kept.set(conversation, events) }),
  })
}

/** Every event of `room` until the reply to `post` settles, bounded. */
effect function settled(factory: Factory.Shape, room: string, post: string) {
  const events = try Stream.runCollect(factory.events(room, 0).pipe(
    Stream.takeUntil((event) => (event.type === "ReplyFinished" || event.type === "ReplyFailed") && event.id === replyIdOf(post)),
    Stream.timeout("20 seconds"),
  ))
  if (!Array.from(events).some((event) => (event.type === "ReplyFinished" || event.type === "ReplyFailed") && event.id === replyIdOf(post))) throw new Refuted({ check: 1 })
}

effect function reply(factory: Factory.Shape, room: string, post: string) {
  return (try factory.read(room, 0)).entries.find((entry) => entry.inReplyTo === post)
}

it.live("mock/factory-edges", () => run("mock/factory-edges", Input, ({ text, step, action }) => scoped(effect {
  const retained = journal({
    "cut-off": [
      { type: "Posted", seq: 1, id: "m1", clientId: "a", name: "Ada", text: "install" },
      { type: "ReplyStarted", seq: 2, id: replyIdOf("m1"), inReplyTo: "m1" },
      { type: "ReplyDelta", seq: 3, id: replyIdOf("m1"), text: text === "" ? "Half" : text },
    ],
    "unanswered": [{ type: "Posted", seq: 1, id: "m1", clientId: "a", name: "Ada", text: "install" }],
    // A journal an older or broken writer numbered out of order: one number repeated, one skipped.
    "renumbered": [
      { type: "Posted", seq: 1, id: "m1", clientId: "a", name: "Ada", text: "install" },
      { type: "Posted", seq: 1, id: "m2", clientId: "b", name: "Ada", text: text === "" ? "again" : text },
      { type: "Posted", seq: 3, id: "m3", clientId: "c", name: "Ada", text: "later" },
    ],
  })
  provide mockFactoryFor().pipe(Layer.provide(retained)) {
    const factory = try Factory
    const controlTour = factory.controlTour
    if (controlTour === undefined) throw new Refuted({ check: 0 })
    // A project wiki page opens in the room; a page the wiki doesn't have opens nothing and is refused as empty.
    const known = try exit(factory.openWiki(`wiki-${step}`, "index"))
    const unknown = try exit(factory.openWiki(`wiki-${step}`, "no-such-page"))
    const refusal = unknown._tag === "Failure" ? Cause.squash(unknown.cause) : undefined
    if (known._tag !== "Success" || !(refusal instanceof Refused) || refusal.refusal !== "empty") throw new Refuted({ check: 30 })
    // A reply the reload cut off fails in words, and the next post is answered.
    try factory.post("cut-off", "b", "Ada", "install")
    const next = (try factory.read("cut-off", 0)).entries.find((entry) => entry.clientId === "b")
    if (next === undefined) throw new Refuted({ check: 2 })
    try settled(factory, "cut-off", next.id)
    const cut = (try factory.read("cut-off", 0)).entries.find((entry) => entry.id === replyIdOf("m1"))
    if (cut?.done !== true || cut.error !== "The agent failed. Try again.") throw new Refuted({ check: 3 })
    if ((try reply(factory, "cut-off", next.id))?.error !== "") throw new Refuted({ check: 4 })

    // A retained post nobody answered is answered once the room opens.
    try settled(factory, "unanswered", "m1")
    if ((try reply(factory, "unanswered", "m1"))?.done !== true) throw new Refuted({ check: 5 })

    // A renumbered journal keeps only the events a replay applies, counts the rest, and answers the kept post.
    const trimmed = Metric.counter("vibelang_mock_trimmed_journal_events", { description: "Retained journal events a restore dropped: numbered out of order", incremental: true })
    const dropped = (try Metric.value(trimmed)).count
    try settled(factory, "renumbered", "m1")
    const restored = try factory.read("renumbered", 0)
    if ((try Metric.value(trimmed)).count - dropped !== 2 || restored.entries.some((entry) => entry.id === "m2" || entry.id === "m3")) throw new Refuted({ check: 14 })
    const numbers = Array.from(try Stream.runCollect(factory.events("renumbered", 0).pipe(Stream.take(restored.seq), Stream.timeout("20 seconds")))).map((event) => event.seq)
    if (numbers.some((seq, index) => seq !== index + 1)) throw new Refuted({ check: 15 })

    // A control outside the protocol is Unavailable; one with no tour is Refused; neither writes an event.
    const room = `controls-${step}`
    const before = (try factory.read(room, 0)).seq
    const malformed = try exit(controlTour(room, "jump" as "pause", step))
    const outOfRange = try exit(controlTour(room, "seek", 12 + step))
    if (malformed._tag !== "Failure" || !(Cause.squash(malformed.cause) instanceof Unavailable) || outOfRange._tag !== "Failure" || !(Cause.squash(outOfRange.cause) instanceof Unavailable)) throw new Refuted({ check: 6 })
    for (const control of ["pause", "resume", "seek"] as const) {
      const idle = try exit(controlTour(room, control, 1 + step % 11))
      if (idle._tag !== "Failure" || !(Cause.squash(idle.cause) instanceof Refused)) throw new Refuted({ check: 7 })
    }
    if ((try factory.read(room, 0)).seq !== before) throw new Refuted({ check: 8 })

    // Once the walkthrough drives its first step every control answers; a post behind the tour waits, then is answered.
    try factory.tour(room)
    const driven = try Stream.runCollect(factory.events(room, 0).pipe(Stream.takeUntil((event) => event.type === "WalkthroughDriven"), Stream.timeout("20 seconds")))
    if (!Array.from(driven).some((event) => event.type === "WalkthroughDriven")) throw new Refuted({ check: 19 })
    for (const [index, control] of (["pause", "resume", "seek"] as const).entries()) {
      const answered = try exit(controlTour(room, control, 1 + step % 11))
      if (answered._tag === "Failure") throw new Refuted({ check: 20 + index })
    }
    if (action !== "jump") try exit(controlTour(room, action, 1 + step % 11))
    try factory.post(room, "q", "Ada", "install")
    const asked = (try factory.read(room, 0)).entries.find((entry) => entry.clientId === "q")
    if (asked === undefined) throw new Refuted({ check: 9 })
    // A seek to the last stop lets the walkthrough finish on its own first; ending it then is refused as no tour.
    const ended = try exit(factory.endTour(room))
    if (ended._tag === "Failure" && !(Cause.squash(ended.cause) instanceof Refused && (Cause.squash(ended.cause) as Refused).refusal === "not-replying")) throw new Refuted({ check: 16 })
    try settled(factory, room, asked.id)
    if ((try reply(factory, room, asked.id))?.done !== true) throw new Refuted({ check: 10 })

    // A tour asked for right after a post may start before the post's reply does: the reply's start is contended,
    // hands the object to the tour, and is answered once the tour ends.
    const raced = `race-${step}`
    try factory.post(raced, "r", "Ada", "install")
    const toured = try exit(factory.tour(raced))
    if (toured._tag === "Failure" && !(Cause.squash(toured.cause) instanceof Refused)) throw new Refuted({ check: 12 })
    const racer = (try factory.read(raced, 0)).entries.find((entry) => entry.clientId === "r")
    if (racer === undefined) throw new Refuted({ check: 13 })
    if (toured._tag === "Success") try exit(factory.endTour(raced))
    try settled(factory, raced, racer.id)
  }

  // After its scope closes, the Factory opens no room.
  const scope = try Scope.make()
  const closed = Context.get(try Layer.buildWithScope(mockFactoryFor(), scope), Factory)
  try Scope.close(scope, Exit.void)
  const late = try exit(closed.tour("after-close"))
  if (late._tag !== "Failure" || !(Cause.squash(late.cause) instanceof Unavailable)) throw new Refuted({ check: 11 })
  return true
})))
