// The container and allowance Durable Objects' real bodies, wired as live: gateway, account object, machine object,
// over SQLite storage and a container whose commands are local processes. Live Containers stay off.
import { it } from "@effect/vitest"
import { RuntimeContext } from "alchemy"
import { HttpServerRequest } from "effect/http"
import type { SandboxSnapshot } from "../src/core/Factory.vibe"
import { mayStart, SandboxPolicy, signedOut } from "../src/core/sandboxPolicy.vibe"
import { machineObject, type MachineBox, type ObjectState } from "../worker/SandboxMachine.vibe"
import { accountObject, gatewayOf, gatewayWithIdentity, identityFromPolicy, noIdentity, SandboxGateway, SandboxIdentity } from "../worker/SandboxAccounts.vibe"
import { signedOutGateway } from "../worker/SandboxHttp.vibe"
import { makeBox, namespaceOf, type BoxFault } from "./machine-box.ts"
import { objectStorage } from "../test/support/objectStorage.ts"
import { run, Finding, Int } from "./run.vibe"

const OWNER = "person-1"
const FAULTS = ["start", "stuck", "setup", "snapshot", "destroy", "exec", "running"] as const satisfies ReadonlyArray<BoxFault>
/** Fixed text: these run as real processes, so a target never executes generated text. */
const COMMANDS = ["echo hi", "false", "exit 3", "head -c 300000 /dev/zero | tr \"\\0\" x", "printf \"\\377\""]
const DURATIONS = ["60000", "5", "many", "21600001", "1000"]
const Fault = Schema.Struct({ faulty: Schema.Boolean, fault: Int })
const MachineInput = Schema.Struct({
  prefix: Schema.Boolean,
  steps: Schema.Array(Schema.Struct({ kind: Schema.Literals(["start", "stop", "command", "lease"]), generation: Int, current: Schema.Boolean, next: Schema.Boolean, operation: Int, command: Int, duration: Int, fault: Fault })).check(Schema.isMaxLength(10)),
})
const AccountInput = Schema.Struct({
  role: Schema.Literals(["viewer", "new", "community", "contributor", "maintainer"]),
  person: Schema.Literals([OWNER, "", "person-2"]),
  prefix: Schema.Boolean,
  allowed: Schema.Boolean,
  binding: Schema.Boolean,
  steps: Schema.Array(Schema.Struct({ kind: Schema.Literals(["read", "start", "stop", "command"]), generation: Int, current: Schema.Boolean, operation: Int, command: Int, fault: Fault })).check(Schema.isMaxLength(8)),
})
function stateOf(storage: ReturnType<typeof objectStorage>, id: string) {
  return { raw: { storage }, id: { toString: () => id } } as unknown as ObjectState
}
function faulted(faults: Set<BoxFault>, fault: { readonly faulty: boolean; readonly fault: number }) {
  faults.clear()
  if (fault.faulty) faults.add(FAULTS[fault.fault % FAULTS.length]!)
}
const provided = <A, E>(body: Effect<A, E, RuntimeContext | Scope.Scope>) => Effect.provideService(body, RuntimeContext, {} as never)
const clean = { faulty: false, fault: 0 }

/** Stale generations never act, an admitted command runs once, and a stop that reports success has stopped the box. */
it.live("sandbox/machine-object", () => run("sandbox/machine-object", MachineInput, (input) => provided(effect {
  const local = try Effect.acquireRelease(sync(() => makeBox()), (made) => sync(() => made.dispose()))
  const storage = try Effect.try(() => objectStorage())
  const machine = try machineObject(local.box as unknown as MachineBox, stateOf(storage, "m"))
  let generation = 0
  const reached = new Set<string>()
  const lifecycle = input.prefix ? [
    { kind: "start" as const, generation: 0, current: false, next: true, operation: 0, command: 0, duration: 0, fault: clean },
    { kind: "lease" as const, generation: 0, current: true, next: false, operation: 0, command: 0, duration: 0, fault: clean },
    { kind: "command" as const, generation: 0, current: true, next: false, operation: 1, command: 0, duration: 0, fault: clean },
    { kind: "command" as const, generation: 0, current: true, next: false, operation: 1, command: 0, duration: 0, fault: clean },
    { kind: "stop" as const, generation: 0, current: true, next: false, operation: 0, command: 0, duration: 0, fault: clean },
    { kind: "start" as const, generation: 0, current: false, next: true, operation: 0, command: 0, duration: 0, fault: clean },
  ] : []
  // Every box fault once per execution, at each kind it can break: a start, a leased command, a stop.
  const faultWalk = FAULTS.flatMap((_, at) => [
    { kind: "start" as const, generation: 0, current: false, next: true, operation: at, command: 0, duration: 0, fault: { faulty: true, fault: at } },
    { kind: "lease" as const, generation: 0, current: true, next: false, operation: at, command: 0, duration: 0, fault: clean },
    { kind: "command" as const, generation: 0, current: true, next: false, operation: at, command: 0, duration: 0, fault: { faulty: true, fault: at } },
    { kind: "stop" as const, generation: 0, current: true, next: false, operation: at, command: 0, duration: 0, fault: { faulty: true, fault: at } },
  ])
  // A container that stops while an admitted command runs: the command is not current, and it never runs again.
  {
    generation += 1
    const started = try machine.apply("start", generation, "op-dies", "")
    try machine.apply("lease", generation, "op-dies", "60000")
    local.faults.add("dies")
    const ran = local.state.executed.length
    const lost = try machine.apply("command", generation, "op-dies", "echo hi")
    local.faults.clear()
    const again = try machine.apply("command", generation, "op-dies", "echo hi")
    if (started.ok && (lost.ok || local.state.executed.length !== ran + 1 || again.ok)) return false
  }
  // Every execution: a lease the protocol refuses, a repeated operation answered from its receipt (never run again), a
  // receipt left pending by a failed exec, and a command after its lease ran out (the lease's end moved to the past).
  {
    try machine.apply("stop", generation, "op-receipt-stop", "")
    generation += 1
    const started = try machine.apply("start", generation, "op-receipt", "")
    const refusedLease = try machine.apply("lease", generation, "op-receipt", "5")
    try machine.apply("lease", generation, "op-receipt", "60000")
    const first = try machine.apply("command", generation, "op-receipt", "echo hi")
    const ran = local.state.executed.length
    const repeated = try machine.apply("command", generation, "op-receipt", "echo hi")
    const changed = try machine.apply("command", generation, "op-receipt", "echo bye")
    local.faults.add("exec")
    try machine.apply("command", generation, "op-pending", "echo hi")
    local.faults.clear()
    const pending = try machine.apply("command", generation, "op-pending", "echo hi")
    const saved = storage.kv.get("machine") as Record<string, unknown>
    try promise(() => storage.put("machine", { ...saved, leaseUntil: Date.now() - 1 }))
    const expired = try machine.apply("command", generation, "op-expired", "echo hi")
    const reason = (answer: { readonly ok: boolean }) => "reason" in answer ? answer.reason : ""
    if (!started.ok || refusedLease.ok || reason(refusedLease) !== "lease-duration" || !first.ok || !repeated.ok || repeated.output !== first.output
      || changed.ok || reason(changed) !== "receipt-conflict" || pending.ok || reason(pending) !== "receipt-conflict" || local.state.executed.length !== ran
      || expired.ok || reason(expired) !== "lease-expired") return false
  }
  // Every execution: a command on a machine started but never leased (a fresh object, or a restart: a lease is its
  // generation's, so the next generation starts with none) has no lease to run under, and does not run.
  {
    const fresh = try Effect.acquireRelease(sync(() => makeBox()), (made) => sync(() => made.dispose()))
    const unleasedMachine = try machineObject(fresh.box as unknown as MachineBox, stateOf(try Effect.try(() => objectStorage()), "m-unleased"))
    const started = try unleasedMachine.apply("start", 1, "op-unleased-start", "")
    const unleased = try unleasedMachine.apply("command", 1, "op-unleased", "echo hi")
    if (!started.ok || unleased.ok || !("reason" in unleased) || unleased.reason !== "lease-expired" || fresh.state.executed.length !== 0) return false
    const again = try Effect.acquireRelease(sync(() => makeBox()), (made) => sync(() => made.dispose()))
    const restarted = try machineObject(again.box as unknown as MachineBox, stateOf(try Effect.try(() => objectStorage()), "m-restarted"))
    const first = [try restarted.apply("start", 1, "op-r1", ""), try restarted.apply("lease", 1, "op-r1", "60000"), try restarted.apply("stop", 1, "op-r1", ""), try restarted.apply("start", 2, "op-r2", "")]
    const ran = again.state.executed.length
    const inherited = try restarted.apply("command", 2, "op-r2", "echo hi")
    if (!first.every((answer) => answer.ok) || inherited.ok || !("reason" in inherited) || inherited.reason !== "lease-expired" || again.state.executed.length !== ran) return false
    // A stop of a stopped machine answers at once and never touches the box.
    try restarted.apply("stop", 2, "op-r2-stop", "")
    const destroyed = again.state.destroys
    const twice = try restarted.apply("stop", 2, "op-r2-again", "")
    if (!twice.ok || twice.output !== "" || again.state.destroys !== destroyed) return false
  }
  for (const step of [...lifecycle, ...faultWalk, ...input.steps]) {
    faulted(local.faults, step.fault)
    const target = step.next ? generation + 1 : step.current ? generation : step.generation
    const executedBefore = local.state.executed.length
    const operation = `op-${step.operation % 3}`
    const argument = step.kind === "lease" ? DURATIONS[step.duration % DURATIONS.length]! : COMMANDS[step.command % COMMANDS.length]!
    const before = (storage.kv.get("machine") as { readonly generation: number } | undefined)?.generation ?? 0
    const answer = try machine.apply(step.kind, target, operation, argument)
    if (typeof answer.ok !== "boolean" || typeof answer.output !== "string") return false
    if (target < before && answer.ok) return false
    const saved = storage.kv.get("machine") as { readonly generation: number; readonly phase: string } | undefined
    if ((saved?.generation ?? 0) < before) return false
    if (step.kind === "stop" && answer.ok && local.state.running) return false
    if (step.kind === "start" && answer.ok) generation = target
    const grew = local.state.executed.length !== executedBefore
    if (step.kind !== "command" && grew) return false
    // An uncertain command never runs again: a key that reached the box stays out of it.
    const key = `${target}/${operation}`
    if (grew && reached.has(key)) return false
    if (grew) reached.add(key)
  }
  return true
})))

/**
 * The owner's walk with no machine binding, then under each box fault: start, command and stop, then a command for the
 * generation it stopped.
 */
const accountChosen: ReadonlyArray<typeof AccountInput.Type> = [{ role: "contributor", person: OWNER, prefix: true, allowed: true, binding: false, steps: [] }, ...FAULTS.map((_, at): typeof AccountInput.Type => ({
  role: "contributor" as const, person: OWNER, prefix: false, allowed: true, binding: true,
  steps: [
    { kind: "start" as const, generation: 0, current: true, operation: 0, command: 0, fault: { faulty: true, fault: at } },
    { kind: "command" as const, generation: 0, current: true, operation: 1, command: 0, fault: { faulty: true, fault: at } },
    { kind: "stop" as const, generation: 0, current: true, operation: 2, command: 0, fault: { faulty: true, fault: at } },
    { kind: "command" as const, generation: 1, current: false, operation: 3, command: 0, fault: clean },
  ],
}))]

/** Only the owner with a starting role reaches their machine, and every failure answers as a typed refusal. */
it.live("sandbox/account-gateway", () => run("sandbox/account-gateway", AccountInput, (input) => provided(effect {
  const local = try Effect.acquireRelease(sync(() => makeBox()), (made) => sync(() => made.dispose()))
  const machineStorage = try Effect.try(() => objectStorage())
  const storage = try Effect.try(() => objectStorage())
  const machine = try machineObject(local.box as unknown as MachineBox, stateOf(machineStorage, "m"))
  const identity = try Effect.provide(effect { return try SandboxIdentity }, identityFromPolicy(
    () => succeed({ owner: input.person, role: input.role }),
    () => succeed(input.role),
    { authorize: () => input.allowed ? Effect.void : fail("denied") },
  ))
  const defaults = try Effect.provide(effect { return try SandboxIdentity }, noIdentity)
  if ((try defaults.role("x")) !== "viewer") return false
  // Signed out, by default and by policy, is the ownerless viewer.
  const anonymous = try Effect.provideService(defaults.request(), HttpServerRequest.HttpServerRequest, {} as never)
  const policed = try Effect.provide(effect { return try (try SandboxPolicy).current() }, signedOut)
  if (anonymous.owner !== "" || anonymous.role !== "viewer" || policed.owner !== "" || policed.role !== "viewer") return false
  const account = try accountObject(stateOf(storage, "a"), (try Effect.try(() => namespaceOf(() => input.binding, machine))) as never, identity)
  const { gateway } = gatewayOf((try Effect.try(() => namespaceOf(() => true, account))) as never, identity)
  const admitted = input.allowed && input.person !== "" && mayStart(input.role)
  // The accounts binding unreachable: an admitted person's write is Unavailable, anyone else's is still refused.
  const unbound = gatewayOf((try Effect.try(() => namespaceOf(() => false, account))) as never, identity).gateway
  const lost = try Effect.result(Effect.provideService(unbound.startSandbox("c-1", "op-lost"), HttpServerRequest.HttpServerRequest, {} as never))
  if (lost._tag !== "Failure") return false
  if (admitted ? !(lost.failure._tag === "Unavailable" && lost.failure.reason === "sandbox-binding") : !(lost.failure._tag === "Refused" && lost.failure.refusal === "forbidden")) return false
  // And every execution, for an admitted contributor.
  const contributor = try Effect.provide(effect { return try SandboxIdentity }, identityFromPolicy(() => succeed({ owner: "person-1", role: "contributor" as const }), () => succeed("contributor" as const), { authorize: () => Effect.void }))
  const away = try Effect.result(Effect.provideService(gatewayOf((try Effect.try(() => namespaceOf(() => false, account))) as never, contributor).gateway.startSandbox("c-1", "op-away"), HttpServerRequest.HttpServerRequest, {} as never))
  if (away._tag !== "Failure" || away.failure._tag !== "Unavailable" || away.failure.reason !== "sandbox-binding") return false
  type Step = typeof AccountInput.Type["steps"][number]
  effect function act(step: Step, generation: number) {
    const operation = `op-${step.operation % 4}`
    const target = step.current ? generation : step.generation
    if (step.kind === "read") return try gateway.sandbox("c-1")
    if (step.kind === "start") return try gateway.startSandbox("c-1", operation)
    if (step.kind === "stop") return try gateway.stopSandbox("c-1", operation, target)
    return try gateway.sandboxCommand("c-1", operation, COMMANDS[step.command % COMMANDS.length]!, target)
  }
  let generation = 0
  const lifecycle = input.prefix ? [
    { kind: "start" as const, generation: 0, current: true, operation: 0, command: 0, fault: clean },
    { kind: "command" as const, generation: 0, current: true, operation: 1, command: 0, fault: clean },
    { kind: "stop" as const, generation: 0, current: true, operation: 2, command: 0, fault: clean },
  ] : []
  for (const step of [...lifecycle, ...input.steps]) {
    faulted(local.faults, step.fault)
    const outcome = try Effect.result(Effect.provideService(act(step, generation), HttpServerRequest.HttpServerRequest, {} as never))
    // With no machine binding an admitted start reaches the account, whose refusal names the missing binding.
    if (admitted && !input.binding && step.kind === "start" && !(outcome._tag === "Failure" && outcome.failure._tag === "Refused" && outcome.failure.refusal === "unavailable" && outcome.failure.reason === "container-binding")) throw new Finding({ report: `an unbound start answered ${outcome._tag === "Failure" ? outcome.failure._tag : "success"}` })
    if (outcome._tag === "Failure") {
      if (!admitted && step.kind !== "read" && !(outcome.failure._tag === "Refused" && outcome.failure.refusal === "forbidden")) return false
      continue
    }
    if (!admitted && step.kind !== "read") return false
    if (typeof outcome.success !== "string") {
      if (outcome.success.remaining < 0) return false
      generation = outcome.success.generation
    }
  }
  faulted(local.faults, clean)
  // An alarm on an ownerless object wrote a ledger owned by nobody; a later refused run must still answer, not die.
  try account.alarm()
  // An account belongs to the first person who used it, and an empty owner never acts.
  const owner = storage.kv.get("owner")
  const blank = try account.run("", "start", "c-1", "op-blank", 0, "")
  if (blank.ok || blank.refusal !== "forbidden") return false
  const foreign = try account.run("someone-else", "start", "c-1", "op-foreign", 0, "")
  return owner === undefined || (!foreign.ok && foreign.refusal === "forbidden")
}), undefined, { chosen: accountChosen }))

/** A deployment with no container image binds no objects: every sandbox request answers signed out. */
it.live("sandbox/gateway-without-image", () => run("sandbox/gateway-without-image", Schema.Boolean, () => scoped(effect {
  const context = try Layer.build(gatewayWithIdentity as unknown as Layer.Layer<SandboxGateway>).pipe(Effect.provide(ConfigProvider.layer(ConfigProvider.fromUnknown({}))))
  return Context.get(context, SandboxGateway).gateway === signedOutGateway
})))
