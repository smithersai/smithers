// The wiki draft writer, the specification reviewers and the reply's tools on the real durable engine. Faults replace
// the agent or the budget; a model bound to a refused local port walks the live path as far as the provider call.
import { it } from "@effect/vitest"
import { HostModel } from "@smthrs/model-host"
import { WikiWriter } from "../src/core/WikiWriter.vibe"
import { WikiFailure } from "../src/core/wikiSchemas.vibe"
import { SpecificationReviewers } from "../src/core/specification.vibe"
import { unansweredSpecificationReview } from "../src/core/conversation.vibe"
import { agentOf, answer as answerPost, ChatModel, Replies, REASONS, Spend, tagOf } from "../worker/Reply.vibe"
import { AgentAction, EventSink } from "@smthrs/agent"
import { HistoryTools } from "../worker/HistoryTools.vibe"
import { Tours } from "../src/core/flows.vibe"
import { WikiDraftAgent, wikiAgentLayer, wikiWriter } from "../worker/WikiDraft.vibe"
import { liveSpecificationReviewers } from "../worker/SpecificationReviewers.vibe"
import { run, Text, virtually } from "./run.vibe"
import { Unreachable } from "../worker/Unreachable.vibe"
import { ledger, within } from "../test/support/durableWriters.vibe"
import { cell, scriptedModel, type Scripted } from "./model-server.vibe"
import { AgentActions } from "../src/actions/agent.vibe"
import { Actions } from "../src/actions/Actions.vibe"
import { MockActions } from "../src/actions/MockActions.vibe"
import { MockFactory, mockFactoryFor } from "../src/core/MockFactory.vibe"
import { Factory } from "../src/core/Factory.vibe"
import { SandboxAgent } from "../worker/SandboxTools.vibe"

type HostModelService = HostModel["Service"]

/**
 * A model that fails at once: the scripted server answers a provider's non-retryable 400. These targets test the
 * writers' answers to a failed model, not the retry policy, which a refused port would wait out for seconds.
 */
const FAILING: ReadonlyArray<Scripted> = [{ kind: "status", status: 400, code: "invalid" }]
const Admission = Schema.Literals(["admit", "refuse", "fault"])
const WikiInput = Schema.Struct({ agent: Schema.Literals(["absent", "fails", "drafts", "refused-model", "no-model"]), admission: Admission, ask: Text, page: Text })
const ReviewerInput = Schema.Struct({ reviewer: Schema.Literals(["astra", "sol", "fable", "opus"]), admission: Admission, bound: Schema.Literals(["none", "refused", "broken"]), text: Text, revision: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 9 })) })

const spendFailures = effect (draft: string) => (try Metric.value(Metric.withAttributes(Metric.counter("vibelang_draft_spend_failures", { incremental: true }), { draft }))).count

/** An admitting ledger whose physical model calls the day refuses, or cannot record. */
function physicalLedger(physical: "refuse" | "fault") {
  const day = ledger("admit")
  const spend: Spend.Shape = {
    admit: effect (date, key, ceiling) => {
      if (!key.startsWith("model/")) return try day.spend.admit(date, key, ceiling)
      if (physical === "fault") throw new Unreachable({ what: "budget" })
      return false
    },
    spend: day.spend.spend,
  }
  return spend
}

/** A wiki draft whose model call the day refuses or cannot record: `budget`, never `draft`. */
effect function wikiPhysical(physical: "refuse" | "fault") {
  const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify({ page: "roadmap", text: "# Edited" }))], prompt: 3, completion: 4 }])
  const agent = wikiAgentLayer.pipe(Layer.provide(Layer.succeed(ChatModel, { model: scripted.model, unusable: "" })))
  return try within(wikiWriter.pipe(Layer.provide(agent), Layer.provide(Layer.succeed(Spend, physicalLedger(physical)))), effect {
    const result = try Effect.result((try WikiWriter).draft({ page: "roadmap", source: "# Page", ask: "Shorter." }))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  })
}

/** A review whose model call the day refuses or cannot record: `budget`, never `review`. */
effect function reviewPhysical(reviewer: "astra" | "sol" | "fable" | "opus", physical: "refuse" | "fault") {
  const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify({ verdict: "LGTM", grade: "A", review: "Fine." }))], prompt: 2, completion: 2 }])
  const values = { ...scripted.values, [`SPEC_REVIEW_${reviewer.toUpperCase()}`]: JSON.stringify(scripted.record) }
  const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, physicalLedger(physical))), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(values))))
  const spec = { revision: 1, text: "spec", astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
  return try within(layer, effect {
    const result = try Effect.result((try SpecificationReviewers).review(reviewer, spec))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  })
}

/** An admitting ledger that never takes a charge. */
function unchargeable() {
  const day = ledger("admit")
  const log = { charges: 0 }
  const spend: Spend.Shape = { admit: day.spend.admit, spend: effect () => {
    log.charges += 1
    throw new Unreachable({ what: "budget" })
  } }
  return { log, spend }
}

/** A wiki draft whose final charge never lands: retried by the engine in virtual time, then `budget`, counted once. */
effect function wikiSettlementDown(ask: string) {
  const { log, spend } = unchargeable()
  const agent = Layer.succeed(WikiDraftAgent, { available: true, run: (request) => succeed({ page: request.page, text: `${request.source}${ask}` }) })
  const before = try spendFailures("wiki")
  const outcome = try virtually(within(wikiWriter.pipe(Layer.provide(agent), Layer.provide(Layer.succeed(Spend, spend))), effect {
    const result = try Effect.result((try WikiWriter).draft({ page: "roadmap", source: "# Page", ask }))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  }), 300)
  return Option.isSome(outcome) && outcome.value === "budget" && log.charges > 1 && (try spendFailures("wiki")) - before === 1
}

/** No admission means no agent and no charge; a charge follows exactly one admitted attempt. */
it.live("wiki/writer", () => run("wiki/writer", WikiInput, (input) => scoped(effect {
  // The agent itself refuses with no model, even when asked past the writer's own check.
  const bare = try Effect.provide(WikiDraftAgent, wikiAgentLayer.pipe(Layer.provide(Layer.succeed(ChatModel, { model: undefined, unusable: "unset" }))))
  const refusal = try Effect.flip(bare.run({ page: input.page, source: "# Page", ask: input.ask }, undefined as never) as never as Effect<never, WikiFailure>)
  if (bare.available || refusal.reason !== "no-model") return false
  if (!(try wikiSettlementDown(input.ask))) return false
  if ((try wikiPhysical("refuse")) !== "budget" || (try wikiPhysical("fault")) !== "budget") return false
  const { log, spend } = ledger(input.admission)
  let agents = 0
  const agent = input.agent === "fails" || input.agent === "drafts" || input.agent === "absent" ? Layer.succeed(WikiDraftAgent, {
    available: input.agent !== "absent",
    run: effect (request) => {
      agents += 1
      if (input.agent === "fails") throw new WikiFailure({ reason: "draft" })
      return { page: request.page, text: `${request.source}${request.ask}` }
    },
  }) : wikiAgentLayer.pipe(Layer.provide(Layer.succeed(ChatModel, input.agent === "no-model" ? { model: undefined, unusable: "unset" } : { model: (try scriptedModel(FAILING)).model, unusable: "" })))
  const writer = wikiWriter.pipe(Layer.provide(agent), Layer.provide(Layer.succeed(Spend, spend)))
  const answer = try within(writer, effect {
    const result = try Effect.result((try WikiWriter).draft({ page: input.page, source: "# Page", ask: input.ask }))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  })
  const unavailable = input.agent === "absent" || input.agent === "no-model"
  if (unavailable) return answer === "no-model" && log.admitted === 0 && log.spent === 0
  if (input.admission !== "admit") return answer === "budget" && agents === 0 && log.spent === 0
  if (log.spent !== 1) return false
  return input.agent === "drafts" ? answer === "ok" : answer === "draft"
})))

/** A review whose final charge never lands: retried by the engine in virtual time, then `budget`, counted once. */
effect function reviewSettlementDown(reviewer: "astra" | "sol" | "fable" | "opus", revision: number) {
  const { log, spend } = unchargeable()
  const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify({ verdict: "LGTM", grade: "A", review: "Fine." }))], prompt: 2, completion: 2 }])
  const values = { ...scripted.values, [`SPEC_REVIEW_${reviewer.toUpperCase()}`]: JSON.stringify(scripted.record) }
  const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, spend)), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(values))))
  const spec = { revision, text: "spec", astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
  const before = try spendFailures("specification")
  const outcome = try virtually(within(layer, effect {
    const result = try Effect.result((try SpecificationReviewers).review(reviewer, spec))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  }), 300)
  return Option.isSome(outcome) && outcome.value === "budget" && log.charges > 1 && (try spendFailures("specification")) - before === 1
}

/** A reviewer whose record names a key the deployment lacks has no model: `no-model`, nothing admitted. */
effect function keylessReviewer(reviewer: "astra" | "sol" | "fable" | "opus") {
  const { log, spend } = ledger("admit")
  const scripted = try scriptedModel(FAILING)
  const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, spend)), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown({ [`SPEC_REVIEW_${reviewer.toUpperCase()}`]: JSON.stringify(scripted.record) }))))
  const spec = { revision: 1, text: "spec", astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
  const outcome = try within(layer, effect {
    const result = try Effect.result((try SpecificationReviewers).review(reviewer, spec))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  })
  return outcome === "no-model" && log.admitted === 0 && (try scripted.calls) === 0
}

/** A reviewer with no configured model and a refused budget never asks a model; reasons stay within the known set. */
it.live("specification/reviewers", () => run("specification/reviewers", ReviewerInput, (input) => scoped(effect {
  if (!(try reviewSettlementDown(input.reviewer, input.revision)) || !(try keylessReviewer(input.reviewer))) return false
  if ((try reviewPhysical(input.reviewer, "refuse")) !== "budget" || (try reviewPhysical(input.reviewer, "fault")) !== "budget") return false
  const { log, spend } = ledger(input.admission)
  const name = `SPEC_REVIEW_${input.reviewer.toUpperCase()}`
  const failing = input.bound === "refused" ? try scriptedModel(FAILING) : undefined
  const values = { ...failing?.values, ...(failing !== undefined ? { [name]: JSON.stringify(failing.record) } : input.bound === "broken" ? { [name]: "{not json" } : {}) }
  const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, spend)), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(values))))
  const spec = { revision: input.revision, text: input.text, astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
  const outcome = try Effect.exit(within(layer, effect {
    const result = try Effect.result((try SpecificationReviewers).review(input.reviewer, spec))
    return result._tag === "Success" ? "ok" : result.failure.reason as string
  }))
  // Malformed reviewer configuration stops the object at startup, a deployment error.
  if (input.bound === "broken") return true
  if (outcome._tag === "Failure") return false
  if (input.bound === "none") return outcome.value === "no-model" && log.admitted === 0
  if (input.admission !== "admit") return outcome.value === "budget" && log.spent === 0
  return outcome.value === "review" && log.spent === 1
})))

const WikiAnswer = Schema.Struct({ answer: Schema.Literals(["draft", "other-page", "blank", "not-a-draft", "no-cell", "unavailable"]), ask: Text })

/** A real model answer on a real socket: only the asked page with a non-blank text becomes a draft, and it is charged once. */
it.live("wiki/writer-answers", () => run("wiki/writer-answers", WikiAnswer, ({ answer, ask }) => scoped(effect {
  const { log, spend } = ledger("admit")
  const page = "roadmap"
  const output = answer === "other-page" ? { page: "index", text: "# X" } : answer === "blank" ? { page, text: "   " } : answer === "not-a-draft" ? { nope: 1 } : { page, text: "# Edited" }
  const script = answer === "unavailable" ? { kind: "status" as const, status: 400, code: "invalid" } : { kind: "stream" as const, pieces: [answer === "no-cell" ? "prose only" : cell(JSON.stringify(output))], prompt: 3, completion: 4 }
  const scripted = try scriptedModel([script])
  const agent = wikiAgentLayer.pipe(Layer.provide(Layer.succeed(ChatModel, { model: scripted.model, unusable: "" })))
  const writer = wikiWriter.pipe(Layer.provide(agent), Layer.provide(Layer.succeed(Spend, spend)))
  const outcome = try within(writer, effect {
    const result = try Effect.result((try WikiWriter).draft({ page, source: "# Page", ask }))
    return result._tag === "Success" ? "ok:" + result.success.text : result.failure.reason as string
  })
  if (log.spent !== 1) return false
  return answer === "draft" ? outcome === "ok:# Edited" : outcome === "draft"
})))

const ReviewAnswer = Schema.Struct({ reviewer: Schema.Literals(["astra", "sol", "fable", "opus"]), verdict: Schema.Literals(["LGTM", "Changes requested", "Maybe"]), grade: Schema.Literals(["A", "C+", "Z"]), review: Text, revision: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 9 })) })

/** Only a verdict the schema accepts becomes a review, it carries the asked revision, and it is charged once. */
it.live("specification/reviewer-answers", () => run("specification/reviewer-answers", ReviewAnswer, (input) => scoped(effect {
  const { log, spend } = ledger("admit")
  const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify({ verdict: input.verdict, grade: input.grade, review: input.review }))], prompt: 2, completion: 2 }])
  const values = { ...scripted.values, [`SPEC_REVIEW_${input.reviewer.toUpperCase()}`]: JSON.stringify(scripted.record) }
  const layer = liveSpecificationReviewers.pipe(Layer.provide(Layer.succeed(Spend, spend)), Layer.provide(ConfigProvider.layer(ConfigProvider.fromUnknown(values))))
  const spec = { revision: input.revision, text: "spec", astra: unansweredSpecificationReview(), sol: unansweredSpecificationReview(), fable: unansweredSpecificationReview(), opus: unansweredSpecificationReview() }
  const outcome = try within(layer, effect {
    const result = try Effect.result((try SpecificationReviewers).review(input.reviewer, spec))
    return result._tag === "Success" ? `ok:${result.success.revision}:${result.success.verdict}` : result.failure.reason as string
  })
  if (log.spent !== 1) return false
  const accepted = input.verdict !== "Maybe" && input.grade !== "Z"
  return accepted ? outcome === `ok:${input.revision}:${input.verdict}` : outcome === "review"
})))

const ANSWER_KINDS = ["answer", "chunked", "corrected", "empty", "blank", "prose", "refused", "credit", "rate-limited", "garbage", "bad-usage", "history-defect", "busy-once"] as const
const ReplyInput = Schema.Struct({ kind: Schema.Literals(ANSWER_KINDS), text: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(60)), start: Schema.Literals(["done", "refused"]), admission: Schema.Literals(["admit", "refuse"]), bound: Schema.Boolean })

function scriptsOf(input: typeof ReplyInput.Type): ReadonlyArray<Scripted> {
  const done = (output: string) => cell(JSON.stringify(output))
  // A first cell that shows text and then throws, so the next frame's different answer starts the visible reply over.
  if (input.kind === "corrected") return [{ kind: "stream", pieces: ["```cell\nctx.done(\"\\u0001draft\" + missing);\n```"], prompt: 3, completion: 4 }, { kind: "stream", pieces: [done(input.text)], prompt: 3, completion: 4 }]
  return [scriptOf(input, done)]
}

function scriptOf(input: typeof ReplyInput.Type, done: (output: string) => string): Scripted {
  switch (input.kind) {
    case "corrected": case "history-defect": case "busy-once": return { kind: "stream", pieces: [done(input.text)], prompt: 3, completion: 4 }
    case "answer": return { kind: "stream" as const, pieces: [done(input.text)], prompt: 3, completion: 4 }
    case "chunked": { const whole = done(input.text); const middle = Math.floor(whole.length / 2); return { kind: "stream" as const, pieces: [whole.slice(0, middle), whole.slice(middle)], prompt: 3, completion: 4 } }
    case "empty": return { kind: "stream" as const, pieces: [done("")], prompt: 3, completion: 4 }
    case "blank": return { kind: "stream" as const, pieces: [done("  ")], prompt: 3, completion: 4 }
    case "prose": return { kind: "stream" as const, pieces: ["no cell here"], prompt: 3, completion: 4 }
    case "refused": return { kind: "status" as const, status: 400, code: "content_policy" }
    case "credit": return { kind: "status" as const, status: 402, code: "out_of_credit" }
    case "rate-limited": return { kind: "status" as const, status: 400, code: "invalid" }
    case "garbage": return { kind: "garbage" as const }
    case "bad-usage": return { kind: "stream" as const, pieces: [done(input.text)], prompt: -5, completion: 4 }
  }
}

/**
 * `Reply.answer` over a real model answer: an answer the agent completed is finished with exactly that text, its visible
 * stream is a prefix of it, and everything else fails with one of the product's reasons.
 */
/** One reply over `scripts` and `spend`: what it finished or failed with, and how often it started over. */
effect function replyOver(scripts: ReadonlyArray<Scripted>, spend: Spend.Shape) {
  const log = { finished: [] as Array<string>, failed: [] as Array<string>, restarts: 0 }
  const replies: Replies.Shape = {
    start: () => succeed("done" as const),
    history: () => succeed([{ author: "person" as const, text: "question" }]),
    append: () => Effect.void,
    restart: () => sync(() => { log.restarts += 1 }),
    finish: (_reply, text) => sync(() => { log.finished.push(text); return "done" as const }),
    fail: (_reply, reason) => sync(() => { log.failed.push(reason); return "done" as const }),
  }
  const scripted = try scriptedModel(scripts)
  const services = Layer.mergeAll(
    Layer.succeed(Replies, replies), Layer.succeed(Spend, spend), Layer.succeed(ChatModel, { model: scripted.model, unusable: "" }),
    Layer.succeed(Tours, {} as Tours.Shape), Layer.succeed(HistoryTools, { history: {} as HistoryTools.Shape["history"] }),
  )
  try within(services, Effect.as(Effect.orDie(answerPost("m1")), "settled") as never)
  return log
}

it.live("reply/answers", () => run("reply/answers", ReplyInput, (input) => scoped(effect {
  // Every execution: an answer that starts over shows the second text only; a model call the day refuses, or whose
  // charge cannot be recorded, fails the reply as the budget's.
  const corrected = try replyOver(scriptsOf({ ...input, kind: "corrected" }), ledger("admit").spend)
  if (input.text.isWellFormed() && input.text.trim() !== "" && (corrected.restarts !== 1 || corrected.finished[0] !== input.text)) return false
  // Every execution: an answer with no text fails the reply as empty, never finishing it blank.
  for (const kind of ["empty", "blank"] as const) {
    const blank = try replyOver(scriptsOf({ ...input, kind }), ledger("admit").spend)
    if (blank.finished.length !== 0 || blank.failed[0] !== REASONS.empty) return false
  }
  for (const physical of ["refuse", "fault"] as const) {
    const refused = try replyOver(scriptsOf({ ...input, kind: "answer" }), physicalLedger(physical))
    if (refused.finished.length !== 0 || refused.failed[0] !== REASONS.budget) return false
  }
  const log = { finished: [] as Array<string>, failed: [] as Array<string>, appended: new Map<number, string>(), restarts: 0, starts: 0 }
  const { log: charges, spend } = ledger(input.admission)
  const replies: Replies.Shape = {
    start: () => sync(() => { log.starts += 1; return input.kind === "busy-once" && log.starts === 1 ? "busy" as const : input.start }),
    history: () => input.kind === "history-defect" ? Effect.die("history") : succeed([{ author: "person" as const, text: "question" }]),
    append: (_reply, attempt, _offset, text) => sync(() => { log.appended.set(attempt, (log.appended.get(attempt) ?? "") + text) }),
    restart: () => sync(() => { log.restarts += 1 }),
    finish: (_reply, text) => sync(() => { log.finished.push(text); return "done" as const }),
    fail: (_reply, reason) => sync(() => { log.failed.push(reason); return "done" as const }),
  }
  const scripted = try scriptedModel(scriptsOf(input))
  const services = Layer.mergeAll(
    Layer.succeed(Replies, replies), Layer.succeed(Spend, spend),
    Layer.succeed(ChatModel, input.bound ? { model: scripted.model, unusable: "" } : { model: undefined, unusable: "unset" }),
    Layer.succeed(Tours, {} as Tours.Shape), Layer.succeed(HistoryTools, { history: {} as HistoryTools.Shape["history"] }),
  )
  const exit = try Effect.exit(within(services, Effect.as(Effect.orDie(answerPost("m1")), "settled") as never))
  if (exit._tag === "Failure") return false
  if (log.starts !== (input.kind === "busy-once" ? 2 : 1)) return false
  if (input.start === "refused") return log.finished.length === 0 && log.failed.length === 0 && charges.admitted === 0
  if (log.finished.length + log.failed.length !== 1) return false
  // No model is checked before admission, so an unconfigured reply reserves nothing (c5bbf81b, 0015).
  if (!input.bound) return log.failed[0] === REASONS.unconfigured && charges.admitted === 0 && charges.spent === 0
  if (input.admission === "refuse") return log.failed[0] === REASONS.budget && charges.spent === 0
  if (input.kind === "history-defect") return log.failed[0] === REASONS.failed && charges.spent === 0
  if (charges.spent !== 1) return false
  const complete = input.kind === "answer" || input.kind === "chunked" || input.kind === "corrected" || input.kind === "busy-once"
  if (complete && input.text.trim() !== "") {
    if (log.finished[0] !== input.text) return false
    const shown = log.appended.get(1 + log.restarts) ?? ""
    return input.text.startsWith(shown)
  }
  return log.finished.length === 0 && Object.values(REASONS).includes(log.failed[0] as never)
})))

const OtherSeat = AgentAction.make("vibelang/fuzz/other-seat", { payload: {}, output: Schema.String, seat: "other", profile: "conversation", system: [], prompt: () => "", maxFrames: 1 })

/** The agent has one seat: an action asking for another fails unresolved and calls no model. */
it.live("reply/unknown-seat", () => run("reply/unknown-seat", Schema.Boolean, () => scoped(effect {
  const scripted = try scriptedModel([{ kind: "garbage" }])
  const sink: EventSink.Service = { emit: () => Effect.void }
  const outcome = try within(Layer.empty, effect {
    const exit = try Effect.exit(effect {
      provide agentOf(OtherSeat.layer, scripted.model, sink), EventSink.EventSink = sink {
        return try (try OtherSeat.requirement).action({})
      }
    })
    return exit._tag === "Success" ? "answered" : tagOf(Cause.squash(exit.cause))
  } as never)
  return outcome.endsWith("SeatUnresolved") && (try scripted.calls) === 0
})))

const ActionsInput = Schema.Struct({ start: Schema.Boolean, text: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(60)) })

/** Answer services for one post; the agent's only tools are the ones under test. */
function replyServices(model: HostModelService, log: { finished: Array<string>; failed: Array<string> }) {
  const replies: Replies.Shape = {
    start: () => succeed("done" as const),
    history: () => succeed([{ author: "person" as const, text: "question" }]),
    append: () => Effect.void,
    restart: () => Effect.void,
    finish: (_reply, text) => sync(() => { log.finished.push(text); return "done" as const }),
    fail: (_reply, reason) => sync(() => { log.failed.push(reason); return "done" as const }),
  }
  return Layer.mergeAll(
    Layer.succeed(Replies, replies), Layer.succeed(Spend, ledger("admit").spend),
    Layer.succeed(ChatModel, { model, unusable: "" }),
    Layer.succeed(Tours, {} as Tours.Shape), Layer.succeed(HistoryTools, { history: {} as HistoryTools.Shape["history"] }),
  )
}

/**
 * With the product's actions bound, the agent lists them and may start one: the answer reports the registered list,
 * and a started run is announced exactly once with the id the agent got back.
 */
it.live("reply/actions-bound", () => run("reply/actions-bound", ActionsInput, (input) => scoped(effect {
  const log = { finished: [] as Array<string>, failed: [] as Array<string> }
  const announced: Array<string> = []
  const actions = Context.get(try Layer.build(MockActions({ role: "contributor", actor: "agent" }).pipe(Layer.provide(MockFactory))), Actions)
  const start = input.start ? `var started = await ctx.call("vibelang/actions/Start", { flow: "vibelang/Post", input: { text: ${JSON.stringify(input.text)} } });\n` : "var started = null;\n"
  const code = "```cell\nvar listed = await ctx.call(\"vibelang/actions/List\", {});\n" + start + "ctx.done(JSON.stringify({ listed: listed, started: started }));\n```"
  const scripted = try scriptedModel([{ kind: "stream", pieces: [code], prompt: 3, completion: 4 }])
  const services = Layer.mergeAll(replyServices(scripted.model, log), Layer.succeed(AgentActions, { actions, announce: (run) => sync(() => { announced.push(run.id) }) }))
  const exit = try Effect.exit(within(services, Effect.as(Effect.orDie(answerPost("m1")), "settled") as never))
  if (exit._tag === "Failure") return false
  // A cell call is keyed by a digest of its input; ill-formed UTF-16 has no UTF-8 bytes, so the run fails with the product reason.
  if (input.start && !input.text.isWellFormed()) return log.finished.length === 0 && log.failed[0] === REASONS.failed && announced.length === 0
  if (log.finished.length !== 1 || log.failed.length !== 0) return false
  const answer = log.finished[0]!
  if (!answer.includes("vibelang/Post")) return false
  if (!input.start) return announced.length === 0
  return announced.length === 1 && answer.includes(announced[0]!)
})))

const SandboxInput = Schema.Struct({ agent: Schema.Literals(["closed", "viewer", "contributor"]), command: Schema.Literals(["echo hi", "pwd", "ls"]) })

/**
 * The reply's sandbox tools: with no resolved identity they are closed and every call is refused `forbidden`; with
 * one, each call reaches the Factory once for the reply's own conversation, under a distinct operation id (the same
 * command twice is two operations), and only a contributor's start runs a machine.
 */
effect function sandboxReply(input: typeof SandboxInput.Type) {
  const log = { finished: [] as Array<string>, failed: [] as Array<string> }
  const calls: Array<{ readonly conversation: string; readonly operation: string }> = []
  const record = (conversation: string, operation: string) => sync(() => { calls.push({ conversation, operation }) })
  // A tool answers its value, or { ok: false, error } when refused; a refused start leaves generation 1 to try.
  const code = "```cell\nvar out = {};\n"
    + "out.start = await ctx.call(\"vibelang/sandbox/start\", {});\n"
    + "var generation = out.start.ok === false ? 1 : out.start.generation;\n"
    + `out.command = await ctx.call("vibelang/sandbox/command", { generation: generation, command: ${JSON.stringify(input.command)} });\n`
    + `out.again = await ctx.call("vibelang/sandbox/command", { generation: generation, command: ${JSON.stringify(input.command)} });\n`
    + "out.stop = await ctx.call(\"vibelang/sandbox/stop\", { generation: generation });\n"
    + "ctx.done(JSON.stringify(out));\n```"
  const scripted = try scriptedModel([{ kind: "stream", pieces: [code], prompt: 3, completion: 4 }])
  let layer = replyServices(scripted.model, log)
  if (input.agent !== "closed") {
    const factory = Context.get(try Layer.build(mockFactoryFor(input.agent)), Factory)
    const tools: SandboxAgent.Shape["factory"] = {
      startSandbox: (conversation, operation) => Effect.andThen(record(conversation, operation), factory.startSandbox(conversation, operation)),
      stopSandbox: (conversation, operation, generation) => Effect.andThen(record(conversation, operation), factory.stopSandbox(conversation, operation, generation)),
      sandboxCommand: (conversation, operation, command, generation) => Effect.andThen(record(conversation, operation), factory.sandboxCommand(conversation, operation, command, generation)),
    }
    layer = Layer.mergeAll(layer, Layer.succeed(SandboxAgent, { factory: tools, conversation: "fuzz-room" }))
  }
  const exit = try Effect.exit(within(layer, Effect.as(Effect.orDie(answerPost("m1")), "settled") as never))
  if (exit._tag === "Failure" || log.finished.length !== 1 || log.failed.length !== 0) return false
  type Answer = { readonly ok?: unknown; readonly error?: { readonly message?: unknown }; readonly generation?: unknown; readonly status?: unknown }
  const out = try Effect.try(() => JSON.parse(log.finished[0]!) as { readonly start: Answer; readonly command: Answer | string; readonly again: Answer | string; readonly stop: Answer })
  const refused = (answer: Answer | string) => typeof answer === "object" && answer.ok === false && String(answer.error?.message).endsWith("failed: forbidden")
  if (input.agent === "closed") return calls.length === 0 && refused(out.start) && refused(out.command) && refused(out.again) && refused(out.stop)
  // The same command twice in one cell is two operations.
  if (calls.length !== 4 || calls.some((call) => call.conversation !== "fuzz-room" || !/^agent\/[0-9a-f]+$/.test(call.operation))) return false
  if (new Set(calls.map((call) => call.operation)).size !== 4) return false
  if (input.agent === "viewer") return refused(out.start) && refused(out.command) && refused(out.again) && refused(out.stop)
  return typeof out.start.generation === "number" && out.start.status === "running" && typeof out.command === "string" && typeof out.again === "string" && out.stop.generation === out.start.generation && out.stop.status === "stopped"
}

it.live("reply/sandbox-tools", () => run("reply/sandbox-tools", SandboxInput, (input) => scoped(effect {
  for (const agent of ["closed", "viewer", "contributor"] as const) if (!(try sandboxReply({ ...input, agent }))) return false
  return true
})))

/**
 * A model call the runtime interrupts is the engine's, never a failed reply: the reply is neither finished nor failed,
 * and the answer's interruption reaches the flow.
 */
it.live("reply/interrupted", () => run("reply/interrupted", Schema.Literals(["at-once", "after-text"]), (when) => scoped(effect {
  const log = { finished: [] as Array<string>, failed: [] as Array<string> }
  const scripted = try scriptedModel([{ kind: "garbage" }])
  const interrupting: HostModelService = { ...scripted.model, model: { stream: () => when === "at-once" ? Stream.fromEffect(Effect.interrupt) : Stream.concat(Stream.make({ type: "text-delta", id: "fuzz", text: "par" } as never), Stream.fromEffect(Effect.interrupt)) } }
  const exit = try Effect.exit(within(replyServices(interrupting, log), Effect.as(Effect.orDie(answerPost("m1")), "settled") as never))
  const interrupted = exit._tag === "Failure" ? Cause.hasInterrupts(exit.cause) : exit.value !== "settled"
  return interrupted && log.finished.length === 0 && log.failed.length === 0
})))
