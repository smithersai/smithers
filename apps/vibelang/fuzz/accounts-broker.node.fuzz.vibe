// The Accounts object's brokered sign-in, Connect GitHub, device and role routes (worker/Accounts.vibe) with the real
// smithers.sh broker (VL-33) in the same process: the browser keeps one cookie jar per origin and follows each
// redirect, and the site reaches the broker through an injected HttpClient that serves the broker's routes. GitHub is
// the injected token service (one person per numeric code) and the credential custodian is an injected service that
// may fail. Nothing intercepts a request.
import { it } from "@effect/vitest"
import * as NodeCrypto from "@effect/platform-node/NodeCrypto"
import { HttpClient, HttpClientRequest, HttpClientResponse, HttpServerRequest, HttpServerResponse } from "effect/http"
import { FlowEngine } from "@smthrs/engine"
import { Flow, FlowRuntime } from "@smthrs/flow"
import { Core, GitHub } from "@smthrs/integrations"
import { Node } from "@smthrs/plan"
import * as Accounts from "../worker/Accounts.vibe"
import { wikiRepository } from "../worker/Wiki.vibe"
import { may, type Role } from "../src/core/conversation.vibe"
import type { Storage } from "../worker/Objects.vibe"
import { objectStorage } from "../test/support/objectStorage.ts"
import { run, stepped, Int, STEERED_FLOOR } from "./run.vibe"
import { delegated as smithersConnection, reach } from "./delegated.vibe"

const SITE = "https://factory.example"
const BROKER = "https://broker.example"
const SECRET = Redacted.make("fixture-only-broker-site-secret-32-chars")
const KEY = Redacted.make("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=")
const STATE = "__Host-vibelang-sign-in"

const Op = Schema.Struct({
  kind: Schema.Literals(["sign-in", "connect", "disconnect", "device", "session", "members", "grant", "events", "sign-out", "install", "handoff", "unknown", "foreign", "issues", "wiki", "draft-wiki", "participation", "roles-large", "expire", "abandon", "device-id", "elsewhere", "refusals", "stall", "lost", "reads", "queued", "propose", "revoke", "file"]),
  person: Schema.Literals(["1", "2", "7", "0"]),
  tamper: Schema.Literals(["none", "none", "state", "cookie", "code", "replay", "null-same", "null-cross", "foreign-origin", "expired", "corrupt", "huge"]),
  query: Schema.Literals(["", "?wiki-page=index", "?wiki-page=../x", "?resume-op=new&resume-key=k1", "?resume-op=new", "?resume-op=bad&resume-key=k1", "?resume-op=new&resume-key=k1&resume-recovery=r1", "?resume-recovery=r1", "?resume-op=new&resume-key=k1&resume-recovery=bad%20key"]),
  answer: Schema.Literals(["connect", "cancel"]),
  install: Schema.Boolean,
  role: Schema.Literals(["new", "community", "contributor", "maintainer", "owner"]),
  body: Schema.Literals(["valid", "malformed", "large", "empty"]),
  n: Int,
})
const Input = Schema.Struct({ walk: Schema.Boolean, slug: Schema.Boolean, brokered: Schema.Boolean, named: Schema.Boolean, ops: Schema.Array(Op).check(Schema.isMaxLength(12)) })
type Op = typeof Op.Type

/** GitHub with one person per numeric code; code 0 has no account. */
const github: GitHub.Auth.GitHubAuth["Service"] = {
  authorizeUrl: ({ state, redirectUri }) => `https://github.test/login?state=${state}&redirect_uri=${encodeURIComponent(redirectUri)}`,
  exchange: ({ code }) => succeed({ accessToken: Redacted.make(Redacted.value(code)), expiresAt: null, refreshToken: null }),
  refresh: () => fail(new GitHub.Auth.GitHubRefused({ step: "refresh", reason: "rejected" })),
  user: (token) => /^[1-9][0-9]*$/.test(Redacted.value(token)) ? succeed({ id: Number(Redacted.value(token)), login: `p${Redacted.value(token)}` }) : fail(new GitHub.Auth.GitHubRefused({ step: "user", reason: "rejected" })),
  permission: () => succeed("read"),
  revoke: () => Effect.void,
  deviceCode: () => fail(new GitHub.Auth.GitHubRefused({ step: "device", reason: "unavailable" })),
  deviceToken: () => fail(new GitHub.Auth.GitHubRefused({ step: "device", reason: "unavailable" })),
}

const BrokerStep = Flow.make("fuzz/AccountsBroker", { payload: {}, success: Schema.Null, body: () => Node.succeed(null) })
/** One broker step in a real engine, as the production host runs it. */
const inFlow = <R>(body: string!GitHub.Auth.Broker.BrokerRefused!R) => scoped(effect {
  const runtime = try FlowRuntime.FlowRuntime
  const outcome = try Ref.make<Exit.Exit<string, GitHub.Auth.Broker.BrokerRefused>>(Exit.succeed(""))
  try runtime.register(BrokerStep, () => effect { try Ref.set(outcome, try exit(body as string!GitHub.Auth.Broker.BrokerRefused)); return null })
  try Effect.orDie(runtime.execute(BrokerStep, { executionId: try Effect.orDie(Core.Pkce.createCodeVerifier()), payload: {} }))
  return try (try Ref.get(outcome))
}).pipe(Effect.provide(Layer.mergeAll(FlowEngine.layerMemory, NodeCrypto.layer)))

interface Answer { readonly status: number; readonly location: string; readonly text: string; readonly cookies: ReadonlyArray<string> }
type Jar = Map<string, string>

/** The world's GitHub when person 7's delegation is smithers.sh's real one: down, so no write lands. */
const githubDown = HttpClient.make((request) => succeed(HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.empty({ status: 503 })))))

/**
 * `real`: person 7's Connect installs smithers.sh's real delegation (fuzz/delegated.vibe), the site's delegate calls
 * smithers.sh's real route, and `revoke` ends that delegation there. Otherwise the custodian hands out `d-<person>`.
 */
effect function world(slug: boolean, brokered: boolean, named: boolean, legacy = false, real = false) {
  const smithers = real ? try smithersConnection(githubDown, reach(), "p7", { api: wikiRepository.api, repository: `${wikiRepository.owner}/${wikiRepository.name}`, repositoryId: 1, token: Redacted.make("fixture-token") }) : undefined
  const storage = try Effect.try(() => objectStorage())
  // An object that held tokens from the per-site connect path (0165 migration) before this version started.
  if (legacy) try promise(() => storage.put({ "github/1": { token: "sealed" }, "github/7": { token: "sealed" } }))
  // The object's storage lost: every read and write rejects until it heals.
  const healthy = { get: storage.get, put: storage.put, delete: storage.delete, list: storage.list }
  const rejected = () => Promise.reject(new Error("storage lost"))
  const setLost = (lost: boolean) => { Object.assign(storage, lost ? { get: rejected, put: rejected, delete: rejected, list: rejected } : healthy) }
  // The object's SQL database lost: SQLite refuses every statement (a table that does not exist) until it heals.
  const sql = storage.sql
  const setSqlLost = (lost: boolean) => { Object.assign(storage, { sql: lost ? { exec: () => sql.exec("SELECT lost FROM vibelang_database_lost") } : sql }) }
  const keys = try Core.CookieKeys.make({ primary: Redacted.make("fixture-only-broker-cookie-key-32-chars") }, "primary")
  let custodian = true
  const issued = (person: number) => smithers !== undefined && person === smithers.connection.person ? smithers.connection.delegation : `d-${person}`
  const broker = try GitHub.Auth.Broker.make({
    origin: BROKER, keys, github, store: try GitHub.Auth.Broker.memoryStore(), sites: [{ origin: SITE, secret: SECRET }], encryptionKey: KEY,
    connections: { install: (input) => custodian ? succeed({ delegation: issued(input.person), expires: Date.now() + 3_600_000 }) : fail(new GitHub.Auth.Broker.BrokerRefused()) },
  })
  const durable = { ...broker, callback: (...args: Parameters<typeof broker.callback>) => inFlow(broker.callback(...args)), consent: (...args: Parameters<typeof broker.consent>) => inFlow(broker.consent(...args)) }
  const serveBroker = GitHub.Auth.Broker.serve(durable, BROKER)
  // The site's own HttpClient: smithers.sh's routes, served in process; anything else is unreachable.
  const client = HttpClient.make((request, url) => effect {
    if (smithers !== undefined && url.origin !== BROKER) return try smithers.http.execute(request)
    const response = try Effect.provideService(serveBroker, HttpServerRequest.HttpServerRequest, HttpServerRequest.fromClientRequest(request))
    return HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(response))
  })
  const accounts = try Effect.provideService(Accounts.make("accounts-broker-fuzz", storage as unknown as Storage, {
    origin: SITE, initialMaintainer: "1", clientId: "fixture-client-id", github, signingSecret: Redacted.make("fixture-only-signing-secret-32-chars"),
    encryptionKey: KEY, ...(smithers === undefined ? {} : { delegate: smithers.delegate }), ...(brokered ? { broker: { origin: BROKER, secret: SECRET } } : named ? { broker: { origin: BROKER } } : {}), ...(slug ? { appSlug: "vibelang fixture" } : {}),
  }), HttpClient.HttpClient, client)
  const jars = new Map<string, Jar>([[SITE, new Map()], [BROKER, new Map()]])
  /** One browser request: the origin's cookies, then the response's Set-Cookie into that jar. */
  effect function ask(url: string, options: { readonly method?: "GET" | "POST"; readonly origin?: string; readonly site?: string; readonly body?: string; readonly cookies?: Jar; readonly stream?: boolean; readonly form?: boolean; readonly url?: string; readonly chunks?: ReadonlyArray<string> | "stall" } = {}) {
    const target = new URL(url).origin
    const jar = options.cookies ?? jars.get(target) ?? new Map()
    let request = HttpClientRequest.make(options.method ?? "GET")(url)
    if (options.origin !== undefined) request = HttpClientRequest.setHeader(request, "origin", options.origin)
    if (options.site !== undefined) request = HttpClientRequest.setHeader(request, "sec-fetch-site", options.site)
    if (jar.size > 0) request = HttpClientRequest.setHeader(request, "cookie", [...jar].map(([name, value]) => `${name}=${value}`).join("; "))
    if (options.body !== undefined) request = HttpClientRequest.bodyText(request, options.body, options.form === true ? "application/x-www-form-urlencoded" : "application/json")
    // A body with no length header: its chunks, or a stream that never ends.
    if (options.chunks !== undefined) request = HttpClientRequest.bodyStream(request, options.chunks === "stall" ? Stream.never : Stream.fromIterable(options.chunks).pipe(Stream.encodeText), { contentType: "application/json" })
    const parsed = HttpServerRequest.fromWeb(try HttpClientRequest.toWeb(request))
    // A platform that hands the object an absolute URL for another host.
    const server = options.url === undefined ? parsed : parsed.modify({ url: options.url })
    const response = target === BROKER ? try Effect.provideService(serveBroker, HttpServerRequest.HttpServerRequest, server)
      : try Effect.provideService(accounts.fetch, HttpServerRequest.HttpServerRequest, server)
    const answer = HttpServerResponse.toWeb(response)
    const cookies = answer.headers.getSetCookie()
    if (options.cookies === undefined) for (const cookie of cookies) {
      const pair = cookie.split(";")[0]!
      const at = pair.indexOf("=")
      if (pair.slice(at + 1) === "") jar.delete(pair.slice(0, at))
      else jar.set(pair.slice(0, at), pair.slice(at + 1))
    }
    // An event stream never ends; its body is not read.
    const text = options.stream !== true && (response.status === 200 || response.status >= 400) ? try promise(() => answer.text()) : ""
    return { status: response.status, location: answer.headers.get("location") ?? "", text, cookies } satisfies Answer
  }
  const revoke = smithers === undefined ? Effect.void : smithers.end()
  return { storage, accounts, ask, jars, setLost, setSqlLost, setCustodian: (healthy: boolean) => { custodian = healthy }, issued, revoke }
}
type World = Effect.Success<ReturnType<typeof world>>
const kvOf = (w: World) => (w.storage as unknown as { readonly kv: ReadonlyMap<string, unknown> }).kv

/** Where the last trip stopped, for a refuted check. */
let tripStage = 0

/** The browser's trip from the site through the broker and GitHub to the handoff fragment the page posts back. */
effect function trip(w: World, start: Answer, code: string, answer: "connect" | "cancel") {
  if (!start.location.startsWith(BROKER)) { tripStage = 1; return undefined }
  const atBroker = try w.ask(start.location)
  const authorize = new URL(atBroker.location)
  if (authorize.origin !== "https://github.test") { tripStage = 2; return undefined }
  const back = try w.ask(`${authorize.searchParams.get("redirect_uri") ?? ""}?state=${authorize.searchParams.get("state") ?? ""}&code=${code}`)
  let location = back.location
  if (location.startsWith(BROKER + GitHub.Auth.Broker.CONSENT)) {
    const consent = new URL(location).searchParams.get("consent") ?? ""
    const page = try w.ask(location)
    if (page.status !== 200) { tripStage = 3; return undefined }
    const answered = try w.ask(BROKER + GitHub.Auth.Broker.CONSENT, { method: "POST", origin: BROKER, site: "same-origin", body: new URLSearchParams({ consent, answer }).toString(), form: true })
    location = answered.location
    // A cancelled consent returns the browser to the site's front page with nothing to hand back.
    if (answer === "cancel" && answered.status === 303 && location === SITE + "/") return "cancelled" as const
  }
  if (!location.startsWith(SITE + Accounts.CALLBACK + "#")) { tripStage = 4; return undefined }
  const fragment = new URLSearchParams(new URL(location).hash.slice(1))
  return { code: fragment.get("code") ?? "", state: fragment.get("state") ?? "" }
}

/** What the site says the browser is. */
effect function who(w: World) {
  const answer = try w.ask(SITE + "/api/auth/session")
  return (try parsed(answer.text)) as { readonly id: string; readonly agent?: boolean; readonly available?: boolean }
}
effect function parsed(text: string) {
  return try Effect.orDie(Effect.try(() => JSON.parse(text) as unknown))
}

error Refuted {
  kind: string
  check: number
  get message() { return `${this.kind} check ${this.check}` }
}

const ALLOWED = new Set([200, 204, 302, 303, 400, 401, 403, 404, 405, 408, 413, 503])

/** A sign-in signs in exactly the person GitHub named, once; a tampered handoff never does; Connect needs a person's
 * own session and stores a delegation only after consent; a device session stays an agent; nothing answers 500. */
it.live("accounts/broker-sequences", () => run("accounts/broker-sequences", Input, (input) => scoped(effect {
  // Every execution walks the brokered world and GitHub's own OAuth, so neither depends on the draw (one execution
  // takes seconds, so a drawn walk might never run at a short budget); drawn ops then run in the drawn world.
  if (!(try play(input, true, false, true))) return false
  if (!(try play(input, false, false, true))) return false
  if (!(try play(input, false, true, true))) return false
  // Lost storage as a fresh brokered world's first step, with no session cookie (0015).
  if (!(try play({ ...input, ops: [{ kind: "lost", person: "1", tamper: "none", query: "", answer: "connect", install: true, role: "new", body: "valid", n: 0 }] }, true, false, false))) return false
  // smithers.sh's real delegation, ended there: the site still holds its copy, so the proposal reaches smithers.sh,
  // which no longer honors it; the proposal asks to connect and the site forgets the copy (checks 260 and 261).
  // Connected again with that same ended delegation, a new issue is answered the same way (checks 271 and 272).
  const as = (kind: Op["kind"], person: Op["person"], role: Op["role"] = "community", n = 0): Op => ({ kind, person, tamper: "none", query: "", answer: "connect", install: true, role, body: "valid", n })
  const ended = [as("sign-in", "1"), as("grant", "1", "contributor", 6), as("sign-out", "1"), as("sign-in", "7"), as("connect", "7"), as("revoke", "7"), as("propose", "7", "community", 2), as("connect", "7"), as("file", "7", "community", 3)]
  if (!(try play({ ...input, ops: ended }, true, false, false, true))) return false
  return try play(input, input.brokered, !input.brokered && input.named, false)
  // One execution walks three worlds: about 20 s on nyc-01 and over a minute on a 4-vCPU box, after the 30 s floor.
}), undefined, { minimum: STEERED_FLOOR }), 300_000)

effect function play(input: typeof Input.Type, brokered: boolean, named: boolean, walking: boolean, real = false) {
  const w = try world(input.slug, brokered, named, walking, real)
  // The migration deletes every per-site token once, before the object answers anything.
  if (walking && (kvOf(w).has("github/1") || kvOf(w).has("github/7") || kvOf(w).get("migrated/connect-v1") !== true)) throw new Refuted({ kind: "migration", check: 1 })
  const base: Op = { kind: "session", person: "7", tamper: "none", query: "", answer: "connect", install: true, role: "community", body: "valid", n: 0 }
  const namedWalk: ReadonlyArray<Op> = [{ ...base, kind: "sign-in" }, { ...base, kind: "abandon" }, { ...base, kind: "refusals" }, { ...base, kind: "lost" }]
  const walk: ReadonlyArray<Op> = walking && named ? namedWalk : walking ? [
    { ...base, kind: "sign-in" }, { ...base, kind: "connect" }, { ...base, kind: "queued" }, { ...base, kind: "disconnect" }, { ...base, kind: "reads" },
    { ...base, kind: "connect", answer: "cancel" },
    { ...base, kind: "connect", install: false }, { ...base, kind: "connect", query: "?resume-op=new&resume-key=k1&resume-recovery=r1" },
    { ...base, kind: "sign-in", tamper: "code" }, { ...base, kind: "sign-in", tamper: "replay" }, { ...base, kind: "sign-in", tamper: "expired" },
    { ...base, kind: "device" }, { ...base, kind: "connect" }, { ...base, kind: "device", body: "malformed" }, { ...base, kind: "device", person: "0" },
    { ...base, kind: "grant" }, { ...base, kind: "members" }, { ...base, kind: "events" }, { ...base, kind: "install" }, { ...base, kind: "handoff" },
    { ...base, kind: "sign-out" }, { ...base, kind: "disconnect" }, { ...base, kind: "connect" }, { ...base, kind: "propose" }, { ...base, kind: "sign-in", person: "1", tamper: "null-same" }, { ...base, kind: "propose" },
    { ...base, kind: "grant", role: "maintainer", n: 2 }, { ...base, kind: "members" }, { ...base, kind: "foreign" },
    { ...base, kind: "draft-wiki" }, { ...base, kind: "draft-wiki", person: "1" }, { ...base, kind: "participation" }, { ...base, kind: "roles-large" },
    { ...base, kind: "sign-out" }, { ...base, kind: "issues" }, { ...base, kind: "wiki" }, { ...base, kind: "roles-large" }, { ...base, kind: "participation" },
    { ...base, kind: "device-id" }, { ...base, kind: "elsewhere" }, { ...base, kind: "abandon" }, { ...base, kind: "sign-in" }, { ...base, kind: "expire" },
    { ...base, kind: "sign-in" }, { ...base, kind: "expire", n: 1 },
    // Refusals a draw reaches only by chance (0015): bodies a route cannot take, a corrupt sign-in row, an id GitHub
    // cannot have, each query Connect refuses, a handoff without the session that pressed Connect, and issue and wiki
    // writes by a person and by their agent.
    { ...base, kind: "lost" }, { ...base, kind: "refusals" }, { ...base, kind: "stall" }, { ...base, kind: "sign-in", tamper: "corrupt" }, { ...base, kind: "sign-in", tamper: "huge" },
    { ...base, kind: "sign-in" }, { ...base, kind: "refusals" }, { ...base, kind: "stall" },
    ...(["?wiki-page=../x", "?resume-op=new", "?resume-recovery=r1", "?resume-op=bad&resume-key=k1", "?resume-op=new&resume-key=k1&resume-recovery=bad%20key", "?wiki-page=index"] as const).map((query) => ({ ...base, kind: "connect" as const, query })),
    { ...base, kind: "disconnect" }, { ...base, kind: "connect", tamper: "cookie" },
    // Writes only: a read goes on to an unreachable GitHub and waits out its flow's deadline (6 to 13 s each).
    { ...base, kind: "issues" }, { ...base, kind: "wiki" },
    { ...base, kind: "device" }, { ...base, kind: "issues" }, { ...base, kind: "wiki" },
  ] : []
  // The model: whose session the browser holds, and whether it is the person's agent.
  let signedIn: { readonly id: string; readonly agent: boolean } | undefined
  // Whether smithers.sh ended the delegation it issued (a `real` world only).
  let revoked = false
  // A refuted check fails naming its step kind and check, never a value.
  const refute = effect (kind: string, check: number) => {
    throw new Refuted({ kind, check })
    return false
  }
  for (const op of walking ? walk : input.ops) {
    w.setCustodian(op.install)
    const statuses: Array<number> = []
    const seen = effect (answer: Answer) => { statuses.push(answer.status); return answer }
    switch (op.kind) {
      case "sign-in": {
        const start = try seen(try w.ask(SITE + "/api/auth/sign-in"))
        if (named) { if (start.status !== 503) return try refute(op.kind, 4); break }
        if (!brokered) {
          // GitHub's own OAuth: the site keeps the PKCE verifier and GitHub returns the code to its callback.
          const authorize = new URL(start.location)
          if (start.status !== 302 || authorize.origin !== "https://github.test") return try refute(op.kind, 1)
          const state = op.tamper === "state" ? "y".repeat(43) : authorize.searchParams.get("state") ?? ""
          const jar = w.jars.get(SITE)!
          const cookies = op.tamper === "cookie" ? new Map([...jar, [STATE, (jar.get(STATE) ?? "") + "0"]]) : undefined
          if (op.tamper === "expired" || op.tamper === "corrupt") {
            const key = `sign-in/${state}`
            const record = (try promise(() => w.storage.get(key))) as Record<string, unknown> | undefined
            if (record !== undefined) try promise(() => w.storage.put(key, op.tamper === "corrupt" ? { broken: true } : { ...record, expires: 1 }))
          }
          // GitHub names no person with an id past 2^53 - 1.
          const code = op.tamper === "code" ? "x".repeat(5000) : op.tamper === "huge" ? "9".repeat(20) : op.person
          const back = try seen(try w.ask(`${SITE}${Accounts.CALLBACK}?state=${state}&code=${code}`, cookies === undefined ? {} : { cookies }))
          const replayed = op.tamper === "replay" ? try seen(try w.ask(`${SITE}${Accounts.CALLBACK}?state=${state}&code=${op.person}`)) : undefined
          const honest = !["state", "cookie", "code", "expired", "corrupt", "huge"].includes(op.tamper) && op.person !== "0"
          if (honest) {
            if (back.status !== 302 || back.location !== SITE + "/" || (replayed !== undefined && replayed.status !== 400)) return try refute(op.kind, 2)
            signedIn = { id: op.person, agent: false }
          } else if (back.location === SITE + "/") return try refute(op.kind, 3)
          break
        }
        if (start.status !== 302) return try refute(op.kind, 21)
        const handed = try trip(w, start, op.person, op.answer)
        // GitHub has no account for code 0, so the broker never hands the browser back.
        if (handed === undefined || handed === "cancelled") { if (op.person !== "0") return try refute(op.kind, 2400 + tripStage); break }
        if (op.tamper === "expired" || op.tamper === "corrupt") {
          const key = `broker/${handed.state}`
          const record = (try promise(() => w.storage.get(key))) as { readonly claims: Record<string, unknown> } | undefined
          if (record !== undefined) try promise(() => w.storage.put(key, op.tamper === "corrupt" ? { broken: true } : { ...record, claims: { ...record.claims, expires: 1 } }))
        }
        const body = JSON.stringify({ code: op.tamper === "code" ? "z".repeat(43) : handed.code, state: op.tamper === "state" ? "y".repeat(43) : handed.state })
        const jar = w.jars.get(SITE)!
        const cookies = op.tamper === "cookie" ? new Map([...jar, [STATE, (jar.get(STATE) ?? "") + "0"]]) : undefined
        const origin = op.tamper === "null-same" || op.tamper === "null-cross" ? "null" : op.tamper === "foreign-origin" ? "https://evil.example" : SITE
        const site = op.tamper === "null-same" ? "same-origin" : op.tamper === "null-cross" ? "cross-site" : undefined
        const accepted = try seen(try w.ask(SITE + Accounts.CALLBACK, { method: "POST", origin, ...(site === undefined ? {} : { site }), body, ...(cookies === undefined ? {} : { cookies }) }))
        const replayed = op.tamper === "replay" ? try seen(try w.ask(SITE + Accounts.CALLBACK, { method: "POST", origin: SITE, body })) : undefined
        const honest = op.tamper === "none" || op.tamper === "replay" || op.tamper === "null-same" || op.tamper === "huge"
        const person = op.person !== "0"
        if (honest && person) {
          if (accepted.status !== 200 || (replayed !== undefined && replayed.status !== 400)) return try refute(op.kind, 40)
          signedIn = { id: op.person, agent: false }
        } else if (accepted.status === 200) return try refute(op.kind, 42)
        break
      }
      case "connect": {
        const press = try seen(try w.ask(SITE + "/api/auth/connect" + op.query, { method: "POST", origin: SITE }))
        const valid = !["?wiki-page=../x", "?resume-op=new", "?resume-op=bad&resume-key=k1", "?resume-recovery=r1", "?resume-op=new&resume-key=k1&resume-recovery=bad%20key"].includes(op.query)
        if (signedIn === undefined) { if (press.status !== 401) return try refute(op.kind, 48); break }
        if (signedIn.agent) { if (press.status !== 403) return try refute(op.kind, 49); break }
        if (valid && !brokered) { if (press.status !== 503) return try refute(op.kind, 49); break }
        if (!valid) { if (press.status !== 400) return try refute(op.kind, 50); break }
        if (press.status !== 303) return try refute(op.kind, 51)
        const handed = try trip(w, press, signedIn.id, op.answer)
        // A custodian that fails refuses the consent at the broker, which keeps the browser there.
        if (handed === undefined) { if (op.answer === "connect" && !op.install) break; return try refute(op.kind, 5400 + tripStage) }
        if (handed === "cancelled") { if (op.answer !== "cancel") return try refute(op.kind, 55); break }
        // The browser no longer presents the session that pressed Connect: the handoff is refused and stores nothing.
        const unsigned = op.tamper === "cookie" ? new Map([...w.jars.get(SITE)!].filter(([name]) => name !== Accounts.SESSION)) : undefined
        const before = JSON.stringify((try promise(() => w.storage.get(`delegation/${signedIn!.id}`))) ?? null)
        const accepted = try seen(try w.ask(SITE + Accounts.CALLBACK, { method: "POST", origin: SITE, body: JSON.stringify(handed), ...(unsigned === undefined ? {} : { cookies: unsigned }) }))
        const stored = (try promise(() => w.storage.get(`delegation/${signedIn!.id}`))) as { readonly delegation?: string } | undefined
        if (unsigned !== undefined) { if (accepted.status !== 403 || JSON.stringify(stored ?? null) !== before) return try refute(op.kind, 57); break }
        // Consent with a working custodian is the only way here, and it installs a delegation for the same person.
        const delegated = op.answer === "connect" && op.install
        if (!delegated || accepted.status !== 200 || stored?.delegation !== w.issued(Number(signedIn.id))) return try refute(op.kind, 59)
        if (delegated) {
          const location = ((try parsed(accepted.text)) as { readonly location?: string }).location ?? ""
          const expected = op.query === "?wiki-page=index" ? "/wiki/index" : op.query.startsWith("?resume-op") ? "/?issues=1&" + op.query.slice(1) : "/?issues=1"
          if (location !== expected) return try refute(op.kind, 63)
        }
        break
      }
      case "disconnect": {
        const answer = try seen(try w.ask(SITE + "/api/auth/disconnect", { method: "POST", origin: SITE }))
        if (signedIn === undefined ? answer.status !== 401 : answer.status !== 303 || (try promise(() => w.storage.get(`delegation/${signedIn!.id}`))) !== undefined) return try refute(op.kind, 69)
        break
      }
      case "device": {
        const body = op.body === "valid" ? JSON.stringify({ token: op.person }) : op.body === "malformed" ? "{" : op.body === "empty" ? JSON.stringify({ token: "" }) : JSON.stringify({ token: "x".repeat(3000) })
        const answer = try seen(try w.ask(SITE + "/api/auth/device", { method: "POST", origin: SITE, body }))
        const expected = op.body === "large" ? 413 : op.body !== "valid" ? 400 : op.person === "0" ? 401 : 200
        if (answer.status !== expected) return try refute(op.kind, 76)
        if (answer.status === 200) {
          // The CLI keeps the returned cookie; this browser takes it as its session.
          const cookie = ((try parsed(answer.text)) as { readonly cookie: string }).cookie
          const at = cookie.indexOf("=")
          w.jars.get(SITE)!.set(cookie.slice(0, at), cookie.slice(at + 1))
          signedIn = { id: op.person, agent: true }
        }
        break
      }
      case "sign-out": {
        const answer = try seen(try w.ask(SITE + "/api/auth/sign-out", { method: "POST", origin: SITE }))
        if (answer.status !== 204) return try refute(op.kind, 88)
        signedIn = undefined
        break
      }
      case "grant": {
        const role = op.role
        const body = op.body === "malformed" ? "{" : JSON.stringify({ id: String(op.n + 1), role })
        const answer = try seen(try w.ask(SITE + "/api/roles", { method: "POST", origin: SITE, body }))
        if (signedIn === undefined ? answer.status !== 403 : ![200, 400, 403].includes(answer.status)) return try refute(op.kind, 96)
        if ((role === "owner" || op.body === "malformed") && signedIn !== undefined && answer.status !== 400) return try refute(op.kind, 97)
        break
      }
      case "members": case "events": {
        const answer = try seen(try w.ask(SITE + (op.kind === "members" ? "/api/roles" : `/api/roles/events?after=${op.n === 0 ? "x" : "0"}`), { stream: op.kind === "events" }))
        if (![200, 400, 403].includes(answer.status) || (signedIn === undefined && answer.status !== 403)) return try refute(op.kind, 102)
        break
      }
      case "install": {
        const answer = try seen(try w.ask(SITE + "/api/auth/install"))
        if (input.slug ? answer.status !== 302 || !answer.location.startsWith("https://github.com/apps/vibelang%20fixture/") : answer.status !== 503) return try refute(op.kind, 107)
        break
      }
      case "handoff": {
        const answer = try seen(try w.ask(SITE + Accounts.CALLBACK))
        if (answer.status !== 200 || answer.text !== GitHub.Auth.Broker.HANDOFF_PAGE) return try refute(op.kind, 112)
        break
      }
      case "issues": case "wiki": {
        // Signed out, a write is asked to sign in before any GitHub request; every answer is a typed status.
        const write = op.body !== "malformed"
        const path = op.kind === "issues" ? "/api/issues" : "/api/wiki"
        const body = op.kind === "issues"
          ? JSON.stringify({ op: "new", number: 0, parent: 0, title: "Fuzzed", text: "Fuzzed", assignee: "", example: "", prior: "", key: `k${op.n}` })
          : JSON.stringify({ op: "draft", page: "index", base: "", text: "ask", key: `k${op.n}` })
        const answer = try seen(write ? try w.ask(SITE + path, { method: "POST", origin: SITE, body }) : try w.ask(SITE + path + (op.kind === "wiki" ? "?page=index" : "")))
        if (answer.status === 500 || answer.status > 503) return try refute(op.kind, 140)
        if (write && signedIn === undefined && answer.status !== 401) return try refute(op.kind, 141)
        break
      }
      case "draft-wiki": {
        // The conversation host's server-only draft: an owner with no role is refused; the bootstrap maintainer is not.
        const owner = op.person === "1" ? "1" : "99"
        const reason = try w.accounts.draftWiki(owner, "index", "ask", `draft-${op.n}`)
        if (owner === "99" ? reason !== "forbidden" : reason === "forbidden") return try refute(op.kind, 150)
        // A draft the object's database cannot record is unavailable, never a defect.
        if (owner === "1") {
          w.setSqlLost(true)
          const lost = try Effect.exit(w.accounts.draftWiki(owner, "index", "ask", `lost-${op.n}`))
          w.setSqlLost(false)
          if (lost._tag !== "Success" || lost.value !== "unavailable") return try refute(op.kind, 151)
        }
        break
      }
      case "participation": {
        const jar = w.jars.get(SITE)!
        try w.accounts.participation(jar.get(Accounts.SESSION))
        const role = ((try parsed((try w.ask(SITE + "/api/auth/session")).text)) as { readonly role?: string }).role
        // Taking part makes a signed-in person at least a community member; a visitor stays a viewer.
        if ((signedIn === undefined) !== (role === "viewer")) return try refute(op.kind, 160)
        break
      }
      case "roles-large": {
        const answer = try seen(try w.ask(SITE + "/api/roles", { method: "POST", origin: SITE, body: "x".repeat(3000) }))
        if (answer.status !== (signedIn === undefined ? 403 : 413)) return try refute(op.kind, 170)
        break
      }
      case "expire": {
        // A stored session that expired, or that no longer decodes, is a visitor's.
        for (const key of (try promise(() => w.storage.list({ prefix: "session/" }))).keys()) {
          try promise(() => w.storage.put(key, op.n % 2 === 0 ? { id: "1", login: "x", expires: 1 } : { broken: true }))
        }
        signedIn = undefined
        break
      }
      case "abandon": {
        // Sign-ins nobody finished: the next start deletes every expired row, and keeps a live one.
        try promise(() => w.storage.put("sign-in/stale", { expires: 1, verifier: { nonce: "n", ciphertext: "c" } }))
        try promise(() => w.storage.put("broker/stale", { claims: { expires: "never" } }))
        try promise(() => w.storage.put("sign-in/live", { expires: Number.MAX_SAFE_INTEGER, verifier: { nonce: "n", ciphertext: "c" } }))
        try seen(try w.ask(SITE + "/api/auth/sign-in"))
        if (named) break
        const rows = [...(try promise(() => w.storage.list({ prefix: "sign-in/" }))).keys(), ...(try promise(() => w.storage.list({ prefix: "broker/" }))).keys()]
        if (rows.includes("sign-in/stale") || rows.includes("broker/stale") || !rows.includes("sign-in/live")) return try refute(op.kind, 190)
        break
      }
      case "device-id": {
        const answer = try seen(try w.ask(SITE + "/api/auth/device"))
        if (answer.status !== 200 || ((try parsed(answer.text)) as { readonly clientId?: string }).clientId !== "fixture-client-id") return try refute(op.kind, 200)
        break
      }
      case "elsewhere": {
        const answer = try seen(try w.ask(SITE + "/api/auth/session", { url: "https://evil.example/api/auth/session" }))
        if (answer.status !== 403) return try refute(op.kind, 210)
        break
      }
      case "lost": {
        w.setLost(true)
        const callback = try seen(try w.ask(SITE + "/api/auth/callback", { method: "POST", origin: SITE, body: "{}" }))
        const start = try seen(try w.ask(SITE + "/api/auth/sign-in"))
        const session = try seen(try w.ask(SITE + "/api/auth/session"))
        w.setLost(false)
        // Lost storage fails a request that needs it, never answers it: GitHub's callback is unavailable (the broker's
        // refuses this body first), sign-in returns to the site marked failed, and a presented session is unavailable.
        // Without a session cookie the session route answers the viewer and reads nothing.
        const presented = w.jars.get(SITE)!.has(Accounts.SESSION)
        if (callback.status !== (brokered ? 400 : 503) || start.status !== 302 || start.location !== `${SITE}/?sign-in=failed` || session.status !== (presented ? 503 : 200)) return try refute(op.kind, 1)
        break
      }
      case "refusals": {
        // Another origin's writes, and bodies a route cannot take, are refused before any work.
        const evil = "https://evil.example"
        const long = ["x".repeat(1500), "x".repeat(1500)]
        const answers: ReadonlyArray<readonly [Answer, number]> = [
          [try seen(try w.ask(SITE + "/api/issues", { method: "POST", origin: evil, body: "{}" })), 403],
          [try seen(try w.ask(SITE + "/api/wiki", { method: "POST", origin: evil, body: "{}" })), 403],
          [try seen(try w.ask(SITE + "/api/auth/device", { method: "POST", origin: evil, body: "{}" })), 403],
          [try seen(try w.ask(SITE + "/api/auth/device", { method: "POST", origin: SITE, body: "x".repeat(3000) })), 413],
          [try seen(try w.ask(SITE + "/api/auth/device", { method: "POST", origin: SITE, chunks: long })), 413],
          [try seen(try w.ask(SITE + "/api/roles", { method: "POST", origin: SITE, chunks: long })), signedIn === undefined ? 403 : 413],
          [try seen(try w.ask(SITE + Accounts.CALLBACK, { method: "POST", origin: SITE, body: "{" })), brokered ? 400 : 503],
        ]
        const wrong = answers.findIndex(([answer, status]) => answer.status !== status)
        if (wrong !== -1) return try refute(op.kind, 220 + wrong)
        break
      }
      case "reads": {
        // Signed in without a connection: issue and wiki reads from an unreachable GitHub are unavailable, an issue
        // write passes its role check and is asked to connect, and a merge a community member cannot make is refused
        // by the role policy before any flow runs. Virtual time. A drawn step in any other state (signed out, an agent,
        // connected, a maintainer who may merge) is skipped.
        if (signedIn === undefined || signedIn.agent || kvOf(w).has("delegation/" + signedIn.id)) break
        if (((try parsed((try w.ask(SITE + "/api/auth/session")).text)) as { readonly role: Role }).role === "maintainer") break
        const issue = (op2: string, key: string) => JSON.stringify({ op: op2, number: 0, parent: 0, title: "Fuzzed", text: "Fuzzed", assignee: "", example: "", prior: "", key })
        const issues = try seen(try stepped(w.ask(SITE + "/api/issues"), 20))
        const wiki = try seen(try stepped(w.ask(SITE + "/api/wiki?page=index"), 20))
        const write = try seen(try stepped(w.ask(SITE + "/api/issues", { method: "POST", origin: SITE, body: issue("new", `r${op.n}`) }), 20))
        const merge = try seen(try stepped(w.ask(SITE + "/api/issues", { method: "POST", origin: SITE, body: issue("spec-revise", `m${op.n}`) }), 20))
        if (issues.status !== 503 || wiki.status !== 503 || write.status !== 401 || !write.text.includes(`"connect"`) || merge.status !== 403) return try refute(op.kind, 240)
        break
      }
      case "propose": {
        const held = signedIn !== undefined && kvOf(w).has("delegation/" + signedIn.id)
        const proposal = try seen(try stepped(w.ask(SITE + "/api/wiki", { method: "POST", origin: SITE, body: JSON.stringify({ op: "propose", page: "index", base: "", text: "Fuzzed", key: `w${op.n}` }) }), 20))
        // A wiki proposal: a visitor is asked to sign in, a person whose role may not propose is refused, and anyone else
        // without a connection is asked to connect, never answered with a page. Only a held delegation reaches GitHub,
        // here unreachable; one the broker no longer honors is forgotten, so the person holds none after that answer.
        const role = ((try parsed((try w.ask(SITE + "/api/auth/session")).text)) as { readonly role: Role }).role
        const reason = proposal.status === 200 ? "" : ((try parsed(proposal.text)) as { readonly reason?: string }).reason
        const expected = signedIn === undefined ? [401, "sign-in"] : may(role, "wiki") && !signedIn.agent ? [401, "connect"] : [403, "forbidden"]
        const connected = expected[1] === "connect" && held && proposal.status === 503
        if (!connected && (proposal.status !== expected[0] || reason !== expected[1])) return try refute(op.kind, 260)
        if (signedIn !== undefined && reason === "connect" && kvOf(w).has("delegation/" + signedIn.id)) return try refute(op.kind, 261)
        break
      }
      case "revoke": {
        // smithers.sh ends the delegation it issued (a person's Disconnect there); the site still holds its copy.
        try w.revoke
        if (real) revoked = true
        break
      }
      case "file": {
        // A new issue: a visitor is asked to sign in before any GitHub request; a delegation smithers.sh ended is
        // answered `connect` and forgotten, so the person holds none after that answer.
        const held = signedIn !== undefined && kvOf(w).has("delegation/" + signedIn.id)
        const filed = try seen(try stepped(w.ask(SITE + "/api/issues", { method: "POST", origin: SITE, body: JSON.stringify({ op: "new", number: 0, parent: 0, title: "Fuzzed", text: "Fuzzed", assignee: "", example: "", prior: "", key: `f${op.n}` }) }), 20))
        const reason = filed.status === 200 ? "" : ((try parsed(filed.text)) as { readonly reason?: string }).reason
        if (signedIn === undefined && (filed.status !== 401 || reason !== "sign-in")) return try refute(op.kind, 270)
        if (held && revoked && (filed.status !== 401 || reason !== "connect")) return try refute(op.kind, 271)
        if (signedIn !== undefined && reason === "connect" && kvOf(w).has("delegation/" + signedIn.id)) return try refute(op.kind, 272)
        break
      }
      case "queued": {
        // Connected, a write waits on an unreachable GitHub holding the issue lock; a read queued behind it is answered
        // unavailable at its 13-second queue deadline, never left waiting. The write is then abandoned. Virtual time.
        // Only a connected person's write reaches GitHub and holds the lock; a drawn step in any other state is skipped.
        if (!brokered || signedIn === undefined || signedIn.agent || !kvOf(w).has("delegation/" + signedIn.id)) break
        const body = JSON.stringify({ op: "new", number: 0, parent: 0, title: "Fuzzed", text: "Fuzzed", assignee: "", example: "", prior: "", key: `q${op.n}` })
        const { read, waited } = try stepped(effect {
          const writer = fork w.ask(SITE + "/api/issues", { method: "POST", origin: SITE, body })
          try sleep("1 second")
          const began = try Clock.currentTimeMillis
          const read = try w.ask(SITE + "/api/issues")
          const waited = (try Clock.currentTimeMillis) - began
          try Fiber.interrupt(writer)
          return { read, waited }
        }, 40)
        try seen(read)
        if (read.status !== 503 || waited < 13_000) return try refute(op.kind, 250)
        break
      }
      case "stall": {
        // A body that never ends is answered at the 3-second read deadline, in virtual time.
        const device = try stepped(w.ask(SITE + "/api/auth/device", { method: "POST", origin: SITE, chunks: "stall" }), 10)
        const roles = try stepped(w.ask(SITE + "/api/roles", { method: "POST", origin: SITE, chunks: "stall" }), 10)
        if (device.status !== 408 || roles.status !== (signedIn === undefined ? 403 : 408)) return try refute(op.kind, 230)
        break
      }
      case "foreign": {
        // A write without the site's Origin is refused before any route.
        const write = try seen(try w.ask(SITE + "/api/auth/sign-out", { method: "POST", origin: "https://evil.example" }))
        const unsigned = try seen(try w.ask(SITE + "/api/roles", { method: "POST", body: "{}" }))
        if (write.status !== 403 || unsigned.status !== 403) return try refute(op.kind, 119)
        break
      }
      default: {
        const answer = try seen(try w.ask(SITE + "/api/auth/unknown"))
        if (answer.status !== 404) return try refute(op.kind, 124)
      }
    }
    if (statuses.some((status) => !ALLOWED.has(status))) return try refute(op.kind, 127)
    // The session the site reports is the model's.
    const current = try who(w)
    if (signedIn === undefined ? current.id !== "" : current.id !== signedIn.id || (current.agent === true) !== signedIn.agent) return try refute(op.kind, 130)
    if (current.available !== !named) return try refute(op.kind, 131)
  }
  return true
}
