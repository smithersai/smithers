import { Base64 } from "effect/encoding"
import { HttpClient, HttpServerResponse } from "effect/http"
import type { Repository } from "../worker/Issues.vibe"

export const API = "https://github.invalid"
export const repo: Repository = { owner: "o", name: "r", api: API, agent: "vibe-agent" }
/** GitHub's immutable id for o/r: smithers.sh checks it, and a fork's parent, before every write. */
export const REPOSITORY_ID = 11

export interface FakeIssue {
  id: number
  node_id: string
  number: number
  title: string
  body: string | null
  state: "open" | "closed"
  state_reason: string | null
  user: { id: number; login: string } | null
  labels: Array<{ name: string }>
  comments: number
  created_at: string
  updated_at: string
  closed_at: string | null
  assignees: Array<{ id: number; login: string } | null>
  parent_issue_url?: string | null
}

export interface FakePull {
  id: number
  node_id: string
  number: number
  title: string
  body: string | null
  state: "open" | "closed"
  user: { id: number; login: string } | null
  head: { ref: string; sha: string }
  base: { ref: string; sha: string; repo: { default_branch: string } | null }
  changed_files: number
  created_at: string
  updated_at: string
  closed_at: string | null
  files: Array<{ filename: string; status: "added" | "modified" }>
}

export interface Fake {
  issues: Array<FakeIssue>
  comments: Record<number, Array<{ id: number; node_id: string; body: string | null; user: { id: number; login: string } | null; created_at: string; updated_at: string; issue_url: string }>>
  labels: Array<string>
  assignable: Array<{ id: number; login: string }>
  pulls: Array<FakePull>
  forks: Record<string, { id: number; name: string; owner: { login: string }; default_branch: string; fork: boolean; parent: { id: number; full_name: string } }>
  branches: Record<string, Record<string, string>>
  commits: Record<string, string>
  pullAdditions: Record<string, Array<string>>
  writes: number
  nextId: number
  nextIssue: number
  nextPull: number
  nextSha: number
  forbiddenNext: boolean
  endlessIssues: boolean
  endlessTimeline: boolean
  endlessReviews: boolean
  malformedIssues: boolean
  endlessComments: boolean
  dropAssignees: boolean
  noMain: boolean
  /** Repository text by path; a pull that changes one of these reports it as modified. */
  files: Record<string, string>
  /** Commit-pinned reads see this text: main advanced after the first read. */
  pinnedText: string | undefined
  contentStatus: number
}

function seedIssue(fake: Fake, number: number, state: "open" | "closed", labels: Array<string>, body: string, assignees: Array<{ id: number; login: string }>): void {
  fake.issues.push({
    id: number * 10, node_id: `node-${number}`, number, title: `Seed ${number}`, body,
    state, state_reason: null, user: { id: 7, login: "fuzz" }, labels: labels.map((name) => ({ name })),
    comments: 0, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z",
    closed_at: state === "closed" ? "2026-01-02T00:00:00Z" : null, assignees,
  })
  fake.comments[number] = []
}

export function seed(): Fake {
  const fake: Fake = {
    issues: [], comments: {}, labels: [], assignable: [{ id: 7, login: "fuzz" }, { id: 8, login: "vibe-agent" }],
    pulls: [], forks: {}, branches: { "o/r": { main: "a".repeat(40) } }, commits: {}, pullAdditions: {},
    writes: 0, nextId: 1000, nextIssue: 100, nextPull: 600, nextSha: 1,
    forbiddenNext: false, endlessIssues: false, endlessTimeline: false, endlessReviews: false, malformedIssues: false,
    endlessComments: false, dropAssignees: false, noMain: false, files: {}, pinnedText: undefined, contentStatus: 200,
  }
  seedIssue(fake, 1, "open", [], "A plain issue", [])
  fake.comments[1] = [{ id: 900, node_id: "comment-900", body: "First note", user: { id: 8, login: "reviewer" }, created_at: "2026-01-02T00:00:00Z", updated_at: "2026-01-02T00:00:00Z", issue_url: `${API}/repos/o/r/issues/1` }]
  fake.issues[0]!.comments = 1
  seedIssue(fake, 2, "closed", [], "A closed issue", [])
  seedIssue(fake, 3, "open", ["vibelang:task"], "A committed issue", [{ id: 8, login: "vibe-agent" }])
  fake.issues.push({
    id: 5000, node_id: "pull-500", number: 500, title: "VIP: seed", body: "Seed review", state: "open", state_reason: null,
    user: { id: 7, login: "fuzz" }, labels: [], comments: 0, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z",
    closed_at: null, assignees: [], pull_request: { url: `${API}/repos/o/r/pulls/500` },
  } as never)
  seedIssue(fake, 4, "open", [], "A reviewed proposal\n\n<!-- vibelang:vip path=docs/design/vips/proposal-seed.md review=https://github.com/o/r/pull/500 -->", [])
  fake.pulls.push({
    id: 5000, node_id: "pull-500", number: 500, title: "VIP: seed", body: "Seed review", state: "open",
    user: { id: 7, login: "fuzz" }, head: { ref: "vibelang/vip-seed", sha: "d".repeat(40) },
    base: { ref: "main", sha: "a".repeat(40), repo: { default_branch: "main" } },
    changed_files: 1, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z", closed_at: null,
    files: [{ filename: "docs/design/vips/proposal-seed.md", status: "added" }],
  })
  return fake
}

/** The person forked o/r on GitHub themselves: smithers.sh never creates a fork (decision 0165). */
export function forked(fake: Fake, login = "fuzz"): void {
  fake.forks[`${login}/r`] = { id: 12, name: "r", owner: { login }, default_branch: "main", fork: true, parent: { id: REPOSITORY_ID, full_name: "o/r" } }
  fake.branches[`${login}/r`] = { ...fake.branches["o/r"] }
}

const jsonResponse = (request: HttpClientRequest.HttpClientRequest, status: number, body: unknown, headers: Record<string, string> = {}) =>
  succeed(HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.text(JSON.stringify(body), { status, headers: { "content-type": "application/json", ...headers } }))))

/** An in-memory GitHub over the real client protocol: REST pagination, sub-issues, forks, refs, GraphQL commits. */
export function fakeClient(fake: Fake): HttpClient.HttpClient {
  return HttpClient.make(effect (request) => {
    const url = new URL(request.url)
    const path = url.pathname
    const rawBody = request.body as { readonly _tag: string; readonly body?: unknown }
    const decode = (bytes: Uint8Array) => Effect.try(() => new TextDecoder().decode(bytes)).pipe(Effect.catch(() => succeed("")))
    const text = rawBody._tag === "Raw" ? typeof rawBody.body === "string" ? rawBody.body : rawBody.body instanceof Uint8Array ? try decode(rawBody.body) : undefined : rawBody._tag === "Uint8Array" ? try decode(rawBody.body as Uint8Array) : undefined
    const body = text === undefined ? undefined : try Effect.try(() => JSON.parse(text) as Record<string, unknown>).pipe(Effect.catch(() => succeed(undefined)))
    // A refused write never applies; an applied write answers from the state after it.
    const write = effect (status: number, answer: () => unknown, apply: () => void) => {
      if (fake.forbiddenNext) {
        fake.forbiddenNext = false
        return try jsonResponse(request, 403, { message: "Forbidden" })
      }
      fake.writes += 1
      apply()
      return try jsonResponse(request, status, answer())
    }
    const page = (items: ReadonlyArray<unknown>, endless: boolean) =>
      jsonResponse(request, 200, items, endless ? { link: `<${API}${path}?page=2>; rel="next"` } : {})
    const issueOne = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)$/.exec(path)
    const comments = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/comments$/.exec(path)
    const timeline = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/timeline$/.exec(path)
    const subIssues = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/sub_issues$/.exec(path)
    const labels = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/labels$/.exec(path)
    const removeLabel = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/labels\/([^/]+)$/.exec(path)
    const issuesList = /^\/repos\/([^/]+)\/([^/]+)\/issues$/.exec(path)
    const createLabel = /^\/repos\/([^/]+)\/([^/]+)\/labels$/.exec(path)
    const assignees = /^\/repos\/([^/]+)\/([^/]+)\/assignees$/.exec(path)
    const pullsList = /^\/repos\/([^/]+)\/([^/]+)\/pulls$/.exec(path)
    const pullOne = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)$/.exec(path)
    const pullFiles = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)\/files$/.exec(path)
    const pullReviews = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)\/reviews$/.exec(path)
    const repoOne = /^\/repos\/([^/]+)\/([^/]+)$/.exec(path)
    const refOne = /^\/repos\/([^/]+)\/([^/]+)\/git\/ref\/heads\/(.+)$/.exec(path)
    const matchingRefs = /^\/repos\/([^/]+)\/([^/]+)\/git\/matching-refs\/heads\/(.+)$/.exec(path)
    const createRef = /^\/repos\/([^/]+)\/([^/]+)\/git\/refs$/.exec(path)
    const commitOne = /^\/repos\/([^/]+)\/([^/]+)\/git\/commits\/([0-9a-f]+)$/.exec(path)
    if (repoOne && request.method === "GET") {
      const key = `${repoOne[1]}/${repoOne[2]}`
      if (key === "o/r") return try jsonResponse(request, 200, { id: REPOSITORY_ID, name: "r", owner: { login: "o" }, default_branch: "main" })
      const existing = fake.forks[key]
      return try (existing === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, existing))
    }
    if (issuesList && request.method === "GET") return try page(fake.malformedIssues ? [{ garbage: true }, ...fake.issues] : fake.issues, fake.endlessIssues)
    if (issuesList && request.method === "POST") {
      const number = fake.nextIssue
      const title = String(body?.title ?? "")
      const textBody = String(body?.body ?? "")
      return try write(201, () => fake.issues.find((issue) => issue.number === number), () => {
        fake.nextIssue += 1
        fake.issues.push({
          id: fake.nextId++, node_id: `node-${number}`, number, title, body: textBody,
          state: "open", state_reason: null, user: { id: 7, login: "fuzz" }, labels: [], comments: 0,
          created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", closed_at: null, assignees: [],
        })
        fake.comments[number] = []
      })
    }
    if (issueOne && request.method === "GET") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(issueOne[3]))
      return try (issue === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, issue))
    }
    if (issueOne && request.method === "PATCH") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(issueOne[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      return try write(200, () => issue, () => {
        if (Array.isArray(body?.assignees) && !fake.dropAssignees) issue.assignees = (body.assignees as Array<string>).map((login) => ({ id: login === "vibe-agent" ? 8 : 7, login }))
        if (body?.state === "closed" || body?.state === "open") {
          issue.state = body.state
          issue.closed_at = body.state === "closed" ? "2026-01-04T00:00:00Z" : null
        }
      })
    }
    if (subIssues && request.method === "POST") {
      const parent = fake.issues.find((candidate) => candidate.number === Number(subIssues[3]))
      if (parent === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const child = fake.issues.find((candidate) => candidate.id === Number(body?.sub_issue_id))
      return try write(200, () => parent, () => {
        if (child !== undefined) child.parent_issue_url = `${API}/repos/o/r/issues/${parent.number}`
      })
    }
    if (timeline && request.method === "GET") return try page([
      { event: "labeled", actor: { id: 7, login: "fuzz" }, created_at: "2026-01-02T00:00:00Z", label: { name: "vibelang:task" } },
      { event: "unlabeled", actor: null, label: { name: "old" } },
      { event: "assigned", actor: { id: 7, login: "fuzz" }, assignee: { id: 8, login: "vibe-agent" } },
      { event: "unassigned", assignee: null },
      { event: "unassigned", actor: { id: 7, login: "fuzz" }, assignee: { id: 8, login: "vibe-agent" } },
      { event: "closed", actor: { id: 7, login: "fuzz" } },
      { event: "reopened", created_at: "2026-01-05T00:00:00Z" },
      { event: "renamed", actor: { id: 7, login: "fuzz" } },
    ], fake.endlessTimeline)
    if (comments && request.method === "GET") return try page(fake.comments[Number(comments[3])] ?? [], fake.endlessComments)
    if (comments && request.method === "POST") {
      const number = Number(comments[3])
      const issue = fake.issues.find((candidate) => candidate.number === number)
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const textBody = String(body?.body ?? "")
      return try write(201, () => fake.comments[number]!.at(-1), () => {
        fake.comments[number]!.push({ id: fake.nextId++, node_id: `comment-${fake.nextId}`, body: textBody, user: { id: 7, login: "fuzz" }, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", issue_url: `${API}/repos/o/r/issues/${number}` })
        issue.comments += 1
      })
    }
    if (labels && request.method === "POST") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(labels[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      return try write(200, () => issue.labels, () => {
        for (const name of (body?.labels as Array<string>) ?? []) if (!issue.labels.some((label) => label.name === name)) issue.labels.push({ name })
      })
    }
    if (removeLabel && request.method === "DELETE") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(removeLabel[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const name = try Effect.try(() => decodeURIComponent(removeLabel[4]!)).pipe(Effect.catch(() => succeed("")))
      return try write(200, () => issue.labels, () => { issue.labels = issue.labels.filter((label) => label.name !== name) })
    }
    if (createLabel && request.method === "POST") {
      const name = String(body?.name ?? "")
      return try write(201, () => ({ name, color: String(body?.color ?? "") }), () => { fake.labels.push(name) })
    }
    if (assignees && request.method === "GET") return try page(fake.assignable, false)
    if (pullsList && request.method === "GET") {
      const head = url.searchParams.get("head")
      return try page(fake.pulls.filter((pull) => head === null || `${pull.user?.login}:${pull.head.ref}` === head), false)
    }
    if (pullsList && request.method === "POST") {
      const number = fake.nextPull
      const headName = String(body?.head ?? "")
      const branch = headName.includes(":") ? headName.split(":")[1]! : headName
      const sha = fake.branches[`${headName.split(":")[0]}/r`]?.[branch] ?? "b".repeat(40)
      return try write(201, () => fake.pulls.find((pull) => pull.number === number), () => {
        fake.nextPull += 1
        const additions = fake.pullAdditions[sha] ?? []
        fake.pulls.push({
          id: fake.nextId++, node_id: `pull-${number}`, number, title: String(body?.title ?? ""), body: String(body?.body ?? ""),
          state: "open", user: { id: 7, login: "fuzz" }, head: { ref: branch, sha },
          base: { ref: String(body?.base ?? "main"), sha: "a".repeat(40), repo: { default_branch: "main" } },
          changed_files: additions.length, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", closed_at: null,
          files: additions.map((filename) => ({ filename, status: fake.files[filename] === undefined ? "added" as const : "modified" as const })),
        })
      })
    }
    if (pullOne && request.method === "GET") {
      const pull = fake.pulls.find((candidate) => candidate.number === Number(pullOne[3]))
      return try (pull === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, pull))
    }
    if (pullFiles && request.method === "GET") return try page(fake.pulls.find((candidate) => candidate.number === Number(pullFiles[3]))?.files ?? [], false)
    if (pullReviews && request.method === "GET") return try page([
      { id: 1, node_id: "rev-1", user: { id: 8, login: "reviewer" }, body: null, state: "APPROVED", commit_id: null },
      { id: 2, node_id: "rev-2", user: null, body: "note", state: "COMMENTED", commit_id: "d".repeat(40) },
    ], fake.endlessReviews)
    if (refOne && request.method === "GET") {
      const sha = fake.noMain && refOne[3] === "main" ? undefined : fake.branches[`${refOne[1]}/${refOne[2]}`]?.[refOne[3]!]
      return try (sha === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, { ref: `refs/heads/${refOne[3]}`, object: { sha, type: "commit" } }))
    }
    if (matchingRefs && request.method === "GET") {
      const owned = fake.branches[`${matchingRefs[1]}/${matchingRefs[2]}`] ?? {}
      const items = Object.entries(owned).filter(([name]) => name.startsWith(matchingRefs[3]!)).map(([name, sha]) => ({ ref: `refs/heads/${name}`, object: { sha, type: "commit" } }))
      return try page(items, false)
    }
    if (createRef && request.method === "POST") {
      const name = String(body?.ref ?? "").replace(/^refs\/heads\//, "")
      const sha = String(body?.sha ?? "")
      const key = `${createRef[1]}/${createRef[2]}`
      return try write(201, () => ({ ref: `refs/heads/${name}`, object: { sha, type: "commit" } }), () => { (fake.branches[key] ??= {})[name] = sha })
    }
    if (commitOne && request.method === "GET") {
      const message = fake.commits[commitOne[3]!]
      return try (message === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, { sha: commitOne[3], message, tree: { sha: "c".repeat(40) }, parents: [] }))
    }
    const contents = /^\/repos\/([^/]+)\/([^/]+)\/contents\/(.+)$/.exec(path)
    if (contents && request.method === "GET") {
      if (fake.contentStatus !== 200) return try jsonResponse(request, fake.contentStatus, { message: "Refused" })
      const file = fake.files[contents[3]!]
      if (file === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const pinned = /^[0-9a-f]{40}$/.test(url.searchParams.get("ref") ?? "") && fake.pinnedText !== undefined
      const text = pinned ? fake.pinnedText! : file
      return try jsonResponse(request, 200, { type: "file", encoding: "base64", content: Base64.encode(text), sha: `sha-${text.length}` })
    }
    if (path === "/graphql" && request.method === "POST") {
      const input = (body?.variables as { input: { branch: { repositoryNameWithOwner: string; branchName: string }; expectedHeadOid: string; message: { headline: string; body?: string }; fileChanges: { additions: Array<{ path: string; contents: string }> } } }).input
      const owned = fake.branches[input.branch.repositoryNameWithOwner]
      if (owned === undefined || owned[input.branch.branchName] !== input.expectedHeadOid) return try jsonResponse(request, 200, { errors: [{ message: "Stale head", type: "STALE" }] })
      const sha = fake.nextSha.toString(16).padStart(40, "0")
      return try write(200, () => ({ data: { createCommitOnBranch: { commit: { oid: sha } } } }), () => {
        fake.nextSha += 1
        owned[input.branch.branchName] = sha
        fake.commits[sha] = `${input.message.headline}${input.message.body === undefined ? "" : `\n\n${input.message.body}`}`
        fake.pullAdditions[sha] = input.fileChanges.additions.map((addition) => addition.path)
      })
    }
    return try jsonResponse(request, 404, { message: "Not Found" })
  })
}

