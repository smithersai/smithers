import { Base64 } from "effect/encoding"
import { HttpClient, HttpServerResponse } from "effect/http"
import type { Repository } from "../worker/Issues.vibe"

export const API = "https://github.invalid"
export const repo: Repository = { owner: "o", name: "r", api: API, agent: "vibe-agent" }
/** GitHub's immutable id for o/r: smithers.sh checks it, and a fork's parent, before every write. */
export const REPOSITORY_ID = 11

export interface FakeIssue {
  id: number
  node_id: string
  number: number
  title: string
  body: string | null
  state: "open" | "closed"
  state_reason: string | null
  sub_issues_summary?: { total: number; completed: number } | null
  repository_url?: string
  user: { id: number; login: string } | null
  labels: Array<{ name: string }>
  comments: number
  created_at: string
  updated_at: string
  closed_at: string | null
  assignees: Array<{ id: number; login: string } | null>
  parent_issue_url?: string | null
}

export interface FakePull {
  id: number
  node_id: string
  number: number
  title: string
  body: string | null
  state: "open" | "closed"
  user: { id: number; login: string } | null
  head: { ref: string; sha: string }
  base: { ref: string; sha: string; repo: { default_branch: string } | null }
  changed_files: number
  commits?: number
  additions?: number
  deletions?: number
  mergeable_state?: string
  merge_commit_sha?: string | null
  created_at: string
  updated_at: string
  closed_at: string | null
  files: Array<{ filename: string; status: "added" | "modified" }>
}

export interface Fake {
  /** Independent GitHub state and scheduling inputs used by recording conformance. */
  repositories?: Record<string, unknown>
  author?: { id: number; login: string }
  sinceNumbers?: Array<number>
  /** The list read from which GitHub shows a parent's child count `number:total`. */
  summaryVisibleAt?: Record<string, number>
  /** Issues the fake created: updated since any run's start. */
  made?: Array<number>
  shaAllocations?: Array<string>
  commitNext?: Record<string, string>
  commitPages?: Record<string, Array<unknown>>
  commitFiles?: Record<string, Record<string, string>>
  timelines?: Record<number, Array<Record<string, unknown>>>
  reviews?: Record<number, Array<unknown>>
  tick?: number
  issueVisibleAt?: Record<number, number>
  /** An issue's own read answers this status instead of the issue. */
  issueStatus?: Record<number, number>
  eventVisibleAt?: Record<string, number>
  mergeShas?: Record<number, string>
  mergeability?: Record<number, Array<{ at: number; state: string }>>
  issues: Array<FakeIssue>
  comments: Record<number, Array<{ id: number; node_id: string; body: string | null; user: { id: number; login: string } | null; created_at: string; updated_at: string; issue_url: string }>>
  labels: Array<string>
  assignable: Array<{ id: number; login: string }>
  pulls: Array<FakePull>
  forks: Record<string, { id: number; name: string; owner: { login: string }; default_branch: string; fork: boolean; parent: { id: number; full_name: string } }>
  branches: Record<string, Record<string, string>>
  commits: Record<string, string>
  pullAdditions: Record<string, Array<string>>
  writes: number
  nextId: number
  nextIssue: number
  nextPull: number
  nextSha: number
  forbiddenNext: boolean
  endlessIssues: boolean
  endlessTimeline: boolean
  endlessReviews: boolean
  malformedIssues: boolean
  endlessComments: boolean
  dropAssignees: boolean
  noMain: boolean
  /** Repository text by path; a pull that changes one of these reports it as modified. */
  files: Record<string, string>
  /** Commit-pinned reads see this text: main advanced after the first read. */
  pinnedText: string | undefined
  contentStatus: number
  /** A branch lookup answers this status when it is not 200. */
  refStatus: number
  /** Every GET answers this status when it is not 200: GitHub is down. */
  outage: number
  /** After the next sub-issue link, this many GETs answer 503: GitHub wrote the link, then went down for a moment. */
  dropAfterLink: number
  /** GETs that still answer 503. */
  dropping: number
  /** Issue reads omit the VIP marker of bodies: GitHub has not shown a new issue's body yet. */
  hideVip: boolean
}

function seedIssue(fake: Fake, number: number, state: "open" | "closed", labels: Array<string>, body: string, assignees: Array<{ id: number; login: string }>): void {
  fake.issues.push({
    id: number * 10, node_id: `node-${number}`, number, title: `Seed ${number}`, body,
    state, state_reason: null, user: { id: 7, login: "fuzz" }, labels: labels.map((name) => ({ name })),
    comments: 0, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z",
    closed_at: state === "closed" ? "2026-01-02T00:00:00Z" : null, assignees,
  })
  fake.comments[number] = []
}

export function seed(): Fake {
  const fake: Fake = {
    issues: [], comments: {}, labels: ["vibelang:task"], assignable: [{ id: 7, login: "fuzz" }, { id: 8, login: "vibe-agent" }],
    pulls: [], forks: {}, branches: { "o/r": { main: "a".repeat(40) } }, commits: {}, pullAdditions: {},
    writes: 0, nextId: 1000, nextIssue: 100, nextPull: 600, nextSha: 1,
    forbiddenNext: false, endlessIssues: false, endlessTimeline: false, endlessReviews: false, malformedIssues: false,
    endlessComments: false, dropAssignees: false, noMain: false, files: {}, pinnedText: undefined, contentStatus: 200, refStatus: 200, outage: 200, dropAfterLink: 0, dropping: 0, hideVip: false,
  }
  seedIssue(fake, 1, "open", [], "A plain issue", [])
  fake.comments[1] = [{ id: 900, node_id: "comment-900", body: "First note", user: { id: 8, login: "reviewer" }, created_at: "2026-01-02T00:00:00Z", updated_at: "2026-01-02T00:00:00Z", issue_url: `${API}/repos/o/r/issues/1` }]
  fake.issues[0]!.comments = 1
  seedIssue(fake, 2, "closed", [], "A closed issue", [])
  seedIssue(fake, 3, "open", ["vibelang:task"], "A committed issue", [{ id: 8, login: "vibe-agent" }])
  fake.issues.push({
    id: 5000, node_id: "pull-500", number: 500, title: "VIP: seed", body: "Seed review", state: "open", state_reason: null,
    user: { id: 7, login: "fuzz" }, labels: [], comments: 0, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z",
    closed_at: null, assignees: [], pull_request: { url: `${API}/repos/o/r/pulls/500` },
  } as never)
  seedIssue(fake, 4, "open", [], "A reviewed proposal\n\n<!-- vibelang:vip path=docs/design/vips/proposal-seed.md review=https://github.com/o/r/pull/500 -->", [])
  fake.pulls.push({
    id: 5000, node_id: "pull-500", number: 500, title: "VIP: seed", body: "Seed review", state: "open",
    user: { id: 7, login: "fuzz" }, head: { ref: "vibelang/vip-seed", sha: "d".repeat(40) },
    base: { ref: "main", sha: "a".repeat(40), repo: { default_branch: "main" } },
    changed_files: 1, created_at: "2026-01-01T00:00:00Z", updated_at: "2026-01-01T00:00:00Z", closed_at: null,
    files: [{ filename: "docs/design/vips/proposal-seed.md", status: "added" }],
  })
  fake.timelines = {}
  return fake
}

/** The person forked o/r on GitHub themselves: smithers.sh never creates a fork (decision 0165). */
export function forked(fake: Fake, login = "fuzz"): void {
  fake.forks[`${login}/r`] = { id: 12, name: "r", owner: { login }, default_branch: "main", fork: true, parent: { id: REPOSITORY_ID, full_name: "o/r" } }
  fake.branches[`${login}/r`] = { ...fake.branches["o/r"] }
}

/** One issue as GitHub answers it alone: labels by name. A list keeps the order they were added in. */
const sortedLabels = <A extends { readonly labels: ReadonlyArray<{ readonly name: string }> } | undefined>(issue: A): A =>
  issue === undefined ? issue : { ...issue, labels: [...issue.labels].sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0) }

/** A JSON answer; a successful GET carries an ETag of its body, as GitHub's do, so a read cache keeps it. */
const jsonResponse = (request: HttpClientRequest.HttpClientRequest, status: number, body: unknown, headers: Record<string, string> = {}) => {
  const text = JSON.stringify(body)
  const etag = request.method === "GET" && status === 200 ? { etag: `"${tagOf(text)}"` } : {}
  return succeed(HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.text(text, { status, headers: { "content-type": "application/json", ...etag, ...headers } }))))
}

function tagOf(text: string): string {
  let hash = 0
  for (let index = 0; index < text.length; index++) hash = (Math.imul(hash, 31) + text.charCodeAt(index)) | 0
  return `${text.length}-${(hash >>> 0).toString(16)}`
}

/** An in-memory GitHub over the real client protocol: REST pagination, sub-issues, forks, refs, GraphQL commits. */
export function fakeClient(fake: Fake): HttpClient.HttpClient {
  return HttpClient.make(effect (request) => {
    const url = new URL(request.url)
    const path = url.pathname
    const repositoryPath = /^\/repos\/([^/]+\/[^/]+)/.exec(path)?.[1] ?? "o/r"
    const author = fake.author ?? { id: 7, login: "fuzz" }
    const repositoryUrl = `${url.origin}/repos/${repositoryPath}`
    const event = (number: number, kind: string, extra: Record<string, unknown> = {}) => {
      (fake.timelines ??= {})[number] ??= []
      fake.timelines[number]!.push({ event: kind, actor: author, created_at: "2026-01-03T00:00:00Z", ...extra })
    }
    const rawBody = request.body as { readonly _tag: string; readonly body?: unknown }
    const decode = (bytes: Uint8Array) => Effect.try(() => new TextDecoder().decode(bytes)).pipe(Effect.catch(() => succeed("")))
    const text = rawBody._tag === "Raw" ? typeof rawBody.body === "string" ? rawBody.body : rawBody.body instanceof Uint8Array ? try decode(rawBody.body) : undefined : rawBody._tag === "Uint8Array" ? try decode(rawBody.body as Uint8Array) : undefined
    const body = text === undefined ? undefined : try Effect.try(() => JSON.parse(text) as Record<string, unknown>).pipe(Effect.catch(() => succeed(undefined)))
    // A refused write never applies; an applied write answers from the state after it.
    const write = effect (status: number, answer: () => unknown, apply: () => void) => {
      if (fake.forbiddenNext) {
        fake.forbiddenNext = false
        return try jsonResponse(request, 403, { message: "Forbidden" })
      }
      fake.writes += 1
      apply()
      return try jsonResponse(request, status, answer())
    }
    if (fake.outage !== 200 && request.method === "GET") return try jsonResponse(request, fake.outage, { message: "Unavailable" })
    if (fake.dropping > 0 && request.method === "GET") {
      fake.dropping -= 1
      return try jsonResponse(request, 503, { message: "Unavailable" })
    }
    const page = (items: ReadonlyArray<unknown>, endless: boolean) =>
      jsonResponse(request, 200, items, endless ? { link: `<${API}${path}?page=2>; rel="next"` } : {})
    const issueOne = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)$/.exec(path)
    const comments = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/comments$/.exec(path)
    const timeline = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/timeline$/.exec(path)
    const subIssues = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/sub_issues$/.exec(path)
    const labels = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/labels$/.exec(path)
    const removeLabel = /^\/repos\/([^/]+)\/([^/]+)\/issues\/(\d+)\/labels\/([^/]+)$/.exec(path)
    const issuesList = /^\/repos\/([^/]+)\/([^/]+)\/issues$/.exec(path)
    const createLabel = /^\/repos\/([^/]+)\/([^/]+)\/labels$/.exec(path)
    const assignees = /^\/repos\/([^/]+)\/([^/]+)\/assignees$/.exec(path)
    const pullsList = /^\/repos\/([^/]+)\/([^/]+)\/pulls$/.exec(path)
    const pullOne = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)$/.exec(path)
    const pullFiles = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)\/files$/.exec(path)
    const pullReviews = /^\/repos\/([^/]+)\/([^/]+)\/pulls\/(\d+)\/reviews$/.exec(path)
    const repoOne = /^\/repos\/([^/]+)\/([^/]+)$/.exec(path)
    const refOne = /^\/repos\/([^/]+)\/([^/]+)\/git\/ref\/heads\/(.+)$/.exec(path)
    const matchingRefs = /^\/repos\/([^/]+)\/([^/]+)\/git\/matching-refs\/heads\/(.+)$/.exec(path)
    const createRef = /^\/repos\/([^/]+)\/([^/]+)\/git\/refs$/.exec(path)
    const commitOne = /^\/repos\/([^/]+)\/([^/]+)\/git\/commits\/([0-9a-f]+)$/.exec(path)
    if (repoOne && request.method === "GET") {
      const key = `${repoOne[1]}/${repoOne[2]}`
      if (fake.repositories?.[key] !== undefined) return try jsonResponse(request, 200, fake.repositories[key])
      if (key === "o/r") return try jsonResponse(request, 200, { id: REPOSITORY_ID, name: "r", owner: { login: "o" }, default_branch: "main" })
      const existing = fake.forks[key]
      return try (existing === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, existing))
    }
    if (issuesList && request.method === "GET") {
      const shown = fake.hideVip ? fake.issues.map((issue) => ({ ...issue, body: String(issue.body ?? "").replace(/<!-- vibelang:vip [^>]*-->/g, "") })) : fake.issues
      let items = shown.filter((issue) => (fake.issueVisibleAt?.[issue.number] ?? 0) <= (fake.tick ?? Infinity))
      const state = url.searchParams.get("state")
      if (state === "open" || state === "closed") items = items.filter((issue) => issue.state === state)
      if (url.searchParams.has("since") && fake.sinceNumbers !== undefined) items = items.filter((issue) => fake.sinceNumbers!.includes(issue.number) || issue.number >= Math.min(fake.nextIssue, fake.nextPull) || (fake.made ?? []).includes(issue.number))
      // GitHub lists newest first unless asked otherwise (sort=created, direction=desc).
      items = [...items].sort((a, b) => (url.searchParams.has("sort") && url.searchParams.get("direction") !== "desc" ? 1 : -1) * (a.number - b.number))
      const perPage = Number(url.searchParams.get("per_page") ?? 100)
      const offset = (Number(url.searchParams.get("page") ?? 1) - 1) * perPage
      // A list longer than a page links its next page as GitHub does, by repository id; GitHub adds an opaque cursor.
      const following = new URLSearchParams(url.searchParams)
      following.set("page", String(Number(url.searchParams.get("page") ?? 1) + 1))
      const id = (fake.repositories?.[repositoryPath] as { readonly id?: number } | undefined)?.id ?? REPOSITORY_ID
      // GitHub's list may show a parent's previous child count for a read after a link (a schedule, summaryVisibleAt).
      items = items.map((issue) => {
        const total = issue.sub_issues_summary?.total
        const visible = total === undefined ? undefined : fake.summaryVisibleAt?.[`${issue.number}:${total}`]
        return visible === undefined || visible <= (fake.tick ?? Infinity) ? issue : { ...issue, sub_issues_summary: { ...issue.sub_issues_summary!, total: total! - 1 } }
      })
      const response = offset + perPage < items.length && !fake.endlessIssues && !fake.malformedIssues
        ? try jsonResponse(request, 200, items.slice(offset, offset + perPage), { link: `<${url.origin}/repositories/${id}/issues?${following.toString()}>; rel="next"` })
        : try page(fake.malformedIssues ? [{ garbage: true }, ...items] : items.slice(offset, offset + perPage), fake.endlessIssues)
      // A repository list may begin with a stale aggregate; subsequent reads derive it from the seeded children.
      for (const parent of fake.issues) {
        const children = fake.issues.filter((child) => child.parent_issue_url === `${repositoryUrl}/issues/${parent.number}`)
        if (children.length > 0) parent.sub_issues_summary = { total: children.length, completed: children.filter((child) => child.state === "closed").length }
      }
      return response
    }
    if (issuesList && request.method === "POST") {
      const number = fake.nextIssue
      const title = String(body?.title ?? "")
      const textBody = String(body?.body ?? "")
      return try write(201, () => sortedLabels(fake.issues.find((issue) => issue.number === number)), () => {
        ;(fake.made ??= []).push(number)
        fake.nextIssue += 1
        fake.nextPull = Math.max(fake.nextPull, fake.nextIssue)
        // GitHub creates a label an issue names that the repository lacks, and assigns only assignable accounts.
        const named = Array.isArray(body?.labels) ? (body.labels as Array<string>) : []
        for (const name of named) if (!fake.labels.includes(name)) fake.labels.push(name)
        const assigned = (Array.isArray(body?.assignees) ? (body.assignees as Array<string>) : []).flatMap((login) => fake.assignable.filter((user) => user.login === login))
        fake.issues.push({
          id: fake.nextId++, node_id: `node-${number}`, number, title, body: textBody === "" ? null : textBody,
          state: "open", state_reason: null, user: author, labels: named.map((name) => ({ name })), comments: 0, sub_issues_summary: { total: 0, completed: 0 }, repository_url: repositoryUrl,
          created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", closed_at: null, assignees: assigned,
        })
        fake.comments[number] = []
        ;(fake.timelines ??= {})[number] = []
        for (const user of assigned) event(number, "assigned", { assignee: user })
        for (const name of named) event(number, "labeled", { label: { name } })
      })
    }
    if (issueOne && request.method === "GET") {
      const refused = fake.issueStatus?.[Number(issueOne[3])]
      if (refused !== undefined) return try jsonResponse(request, refused, { message: "Refused" })
      const issue = fake.issues.find((candidate) => candidate.number === Number(issueOne[3]))
      const shown = issue !== undefined && fake.hideVip ? { ...issue, body: String(issue.body ?? "").replace(/<!-- vibelang:vip [^>]*-->/g, "") } : issue
      return try (shown === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, sortedLabels(shown)))
    }
    if (issueOne && request.method === "PATCH") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(issueOne[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      return try write(200, () => sortedLabels(issue), () => {
        if (Array.isArray(body?.assignees) && !fake.dropAssignees) {
          const before = issue.assignees
          const after = (body.assignees as Array<string>).map((login) => fake.assignable.find((user) => user.login === login) ?? { id: login === "vibe-agent" ? 8 : 7, login })
          for (const user of before) if (user && !after.some((next) => next.login === user.login)) event(issue.number, "unassigned", { assignee: user })
          for (const user of after) if (!before.some((old) => old?.login === user.login)) event(issue.number, "assigned", { assignee: user })
          issue.assignees = after
        }
        if (Array.isArray(body?.labels)) {
          const after = body.labels as Array<string>
          for (const label of issue.labels) if (!after.includes(label.name)) event(issue.number, "unlabeled", { label: { name: label.name } })
          for (const name of after) if (!issue.labels.some((label) => label.name === name)) event(issue.number, "labeled", { label: { name } })
          for (const name of after) if (!fake.labels.includes(name)) fake.labels.push(name)
          issue.labels = after.map((name) => ({ name }))
        }
        if (typeof body?.title === "string") issue.title = body.title
        if (typeof body?.body === "string") issue.body = body.body === "" ? null : body.body
        if ((body?.state === "closed" || body?.state === "open") && body.state !== issue.state) event(issue.number, body.state === "closed" ? "closed" : "reopened")
        if (body?.state === "closed" || body?.state === "open") {
          issue.state = body.state
          issue.state_reason = body.state === "closed" ? "completed" : null
          issue.closed_at = body.state === "closed" ? "2026-01-04T00:00:00Z" : null
        }
      })
    }
    if (subIssues && request.method === "POST") {
      const parent = fake.issues.find((candidate) => candidate.number === Number(subIssues[3]))
      if (parent === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const child = fake.issues.find((candidate) => candidate.id === Number(body?.sub_issue_id))
      if (child === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      // The link's answer counts the new child; GitHub's issue list shows the old count until its next read.
      const counted = () => {
        const children = fake.issues.filter((issue) => issue.parent_issue_url === `${repositoryUrl}/issues/${parent.number}`)
        return { ...parent, sub_issues_summary: { total: children.length, completed: children.filter((issue) => issue.state === "closed").length } }
      }
      return try write(201, counted, () => {
        const linked = `${repositoryUrl}/issues/${parent.number}`
        if (child.parent_issue_url !== linked) {
          child.parent_issue_url = linked
          parent.sub_issues_summary = { total: (parent.sub_issues_summary?.total ?? 0) + 1, completed: 0 }
          event(child.number, "parent_issue_added")
          event(parent.number, "sub_issue_added")
        }
        fake.dropping = fake.dropAfterLink
        fake.dropAfterLink = 0
      })
    }
    if (timeline && request.method === "GET" && fake.timelines?.[Number(timeline[3])] !== undefined) {
      const number = Number(timeline[3])
      return try page(fake.timelines[number]!.filter((_, index) => (fake.eventVisibleAt?.[`${number}:${index}`] ?? 0) <= (fake.tick ?? Infinity)), fake.endlessTimeline)
    }
    if (timeline && request.method === "GET") return try page([
      { event: "labeled", actor: { id: 7, login: "fuzz" }, created_at: "2026-01-02T00:00:00Z", label: { name: "vibelang:task" } },
      { event: "unlabeled", actor: null, label: { name: "old" } },
      { event: "assigned", actor: { id: 7, login: "fuzz" }, assignee: { id: 8, login: "vibe-agent" } },
      { event: "unassigned", assignee: null },
      { event: "unassigned", actor: { id: 7, login: "fuzz" }, assignee: { id: 8, login: "vibe-agent" } },
      { event: "closed", actor: { id: 7, login: "fuzz" } },
      { event: "reopened", created_at: "2026-01-05T00:00:00Z" },
      { event: "renamed", actor: { id: 7, login: "fuzz" } },
    ], fake.endlessTimeline)
    if (comments && request.method === "GET") return try page(fake.comments[Number(comments[3])] ?? [], fake.endlessComments)
    if (comments && request.method === "POST") {
      const number = Number(comments[3])
      const issue = fake.issues.find((candidate) => candidate.number === number)
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const textBody = String(body?.body ?? "")
      return try write(201, () => fake.comments[number]!.at(-1), () => {
        fake.comments[number]!.push({ id: fake.nextId++, node_id: `comment-${fake.nextId}`, body: textBody, user: author, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", issue_url: `${repositoryUrl}/issues/${number}` })
        issue.comments += 1
        event(number, "commented")
      })
    }
    if (labels && request.method === "POST") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(labels[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      return try write(200, () => issue.labels, () => {
        for (const name of (body?.labels as Array<string>) ?? []) if (!issue.labels.some((label) => label.name === name)) {
          issue.labels.push({ name })
          event(issue.number, "labeled", { label: { name } })
        }
      })
    }
    if (removeLabel && request.method === "DELETE") {
      const issue = fake.issues.find((candidate) => candidate.number === Number(removeLabel[3]))
      if (issue === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const name = try Effect.try(() => decodeURIComponent(removeLabel[4]!)).pipe(Effect.catch(() => succeed("")))
      if (!issue.labels.some((label) => label.name === name)) return try jsonResponse(request, 404, { message: "Label does not exist" })
      return try write(200, () => issue.labels, () => {
        issue.labels = issue.labels.filter((label) => label.name !== name)
        event(issue.number, "unlabeled", { label: { name } })
      })
    }
    if (createLabel && request.method === "POST") {
      const name = String(body?.name ?? "")
      if (fake.labels.includes(name)) return try jsonResponse(request, 422, { message: "Validation Failed", errors: [{ resource: "Label", code: "already_exists", field: "name" }] })
      return try write(201, () => ({ name, color: String(body?.color ?? "") }), () => { fake.labels.push(name) })
    }
    const labelOne = /^\/repos\/([^/]+)\/([^/]+)\/labels\/([^/]+)$/.exec(path)
    if (labelOne && (request.method === "GET" || request.method === "DELETE")) {
      const name = try Effect.try(() => decodeURIComponent(labelOne[3]!)).pipe(Effect.catch(() => succeed("")))
      if (!fake.labels.includes(name)) return try jsonResponse(request, 404, { message: "Not Found" })
      if (request.method === "GET") return try jsonResponse(request, 200, { name, color: "ededed", description: null, default: false })
      if (fake.forbiddenNext) { fake.forbiddenNext = false; return try jsonResponse(request, 403, { message: "Forbidden" }) }
      // Deleting a repository label removes it from every issue that carries it.
      fake.labels = fake.labels.filter((label) => label !== name)
      for (const issue of fake.issues) issue.labels = issue.labels.filter((label) => label.name !== name)
      fake.writes += 1
      return HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.empty({ status: 204 })))
    }
    if (pullReviews && request.method === "POST") {
      const pull = fake.pulls.find((candidate) => candidate.number === Number(pullReviews[3]))
      if (pull === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const states: Record<string, string> = { COMMENT: "COMMENTED", APPROVE: "APPROVED", REQUEST_CHANGES: "CHANGES_REQUESTED" }
      const id = fake.nextId++
      const review = { id, node_id: `review-${id}`, user: author, body: String(body?.body ?? ""), state: states[String(body?.event ?? "")] ?? "PENDING", submitted_at: "2026-01-03T00:00:00Z", commit_id: pull.head.sha }
      return try write(200, () => review, () => { ((fake.reviews ??= {})[pull.number] ??= []).push(review) })
    }
    if (assignees && request.method === "GET") return try page(fake.assignable, false)
    if (pullsList && request.method === "GET") {
      const head = url.searchParams.get("head")
      return try page(fake.pulls.filter((pull) => head === null || `${pull.user?.login}:${pull.head.ref}` === head), false)
    }
    if (pullsList && request.method === "POST") {
      const number = fake.nextPull
      const headName = String(body?.head ?? "")
      const branch = headName.includes(":") ? headName.split(":")[1]! : headName
      const headOwner = headName.includes(":") ? headName.split(":")[0]! : pullsList[1]!
      const sha = fake.branches[`${headOwner}/${pullsList[2]}`]?.[branch]
      // GitHub refuses a pull request whose head branch does not exist.
      if (sha === undefined) return try jsonResponse(request, 422, { message: "Validation Failed", errors: [{ resource: "PullRequest", field: "head", code: "invalid" }] })
      return try write(201, () => fake.pulls.find((pull) => pull.number === number), () => {
        fake.nextPull += 1
        fake.nextIssue = Math.max(fake.nextIssue, fake.nextPull)
        const additions = fake.pullAdditions[sha] ?? []
        const baseRef = String(body?.base ?? "main")
        const baseSha = fake.branches[repositoryPath]?.[baseRef] ?? "a".repeat(40)
        const before = fake.commitFiles?.[baseSha] ?? fake.files
        const after = fake.commitFiles?.[sha] ?? fake.files
        let added = 0
        let removed = 0
        for (const path of additions) {
          const changes = lineChanges(before[path] ?? "", after[path] ?? "")
          added += changes.additions
          removed += changes.deletions
        }
        fake.pulls.push({
          id: fake.nextId++, node_id: `pull-${number}`, number, title: String(body?.title ?? ""), body: String(body?.body ?? ""),
          state: "open", user: author, head: { ref: branch, sha },
          base: { ref: baseRef, sha: baseSha, repo: { default_branch: "main" } },
          commits: 1, additions: added, deletions: removed, mergeable_state: "unknown",
          changed_files: additions.length, created_at: "2026-01-03T00:00:00Z", updated_at: "2026-01-03T00:00:00Z", closed_at: null,
          files: additions.map((filename) => ({ filename, status: before[filename] === undefined ? "added" as const : "modified" as const })),
        })
        {
          const pull = fake.pulls.at(-1)!
          fake.issues.push({
            id: pull.id, node_id: pull.node_id, number, title: pull.title, body: pull.body, state: pull.state,
            state_reason: null, user: author, labels: [], comments: 0, assignees: [],
            created_at: pull.created_at, updated_at: pull.updated_at, closed_at: null,
            repository_url: repositoryUrl,
            pull_request: { url: `${repositoryUrl}/pulls/${number}`, html_url: `https://github.com/${repositoryPath}/pull/${number}`, merged_at: null },
          } as FakeIssue)
        }
      })
    }
    if (pullOne && request.method === "GET") {
      const pull = fake.pulls.find((candidate) => candidate.number === Number(pullOne[3]))
      const state = fake.mergeability?.[Number(pullOne[3])]?.filter((check) => check.at <= (fake.tick ?? Infinity)).at(-1)?.state
      return try (pull === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, state === undefined ? pull : { ...pull, mergeable_state: state, merge_commit_sha: state === "unknown" ? null : fake.mergeShas?.[pull.number] ?? pull.head.sha }))
    }
    if (pullOne && request.method === "PATCH") {
      const pull = fake.pulls.find((candidate) => candidate.number === Number(pullOne[3]))
      if (pull === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      return try write(200, () => pull, () => {
        if (body?.state === "closed" || body?.state === "open") {
          pull.state = body.state
          pull.closed_at = body.state === "closed" ? "2026-01-04T00:00:00Z" : null
        }
        const check = fake.mergeability?.[pull.number]?.filter((check) => check.at <= (fake.tick ?? Infinity)).at(-1)
        if (check) { pull.mergeable_state = check.state; pull.merge_commit_sha = check.state === "unknown" ? null : fake.mergeShas?.[pull.number] ?? pull.head.sha }
      })
    }
    if (pullFiles && request.method === "GET") return try page(fake.pulls.find((candidate) => candidate.number === Number(pullFiles[3]))?.files ?? [], false)
    if (pullReviews && request.method === "GET") return try page(fake.reviews?.[Number(pullReviews[3])] ?? (Number(pullReviews[3]) === 500 ? [
      { id: 1, node_id: "rev-1", user: { id: 8, login: "reviewer" }, body: null, state: "APPROVED", commit_id: null },
      { id: 2, node_id: "rev-2", user: null, body: "note", state: "COMMENTED", commit_id: "d".repeat(40) },
    ] : []), fake.endlessReviews)
    if (refOne && request.method === "GET") {
      if (fake.refStatus !== 200) return try jsonResponse(request, fake.refStatus, { message: "Refused" })
      const sha = fake.noMain && refOne[3] === "main" ? undefined : fake.branches[`${refOne[1]}/${refOne[2]}`]?.[refOne[3]!]
      return try (sha === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, { ref: `refs/heads/${refOne[3]}`, object: { sha, type: "commit" } }))
    }
    if (matchingRefs && request.method === "GET") {
      const owned = fake.branches[`${matchingRefs[1]}/${matchingRefs[2]}`] ?? {}
      // GitHub answers matching refs sorted by name, not in the order they were made (test/fakeConformance.test.vibe).
      const items = Object.entries(owned).filter(([name]) => name.startsWith(matchingRefs[3]!)).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0).map(([name, sha]) => ({ ref: `refs/heads/${name}`, object: { sha, type: "commit" } }))
      return try page(items, false)
    }
    if (createRef && request.method === "POST") {
      const name = String(body?.ref ?? "").replace(/^refs\/heads\//, "")
      const sha = String(body?.sha ?? "")
      const key = `${createRef[1]}/${createRef[2]}`
      return try write(201, () => ({ ref: `refs/heads/${name}`, object: { sha, type: "commit" } }), () => { (fake.branches[key] ??= {})[name] = sha })
    }
    const deleteRef = /^\/repos\/([^/]+)\/([^/]+)\/git\/refs\/heads\/(.+)$/.exec(path)
    if (deleteRef && request.method === "DELETE") {
      const owned = fake.branches[`${deleteRef[1]}/${deleteRef[2]}`]
      if (owned?.[deleteRef[3]!] === undefined) return try jsonResponse(request, 422, { message: "Reference does not exist" })
      if (fake.forbiddenNext) { fake.forbiddenNext = false; return try jsonResponse(request, 403, { message: "Forbidden" }) }
      delete owned[deleteRef[3]!]
      fake.writes += 1
      return HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(HttpServerResponse.empty({ status: 204 })))
    }
    if (/\/commits$/.test(path) && request.method === "GET" && fake.commitPages !== undefined) {
      const items = fake.commitPages[repositoryPath] ?? []
      const perPage = Number(url.searchParams.get("per_page") ?? 100)
      const start = (Number(url.searchParams.get("page") ?? 1) - 1) * perPage
      const next = fake.commitNext?.[request.url]
      return try jsonResponse(request, 200, items.slice(start, start + perPage), next === undefined ? {} : { link: `<${next}>; rel="next"` })
    }
    if (commitOne && request.method === "GET") {
      const message = fake.commits[commitOne[3]!]
      return try (message === undefined ? jsonResponse(request, 404, { message: "Not Found" }) : jsonResponse(request, 200, { sha: commitOne[3], message, tree: { sha: "c".repeat(40) }, parents: [] }))
    }
    const contents = /^\/repos\/([^/]+)\/([^/]+)\/contents\/(.+)$/.exec(path)
    if (contents && request.method === "GET") {
      if (fake.contentStatus !== 200) return try jsonResponse(request, fake.contentStatus, { message: "Refused" })
      const ref = url.searchParams.get("ref") ?? "main"
      const sha = fake.branches[repositoryPath]?.[ref] ?? ref
      const file = (fake.commitFiles?.[sha] ?? fake.files)[contents[3]!]
      if (file === undefined) return try jsonResponse(request, 404, { message: "Not Found" })
      const pinned = /^[0-9a-f]{40}$/.test(url.searchParams.get("ref") ?? "") && fake.pinnedText !== undefined
      const text = pinned ? fake.pinnedText! : file
      return try jsonResponse(request, 200, { type: "file", encoding: "base64", content: Base64.encode(text), sha: `sha-${text.length}` })
    }
    if (path === "/graphql" && request.method === "POST") {
      const input = (body?.variables as { input: { branch: { repositoryNameWithOwner: string; branchName: string }; expectedHeadOid: string; message: { headline: string; body?: string }; fileChanges: { additions: Array<{ path: string; contents: string }> } } }).input
      const owned = fake.branches[input.branch.repositoryNameWithOwner]
      if (owned === undefined || owned[input.branch.branchName] !== input.expectedHeadOid) return try jsonResponse(request, 200, { errors: [{ message: "Stale head", type: "STALE" }] })
      const sha = fake.shaAllocations?.shift() ?? fake.nextSha.toString(16).padStart(40, "0")
      return try write(200, () => ({ data: { createCommitOnBranch: { commit: { oid: sha } } } }), () => {
        fake.nextSha += 1
        const snapshot = { ...(fake.commitFiles?.[input.expectedHeadOid] ?? fake.files) }
        for (const addition of input.fileChanges.additions) snapshot[addition.path] = Base64.decodeString(addition.contents).pipe(Result.getOrElse(() => ""))
        ;(fake.commitFiles ??= {})[sha] = snapshot
        owned[input.branch.branchName] = sha
        fake.commits[sha] = `${input.message.headline}${input.message.body === undefined ? "" : `\n\n${input.message.body}`}`
        fake.pullAdditions[sha] = input.fileChanges.additions.map((addition) => addition.path)
      })
    }
    return try jsonResponse(request, 404, { message: "Not Found" })
  })
}


/** Lines outside the unchanged prefix and suffix, as GitHub counts a small single-file edit. */
function lineChanges(before: string, after: string): { additions: number; deletions: number } {
  const lines = (text: string) => text === "" ? [] : text.replace(/\n$/, "").split("\n")
  const left = lines(before)
  const right = lines(after)
  let start = 0
  while (start < left.length && start < right.length && left[start] === right[start]) start++
  let oldEnd = left.length
  let newEnd = right.length
  while (oldEnd > start && newEnd > start && left[oldEnd - 1] === right[newEnd - 1]) { oldEnd--; newEnd-- }
  return { additions: newEnd - start, deletions: oldEnd - start }
}
