// Runs every subscription the web app declares, over arbitrary Models and native DOM events; what they emit goes through `update`.
import { it } from "@effect/vitest"
import { ExperimentalBrowserWindow, ExperimentalBrowserDocument } from "vibelang-runtime/experimental/platform-browser"
import { Model, Message, subscriptions, update } from "../src/web/main.vibe"
import { backend, Backend, Role } from "./web-backends.vibe"
import { run, Finding } from "./run.vibe"

const WINDOW = "40 millis"
/** The deadline for the keyboard probe to answer; it never ends a passing run early. */
const READY = "5 seconds"

const KINDS = ["keydown", "wheel", "touchstart", "touchmove", "touchend", "touchcancel", "scroll", "click-wiki", "click-draft", "click-outside", "popstate", "popstate-elsewhere", "resize", "orientationchange"] as const
const DomEvent = Schema.Struct({
  kind: Schema.Literals(KINDS),
  key: Schema.Literals(["k", "K", "Escape", " ", "Tab", "ArrowLeft", "ArrowRight", "PageUp", "Home", "ArrowUp", "a"]),
  meta: Schema.Boolean,
  control: Schema.Boolean,
  shift: Schema.Boolean,
  button: Schema.Literals([0, 1]),
})
type DomEvent = typeof DomEvent.Type

interface Entry {
  readonly modelToDependencies: (model: Model) => unknown
  readonly dependenciesToStream: (dependencies: unknown, read: () => unknown) => Stream.Stream<Message, never, never>
}

type DomEventInstance = Parameters<EventTarget["dispatchEvent"]>[0]
type Constructors = Record<"Event" | "KeyboardEvent" | "WheelEvent" | "MouseEvent" | "TouchEvent", new (type: string, init?: object) => DomEventInstance>

/** A real happy-dom page holding the links the click subscriptions look for. */
function page(document: Document) {
  const wiki = document.createElement("div")
  wiki.className = "vl-wiki-content"
  wiki.innerHTML = `<a href="/wiki/index">w</a>`
  const bubble = document.createElement("div")
  bubble.className = "sui-chat-bubble"
  bubble.innerHTML = `<a href="#wiki-draft-index">d</a>`
  document.body.append(wiki, bubble)
  return { wiki: wiki.querySelector("a")!, draft: bubble.querySelector("a")!, dispose: () => { wiki.remove(); bubble.remove() } }
}

function fire(document: Document, window: Window, links: ReturnType<typeof page>, event: DomEvent): void {
  const dom = window as unknown as Constructors
  const keys = { key: event.key, metaKey: event.meta, ctrlKey: event.control, shiftKey: event.shift, bubbles: true, cancelable: true }
  switch (event.kind) {
    case "keydown": document.dispatchEvent(new dom.KeyboardEvent("keydown", keys)); return
    case "wheel": document.dispatchEvent(new dom.WheelEvent("wheel", { deltaY: event.button === 0 ? -8 : 8, bubbles: true, cancelable: true })); return
    case "touchstart":
    case "touchmove":
    case "touchend":
    case "touchcancel": document.dispatchEvent(new dom.TouchEvent(event.kind, { touches: event.button === 0 ? [{ identifier: 1, clientY: event.shift ? 40 : 10 }] : [], bubbles: true, cancelable: true })); return
    case "scroll": document.dispatchEvent(new dom.Event("scroll", { bubbles: true })); return
    case "click-wiki": links.wiki.dispatchEvent(new dom.MouseEvent("click", { ...keys, button: event.button })); return
    case "click-draft": links.draft.dispatchEvent(new dom.MouseEvent("click", { ...keys, button: event.button })); return
    case "click-outside": document.dispatchEvent(new dom.MouseEvent("click", { ...keys, button: event.button })); return
    case "popstate-elsewhere": window.history.replaceState(null, "", "/elsewhere"); window.dispatchEvent(new dom.Event("popstate")); return
    case "popstate":
    case "resize":
    case "orientationchange": window.dispatchEvent(new dom.Event(event.kind)); return
  }
}

/**
 * The page the subscriptions read: the document itself (as the app passes it), a document with no window (its
 * `defaultView` is null, so window events fall back to the key target), or none.
 */
const Page = Schema.Literals(["document", "windowless", "none"])
const Input = Schema.Struct({ model: Model, backend: Backend, role: Role, events: Schema.Array(DomEvent).check(Schema.isMaxLength(12)), page: Schema.optionalKey(Page) })

function pageOf(document: Document, page: typeof Page.Type | undefined): Document | undefined {
  return page === "none" ? undefined : page === "windowless" ? document.implementation.createHTMLDocument("windowless") : document
}

/**
 * Every subscription attaches before the events fire: the keyboard subscription, forked after all of them, must answer
 * Escape with PressedEscape first. Whatever any subscription then emits is a declared Message that leaves a valid Model.
 */
it.live("web/subscriptions", () => run("web/subscriptions", Input, ({ model, backend: kind, role, events, page: shown }) => Effect.provide(effect {
  const document = try (try Experimental.Document.Document).current
  const window = try (try Experimental.Window.Window).current
  const links = try acquireRelease(Effect.orDie(Effect.try(() => page(document))), (links) => sync(links.dispose))
  try Effect.try(() => window.history.replaceState(null, "", "/"))
  const all = (try Effect.try(() => subscriptions(document, pageOf(document, shown)))) as unknown as Record<string, Entry>
  const done = try Deferred.make<void>()
  const seen = new Map<string, Array<Message>>()
  const collect = (name: string, entry: Entry) => effect {
    const dependencies = entry.modelToDependencies(model)
    const bucket: Array<Message> = []
    seen.set(name, bucket)
    const stream = entry.dependenciesToStream(dependencies, () => dependencies).pipe(Stream.interruptWhen(Deferred.await(done)))
    return { name, fiber: fork Stream.runForEach(stream, (message) => sync(() => { bucket.push(message) })) }
  }
  const running = try Effect.forEach(Object.entries(all).filter(([name]) => name !== "keyboard"), ([name, entry]) => collect(name, entry))
  // The keyboard is forked last, so once it answers, every subscription forked before it has attached its listeners.
  // (A second keyboard instance would see the first's preventDefault and stay silent.)
  const probe = try collect("keyboard", all.keyboard!)
  const dom = window as unknown as Constructors
  const answered = () => seen.get(probe.name)!.some((message) => message._tag === "PressedEscape")
  const ready = try Effect.timeoutOption(effect {
    while (!answered()) {
      try Effect.try(() => document.dispatchEvent(new dom.KeyboardEvent("keydown", { key: "Escape", bubbles: true, cancelable: true })))
      try sleep("1 millis")
    }
  }, READY)
  if (Option.isNone(ready)) throw new Finding({ report: `keyboard: Escape answered no PressedEscape within ${READY}` })
  // Every kind fires once, a finger down then moving, so each listener runs whatever the draw; then the drawn events.
  const chosen = KINDS.map((kind): DomEvent => ({ kind, key: "a", meta: false, control: false, shift: kind === "touchmove", button: 0 }))
  try Effect.try(() => { for (const event of [...chosen, ...events]) fire(document, window, links, event) })
  try sleep(WINDOW)
  try Deferred.succeed(done, undefined)
  for (const { name, fiber } of [...running, probe]) {
    const result = try exit(Fiber.join(fiber))
    if (result._tag === "Failure") throw new Finding({ report: `${name}: ${Cause.pretty(result.cause)}` })
    for (const message of seen.get(name)!) {
      if (!Schema.is(Message)(message)) throw new Finding({ report: `${name}: emitted an undeclared Message` })
      if (!Schema.is(Model)(update(model, message).model)) throw new Finding({ report: `${name}: ${message._tag} left an invalid Model` })
      // Back and forward follow the wiki only: an address outside it and the home page is never a wiki location.
      if (message._tag === "WikiLocationChanged" && !(message.page.startsWith("/wiki/") || message.page === "/" || message.page.startsWith("/#"))) throw new Finding({ report: `${name}: followed ${message.page}` })
    }
  }
  return true
}, Layer.mergeAll(backend(kind, role), ExperimentalBrowserDocument.layer, ExperimentalBrowserWindow.layer))))
