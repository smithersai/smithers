// A post's run and its agent-started reply, answered by a scripted model on a real local socket, under a ledger that
// admits, refuses, or is unavailable, and a person whose role may change before the reply runs.
import { it } from "@effect/vitest"
import { Mythical } from "../src/history/MythicalHistory.vibe"
import { ActionDevice } from "../src/actions/execution.vibe"
import { MockFactory } from "../src/core/MockFactory.vibe"
import { Factory } from "../src/core/Factory.vibe"
import * as Runs from "../worker/ActionRuns.vibe"
import { ExecutionObject } from "@smthrs/platform-cloudflare"
import { Post, Tour } from "../src/core/flows.vibe"
import { Show } from "../src/history/tools.vibe"
import type { RunRequest } from "../src/actions/wire.vibe"
import * as Objects from "../worker/Objects.vibe"
import { world, request, history } from "../test/support/actionObjects.vibe"
import { objectStorage } from "../test/support/objectStorage.ts"
import { cell, scriptedModel, type Scripted } from "./model-server.vibe"
import { run, Finding, Text } from "./run.vibe"

const Config = Schema.Struct({
  flow: Schema.Literals(["vibelang/Post", "vibelang/Tour"]),
  reply: Schema.Literals(["answer", "refused", "credit", "garbage", "prose"]),
  text: Text,
  ledger: Schema.Literals(["admit", "refuse", "die"]),
  demote: Schema.Literals(["none", "new", "community", "contributor"]),
  alarms: Schema.Int.check(Schema.isBetween({ minimum: 1, maximum: 4 })),
  cancel: Schema.Literals(["none", "run", "child"]),
  // The conversation log refuses the reply's first settle write: the reply execution completes as a failure.
  settle: Schema.optionalKey(Schema.Literal("dies-once")),
})
/** Several independent runs per execution, each in its own object, so one execution meets many combinations. */
const Input = Schema.Array(Config).check(Schema.isMinLength(1), Schema.isMaxLength(6))

const scriptOf = (input: typeof Config.Type): Scripted => {
  switch (input.reply) {
    case "answer": return { kind: "stream", pieces: [cell(JSON.stringify(`Answer: ${input.text}`))], prompt: 3, completion: 4 }
    case "prose": return { kind: "stream", pieces: ["no cell here"], prompt: 3, completion: 4 }
    case "refused": return { kind: "status", status: 400, code: "content_policy" }
    case "credit": return { kind: "status", status: 402, code: "out_of_credit" }
    case "garbage": return { kind: "garbage" }
  }
}

/**
 * A run object whose conversation log dies on the reply's first settle write (`finish` or `fail`), as a reset store
 * does: a faulty service, the real sequencer behind it. Reads go to the real sequencer.
 */
const faultyObject = (id: string, authority: Parameters<typeof Runs.make>[3]) => effect {
  const storage = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Objects.Storage
  const sequencer = try Objects.conversation(storage)
  let faults = 1
  const dies = <A, E>(write: A!E) => faults-- > 0 ? Effect.die(new Error("conversation log unavailable")) : write
  const faulty: typeof sequencer = { ...sequencer, finish: (reply, text) => dies(sequencer.finish(reply, text)), fail: (reply, reason) => dies(sequencer.fail(reply, reason)) }
  return { storage, sequencer, host: Runs.make(id, storage, faulty, authority) }
}

/** A run's rows always agree with the conversation they describe, and a settled row never changes. */
it.live("actions/run-answers", () => run("actions/run-answers", Input, (configs) => scoped(effect {
  const w = try world()
  provide MockFactory, history {
    const device = try Factory
    try device.accounts!.choose("maintainer")
    const product = try Mythical
    provide ActionDevice = device {
      for (const [index, input] of configs.entries()) {
        const scripted = try scriptedModel([scriptOf(input)])
        const id = `answered${index}`
        const object = input.settle === undefined ? try w.object(id) : try faultyObject(id, w.authority)
        const model = { model: scripted.model, unusable: "" }
        const spend = input.ledger === "admit" ? w.spend
          : input.ledger === "refuse" ? { admit: () => succeed(false), spend: () => Effect.void }
          : { admit: () => Effect.die(new Error("ledger unavailable")), spend: () => Effect.void }
        // Each run starts with its owner a maintainer; a demotion lands between its first and second alarm.
        try w.accounts.choose("maintainer")
        const restored = w.accounts.grant(w.person.id, "maintainer") catch () => "refused"
        if (restored === "refused") throw new Finding({ report: "a maintainer could not restore a maintainer" })
        const started = try object.host.start(request(id, input.flow, { text: `Question ${input.text}` }, w.person.id), "maintainer")
        // The wire refuses text that is not well-formed UTF-16, so a post of it is invalid, as the Worker answers.
        if (input.flow === "vibelang/Post" && !`Question ${input.text}`.isWellFormed()) {
          if (started !== "invalid") throw new Finding({ report: `a malformed post answered ${started}` })
          continue
        }
        if (started !== null) throw new Finding({ report: `a permitted ${input.flow} start answered ${started}` })
        const settled = new Map<string, string>()
        for (let turn = 0; turn < input.alarms; turn++) {
          const outcome = try exit(object.host.alarm(spend, model, product))
          if (outcome._tag === "Failure" && input.ledger !== "die") throw new Finding({ report: "an alarm failed with a working ledger" })
          if (turn === 0 && input.cancel !== "none") {
            const answer = try object.host.cancel(input.cancel === "child" ? `${id}-reply` : id, "maintainer", w.person.id)
            if (![null, "not-found", "forbidden", "cancel-failed"].includes(answer)) throw new Finding({ report: `cancel answered ${answer}` })
          }
          if (turn === 0 && input.demote !== "none") {
            try w.accounts.choose("maintainer")
            const granted = w.accounts.grant(w.person.id, input.demote) catch () => "refused"
            if (granted !== undefined && granted !== "refused") throw new Finding({ report: "a grant answered a value" })
          }
          const rows = try Runs.read(object.sequencer)
          if (new Set(rows.map((row) => row.id)).size !== rows.length) throw new Finding({ report: "a run was recorded twice" })
          for (const row of rows) {
            const was = settled.get(row.id)
            if (was !== undefined && was !== row.state) throw new Finding({ report: `settled ${row.id} changed from ${was} to ${row.state}` })
            if (["passed", "failed", "cancelled"].includes(row.state)) settled.set(row.id, row.state)
          }
          // The reply's row says what the reply says: an answered reply passed, a failed one did not.
          const reply = (try object.sequencer.read(0)).entries.find((entry) => entry.author === "agent")
          const child = rows.find((row) => row.id === `${id}-reply`)
          if (input.flow === "vibelang/Post" && reply !== undefined && reply.done && child !== undefined) {
            if (reply.error === "" && child.state === "failed") throw new Finding({ report: "an answered reply's run failed" })
            if (reply.error !== "" && child.state === "passed") throw new Finding({ report: "a failed reply's run passed" })
          }
        }
        // A reply whose execution failed is failed in the conversation and in its run, never left running.
        if (input.settle !== undefined && input.flow === "vibelang/Post" && input.ledger === "admit" && input.cancel === "none" && input.demote === "none") {
          const reply = (try object.sequencer.read(0)).entries.find((entry) => entry.author === "agent")
          const child = (try Runs.read(object.sequencer)).find((row) => row.id === `${id}-reply`)
          if (reply?.done !== true || reply.error !== "Action failed" || child?.state !== "failed") throw new Finding({ report: `a reply whose execution failed reads ${reply?.error === undefined ? "absent" : reply.done ? "done" : "running"}, its run ${child?.state}` })
        }
      }
    }
  }
  return true
})))

/**
 * Every execution runs both held states: the conversation log dies on the reply's first settle write, and the reply
 * still ends failed; a latch holds the reply at its admission while a person cancels it, and it ends cancelled.
 */
it.live("actions/held-replies", () => run("actions/held-replies", Text, (text) => scoped(effect {
  const w = try world()
  provide MockFactory, history {
    const device = try Factory
    try device.accounts!.choose("maintainer")
    const product = try Mythical
    provide ActionDevice = device {
      const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify(`Answer: ${text}`))], prompt: 3, completion: 4 }])
      const question = `Question ${text}`
      const settle = effect (id: string, object: { readonly host: ReturnType<typeof Runs.make>; readonly sequencer: Parameters<typeof Runs.read>[0] }) => {
        const started = try object.host.start(request(id, "vibelang/Post", { text: question }, w.person.id), "maintainer")
        if (!question.isWellFormed()) {
          if (started !== "invalid") throw new Finding({ report: `a malformed post answered ${started}` })
          return false
        }
        if (started !== null) throw new Finding({ report: `a permitted post answered ${started}` })
        return true
      }
      const alarms = effect (object: { readonly host: ReturnType<typeof Runs.make> }) => {
        for (let turn = 0; turn < 2; turn++) {
          const outcome = try exit(object.host.alarm(w.spend, { model: scripted.model, unusable: "" }, product))
          if (outcome._tag === "Failure") throw new Finding({ report: "an alarm failed with a working ledger" })
        }
      }
      const ended = effect (id: string, sequencer: Parameters<typeof Runs.read>[0], error: string, state: string) => {
        const reply = (try sequencer.read(0)).entries.find((entry) => entry.author === "agent")
        const child = (try Runs.read(sequencer)).find((row) => row.id === `${id}-reply`)
        if (reply?.done !== true || reply.error !== error || child?.state !== state) throw new Finding({ report: `a ${state} reply reads ${reply === undefined ? "absent" : reply.done ? "done" : "running"}, its run ${child?.state}` })
      }
      const failing = try faultyObject("failing", w.authority)
      if (!(try settle("failing", failing))) return true
      try alarms(failing)
      try ended("failing", failing.sequencer, "Action failed", "failed")
      // The reply's run exists once an alarm starts it; its admission waits on the latch, so the run is running.
      const cancelled = try w.object("cancelled")
      try settle("cancelled", cancelled)
      const entered = try Deferred.make<void>()
      const release = try Deferred.make<void>()
      const held = { admit: (day: string) => Deferred.succeed(entered, undefined).pipe(Effect.andThen(Deferred.await(release)), Effect.andThen(w.spend.admit(day))), spend: w.spend.spend }
      const running = try Effect.forkScoped(Effect.exit(cancelled.host.alarm(held, { model: scripted.model, unusable: "" }, product)))
      try Deferred.await(entered)
      const row = (try Runs.read(cancelled.sequencer)).find((item) => item.id === "cancelled-reply")
      if (row?.state !== "running") throw new Finding({ report: `a held reply's run is ${row?.state}` })
      const answer = try cancelled.host.cancel("cancelled-reply", "maintainer", w.person.id)
      if (answer !== null) throw new Finding({ report: `cancelling a running reply answered ${answer}` })
      try Deferred.succeed(release, undefined)
      try Fiber.join(running)
      try alarms(cancelled)
      try ended("cancelled", cancelled.sequencer, "Cancelled", "cancelled")
    }
  }
  return true
})))

/** Run objects whose services fail or hold once: the object's storage, the conversation's settle write, a reply's start. */
interface Steer {
  intentWrites: number
  /** Reads of the held execution's intent: `skip` succeed, then `fail` reject. */
  intentReads: { skip: number; fail: number }
  cancelledReads: number
  settles: number
  /** The tour's spoken steps that die before the conversation hears them. */
  says: number
  readonly hold?: { readonly entered: Deferred.Deferred<void>; readonly release: Deferred.Deferred<void> }
}
const steeredObject = (id: string, authority: Parameters<typeof Runs.make>[3], steer: Steer) => effect {
  const raw = (try Effect.orDie(Effect.try(() => objectStorage()))) as unknown as Objects.Storage
  const storage = new Proxy(raw, {
    get: (target, name) => {
      if (name === "put") return (key: string, value: unknown) => {
        if (key === ExecutionObject.intentKey && steer.intentWrites > 0) {
          steer.intentWrites -= 1
          return Promise.reject(new Error("injected intent write failure"))
        }
        return target.put(key, value)
      }
      if (name === "get") return (key: string) => {
        if (key === ExecutionObject.cancelledKey && steer.cancelledReads > 0) {
          steer.cancelledReads -= 1
          return Promise.reject(new Error("injected admission read failure"))
        }
        if (key === ExecutionObject.intentKey && steer.intentReads.skip > 0) steer.intentReads.skip -= 1
        else if (key === ExecutionObject.intentKey && steer.intentReads.fail > 0) {
          steer.intentReads.fail -= 1
          return Promise.reject(new Error("injected intent read failure"))
        }
        return target.get(key)
      }
      const member = Reflect.get(target, name) as unknown
      return typeof member === "function" ? (member as (...args: ReadonlyArray<unknown>) => unknown).bind(target) : member
    },
  })
  const sequencer = try Objects.conversation(storage)
  const hold = steer.hold
  const faulty: typeof sequencer = {
    ...sequencer,
    action: (intent) => {
      if (intent.type !== "SettleAction" || steer.settles === 0) return sequencer.action(intent)
      steer.settles -= 1
      return Effect.die(new Error("conversation log unavailable"))
    },
    say: (tour, text) => {
      if (steer.says === 0) return sequencer.say(tour, text)
      steer.says -= 1
      return Effect.die(new Error("tour voice unavailable"))
    },
    start: (post) => hold === undefined ? sequencer.start(post) : Deferred.succeed(hold.entered, undefined).pipe(Effect.andThen(Deferred.await(hold.release)), Effect.andThen(sequencer.start(post))),
  }
  return { storage, sequencer, host: Runs.make(id, storage, faulty, authority) }
}

/**
 * Every execution runs each state the random runs reach only by chance: a post with no text, a history run behind a
 * dispatched reply, a run with no owner, a tour whose dispatch or admission fails, a tour ended by Escape, a post
 * started again after its settle write failed, and a reply cancelled before its agent entry exists.
 */
it.live("actions/steered-runs", () => run("actions/steered-runs", Text, (text) => scoped(effect {
  const w = try world()
  provide MockFactory, history {
    const device = try Factory
    try device.accounts!.choose("maintainer")
    const product = try Mythical
    provide ActionDevice = device {
      const scripted = try scriptedModel([{ kind: "stream", pieces: [cell(JSON.stringify(`Answer: ${text}`))], prompt: 3, completion: 4 }])
      const model = { model: scripted.model, unusable: "" }
      type Steered = { readonly storage: Objects.Storage; readonly sequencer: Parameters<typeof Runs.read>[0]; readonly host: ReturnType<typeof Runs.make> }
      const state = effect (object: Steered, id: string) => (try Runs.read(object.sequencer)).find((row) => row.id === id)?.state
      const alarms = effect (object: Steered, count: number) => {
        for (let turn = 0; turn < count; turn++) {
          const outcome = try exit(object.host.alarm(w.spend, model, product))
          if (outcome._tag === "Failure") throw new Finding({ report: `alarm ${turn} failed with healthy services` })
        }
      }
      const fresh = (id: string, steer: Partial<Steer> = {}) => steeredObject(id, w.authority, { intentWrites: 0, intentReads: { skip: 0, fail: 0 }, cancelledReads: 0, settles: 0, says: 0, ...steer })

      // A post with no text passes the catalog as an empty post; the run answers input and records nothing.
      const textless = try fresh("textless")
      const bare = try textless.host.start(request("textless", Post._tag, {}, w.person.id), "maintainer")
      if (bare !== "input" || (try state(textless, "textless")) !== "failed" || (try textless.sequencer.read(0)).entries.length !== 0) throw new Finding({ report: `a post with no text answered ${bare}` })

      // A dispatched reply holds the object's one execution: a history run started now is busy, and its run fails.
      const crowded = try fresh("crowded")
      if ((try Objects.post("crowded", crowded.storage, crowded.sequencer, "c1", "Guest", "Question")) !== null) throw new Finding({ report: "a first post was refused" })
      const behind = try crowded.host.start(request("crowded", Show._tag, {}, w.person.id), "maintainer")
      if (behind !== "busy" || (try state(crowded, "crowded")) !== "failed") throw new Finding({ report: `a history run behind a reply answered ${behind}` })

      // A door that names no one runs the owner as Guest (every door names the person; ActionRuns.start is public).
      const anonymous = try fresh("anonymous")
      const unnamed: RunRequest = { id: "anonymous", flow: Show._tag, input: {}, door: "agent", actor: "agent", owner: w.person.id }
      const shown = try anonymous.host.start(unnamed, "maintainer")
      if (shown !== null) throw new Finding({ report: `an unnamed history run answered ${shown}` })
      try alarms(anonymous, 2)
      if ((try state(anonymous, "anonymous")) !== "passed") throw new Finding({ report: `an unnamed history run is ${try state(anonymous, "anonymous")}` })

      // The tour is recorded, then its dispatch's intent write fails: the start answers failed, and so does its run.
      const orphan = try fresh("orphan", { intentWrites: 1 })
      const orphaned = try orphan.host.start(request("orphan", Tour._tag, {}, w.person.id), "maintainer")
      if (orphaned !== "failed" || (try state(orphan, "orphan")) !== "failed") throw new Finding({ report: `a tour whose dispatch failed answered ${orphaned}` })

      // Escape ends a running tour action; the next alarm settles its run passed.
      const walked = try fresh("walked")
      if ((try walked.host.start(request("walked", Tour._tag, {}, w.person.id), "maintainer")) !== null) throw new Finding({ report: "a tour action was refused" })
      try alarms(walked, 1)
      if ((try Objects.endTour("walked", walked.storage, walked.sequencer)) !== null) throw new Finding({ report: "Escape was refused" })
      // Ended but not yet settled, the tour's run is still running: the same start again answers and changes nothing.
      const repeated = try walked.host.start(request("walked", Tour._tag, {}, w.person.id), "maintainer")
      if (repeated !== null || (try state(walked, "walked")) !== "running") throw new Finding({ report: `a tour started again after Escape answered ${repeated}` })
      try alarms(walked, 2)
      if ((try state(walked, "walked")) !== "passed") throw new Finding({ report: `a tour ended by Escape is ${try state(walked, "walked")}` })

      // The tour's admission read fails: its drive retries, the alarm settles nothing, and the next alarm admits it.
      const stalled = try fresh("stalled", { cancelledReads: 1 })
      if ((try stalled.host.start(request("stalled", Tour._tag, {}, w.person.id), "maintainer")) !== null) throw new Finding({ report: "a tour action was refused" })
      const retried = try exit(stalled.host.alarm(w.spend, model, product))
      if (retried._tag !== "Success" || retried.value._tag !== "Retrying") throw new Finding({ report: `an alarm whose admission read failed ended ${retried._tag === "Failure" ? String(Cause.squash(retried.cause)).slice(0, 120) : retried.value._tag}` })
      if ((try state(stalled, "stalled")) !== "running") throw new Finding({ report: `a tour whose drive retries is ${try state(stalled, "stalled")}` })
      try alarms(stalled, 1)
      if ((try Objects.endTour("stalled", stalled.storage, stalled.sequencer)) !== null) throw new Finding({ report: "Escape was refused" })
      try alarms(stalled, 1)
      if ((try state(stalled, "stalled")) !== "passed") throw new Finding({ report: `a tour that recovered is ${try state(stalled, "stalled")}` })

      // The drive's own intent read fails: the alarm fails with that cause and settles nothing, as the platform retries it.
      const reads = { skip: 0, fail: 0 }
      const dropped = try fresh("dropped", { intentReads: reads })
      if ((try dropped.host.start(request("dropped", Tour._tag, {}, w.person.id), "maintainer")) !== null) throw new Finding({ report: "a tour action was refused" })
      // The alarm reads the intent once itself, then its drive reads it.
      reads.skip = 1
      reads.fail = 1
      const died = try exit(dropped.host.alarm(w.spend, model, product))
      if (died._tag !== "Failure" || !String(Cause.squash(died.cause)).includes("injected intent read failure")) throw new Finding({ report: `an alarm whose intent read failed ended ${died._tag === "Failure" ? String(Cause.squash(died.cause)).slice(0, 120) : died.value._tag}` })
      if ((try state(dropped, "dropped")) !== "running") throw new Finding({ report: `a tour whose alarm failed is ${try state(dropped, "dropped")}` })
      try alarms(dropped, 1)
      if ((try Objects.endTour("dropped", dropped.storage, dropped.sequencer)) !== null) throw new Finding({ report: "Escape was refused" })
      try alarms(dropped, 1)
      if ((try state(dropped, "dropped")) !== "passed") throw new Finding({ report: `a tour that recovered is ${try state(dropped, "dropped")}` })

      // A signed-out visitor's tour names no owner or person: it runs at the viewer role, and Escape ends it passed.
      const visitor = try fresh("visitor")
      const visiting: RunRequest = { id: "visitor", flow: Tour._tag, input: {}, door: "button", actor: "person" }
      if ((try visitor.host.start(visiting, "viewer")) !== null) throw new Finding({ report: "a visitor's tour was refused" })
      try alarms(visitor, 1)
      if ((try Objects.endTour("visitor", visitor.storage, visitor.sequencer)) !== null) throw new Finding({ report: "Escape was refused" })
      try alarms(visitor, 1)
      if ((try state(visitor, "visitor")) !== "passed") throw new Finding({ report: `a visitor's tour is ${try state(visitor, "visitor")}` })

      // The tour's first spoken step dies: its execution fails, and the tour and its run end failed.
      const hoarse = try fresh("hoarse", { says: 1 })
      if ((try hoarse.host.start(request("hoarse", Tour._tag, {}, w.person.id), "maintainer")) !== null) throw new Finding({ report: "a tour action was refused" })
      try alarms(hoarse, 3)
      const hoarseEntry = (try hoarse.sequencer.read(0)).entries.find((entry) => entry.author === "agent")
      if (hoarseEntry?.done !== true || hoarseEntry.error !== "Action failed" || (try state(hoarse, "hoarse")) !== "failed") throw new Finding({ report: `a tour whose step died is ${try state(hoarse, "hoarse")}` })

      // The post is recorded, then its run's settle write fails: started again, the post is not recorded twice and passes.
      const resettled = try fresh("resettled", { settles: 1 })
      const asked = request("resettled", Post._tag, { text: "Question" }, w.person.id)
      if ((try exit(resettled.host.start(asked, "maintainer")))._tag !== "Failure") throw new Finding({ report: "a post whose settle write failed answered" })
      const again = try resettled.host.start(asked, "maintainer")
      const posts = (try resettled.sequencer.read(0)).entries.filter((entry) => entry.clientId === "resettled").length
      if (again !== null || posts !== 1 || (try state(resettled, "resettled")) !== "passed") throw new Finding({ report: `a post started again answered ${again} with ${posts} posts, its run ${try state(resettled, "resettled")}` })

      // A latch holds the reply before its agent entry exists; cancelling its run then cancels a reply that never spoke.
      const hold = { entered: try Deferred.make<void>(), release: try Deferred.make<void>() }
      const early = try fresh("early", { hold })
      // Its door names no person, so the post is signed Guest.
      const nameless: RunRequest = { id: "early", flow: Post._tag, input: { text: "Question" }, door: "button", actor: "person", owner: w.person.id }
      if ((try early.host.start(nameless, "maintainer")) !== null) throw new Finding({ report: "a post was refused" })
      if ((try early.sequencer.read(0)).entries.find((entry) => entry.clientId === "early")?.name !== "Guest") throw new Finding({ report: "a nameless post was not signed Guest" })
      const replying = try Effect.forkScoped(Effect.exit(early.host.alarm(w.spend, model, product)))
      try Deferred.await(hold.entered)
      const child = try state(early, "early-reply")
      if (child === "running") {
        const cancelled = try early.host.cancel("early-reply", "maintainer", w.person.id)
        if (cancelled !== null) throw new Finding({ report: `cancelling a reply before it spoke answered ${cancelled}` })
      }
      try Deferred.succeed(hold.release, undefined)
      try Fiber.join(replying)
      try alarms(early, 2)
      const spoke = (try early.sequencer.read(0)).entries.filter((entry) => entry.author === "agent" && !entry.done)
      if (child !== "running" || spoke.length !== 0 || (try state(early, "early-reply")) !== "cancelled") throw new Finding({ report: `a reply cancelled before it spoke: run was ${child}, is ${try state(early, "early-reply")}, ${spoke.length} entries running` })
    }
  }
  return true
})))
