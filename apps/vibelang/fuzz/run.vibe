// One bounded target, its persistent regressions, and content-free campaign receipts.
import * as NodeServices from "@effect/platform-node/NodeServices"
import { TestClock } from "effect/testing"
import { Fuzz } from "@smthrs/fuzz"
import { FuzzCorpus } from "@smthrs/testing"
import { MAX_TEXT } from "../src/core/decide.vibe"

export error Finding {
  report: string
  get message() { return this.report }
}
export error BudgetInvalid { message: string }
/** The budget ran out before the property ran once (corpus loading and arbitrary construction share the deadline). */
export error NoExecution {
  report: string
  get message() { return this.report }
}

const executions = Metric.counter("vibelang_fuzz_executions", { incremental: true })

/** Every target has its own wall budget; corpus replay happens on every invocation. */
export effect function run<S extends Schema.Constraint>(
  name: string,
  schema: S,
  property: (input: S["Type"]) => boolean | (boolean!unknown!Scope.Scope),
  execution?: Fuzz.Execution,
  options?: { readonly revision?: string; readonly codec?: Fuzz.Codec<S["Type"]>; readonly minimum?: Duration.Input },
) {
  provide NodeServices.layer {
    return try withSpan(effect {
      const began = try Clock.currentTimeMillis
      const configured = try Config.withDefault(Config.Duration("FUZZ_BUDGET"), name.startsWith("browser/") ? Duration.seconds(25) : Duration.millis(250))
      if (Duration.toMillis(configured) <= 0) throw new BudgetInvalid({ message: "FUZZ_BUDGET must be positive" })
      // The deadline also covers replaying saved failures; a target whose replay outlasts a short budget declares a floor (0015).
      const budget = options?.minimum === undefined ? configured : Duration.max(configured, Duration.fromInputUnsafe(options.minimum))
      const seed = try Config.withDefault(Config.String("FUZZ_SEED"), "20261107")
      const limit = try Config.option(Config.Int("FUZZ_EXECUTIONS"))
      const path = try Path.Path
      const directory = path.resolve("fuzz")
      // FUZZ_CORPUS moves both stores under one directory (the gate's own tests); unset, they are the checked-in failures and the local input cache.
      const corpus = try Config.option(Config.String("FUZZ_CORPUS"))
      const store = try Effect.try(() => FuzzCorpus.fileCorpus(Option.isSome(corpus)
        ? { failures: path.join(corpus.value, "failures"), inputs: path.join(corpus.value, "inputs") }
        : { failures: path.join(directory, "__fuzz__"), inputs: path.join(directory, "../node_modules/.cache/effect-fuzz") }))
      const target = try Effect.try(() => Fuzz.target(schema, (input) => scoped(Effect.suspend(() => {
        const output = property(input)
        return Effect.isEffect(output) ? output : succeed(output)
      })).pipe(Effect.provideService(References.MinimumLogLevel, "Warn")), { id: name, revision: options?.revision ?? "1", ...(options?.codec === undefined ? {} : { codec: options.codec }) }))
      const searched = { seed, maxShrinks: name.startsWith("browser/") ? 16 : 64, ...(execution === undefined ? {} : { execution }) }
      const first = try Fuzz.runTarget(target, { duration: budget, ...searched, ...(Option.isSome(limit) ? { executions: limit.value } : {}) }).pipe(Effect.provideService(Fuzz.Corpus, store))
      // The deadline covers the replay of saved failures, so a slow box can spend the whole budget replaying them and
      // start no fresh execution (0015). Those replays passed; one more run skips them and executes once, so the gate
      // below judges the property and not the box. FUZZ_EXECUTIONS and a finding keep the first report.
      const oneMore = first._tag === "Passed" && first.stats.executions === 0 && Option.isNone(limit)
      const inputsOnly: Fuzz.Store = { load: (id) => store.load(id).pipe(Effect.map((entries) => entries.filter((entry) => entry.kind === "Input"))), save: store.save }
      const report = oneMore ? try Fuzz.runTarget(target, { ...searched, executions: 1 }).pipe(Effect.provideService(Fuzz.Corpus, inputsOnly)) : first
      const ended = try Clock.currentTimeMillis
      try Metric.update(Metric.withAttributes(executions, { target: name }), report.stats.executions)
      try Effect.logInfo("vibelang.fuzz.target").pipe(Effect.annotateLogs({ target: name, outcome: report._tag, executions: report.stats.executions, regressions: first.stats.regressions, stoppedBy: report.stats.stoppedBy, oneMore }))
      const fs = try FileSystem.FileSystem
      const receipts = path.resolve("fuzz-results")
      try fs.makeDirectory(receipts, { recursive: true })
      try fs.writeFileString(path.join(receipts, name.replaceAll("/", "--") + ".json"), JSON.stringify({ target: name, seed, budget: Duration.toMillis(budget), outcome: report._tag, began, ended, elapsedMs: ended - began, oneMore, stats: { ...report.stats, regressions: first.stats.regressions } }))
      const finding = try Effect.try(() => Fuzz.formatReport(report))
      if (finding !== undefined) throw new Finding({ report: finding })
      try gate(name, budget, limit, report.stats)
    }, `vibelang.fuzz.${name}`)
  }
}

/**
 * A target that never ran its property proves nothing, so it fails and names the load that starved it.
 * The deadline starts before corpus loading and arbitrary construction; on a loaded host they can spend it all.
 * `FUZZ_EXECUTIONS=0` is the explicit replay-only mode and passes with zero executions.
 */
export effect function gate(name: string, budget: Duration.Duration, limit: Option.Option<number>, stats: { readonly executions: number }) {
  if (stats.executions > 0 || (Option.isSome(limit) && limit.value === 0)) return
  const fs = try FileSystem.FileSystem
  const load = try fs.readFileString("/proc/loadavg").pipe(Effect.map((text) => text.split(" ")[0] ?? "unknown"), Effect.orElseSucceed(() => "unknown"))
  throw new NoExecution({ report: `${name} ran no execution in ${Duration.toMillis(budget)} ms (host load ${load})` })
}

/**
 * Floor for a target whose one execution is seconds long: replaying its saved failure alone takes about 5 s,
 * so a fresh checkout at the 5 s coverage budget ran no execution even on an idle 4-vCPU box (0015). Browser
 * targets declare it too: at `FUZZ_BUDGET=5 seconds` two of them replayed their saved failures and never explored.
 */
export const REPLAY_FLOOR = "15 seconds"

/**
 * Floor for a steered target whose saved-value replay and one execution took 8.5 s (`actions/steered-runs`) and 21.7 s
 * (`wiki/steered-host`) under coverage on an idle 4-vCPU box; at 5 s and 15 s they ran none in the next run (0015).
 */
export const STEERED_FLOOR = "30 seconds"

/**
 * Runs `program` in virtual time, advancing the clock a second at a time (letting the engine's real promises settle
 * between) for at most `seconds`; none when it has not finished by then.
 */
export effect function virtually<A, E, R>(program: A!E!R, seconds: number) {
  provide TestClock.layer() {
    let done = false
    const running = fork program.pipe(Effect.ensuring(sync(() => { done = true })))
    for (let second = 0; second < seconds && !done; second++) {
      try TestClock.adjust("1 second")
      try TestClock.withLive(sleep("2 millis"))
    }
    if (!done) {
      try Fiber.interrupt(running)
      return Option.none<A>()
    }
    return Option.some(join running)
  }
}

export const Int = Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 31 }))
export const Text = Schema.String.check(Schema.isMaxLength(120))
export const TextOrBoundary = Schema.Union([Text, Schema.Literals(["", " ", "\n\t", "x".repeat(MAX_TEXT + 1), "```vibe\nhello\n```", "a`b`c", "\ud800"])])
export const Steps = Schema.Array(Schema.Struct({ op: Int, id: Int, text: TextOrBoundary, flag: Schema.Boolean })).check(Schema.isMaxLength(48))

/** Structural comparison keeps prototypes and JSON key order out of the value-level invariants. */
export function same(a: unknown, b: unknown): boolean {
  const canonical = (value: unknown): unknown => {
    if (Array.isArray(value)) return value.map(canonical)
    if (typeof value === "object" && value !== null) {
      const out: Record<string, unknown> = {}
      for (const key of Object.keys(value).sort()) out[key] = canonical((value as Record<string, unknown>)[key])
      return out
    }
    return value
  }
  try { return JSON.stringify(canonical(a)) === JSON.stringify(canonical(b)) } catch { return false }
}

/**
 * Runs `program` under a test clock stepped 250 ms at a time, letting real promises settle 10 ms between steps, so a
 * flow's retries and deadlines pass in virtual time. A program still running after `limitSeconds` is a finding.
 */
export effect function stepped<A, E>(program: A!E!never, limitSeconds: number) {
  return try Effect.provide(effect {
    const fiber = try forkChild(program)
    for (let step = 0; step < limitSeconds * 4 && fiber.pollUnsafe() === undefined; step++) {
      try TestClock.withLive(sleep("10 millis"))
      try TestClock.adjust("250 millis")
    }
    const exit = fiber.pollUnsafe()
    if (exit === undefined) {
      try Fiber.interrupt(fiber)
      throw new Finding({ report: `a flow outlived ${limitSeconds} virtual seconds` })
    }
    return try exit
  }, TestClock.layer())
}
