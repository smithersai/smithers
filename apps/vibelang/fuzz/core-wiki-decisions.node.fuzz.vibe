// The wiki's verified decisions (src/core/wikiPageDecision.vibe) on arbitrary ids, texts and flags, each held to its
// contract, and the page lookups built on them (src/core/wiki.vibe) against the generated pages.
import { it } from "@effect/vitest"
import { pages, requestedWiki, wikiEditable, wikiPage, wikiPath } from "../src/core/wiki.vibe"
import {
  editable, firstWithPrefix, fixtureVerdict, longestIncluded, pageIdOf, pageIndex, reviewNumber, wikiHref, wikiRefusalStatus, wikiRequest, wikiUnwritten,
} from "../src/core/wikiPageDecision.vibe"
import {
  decisionLabel, digitsEnd, feedFrom, findDate, findDigitsEnd, findFeed, findFolded, findHeading, findKey, findLineEnd, findRulingEnd, findRulings,
  firstDate, firstHeading, foldedAt, foldedIncludes, headingTitle, keyFrom, lineEnd, rulingEnd, rulingsFrom,
} from "../src/core/wikiBuildDecision.vibe"
import { run, Int } from "./run.vibe"

const WORDS = ["", "a", "ab", "b", "decisions", "designs", "designs/index", "index", "rulings", "a/b"] as const
const REASONS = ["forbidden", "sign-in", "connect", "missing", "unknown", "conflict", "empty", "invalid", "fork", "install", "busy", ""] as const
const Word = Schema.Literals(WORDS)
const Input = Schema.Struct({
  ids: Schema.Array(Word).check(Schema.isMaxLength(6)), id: Word, text: Schema.Literals(["", "open ab", "the rulings and a/b", "designs/index please", "b"]),
  flags: Schema.Array(Schema.Boolean).check(Schema.isMinLength(6), Schema.isMaxLength(6)),
  op: Schema.Literals(["read", "draft", "save", "propose"]), reason: Schema.Literals(REASONS), hash: Schema.Literals(["", "sec-1"]), reviews: Int,
})

it.live("decisions/wiki-pages", () => run("decisions/wiki-pages", Input, (input) => {
  const ids = input.ids
  const list = ids.map((id) => ({ id }))
  const [a, b, c, d, e, f] = input.flags as unknown as readonly [boolean, boolean, boolean, boolean, boolean, boolean]
  const index = pageIndex(list, input.id)
  if (index !== ids.indexOf(input.id)) return false
  if (editable(list, input.id) !== (input.id !== "decisions" && ids.includes(input.id))) return false
  if (pageIdOf(input.id) !== (input.id === "designs" ? "designs/index" : input.id)) return false
  if (wikiHref(input.id, input.hash) !== "/wiki/" + input.id + (input.hash === "" ? "" : "#" + input.hash)) return false
  // The longest contained id, the earliest of its length.
  const best = longestIncluded(ids, input.text)
  const contained = ids.map((id, i) => [id, i] as const).filter(([id]) => input.text.includes(id))
  const longest = contained.reduce((top, [id, i]) => top < 0 || id.length > ids[top]!.length ? i : top, -1)
  if (best !== longest) return false
  const prefixed = firstWithPrefix(ids, input.id)
  if (prefixed !== ids.findIndex((id) => id.startsWith(input.id))) return false
  const request = wikiRequest(a, b, c, d)
  if (request !== (!a ? "none" : b ? "direct" : c ? "designs" : d ? "decision" : "index")) return false
  if (wikiUnwritten(a, b, input.reason) !== (a && !b && (input.reason === "conflict" || input.reason === "empty" || input.reason === "connect"))) return false
  const verdict = fixtureVerdict(input.op, a, b, c, d, e)
  const expected = input.op === "read" ? (a ? "read" : "missing") : b ? "invalid" : !a ? "missing" : c ? "empty" : input.op === "draft" ? "draft" : d ? "conflict" : e ? "empty" : "write"
  if (verdict !== expected) return false
  if (reviewNumber(input.reviews) !== 1001 + input.reviews) return false
  const status = wikiRefusalStatus(input.reason)
  const named = { forbidden: 403, "sign-in": 401, connect: 401, missing: 404, unknown: 409, conflict: 409, empty: 400, invalid: 400, fork: 400, install: 400 } as Record<string, number>
  if (status !== (named[input.reason] ?? 503)) return false
  // The generated pages: a known page's path and lookup, an unknown one's absence, and the scripted agent's request.
  const page = pages[input.reviews % pages.length]!
  const path = wikiPath(f ? `/wiki/${page.id}.md` : page.id + (input.hash === "" ? "" : "#" + input.hash))
  if (path !== wikiHref(page.id, f ? "" : input.hash)) return false
  if (wikiPath(`/wiki/${page.id}#Bad Hash`) !== undefined || wikiPath("/wiki/no-such-page") !== undefined || wikiPath("/wiki/") !== wikiHref("index", "")) return false
  if (wikiPage(`/wiki/${page.id}#x`) !== page || wikiPage(page.id) !== undefined || wikiPage("/wiki/no-such-page") !== undefined) return false
  if (wikiEditable(page.id) !== (page.id !== "decisions")) return false
  const asked = requestedWiki(f ? `Open the wiki page ${page.id}` : e ? "Open the wiki designs" : d ? "Open wiki decision 0015" : c ? "open the wiki 9999" : "Open the wiki")
  if (asked === undefined && !(c && !f && !e && !d)) return false
  return requestedWiki("no request here") === undefined
}))

const BUILD_TOKENS = ["\n", "\r", "\u2028", "# ", "#", " ", "a", "B", "VL-", "VL-1", "7", "2026-", "01", "-", "2026-01-01", "2026-1-01", "Status:", "**", "Rulings:", "accepted", "ACCEPTED"] as const
const BuildInput = Schema.Struct({
  text: Schema.Array(Schema.Literals(BUILD_TOKENS)).check(Schema.isMaxLength(30)), at: Int,
  key: Schema.Literals(["Status:", "Rulings:", "a", "VL-"]), word: Schema.Literals(["accepted", "a", "superseded"]),
  id: Schema.Literals(["", "decisions/", "decisions/x", "decisions/0015", "decisions/0015-fuzzing", "decisions/015-x", "decisions/0015x"]),
})

/**
 * The wiki build's scans (src/core/wikiBuildDecision.vibe): each loop the build runs equals the recursive
 * specification its proof names, and both equal the regular expression the build used before. The proofs model
 * strings; this checks the emitted JavaScript on drawn pages, from every start including before and past the text.
 */
it.live("decisions/wiki-build", () => run("decisions/wiki-build", BuildInput, (input) => {
  const text = input.text.join("")
  const at = input.at - 2
  const { key, word } = input
  const terminator = (from: number) => {
    for (let i = from; i < text.length; i++) if (/[\n\r\u2028\u2029]/.test(text[i]!)) return i
    return text.length
  }
  const line = at < 0 || at >= text.length ? at : terminator(at)
  if (findLineEnd(text, at) !== line || lineEnd(text, at) !== line) return false
  const heading = /^# (.+)$/m.exec(text)
  if (findHeading(text) !== firstHeading(text, 0) || findHeading(text) !== (heading === null ? -1 : heading.index)) return false
  if (headingTitle(text) !== (heading?.[1] ?? "")) return false
  // From any start: the first heading line that starts at or after it.
  const later = /^# (.+)$/gm
  later.lastIndex = Math.max(at, 0)
  const next = at < 0 || at >= text.length ? null : later.exec(text)
  if (firstHeading(text, at) !== (next === null ? -1 : next.index)) return false
  const keyed = at < 0 ? -1 : text.indexOf(key, at)
  if (findKey(text, key) !== text.indexOf(key) || keyFrom(text, 0, key) !== text.indexOf(key) || keyFrom(text, at, key) !== keyed) return false
  const feed = at < 0 || at >= text.length ? at : text.indexOf("\n", at) < 0 ? text.length : text.indexOf("\n", at)
  if (findFeed(text, at) !== feed || feedFrom(text, at) !== feed) return false
  const digits = at < 0 ? at : at + (/^[0-9]*/.exec(text.slice(at))![0].length)
  if (findDigitsEnd(text, at) !== digits || digitsEnd(text, at) !== digits) return false
  const ruling = at < 0 ? null : /^VL-[0-9]+/.exec(text.slice(at))
  const ended = ruling === null ? -1 : at + ruling[0].length
  if (findRulingEnd(text, at) !== ended || rulingEnd(text, at) !== ended) return false
  const rulings = text.match(/VL-[0-9]+/g) ?? []
  const after = at < 0 ? [] : text.slice(at).match(/VL-[0-9]+/g) ?? []
  if (JSON.stringify(findRulings(text)) !== JSON.stringify(rulings) || JSON.stringify(rulingsFrom(text, 0)) !== JSON.stringify(rulings) || JSON.stringify(rulingsFrom(text, at)) !== JSON.stringify(after)) return false
  const folded = new RegExp(word, "i").test(text)
  const here = at >= 0 && at + word.length <= text.length
  if (findFolded(text, word) !== folded || foldedIncludes(text, 0, word) !== folded || foldedIncludes(text, at, word) !== (here && new RegExp(word, "i").test(text.slice(at)))) return false
  if (foldedAt(text, at, word, 0) !== (here && text.slice(at, at + word.length).toLowerCase() === word) || foldedAt(text, at, word, word.length) !== here) return false
  const date = /2026-[0-9]{2}-[0-9]{2}/.exec(text)?.[0] ?? ""
  if (findDate(text) !== date || firstDate(text, 0) !== date || firstDate(text, at) !== (at < 0 ? "" : /2026-[0-9]{2}-[0-9]{2}/.exec(text.slice(at))?.[0] ?? "")) return false
  return decisionLabel(input.id) === (input.id.length >= 10 ? input.id.slice(10).replace(/^([0-9]{4})-/, "$1 ") : "")
}))
