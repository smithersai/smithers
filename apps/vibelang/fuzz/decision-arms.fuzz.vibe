// src/web's pure decisions with arms that no app path reaches in every run, or at all (screenKept is a proof lemma;
// roleRank's unknown name is never asked, as roleDialog ranks only a found person): each is called in every execution
// over fixed values that take every arm, with drawn text in the free strings, and must agree with its written contract
// (0015, eighteenth session).
import { it } from "@effect/vitest"
import * as AccountView from "../src/web/accountViewDecision.vibe"
import * as ActionFollow from "../src/web/actionFollowDecision.vibe"
import { actionsOf, completions, initial as initialActions, resultText } from "../src/web/actionModel.vibe"
import { accountOf, init, type Model } from "../src/web/main.vibe"
import { escapeWrite, escapeWritesIssues, screenKept, wikiFailedWrite } from "../src/web/modelWrite.vibe"
import { escapeScreen, wikiDraft, wikiRequest } from "../src/web/screenRead.vibe"
import { initialIssues, issuesUpdate } from "../src/web/issues.vibe"
import { historyRefusal } from "../src/history/flowMachine.vibe"
import { Note, Start } from "../src/history/flows.vibe"
import * as HistoryViewD from "../src/web/historyViewDecision.vibe"
import * as IssuesView from "../src/web/issuesViewDecision.vibe"
import * as Markdown from "../src/web/markdownDecision.vibe"
import * as ModelD from "../src/web/modelDecision.vibe"
import * as Pane from "../src/web/paneDecision.vibe"
import * as Screen from "../src/web/screenDecision.vibe"
import * as Tour from "../src/web/tourDecision.vibe"
import * as UpdateD from "../src/web/updateDecision.vibe"
import * as ViewD from "../src/web/viewDecision.vibe"
import * as WikiEditor from "../src/web/wikiEditorDecision.vibe"
import * as WikiView from "../src/web/wikiViewDecision.vibe"
import { run, same, Finding, Text } from "./run.vibe"

const Input = Schema.Struct({ text: Text, other: Text, height: Schema.Int.check(Schema.isBetween({ minimum: 0, maximum: 1000000 })) })

/** A Finding named `name` unless `holds`. */
effect function check(name: string, holds: boolean) {
  if (!holds) throw new Finding({ report: name })
}

const ROLES = ["viewer", "new", "community", "contributor", "maintainer"] as const
const POST = [["empty", "Empty message"], ["too-long", "Message too long"], ["duplicate", "Already sent"], ["busy", "Agent busy"], ["not-replying", "Answer unavailable"], ["full", "Conversation full"], ["connection", "Connection lost"]] as const
const WIKI = [["forbidden", "Not allowed."], ["conflict", "The page changed. Reload the editor."], ["connect", "Connect GitHub."], ["sign-in", "Connect GitHub."], ["fork", "Fork on GitHub."], ["install", "Install Smithers on your fork."]] as const
const RETRIES = [["grant", "Role change failed.", "command"], ["people", "People couldn’t load.", "command"], ["sign-out", "Sign out failed.", "command"], ["sign-in", "Sign-in failed. GitHub didn’t answer.", "sign-in"], ["roles", "Sign-in failed. GitHub didn’t answer.", "resume"]] as const
const NUMBERS = ["", "0", "7", "07", "12", "1a", "a1", "3d", "12w", "d", "0w", "3x", "a3d", "3dd"]

/** The text a contract names for `key`, else `otherwise`. */
function named(table: ReadonlyArray<readonly [string, string]>, key: string, otherwise: string): string {
  return table.find(([name]) => name === key)?.[1] ?? otherwise
}

it.live("web/decision-arms", () => run("web/decision-arms", Input, ({ text, other, height }) => effect {
  // Words: every named reason, and drawn text.
  for (const reason of [...POST.map(([name]) => name), text]) try check(`postFailure ${reason}`, ViewD.postFailure(reason) === named(POST, reason, "Send failed"))
  for (const reason of [...WIKI.map(([name]) => name), text]) try check(`wikiEditErrorText ${reason}`, Pane.wikiEditErrorText(reason) === named(WIKI, reason, "Couldn't save. Retry."))
  for (const [retry, words, plan] of RETRIES) {
    try check(`accountFailureText ${retry}`, ModelD.accountFailureText(retry) === words)
    try check(`accountRetryPlan ${retry}`, ModelD.accountRetryPlan(retry) === plan)
  }
  for (const code of ["input", "forbidden", text]) for (const op of ["run", "cancel", "load"]) {
    const expected = code === "input" ? "Input isn't valid." : code === "forbidden" ? "Not allowed." : op === "run" ? "Couldn't start the run." : op === "cancel" ? "Couldn't cancel the run." : "Couldn't load runs"
    try check(`actionFailureText ${code} ${op}`, ModelD.actionFailureText(code, op) === expected)
  }
  for (const status of ["Accepted", "Proposed", text]) try check(`wikiStatusClass ${status}`, WikiView.wikiStatusClass(status) === (status === "Accepted" ? "sui-badge sui-badge-success" : "sui-badge sui-badge-outline"))
  for (const query of ["", text]) for (const kind of ["Tasks", "VIPs", "All"]) for (const state of ["open", "closed"]) {
    const expected = query !== "" ? "No matches" : kind === "Tasks" ? "No tasks committed" : kind === "VIPs" ? "No VIPs in review" : "No " + state + " issues"
    try check(`emptyTitle ${kind} ${state}`, IssuesView.emptyTitle(query, kind, state) === expected)
  }
  for (const [rank, role] of ROLES.entries()) try check(`roleRank ${role}`, AccountView.roleRank(role) === rank)
  for (const role of ["", text]) if (!(ROLES as ReadonlyArray<string>).includes(role)) try check("roleRank of an unknown name", AccountView.roleRank(role) === -1)
  // Numbers and ages: the contracts' character classes.
  for (const value of [...NUMBERS, text]) {
    try check(`digits ${value}`, IssuesView.digits(value) === /^[0-9]+$/.test(value))
    try check(`compactAge ${value}`, IssuesView.compactAge(value) === /^[0-9]+[dw]$/.test(value))
    try check(`positiveDecimal ${value}`, ViewD.positiveDecimal(value) === /^[1-9][0-9]*$/.test(value))
  }
  for (const unit of ["&", "<", ">", "\"", "a", ...Array.from(text.slice(0, 4))]) {
    const expected = unit === "&" ? "&amp;" : unit === "<" ? "&lt;" : unit === ">" ? "&gt;" : unit === "\"" ? "&quot;" : unit
    if (unit.length === 1) try check(`escapedUnit ${unit.charCodeAt(0)}`, Markdown.escapedUnit(unit.charCodeAt(0), unit) === expected)
  }
  for (const page of [false, true]) for (const clientHeight of [0, 45, 46, 1000, height]) {
    try check(`keyScrollTop ${page} ${clientHeight}`, Screen.keyScrollTop(page, clientHeight) === (page ? -Math.max(40, Math.floor(clientHeight * 0.875)) : -40))
  }
  for (const count of [1, 3]) for (let index = 0; index < count; index++) for (const key of ["j", "k", text === "j" || text === "k" ? "x" : text]) {
    const expected = key === "j" ? Math.min(count - 1, index + 1) : key === "k" ? Math.max(0, index - 1) : -1
    try check(`rowFocus ${index}/${count} ${key}`, IssuesView.rowFocus(index, count, key) === expected)
  }
  // An event's age: as given when blank, absolute or just now; spelled out when long and compact; else "… ago".
  for (const absolute of [false, true]) for (const long of [false, true]) for (const age of ["", "just now", "1d", "3d", "1w", "12w", "yesterday", text]) {
    const compact = /^[0-9]+[dw]$/.test(age)
    const count = age.slice(0, -1)
    const expected = age === "" || absolute || age === "just now" ? age : !long || !compact ? `${age} ago` : `${count}${age.endsWith("d") ? " day" : " week"}${count === "1" ? "" : "s"} ago`
    try check(`ageText ${absolute} ${long} ${age}`, IssuesView.ageText(absolute, age, long) === expected)
  }
  // Booleans: every combination.
  for (const live of [false, true]) for (const unavailable of [false, true]) try check("signInRefused", ModelD.signInRefused(live, unavailable) === (live && unavailable))
  for (const tour of [false, true]) for (const paused of [false, true]) {
    try check("pauseTour", same(Tour.pauseTour(tour, paused), { action: !tour ? "none" : paused ? "resume" : "pause", step: 0 }))
  }
  for (const found of [false, true]) for (const error of ["", text || "x"]) {
    try check("answerAnnouncement", Screen.answerAnnouncement(found, error, other, "before") === (found ? (error === "" ? other : "Answer failed") : "before"))
  }
  for (const id of ["", "e-1"]) for (const known of [false, true]) try check("wikiAfterEvent", UpdateD.wikiAfterEvent(id, known, other) === (id !== "" ? id : known ? other : ""))
  // Screens: the tour's failure and completion keep everything they do not name.
  const screen: Screen.ScreenState = { surface: "chat", palette: true, tour: true, tourError: "", docs: "max", following: true }
  for (const reason of ["busy", text]) for (const touring of [false, true]) {
    const keep = reason === "busy" && touring
    try check("failedTourKeepsControl", Screen.failedTourKeepsControl(reason, touring) === keep)
    try check("failScreenTour", same(Screen.failScreenTour(screen, reason, touring), { ...screen, tour: keep, tourError: reason, docs: keep ? "max" : "pane" }))
  }
  for (const toured of [false, true]) for (const kind of ["ReplyFinished", "WalkthroughDriven"]) {
    try check("completeScreenTour", same(Screen.completeScreenTour(screen, toured, kind), { ...screen, tour: toured ? false : screen.tour, docs: toured && kind !== "ReplyFinished" ? "pane" : screen.docs }))
  }
  // An absent actions epoch is epoch zero on either side; a failed tour end keeps the docs maximized only while this
  // tab still tours, else leaves them as they were.
  for (const incoming of [null, 0, 3]) for (const current of [null, 0, 3]) {
    try check(`actionsEpochCurrent ${incoming} ${current}`, ModelD.actionsEpochCurrent(incoming, current) === ((incoming ?? 0) === (current ?? 0)))
    try check(`actionsFailureApplies ${incoming} ${current}`, ModelD.actionsFailureApplies(incoming, current) === (incoming === null || incoming === (current ?? 0)))
  }
  for (const touring of [false, true]) for (const docs of ["pane", "max"] as const) {
    try check(`failedScreenEnd ${touring} ${docs}`, same(Screen.failedScreenEnd({ ...screen, docs }, touring), { ...screen, tour: touring, docs: touring ? "max" : docs }))
  }
  // A run's place in the list is found past runs with other ids, and a new run has none.
  const clocks = ["a", "b", "c"].map((id) => ({ id: `${id}${text}`, state: "running", at: 1, started: 1 }))
  const started = [["a", 1], ["b", 3], ["c", 2]].map(([id, at]) => ({ id: `${id}${text}`, state: "running", at: 1, started: at as number }))
  try check("newestFirst", same(ModelD.newestFirst(started).map((run) => run.id), [`b${text}`, `c${text}`, `a${text}`]))
  try check("runIndex", ModelD.runIndex(clocks, `c${text}`) === 2 && ModelD.runIndex(clocks, `a${text}`) === 0 && ModelD.runIndex(clocks, `d${text}`) === -1 && ModelD.runIndex([], other) === -1)
  // A loaded history without epics is empty whatever else is set; a wiki submit is ignored while busy, unchanged
  // without an edit, and otherwise saved, proposed or refused by the person's rights.
  try check("historyBody empty", HistoryViewD.historyBody("ready", 0, true, true, false, true, true) === "empty" && HistoryViewD.historyBody("ready", 1, false, false, false, false, false) === "list")
  for (const [busy, edited, save, propose, plan] of [[true, true, true, true, "ignore"], [false, false, true, true, "no-changes"], [false, true, true, true, "save"], [false, true, false, true, "propose"], [false, true, false, false, "refuse"]] as const) {
    try check(`wikiSubmitPlan ${plan}`, Pane.wikiSubmitPlan(busy, edited ? `${text}!` : text, text, save, propose) === plan)
  }
  // An accepted sandbox action keeps a maximized docs pane maximized and opens any other at pane size.
  for (const docs of ["pane", "max"] as const) {
    const sandbox: Pane.SandboxScreen = { surface: "splash", palette: true, docs, pane: "closed", operation: "", busy: false, error: "e", request: 4, draft: text }
    try check(`startSandboxAction ${docs}`, same(Pane.startSandboxAction(sandbox, "command", 2), { state: { ...sandbox, surface: "chat", palette: false, docs: "pane", pane: docs, operation: "command", busy: true, error: "", request: 5, draft: "" }, commands: [{ type: "SandboxAction", request: 5, kind: "command", generation: 2, command: text }] }))
  }
  // Panes: a polled answer leaves a waiting operation alone; the editor keeps typed text, else the draft, else the source.
  for (const operation of ["", "start"] as const) for (const opens of [false, true]) {
    const state: Pane.SandboxResult = { pane: "closed", operation, busy: operation !== "", error: "e" }
    const pane = opens ? "pane" : state.pane
    try check(`polledSandbox ${operation} ${opens}`, same(Pane.polledSandbox(state, opens), operation === "" ? { ...state, pane, operation: "", busy: false, error: "" } : { ...state, pane }))
    try check(`polledFailure ${operation}`, same(Pane.polledFailure(state, other), operation === "" ? { ...state, busy: false, error: other } : state))
  }
  for (const typed of [false, true]) for (const draft of ["", "# Draft"]) {
    const editing: Pane.WikiEditScreen = { page: "p", base: "old", text: typed ? `old${text}!` : "old", busy: false, error: "" }
    const expected = editing.text !== editing.base ? editing.text : draft === "" ? other : draft
    try check(`beganWikiEdit ${typed} ${draft}`, same(Pane.beganWikiEdit(editing, other, draft), { ...editing, base: other, text: expected }))
  }
  // A started run follows the panel only while it shows a run.
  for (const shown of ["", "run-1"]) {
    const selection: ModelD.RunSelection = { step: "s", run: shown, selected: "a", open: true, maximized: false }
    try check(`followedRun ${shown}`, same(ModelD.followedRun(selection, "run-2", other), shown === "" ? selection : { ...selection, step: "", run: "run-2", selected: other }))
  }
  // The slash menu offers the page's mode switch only when it knows the mode; a refused write's result reads as its reason.
  const open = { ...initialActions, slash: true }
  try check("completions without a mode", completions({ actions: open, draft: "/" }).length === 0 && completions({ actions: open, draft: "/", mode: "live" }).some((entry) => entry.command === "/mock"))
  try check("resultText", resultText(JSON.stringify({ id: "m1", refusal: "forbidden" }), other) === historyRefusal("forbidden") && resultText(JSON.stringify({ id: "m1", refusal: null }), other) === JSON.stringify({ id: "m1", refusal: null }) && resultText(other, other) === other)
  // A blank lane or note only the agent sends is refused as `empty`; the answer names the field its flow needs.
  const blank = JSON.stringify({ id: "m1", refusal: "empty" })
  try check("resultText empty", resultText(blank, Start._tag) === "Needs a lane." && resultText(blank, Note._tag) === "Needs text." && resultText(blank, "vibelang/history/Fold") === historyRefusal("empty"))
  // A specification revision is sent with the revision it revises (0 before any).
  const revise = issuesUpdate({ ...initialIssues, role: "maintainer", status: "ready", screen: "specification", comment: other || "x" }, "spec-revise", other || "x")
  try check(`spec-revise ${JSON.stringify(revise.request ?? null)}`, revise.request?.op === "spec-revise" && revise.request.revision === 0)
  // An action that failed is sent again as saved, with its key and serial, when the reader repeats it.
  const failed = { ...initialIssues, role: "maintainer" as const, status: "ready" as const, screen: "detail" as const, selected: 3, comment: other || "x", serial: 4 }
  for (const [action, value, saved] of [
    ["comment", other, { op: "comment", number: 3, parent: 0, title: "", text: other || "x", example: "", prior: "", assignee: "VibeLang agent", key: "-4" }],
    ["spec-review", "sol", { op: "spec-review", number: 3, parent: 0, title: "", text: "", example: "", prior: "", assignee: "VibeLang agent", key: "-4", revision: 2, reviewer: "sol" }],
  ] as const) {
    const repeated = issuesUpdate({ ...failed, retry: saved }, action, value)
    try check(`resend ${action}`, repeated.request === saved && repeated.ui.retry === saved && repeated.ui.busy && repeated.ui.serial === 4 && IssuesView.issueUpdatePlan("saved", true) === "resend")
  }
  for (const loading of [false, true]) for (const error of [false, true]) for (const matches of [false, true]) for (const found of [false, true]) {
    try check(`wikiContent ${loading} ${error} ${matches} ${found}`, WikiView.wikiContent(loading, error, matches, found) === (loading ? "loading" : error ? "error" : !matches ? "empty" : found ? "page" : "none"))
  }
  // The two proof lemmas of modelWrite: Escape writes the issues screen exactly when the proved write changes one the
  // page has; writing back the screen just read changes nothing.
  const home = init({ session: "pane", mode: "mock", name: other }).model
  const screens: ReadonlyArray<Model> = [
    (({ issues: _issues, ...rest }) => rest)(home), { ...home, issues: { ...initialIssues, open: true, dialog: "" } },
    { ...home, issues: { ...initialIssues, open: true, dialog: "split" } }, { ...home, issues: { ...initialIssues, open: false, dialog: "" } },
  ]
  for (const [index, page] of screens.entries()) for (const route of ["tour", "palette", "docs", "splash"] as const) for (const wikiPane of [false, true]) {
    const account = accountOf(page)
    const actions = actionsOf(page)
    const written = escapeWrite(page, account, actions, page.issues ?? initialIssues, UpdateD.pressedEscape(escapeScreen(page, account, actions), route, wikiPane))
    const changes = page.issues !== undefined && JSON.stringify(written.issues) !== JSON.stringify(page.issues)
    try check(`escapeWritesIssues ${index} ${route} ${wikiPane}`, escapeWritesIssues(page, account, actions, route, wikiPane) === changes)
    try check(`screenKept ${index}`, same(screenKept(page), page))
  }
  // A saved page replaces what was known of it and comes last, once.
  const pages: ReadonlyArray<WikiEditor.WikiPage> = [{ id: "a", source: "A", revision: "1" }, { id: "p", source: "P", revision: "1" }, { id: "b", source: text, revision: "2" }]
  try check("savedWikiPages", same(WikiEditor.savedWikiPages(pages, "p", other, "3"), [pages[0], pages[2], { id: "p", source: other, revision: "3" }]))
  try arms(text, other, home, failed)
  return true
}))

/**
 * Arms the full runs at seeds 20261286 and 20261287 reached in only one seed or neither (0015, twentieth session):
 * the action follow's uncertainty (#5348), a demotion, the People size control, a repeated issue request, the issue
 * form's steps and kind keys, and the wiki editor's waiting submission, failure and request round trip.
 */
effect function arms(text: string, other: string, home: Model, failed: typeof initialIssues) {
  const runs = [{ id: "q", state: "queued" }, { id: "r", state: "running" }, { id: "p", state: "passed" }]
  for (const id of ["q", "r", "p", "x"]) for (const known of [[], ["q"], ["r"], ["q", "r"]] as ReadonlyArray<ReadonlyArray<string>>) {
    const live = id === "q" || id === "r"
    try check(`ActionFollow.failed ${id} ${known}`, same(ActionFollow.failed(known, id, runs), !live || known.includes(id) ? known : [...known, id]))
  }
  for (const known of [[], ["q", "p"], ["p", "x", "r"]] as ReadonlyArray<ReadonlyArray<string>>) {
    try check(`ActionFollow.settled ${known}`, same(ActionFollow.settled(known, runs), known.filter((id) => id !== "p")))
  }
  for (const [left, right, equal] of [[[], [], true], [["a"], [], false], [["a", "b"], ["a", "b"], true], [["a", "b"], ["a", "c"], false], [["a"], ["b"], false]] as const) {
    try check(`ActionFollow.same ${left} ${right}`, ActionFollow.same(left, right) === equal)
  }
  for (const found of [false, true]) for (const [person, target] of [["maintainer", "contributor"], ["contributor", "maintainer"], ["maintainer", "maintainer"]] as const) {
    const verb = found && AccountView.roleRank(target) < AccountView.roleRank(person) ? "Demote" : "Promote"
    try check(`roleDialog ${found} ${person} ${target}`, AccountView.roleDialog(found, person, target, "t", "").verb === verb && (found && person === "maintainer" && target === "contributor") === (verb === "Demote"))
  }
  try check("peopleToggled", ModelD.peopleToggled("max") === "pane" && ModelD.peopleToggled("pane") === "max")
  for (const action of ["retry", "spec-review", "spec-revise", "comment", text]) for (const hasRetry of [false, true]) {
    const expected = action === "retry" && hasRetry ? "retry" : action === "spec-review" ? "spec-review" : action === "spec-revise" ? "spec-revise" : "op"
    try check(`issueRequestKind ${action} ${hasRetry}`, IssuesView.issueRequestKind(action, hasRetry) === expected)
  }
  for (let index = 0; index < 4; index++) for (const key of ["ArrowRight", "ArrowLeft", text.startsWith("Arrow") ? "x" : text]) {
    try check(`kindKey ${index} ${key}`, IssuesView.kindKey(index, key) === (key === "ArrowRight" ? (index + 1) % 4 : key === "ArrowLeft" ? (index + 3) % 4 : -1))
  }
  for (const vip of [false, true]) for (const step of [1, 2, 3, 4]) {
    const form = IssuesView.issueForm(vip, step)
    try check(`issueForm ${vip} ${step}`, form.submit === (vip ? (step < 4 ? "continue" : "propose") : "new") && form.label === (vip ? (step < 4 ? "Continue" : "Submit VIP") : "New issue"))
  }
  // Retry resends the saved request under its own key, with a fresh recovery key.
  const saved = { op: "comment" as const, number: 3, parent: 0, title: "", text: other || "x", example: "", prior: "", assignee: "VibeLang agent", key: "-4" }
  const retried = issuesUpdate({ ...failed, retry: saved, error: "e" }, "retry", "")
  try check(`issues retry ${JSON.stringify(retried.request ?? null)}`, retried.request !== undefined && same({ ...retried.request, recovery: undefined }, { ...saved, recovery: undefined }) && typeof retried.request.recovery === "string" && retried.request.recovery.endsWith(`-${retried.ui.serial}`))
  // The wiki editor: a waiting submission resends with a new recovery key; a failure clears it only when unwritten.
  const editing: Pane.WikiEditScreen = { page: "p", base: "b", text, busy: true, error: "" }
  const waiting: WikiEditor.WikiDraft = { op: "save", page: "p", base: "a", text: other, key: "k1", recovery: "" }
  for (const isWaiting of [false, true]) {
    const step = WikiEditor.submittedWikiEdit(editing, "save", 2, isWaiting, waiting, "k2", "r2")
    try check(`submittedWikiEdit ${isWaiting}`, step.serial === 3 && same(step.submission, isWaiting ? { ...waiting, recovery: "r2" } : { op: "save", page: "p", base: "b", text, key: "k2", recovery: "" }))
  }
  for (const unwritten of [false, true]) {
    const failure = Pane.failedWikiEdit(editing, other, unwritten)
    try check(`failedWikiEdit ${unwritten}`, failure.submission === (unwritten ? "clear" : "keep") && same(failure.state, { ...editing, busy: false, error: other }))
    const model = { ...home, wikiEdit: { ...editing, submission: { op: "save" as const, page: "p", base: "a", text: other, key: "k1" } } }
    const written = wikiFailedWrite(model, model.wikiEdit, failure.state, unwritten)
    try check(`wikiFailedWrite ${unwritten}`, (written.wikiEdit?.submission === undefined) === unwritten && written.wikiEdit?.error === other)
  }
  try check("wikiDraft none", same(wikiDraft(undefined), { op: "save", page: "", base: "", text: "", key: "", recovery: "" }))
  for (const recovery of [undefined, "r1"]) {
    const request = { op: "save" as const, page: "p", base: "b", text: other, key: "k", ...(recovery === undefined ? {} : { recovery }) }
    const draft = wikiDraft(request)
    try check(`wikiDraft ${recovery}`, draft.recovery === (recovery ?? "") && same(wikiRequest(draft), request))
  }
}
