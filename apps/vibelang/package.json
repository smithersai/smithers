{
  "name": "@smthrs/vibelang-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "vibelang.smithers.sh, the VibeLang factory: a Foldkit app written in VibeLang on Effect, served by Cloudflare and deployed by Alchemy.",
  "scripts": {
    "setup": "pnpm install --config.minimum-release-age-exclude='vibelang*' --config.minimum-release-age-exclude='@smthrs/*'",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vibelang -p tsconfig.json --noEmit",
    "test": "pnpm build:surfaces && vitest run",
    "e2e": "playwright test",
    "plan": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy plan --stage prod",
    "deploy": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy deploy --stage prod",
    "build:surfaces": "vibelang -p tsconfig.surfaces.json && chmod +x dist-factory/surfaces/*-entry.js",
    "cli": "pnpm build:surfaces && node dist-factory/surfaces/cli-entry.js",
    "mcp": "pnpm build:surfaces >&2 && node dist-factory/surfaces/mcp-entry.js"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.1",
    "@smthrs/ui-css": "link:../../packages/smithers/ui/ui-css",
    "@smthrs/ui-styleguide": "link:../../packages/smithers/ui/ui-styleguide",
    "effect": "4.1.1",
    "foldkit": "0.170.0",
    "vibelang-runtime": "0.0.12"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.6.6",
    "alchemy": "2.0.0-beta.85",
    "happy-dom": "20.14.6",
    "vibelang": "0.0.12",
    "vibelang-vite": "0.0.12",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "bin": {
    "vibelang-factory": "dist-factory/surfaces/cli-entry.js"
  }
}
