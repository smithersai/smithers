{
  "name": "@smthrs/vibelang-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "vibelang.smithers.sh, the VibeLang factory: a Foldkit app written in VibeLang on Effect, served by Cloudflare and deployed by Alchemy.",
  "scripts": {
    "dev": "pnpm wiki:build && vite",
    "build": "pnpm wiki:build && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "pnpm wiki:build && vibelang -p tsconfig.json --noEmit && vibelang -p worker/tsconfig.json --noEmit",
    "test": "pnpm build:surfaces && pnpm build:scripts && vitest run",
    "test:workerd": "pnpm build && pnpm build:surfaces && vitest run --mode workerd",
    "e2e": "playwright test",
    "plan": "pnpm wiki:build && NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy plan --stage prod",
    "deploy": "pnpm wiki:build && NODE_OPTIONS=\"${NODE_OPTIONS:-} --import=vibelang/register\" alchemy deploy --stage prod",
    "build:surfaces": "pnpm wiki:build && vibelang -p tsconfig.surfaces.json && chmod +x dist-factory/surfaces/*-entry.js",
    "agent-context": "pnpm build:scripts && node dist-scripts/agent-context.js",
    "mythical-seed": "node --import=vibelang/register scripts/mythical-seed.vibe",
    "cli": "pnpm build:surfaces && node dist-factory/surfaces/cli-entry.js",
    "mcp": "pnpm build:surfaces >&2 && node dist-factory/surfaces/mcp-entry.js",
    "verify": "bash verify/check.sh",
    "verify:broken": "bash verify/broken.sh",
    "build:scripts": "vibelang -p tsconfig.scripts.json && vibelang -p tsconfig.script-tests.json && ln -sfn ../node_modules dist-script-tests/node_modules",
    "bench": "pnpm build:surfaces && pnpm build:scripts && BENCH_COVERAGE=0 vitest bench --run --config bench/config.ts",
    "bench:coverage": "pnpm build:surfaces && pnpm build:scripts && BENCH_COVERAGE=1 vitest run --config bench/coverage.config.ts --coverage && node bench/merge-coverage.ts",
    "bench:live": "BENCH_LIVE=1 playwright test --config bench/playwright.config.ts",
    "bench:browser": "BENCH_LIVE=0 playwright test --config bench/playwright.config.ts",
    "fuzz": "pnpm --workspace-root exec node --import=vibelang/register .smithers/flows/vibelang-fuzz/main.vibe",
    "fuzz:coverage": "FUZZ_COVERAGE=1 pnpm fuzz",
    "test:coverage": "pnpm test --coverage",
    "e2e:coverage": "E2E_COVERAGE_GATE=1 playwright test",
    "wiki:build": "node --import=vibelang/register scripts/wiki.vibe"
  },
  "dependencies": {
    "@smthrs/agent": "workspace:*",
    "@smthrs/control": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "@smthrs/engine": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/integrations": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/model-host": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/platform-cloudflare": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/sandbox": "workspace:*",
    "@smthrs/ui-css": "workspace:*",
    "@smthrs/ui-styleguide": "workspace:*",
    "effect": "4.1.1",
    "foldkit": "0.170.0",
    "vibelang-runtime": "0.0.13"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/platform-node": "4.1.1",
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.62.1",
    "@smthrs/fuzz": "workspace:*",
    "@smthrs/lemmascript": "workspace:*",
    "@smthrs/mvp": "workspace:*",
    "@smthrs/platform-node": "workspace:*",
    "@smthrs/testing": "workspace:*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "alchemy": "2.0.0-beta.85",
    "ast-v8-to-istanbul": "1.0.5",
    "esbuild": "0.28.2",
    "happy-dom": "20.13.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-lib-source-maps": "^5.0.6",
    "istanbul-reports": "^3.2.0",
    "miniflare": "5.20261019.0-beta",
    "vibelang": "0.0.13",
    "vibelang-unplugin": "0.0.13",
    "vibelang-vite": "0.0.13",
    "vite": "8.3.4",
    "vitest": "5.0.0"
  },
  "bin": {
    "vibelang-factory": "dist-factory/surfaces/cli-entry.js"
  }
}
