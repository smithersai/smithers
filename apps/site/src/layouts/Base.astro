---
import "../styles/site.css"
import "../styles/navigation.css"
interface Props {
  title: string
  description: string
  header?: boolean
  footer?: boolean
}
const { title, description, header = true, footer = true } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/media/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/media/og.png", Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    {header && (
      <header class="wrap top">
        <a class="mark" href="/" data-astro-prefetch="hover"><img src="/icon.png" alt="" width="26" height="26" /> Smithers</a>
        <nav class="nav">
          <a href="/docs/" data-astro-prefetch="hover">Documentation</a>
          <a href="/pricing/" data-astro-prefetch="hover">Pricing</a>
          <a href="https://github.com/smithersai/smithers">GitHub</a>
        </nav>
      </header>
    )}
    <slot />
    {footer && (
      <footer class="wrap foot">
        <span>© {new Date().getFullYear()} Smithers</span>
        <a href="/docs/" data-astro-prefetch="hover">Documentation</a>
        <a href="/pricing/" data-astro-prefetch="hover">Pricing</a>
        <a href="https://github.com/smithersai/smithers">Source, MIT</a>
        <a href="https://status.smithers.sh">Status</a>
      </footer>
    )}
  </body>
</html>
