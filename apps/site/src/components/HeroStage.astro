---
/*
 * The hero: one editor frame showing the file-based authoring model. The
 * tree follows this repository's layout. The panes show a reduced workspace
 * declaration and example test and review targets for the engine-store package.
 * Every identifier a pane names is declared in that pane, and every
 * import it makes is used. Clicking a file swaps the pane; directories fold
 * and unfold.
 */
import { Code } from "astro:components"
import nightOwl from "@shikijs/themes/night-owl"

// `.smithers/WORKSPACE.ts` as it stands in this repository, minus the
// comments, the `export` keywords, the Bun toolchain and Nix environment
// used only by the `microsandbox` sandbox, and the `repos:` map of build-CLI
// test fixtures. One runtime, one package manager, one install, one Rust
// toolchain, one cache.
const workspaceSource = `import { Smithers as S } from "@smthrs/targets"

const packageJson = S.file("//package.json")
const workspaceConfig = S.file("//pnpm-workspace.yaml")
const runtime = S.Runtime.Node({ version: ">=26.4.0" })
const packageManager = S.PackageManager.Pnpm({ version: "11.21.0", runtime })
const nodeModules = S.Npm.NodeModules({
  packageJson,
  workspaces: workspaceConfig
})

const rust = S.Rust.Toolchain({
  workspace: S.file("//Cargo.toml"),
  toolchain: S.file("//rust-toolchain.toml"),
  lockfile: S.file("//Cargo.lock")
})

export const Workspace = S.Workspace("smithers", {
  repository: "git+https://github.com/smithersai/smithers.git",
  cache: S.Cache({ directory: ".flows" }),
  runtime,
  packageManager,
  nodeModules,
  toolchains: [rust],
  host: S.Host({ bins: ["git", "jj", "bun", "cargo"] }),
  sandboxes: S.Sandboxes({ default: S.Sandbox.None() })
})`

// Example targets for `packages/smithers/flows/engine-store/PACKAGE.ts`.
// Show the backup test and agentic review directly so readers can see
// what each target does without first learning a package macro.
const packageSource = `import { Smithers } from "@smthrs/targets"

const disasterRecovery = Smithers.NodeTest({
  runner: Smithers.testRunner([Smithers.file("//packages/smithers/flows/engine-store/scripts/flows-backup.test.mjs")]),
  srcs: [
    Smithers.glob("//packages/smithers/flows/engine-store/scripts/flows-backup*.mjs"),
    Smithers.glob("//packages/smithers/flows/engine-store/src/**/*.ts")
  ],
  deps: [],
  cwd: "packages/smithers/flows/engine-store"
})
const reviewChangedFiles = Smithers.LlmLint({
  changes: Smithers.gitDiff({ base: "origin/main" }),
  include: [Smithers.glob("//packages/smithers/flows/engine-store/src/**/*.ts")],
  deps: [],
  prompt: "Review the changed code for bugs.",
  rubric: "Report bugs that could lose saved data. Explain how each bug occurs.",
  engine: "codex",
  model: "gpt-6-luna",
  batchSize: 2,
  failOn: "error"
})

export const Package = Smithers.Package({
  targets: { disasterRecovery, reviewChangedFiles }
})`

const panes = [
  { id: "workspace", name: ".smithers/WORKSPACE.ts", code: workspaceSource },
  { id: "package", name: "packages/smithers/flows/engine-store/PACKAGE.ts", code: packageSource, active: true }
]

const tree = [
  { depth: 0, name: ".smithers/", kind: "dir" },
  { depth: 1, name: "WORKSPACE.ts", kind: "file", pane: "workspace", path: ".smithers/WORKSPACE.ts" },
  { depth: 0, name: "PACKAGE.ts", kind: "file" },
  { depth: 0, name: "packages/", kind: "dir" },
  { depth: 1, name: "engine-store/", kind: "dir" },
  { depth: 2, name: "PACKAGE.ts", kind: "file", pane: "package", path: "packages/smithers/flows/engine-store/PACKAGE.ts", active: true },
  { depth: 2, name: "src/", kind: "dir" },
  { depth: 1, name: "flow/", kind: "dir" },
  { depth: 2, name: "PACKAGE.ts", kind: "file" },
  { depth: 0, name: "flows/", kind: "dir" },
  { depth: 1, name: "review/", kind: "dir" },
  { depth: 2, name: "flow.mdx", kind: "file" },
  { depth: 0, name: ".flows/", kind: "dir", muted: true },
  { depth: 1, name: "cache/", kind: "dir", muted: true }
]
---

<section class="stage" aria-label="Smithers authoring model">
  <div class="frame">
    <div class="chrome"><span></span><span></span><span></span><b data-title>smithers / packages/smithers/flows/engine-store/PACKAGE.ts</b></div>
    <div class="editor">
      <ul class="tree" role="presentation">
        {tree.map((entry, index) => (
          <li style={`--i:${index}; --d:${entry.depth}`}>
            {entry.pane ? (
              <button type="button" class:list={["node", entry.kind, { active: entry.active, muted: entry.muted }]} data-pane={entry.pane} data-path={entry.path}>
                <i></i>{entry.name}
              </button>
            ) : entry.kind === "dir" ? (
              <button type="button" class:list={["node", entry.kind, { muted: entry.muted }]} data-dir aria-expanded="true">
                <i></i>{entry.name}
              </button>
            ) : (
              <span class:list={["node", entry.kind, { active: entry.active, muted: entry.muted }]}>
                <i></i>{entry.name}
              </span>
            )}
          </li>
        ))}
      </ul>
      <div class="code">
        {panes.map((pane) => (
          <div class:list={["pane", { current: pane.active }]} data-pane={pane.id} aria-hidden={pane.active ? "false" : "true"}>
            <Code code={pane.code} lang="ts" theme={nightOwl} />
          </div>
        ))}
        <div class="run">
          <span class="prompt">$</span> smithers-build review <span class="str">//packages/smithers/flows/engine-store</span>
          <span class="caret"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stage { position: relative; margin: 2.4rem auto; width: min(1120px, 100%); --base: 500ms;
    --surface: var(--sl-color-gray-6, #0b253a); --surface-2: var(--sl-color-gray-5, #1d3b53);
    --border: var(--sl-color-gray-5, #1d3b53); --border-strong: var(--sl-color-gray-4, #5f7f97);
    --text-faint: var(--sl-color-gray-3, #8badc1); --font-mono: var(--sl-font-mono, monospace);
    --ease: cubic-bezier(0.22, 0.61, 0.21, 1);
  }
  .stage :global(*) { margin-top: 0; }
  .frame {
    display: block; position: relative; width: 100%;
    aspect-ratio: 16 / 10; border-radius: 16px; background: var(--surface);
    border: 1px solid var(--border-strong); box-shadow: var(--shadow-3); overflow: hidden;
    animation: rise 700ms var(--ease) both;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(24px) scale(0.98); filter: blur(6px); } }

  .chrome { display: flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--surface-2); font-size: 0.75rem; color: var(--text-faint); font-family: var(--font-mono); }
  .chrome span { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .chrome span:nth-child(1) { background: #ef5350; } .chrome span:nth-child(2) { background: #ecc48d; } .chrome span:nth-child(3) { background: #addb67; }
  .chrome b { margin-left: auto; margin-right: auto; font-weight: 500; }

  .editor { display: grid; grid-template-columns: 200px 1fr; height: calc(100% - 34px); min-height: 0; background: #011627; color: #d6deeb; font-family: var(--font-mono); font-size: 0.8rem; }
  .tree { list-style: none; margin: 0; padding: 12px 0; border-right: 1px solid rgb(214 222 235 / 8%); overflow: hidden; }
  .tree li { padding: 0; margin: 0; }
  .node {
    all: unset; box-sizing: border-box; cursor: default; width: 100%;
    padding: 4px 12px 4px calc(12px + var(--d) * 14px); white-space: nowrap;
    display: flex; align-items: center; gap: 6px;
    opacity: 0; transform: translateX(-10px);
    animation: pop 420ms var(--ease) forwards; animation-delay: calc(240ms + var(--i) * 70ms);
  }
  button.node { cursor: pointer; }
  button.node:hover { background: rgb(199 146 234 / 8%); color: #fff; }
  button.node:focus-visible { outline: 2px solid #9bd5c6; outline-offset: -2px; }
  .node.dir::after { content: ""; margin-left: auto; border: 4px solid transparent; border-top-color: currentColor; opacity: 0.55; transition: transform 200ms var(--ease); }
  .tree li.collapsed .node.dir::after { transform: rotate(-90deg); }
  .tree li.hidden { display: none; }
  @keyframes pop { to { opacity: 1; transform: none; } }
  .node i { width: 12px; height: 12px; border-radius: 3px; background: #82aaff; opacity: 0.85; flex: none; }
  .node.dir i { background: #9bd5c6; }
  .node.muted { color: #6f8aa0; } .node.muted i { background: #1d3b53; }
  .node.active { background: rgb(199 146 234 / 14%); color: #fff; }

  .code { position: relative; overflow: auto; padding: 6px 0 0; min-height: 0; }
  .pane { display: none; }
  .pane.current { display: block; }
  .code :global(pre) { margin: 0; padding: 8px 18px 60px; background: transparent !important; border: 0; border-radius: 0; font-size: 0.8rem; line-height: 1.55; overflow: visible; }
  /* inline-block, not block: the newline after each span already breaks the line, and a block span would double the spacing. */
  .code :global(.line) { display: inline-block; opacity: 0; transform: translateX(6px); }
  .pane.current :global(.line) { animation: typed 240ms var(--ease) forwards; animation-delay: calc(var(--base) + var(--n, 0) * 45ms); }
  @keyframes typed { to { opacity: 1; transform: none; } }
  .run { position: absolute; left: 0; right: 0; bottom: 0; padding: 12px 18px; background: linear-gradient(to top, #011627 70%, transparent); color: #d6deeb; opacity: 0; animation: typed 400ms var(--ease) forwards; animation-delay: calc(var(--base) + 1600ms); }
  .prompt { color: #addb67; } .str { color: #ecc48d; }
  .caret { display: inline-block; width: 8px; height: 1em; background: #9bd5c6; vertical-align: text-bottom; margin-left: 4px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { to { opacity: 0; } }

  @media (max-width: 720px) {
    .editor { grid-template-columns: 1fr; }
    .tree { display: none; }
    .frame { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".stage")!
  const title = stage.querySelector<HTMLElement>("[data-title]")!
  const nodes = [...stage.querySelectorAll<HTMLButtonElement>("button.node")]
  const panes = [...stage.querySelectorAll<HTMLElement>(".pane")]

  // Number the highlighted lines so each one can stagger its own reveal.
  for (const pane of panes) {
    pane.querySelectorAll<HTMLElement>(".line").forEach((line, n) => line.style.setProperty("--n", String(n)))
  }

  for (const node of nodes) {
    node.addEventListener("click", () => {
      // Directory buttons only fold; the handler below belongs to file rows.
      if (!node.dataset.pane || node.classList.contains("active")) return
      // The first load eases in slowly; swaps replay immediately.
      stage.style.setProperty("--base", "0ms")
      for (const other of nodes) other.classList.toggle("active", other === node)
      for (const pane of panes) {
        const on = pane.dataset.pane === node.dataset.pane
        pane.classList.toggle("current", on)
        pane.setAttribute("aria-hidden", on ? "false" : "true")
      }
      title.textContent = `smithers / ${node.dataset.path}`
    })
  }

  // Directories collapse and expand. A row's parent is the nearest previous
  // row one depth shallower; a row shows only when no ancestor is collapsed.
  const rows = [...stage.querySelectorAll<HTMLElement>(".tree li")]
  const depths = rows.map((row) => Number(row.style.getPropertyValue("--d")))
  const parents = depths.map((depth, i) => {
    for (let j = i - 1; j >= 0; j--) if (depths[j]! < depth) return j
    return -1
  })
  const collapsed = new Set<number>()
  const applyVisibility = () => {
    rows.forEach((row, i) => {
      let hidden = false
      for (let p = parents[i]!; p !== -1; p = parents[p]!) {
        if (collapsed.has(p)) { hidden = true; break }
      }
      row.classList.toggle("hidden", hidden)
    })
  }
  for (const dir of stage.querySelectorAll<HTMLButtonElement>("[data-dir]")) {
    dir.addEventListener("click", () => {
      const i = rows.indexOf(dir.closest("li")!)
      if (collapsed.has(i)) collapsed.delete(i)
      else collapsed.add(i)
      dir.closest("li")!.classList.toggle("collapsed", collapsed.has(i))
      dir.setAttribute("aria-expanded", collapsed.has(i) ? "false" : "true")
      applyVisibility()
    })
  }
</script>
