  {
    "name": "tui",
    "description": "Open the terminal coding agent",
    "schema": {
      "args": {
        "type": "object",
        "properties": {
          "directory": {
            "description": "Working directory; defaults to cwd",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "options": {
        "type": "object",
        "properties": {
          "model": {
            "description": "Chat seat as provider:model",
            "type": "string"
          },
          "continue": {
            "default": false,
            "description": "Continue the latest session in the directory",
            "type": "boolean"
          },
          "resume": {
            "default": false,
            "description": "Pick a session to continue",
            "type": "boolean"
          },
          "print": {
            "description": "Answer one prompt, print it, and exit",
            "type": "string"
          },
          "approve": {
            "description": "Consequential calls: all, ask, or deny",
            "type": "string",
            "enum": [
              "all",
              "ask",
              "deny"
            ]
          },
          "budgetTokens": {
            "description": "Token cap per turn and worker (default 200M; 0 or none disables)",
            "type": "string"
          },
          "budgetDailyTokens": {
            "description": "Token cap per UTC day on this machine (default 2B; 0 or none disables)",
            "type": "string"
          },
          "box": {
            "description": "Run worker tools in a Smithers Cloud workspace: owner/repo/id",
            "type": "string"
          },
          "environment": {
            "description": "Run the TUI app in a saved execution environment",
            "type": "string"
          },
          "verbose": {
            "default": false,
            "description": "Show redacted diagnostic details",
            "type": "boolean"
          }
        },
        "required": [
          "continue",
          "resume",
          "verbose"
        ],
        "additionalProperties": false
      },
      "globals": {
        "type": "object",
        "properties": {
          "audience": {
            "default": "auto",
            "description": "Presentation audience; auto detects agent harnesses, CI, and terminals",
            "type": "string",
            "enum": [
              "auto",
              "human",
              "agent"
            ]
          },
          "silent": {
            "default": false,
            "description": "Suppress progress; retain the result and actionable failures",
            "type": "boolean"
          },
          "ui": {
            "default": "auto",
            "description": "Terminal renderer: tty draws in place, stream colours without cursor motion, plain prints bare lines; auto shows live human progress; agent, --silent, pipe and dumb-terminal policies take precedence",
            "type": "string",
            "enum": [
              "auto",
              "tty",
              "stream",
              "plain"
            ]
          }
        },
        "required": [
          "audience",
          "silent",
          "ui"
        ],
        "additionalProperties": false
      }
    }
  }
]
