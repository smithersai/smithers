[
  {
    "name": "change list",
    "description": "List changes",
    "schema": {
      "args": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "options": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 10,
            "type": "number",
            "description": "Number of changes to show"
          },
          "repo": {
            "type": "string",
            "description": "Repository (OWNER/REPO)"
          },
          "verbose": {
            "default": false,
            "description": "Show redacted diagnostic details",
            "type": "boolean"
          }
        },
        "required": [
          "limit",
          "verbose"
        ],
        "additionalProperties": false
      },
      "globals": {
        "type": "object",
        "properties": {
          "audience": {
            "default": "auto",
            "description": "Presentation audience; auto detects agent harnesses, CI, and terminals",
            "type": "string",
            "enum": [
              "auto",
              "human",
              "agent"
            ]
          },
          "silent": {
            "default": false,
            "description": "Suppress progress; retain the result and actionable failures",
            "type": "boolean"
          },
          "ui": {
            "default": "auto",
            "description": "Terminal renderer: tty draws in place, stream colours without cursor motion, plain prints bare lines; auto shows live human progress; agent, --silent, pipe and dumb-terminal policies take precedence",
            "type": "string",
            "enum": [
              "auto",
              "tty",
              "stream",
              "plain"
            ]
          }
        },
        "required": [
          "audience",
          "silent",
          "ui"
        ],
        "additionalProperties": false
      }
    }
  },
