  {
    "name": "generate package",
    "description": "Run the workspace's declared package scaffold with its configured defaults",
    "schema": {
      "args": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "options": {
        "type": "object",
        "properties": {
          "workspace": {
            "default": "<cwd>",
            "type": "string"
          },
          "target": {
            "description": "Declared generator label; required when more than one matches",
            "type": "string"
          },
          "plan": {
            "default": false,
            "description": "Show the generator plan without writing files",
            "type": "boolean"
          },
          "verbose": {
            "default": false,
            "description": "Show redacted diagnostic details",
            "type": "boolean"
          }
        },
        "required": [
          "workspace",
          "plan",
          "verbose"
        ],
        "additionalProperties": false
      },
      "globals": {
        "type": "object",
        "properties": {
          "audience": {
            "default": "auto",
            "description": "Presentation audience; auto detects agent harnesses, CI, and terminals",
            "type": "string",
            "enum": [
              "auto",
              "human",
              "agent"
            ]
          },
          "silent": {
            "default": false,
            "description": "Suppress progress; retain the result and actionable failures",
            "type": "boolean"
          },
          "ui": {
            "default": "auto",
            "description": "Terminal renderer: tty draws in place, stream colours without cursor motion, plain prints bare lines; auto shows live human progress; agent, --silent, pipe and dumb-terminal policies take precedence",
            "type": "string",
            "enum": [
              "auto",
              "tty",
              "stream",
              "plain"
            ]
          }
        },
        "required": [
          "audience",
          "silent",
          "ui"
        ],
        "additionalProperties": false
      }
    }
  },
