---
import { getEntry, render } from "astro:content"
import Base from "../layouts/Base.astro"

// Both pricing routes render the same authored content.
const entry = await getEntry("docs", "docs/pricing")
if (!entry) throw new Error("The pricing documentation is missing")
const { Content } = await render(entry)
---
<Base title="Pricing · Smithers" description={entry.data.description ?? "Free, Pro, and Max sandbox plans."}>
  <main class="pricing wrap">
    <p class="eyebrow">Smithers / Pricing</p>
    <h1>Choose your sandbox capacity.</h1>
    <div class="pricing-copy"><Content /></div>
    <a class="btn primary" href="/smithersai/smithers">Open Smithers <span aria-hidden="true">↗</span></a>
  </main>
</Base>
<style>
  .pricing { max-width: 960px; padding-block: clamp(3rem, 7vw, 7rem); }
  .eyebrow { font: .8rem var(--font-mono); color: var(--brand); text-transform: uppercase; letter-spacing: .08em; }
  h1 { max-width: 760px; font-size: clamp(2.75rem, 7vw, 5rem); line-height: 1.05; letter-spacing: -.045em; margin: 1rem 0 2rem; }
  .pricing-copy { max-width: 820px; }
  .pricing-copy :global(h2) { margin: 3rem 0 .85rem; font-size: 1.6rem; letter-spacing: -.025em; }
  .pricing-copy :global(h3) { margin: 1.8rem 0 .65rem; font-size: 1.08rem; }
  .pricing-copy :global(p) { color: var(--text-muted); line-height: 1.75; margin: .8rem 0; }
  .pricing-copy :global(strong) { color: var(--text); }
  .pricing-copy :global(.sl-heading-wrapper) { position: relative; }
  .pricing-copy :global(.sl-anchor-link) { display: none; }
  .pricing-copy :global(a) { color: var(--brand); text-underline-offset: 3px; }
  .pricing-copy :global(table) { display: block; overflow-x: auto; border-collapse: collapse; margin-block: 1.4rem; font-size: .9rem; }
  .pricing-copy :global(th), .pricing-copy :global(td) { text-align: left; padding: 1rem; border-bottom: 1px solid var(--border-strong); min-width: 145px; vertical-align: top; line-height: 1.6; }
  .pricing-copy :global(th) { background: var(--surface); color: var(--text); }
  .pricing-copy :global(td) { color: var(--text-muted); }
  .btn { margin-top: 2rem; }
</style>
