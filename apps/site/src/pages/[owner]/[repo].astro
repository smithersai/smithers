---
/* One app page per available catalog repository, prerendered at /<owner>/<repo>. */
import AppIsland from "../../AppIsland"
import AppShell from "../../layouts/AppShell.astro"
import { AVAILABLE_REPOS } from "../../../../server/src/publicRepoCatalog"

interface Props {
  readonly title: string
}

export function getStaticPaths() {
  return AVAILABLE_REPOS.map((repo) => {
    const [owner, name] = repo.name.split("/")
    return { params: { owner, repo: name }, props: { title: repo.title } satisfies Props }
  })
}
const { title } = Astro.props
---

<AppShell title={title}><div id="root"><AppIsland client:only="react" /></div></AppShell>
