{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // The app imports `electrobun/view`, which no package provides in this
    // tree; astro.config.mjs aliases it to the same web shim for the bundle.
    "paths": {
      "electrobun/view": ["../app/src/mainview/native/electrobun-view.web.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
