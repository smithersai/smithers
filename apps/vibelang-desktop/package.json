{
  "name": "@smthrs/vibelang-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The VibeLang Foldkit app in Electrobun with local durable flows, folders and models.",
  "scripts": {
    "typecheck": "vibelang -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:view": "vite build",
    "build": "pnpm build:view && bun run src/build.vibe && electrobun build",
    "start": "electrobun dev",
    "e2e": "playwright test",
    "verify": "VIBELANG_VERIFY_ROOT=\"$PWD\" bash ../vibelang/verify/check.sh \"$PWD/src/policy.vibe\"",
    "verify:broken": "bun run verify/broken.vibe"
  },
  "dependencies": {
    "@smthrs/agent": "workspace:*",
    "@smthrs/crypto": "workspace:*",
    "@smthrs/engine-store": "workspace:*",
    "@smthrs/flow": "workspace:*",
    "@smthrs/flows": "workspace:*",
    "@smthrs/harness": "workspace:*",
    "@smthrs/kernel": "workspace:*",
    "@smthrs/model": "workspace:*",
    "@smthrs/plan": "workspace:*",
    "@smthrs/platform-bun": "workspace:*",
    "@smthrs/registry": "workspace:*",
    "@smthrs/run-store": "workspace:*",
    "@smthrs/std": "workspace:*",
    "effect": "4.1.1",
    "electrobun": "1.18.1",
    "foldkit": "0.170.0",
    "vibelang-runtime": "0.0.14-pre.6279f9f9fbfc"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "vibelang": "0.0.14-pre.6279f9f9fbfc",
    "vibelang-unplugin": "0.0.14-pre.6279f9f9fbfc",
    "vibelang-vite": "0.0.14-pre.6279f9f9fbfc",
    "vite": "8.3.4",
    "vitest": "5.0.0",
    "happy-dom": "20.13.2"
  }
}
