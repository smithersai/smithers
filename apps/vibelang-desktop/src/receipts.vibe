import type { ToolReceipt } from "./protocol.vibe"

// Receipts are display excerpts. Exact originals belong only to the active write-ahead intent.
function splitsPair(text: string, at: number) {
  const high = text.charCodeAt(at - 1)
  const low = text.charCodeAt(at)
  return high >= 0xd800 && high <= 0xdbff && low >= 0xdc00 && low <= 0xdfff
}

function excerpt(text: string, limit: number) {
  if (text.length <= limit) return text
  const end = limit - 2
  return text.slice(0, splitsPair(text, end) ? end - 1 : end) + "\n…"
}

function editContext(before: string, after: string) {
  let start = 0
  while (start < before.length && start < after.length && before[start] === after[start]) start++
  let suffix = 0
  while (suffix < before.length - start && suffix < after.length - start && before[before.length - suffix - 1] === after[after.length - suffix - 1]) suffix++

  // Replacing one or two characters with a two-character marker saves no space.
  const from = start > 82 ? start - 80 : 0
  const changed = (text: string) => {
    const to = suffix > 82 ? text.length - suffix + 80 : text.length
    const left = splitsPair(text, from) ? from + 1 : from
    const right = splitsPair(text, to) ? to - 1 : to
    return (from > 0 ? "…\n" : "") + text.slice(left, right) + (to < text.length ? "\n…" : "")
  }
  return { before: changed(before), after: changed(after) }
}

export function receiptOf(receipt: ToolReceipt, limit: number): ToolReceipt {
  if (receipt.operation !== "fs.edit") return { ...receipt, before: excerpt(receipt.before, limit), after: excerpt(receipt.after, limit) }
  const context = editContext(receipt.before, receipt.after)
  if (context.before.length <= limit && context.after.length <= limit) return { ...receipt, ...context }

  // Truncation can expose a new common suffix. Shorten it now so replaying the archive is lossless.
  return { ...receipt, ...editContext(excerpt(context.before, limit), excerpt(context.after, limit)) }
}
