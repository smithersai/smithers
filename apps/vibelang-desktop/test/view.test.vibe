// The desktop wrapper's behavior independent of the native runtime and model server.
import { describe, expect, it } from "@effect/vitest"
import * as Scene from "foldkit/scene"
import { busy, canSend, init, Message, update } from "../src/view/main.vibe"
import { view } from "../src/view/view.vibe"
import { endpointOf, relativeFile } from "../src/policy.vibe"
const initial = () => init({ session: "desktop", name: "Guest", mode: "mock" }).model

describe("desktop controls", () => {
  it("keeps the shared mock tour usable when a selected local model has failed", () => {
    const model = { ...initial(), conversation: "tour-desktop", desktop: { mock: false, folder: null, tools: [], model: { endpoint: "http://localhost:1234", model: "local", state: "failed" as const } } }
    expect(canSend(model)).toBe(true)
    const selected = update(model, Message.Select({ model: "local" })).model
    expect(selected.conversation).toBe("home")
    const keyboard = update({ ...model, available: ["local"], picker: true }, Message.PickerKey({ key: "Enter" })).model
    expect(keyboard.conversation).toBe("home")
  })
  it("starts in mock without a model; a pending folder picker and a held discovery never block a send", () => {
    const model = { ...initial(), draft: "hello" }
    expect(canSend(model)).toBe(true)
    const direct = update(model, Message.SubmittedDraft())
    expect(direct.commands?.length).toBeGreaterThan(0)
    const opened = update(model, Message.OpenFolder())
    expect(opened.model.folderOps).toBe(1)
    expect(opened.commands?.[0]?.name).toBe("Desktop.Change")
    // Neither native operation has answered: both are still busy, and the ready chat admits exactly one post.
    const held = update({ ...opened.model, endpoint: "http://localhost:1111" }, Message.Connect()).model
    expect(held.discovering).toBe("http://localhost:1111")
    expect(busy(held)).toBe(true)
    expect(canSend(held)).toBe(true)
    const sent = update(held, Message.SubmittedDraft())
    expect(sent.commands?.map((command) => command.name)).toEqual(direct.commands?.map((command) => command.name))
    expect(sent.model.folderOps).toBe(1)
    expect(sent.model.discovering).toBe("http://localhost:1111")
  })
  it("holds a send only while the model that would answer is being chosen", () => {
    const model = { ...initial(), draft: "hello" }
    const choosing = update(model, Message.Select({ model: "local" })).model
    expect(choosing.modelOps).toBe(1)
    expect(canSend(choosing)).toBe(false)
    expect(update(choosing, Message.SubmittedDraft()).commands).toBeUndefined()
    const state = { mock: false, folder: null, tools: [], model: { endpoint: "http://localhost:1234", model: "local", state: "ready" as const } }
    const chosen = update(choosing, Message.Snapshot({ generation: 1, state, operation: "model" })).model
    expect(chosen.modelOps).toBe(0)
    expect(canSend(chosen)).toBe(true)
  })
  it("settles each native operation on its own answer; a refresh settles none and keeps the error", () => {
    const opened = update(initial(), Message.OpenFolder()).model
    const choosing = update(opened, Message.Mock()).model
    expect([choosing.folderOps, choosing.modelOps]).toEqual([1, 1])
    const refreshed = update({ ...choosing, error: "Model unavailable" }, Message.Snapshot({ generation: 1, conversation: choosing.conversation, state: choosing.desktop })).model
    expect([refreshed.folderOps, refreshed.modelOps, refreshed.error]).toEqual([1, 1, "Model unavailable"])
    const mocked = update(refreshed, Message.Snapshot({ generation: 1, state: choosing.desktop, operation: "mock" })).model
    expect([mocked.folderOps, mocked.modelOps, mocked.error]).toEqual([1, 0, ""])
    const failed = update(mocked, Message.Failed({ reason: "Unavailable", operation: "open" })).model
    expect([failed.folderOps, failed.modelOps, failed.error]).toEqual([0, 0, "Unavailable"])
    expect(busy(failed)).toBe(false)
  })
  it("discards a discovery answer for an endpoint the person has since edited", () => {
    const a = "http://localhost:1111"
    const b = "http://localhost:2222"
    const asked = update({ ...initial(), endpoint: a }, Message.Connect())
    expect(asked.commands?.[0]?.args).toEqual({ endpoint: a, generation: 1 })
    // A is held. The person edits the endpoint to B, then A answers.
    const edited = update(asked.model, Message.UpdatedEndpoint({ value: b })).model
    expect(edited.discovering).toBeNull()
    expect(update(edited, Message.Listed({ models: ["from-a"], endpoint: a, generation: 1 })).model).toBe(edited)
    expect(update(edited, Message.DiscoveryFailed({ endpoint: a, generation: 1 })).model).toBe(edited)
    // B's own request fails. A's late list replaces neither B's empty list nor its error.
    const askedB = update(edited, Message.Connect())
    expect(askedB.commands?.[0]?.args).toEqual({ endpoint: b, generation: 3 })
    const failedB = update(askedB.model, Message.DiscoveryFailed({ endpoint: b, generation: 3 })).model
    expect([failedB.error, failedB.discovering, failedB.available]).toEqual(["Model unavailable", null, []])
    expect(update(failedB, Message.Listed({ models: ["from-a"], endpoint: a, generation: 1 })).model).toBe(failedB)
    // Editing back to A does not revive the answer to the abandoned request.
    const back = update(failedB, Message.UpdatedEndpoint({ value: a })).model
    expect(update(back, Message.Listed({ models: ["from-a"], endpoint: a, generation: 1 })).model).toBe(back)
    // The current request's answer applies.
    const listed = update(askedB.model, Message.Listed({ models: ["from-b"], endpoint: b, generation: 3 })).model
    expect([listed.available, listed.discovering, listed.error]).toEqual([["from-b"], null, ""])
  })
  it("keeps the endpoint the person named when the host reports another server's model", () => {
    const ready = (endpoint: string) => ({ mock: false, folder: null, tools: [], model: { endpoint, model: "local", state: "ready" as const } })
    const typed = update(initial(), Message.UpdatedEndpoint({ value: "http://localhost:2222" })).model
    expect(update(typed, Message.Snapshot({ generation: 1, conversation: typed.conversation, state: ready("http://localhost:1111") })).model.endpoint).toBe("http://localhost:2222")
    const versioned = update(initial(), Message.UpdatedEndpoint({ value: "http://localhost:1111/v1" })).model
    expect(update(versioned, Message.Snapshot({ generation: 1, state: ready("http://localhost:1111"), operation: "model" })).model.endpoint).toBe("http://localhost:1111")
    expect(update(initial(), Message.Snapshot({ generation: 1, state: ready("http://localhost:1111") })).model.endpoint).toBe("http://localhost:1111")
  })
  it("selects a model, restarts the stream at zero and preserves the draft", () => {
    const model = { ...initial(), draft: "keep this" }
    const next = update(model, Message.Snapshot({ generation: 1, state: { mock: false, folder: null, tools: [], model: { endpoint: "http://localhost:1234", model: "local", state: "ready" } } })).model
    expect(next.mode).toBe("live")
    expect(next.epoch).toBe(1)
    expect(next.from).toBe(0)
    expect(next.stream).toBe("open")
    expect(next.draft).toBe("keep this")
    expect(canSend(next)).toBe(true)
    expect(canSend({ ...next, desktop: { ...next.desktop, model: { ...next.desktop.model!, state: "failed" } } })).toBe(false)
    expect(canSend({ ...next, offline: true })).toBe(true)
  })
  it("closes the model picker before the pane and retains chat's Escape behavior", () => {
    const model = { ...initial(), picker: true, manager: true }
    const next = update(model, Message.PressedEscape()).model
    expect(next.picker).toBe(false)
    expect(next.manager).toBe(true)
    expect(update(next, Message.PressedEscape()).model.manager).toBe(false)
  })
  it("wraps keyboard selection, selects Mock, and closes on Escape", () => {
    const model = { ...initial(), available: ["one", "two"], picker: true }
    const up = update(model, Message.PickerKey({ key: "ArrowUp" })).model
    expect(up.highlighted).toBe(2)
    expect(update(up, Message.PickerKey({ key: "Enter" })).commands?.[0]?.args).toMatchObject({ operation: "mock" })
    expect(update(up, Message.PickerKey({ key: "Escape" })).model.picker).toBe(false)
  })
  it("shows selection failures without breaking mock chat", () => {
    const asked = update(initial(), Message.Connect())
    const failed = update(asked.model, Message.DiscoveryFailed({ endpoint: "", generation: 1 })).model
    expect(failed.error).toBe("Model unavailable")
    expect(busy(failed)).toBe(false)
    expect(canSend(failed)).toBe(true)
  })
})

it.effect("fuzzes file admission and model origins with Effect Arbitrary", () => effect {
  const checked = try Arbitrary.checkEffect(Arbitrary.schema(Schema.String), (name) => {
    const endpoint = endpointOf(name)
    return (!relativeFile(name) || (name.length > 0 && !name.startsWith("/") && !name.includes("\\") && !name.split("/").includes(".."))) &&
      (endpoint === "" || /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$/.test(endpoint))
  }, { runs: 1000 })
  try Effect.try(() => expect(Arbitrary.formatCheckFailure(checked)).toBeUndefined())
})


it("local selection clears Mock project authority before session I/O and rejects late identities", () => {
  const account = { ...initial().account!, identity: { id: "1", login: "will", role: "maintainer" as const } }
  const state = { mock: false, folder: null, tools: [], model: { endpoint: "http://localhost:1234", model: "local", state: "ready" as const } }
  const selected = update({ ...initial(), account }, Message.Snapshot({ generation: 1, state })).model
  expect(selected.account?.identity).toEqual({ id: "", login: "", role: "viewer", available: false })
  const late = update(selected, Message.AccountLoaded({ identity: account.identity })).model
  expect(late.account?.identity).toEqual({ id: "", login: "", role: "viewer", available: false })
  const beforeLoad = update({ ...selected, account }, Message.ClickedSignIn())
  expect(beforeLoad.commands ?? []).toHaveLength(0)
  expect(beforeLoad.model.account?.error).toBe("Sign-in unavailable.")
  const failed = update(selected, Message.AccountFailed()).model
  expect(update(failed, Message.ClickedSignIn()).model.account?.error).toBe("Sign-in unavailable.")
})


it("a late local session cannot replace a newer Mock identity", () => {
  const account = { ...initial().account!, identity: { id: "1", login: "will", role: "maintainer" as const } }
  const model = { ...initial(), account }
  const late = update(model, Message.AccountLoaded({ identity: { id: "", login: "", role: "viewer", available: false } })).model
  expect(late.account?.identity).toEqual(account.identity)
})

it("requests only the visible conversation and ignores a late receipt snapshot from another conversation", () => {
  const started = init({ session: "desktop", name: "Guest", mode: "mock" })
  expect(started.commands?.[0]?.args).toEqual({ generation: 1, conversation: started.model.conversation })
  const receipt = { conversation: "other", reply: "reply", operation: "fs.edit", path: "file", before: "old", after: "new" }
  const stale = update(started.model, Message.Snapshot({ generation: 1, conversation: "other", state: { ...started.model.desktop, tools: [receipt] } }))
  expect(stale.model).toBe(started.model)
  const current = update(started.model, Message.Snapshot({ generation: 1, conversation: started.model.conversation, state: started.model.desktop }))
  expect(current.commands ?? []).toHaveLength(0)
})

it("clears the prior conversation's receipts immediately when leaving the tour for a local model", () => {
  const receipt = { conversation: "tour-desktop", reply: "reply", operation: "fs.edit", path: "file", before: "old", after: "new" }
  const model = { ...initial(), conversation: "tour-desktop", desktop: { ...initial().desktop, tools: [receipt] } }
  const selected = update(model, Message.Select({ model: "local" })).model
  expect(selected.conversation).toBe("home")
  expect(selected.desktop.tools).toEqual([])
})

it("preserves shared commands when opening Models and handles the empty-command branches", () => {
  const model = initial()
  const opened = update({ ...model, palette: true }, Message.OpenModels())
  expect(opened.model.manager).toBe(true)
  expect(opened.model.palette).toBe(false)
  expect(opened.commands?.map((command) => command.name)).toEqual(["ClosePalette"])
  const alreadyClosed = update(model, Message.OpenModels())
  expect(alreadyClosed.model.manager).toBe(true)
  expect(alreadyClosed.commands).toEqual([])
  const snapshot = update(model, Message.Snapshot({ generation: 1, conversation: model.conversation, state: model.desktop }))
  expect(snapshot.commands).toEqual([])
})

it("retains shared wiki and actions commands in the desktop update", () => {
  const model = initial()
  const wiki = update(model, Message.ClickedWiki({ page: "index" }))
  expect(wiki.commands?.map((command) => command.name)).toEqual(["OpenWiki"])
  expect(wiki.commands?.[0]?.args).toMatchObject({ conversation: model.conversation, page: "index" })
  const actions = update(model, Message.ClickedActions())
  expect(actions.commands?.map((command) => command.name)).toEqual(["LoadActions"])
})

describe("desktop chrome", () => {
  const folder = { path: "/Users/ada/project-under-test", files: 3, token: "token", identity: "identity" }
  const local = { endpoint: "http://localhost:1234", model: "local", state: "ready" as const }
  it("offers Mock once, in the model picker, and Models once, in the navigation", () => {
    const model = { ...initial(), manager: true, picker: true, available: ["local"], desktop: { mock: true, folder, tools: [], model: local } }
    Scene.scene({ update, view }, Scene.given(model),
      Scene.expectAll(Scene.all.role("option", { name: "Mock" })).toHaveCount(1),
      Scene.expectAll(Scene.all.role("button", { name: "Mock" })).toHaveCount(0),
      Scene.expectAll(Scene.all.role("button", { name: "Models" })).toHaveCount(1),
      Scene.expectAll(Scene.all.role("button", { name: "Manage models…" })).toHaveCount(0),
      Scene.expect(Scene.role("region", { name: "Models" })).toExist(),
    )
  })
  it("shows the open folder's path once, on its chip", () => {
    const model = { ...initial(), desktop: { mock: false, folder, tools: [], model: local } }
    Scene.scene({ update, view }, Scene.given(model),
      Scene.expectAll(Scene.all.text(folder.path)).toHaveCount(1),
      Scene.expectAll(Scene.all.selector(".dt-chip code")).toHaveCount(1),
      Scene.expectAll(Scene.all.selector(".dt-title code")).toHaveCount(0),
      Scene.expect(Scene.placeholder("Describe what to change")).toExist(),
      Scene.expect(Scene.text("3 files")).toExist(),
      Scene.expect(Scene.role("button", { name: "Close folder" })).toExist(),
    )
  })
})


it("keeps the selected local model and stream after an older same-conversation refresh arrives", () => {
  const start = initial()
  const folder = update(start, Message.OpenFolder()).model
  const choosing = update(folder, Message.Select({ model: "local" })).model
  const state = { mock: false, folder: null, tools: [], model: { endpoint: "http://localhost:1234", model: "local", state: "ready" as const } }
  const chosen = update(choosing, Message.Snapshot({ generation: choosing.settingsRequest, operation: "model", state }))
  const conversation = start.conversation
  expect(chosen.commands?.at(-1)?.args).toEqual({ conversation, generation: chosen.model.settingsRequest })
  const current = update(chosen.model, Message.Snapshot({ generation: chosen.model.settingsRequest, conversation, state })).model
  const late = update(current, Message.Snapshot({ generation: start.settingsRequest, conversation, state: start.desktop })).model
  const settled = update(late, Message.Snapshot({ generation: folder.settingsRequest, operation: "open", state: start.desktop })).model
  expect(settled.mode).toBe("live")
  expect(settled.desktop.model?.model).toBe("local")
  expect(settled.epoch).toBe(start.epoch + 1)
  expect(settled.folderOps).toBe(0)
  expect(canSend(settled)).toBe(true)
})
