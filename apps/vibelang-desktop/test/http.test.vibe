// Loopback admission: spoofed Host and Origin headers alone never reach the desktop or conversation API.
import { BunHost } from "@smthrs/platform-bun"
import { expect, it } from "@effect/vitest"
import { HttpClientRequest, HttpServerRequest, HttpServerResponse } from "effect/http"
import { ConversationRead } from "../../vibelang/src/core/Factory.vibe"
import { MockFactory } from "../../vibelang/src/core/MockFactory.vibe"
import { Desktop } from "../src/host/Factory.vibe"
import { handler } from "../src/host/Http.vibe"

const origin = "http://127.0.0.1:44509"
const launch = "a".repeat(64)
const empty = { mock: true, folder: null, model: null, tools: [] }

it.effect("admits only the window that presented this launch's secret", () => (effect {
  const calls: Array<string> = []
  const desktop = Layer.succeed(Desktop, {
    external: effect (url) => { calls.push(`external ${url}`) },
    snapshot: effect (conversation) => { calls.push(`snapshot ${conversation}`); return empty },
    change: effect (operation, endpoint) => { calls.push(`change ${operation} ${endpoint}`); return empty },
    models: effect (endpoint) => { calls.push(`models ${endpoint}`); return [] },
  })
  const fs = try FileSystem.FileSystem
  const assets = try fs.makeTempDirectoryScoped()
  // Exactly what a non-browser client on this machine can send: any method, Host, Origin, cookie and body.
  effect function send(path: string, options: { readonly method?: "GET" | "POST"; readonly cookie?: string; readonly body?: string } = {}) {
    const base = options.method === "POST" ? HttpClientRequest.post(`${origin}${path}`).pipe(HttpClientRequest.bodyText(options.body ?? "", "application/json")) : HttpClientRequest.get(`${origin}${path}`)
    const forged = base.pipe(HttpClientRequest.setHeaders({ host: "127.0.0.1:44509", origin, ...(options.cookie === undefined ? {} : { cookie: options.cookie }) }))
    const request = HttpServerRequest.fromWeb(try HttpClientRequest.toWeb(forged))
    const response = try handler(origin, assets, launch).pipe(Effect.provideService(HttpServerRequest.HttpServerRequest, request))
    return HttpServerResponse.toWeb(response)
  }
  provide desktop, MockFactory {
    // A local process forges Host and Origin but has no cookie: every privileged route refuses it.
    const state = try send("/desktop/state")
    const model = try send("/desktop/change", { method: "POST", body: JSON.stringify({ operation: "model", endpoint: "http://127.0.0.1:1", model: "x" }) })
    const external = try send("/desktop/external", { method: "POST", body: JSON.stringify({ url: "https://example.invalid" }) })
    const conversation = try send("/api/conversations/home/posts", { method: "POST", body: "{}" })
    const guessed = try send("/desktop/state", { cookie: `vibelang-desktop-launch=${"b".repeat(64)}` })
    const wrongKey = try send(`/desktop/launch?key=${"b".repeat(64)}`)
    const noKey = try send("/desktop/launch")
    // The native window opens the launch URL, receives the cookie and is redirected to the app.
    const launched = try send(`/desktop/launch?key=${launch}`)
    const cookie = launched.headers.get("set-cookie") ?? ""
    const admitted = try send("/desktop/state", { cookie: cookie.split(";")[0]! })
    const scoped = try send("/desktop/state?conversation=a%2Fb", { cookie: cookie.split(";")[0]! })
    const changed = try send("/desktop/change", { method: "POST", cookie: cookie.split(";")[0]!, body: JSON.stringify({ operation: "mock" }) })
    const wiki = try send("/api/conversations/home/wiki", { method: "POST", cookie: cookie.split(";")[0]!, body: JSON.stringify({ page: "index" }) })
    const recorded = try (try ConversationRead).read("home", 0)
    const unknown = try send("/api/conversations/home/wiki", { method: "POST", cookie: cookie.split(";")[0]!, body: JSON.stringify({ page: "missing" }) })
    const refusal = try promise(() => unknown.json())
    try Effect.try(() => {
      expect(wiki.status).toBe(200)
      expect(recorded.seq).toBeGreaterThan(0)
      expect(unknown.status).toBe(409)
      expect(refusal).toEqual({ refusal: "empty" })
      expect([state.status, model.status, external.status, conversation.status, guessed.status, wrongKey.status, noKey.status]).toEqual([403, 403, 403, 403, 403, 403, 403])
      expect(wrongKey.headers.get("set-cookie")).toBeNull()
      expect(launched.status).toBe(303)
      expect(launched.headers.get("location")).toBe("/")
      expect(cookie).toContain(`vibelang-desktop-launch=${launch}`)
      expect(cookie).toContain("HttpOnly")
      expect(cookie).toContain("SameSite=Strict")
      expect(admitted.status).toBe(200)
      expect(changed.status).toBe(200)
      expect(scoped.status).toBe(200)
      expect(calls).toEqual(["snapshot undefined", "snapshot a/b", "change mock undefined"])
    })
  }
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("counts a desktop write's bytes while reading it and refuses what it will not open", () => (effect {
  const calls: Array<string> = []
  const desktop = Layer.succeed(Desktop, {
    external: effect (url) => { calls.push(`external ${url}`) },
    snapshot: effect () => empty,
    change: effect (operation, _endpoint, model) => { calls.push(`change ${operation} ${model?.length ?? 0}`); return empty },
    models: effect () => [],
  })
  const fs = try FileSystem.FileSystem
  const assets = try fs.makeTempDirectoryScoped()
  const encoder = new TextEncoder()
  // The launched window's own requests. `chunks` sends a streamed body, which declares no Content-Length.
  effect function post(path: string, body: string | ReadonlyArray<string>, type = "application/json") {
    const base = HttpClientRequest.post(`${origin}${path}`)
    const filled = typeof body === "string" ? base.pipe(HttpClientRequest.bodyText(body, type)) : base.pipe(HttpClientRequest.bodyStream(Stream.fromIterable(body.map((chunk) => encoder.encode(chunk))), { contentType: type }))
    const admitted = filled.pipe(HttpClientRequest.setHeaders({ host: "127.0.0.1:44509", origin, cookie: `vibelang-desktop-launch=${launch}` }))
    const request = HttpServerRequest.fromWeb(try HttpClientRequest.toWeb(admitted))
    const response = try handler(origin, assets, launch).pipe(Effect.provideService(HttpServerRequest.HttpServerRequest, request))
    return response.status
  }
  // A change body of exactly `bytes` bytes: the model name pads it.
  const sized = (bytes: number) => {
    const shell = JSON.stringify({ operation: "mock", model: "" })
    return JSON.stringify({ operation: "mock", model: "x".repeat(bytes - encoder.encode(shell).length) })
  }
  const link = JSON.stringify({ url: "https://example.com/a" })
  const large = JSON.stringify({ url: `https://example.com/${"a".repeat(8192)}` })
  // 2,040 two-byte characters: under 4,096 UTF-16 units, over 4,096 bytes.
  const multibyte = JSON.stringify({ operation: "mock", model: "é".repeat(2040) })
  provide desktop, MockFactory {
    const plain = try post("/desktop/external", link, "text/plain")
    const chunked = try post("/desktop/external", [link.slice(0, 9), link.slice(9)])
    const oversizedLink = try post("/desktop/external", [large.slice(0, 3000), large.slice(3000, 6000), large.slice(6000)])
    const script = try post("/desktop/external", JSON.stringify({ url: "javascript:alert(1)" }))
    const http = try post("/desktop/external", JSON.stringify({ url: "http://example.com/" }))
    const credentialed = try post("/desktop/external", JSON.stringify({ url: "https://user:secret@example.com/" }))
    const untyped = try post("/desktop/external", JSON.stringify({ url: 5 }))
    const atLimit = try post("/desktop/change", sized(4096))
    const overLimit = try post("/desktop/change", sized(4097))
    const chunkedAtLimit = try post("/desktop/change", [sized(4096).slice(0, 1000), sized(4096).slice(1000)])
    const chunkedOverLimit = try post("/desktop/change", [sized(8192).slice(0, 4000), sized(8192).slice(4000)])
    const wide = try post("/desktop/change", multibyte)
    const wideChunked = try post("/desktop/change", [multibyte.slice(0, 500), multibyte.slice(500)])
    try Effect.try(() => {
      expect(multibyte.length).toBeLessThan(4096)
      expect(encoder.encode(multibyte).length).toBeGreaterThan(4096)
      expect([plain, chunked, oversizedLink, script, http, credentialed, untyped]).toEqual([415, 200, 413, 400, 400, 400, 400])
      expect([atLimit, overLimit, chunkedAtLimit, chunkedOverLimit, wide, wideChunked]).toEqual([200, 413, 200, 413, 413, 413])
      // Only the admitted bodies reached the desktop service.
      expect(calls).toEqual(["external https://example.com/a", `change mock ${JSON.parse(sized(4096)).model.length}`, `change mock ${JSON.parse(sized(4096)).model.length}`])
    })
  }
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))
