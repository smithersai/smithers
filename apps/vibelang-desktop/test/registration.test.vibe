// The desktop composition over a real data directory: an undecodable file is set aside, and a save is synced before and after its rename.
import { expect, it } from "@effect/vitest"
import { FlowEngine } from "@smthrs/engine"
import { BunHost } from "@smthrs/platform-bun"
import { HttpClient, HttpClientRequest, HttpClientResponse, HttpServerRequest, HttpServerResponse } from "effect/http"
import { Factory } from "../../vibelang/src/core/Factory.vibe"
import { Desktop, Preferences, registration } from "../src/host/Factory.vibe"
import { replyIdOf } from "../../vibelang/src/core/flows.vibe"
import { folderLayer } from "../src/host/Folder.vibe"
import { clientLayer, DesktopClient } from "../src/view/Client.vibe"
import { Actions } from "../../vibelang/src/actions/Actions.vibe"
import { handler } from "../src/host/Http.vibe"
import { init, Message, update } from "../src/view/main.vibe"
import { localModelsLayer } from "../src/host/LocalModel.vibe"

const initial = { mock: true, folder: null, model: null, tools: [] }

/** Builds registration over `directory`; the host filesystem reports each write, sync and rename to `operations`. */
effect function start(directory: string, operations: Array<string>) {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const label = (name: string) => name === directory ? "directory" : path.basename(name)
  const recorded: FileSystem.FileSystem = {
    ...fs,
    writeFileString: (name, text, options) => { operations.push(`write ${label(name)}`); return fs.writeFileString(name, text, options) },
    rename: (from, to) => { operations.push(`rename ${label(from)} ${label(to)}`); return fs.rename(from, to) },
    open: (name, options) => map(fs.open(name, options), (file) => Object.create(file, { sync: { value: Effect.andThen(Effect.sync(() => operations.push(`sync ${label(name)}`)), file.sync) } })),
  }
  const offline = HttpClient.make(() => Effect.die("No model provider in this test"))
  const host = Layer.mergeAll(Layer.succeed(FileSystem.FileSystem, recorded), Layer.succeed(Path.Path, path), BunHost.BunCrypto.layer, Layer.succeed(HttpClient.HttpClient, offline))
  const preferences = Layer.succeed(Preferences, { directory, chooseDirectory: () => succeed(null), openExternal: () => Effect.void })
  const composed = registration.pipe(Layer.provide(Layer.mergeAll(folderLayer, localModelsLayer, preferences)), Layer.provideMerge(FlowEngine.layerMemory), Layer.provide(host))
  const context = try Layer.build(composed)
  return { desktop: Context.get(context, Desktop), factory: Context.get(context, Factory) }
}

it.effect("sets an undecodable settings file aside, starts from the default and syncs the next save", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const settings = path.join(directory, "settings.json")
  try fs.writeFileString(settings, "{\"snapshot\":")
  const operations: Array<string> = []
  const { desktop } = try start(directory, operations)
  const restored = try desktop.snapshot()
  const aside = (try fs.readDirectory(directory)).filter((name) => name.startsWith("settings.json.corrupt-"))
  const kept = try fs.readFileString(path.join(directory, aside[0] ?? "missing"))
  operations.length = 0
  const changed = try desktop.change("mock")
  const saved = try fs.readFileString(settings)
  try Effect.try(() => {
    expect(restored).toEqual(initial)
    expect(aside).toHaveLength(1)
    expect(kept).toBe("{\"snapshot\":")
    expect(changed).toEqual(initial)
    expect(JSON.parse(saved)).toEqual({ snapshot: initial, edits: [] })
    expect(operations.filter((operation) => operation.includes("settings") || operation === "sync directory")).toEqual([
      "write settings.json.new", "sync settings.json.new", "rename settings.json.new settings.json", "sync directory",
    ])
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("sets an undecodable conversation aside; it still reads and takes the next post", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const conversation = path.join(directory, "conversation-home.json")
  try fs.writeFileString(conversation, "[{")
  const { factory } = try start(directory, [])
  const read = try factory.read("home", 0)
  const aside = (try fs.readDirectory(directory)).filter((name) => name.startsWith("conversation-home.json.corrupt-"))
  try factory.post("home", "first", "Ada", "hello")
  const log = try fs.readFileString(conversation)
  try Effect.try(() => {
    expect(read.entries).toEqual([])
    expect(aside).toHaveLength(1)
    expect(JSON.parse(log)).toEqual(expect.arrayContaining([expect.objectContaining({ clientId: "first", text: "hello" })]))
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("migrates legacy full-file receipts out of settings before the next preference save", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const settings = path.join(directory, "settings.json")
  const receipt = { id: "edit-1", conversation: "home", reply: "reply-1", operation: "fs.edit", model: "local", path: "large.vibe", before: "x".repeat(500 * 1024) + "old", after: "x".repeat(500 * 1024) + "new" }
  try fs.writeFileString(settings, JSON.stringify({ snapshot: { ...initial, tools: [receipt] }, edits: [] }))
  const { desktop } = try start(directory, [])
  const state = try desktop.snapshot()
  try desktop.change("mock")
  const saved = try fs.readFileString(settings)
  try Effect.try(() => {
    expect(state.tools.length).toBe(0)
    expect(saved.length).toBeLessThan(2048)
    expect(JSON.parse(saved)).toEqual({ snapshot: initial, edits: [] })
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("partitions migrated receipts, deduplicates interrupted migration and retains only unfinished recovery intents", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const folder = { path: "project", files: 1, token: "folder-token", identity: "folder-identity" }
  const tool = (id: string, conversation: string) => ({ id, conversation, reply: "reply", operation: "fs.edit", path: "file.vibe", before: "prefix".repeat(100000) + "old", after: "prefix".repeat(100000) + "new" })
  const a = tool("a", "a/b")
  const b = tool("b", "other")
  const old = { snapshot: { ...initial, tools: [a, b] }, edits: [{ key: "a", folder, receipt: a, done: true }, { key: "b", folder, receipt: b, done: false }] }
  const settings = path.join(directory, "settings.json")
  try fs.writeFileString(settings, JSON.stringify(old))
  try fs.writeFileString(path.join(directory, "conversation-a%2Fb.json"), JSON.stringify([{ type: "ReplyFinished", seq: 1, id: "reply" }]))
  const first = try start(directory, [])
  const aTools = (try first.desktop.snapshot("a/b")).tools
  const bTools = (try first.desktop.snapshot("other")).tools
  const recovery = try fs.readFileString(path.join(directory, "edit-intents.json"))
  // Simulate stopping after the new files were published but before settings was replaced.
  try fs.writeFileString(settings, JSON.stringify(old))
  const operations: Array<string> = []
  const second = try start(directory, operations)
  const replayed = (try second.desktop.snapshot("a/b")).tools
  operations.length = 0
  try second.desktop.snapshot("other")
  try second.desktop.change("mock")
  try Effect.try(() => {
    expect(aTools).toHaveLength(1)
    expect(bTools.map((receipt) => receipt.id)).toEqual(["b"])
    expect(aTools[0]?.before).toContain("old")
    expect(aTools[0]?.after).toContain("new")
    expect(JSON.stringify(aTools).length).toBeLessThan(2000)
    expect(replayed).toEqual(aTools)
    expect(JSON.parse(recovery).map((intent: { key: string }) => intent.key)).toEqual(["b"])
    expect(JSON.parse(recovery)[0].receipt.before).toBe(b.before)
    expect(operations.some((operation) => operation.includes("tools-") || operation.includes("edit-intents"))).toBe(false)
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("drops a reply's recovery intents only after its durable reply has settled", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const reply = replyIdOf("m1")
  const folder = { path: "project", files: 1, token: "token", identity: "identity" }
  const receipt = { id: "edit", conversation: "home", reply, operation: "fs.edit", path: "file.vibe", before: "old", after: "new" }
  try fs.writeFileString(path.join(directory, "settings.json"), JSON.stringify({ snapshot: initial, edits: [{ key: "edit", folder, receipt, done: true }] }))
  const before = try scoped(effect {
    const { factory } = try start(directory, [])
    const saved = try fs.readFileString(path.join(directory, "edit-intents.json"))
    try factory.post("home", "post", "Ada", "hello")
    try factory.events("home", 0).pipe(Stream.filter((event) => event.type === "ReplyFinished"), Stream.take(1), Stream.runDrain)
    return saved
  })
  // Restart after closing the first host, including the window before its cleanup action.
  const restarted = try start(directory, [])
  const after = try fs.readFileString(path.join(directory, "edit-intents.json"))
  const tools = (try restarted.desktop.snapshot("home")).tools
  try Effect.try(() => {
    expect(JSON.parse(before)).toHaveLength(1)
    expect(JSON.parse(after)).toEqual([])
    expect(tools).toEqual([receipt])
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

it.effect("retains an applied edit's original through an archive failure and reconciles it before reclaiming the intent", () => (effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  const directory = try fs.makeTempDirectoryScoped()
  const project = try fs.makeTempDirectoryScoped()
  const receipt = { id: "edit", conversation: "home", reply: "reply", operation: "fs.edit", path: "file.vibe", before: "old", after: "new" }
  const intent = { key: "edit", done: true, folder: { path: project, files: 1, token: "token", identity: "identity" }, receipt }
  // The persisted boundary after replacement, before the receipt has been archived.
  try fs.writeFileString(path.join(project, "file.vibe"), receipt.after)
  try fs.writeFileString(path.join(directory, "edit-intents.json"), JSON.stringify([intent]))
  try fs.writeFileString(path.join(directory, "conversation-home.json"), JSON.stringify([{ type: "ReplyFailed", seq: 1, id: "reply", reason: "Unavailable" }]))
  const faulty: FileSystem.FileSystem = { ...fs, writeFileString: (name, text, options) => name.endsWith("tools-home.json.new") ? Effect.die("Injected archive failure") : fs.writeFileString(name, text, options) }
  const failed = try exit(scoped(effect { provide FileSystem.FileSystem = faulty { return try start(directory, []) } }))
  const retained = try fs.readFileString(path.join(directory, "edit-intents.json"))
  const restarted = try start(directory, [])
  const reclaimed = try fs.readFileString(path.join(directory, "edit-intents.json"))
  const tools = (try restarted.desktop.snapshot("home")).tools
  const actual = try fs.readFileString(path.join(project, "file.vibe"))
  try Effect.try(() => {
    expect(Exit.isFailure(failed)).toBe(true)
    expect(JSON.parse(retained)).toEqual([intent])
    expect(JSON.parse(reclaimed)).toEqual([])
    expect(tools).toEqual([receipt])
    expect(actual).toBe("new")
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))

for (const forcedMock of [false, true]) {
  it.effect(`shares wiki and action commands with the selected backend (forced Mock: ${forcedMock})`, () => (effect {
    const fs = try FileSystem.FileSystem
    const path = try Path.Path
    const directory = try fs.makeTempDirectoryScoped()
    // Restore a local session without a selected provider: no model request can run.
    try fs.writeFileString(path.join(directory, "settings.json"), JSON.stringify({ snapshot: { ...initial, mock: false }, edits: [] }))
    const host = try start(directory, [])
    const origin = "http://127.0.0.1:44509"
    const launch = "c".repeat(64)
    // Reach the real desktop handler through its HTTP request/response boundary.
    const transport = HttpClient.make((request) => (effect {
      const web = try orDie(HttpClientRequest.toWeb(request.pipe(HttpClientRequest.setHeaders({
        host: "127.0.0.1:44509", origin, cookie: `vibelang-desktop-launch=${launch}`,
      }))))
      const response = try orDie(handler(origin, directory, launch).pipe(
        Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(web)),
        Effect.provideService(Factory, host.factory),
        Effect.provideService(Desktop, host.desktop),
        Effect.provideService(FileSystem.FileSystem, fs),
        Effect.provideService(Path.Path, path),
      ))
      return HttpClientResponse.fromWeb(request, HttpServerResponse.toWeb(response))
    }))
    provide clientLayer(origin, forcedMock).pipe(Layer.provide(Layer.succeed(HttpClient.HttpClient, transport))) {
      const factory = try Factory
      const desktop = try DesktopClient
      const actionApi = try Actions
      const run = try actionApi.start("vibelang/Tour", {}, "button")
      const followed = try Stream.runCollect(actionApi.follow(run).pipe(Stream.take(1)))
      try actionApi.cancel(run)
      const stopped = try actionApi.read(run)
      const repeated = try actionApi.rerun(run)
      try actionApi.cancel(repeated)
      const commanded = try actionApi.command("/tour")
      try actionApi.cancel(commanded)
      const model = init({ session: "desktop-contract", name: "Guest", mode: "mock" }).model
      const wiki = try Effect.try(() => update(model, Message.ClickedWiki({ page: "index" })))
      const actions = try Effect.try(() => update(model, Message.ClickedActions()))
      const opened = try wiki.commands![0]!.effect
      const loaded = try actions.commands![0]!.effect
      const page = try factory.wiki.read("index")
      const issues = try factory.issues.read()
      const before = try factory.read(model.conversation, 0)
      const state = try desktop.snapshot()
      const afterOpen = try wiki.commands![0]!.effect
      const afterLoad = try actions.commands![0]!.effect
      const after = try factory.read(model.conversation, 0)
      const localPage = try exit(factory.wiki.read("index"))
      const localIssues = try exit(factory.issues.read())
      const selectedRun = try exit(actionApi.read(run))
      const selectedFollow = try exit(Stream.runCollect(actionApi.follow(run).pipe(Stream.take(1))))
      const selectedCancel = try exit(actionApi.cancel(run))
      const selectedStart = try exit(actionApi.start("vibelang/Tour", {}, "button"))
      if (Exit.isSuccess(selectedStart)) try actionApi.cancel(selectedStart.value)
      const selectedRerun = try exit(actionApi.rerun(run))
      if (Exit.isSuccess(selectedRerun)) try actionApi.cancel(selectedRerun.value)
      const selectedCommand = try exit(actionApi.command("/tour"))
      if (Exit.isSuccess(selectedCommand)) try actionApi.cancel(selectedCommand.value)
      // Guided conversations remain in the product mock, even with a local model.
      try factory.openWiki("tour-desktop-contract", "index")
      const guided = try factory.read("tour-desktop-contract", 0)
      try Effect.try(() => {
        expect(followed).toHaveLength(1)
        expect(followed[0]?.id).toBe(run)
        expect(stopped.state).toBe("cancelled")
        expect(repeated).not.toBe(run)
        expect(commanded).not.toBe(repeated)
        for (const outcome of [selectedRun, selectedFollow, selectedCancel, selectedStart, selectedRerun, selectedCommand]) expect(outcome._tag).toBe(forcedMock ? "Success" : "Failure")
        expect(opened._tag).toBe("SucceededWiki")
        expect(loaded._tag).toBe("LoadedActions")
        if (loaded._tag === "LoadedActions") expect(loaded.entries.length).toBeGreaterThan(0)
        expect(page.pages.length).toBeGreaterThan(0)
        expect(issues.items.length).toBeGreaterThan(0)
        expect(before.seq).toBeGreaterThan(0)
        expect(state.mock).toBe(forcedMock)
        expect(factory.mode).toBe(forcedMock ? "mock" : "live")
        expect(afterOpen._tag).toBe(forcedMock ? "SucceededWiki" : "FailedWiki")
        expect(afterLoad._tag).toBe(forcedMock ? "LoadedActions" : "FailedActions")
        expect(after.seq).toBe(forcedMock ? before.seq + 1 : 0)
        expect(Exit.isSuccess(localPage)).toBe(forcedMock)
        expect(Exit.isSuccess(localIssues)).toBe(forcedMock)
        expect(guided.seq).toBeGreaterThan(0)
      })
    }
  }).pipe(Effect.provide(BunHost.layer), Effect.scoped))
}

it.effect("local project services refuse cloud authority without losing the Viewer session", () => (effect {
  const fs = try FileSystem.FileSystem
  const directory = try fs.makeTempDirectoryScoped()
  const { factory } = try start(directory, [])
  const identity = try factory.accounts.current()
  const failures = try all([
    exit(factory.openWiki("home", "index")),
    exit(factory.issues.read()),
    exit(factory.issues.act({ op: "read", key: "read", number: 0, parent: 0, title: "", text: "", assignee: "", example: "", prior: "" })),
    exit(factory.wiki.read("index")),
    exit(factory.wiki.act({ op: "save", page: "index", base: "", text: "changed", key: "save" })),
    exit(factory.accounts.members()),
    exit(factory.accounts.grant("person", "maintainer")),
    exit(factory.accounts.signOut()),
    exit(factory.accounts.choose("maintainer")),
    exit(factory.accounts.signInAgent()),
    exit(Stream.runCollect(factory.accounts.events(0))),
  ])
  try factory.accounts.participated()
  try Effect.try(() => {
    expect(identity).toEqual({ id: "", login: "", role: "viewer", available: false })
    expect(failures.every((outcome) => outcome._tag === "Failure")).toBe(true)
    const refused = failures[0]!
    if (Exit.isFailure(refused)) expect(Cause.squash(refused.cause)).toMatchObject({ _tag: "Refused", refusal: "not-replying" })
  })
}).pipe(Effect.provide(BunHost.layer), Effect.scoped))
